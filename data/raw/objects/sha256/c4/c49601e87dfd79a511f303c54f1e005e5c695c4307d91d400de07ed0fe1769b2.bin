ionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2100899104176181248/U6BvPBOA?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"100億企業創出経営者ネットワーク ～成長の壁を突破するイノベーションと稼ぐための知財経営～ 本気で100億企業を目指す経営者の皆様へ ──経営者ネットワークは、地域や業種は異なっていても、100億実現という同じ志を持ち、同じ課題に直面する経営者が集います。何かを成し遂げた経営者からの活きた経験、少し失敗してしまった経営者の教訓など、お互いの経験を共有しあうことで成長に向けたヒントと仲間を得...","type":"STRING"}},{"key":"domain","value":{"string_value":"growth-100-oku.smrj.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2100899104176181248/U6BvPBOA?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":1000,"url":"https://pbs.twimg.com/card_img/2100899104176181248/U6BvPBOA?format=jpg&name=orig","width":1600},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2100899104176181248/U6BvPBOA?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":1000,"url":"https://pbs.twimg.com/card_img/2100899104176181248/U6BvPBOA?format=png&name=2048x2048_2_exp","width":1600},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"growth-100-oku.smrj.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":94.29,"rgb":{"blue":187,"green":91,"red":84}},{"percentage":3.92,"rgb":{"blue":243,"green":226,"red":225}},{"percentage":1.8,"rgb":{"blue":215,"green":157,"red":154}}]},"type":"IMAGE_COLOR"}},{"key":"title","value":{"string_value":"100億企業創出経営者ネットワーク ～