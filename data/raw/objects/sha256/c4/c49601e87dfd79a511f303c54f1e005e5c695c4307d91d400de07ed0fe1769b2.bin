":150}},"type":"photo","url":"https://t.co/fLxbf1a2G7"}]},"favorite_count":275,"favorited":false,"full_text":"オーストラリア空軍は、北朝鮮籍船舶の瀬取りを含む違法な海上活動に対して、哨戒機P-8Aを派遣し、9月中旬から10月上旬までの間、17度目となる航空機による警戒監視を行う予定です。我が国としても引き続きオーストラリアを含む関係国及び関係国際機関と緊密に協力を行ってまいります。 https://t.co/fLxbf1a2G7","id_str":"2100884330650480850","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":3,"retweet_count":67,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04199.html","indices":[176,199],"url":"https://t.co/acP7YJzx2G"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA4ODQzMzA1NDE0MDQxNjA=","richtext":{"richtext_tags":[]},"text":"オーストラリア空軍は、北朝鮮籍船舶の瀬取りを含む違法な海上活動に対して、哨戒機P-8Aを派遣し、9月中旬から10月上旬までの間、17度目となる航空機による警戒監視を行う予定です。我が国としても引き続きオーストラリアを含む関係国及び関係国際機関と緊密に協力を行ってまいります。\n写真：オーストラリア空軍哨戒機「P-8A」（出典：オーストラリア国防省）\n\nhttps://t.co/acP7YJzx2G"}}},"rest_id":"2100884330650480850","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"18403","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100884330650480850","sortIndex":"2101755047288242104"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2099278015587049472/x89eztKm?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key