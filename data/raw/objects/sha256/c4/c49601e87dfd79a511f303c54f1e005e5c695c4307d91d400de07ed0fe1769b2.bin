ble"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2101272872933261312","indices":[75,98],"media_key":"3_2101272872933261312","media_results":{"result":{"media_key":"3_2101272872933261312"}},"media_url_https":"https://pbs.twimg.com/media/HSk4i39aAAAismP.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":540,"w":540,"x":0,"y":0},{"h":540,"w":474,"x":0,"y":0},{"h":540,"w":270,"x":33,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EIJYgVTqDt"},{"display_url":"pic.x.com/EIJYgVTqDt","expanded_url":"https://x.com/ModJapan_jp/status/2101273260767994248/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2101272872694304768","indices":[75,98],"media_key":"3_2101272872694304768","media_results":{"result":{"media_key":"3_2101272872694304768"}},"media_url_https":"https://pbs.twimg.com/media/HSk4i3Eb0AAbYsj.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":540,"w":540,"x":42,"y":0},{"h":540,"w":474,"x":75,"y":0},{"h":540,"w":270,"x":177,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EIJYgVTqDt"}]},"favorite_count":676,"favorited":false,"full_text":"【インドネシア国際緊急援助活動（現地調整所）】\nインドネシア共和国における国際緊急援助活動では、派遣作戦部隊を支えている現地調整所も活動しています。 https://t.co/EIJYgVTqDt","id_str":"2101273260767994248","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"quoted_status_id_str":"2100925749402423334","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2100925749402423334","url":"https://t.co/oDBijvHxiM"},"reply_count":20,"retweet_count":88,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDEyNzMyNjA3MTM0OTY1NzY=","text":"【インドネシア国際緊急援助活動（現地調整所）】\nインドネシア共和国における国際緊急援助活動では、派遣作戦部隊を支えている現地調整所も活動しています。\n \n約１０名の自衛官と事務官から構成される現地調整所は、インドネシアの国防省・軍を始めとする関係機関や現地の日本大使館とも連携しながら、情報収集や連絡調整を行い、派遣作戦部隊の円滑で効果的な活動を支援しています。"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2100925749402423334"}},"rest_id":"2101273260767994248","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"208798","state":"EnabledWithCount"}}},"rest_id":"2101532257395806708","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"87696","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101532257395806708","sortIndex":"2101755047288242161"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","na