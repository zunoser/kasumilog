e,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2996469,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":539,"tweets":1794},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2101165074195136777"],"editable_until_msecs":"1789795366000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":457,"bookmarked":false,"conversation_id_str":"2101165074195136777","created_at":"Sat Sep 19 04:22:46 +0000 2026","display_text_range":[0,126],"entities":{},"favorite_count":20538,"favorited":false,"full_text":"スマートフォン、オンラインショッピング、AIなど、私たちの暮らしや産業は、世界中を行き交う膨大なデータに支えられています。\nその土台が、海底ケーブルやデータセンターなどの「デジタルインフラ」で、電気や道路等と同じく、社会に欠かせない基盤となっています。","id_str":"2101165074195136777","is_quote_status":false,"lang":"ja","quote_count":269,"reply_count":1154,"retweet_count":2161,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDExNjUwNzQxMzYzMDE1Njk=","richtext":{"richtext_tags":[]},"text":"スマートフォン、オンラインショッピング、AIなど、私たちの暮らしや産業は、世界中を行き交う膨大なデータに支えられています。\nその土台が、海底ケーブルやデータセンターなどの「デジタルインフラ」で、電気や道路等と同じく、社会に欠かせない基盤となっています。\n\n世界でデジタルインフラへの需要が急拡大する中、日本経済の持続的な成長につなげるため、本年5月に日本と世界を信頼できるデジタルインフラでつなぐ「FOIPデジタル回廊構想」を打ち出しました。\n\n世界のデジタル化を支えながら、日本企業の新たな事業機会を世界に広げ、重要なデジタルインフラを世界に展開する構想です。\n\nこうした海外展開には、長期的な資金支援が欠かせません。\nそこで、先の国会で法改正を行い、日本企業の海外事業を支える官民ファンド「株式会社海外通信・放送・郵便事業支援機構（JICT）」の設置期限を、2045年度末まで延長しました。\n\nJICTは、2015年の設立以来、日本企業による海底ケーブルやデータセンターのデジタルインフラ事業等の海外展開を出融資を通じ支援してきた官民ファンドです。\n2025年度末までに累積で28件、1,536億円の投資支援を行ってきました。\n\nこのような海外展開は、日本の経済安全保障の強化にもつながります。\n\nJICTが、長期にわたり、安定的かつ大規模なリスクマネー供給によるビジネス支援を行うことで、日本企業の挑戦を後押しし、「FOIPデジタル回廊構想」を具体化していきます。"}}},"rest_id":"2101165074195136777","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1085564","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101165074195136777","sortIndex":"2101755047288242148"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/XL86eC1TDZ4","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2101157750655029248/Lh4YylmD?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":158,"url":"https://pbs.twimg.com/card_img/2101157750655029248/Lh4YylmD?format=jpg&name=280x280","width":280},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.6668","type":"STRING"}},{"key":"description","value":{"string_value":"【＋番号など知らない番号は一旦スルー　黒電話篇】近年、「＋（プラス）」から始まる海外からの詐欺電話が多発しています。被害に遭わないた...","type":"STRING"}},{"key":"player_width","value":{"string_value":"1280","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"10228272","path":[]}}},{"key":"player_image_original","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2101157750655029248/Lh4YylmD?format=jpg&name=orig","width":1280},"type":"IMAGE"}},{"key":"app_num_ratings","value":{"string_value":"49,056,266","type":"STRING"}},{"key":"app_price_amount","value":{"string_value":"0.0","type":"STRING"}},{"key":"player_height","value":{"string_value":"720","type":"STRING"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"youtube.com","type":"STRING"}},{"key":"app_name","value":{"string_value":"YouTube","type":"STRING"}},{"key":"player_image_small","value":{"image_value":{"height":81,"url":"https://pbs.twimg.com/card_img/2101157750655029248/Lh4YylmD?format=jpg&name=144x144","width":144},"type":"IMAGE"}},{"key":"title","value":{"string_value":"【特殊詐欺】＋番号など知らない番号は一旦スルー！　黒電話篇","type":"STRING"}},{"key":"app_price_currency","value":{"string_value":"USD","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/i1WmGBtRPR","type":"STRING"}},{"key":"player_image_color","value":{"image_color_value":{"palette":[{"percentage":73.33,"rgb":{"blue":199,"green":175,"red":126}},{"percentage":13.66,"rgb":{"blue":40,"green":21,"red":7}},{"percentage":5.41,"rgb":{"blue":143,"green":159,"red":206}},{"percentage":5.24,"rgb":{"blue":58,"green":68,"red":107}},{"percentage":0.21,"rgb":{"blue":89,"green":106,"red":167}}]},"type":"IMAGE_COLOR"}},{"key":"player_image_x_large","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2101157750655029248/Lh4YylmD?format=png&name=2048x2048_2_exp","width":1280},"type":"IMAGE"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"player","url":"https://t.co/i1WmGBtRPR","user_refs_results":[{"result":{"__typename":"User","action_counts":{"favorites_count":6024},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1984471345854566400/5pd8GpgC_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/10228272/1773248035"},"core":{"created_at":"Tue Nov 13 21:43:46 +0000 2007","name":"YouTube","screen_name":"YouTube"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMDIyODI3Mg==","is_blue_verified":true,"location":{"location":"San Bruno, CA"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2064694071537352925"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"like & subscribe","entities":{"description":{},"url":{"urls":[{"display_url":"youtube.com","expanded_url":"http://youtube.com/","indices":[0,23],"url":"https://t.co/GIOK0JwagA"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"regular"},"relationship_counts":{"followers":68833645,"following":1142},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"10228272","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":16191,"tweets":61501},"verification":{"verified":false,"verified_type":"Business"},"website":{"url":"https://t.co/GIOK0JwagA"}}}]},"rest_id":"https://t.co/i1WmGBtRPR"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2996469,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":539,"tweets":1794},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2101157747329003832"],"editable_until_msecs":"1789793619000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":277,"bookmarked":false,"conversation_id_str":"2101157747329003832","created_at":"Sat Sep 19 03:53:39 +0000 2026","display_text_range":[0,102],"entities":{},"favorite_count":15206,"favorited":false,"full_text":"先の国会で成立した『携帯電話不正利用防止法』の改正についてご紹介いたします。\n\n特殊詐欺の被害額は、過去最悪を更新し続けており、令和7年における被害額が約3,257億円に達するなど、極めて深刻な状況です。","id_str":"2101157747329003832","is_quote_status":false,"lang":"ja","quote_count":205,"reply_count":682,"retweet_count":2559,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/XL86eC1TDZ4?si…","expanded_url":"https://youtu.be/XL86eC1TDZ4?si=IlKMMdAMlPcqWLam","indices":[725,748],"url":"https://t.co/i1WmGBtRPR"},{"display_url":"youtu.be/koH3Xzts_o4?si…","expanded_url":"https://youtu.be/koH3Xzts_o4?si=LfrntH1nIrYV5GaS","indices":[755,778],"url":"https://t.co/9qWoMe7rV5"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDExNTc3NDcxNjk2MjQwNjQ=","richtext":{"richtext_tags":[]},"text":"先の国会で成立した『携帯電話不正利用防止法』の改正についてご紹介いたします。\n\n特殊詐欺の被害額は、過去最悪を更新し続けており、令和7年における被害額が約3,257億円に達するなど、極めて深刻な状況です。\n\nこうした犯罪では、携帯電話をはじめとする通信サービスが巧妙に悪用されており、一層踏み込んだ対策を講じる必要がありました。\n\n今回の改正は、私が昨年まで会長を務めていた自民党の「治安・テロ・サイバー犯罪対策調査会」による『組織的な詐欺から国民の財産を守るための対策に関する緊急提言』を踏まえて実現した対策です。\n\n近年の詐欺では、メッセージアプリなどの「データ通信」の悪用が指摘されており、特に被害が深刻なSNS型投資・ロマンス詐欺では、被害者の方への連絡の9割以上でデータ通信を用いるサービスが不正に利用されました。\n\nこのため、「音声SIM（電話番号や契約情報を書き込んだ小さなチップ）」に加え、「データ通信専用SIM」も本人確認の義務を課し、匿名による携帯通信サービスの不正利用の防止を図ります。\n\nまた、多数の携帯電話回線の契約は、詐欺などに悪用されるおそれがあることから、個人による契約回線数の上限について統一的な基準を示し、通信事業者がその上限を超える回線数の契約申込みを拒否できることを法律で明確化し、通信事業者による対策を一層促進していきます。\n\n加えて、通信サービスを悪用した特殊詐欺の被害を防ぐための対策のポイントを分かりやすくお伝えする取組も進めています。\n\n政府と通信事業者が連携し、こうした対策を確実に進め、国民の皆様が安心して通信サービスを利用できる環境を確保してまいります。\n\n【YouTube動画】\n（特殊詐欺）https://t.co/i1WmGBtRPR\n（制度改正）https://t.co/9qWoMe7rV5"}}},"rest_id":"2101157747329003832","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"794924","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101157747329003832","sortIndex":"2101755047288242147"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2996469,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":539,"tweets":1794},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2101142705309208791"],"editable_until_msecs":"1789790032000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":175,"bookmarked":false,"conversation_id_str":"2101142705309208791","created_at":"Sat Sep 19 02:53:52 +0000 2026","display_text_range":[0,143],"entities":{},"favorite_count":13751,"favorited":false,"full_text":"いよいよ本日、4年に1度のアジア最大のスポーツの祭典である「第20回アジア競技大会（2026/愛知・名古屋）」が開幕します。\n\n1994年の広島大会以来、32年ぶりの日本での開催となる本大会は、「愛知・名古屋」を中心に開催され、アジアの「トップアスリート」が一堂に会する大会となります。","id_str":"2101142705309208791","is_quote_status":false,"lang":"ja","quote_count":287,"reply_count":806,"retweet_count":1293,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDExNDI3MDUyNDYyNDQ4NjQ=","richtext":{"richtext_tags":[]},"text":"いよいよ本日、4年に1度のアジア最大のスポーツの祭典である「第20回アジア競技大会（2026/愛知・名古屋）」が開幕します。\n\n1994年の広島大会以来、32年ぶりの日本での開催となる本大会は、「愛知・名古屋」を中心に開催され、アジアの「トップアスリート」が一堂に会する大会となります。\n本大会の開催に向けた準備に御尽力いただいた、全ての関係者の皆様に、深く感謝申し上げます。\n\nアジアの国・地域から、訪日される多くの選手や関係者の皆様を、心から歓迎申し上げます。\n\n選手の皆様は、ひたむきに努力を積み重ね、本大会への出場をかなえられたことと思います。\nこの檜舞台で、自らを信じ、持てる力を存分に発揮されることを期待しております。\nこれまで選手を支え続けてこられた御家族や多くの関係者の皆様にも、心から敬意を表します。\n\n本大会は、10月4日までの約2週間にわたり、アジアの「トップアスリート」が、43の競技で、熱い戦いを繰り広げます。\n皆様も、各国・地域の選手にエールを送っていただくとともに、日本選手の活躍に熱い声援を送っていただければと思います。\n\n選手の皆様のご健闘を心から祈念いたしますとともに、本大会が皆様に感動と勇気を届ける素晴らしいものとなることを願っております。"}}},"rest_id":"2101142705309208791","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"763385","state":"EnabledWithCount"}}}}},"entryId"