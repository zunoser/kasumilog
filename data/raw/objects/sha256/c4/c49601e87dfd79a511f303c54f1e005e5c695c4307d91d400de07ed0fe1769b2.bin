/HSdKAmPaAAAfbYG.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":800,"w":800,"x":400,"y":0},{"h":800,"w":702,"x":498,"y":0},{"h":800,"w":400,"x":730,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OYULJ4j5yI"}]},"favorite_count":458,"favorited":false,"full_text":"９月１５日、白川統幕副長は、第３回　日ASEAN WPS協力プロジェクトに参加し、挨拶を述べました。また、９月１５日～１７日、統幕ジェンダーアドバイザー中田１空佐は、本プロジェクトにグループ討議の教官として参加しました。 https://t.co/OYULJ4j5yI","id_str":"2100880007233241371","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":6,"retweet_count":39,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA4ODAwMDcxOTU0NDcyOTY=","text":"９月１５日、白川統幕副長は、第３回　日ASEAN WPS協力プロジェクトに参加し、挨拶を述べました。また、９月１５日～１７日、統幕ジェンダーアドバイザー中田１空佐は、本プロジェクトにグループ討議の教官として参加しました。\n\n東南アジア諸国、フィジー、ケニア、モンゴル、PNG、トンガ、イエメン及びEUに対して、WPS（女性・平和・安全保障）をテーマとした協力プロジェクトを日本が提供することで、各国のWPS取組推進を支援するとともに、関係諸国との関係を更に強化しました。"}}},"rest_id":"2100880007233241371","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"33309","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2100991614881853857","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4435","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100991614881853857","sortIndex":"2101755047288242139"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicLi