est_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2101755047288242255-tweet-2100873161957101751","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2100781871558770726"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":587260,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20185,"tweets":48866},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2100873161957101751"],"editable_until_msecs":"1789725768000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2100873161957101751","created_at":"Fri Sep 18 09:02:48 +0000 2026","display_text_range":[0,56],"entities":{"media":[{"display_url":"pic.x.com/wVWk2zQS4g","expanded_url":"https://x.com/MofaJapan_jp/status/2100873161957101751/photo/1","ext_alt_text":"バンサモロ議会選挙の実施について（外務大臣談話）\n\n１　９月１４日、フィリピンのバンサモロ・ムスリム・ミンダナオ自治地域（ＢＡＲＭＭ）において、2014年の「バンサモロ包括和平合意（Comprehensive Agreement on Bangsamoro）」及び2018年の「バンサモロ基本法（Bangsamoro Organic Law）」に基づいた初のバンサモロ議会選挙が実施されました。\n２　今回の選挙では、暴力行為などいくつかの憂慮される事案がありましたが、結果として多くの有権者が投票所に足を運びました。日本は、長年にわたるミンダナオ和平プロセスにおける歴史的な一歩である今回の選挙の実施が、今後、バンサモロ自治政府の正式な発足に向けたプロセスの平和裏かつ着実な進展へとつながることを強く期待します。\n３　日本は、今回の選挙の実施に尽力したフィリピン選挙管理委員会（ＣＯＭＥＬＥＣ）を始めとする全ての関係者の努力に対し、敬意を表します。また、フィリピン政府関係者、モロ・イスラム解放戦線（ＭＩＬＦ）を始めとするＢＡＲＭＭ関係者等がミンダナオ和平プロセスの着実な進展のために行ってきた長年にわたる不断の努力に対し、改めて敬意を表します。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100872915357143040","indices":[57,80],"media_key":"3_2100872915357143040","media_results":{"result":{"media_key":"3_2100872915357143040"}},"media_url_https":"https://pbs.twimg.com/media/HSfMyR4aEAA3k1D.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":131},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":356,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/wVWk2zQS4g"},{"display_url":"pic.x.com/wVWk2zQS4g","expanded_url":"https://x.com/MofaJapan_jp/status/2100873161957101751/photo/1","ext_alt_text":"４　日本は、３０年以上にわたりミンダナオ和平プロセスを一貫して支援してきています。今回の選挙に際しても、大西洋平外務大臣政務官を団長とする選挙監視団の派遣を含め、包摂的で透明性の高い選挙の実施に向けた支援を行ってきました。日本の関係者がこれまでに行ってきた様々な取組が和平の進展に寄与してきたことを嬉しく思います。\n５　日本は、ミンダナオ和平が地域の平和と安定に寄与するとの確信の下、フィリピンの「包括的・戦略的パートナー」として、今後とも、フィリピン政府及びバンサモロ暫定自治政府の双方に寄り添いながら、ミンダナオにおける公正で持続可能な平和の実現に向けて力強く支援していく考えです。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100873078314311680","indices":[57,80],"media_key":"3_2100873078314311680","media_results":{"result":{"media_key":"3_2100873078314311680"}},"media_url_https":"https://pbs.twimg.com/media/HSfM7w8bIAAyyyS.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":66},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":0,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/wVWk2zQS4g"}],"urls":[{"display_url":"mofa.go.jp/mofaj/press/da…","expanded_url":"https://www.mofa.go.jp/mofaj/press/danwa/pageit_000001_00057.html","indices":[33,56],"url":"https://t.co/TRyNMOue3T"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/wVWk2zQS4g","expanded_url":"https://x.com/MofaJapan_jp/status/2100873161957101751/photo/1","ext_alt_text":"バンサモロ議会選挙の実施について（外務大臣談話）\n\n１　９月１４日、フィリピンのバンサモロ・ムスリム・ミンダナオ自治地域（ＢＡＲＭＭ）において、2014年の「バンサモロ包括和平合意（Comprehensive Agreement on Bangsamoro）」及び2018年の「バンサモロ基本法（Bangsamoro Organic Law）」に基づいた初のバンサモロ議会選挙が実施されました。\n２　今回の選挙では、暴力行為などいくつかの憂慮される事案がありましたが、結果として多くの有権者が投票所に足を運びました。日本は、長年にわたるミンダナオ和平プロセスにおける歴史的な一歩である今回の選挙の実施が、今後、バンサモロ自治政府の正式な発足に向けたプロセスの平和裏かつ着実な進展へとつながることを強く期待します。\n３　日本は、今回の選挙の実施に尽力したフィリピン選挙管理委員会（ＣＯＭＥＬＥＣ）を始めとする全ての関係者の努力に対し、敬意を表します。また、フィリピン政府関係者、モロ・イスラム解放戦線（ＭＩＬＦ）を始めとするＢＡＲＭＭ関係者等がミンダナオ和平プロセスの着実な進展のために行ってきた長年にわたる不断の努力に対し、改めて敬意を表します。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100872915357143040","indices":[57,80],"media_key":"3_2100872915357143040","media_results":{"result":{"media_key":"3_2100872915357143040"}},"media_url_https":"https://pbs.twimg.com/media/HSfMyR4aEAA3k1D.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":131},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":356,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/wVWk2zQS4g"},{"display_url":"pic.x.com/wVWk2zQS4g","expanded_url":"https://x.com/MofaJapan_jp/status/2100873161957101751/photo/1","ext_alt_text":"４　日本は、３０年以上にわたりミンダナオ和平プロセスを一貫して支援してきています。今回の選挙に際しても、大西洋平外務大臣政務官を団長とする選挙監視団の派遣を含め、包摂的で透明性の高い選挙の実施に向けた支援を行ってきました。日本の関係者がこれまでに行ってきた様々な取組が和平の進展に寄与してきたことを嬉しく思います。\n５　日本は、ミンダナオ和平が地域の平和と安定に寄与するとの確信の下、フィリピンの「包括的・戦略的パートナー」として、今後とも、フィリピン政府及びバンサモロ暫定自治政府の双方に寄り添いながら、ミンダナオにおける公正で持続可能な平和の実現に向けて力強く支援していく考えです。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"fa