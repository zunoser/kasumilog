ype":"none"},"relationship_counts":{"followers":1264283,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7684,"tweets":21677},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2100888202676670708"],"editable_until_msecs":"1789729354000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":80,"bookmarked":false,"conversation_id_str":"2100888202676670708","created_at":"Fri Sep 18 10:02:34 +0000 2026","display_text_range":[0,125],"entities":{"media":[{"display_url":"pic.x.com/uz8p6tZt0k","expanded_url":"https://x.com/ModJapan_jp/status/2100888202676670708/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100888192459452416","indices":[126,149],"media_key":"3_2100888192459452416","media_results":{"result":{"media_key":"3_2100888192459452416"}},"media_url_https":"https://pbs.twimg.com/media/HSfarhhbsAAv59k.jpg","original_info":{"focus_rects":[{"h":582,"w":1040,"x":0,"y":0},{"h":721,"w":721,"x":319,"y":0},{"h":721,"w":632,"x":408,"y":0},{"h":721,"w":361,"x":679,"y":0},{"h":721,"w":1040,"x":0,"y":0}],"height":721,"width":1040},"sizes":{"large":{"h":721,"resize":"fit","w":1040},"medium":{"h":721,"resize":"fit","w":1040},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uz8p6tZt0k"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/uz8p6tZt0k","expanded_url":"https://x.com/ModJapan_jp/status/2100888202676670708/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100888192459452416","indices":[126,149],"media_key":"3_2100888192459452416","media_results":{"result":{"media_key":"3_2100888192459452416"}},"media_url_https":"https://pbs.twimg.com/media/HSfarhhbsAAv59k.jpg","original_info":{"focus_rects":[{"h":582,"w":1040,"x":0,"y":0},{"h":721,"w":721,"x":319,"y":0},{"h":721,"w":632,"x":408,"y":0},{"h":721,"w":361,"x":679,"y":0},{"h":721,"w":1040,"x":0,"y":0}],"height":721,"width":1040},"sizes":{"large":{"h":721,"resize":"fit","w":1040},"medium":{"h":721,"resize":"fit","w":1040},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uz8p6tZt0k"}]},"favorite_count":809,"favorited":false,"full_text":"【🛰防衛×宇宙🚀シリーズ㉙】\n第29弾は、「宇宙（そら）を守る道しるべ③」\n \n自衛隊の作戦においては、陸上・海上・航空を含むオールドメインでの綿密な連携が重要です！そこでカギとなるのが「衛星通信」🛰\nそこで、今回は宇宙領域防衛指針の4つのアプローチ https://t.co/uz8p6tZt0k","id_str":"2100888202676670708","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":12,"reply_count":8,"retweet_count":170,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[634,639],"text":"宇宙安保"},{"indices":[640,654],"text":"SDF_SpaceYear"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"mod.go.jp/j/press/news/2…","expanded_url":"https://www.mod.go.jp/j/press/news/2025/07/28a.html","indices":[610,633],"url":"https://t.co/Mh8NR3HEGI"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA4ODgyMDI1NjM1Mzg5NDQ=","text":"【🛰防衛×宇宙🚀シリーズ㉙】\n第29弾は、「宇宙（そら）を守る道しるべ③」\n \n自衛隊の作戦においては、陸上・海上・航空を含むオールドメインでの綿密な連携が重要です！そこでカギとなるのが「衛星通信」🛰\nそこで、今回は宇宙領域防衛指針の4つのアプローチ の１つ「作戦の基盤となる衛星通信の確保」の取組をご紹介💪\n \n現在、防衛省・自衛隊専用の通信衛星としては、Xバンド防衛通信衛星「きらめき」を3機態勢で運用しています！\n \n宇宙領域防衛指針においては、作戦の基盤となる衛星通信の確保として以下４つの柱でさらなる能力強化を掲げています。\n①次期防衛通信衛星の整備🛰\n②AIを活用したオンボード処理（情報を衛星上で処置・解析👀）と戦術通信🧠\n③同盟国・同志国と相互運用性を有する抗たん性の高い通信の確保👐\n④通信衛星コンステレーション等の商用サービスの活用🌏\n \n様々なセンサーで集められた情報のリアルタイムな伝達や、遠くにいる部隊とのやり取りを可能にする衛星通信は、「指揮統制・情報関連機能」のみならず、防衛省・自衛隊の作戦全ての基盤となるものです❕\n\nまた、多様な妨害や脅威に対応するためには、低軌道の衛星コンステレーションや静止軌道衛星などを組み合わせ、多層的な衛星通信ネットワークを構築していく必要があります☝\nこうした衛星通信能力の強化を通じて、宇宙から防衛省・自衛隊の活動を支えていきます📡\n\n👇詳しくはこちら\nhttps://t.co/Mh8NR3HEGI\n＃宇宙安保\n＃SDF_SpaceYear"}}},"rest_id":"2100888202676670708","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"47404","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100888202676670708","sortIndex":"2101755047288242108"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/RWi2e-pktj4","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2100867348525920256/mRJ_Zm-x?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":158,"url":"https://pbs.twimg.com/card_img/2100867348525920256/mRJ_Zm-x?format=jpg&name=280x280","width":280},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.6668","type":"STRING"}},{"key":"description","value":{"string_value":"英語版（English）https://youtu.be/DVZCsLvb4Rw ＝＝＝＝＝＝＝ 茂木敏充外務大臣会見記録（要旨...","type":"STRING"}},{"key":"player_width","value":{"string_value":"1280","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":