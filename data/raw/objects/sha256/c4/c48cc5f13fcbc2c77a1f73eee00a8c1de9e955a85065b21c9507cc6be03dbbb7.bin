cts":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":494,"y":0},{"h":1366,"w":1198,"x":578,"y":0},{"h":1366,"w":683,"x":836,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/zkuLF9Zo5M"}]},"favorite_count":535,"favorited":false,"full_text":"8月31日、小泉防衛大臣は「省議・防衛力変革推進本部（第10回）」を開催📣\n今回は、令和9年度概算要求、イラン情勢でみられた戦い方や課題について議論。 https://t.co/zkuLF9Zo5M","id_str":"2094379726748217605","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":23,"retweet_count":83,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/henkaku/index.html","indices":[253,276],"url":"https://t.co/8QaHMGAGdJ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQzNzk3MjY2ODk0ODA3MDQ=","text":"8月31日、小泉防衛大臣は「省議・防衛力変革推進本部（第10回）」を開催📣\n今回は、令和9年度概算要求、イラン情勢でみられた戦い方や課題について議論。\n国内外の情勢は現行の三文書の策定当時に想定していた以上の速度と複雑性をもって変化しており、イランなどでみられる「新しい戦い方」は今や世界におけるスタンダードになっています。\n今回のイラン情勢で得られた教訓も踏まえ、日本として、「新しい戦い方」にどう対応していくか、引き続きスピード感を持って検討を進めて行きます。\n\n📌防衛力変革推進本部についてはこちら\nhttps://t.co/8QaHMGAGdJ"}}},"rest_id":"2094379726748217605","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"34901","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094379726748217605","sortIndex":"2094653795035250609"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemCont