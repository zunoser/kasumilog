":189}]}},"id_str":"2094376460773662720","indices":[79,102],"media_key":"3_2094376460773662720","media_results":{"result":{"media_key":"3_2094376460773662720"}},"media_url_https":"https://pbs.twimg.com/media/HRC4S2paoAAQSIk.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":219},{"h":1366,"w":1366,"x":0,"y":0},{"h":1366,"w":1198,"x":0,"y":0},{"h":1366,"w":683,"x":0,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/eUfjEDR2Cf"}]},"favorite_count":821,"favorited":false,"full_text":"8月31日、小泉防衛大臣は、連合海上部隊（CMF）派遣隊長・米中央海軍司令部（NAVCENT）連絡官として派遣されていた髙橋1等海佐の帰国報告を受けました。 https://t.co/eUfjEDR2Cf","id_str":"2094376473423683754","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":12,"retweet_count":98,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/profile/mini…","expanded_url":"https://www.mod.go.jp/j/profile/minister/koizumi/2026_08.html","indices":[395,418],"url":"https://t.co/gB2FKHbGXQ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQzNzY0NzMyNzI2ODA0NDg=","text":"8月31日、小泉防衛大臣は、連合海上部隊（CMF）派遣隊長・米中央海軍司令部（NAVCENT）連絡官として派遣されていた髙橋1等海佐の帰国報告を受けました。\n\n髙橋1佐は、CMFにおいて連絡官として勤務し、各国軍との連絡調整などを行い、海賊対処行動に貢献するとともに、中東情勢に関する情報収集などを的確に実施しました。\n\n特に、緊迫する中東情勢の中においても、臨機応変に情報収集を実施し、現地の実状に基づく重要な情報を日本へ報告するなど、防衛省・自衛隊の活動を支える重要な役割を果たしました。\n\nこうした連絡官の対応は、厳しい状況においても職務を全うするという平素からの強い使命感の賜物です。防衛省・自衛隊は引き続き自衛官の派遣等を通じて、国際社会の平和と安定に貢献していきます。\n\n☆CMFとは：バーレーンに司令部を置く、中東地域の海域の安全のために組織された多国籍部隊\n👇詳細はこちら\nhttps://t.co/gB2FKHbGXQ"}}},"rest_id":"2094376473423683754","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"35291","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094376473423683754","sortIndex":"2094653795035250607"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSI