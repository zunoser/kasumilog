2,"y":23},{"h":98,"w":98,"x":18,"y":284},{"h":128,"w":128,"x":81,"y":434}]}},"id_str":"2094394007476736001","indices":[143,166],"media_key":"3_2094394007476736001","media_results":{"result":{"media_key":"3_2094394007476736001"}},"media_url_https":"https://pbs.twimg.com/media/HRDIQNNbkAEsSM1.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":2048,"w":2048,"x":0,"y":0},{"h":2048,"w":1796,"x":252,"y":0},{"h":2048,"w":1024,"x":1024,"y":0},{"h":2048,"w":2048,"x":0,"y":0}],"height":2048,"width":2048},"sizes":{"large":{"h":2048,"resize":"fit","w":2048},"medium":{"h":1200,"resize":"fit","w":1200},"small":{"h":680,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mXZoHReGAq"}]},"favorite_count":172,"favorited":false,"full_text":"本日「 海上保安政策プログラム（ＭＳＰ） 」第１１期生の皆さんが、大臣室に お越しになり、一年間の課程を修了したことの報告を受けました。\nＭＳＰは、海上保安庁と政策研究大学院大学（GRIPS）が共同で提供する《 アジア太平洋地域の海上保安官を対象 》とした 修士課程のプログラムです。 https://t.co/mXZoHReGAq","id_str":"2094394015387144341","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":3,"retweet_count":40,"retweeted":false,"user_id_str":"98478961"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQzOTQwMTUzMjAwNjQwMDA=","text":"本日「 海上保安政策プログラム（ＭＳＰ） 」第１１期生の皆さんが、大臣室に お越しになり、一年間の課程を修了したことの報告を受けました。\nＭＳＰは、海上保安庁と政策研究大学院大学（GRIPS）が共同で提供する《 アジア太平洋地域の海上保安官を対象 》とした 修士課程のプログラムです。\n参加者は、一年間 日本に滞在し、学生として 寝食を共にしながら、海上保安政策について学びます。\n修了後は、各国の海上保安機関に戻り、その中枢で活躍することが 期待されます。\n《 第１１期生は、８か国から １１名が 集まり 》晴れて 全員が 修士号を取得できるとの報告を受けました。\n世界は、海でつながっています。\n安全で、美しく、豊かな海を守っていくことは、一つの国だけでは できません。\nＭＳＰで培われた人と人とのつながりが、各国の海上保安機関間の連携の礎となり、法の支配に基づく自由で開かれた海洋秩序の維持・強化という崇高な目標に向かって、力を合わせて取り組んでいただくことを期待します。\n第１１期生の皆さん、修士号の取得、誠におめでとうございます。今後のさらなる活躍を心より期待しています。"}}},"rest_id":"2094394015387144341","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"5503","state":"EnabledWithCount"}}},"user_id_str":"2916368839"},"rest_id":"2094589483501187508","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"911","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094589483501187508","sortIndex":"2094653795035250633"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":597},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1432867630298419206/Uez_q2Zx_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1312820383532294144/1679630740"},"core":{"created_at":"Sun Oct 04 18:22:33 +0000 2020","name":"デジタル庁","screen_name":"digital_jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzEyODIwMzgzNTMyMjk0MTQ0","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2014529654670164390"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"デジタル庁公式アカウントです。政策やサービスの新着情報を発信します。デジタル庁ウェブサイト: https://t.co/w7z4JlAihT |英語版X:@digital_jpn_en|ソーシャルメディア運用ポリシー: https://t.co/ukune2Dn5V","entities":{"description":{"urls":[{"display_url":"digital.go.jp","expanded_url":"https://www.digital.go.jp/","indices":[47,70],"url":"https://t.co/w7z4J