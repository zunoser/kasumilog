esize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/vjCj64xqab"}]},"favorite_count":18,"favorited":false,"full_text":"【神田眞人ADB総裁からのメッセージ】\n私は、地域の歴史におけるこの重要な局面において、アジア開発銀行（ADB）総裁を引き続き務めることについて、加盟国・地域の皆さまから信任をいただいたことを大変光栄に思います。 https://t.co/vjCj64xqab","id_str":"2094600058499182732","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":11,"retweeted":false,"user_id_str":"1897876536419848192"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"adb.org/ja/news/masato…","expanded_url":"https://www.adb.org/ja/news/masato-kanda-reelected-adb-president-5-year-term","indices":[443,466],"url":"https://t.co/hWoTpv2RHI"}],"user_mentions":[{"id_str":"1368840151699320833","indices":[467,480],"name":"Masato Kanda","screen_name":"ADBPresident"}]},"id":"Tm90ZVR3ZWV0OjIwOTQ2MDAwNTgzNzMzMTI1MTI=","richtext":{"richtext_tags":[]},"text":"【神田眞人ADB総裁からのメッセージ】\n私は、地域の歴史におけるこの重要な局面において、アジア開発銀行（ADB）総裁を引き続き務めることについて、加盟国・地域の皆さまから信任をいただいたことを大変光栄に思います。\n\nアジア・太平洋地域は、前回の危機から経済が十分に回復しないうちに新たなショックに見舞われており、国際秩序もここ数世代で最も厳しい緊張状態にあります。こうした中、ADBは地域の安定の錨（いかり）でなければなりません。しかし、安定とは現状維持を意味するものではありません。私たちは、今日の人々を守るとともに、次世代のためにより明るい未来を築くため、加盟国・地域が必要とするスピードと規模で資金や支援を動員しなければなりません。\n\n私にとって、これこそが今後果たすべき使命です。すなわち、各国が今日直面する課題を乗り越えられるよう支援するとともに、次の世代が明日必要とする強靱性と機会を築くことです。私は、その取組を皆さまと共に前進させていけることに、深く感謝しています。\n\nhttps://t.co/hWoTpv2RHI\n@ADBPresident"}}},"rest_id":"2094600058499182732","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3075","state":"EnabledWithCount"}}},"user_id_str":"331514169"},"rest_id":"2094619364767252906","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{