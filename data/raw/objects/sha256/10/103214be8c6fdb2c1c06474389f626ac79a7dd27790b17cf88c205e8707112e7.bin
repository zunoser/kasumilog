8,"x":364,"y":677},{"h":43,"w":43,"x":740,"y":287},{"h":94,"w":94,"x":428,"y":127}]},"orig":{"faces":[{"h":37,"w":37,"x":83,"y":80},{"h":37,"w":37,"x":39,"y":79},{"h":37,"w":37,"x":148,"y":80},{"h":35,"w":35,"x":160,"y":80},{"h":39,"w":39,"x":515,"y":79},{"h":34,"w":34,"x":820,"y":81},{"h":38,"w":38,"x":364,"y":677},{"h":43,"w":43,"x":740,"y":287},{"h":94,"w":94,"x":428,"y":127}]},"small":{"faces":[{"h":24,"w":24,"x":55,"y":53},{"h":24,"w":24,"x":26,"y":52},{"h":24,"w":24,"x":99,"y":53},{"h":23,"w":23,"x":107,"y":53},{"h":26,"w":26,"x":345,"y":52},{"h":22,"w":22,"x":549,"y":54},{"h":25,"w":25,"x":243,"y":453},{"h":28,"w":28,"x":495,"y":192},{"h":62,"w":62,"x":286,"y":85}]}},"id_str":"2106164455763791872","indices":[141,164],"media_key":"3_2106164455763791872","media_results":{"result":{"media_key":"3_2106164455763791872"}},"media_url_https":"https://pbs.twimg.com/media/HTqZaeBa0AA1NMV.jpg","original_info":{"focus_rects":[{"h":568,"w":1015,"x":0,"y":198},{"h":901,"w":901,"x":0,"y":0},{"h":901,"w":790,"x":0,"y":0},{"h":901,"w":451,"x":0,"y":0},{"h":901,"w":1015,"x":0,"y":0}],"height":901,"width":1015},"sizes":{"large":{"h":901,"resize":"fit","w":1015},"medium":{"h":901,"resize":"fit","w":1015},"small":{"h":604,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/UMgah8s3sl"}]},"favorite_count":2115,"favorited":false,"full_text":"１．北朝鮮は本日６時３６分頃、北朝鮮東岸付近から、少なくとも１発の弾道ミサイルを、北東方向に向けて発射しました。詳細については現在日米韓で緊密に連携して分析中ですが、発射された弾道ミサイルは、最高高度約９０ｋｍ程度で、約６８０ｋｍ程度飛翔し、落下したのは日本海の我が国の排他的経済 https://t.co/UMgah8s3sl","id_str":"2106164818113876240","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":46,"quoted_status_id_str":"2106145580795957552","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2106145580795957552","url":"https://t.co/oyXH9crFVu"},"reply_count":69,"retweet_count":717,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDYxNjQ4MTgwNDI2MTM3NjA=","text":"１．北朝鮮は本日６時３６分頃、北朝鮮東岸付近から、少なくとも１発の弾道ミサイルを、北東方向に向けて発射しました。詳細については現在日米韓で緊密に連携して分析中ですが、発射された弾道ミサイルは、最高高度約９０ｋｍ程度で、約６８０ｋｍ程度飛翔し、落下したのは日本海の我が国の排他的経済水域（ＥＥ\nＺ）外であると推定しています。\n\n２． 政府より、付近を航行する航空機や船舶への情報提供を行ったところ、現時点において被害報告等の情報は確認されていません。\n\n３．総理には、本件について直ちに報告を行い、\n① 情報収集・分析に全力を挙げ、国民に対して、迅速・的確な\n情報提供を行うこと\n② 航空機、船舶等の安全確認を徹底すること\n③ 不測の事態に備え、万全の態勢をとること\nの３点について指示がありました。\n\n４．政府においては、官邸危機管理センターに設置している「北朝鮮情勢に関する官邸対策室」において、関係省庁からの情報を集約するとともに、緊急参集チームを招集し、対応について協議を行いました。\n\n５．また、防衛省においては、防衛大臣が総理指示を受け、\n① 米国、韓国等と緊密に連携しつつ、情報収集・分析に全力を挙げ\nること\n② 不測の事態の発生に備え、引き続き警戒監視に万全を期すこと\nの２点について指示を出しました。\n\n６．これまでの弾道ミサイル等の度重なる発射も含め、一連の北朝鮮の行動は、我が国、地域及び国際社会の平和と安全を脅かすものです。また、このような弾道ミサイル発射は、関連する安保理決議に違反し、国民の安全に関わる重大な問題です。我が国としては、北朝鮮に対して厳重に抗議し、強く非難しました。\n\n７．国民の生命・財産を守り抜くため、引き続き、米国や韓国等とも緊密に連携し、情報の収集・分析及び警戒監視に全力をあげるとともに、今後追加して公表すべき情報を入手した場合には、速やかに発表することとします。"}}},"previous_counts":{"bookmark_count":0,"favorite_count":18,"quote_count":1,"reply_count":0,"retweet_count":9},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":fa