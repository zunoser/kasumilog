lse,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":18,"retweet_count":176,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[220,227],"text":"高等工科学校"},{"indices":[229,233],"text":"入校式"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/gsdf/yt_sch/","expanded_url":"https://www.mod.go.jp/gsdf/yt_sch/","indices":[251,274],"url":"https://t.co/Mh2DNoCixA"},{"display_url":"mod.go.jp/gsdf/yt_sch/pd…","expanded_url":"https://www.mod.go.jp/gsdf/yt_sch/pdf/2026panhu.pdf","indices":[293,316],"url":"https://t.co/LtcsAPDHzB"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY3MjAxOTIwMTM0MjI1OTI=","text":"10月4日、小泉防衛大臣は、陸上自衛隊高等工科学校創立71周年記念行事に出席し、生徒や学校職員などに対して訓示を行いました。\n本校は、昭和30年に「生徒制度」を発足させて以来、優れた人材の育成に取り組み、日本の防衛を担う人材を数多く輩出しています。これからも歴史と伝統を継承しつつ、時代の変化に伴う教育の充実に努め、将来の防衛力を支える人材育成の歩みを進めます。\n高等工科学校は、令和10年度から陸海空共同、男女共学の学校になります。\n \n#高等工科学校　\n#入校式　\n \n👇高等工科学校HPはこちら\nhttps://t.co/Mh2DNoCixA\n👇高等工科学校パンフレットはこちら\nhttps://t.co/LtcsAPDHzB"}}},"rest_id":"2106720192097399062","unmention_data":{},"views":{"count":"77370","state":"EnabledWithCount"}}},"rest_id":"2106729935327138111","unmention_data":{},"views":{"count":"105867","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106729935327138111","sortIndex":"2107003692073877450"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url"