_until_msecs":"1790988391000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":192,"bookmarked":false,"conversation_id_str":"2106168985075200460","created_at":"Fri Oct 02 23:46:31 +0000 2026","display_text_range":[0,114],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/y9EWFotWP6","expanded_url":"https://x.com/takaichi_sanae/status/2106168985075200460/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2106168909347090433","indices":[115,138],"media_key":"3_2106168909347090433","media_results":{"result":{"media_key":"3_2106168909347090433"}},"media_url_https":"https://pbs.twimg.com/media/HTqdds6a8AEk5IB.jpg","original_info":{"focus_rects":[{"h":1784,"w":3186,"x":0,"y":616},{"h":2400,"w":2400,"x":313,"y":0},{"h":2400,"w":2105,"x":461,"y":0},{"h":2400,"w":1200,"x":913,"y":0},{"h":2400,"w":3186,"x":0,"y":0}],"height":2400,"width":3186},"sizes":{"large":{"h":1543,"resize":"fit","w":2048},"medium":{"h":904,"resize":"fit","w":1200},"small":{"h":512,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/y9EWFotWP6"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/y9EWFotWP6","expanded_url":"https://x.com/takaichi_sanae/status/2106168985075200460/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2106168909347090433","indices":[115,138],"media_key":"3_2106168909347090433","media_results":{"result":{"media_key":"3_2106168909347090433"}},"media_url_https":"https://pbs.twimg.com/media/HTqdds6a8AEk5IB.jpg","original_info":{"focus_rects":[{"h":1784,"w":3186,"x":0,"y":616},{"h":2400,"w":2400,"x":313,"y":0},{"h":2400,"w":2105,"x":461,"y":0},{"h":2400,"w":1200,"x":913,"y":0},{"h":2400,"w":3186,"x":0,"y":0}],"height":2400,"width":3186},"sizes":{"large":{"h":1543,"resize":"fit","w":2048},"medium":{"h":904,"resize":"fit","w":1200},"small":{"h":512,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/y9EWFotWP6"}]},"favorite_count":9769,"favorited":false,"full_text":"世界のエネルギー環境が大きく変化する今、日本のエネルギー・資源安全保障を強化し、「成長」と「脱炭素」を両立する戦略を加速させていくことが重要です。\n\nその一環として先の国会で成立した『改正建築物省エネ法』について、ご紹介します。 https://t.co/y9EWFotWP6","id_str":"2106168985075200460","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":128,"reply_count":566,"retweet_count":1325,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDYxNjg5ODUwMDM5OTkyMzI=","richtext":{"richtext_tags":[]},"text":"世界のエネルギー環境が大きく変化する今、日本のエネルギー・資源安全保障を強化し、「成長」と「脱炭素」を両立する戦略を加速させていくことが重要です。\n\nその一環として先の国会で成立した『改正建築物省エネ法』について、ご紹介します。\n\n住宅・建築物分野は、我が国のCO2排出量の約4割を占めています。\n「カーボンニュートラル」の実現に向けて、この分野の「脱炭素化」は待ったなしです。\n\n今回の改正では、エアコンや給湯といった建物使用時の省エネ性能の評価に加えて、建材の製造から建設、維持管理、解体に至るまで、いわば「建築物のライフサイクルトータル」でのCO2排出量を「見える化」し評価する「新たな仕組み」を、2028年度から開始します。\n\nこの制度により、建築物のストックを有効活用する取組や、省エネ・省資源・脱炭素に取り組む建材・設備製造事業者等の取組が、新たに評価されるようになり、例えば、木造の建築物の「低炭素価値」を定量的に評価できるようになります。\n\nこれらの取組を通じて、設計・施工のやり方や建材・設備の「技術革新」と「実装化」を図り、日本企業が持つ製品・技術の海外展開を力強く後押ししてまいります。\n\n「省エネ」と「脱炭素」への挑戦は、単なる環境政策ではありません。\n高市内閣が掲げる「成長投資」そのものです。\n脱炭素に取り組む企業や地域の努力が正しく評価され、新たな環境価値が市場で認められる好循環を生み出すことで、「強い経済」と「豊かな暮らし」を実現していきます。\n\n「国民の皆様の暮らし」と「日本経済」を守り抜くため、「エネルギー安全保障の強化」と「産業競争力の向上」を両立させる脱炭素政策を、政府一丸となって力強く推進してまいります。"}}},"rest_id":"2106168985075200460","unmention_data":{},"views":{"count":"364630","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106168985075200460","sortIndex":"2107003692073877424"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1770198,"following":47},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligibl