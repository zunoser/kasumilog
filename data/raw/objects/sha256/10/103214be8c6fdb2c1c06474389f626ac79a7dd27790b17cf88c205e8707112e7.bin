"unmention_data":{},"views":{"count":"12846","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106217687521038647","sortIndex":"2107003692073877427"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3010945,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":568,"tweets":1842},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2106177179436609946"],"editable_until_msecs":"1790990345000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":346,"bookmarked":false,"conversation_id_str":"2106177179436609946","created_at":"Sat Oct 03 00:19:05 +0000 2026","display_text_range":[0,46],"entities":{},"favorite_count":11449,"favorited":false,"full_text":"先の国会で成立した『労働者災害補償保険法等の一部を改正する法律』について、ご紹介いたします。","id_str":"2106177179436609946","is_quote_status":false,"lang":"ja","quote_count":160,"reply_count":654,"retweet_count":1580,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDYxNzcxNzkzNjExMjg0NDg=","text":"先の国会で成立した『労働者災害補償保険法等の一部を改正する法律』について、ご紹介いたします。\n\n労災保険制度は、労働者が業務や通勤により傷病を負った場合に、必要な療養の給付や休業の補償（別途支給される特別支給金とあわせて平均賃金の8割相当）、障害が残った場合の年金の支給、さらに不幸にして亡くなられた場合には御遺族に対する年金の給付などを行うものです。\n\n原則として労働者を使用するすべての事業に適用され、その費用は事業主が負担する保険料によって賄われています。\n\n今回の改正は、就業構造の変化や働き方の多様化を踏まえ、次のような見直しにより、労働災害に対するセーフティネットの充実を図るものです。\n\n第1に、御遺族に支払われる年金について、労働者である妻が死亡した場合には、夫に支払われるのは、妻の死亡時に55歳以上であるか一定の障害の状態にある場合に限られていましたが、この要件を撤廃し、すべての夫に支払われるようにします。\n\n第2に、労災の給付の請求権の消滅時効期間は、2年間でしたが、脳・心臓疾患、精神疾患など、災害補償の対象に該当するか容易に判断できない疾病について、5年間とします。\n\n第3に、労災保険は、原則、労働者を使用するすべての事業に適用されますが、当分の間の暫定措置として、農林水産業の小規模な個人経営の事業の一部について、任意適用となっていました。\n他方で、農林水産業でも重大事故が見られるため、今回、この暫定措置を廃止します。\n\n第4に、一人親方等、労働者に準じて保護するにふさわしい者について、手続等を行う「特別加入団体」を通じて、特別に労災保険への加入を認めていますが、この「特別加入団体」の要件を法令に位置付け、業務改善命令等を行えるようにします。\n\nこれらの見直しは、令和9年4月1日（第3は公布日から5年以内の政令で定める日）から施行されます。こうした取組により労働災害に対するセーフティネットを充実させ、誰もが安心して働き続けられる環境を整備してまいります。"}}},"rest_id":"2106177179436609946","unmention_data":{},"views":{"count":"539598","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106177179436609946","sortIndex":"2107003692073877426"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":53},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1103507033079242752/zm3-5c2b_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1178494159/1570511962"},"core":{"created_at":"Thu Feb 14 10:16:42 +0000 2013","name":"法務省","screen_name":"MOJ_HOUMU"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTc4NDk0MTU5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関1-1-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"法務省の公式アカウントです。法務省ホームページに掲載する情報を中心に，法務省からお知らせしたい情報を発信します。\n運用方針はこちらです。→https://t.co/xUDg7yFxpk","entities":{"description":{"urls":[{"display_url":"moj.go.jp/hisho/kouhou/h…","expanded_url":"https://www.moj.go.jp/hisho/kouhou/hisho06_00190.html","indices":[69,92],"url":"https://t.co/xUDg7yFxpk"}]},"url":{"urls":[{"display_url":"moj.go.jp","expanded_url":"https://www.moj.go.jp/","indices":[0,23],"url":"https://t.co/TXATknTGxK"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","prof