tes_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3010945,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":568,"tweets":1842},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2106265391815446989"],"editable_until_msecs":"1791011376000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":187,"bookmarked":false,"conversation_id_str":"2106265391815446989","created_at":"Sat Oct 03 06:09:36 +0000 2026","display_text_range":[0,108],"entities":{},"favorite_count":15171,"favorited":false,"full_text":"変化が速い時代の中で、経済を支え、社会課題を解決する上で重要な役割を担うのがスタートアップです。\n\n高市内閣では、日本の優れた技術を活用した、世界で活躍するスタートアップの創出・成長発展を支援する取組を進めています。","id_str":"2106265391815446989","is_quote_status":false,"lang":"ja","quote_count":294,"reply_count":1796,"retweet_count":1632,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDYyNjUzOTE3NjA5MTY0ODA=","richtext":{"richtext_tags":[]},"text":"変化が速い時代の中で、経済を支え、社会課題を解決する上で重要な役割を担うのがスタートアップです。\n\n高市内閣では、日本の優れた技術を活用した、世界で活躍するスタートアップの創出・成長発展を支援する取組を進めています。\n\nその一環として、先の国会に提出し、成立した『科学技術・イノベーション創出の活性化に関する法律の一部を改正する法律』をご紹介します。\n\n本改正法では、先端的な技術を活用したスタートアップを育てるためのグローバル拠点を含めた環境作りを進める「グローバル・スタートアップ・キャンパス構想」を実現するため、その拠点の運営を担うとともに、実用化研究開発や事業化の支援、人材育成、研究者と大企業や投資家の交流促進に向けた取組などを行う『先端技術研究成果活用推進機構』を設立するための規定を整備しました。\n\n民間の組織である機構が「グローバル・スタートアップ・キャンパス構想」の中核を担うことで、スタートアップに対する支援を、変化が速い時代の中でも柔軟かつ機動的に行っていきます。\n\nまた、拠点の運営を担う機構が国内外の結節点となり、日本経済を支え、我々の生活を便利で豊かにするスタートアップの創出、ひいては、イノベーション・エコシステムのハブの構築を目指していきます。"}}},"rest_id":"2106265391815446989","unmention_data":{},"views":{"count":"616902","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106265391815446989","sortIndex":"2107003692073877432"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/8