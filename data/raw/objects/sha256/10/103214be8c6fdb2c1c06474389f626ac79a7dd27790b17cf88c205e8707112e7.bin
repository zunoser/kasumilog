542987614527931/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2106542908803538944","indices":[123,146],"media_key":"3_2106542908803538944","media_results":{"result":{"media_key":"3_2106542908803538944"}},"media_url_https":"https://pbs.twimg.com/media/HTvxnVdaYAAxSAK.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":542},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":0,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/XBOixoKK7l"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/XBOixoKK7l","expanded_url":"https://x.com/takaichi_sanae/status/2106542987614527931/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2106542908849762304","indices":[123,146],"media_key":"3_2106542908849762304","media_results":{"result":{"media_key":"3_2106542908849762304"}},"media_url_https":"https://pbs.twimg.com/media/HTvxnVobsAAuYSt.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":0,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/XBOixoKK7l"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/XBOixoKK7l","expanded_url":"https://x.com/takaichi_sanae/status/2106542987614527931/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2106542908858048512","indices":[123,146],"media_key":"3_2106542908858048512","media_results":{"result":{"media_key":"3_2106542908858048512"}},"media_url_https":"https://pbs.twimg.com/media/HTvxnVqaIAADatF.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":1260,"y":0},{"h":2836,"w":2488,"x":1608,"y":0},{"h":2836,"w":1418,"x":2254,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/XBOixoKK7l"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/XBOixoKK7l","expanded_url":"https://x.com/takaichi_sanae/status/2106542987614527931/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":100,"w":100,"x":244,"y":952}]},"medium":{"faces":[{"h":58,"w":58,"x":142,"y":557}]},"orig":{"faces":[{"h":200,"w":200,"x":488,"y":1904}]},"small":{"faces":[{"h":33,"w":33,"x":81,"y":316}]}},"id_str":"2106542908841308160","indices":[123,146],"media_key":"3_2106542908841308160","media_results":{"result":{"media_key":"3_2106542908841308160"}},"media_url_https":"https://pbs.twimg.com/media/HTvxnVmasAAN8HZ.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":181},{"h":2836,"w":2836,"x":1260,"y":0},{"h":2836,"w":2488,"x":1608,"y":0},{"h":2836,"w":1418,"x":2254,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/XBOixoKK7l"}]},"favorite_count":20198,"favorited":false,"full_text":"中東情勢が不安定化する中、政府の目詰まり解消への取組の最新状況をお伝えします。\n\n原油については、調達先の多角化が進展しています。\n10月は、スエズ運河経由のタンカーが到着する目途が立っており、前年平月比で約10割の調達が実現できる見通しです。 https://t.co/XBOixoKK7l","id_str":"2106542987614527931","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":335,"reply_count":834,"retweet_count":3512,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY1NDI5ODc1MzQ4MjM0MjQ=","richtext":{"richtext_tags":[]},"text":"中東情勢が不安定化する中、政府の目詰まり解消への取組の最新状況をお伝えします。\n\n原油については、調達先の多角化が進展しています。\n10月は、スエズ運河経由のタンカーが到着する目途が立っており、前年平月比で約10割の調達が実現できる見通しです。\nこのため、10月も国家備蓄放出の決定を行わないこととします。（資料1）\n今後も代替調達を進め、備蓄の放出を抑えながら、「日本全体として必要となる量」を確保していきます。\n\nナフサについても、国内での精製、代替調達、川中の製品調達が安定的に継続しており、川中在庫は平時の水準（2か月分）に回復しました。\nナフサ由来の化学製品の供給も安定的に推移しています。\n\n燃料油や化学製品の目詰まりの相談は劇的に減少しており、供給要請を頂いた案件は、最近要請頂いた案件を除き、対応を完了しました。\n追加のご相談や要請を頂きましたら、速やかに対応してまいります。（資料2）\n\n塗料・シンナーについては、6月に工務店をはじめとする最終需要家の皆様へのシンナー直接販売スキームを立ち上げましたが、この2か月間、追加の申し込みはありません。\n\n一人親方などからの「建設・住宅資材」の供給要請、自動車整備工場などからの「エンジンオイル」の供給要請についても、対応を完了しました。（資料3、資料4）\n\n国民の皆様の命に直結する医療分野においては、目詰まりが確認できた「115品目」の全てについて、目詰まりを解消しました。\n「医療用手袋」、「分包紙」、「薬剤容器」については、追加の相談を頂いた場合には、速やかにお届けできるようにしています。（資料5）\n\n包装資材や農業資材の不足にお悩みの「パン・菓子等販売店」や「園芸農家」についても、プッシュ型調査を進めた結果、把握した全ての目詰まりへの対応が完了しました。（資料6）\n\n引き続き、中東情勢の変化を注視しつつ、目詰まりなど国民の皆様の命や暮らしを支える分野でのお困りごとを、一件一件、着実に解消していきます。\n\n高市内閣は、「代替調達の促進」と「目詰まり」の解消を進め、国民の皆様の命と暮らし、そして経済活動に支障が生じないよう全力で取り組みます。"}}},"rest_id":"2106542987614527931","unmention_data":{},"views":{"count":"956180","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106542987614527931","sortIndex":"2107003692073877438"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTwee