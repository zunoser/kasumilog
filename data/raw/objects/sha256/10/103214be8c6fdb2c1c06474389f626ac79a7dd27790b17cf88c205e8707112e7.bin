してみませんか？\n\nhttps://t.co/kypEWbe6Mr\n\n■完成報告会の様子はこちら（期間限定配信：10月6日まで）\nhttps://t.co/p5OnDIBqTf"}}},"rest_id":"2106610293329817846","unmention_data":{},"views":{"count":"35246","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106610293329817846","sortIndex":"2107003692073877441"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3010945,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":568,"tweets":1842},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2106605676047077883"],"editable_until_msecs":"1791092506000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1418,"bookmarked":false,"conversation_id_str":"2106605676047077883","created_at":"Sun Oct 04 04:41:46 +0000 2026","display_text_range":[0,116],"entities":{},"favorite_count":46264,"favorited":false,"full_text":"沖縄県那覇市で発生した強盗殺人事件に関し、お亡くなりになった方に哀悼の意を表しますとともに、御遺族の皆様にお悔やみを申し上げます。\n 本件については沖縄県警による捜査が継続していますが、本日、米海兵隊員が逮捕されたと承知しています。","id_str":"2106605676047077883","is_quote_status":false,"lang":"ja","quote_count":1239,"reply_count":3122,"retweet_count":5021,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY2MDU2NzYwMDA5MDcyNjQ=","text":"沖縄県那覇市で発生した強盗殺人事件に関し、お亡くなりになった方に哀悼の意を表しますとともに、御遺族の皆様にお悔やみを申し上げます。\n 本件については沖縄県警による捜査が継続していますが、本日、米海兵隊員が逮捕されたと承知しています。\n \nこのように極めて残忍で凶悪な事件の発生は極めて遺憾であり、日本政府として米側に強く抗議するとともに、捜査への最大限の協力、米軍関係者の綱紀粛正と事件・事故の再発防止の徹底を強く求めたところです。\n \n政府として、本件事案の対応につき、万全を期してまいります。"}}},"rest_id":"2106605676047077883","unmention_data":{},"views":{"count":"5702194","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106605676047077883","sortIndex":"2107003692073877440"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injecti