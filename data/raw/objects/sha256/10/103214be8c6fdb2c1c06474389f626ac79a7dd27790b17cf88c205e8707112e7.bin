rects":[{"h":1147,"w":2048,"x":0,"y":92},{"h":1366,"w":1366,"x":0,"y":0},{"h":1366,"w":1198,"x":0,"y":0},{"h":1366,"w":683,"x":0,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GiFYkeBbYF"}]},"favorite_count":1387,"favorited":false,"full_text":"10月4日、小泉防衛大臣は、陸上自衛隊高等工科学校創立71周年記念行事に出席し、生徒や学校職員などに対して訓示を行いました。 https://t.co/GiFYkeBbYF","id_str":"2106720192097399062","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":18,"retweet_count":176,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[220,227],"text":"高等工科学校"},{"indices":[229,233],"text":"入校式"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/gsdf/yt_sch/","expanded_url":"https://www.mod.go.jp/gsdf/yt_sch/","indices":[251,274],"url":"https://t.co/Mh2DNoCixA"},{"display_url":"mod.go.jp/gsdf/yt_sch/pd…","expanded_url":"https://www.mod.go.jp/gsdf/yt_sch/pdf/2026panhu.pdf","indices":[293,316],"url":"https://t.co/LtcsAPDHzB"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY3MjAxOTIwMTM0MjI1OTI=","text":"10月4日、小泉防衛大臣は、陸上自衛隊高等工科学校創立71周年記念行事に出席し、生徒や学校職員などに対して訓示を行いました。\n本校は、昭和30年に「生徒制度」を発足させて以来、優れた人材の育成に取り組み、日本の防衛を担う人材を数多く輩出しています。これからも歴史と伝統を継承しつつ、時代の変化に伴う教育の充実に努め、将来の防衛力を支える人材育成の歩みを進めます。\n高等工科学校は、令和10年度から陸海空共同、男女共学の学校になります。\n \n#高等工科学校　\n#入校式　\n \n👇高等工科学校HPはこちら\nhttps://t.co/Mh2DNoCixA\n👇高等工科学校パンフレットはこちら\nhttps://t.co/LtcsAPDHzB"}}},"rest_id":"2106720192097399062","unmention_data":{},"views":{"count":"77370","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106720192097399062","sortIndex":"2107003692073877449"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265181,"following":43},"relationship_perspe