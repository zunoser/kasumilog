=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1684","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2092023234757808145","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"454","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092023234757808145","sortIndex":"2092033084634431488"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2981535,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":516,"tweets":1725},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2091895563721793612"],"editable_until_msecs":"1787585342000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":164,"bookmarked":false,"conversation_id_str":"2091895563721793612","created_at":"Mon Aug 24 14:29:02 +0000 2026","display_text_range":[0,99],"entities":{},"favorite_count":11298,"favorited":false,"full_text":"本日、午後8時頃から開催された「ウクライナに関する有志連合オンライン首脳会合」に出席し、私から以下を申し上げました。\n\nまず、ウクライナが独立35周年を迎えたことについて、心からお祝い申し上げます。","id_str":"2091895563721793612","is_quote_status":false,"lang":"ja","quote_count":250,"reply_count":1021,"retweet_count":1289,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTE4OTU1NjM2NjMwNjkxODQ=","richtext":{"richtext_tags":[]},"text":"本日、午後8時頃から開催された「ウクライナに関する有志連合オンライン首脳会合」に出席し、私から以下を申し上げました。\n\nまず、ウクライナが独立35周年を迎えたことについて、心からお祝い申し上げます。\n\nロシアによる侵略に日々対峙している、ゼレンスキー大統領を始めとするウクライナの人々の勇敢さに改めて敬意を表します。\n\n力による一方的な現状変更の試みを容認すべきではない、という原則的考えの重要性は不変です。\n\nウクライナにおける露朝軍事協力や中露の連携強化が示すように、欧州・大西洋とインド太平洋の安全保障は不可分です。\n\n我が国を取り巻く安全保障環境も、一層厳しさを増しています。\n\nそうした中、同盟国・同志国などとの連携がますます重要です。\n\nウクライナについては、一日でも早く、公正かつ永続的な平和をもたらすために、国際社会が結束して、ウクライナを支えていくことが不可欠です。\n\n我が国は、これまでも、官民一体となった復旧・復興支援を含め、ウクライナの社会・経済強靱化の取組に貢献してきました。\n\n国際社会と連携しつつ、我が国にできるウクライナ支援及び対露制裁にしっかり取り組んでいきます。\n\n我が国は、ウクライナと共にあり、その方針に揺るぎはありません。"}}},"rest_id":"2091895563721793612","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"426209","state":"EnabledWithCount"}}}}},"entryId":"tweet-2091895563721793612","sortIndex":"2092033084634431487"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url