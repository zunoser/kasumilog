nment"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2091668954360184968"],"editable_until_msecs":"1787531314706","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2091668954360184968","created_at":"Sun Aug 23 23:28:34 +0000 2026","display_text_range":[0,140],"entities":{"hashtags":[{"indices":[56,61],"text":"はくおう"}],"user_mentions":[{"id_str":"1182556649120075776","indices":[3,19],"name":"防衛省・自衛隊（災害対策）","screen_name":"ModJapan_saigai"}]},"favorite_count":0,"favorited":false,"full_text":"RT @ModJapan_saigai: 【はくおうⅡの宿泊支援（新規予約）】\n防衛省が借り上げている民間船舶「#はくおうⅡ」による食事付き宿泊支援を、8月26日（水）から開始する予定です。\n宿泊支援の予約受付は、本日（24日）正午から熊本県のホームページで開始します。\n詳細は…","id_str":"2091668954360184968","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":251,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/CcgwJY9ims"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2456},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182592351472013314/X9jVEv2u_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1182556649120075776/1570786963"},"core":{"created_at":"Fri Oct 11 07:21:20 +0000 2019","name":"防衛省・自衛隊（災害対策）","screen_name":"ModJapan_saigai"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTgyNTU2NjQ5MTIwMDc1Nzc2","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2091661009849311530"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省・自衛隊の災害対策公式アカウント／災害派遣活動や災害対策に関する最新情報をお届けします。皆さまの安全と暮らしを守るため、災害現場で対応する部隊・隊員たちの姿を迅速にお伝えしていきます。\n災害派遣以外の自衛隊の活動は、統合幕僚監部のアカウントで発信中　https://t.co/P7BIrjGuU5","entities":{"description":{"urls":[{"display_url":"x.com/jointstaffpa","expanded_url":"https://x.com/jointstaffpa","indices":[128,151],"url":"https://t.co/P7BIrjGuU5"}]},"url":{"urls":[{"display_url":"mod.go.jp/js/activity/do…","expanded_url":"https://www.mod.go.jp/js/activity/domestic.html","indices":[0,23],"url":"https://t.co/7Fx4sySSJE"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":261483,"following":24},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1182556649120075776","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1406,"tweets":3511},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/7Fx4sySSJE"}}}},"edit_control":{"edit_tweet_ids":["2091661009849311530"],"editable_until_msecs":"1787529420000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":13,"bookmarked":false,"conversation_id_str":"2091661009849311530","created_at":"Sun Aug 23 22:57:00 +0000 2026","display_text_range":[0,133],"entities":{"hashtags":[{"indices":[35,40],"text":"はくおう"}]},"favorite_count":858,"favorited":false,"full_text":"【はくおうⅡの宿泊支援（新規予約）】\n防衛省が借り上げている民間船舶「#はくおうⅡ」による食事付き宿泊支援を、8月26日（水）から開始する予定です。\n宿泊支援の予約受付は、本日（24日）正午から熊本県のホームページで開始します。\n詳細は以下のリンクをご確認ください。","id_str":"2091661009849311530","is_quote_status":false,"lang":"ja","quote_count":5,"reply_count":7,"retweet_count":251,"retweeted":false,"user_id_str":"1182556649120075776"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[35,40],"text":"はくおう"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"pref.kumamoto.jp/soshiki/219/27…","expanded_url":"https://www.pref.kumamoto.jp/soshiki/219/276703.html","indices":[147,170],"url":"https://t.co/CcgwJY9ims"},{"display_url":"mod.go.jp/j/approach/def…","expanded_url":"https://www.mod.go.jp/j/approach/defense/saigai/index.html","indices":[188,211],"url":"https://t.co/eAcvFFZHmX"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTE2NjEwMDk3ODIyNjM4MDg=","richtext":{"richtext_tags":[]},"text":"【はくおうⅡの宿泊支援（新規予約）】\n防衛省が借り上げている民間船舶「#はくおうⅡ」による食事付き宿泊支援を、8月26日（水）から開始する予定です。\n宿泊支援の予約受付は、本日（24日）正午から熊本県のホームページで開始します。\n詳細は以下のリンクをご確認ください。\n\n「熊本県ホームページ」 https://t.co/CcgwJY9ims\n\n「防衛省・自衛隊ホームページ」 https://t.co/eAcvFFZHmX"}}},"rest_id":"2091661009849311530","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"54458","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2091668954360184968","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"4112","state":"EnabledWithCount"}}}}},"entryId":"tweet-2091668954360184968","sortIndex":"2092033084634431414"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2091516758364659712/mGiK-Tkm?format=jpg&name=800x419","width":800},"type":"IMAGE"}},