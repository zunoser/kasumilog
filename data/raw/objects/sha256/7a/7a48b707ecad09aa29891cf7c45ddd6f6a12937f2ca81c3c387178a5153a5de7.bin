profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2981535,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":516,"tweets":1725},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2091357633366364432"],"editable_until_msecs":"1787457089000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":423,"bookmarked":false,"conversation_id_str":"2091357633366364432","created_at":"Sun Aug 23 02:51:29 +0000 2026","display_text_range":[0,129],"entities":{},"favorite_count":25831,"favorited":false,"full_text":"世界では、「国が一歩前に」出て、官民が手を取り合って、重要な社会課題の解決を目指す、「新たな産業政策」が大きな潮流となっています。\nまた、「地方」には大きな「伸び代」があり、魅力ある地域資源や産業ポテンシャルが多くありますが、まだまだ十分に花開いていません。","id_str":"2091357633366364432","is_quote_status":false,"lang":"ja","quote_count":732,"reply_count":2563,"retweet_count":2917,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTEzNTc2MzMzMDM0MTI3Mzg=","richtext":{"richtext_tags":[]},"text":"世界では、「国が一歩前に」出て、官民が手を取り合って、重要な社会課題の解決を目指す、「新たな産業政策」が大きな潮流となっています。\nまた、「地方」には大きな「伸び代」があり、魅力ある地域資源や産業ポテンシャルが多くありますが、まだまだ十分に花開いていません。\n\n本日は、こうした状況を踏まえ、先の国会に高市内閣として提出し、成立した『産業競争力強化法等の改正法』についても、ご紹介します。\n\n第一に、「大胆な投資促進税制」を創設し、全業種を対象に、大規模かつ高付加価値な国内投資を促進します。\n一定の要件を満たす場合には、機械装置や建物など、生産に必要な設備投資について、幅広く、即時償却又は税額控除7%といった措置が適用されます。\n\n先月31日から、税制の申請受付を開始しました。\n大胆な国内投資に挑戦する日本企業の積極的な活用を期待しています。\n\n第二に、日本の大きな伸び代である「地方」から「強い経済」を実現するため、\n①官民連携で産業用地の整備を進める際の「土地譲渡の課税特例の創設」や、生活環境の保持を前提とした「工場の緑地規制の緩和」などにより、「産業用地の確保を促進」するとともに、\n②地域の生活基盤を支える、小売、運送、交通などの「エッセンシャルサービスを提供する事業者」に対して、「資金供給の円滑化」を支援します。\n\n高市内閣では、こうした措置をはじめ、『日本成長戦略』と『地域未来戦略』のもと、「行き過ぎた緊縮志向」と「未来への投資不足」の流れを断ち切り、「官民投資」を徹底的にてこ入れし、「強い経済」の実現を進めてまいります。"}}},"rest_id":"2091357633366364432","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1448698","state":"EnabledWithCount"}}}}},"entryId":"tweet-2091357633366364432","sortIndex":"2092033084634431407"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2981535,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":516,"tweets":1725},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2091357504013992277"],"editable_until_msecs":"1787457059000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":443,"bookmarked":false,"conversation_id_str":"2091357504013992277","created_at":"Sun Aug 23 02:50:59 +0000 2026","display_text_range":[0,119],"entities":{},"favorite_count":18677,"favorited":false,"full_text":"現在、基礎科学の成果が一気に社会実装され、新たなビジネスにつながる、「科学とビジネスの近接化」とも言える新たな時代に入っています。\n\n世界では、有力企業が、先端技術に巨額の投資競争を繰り広げ、大学が、その受け皿として大きく成長しています。","id_str":"2091357504013992277","is_quote_status":false,"lang":"ja","quote_count":499,"reply_count":941,"retweet_count":2235,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTEzNTc1MDM5NTUzMzcyMTY=","richtext":{"richtext_tags":[]},"text":"現在、基礎科学の成果が一気に社会実装され、新たなビジネスにつながる、「科学とビジネスの近接化」とも言える新たな時代に入っています。\n\n世界では、有力企業が、先端技術に巨額の投資競争を繰り広げ、大学が、その受け皿として大きく成長しています。\n\nこうした時代を日本が勝ち抜き、AI、量子など、戦略技術への支援を抜本的に強化するための法律が、先の国会で成立した『改正産業技術力強化法』です。\n\n第一に、改正法に基づき、『研究開発税制』を抜本強化しました。\n\nAI、量子など「戦略技術領域」の研究開発に挑戦した企業が、試験研究費の最大50％という、前例のない高い控除を受けられることになります。\n令和9年度から、税制の認定を開始予定です。\n\n戦略技術の開発に挑戦する日本企業の積極的な活用を期待しています。\n\n第二に、「戦略技術領域」に関する研究開発計画の認定を受けた事業者が新技術を社会実装するに当たって、現行の制度を見直す必要がある場合には、政府内での情報共有体制を強化し、速やかな規制見直しの検討につなげていきます。\n\n優れた科学技術力は、高市内閣が進める「強い経済」の基盤です。\n\n今日ご紹介した『改正産業技術力強化法』に加え、『日本成長戦略』に基づき、17の戦略分野を中心とする日本の産業競争力強化につながる「新たな大学群の形成」や、ステージに応じた、「スタートアップ・ファイナンス」についても検討を進め、日本の科学技術力を担う企業や研究者の皆様の挑戦を後押しし、「技術で勝って、ビジネスでも勝つ」、『新技術立国』を実現してまいります。"}}},"rest_id":"2091357504013992277","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1240538","state":"EnabledWithCount"}}}}},"entryId":"tweet-2091357504013992277","sortIndex":"2092033084634431406"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/dMNYLfVLKW"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2082019689023345122"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":382449,"following":477},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"571429134","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7881,"tweets":88149},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/yYaoVyKjKO"}}}},"edit_control":{"edit_tweet_ids":["2091350112945807731"],"editable_until_msecs":"1787455296000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_trans