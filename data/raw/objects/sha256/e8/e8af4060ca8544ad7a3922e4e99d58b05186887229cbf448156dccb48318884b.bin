_id_str":"525120344"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[303,310],"text":"チーム印旛沼"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQzOTMzNTE4MDYyMTQxNDQ=","richtext":{"richtext_tags":[]},"text":"【防災情報　28日11時点】                \n◆印旛沼の平均水位　Y.P 1.94ｍ（28日11時現在）               \n印旛沼の水位は常時満水位（Y.P 2.30ｍ）を下回りました。できる限り印旛機場（最大排水能力：毎秒92トン）、大和田機場（最大排水能力：毎秒120トン）の排水運転※を行って水位低下を図ります。            \n※両機場取水地点の水位が低下してきたこと等により最大排水量での運転が難しくなってきたため、排水量の調整や取水に影響が出ないよう慎重に操作しています。\n写真は大和田機場に配置している排水ポンプ車の点検や燃料の給油を行っている状況です。　#チーム印旛沼"}}},"rest_id":"2104393351881740404","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"6243","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2104739722987974748","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"497","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104739722987974748","sortIndex":"2104851539729317816"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1