:137,"x":1993,"y":345},{"h":121,"w":121,"x":256,"y":578}]},"small":{"faces":[{"h":34,"w":34,"x":145,"y":111},{"h":32,"w":32,"x":328,"y":120},{"h":27,"w":27,"x":524,"y":132},{"h":36,"w":36,"x":422,"y":83},{"h":34,"w":34,"x":239,"y":86},{"h":35,"w":35,"x":67,"y":113},{"h":35,"w":35,"x":521,"y":90},{"h":31,"w":31,"x":66,"y":151}]}},"id_str":"2104835249935097856","indices":[42,65],"media_key":"3_2104835249935097856","media_results":{"result":{"media_key":"3_2104835249935097856"}},"media_url_https":"https://pbs.twimg.com/media/HTXgggcaIAAJclA.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0O2Qw6YUWA"}]},"favorite_count":2844,"favorited":false,"full_text":"本日午前、内堀福島県知事、吉田大熊町長、伊澤双葉町長が、官邸にお越し下さりました。 https://t.co/0O2Qw6YUWA","id_str":"2104835289923702917","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":23,"reply_count":166,"retweet_count":327,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ4MzUyODk4NjQ5Mzc0NzI=","richtext":{"richtext_tags":[]},"text":"本日午前、内堀福島県知事、吉田大熊町長、伊澤双葉町長が、官邸にお越し下さりました。\n\n皆様から、帰還困難区域の避難指示解除や除去土壌等の県外最終処分、廃炉、汚染水・処理水対策などの課題や、帰還困難区域の御自宅に泥棒やイノシシが入ることなど多くの方がお困りの切実なお話をお伺いしました。\n\n「福島の復興なくして東北の復興なし、東北の復興なくして日本の再生なし」。\n高市内閣としてもこの方針を堅持し、これまで以上にスピードアップしてまいります。\n\n福島の復興は長い道のりであり、決して風化させてはなりません。\n\n被災地の皆様の声に耳を傾けながら、現場主義に徹したきめ細かな対応により、福島の復興・再生に、国が前面に立って、最後まで、責任貫徹の思いで取り組んでまいります。\n\n細野大臣は、当事者としてこれまで福島や東北の復興に取り組んでこられました。\nその知見の横展開を期待するとともに、地震や豪雨災害への対応を福島県でもしっかり行うべく、細野大臣には、防災大臣も兼務いただくこととしました。\n\n細野大臣には、全ての知見を使って、福島のために働いていただくことを期待しています。\n\n今年度から始まった「第3期復興・創生期間」においても、復興に向けた様々な課題を解決するため、これまで以上に福島の復興に全力で、またスピーディーに取り組んでまいります。"}}},"rest_id":"2104835289923702917","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"94723","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104835289923702917","sortIndex":"2104851539729317876"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2104851539729317901-tweet-2104833969414197269","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072169437722296320/8bWktzdb_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/276848601/1762248306"},"core":{"created_at":"Mon Apr 04 06:12:20 +0000 2011","name":"金融庁","screen_name":"fsa_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNzY4NDg2MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関３－２－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"金融庁の公式アカウントです。\n金融庁ウェブサイトに掲載する情報を中心に情報発信します。#金融