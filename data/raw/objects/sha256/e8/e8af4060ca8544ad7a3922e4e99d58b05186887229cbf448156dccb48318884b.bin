eatures":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2104495779524308992","indices":[98,121],"media_key":"3_2104495779524308992","media_results":{"result":{"media_key":"3_2104495779524308992"}},"media_url_https":"https://pbs.twimg.com/media/HTSrwuna8AAiLke.png","original_info":{"focus_rects":[{"h":245,"w":438,"x":125,"y":0},{"h":245,"w":245,"x":222,"y":0},{"h":245,"w":215,"x":237,"y":0},{"h":245,"w":123,"x":283,"y":0},{"h":245,"w":728,"x":0,"y":0}],"height":245,"width":728},"sizes":{"large":{"h":245,"resize":"fit","w":728},"medium":{"h":245,"resize":"fit","w":728},"small":{"h":229,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mrzLEilHPQ"}]},"favorite_count":1177,"favorited":false,"full_text":"令和８年９月２６日、ロシア海軍ステレグシチー級フリゲート１隻が、与那国島と西表島の間の海域を北東進した後、２７日から２８日にかけて、対馬海峡を北東進し、日本海へ向けて航行したことを確認しました。 https://t.co/mrzLEilHPQ","id_str":"2104496826007146498","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":16,"reply_count":22,"retweet_count":371,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ0OTY4MjU5NTI1NTUwMDk=","richtext":{"richtext_tags":[]},"text":"令和８年９月２６日、ロシア海軍ステレグシチー級フリゲート１隻が、与那国島と西表島の間の海域を北東進した後、２７日から２８日にかけて、対馬海峡を北東進し、日本海へ向けて航行したことを確認しました。\n防衛省・自衛隊は、海上自衛隊の第１水上補給隊所属「とわだ」（呉）及び第３哨戒防備隊所属「しらたか」（佐世保）により、警戒監視・情報収集を行いました。"}}},"rest_id":"2104496826007146498","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"64866","state":"EnabledWithCount"}}},"rest_id":"2104509545594671470","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"48018","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104509545594671470","sortIndex":"2104851539729317797"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3007074,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":554,"tweets":1821},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104504290786062597"],"editable_until_msecs":"1790591497000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":409,"bookmarked":false,"conversation_id_str":"2104504290786062597","created_at":"Mon Sep 28 09:31:37 +0000 2026","display_text_range":[0,88],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/0VUh5twGeB","expanded_url":"https://x.com/takaichi_sanae/status/2104504290786062597/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2104504201539883009","indices":[89,112],"media_key":"3_2104504201539883009","media_results":{"result":{"media_key":"3_2104504201539883009"}},"media_url_https":"https://pbs.twimg.com/media/HTSza9EaEAEAP36.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":385},{"h":2836,"w":2836,"x":1260,"y":0},{"h":2836,"w":2488,"x":1608,"y":0},{"h":2836,"w":1418,"x":2678,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0VUh5twGeB"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/0VUh5twGeB","expanded_url":"https://x.com/takaichi_sanae/status/2104504290786062597/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2104504201539883009","indices":[89,112],"media_key":"3_2104504201539883009","media_results":{"result":{"media_key":"3_2104504201539883009"}},"media_url_https":"https://pbs.twimg.com/media/HTSza9EaEAEAP36.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":385},{"h":2836,"w":2836,"x":1260,"y":0},{"h":2836,"w":2488,"x":1608,"y":0},{"h":2836,"w":1418,"x":2678,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0VUh5twGeB"}]},"favorite_count":20798,"favorited":false,"full_text":"国民の皆様が直面されている「物価高」への対応は、昨年10月の高市内閣発足以来の最優先課題です。\n\nとりわけ、中東情勢は依然として不透明であり、原油価格の見通しは困難な状況です。 https://t.co/0VUh5twGeB","id_str":"2104504290786062597","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":915,"reply_count":2892,"retweet_count":2860,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ1MDQyOTA2ODU0MzU5MDQ=","richtext":{"richtext_tags":[]},"text":"国民の皆様が直面されている「物価高」への対応は、昨年10月の高市内閣発足以来の最優先課題です。\n\nとりわけ、中東情勢は依然として不透明であり、原油価格の見通しは困難な状況です。\nそのため、「国民の皆様の命と暮らし」を守り、「経済活動」に支障を生じさせないよう、「中東情勢等対応予備費」を活用して、ガソリン、軽油・重油・灯油の価格を抑制するための補助を行っています。\n\n軽油は、3月以降、世界的にガソリン以上に価格が上昇傾向にあります。\n\n例えば米国では、直近の7ヶ月程度で、160.7円/ℓ（3月2日時点）が275.5円/ℓ（最新の9月21日時点）と、約1.7倍の水準に上昇しました。\nこの間、米国のガソリン価格の上昇は約1.5倍程度です。\n\nこうした中、日本の軽油価格については、補助がなければ195.3円/ℓ（最新の9月21日時点）でしたが、補助により、軽油価格は同日時点で159.3円/ℓであり、軽油価格についても、日米欧の中で日本が一番安価な状況になっています。\n\n軽油は、公共交通、トラック、農業用のトラクター、漁船や建設用の重機など幅広い用途で使われるため、その価格上昇は、生産・物流コスト上昇により多くの品目の価格上昇につながります。\n\n米国では、軽油の輸出禁止措置を検討しているとの報道がありますが、我が国は必要な軽油のほぼ全てを国内の製油所で製造しており、米国を含めて海外からの輸入に依存している状況にはありません。\n\n中東情勢が物価動向や経済に与える影響を注視しつつ、必要な時にはタイミングを逸することなく、｢中東情勢等対応予備費｣も活用して、国民の皆様の暮らしや経済活動に支障が出ないよう、臨機応変に、必要な対応を実施してまいります。"}}},"rest_id":"2104504290786062597","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1617446","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104504290786062597","sortIndex":"2104851539729317796"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":251,"url":"https://pbs.twimg.com/card_img/2104503929258053632/Erq_wt1t?format=jpg&name=600x314","width":480},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66638","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2104503929258053632/Erq_wt1t?format=jpg&name=280x150","width":200},"type":"IMAGE"}},{"key":"description","value":{"string_value":"令和8年7月29日・30日に開催された「こども霞が関見学デー」の様子を、文部科学省クロスカルチュラルコミュニケーション大使（CCC大使...","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":300,"url":"https://pbs.twimg.com/card_img/2104503929258053632/Erq_wt1t?format=jpg&name=400x400","width":400},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2104503929258053632/Erq_wt1t?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":360,"url":"https://pbs.twimg.com/card_img/2104503929258053632/Erq_wt1t?forma