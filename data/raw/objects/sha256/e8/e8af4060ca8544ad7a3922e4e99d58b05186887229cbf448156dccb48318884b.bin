会議」に際し、書面メッセージを発出しました。茂木大臣は、ウクライナと共にあるとの方針に揺るぎはなく、今後も、全てのウクライナの市民の帰還に向けた外交努力を続けていくという日本の立場を表明しました。\n\nhttps://t.co/gQANa4vYUI"}}},"rest_id":"2104823581947687171","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"4829","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104823581947687171","sortIndex":"2104851539729317872"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":8},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"公正取引委員会の公式アカウントです。 \n公正かつ自由な競争について理解を深めていただくため、措置命令等の報道発表、関係法令（独占禁止法、取適法、フリーランス法、スマホ法等）の解説、イベント・採用情報等をお届けします。 \n#独占禁止法 #取適法 #スマホ法 #フリーランス法","entities":{"description":{},"url":{"urls":[{"display_url":"jftc.go.jp/index.html","expanded_url":"http://www.jftc.go.jp/index.html","indices":[0,23],"url":"https://t.co/izoLg0k5lW"}]}}},"profile_description_language":"ja","profil