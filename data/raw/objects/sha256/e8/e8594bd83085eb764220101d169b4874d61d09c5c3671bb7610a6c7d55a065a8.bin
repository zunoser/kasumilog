応状況の報告発表と、関係部署への指示が行われました。 https://t.co/fGtcoYYuGp","id_str":"2092924321224393037","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":3,"retweet_count":19,"retweeted":false,"user_id_str":"571429134"},"rest_id":"2092924321224393037","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"6620","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092924321224393037","sortIndex":"2093073795966304229"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2093073795966304284-tweet-2092788119078834603","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2092737598343278592/3FOt6rWq?format=png&name=120x120","width":120},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mlit.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2092737598343278592/3FOt6rWq?format=png&name=120x120","width":120},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2092737598343278592/3FOt6rWq?format=png&name=orig","width":120},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"571429134","path":[]}}},{"key":"thumbnai