},{"h":3024,"w":1512,"x":1965,"y":0},{"h":3024,"w":4032,"x":0,"y":0}],"height":3024,"width":4032},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/7SQf9gekSP"}]},"favorite_count":520,"favorited":false,"full_text":"【八代港での給水支援は明日で終了となります】\n本日、明日も以下の時間、場所にて給水支援を行います。\n\n時間：11:00～17:00\n場所：八代港内八代市港町県営6号上屋近く 4.5m岸壁 （〒866-0033 熊本県八代市港町97） https://t.co/7SQf9gekSP","id_str":"2092801919828062608","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":9,"retweet_count":112,"retweeted":false,"user_id_str":"1750343228828844032"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[432,437],"text":"熊本地震"},{"indices":[438,442],"text":"八代市"},{"indices":[443,448],"text":"給水支援"},{"indices":[449,453],"text":"飲用水"},{"indices":[454,458],"text":"八代港"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"city.yatsushiro.lg.jp/kinkyu.html","expanded_url":"https://www.city.yatsushiro.lg.jp/kinkyu.html","indices":[289,312],"url":"https://t.co/fu1eEU3ccR"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI4MDE5MTk3NDgzMDQ4OTY=","richtext":{"richtext_tags":[]},"text":"【八代港での給水支援は明日で終了となります】\n本日、明日も以下の時間、場所にて給水支援を行います。\n\n時間：11:00～17:00\n場所：八代港内八代市港町県営6号上屋近く 4.5m岸壁 （〒866-0033 熊本県八代市港町97）\n\nこれまで、九州地方整備局が所有する船舶「海輝（かいき）」「海煌（かいこう）」から給水を行ってきましたが、8月25日に八代市水道局が水道水を供給している地域の断水が解消されたことから、今後は両船舶の本来の業務である、有明海及び八代海の環境整備等を実施してまいります。\nなお、八代市においては、以下URLの通り引き続き応急給水を行っております。\nhttps://t.co/fu1eEU3ccR\n\nこれまでに延べ1,700名以上の方々にお越しいただき、75,000L以上の給水を実施させていただきました。\n被災された皆さまに心よりお見舞い申し上げますとともに、一日も早い復旧・復興と、安寧な日々が戻りますことをお祈り申し上げます。\n\n#熊本地震 #八代市 #給水支援 #飲用水 #八代港"}}},"previous_counts":{"bookmark_count":0,"favorite_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"rest_id":"2092801919828062608","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"18381","state":"EnabledWithCount"}}},"rest_id":"2092856382701883838","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"6153","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2092869495828427050","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"702","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092869495828427050","sortIndex":"2093073795966304189"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092513935408955862"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"des