6,"w":76,"x":1914,"y":236},{"h":128,"w":128,"x":1352,"y":294},{"h":270,"w":270,"x":636,"y":124}]},"small":{"faces":[{"h":23,"w":23,"x":322,"y":57},{"h":22,"w":22,"x":459,"y":67},{"h":26,"w":26,"x":269,"y":71},{"h":23,"w":23,"x":237,"y":77},{"h":25,"w":25,"x":635,"y":78},{"h":42,"w":42,"x":448,"y":97},{"h":89,"w":89,"x":211,"y":41}]}},"id_str":"2092915149783117825","indices":[73,96],"media_key":"3_2092915149783117825","media_results":{"result":{"media_key":"3_2092915149783117825"}},"media_url_https":"https://pbs.twimg.com/media/HQuHPW_bMAE8WJ8.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":289,"y":0},{"h":1366,"w":1198,"x":373,"y":0},{"h":1366,"w":683,"x":631,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HlYckeZVHz"}]},"favorite_count":740,"favorited":false,"full_text":"／\n📢退職自衛隊員・御家族への支援を強化！\n＼\n \n8月27日、第2回「退職自衛隊員・家族に対する支援の強化に関する検討委員会」を開催しました。 https://t.co/HlYckeZVHz","id_str":"2092915160092680393","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":12,"retweet_count":116,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/support-for-retired/20260827.html","indices":[239,262],"url":"https://t.co/SKbM2vTywl"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI5MTUxNTk5NzUzMDkzMTI=","text":"／\n📢退職自衛隊員・御家族への支援を強化！\n＼\n \n8月27日、第2回「退職自衛隊員・家族に対する支援の強化に関する検討委員会」を開催しました。\n \n小泉防衛大臣から、「退職自衛隊員・家族支援庁（仮称）」の新設に向けて、関連施策を令和9年度概算要求に反映するようにと指示があり、予算案が取りまとめられる年末に向けて引き続き施策の検討を深化させていくこととなりました。\n \n防衛省は、一歩ずつ確実に、退職自衛隊員・御家族への支援強化を進めてまいります。\n \n👇詳しくはこちら\n🔗 https://t.co/SKbM2vTywl"}}},"rest_id":"2092915160092680393","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"28813","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092915160092680393","sortIndex":"2093073795966304226"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/fecUjBHHI0"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092771485316444184"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_typ