https://t.co/M11rSHm483"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/M11rSHm483","expanded_url":"https://x.com/takaichi_sanae/status/2112836965167243301/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2112836595611324416","indices":[114,137],"media_key":"3_2112836595611324416","media_results":{"result":{"media_key":"3_2112836595611324416"}},"media_url_https":"https://pbs.twimg.com/media/HVJNsH3b0AAbwaN.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":542},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":0,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/M11rSHm483"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/M11rSHm483","expanded_url":"https://x.com/takaichi_sanae/status/2112836965167243301/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":124,"w":124,"x":26,"y":928}]},"medium":{"faces":[{"h":72,"w":72,"x":15,"y":543}]},"orig":{"faces":[{"h":248,"w":248,"x":52,"y":1856}]},"small":{"faces":[{"h":41,"w":41,"x":8,"y":308}]}},"id_str":"2112836595514761216","indices":[114,137],"media_key":"3_2112836595514761216","media_results":{"result":{"media_key":"3_2112836595514761216"}},"media_url_https":"https://pbs.twimg.com/media/HVJNsHgaYAA_7Nq.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":114,"y":0},{"h":2836,"w":2488,"x":288,"y":0},{"h":2836,"w":1418,"x":823,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/M11rSHm483"}]},"favorite_count":6226,"favorited":false,"full_text":"【高市内閣発足1周年に当たり⑤】\n\nロシアのウクライナ侵略により、エネルギーや穀物の価格高騰が生じていた中での、内閣総理大臣への就任でした。\n本年2月には、中東情勢により、エネルギーをはじめ、世界的に、物価高騰は加速しました。 https://t.co/M11rSHm483","id_str":"2112836965167243301","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":57,"reply_count":304,"retweet_count":767,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1021kaiken.html","indices":[814,837],"url":"https://t.co/gZivRB3Y5P"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4MzY5NjUwNDk3NjE3OTI=","richtext":{"richtext_tags":[]},"text":"【高市内閣発足1周年に当たり⑤】\n\nロシアのウクライナ侵略により、エネルギーや穀物の価格高騰が生じていた中での、内閣総理大臣への就任でした。\n本年2月には、中東情勢により、エネルギーをはじめ、世界的に、物価高騰は加速しました。\n\nそのような中で、内閣の最優先課題として取り組んできたのが「物価高対策」です。\n就任以来、約10.9兆円の対策を講じてきました。\n\n例えば、\n・「ガソリン・軽油の暫定税率廃止」に1.7兆円、\n・「子育て世帯への支援」に3,677億円、\n・「中東情勢を受けた燃料油補助」に1兆4,085億円、\n・「電気・ガス料金支援」に1兆431億円\nを措置するなど、「切れ目のない物価高対策」に取り組んできました。\n\n2.1兆円措置した「重点支援地方交付金」に基づく措置については、これから地方自治体により執行されるものもあります。\n\nまた、1.8兆円規模の税制改正で措置した｢所得税の負担軽減｣も、納税者お一人あたり、3万円から6万円を、今年の年末調整でお届けします。\n\nこうした政策の効果もあり、「物価上昇率」は、1年前は+2.9%でしたが、今はG7で最も低い水準の+1.9%に抑えられています。\n\nまた、「物価の伸び」を「賃金の伸び」がどれだけ上回ったかを示す「実質賃金上昇率」も、1年前は「マイナス」でしたが、直近では9か月連続プラスで、G7で最も高い水準の1.9%になりました。\n\nしかし、その成果を十分に「実感」できていない方々が多くおられることも、重く受け止めています。\n\n「飲食料品」は、一般的な物価上昇率より高い+3%程度で上昇しています。\n低価格品への切替えなど節約余地の小さい低所得世帯にとって、より大きな負担となっています。\n\nだからこそ、「切れ目のない物価高対策」の手を緩めることなく、『消費税・支援金法案』を今国会に提出させていただきました。\n\n（参考）令和8年10月21日の会見の動画\nhttps://t.co/gZivRB3Y5P"}}},"rest_id":"2112836965167243301","unmention_data":{},"views":{"count":"253544","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112836965167243301","sortIndex":"2112987302270599144"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2112987302270599193-tweet-2112836559380828409","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2046797216074067969/rYuivpB9_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1401738180202622982/1623042842"},"core":{"created_at":"Mon Jun 07 03:11:49 +0000 2021","name":"個人情報保護委員会","screen_name":"PPC_JPN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNDAxNzM4MTgwMjAyNjIyOTgy","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門二丁目２－３　虎ノ門アルセアタワー12階"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"個人情報保護委員会の公式アカウントです。施策や注意喚起情報などを幅広くお伝えしていきます。\n・ソーシャルメディア運用ポリシー　https://t.co/uhy6acc1Dt\n・個人情報保護委員会チャンネル　　https://t.co/C8GWyNGJgB","entities":{"description":{"urls":[{"display_url":"ppc.go.jp/notice/sns_pol…","expanded_url":"https://www.ppc.go.jp/notice/sns_policy/","indices":[63,86],"url":"https://t.co/uhy6acc1Dt"},{"display_url":"youtube.com/@PPC.JPNchannel","expanded_url":"https://www.youtube.com/@PPC.JPNc