itable":true,"quote_count":0,"reply_count":0,"retweet_count":31,"retweeted":false,"user_id_str":"2335919749"},"rest_id":"2112868941802717560","unmention_data":{},"views":{"count":"8342","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112868941802717560","sortIndex":"2112987302270599162"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3030174,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1889},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112863360681406954"],"editable_until_msecs":"1792584454000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":98,"bookmarked":false,"conversation_id_str":"2112863360681406954","created_at":"Wed Oct 21 11:07:34 +0000 2026","display_text_range":[0,104],"entities":{},"favorite_count":9058,"favorited":false,"full_text":"現在、東北地方や北陸地方の日本海側で前線に伴う大雨となっています。\n\n本日（21日）19時45分、秋田県・子吉川に「レベル５氾濫特別警報」が発表されました。\n既に氾濫が発生又は切迫している状況となっています。","id_str":"2112863360681406954","is_quote_status":false,"lang":"ja","quote_count":79,"reply_count":284,"retweet_count":1205,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4NjMzNjA2MjY4NzY0MTY=","richtext":{"richtext_tags":[]},"text":"現在、東北地方や北陸地方の日本海側で前線に伴う大雨となっています。\n\n本日（21日）19時45分、秋田県・子吉川に「レベル５氾濫特別警報」が発表されました。\n既に氾濫が発生又は切迫している状況となっています。\n\n政府としては、警戒態勢強化のため、19時45分、官邸危機管理センターに「官邸連絡室」を設置しました。\n私から、被害状況の把握などの災害応急対策、国民の皆様に対する適時的確な情報提供などを指示し、対応に当たっています。\n\n特別警報が発表中の地域の皆様は、浸水しにくい高い場所などで、直ちに身の安全を確保して下さい。\n屋外の移動が危険な場合は、自宅の２階などへの垂直避難をするなど命を守る行動をとって下さい。\n\n他の地域においても、今後の天候によっては、特別警報が発表される可能性があります。\n雨や風が強くなる前に備えを確認した上で、ラジオ・テレビ・インターネットなどで、自治体からの最新の避難情報に十分注意し、少しでも危険を感じれば、躊躇せず、早め早めに自らの命を守る行動をとっていただきますようお願いいたします。"}}},"rest_id":"2112863360681406954","unmention_data":{},"views":{"count":"890931","stat