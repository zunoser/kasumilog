けできるよう努力してまいります。\n\n#aichinagoya2026 \n#asiangames \n#アジア大会"}}},"rest_id":"2112792037829542136","unmention_data":{},"views":{"count":"24226","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112792037829542136","sortIndex":"2112987302270599102"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/GT00tFU6kMY","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2112440345766326272/2VmVEJ9k?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":158,"url":"https://pbs.twimg.com/card_img/2112440345766326272/2VmVEJ9k?format=jpg&name=280x280","width":280},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66518","type":"STRING"}},{"key":"description","value":{"string_value":"この地には、実証する場所がある。サポートがある。仲間がいる。様々な挑戦が交わり、未来がまさに今つくられている。この動画では、そんな...","type":"STRING"}},{"key":"player_width","value":{"string_value":"1280","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"10228272","path":[]}}},{"key":"player_image_original","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2112440345766326272/2VmVEJ9k?format=jpg&name=orig","width":1280},"type":"IMAGE"}},{"key":"app_num_ratings","value":{"string_value":"49,521,408","type":"STRING"}},{"key":"app_price_amount","value":{"string_value":"0.0","t