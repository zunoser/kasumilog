、今田耕司さんの写真の隣に吹き出しで「官民ワンチームで連携?」と書かれている。下部には大きく「新薬開発を支援する創薬エコシステム」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":36,"w":36,"x":566,"y":56},{"h":37,"w":37,"x":47,"y":209},{"h":39,"w":39,"x":94,"y":458},{"h":48,"w":48,"x":502,"y":424},{"h":63,"w":63,"x":301,"y":423}]},"medium":{"faces":[{"h":36,"w":36,"x":566,"y":56},{"h":37,"w":37,"x":47,"y":209},{"h":39,"w":39,"x":94,"y":458},{"h":48,"w":48,"x":502,"y":424},{"h":63,"w":63,"x":301,"y":423}]},"orig":{"faces":[{"h":36,"w":36,"x":566,"y":56},{"h":37,"w":37,"x":47,"y":209},{"h":39,"w":39,"x":94,"y":458},{"h":48,"w":48,"x":502,"y":424},{"h":63,"w":63,"x":301,"y":423}]},"small":{"faces":[{"h":25,"w":25,"x":400,"y":39},{"h":26,"w":26,"x":33,"y":148},{"h":27,"w":27,"x":66,"y":324},{"h":34,"w":34,"x":355,"y":300},{"h":44,"w":44,"x":213,"y":299}]}},"id_str":"2112433380210163712","indices":[143,166],"media_key":"3_2112433380210163712","media_results":{"result":{"media_key":"3_2112433380210163712"}},"media_url_https":"https://pbs.twimg.com/media/HVDe95cawAA-gJ8.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":540,"w":540,"x":0,"y":0},{"h":540,"w":474,"x":27,"y":0},{"h":540,"w":270,"x":129,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KUlUXQiHrR"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/KUlUXQiHrR","expanded_url":"https://x.com/gov_online/status/2112702910291431817/photo/1","ext_alt_text":"政府広報提供テレビ番組、「ニッポン今だラボ」の10月21日（水曜日）放送のサムネイル。創薬研究施設で研究を行う人や打合せをする人、高層ビル群などの画像を背景に、「薬のタネから実用化、創薬エコシステム、協力して進める仕組み」と書かれている。その横に出演者である今田耕司さん、森香澄さんの写真と、今田耕司さんの写真の隣に吹き出しで「官民ワンチームで連携?」と書かれている。下部には大きく「新薬開発を支援する創薬エコシステム」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":36,"w":36,"x":566,"y":56},{"h":37,