acy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2112876624563822900","created_at":"Wed Oct 21 12:00:17 +0000 2026","display_text_range":[0,121],"entities":{},"favorite_count":35,"favorited":false,"full_text":"令和8年10月21日からの大雨について、大臣指示を行いました。\n\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、人命第一の方針の下、災害応急対策に全力で取り組むこと。","id_str":"2112876624563822900","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":0,"retweet_count":27,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4NzY2MjQ0OTY3ODc0NTY=","richtext":{"richtext_tags":[]},"text":"令和8年10月21日からの大雨について、大臣指示を行いました。\n\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、人命第一の方針の下、災害応急対策に全力で取り組むこと。\n２．地方自治体とのホットライン等を通じて情報を収集し、要請に応じて迅速に地方自治体への支援等を実施すること。"}}},"rest_id":"2112876624563822900","unmention_data":{},"views":{"count":"6178","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112876624563822900","sortIndex":"2112987302270599164"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/LOiA6lm4yv"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":fals