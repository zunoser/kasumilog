play_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3030174,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1889},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112836369148231782"],"editable_until_msecs":"1792578019000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":70,"bookmarked":false,"conversation_id_str":"2112836369148231782","created_at":"Wed Oct 21 09:20:19 +0000 2026","display_text_range":[0,127],"entities":{},"favorite_count":5289,"favorited":false,"full_text":"【高市内閣発足1周年に当たり④】\n\nこの1年間、日本列島は、「令和8年熊本地震」をはじめ、地震、台風や豪雨など、度重なる自然災害に見舞われました。\n\n改めて、お亡くなりになられた方々に哀悼の誠を捧げますとともに、謹んで御遺族の皆様にお悔やみ申し上げます。","id_str":"2112836369148231782","is_quote_status":false,"lang":"ja","quote_count":41,"reply_count":210,"retweet_count":667,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1021kaiken.html","indices":[321,344],"url":"https://t.co/gZivRB3Y5P"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4MzYzNjkwODEwOTQxNDQ=","richtext":{"richtext_tags":[]},"text":"【高市内閣発足1周年に当たり④】\n\nこの1年間、日本列島は、「令和8年熊本地震」をはじめ、地震、台風や豪雨など、度重なる自然災害に見舞われました。\n\n改めて、お亡くなりになられた方々に哀悼の誠を捧げますとともに、謹んで御遺族の皆様にお悔やみ申し上げます。\nそして被災された全ての方に、心からお見舞いを申し上げます。\n\n高市内閣では、何よりも「人命」を守ることを最優先に、迅速な「避難支援」、被災者の「生活と生業の再建」、「インフラの復旧・復興」に全力で取り組んできました。\n\n11月2日には、「防災庁」が発足します。\n事前防災、発災直後の対応から復旧・復興まで、切れ目ない取組を進めてまいります。\n\n（参考）令和8年10月21日の会見の動画\nhttps://t.co/gZivRB3Y5P"}}},"rest_id":"2112836369148231782","unmention_data":{},"views":{"count":"183835","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112836369148231782","sortIndex":"2112987302270599142"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.