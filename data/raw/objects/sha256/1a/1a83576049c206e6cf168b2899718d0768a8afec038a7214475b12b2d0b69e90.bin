があります。PHP公式 https://t.co/h1VJujyZTd","id_str":"2112906086160429175","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1059,"reply_count":201,"retweet_count":9094,"retweeted":false,"user_id_str":"3569246426"},"rest_id":"2112906086160429175","unmention_data":{},"views":{"count":"2764659","state":"EnabledWithCount"}}},"user_id_str":"266566401"},"rest_id":"2112919324273029260","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"522","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112919324273029260","sortIndex":"2112987302270599168"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3030174,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1889},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112890642590564386"],"editable_until_msecs":"1792590959000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":27256,"bookmarked":false,"conversation_id_str":"2112890642590564386","created_at":"Wed Oct 21 12:55:59 +0000 2026","display_text_range":[0,92],"entities":{},"favorite_count":228684,"favorited":false,"full_text":"皆様に、今夜に対応して頂きたい大至急のお願いです。\n \n多くのウェブサイトで使用されているPHPに関し、PHPのセキュリティチームが、重大な２件の脆弱性に関する注意喚起を行っています。","id_str":"2112890642590564386","is_quote_status":false,"lang":"ja","quote_count":13514,"reply_count":2570,"retweet_count":63920,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"3569246426","indices":[331,346],"name":"国家サイバー統括室(注意・警戒情報)","screen_name":"cyber_forecast"}]},"id":"Tm90ZVR3ZWV0OjIxMTI4OTA2NDI1MjMzNzc2NjQ=","text":"皆様に、今夜に対応して頂きたい大至急のお願いです。\n \n多くのウェブサイトで使用されているPHPに関し、PHPのセキュリティチームが、重大な２件の脆弱性に関する注意喚起を行っています。\n \n公開しているウェブサイトでPHPを使用しているか確認し、今夜、10月21日午後11時（日本時間）に公開される修正パッチについて、可及的速やかに適用できるよう準備をお願いします。\n \n修正パッチを速やかに適用することが困難な場合は、例えばウェブサイト等を一時的に停止させることも、リスクを低減させるための有効策の一つと考えられます。\n \n国家サイバー統括室のXアカウントでも関係する情報を発信していますので、そちらも参考にして下さい。\n国家サイバー統括室(注意・警戒情報)（@cyber_forecast） / X"}}},"rest_id":"2112890642590564386","unmention_data":{},"views":{"count":"35580898","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112890642590564386","sortIndex":"2112987302270599167"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/5bEzes2ShZ"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"description":{},"url":{"urls":[{"display_url":"fdma.go.jp","expanded_url":"http://www.fdma.go.jp/","indices":[0,23],"url":"https://t.co/YCgAnjuA83"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profi