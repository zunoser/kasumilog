esults":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3030174,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1889},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112834170858983454"],"editable_until_msecs":"1792577495000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":98,"bookmarked":false,"conversation_id_str":"2112834170858983454","created_at":"Wed Oct 21 09:11:35 +0000 2026","display_text_range":[0,139],"entities":{},"favorite_count":7043,"favorited":false,"full_text":"【高市内閣発足1周年に当たり②】\n\n「責任ある積極財政」は、まさに、「日本経済が音を立てて動き出す」ことを目指した闘いです。\n産業界や地方公共団体の皆様のご理解も得て、「世の中の空気」は変わりつつあると感じています。\n\n数値で見ると、日本経済には、「確かな変化」が表れています。","id_str":"2112834170858983454","is_quote_status":false,"lang":"ja","quote_count":131,"reply_count":508,"retweet_count":902,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1021kaiken.html","indices":[925,948],"url":"https://t.co/gZivRB3Y5P"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4MzQxNzA2OTUzODA5OTI=","richtext":{"richtext_tags":[]},"text":"【高市内閣発足1周年に当たり②】\n\n「責任ある積極財政」は、まさに、「日本経済が音を立てて動き出す」ことを目指した闘いです。\n産業界や地方公共団体の皆様のご理解も得て、「世の中の空気」は変わりつつあると感じています。\n\n数値で見ると、日本経済には、「確かな変化」が表れています。\n\n「GDP」は、名目で「700兆円経済」が視野に入ってきました。\n\n春季労使交渉の「賃上げ率」は、3年連続で5%を超えています。\n\n1年前は4万円台だった「株価」は、6万5000円を超える水準となるなど、市況の上昇もあり、「国や地方自治体が保有する金融資産」は、\n1年間で80兆円も増加し、990兆円を超えました。\n\n皆様の年金を運用しているGPIFの「2025年度の運用益」は、前年度から40兆円近く増加しました。\n\n昨年度の「税収」は、前年度よりも約9兆円増加し、過去最高の84.2兆円となりました。\n\n日本経済は、30年近く続いたデフレ的な経済構造の下、「働いても、なかなか賃金が上がらない」停滞から、「経済の好循環」の道へ踏み出せるかどうかの「分岐点」にあります。\n\nこの変化の兆しを一時的なものに終わらせないため、『日本成長戦略』と『地域未来戦略』を両輪に、「予算編成方針」も大胆に見直しました。\n政府が一歩前に出て、「国内投資の呼び水」として、大規模かつ長期の、予見可能性の高い財政支出を計画的に行い、大胆な「民間国内投資」を力強く引き出していきます。\n\n「成長」なくして、「賃上げ」も、「税収増」も、「社会保障の充実」も\nありません。\nだからこそ、国民の皆様の「手取り」を増やせる「強い経済」を実現しながら､｢財政の持続可能性｣も確保する｡\n\nその両方を実現する「責任ある積極財政」を掲げてきました。\n\n高市内閣の成長戦略は、一部の都市や大企業だけのものではありません。\n日本の大きな伸び代は、「地方」にあります。\n\n『地域未来戦略』によって、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を、国が二人三脚で支え、日本列島の隅々まで「産業クラスターの花」を咲かせてまいります。\n\n（参考）令和8年10月21日の会見の動画\nhttps://t.co/gZivRB3Y5P"}}},"rest_id":"2112834170858983454","unmention_data":{},"views":{"count":"213162","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112834170858983454","sortIndex":"2112987302270599134"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1907032035689996327"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator