.com/MAFF_EXPO2027/status/2095723150852141452","url":"https://t.co/ul4YkOyKRN"},"reply_count":3,"retweet_count":25,"retweeted":false,"user_id_str":"2335919749"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":22},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1991354767910793217/0DeF2vRp_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1985027376716349440/1763610950"},"core":{"created_at":"Sun Nov 02 16:54:08 +0000 2025","name":"農林水産省【公式】GREEN×EXPO 2027（２０２７年国際園芸博覧会）","screen_name":"MAFF_EXPO2027"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxOTg1MDI3Mzc2NzE2MzQ5NDQw","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"農林水産省公式アカウントです。\n2027年3月19日～9月26日まで神奈川県横浜市で開催されるGREEN×EXPO 2027（２０２７年国際園芸博覧会）の魅力を発信していきます💐\n\n#withGREENEXPO\n#weareblooming\n#greenexpo2027\n＃2027年国際園芸博覧会","entities":{"description":{}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3528,"following":64},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1985027376716349440","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":207,"tweets":629},"verification":{"verified":false},"website":{"url":""}}}},"edit_control":{"edit_tweet_ids":["2095723150852141452"],"editable_until_msecs":"1788497910000","edits_remaining":"5","is_edit_elig