https://t.co/9ItjigoXnv"}]},"favorite_count":66,"favorited":false,"full_text":"堀井外務副大臣は、総理特使として、パラオを訪問し、太平洋諸島フォーラム（PIF）域外国対話に出席したほか、スランゲル・S・ウィップス・ジュニア・パラオ大統領を始めとする各国政府要人と会談を行いました。太平洋島嶼国地域の一体性とそれを体現するPIFの「2050年戦略」への強力な支持を示しつつ https://t.co/9ItjigoXnv","id_str":"2095842952837054645","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":3,"retweet_count":12,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04129.html","indices":[256,279],"url":"https://t.co/9SLE3JJz7d"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTU4NDI5NTI3MjM3NjMyMDA=","richtext":{"richtext_tags":[]},"text":"堀井外務副大臣は、総理特使として、パラオを訪問し、太平洋諸島フォーラム（PIF）域外国対話に出席したほか、スランゲル・S・ウィップス・ジュニア・パラオ大統領を始めとする各国政府要人と会談を行いました。太平洋島嶼国地域の一体性とそれを体現するPIFの「2050年戦略」への強力な支持を示しつつ、太平洋島嶼国・地域首脳等に対して、来年夏頃に横浜市で開催予定の第11回太平洋・島サミット（PALM11）に向けた連携について働きかけを行いました。\nまた、堀井副大臣はペリリュー島及び旧日本海軍墓地を慰霊訪問しました。\n\nhttps://t.co/9SLE3JJz7d"}}},"rest_id":"2095842952837054645","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"5219","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095842952837054645","sortIndex":"2095880204676235262"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_ur