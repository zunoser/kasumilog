7247060832437","is_quote_status":false,"lang":"ja","quote_count":5,"reply_count":6,"retweet_count":106,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/henkaku/pdf/20260831b.pdf","indices":[227,250],"url":"https://t.co/3XoQ4dbwce"},{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/henkaku/index.html","indices":[271,294],"url":"https://t.co/8QaHMGAGdJ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTU3ODcyNDcwMDYzMzA4ODE=","text":"／\n📢イラン情勢でみられた戦い方や課題に関する資料を公表\n＼\n \n8月31日に開催した「防衛力変革推進本部」での議論に関する資料を公表します！\n \nテーマは以下のとおり👇\n\n「イラン情勢でみられた戦い方や課題」について、整理しました。得られた教訓を我が国の防衛力整備にどのように活用していくべきか、引き続き情報収集・分析を行いながら、三文書改定に向けた検討に活かしてまいります。\n \n今後も三文書改定に向けて、スピード感をもって検討を進めていきます。\n https://t.co/3XoQ4dbwce\n\n📌防衛力変革推進本部についてはこちら\nhttps://t.co/8QaHMGAGdJ"}}},"previous_counts":{"bookmark_count":2,"favorite_count":8,"quote_count":0,"reply_count":0,"retweet_count":1},"rest_id":"2095787247060832437","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"23183","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095787247060832437","sortIndex":"2095880204676235223"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_