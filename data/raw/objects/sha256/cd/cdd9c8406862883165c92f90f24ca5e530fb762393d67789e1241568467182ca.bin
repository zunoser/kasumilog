"}]},"favorite_count":1092,"favorited":false,"full_text":"9月4日、吉田防衛大臣政務官は、防衛省・自衛隊を代表して、千鳥ヶ淵戦没者墓苑において硫黄島戦没者遺骨引渡式に参列し、献花を行いました。\n \nこの度、ご遺骨23柱が帰還されました。引き続き厚生労働省・外務省と連携し、戦没者の遺骨収集にしっかりと協力してまいります。 https://t.co/aJwVz2fhur","id_str":"2095790166388715948","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":8,"retweet_count":167,"retweeted":false,"user_id_str":"268732024"},"rest_id":"2095790166388715948","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"24371","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095790166388715948","sortIndex":"2095880204676235224"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/3XoQ4dbwce"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"descrip