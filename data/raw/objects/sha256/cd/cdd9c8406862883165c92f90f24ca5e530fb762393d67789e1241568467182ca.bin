=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095738597664301056/vid/avc1/640x360/O285JXfifagAgheH.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095738597664301056/vid/avc1/1280x720/0C2wbJDIBBFCkVNz.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/dp9eivV538","expanded_url":"https://x.com/kantei/status/2095739725760098363/video/1","ext_media_availability":{"status":"Available"},"id_str":"2095738597664301056","indices":[142,165],"media_key":"13_2095738597664301056","media_results":{"result":{"media_key":"13_2095738597664301056"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2095738597664301056/img/FxrI7UDORCqklSsR.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/dp9eivV538","video_info":{"aspect_ratio":[16,9],"duration_millis":250500,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2095738597664301056/pl/apNUaKRcKwYn1VCz.m3u8?tag=29&v=5b2"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095738597664301056/vid/avc1/480x270/fJ9TDuthqDSJxeMW.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095738597664301056/vid/avc1/640x360/O285JXfifagAgheH.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095738597664301056/vid/avc1/1280x720/0C2wbJDIBBFCkVNz.mp4?tag=29"}]}}]},"favorite_count":1808,"favorited":false,"full_text":"【お知らせ】\n本日（９月４日）、高市総理は、令和８年熊本地震非常災害復旧復興本部（第１回）会議を行いました。\n\n※高市総理発言要旨（速報版）\n　お疲れさまでございます。本日（４日）は、ご多用の中、熊本県・木村知事にもご出席をいただき、私たちもさらに気合が入るご意見をいただきま