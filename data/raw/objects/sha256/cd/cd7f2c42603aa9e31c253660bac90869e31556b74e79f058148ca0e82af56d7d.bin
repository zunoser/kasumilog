r_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":520,"tweets":1735},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2092687938320785705"],"editable_until_msecs":"1787774259000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":611,"bookmarked":false,"conversation_id_str":"2092687938320785705","created_at":"Wed Aug 26 18:57:39 +0000 2026","display_text_range":[0,138],"entities":{},"favorite_count":36923,"favorited":false,"full_text":"ネパールでの大規模洪水発生につき、ネパール政府及びネパール国民の皆様に、心よりお見舞いを申し上げます。\n\n現地メディアで、日本人の行方不明者が5名と報じられましたので、心配しています。\n\n同5名の邦人に、現地の日本大使館が連絡を取っても連絡がつかず、捜索依頼をしたとの事です。","id_str":"2092687938320785705","is_quote_status":false,"lang":"ja","quote_count":208,"reply_count":502,"retweet_count":4662,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI2ODc5MzgyNzQ2NzI2NDA=","richtext":{"richtext_tags":[]},"text":"ネパールでの大規模洪水発生につき、ネパール政府及びネパール国民の皆様に、心よりお見舞いを申し上げます。\n\n現地メディアで、日本人の行方不明者が5名と報じられましたので、心配しています。\n\n同5名の邦人に、現地の日本大使館が連絡を取っても連絡がつかず、捜索依頼をしたとの事です。\n\n日本時間の深夜3時30分時点で、未だ私には、現地の通信環境の状況が把握出来ていませんが、もしも現地でこのXを見て頂けた安否をご存知の方がおられましたら、在ネパール日本大使館にご一報下さい。\n\n電話番号は、+977-1-4526-680です。\n\n邦人の皆様、ネパール国民、諸外国の滞在者の皆様の状況を案じ、かけがえのない命が守られますよう、ひたすらに祈っています。"}}},"rest_id":"2092687938320785705","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2522791","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092687938320785705","sortIndex":"2092912418958081919"},{"content":{"__typename":"TimelineTimelineItem","clie