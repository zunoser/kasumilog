"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/d1b6Q29QXz"}]},"favorite_count":7446,"favorited":false,"full_text":"本日午前に、黒岩神奈川県知事と、９月に横浜で公演されるミュージカル「アニオー姫」の主演者の皆様が官邸にお越し下さいました。\n\n私が今年５月にベトナムを訪問した際、ラム党書記長兼国家主席や フン首相からお招きいただいた食事の場で、本作品の https://t.co/d1b6Q29QXz","id_str":"2092581760894984493","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":62,"reply_count":262,"retweet_count":638,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI1ODE3NjA4NDA0MDA4OTc=","richtext":{"richtext_tags":[]},"text":"本日午前に、黒岩神奈川県知事と、９月に横浜で公演されるミュージカル「アニオー姫」の主演者の皆様が官邸にお越し下さいました。\n\n私が今年５月にベトナムを訪問した際、ラム党書記長兼国家主席や フン首相からお招きいただいた食事の場で、本作品の 「荒木宗太郎氏」と「アニオー姫」の演者の方々の素晴らしい歌声を拝聴し、感動したことをよく覚えています。\n\nこの度、多くの日本の皆様がミュージカル「アニオー姫」を鑑賞し、今後の日・ベトナム関係の更なる発展につながっていくことを期待しています。"}}},"rest_id":"2092581760894984493","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"297023","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092581760894984493","sortIndex":"2092912418958081912"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.c