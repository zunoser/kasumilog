{"large":{"h":951,"resize":"fit","w":674},"medium":{"h":951,"resize":"fit","w":674},"small":{"h":680,"resize":"fit","w":482},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uhpdfbx0Ca"},{"display_url":"pic.x.com/uhpdfbx0Ca","expanded_url":"https://x.com/FDMA_JAPAN/status/2090354151297614263/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2090354146994192384","indices":[145,168],"media_key":"3_2090354146994192384","media_results":{"result":{"media_key":"3_2090354146994192384"}},"media_url_https":"https://pbs.twimg.com/media/HQJuBYJagAA1-Id.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":78},{"h":900,"w":900,"x":0,"y":0},{"h":1026,"w":900,"x":0,"y":0},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uhpdfbx0Ca"}]},"favorite_count":150,"favorited":false,"full_text":"⚠️アンダーパスの冠水に注意⚠️\n立体交差で道路や鉄道の下を通る「アンダーパス」は、大雨の際に冠水する危険があります。見た目以上に水位が高い場合があり、車両が進入するとエンジン停止や車内浸水のおそれがあります。無理な通行は控え、安全なルートを選択してください。＃消防庁 ＃大雨 #道路冠水 https://t.co/uhpdfbx0Ca","id_str":"2090354151297614263","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":2,"retweet_count":93,"retweeted":false,"user_id_str":"137272821"},"rest_id":"2090354151297614263","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"146035","state":"EnabledWithCount"}}},"rest_id":"2092739912521199787","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"102109","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092739912521199787","sortIndex":"2092912418958081922"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2983163,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":520,"tweets":1735},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2092738848690446700"],"editable_until_msecs":"1787786397000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":174,"bookmarked":false,"conversation_id_str":"2092738848690446700","created_at":"Wed Aug 26 22:19:57 +0000 2026","display_text_range":[0,107],"entities":{},"favorite_count":13816,"favorited":false,"full_text":"富山県氷見市、石川県羽咋市、志賀町、宝達志水町、中能登町に「レベル５大雨特別警報」が発表されています。\n\n現時点で、石川県や富山県で警戒レベル５の「緊急安全確保」や警戒レベル４の「避難指示」などが発令されています。","id_str":"2092738848690446700","is_quote_status":false,"lang":"ja","quote_count":171,"reply_count":499,"retweet_count":2271,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI3Mzg4NDg2MzE4MDM5MDQ=","richtext":{"richtext_tags":[]},"text":"富山県氷見市、石川県羽咋市、志賀町、宝達志水町、中能登町に「レベル５大雨特別警報」が発表されています。\n\n現時点で、石川県や富山県で警戒レベル５の「緊急安全確保」や警戒レベル４の「避難指示」などが発令されています。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、命の危険が迫っています。\n地方自治体や気象台から発表される避難情報や気象情報をご確認いただき、直ちに身の安全を確保し、最大級の警戒をお願いします。\n\n避難所までの移動がかえって危険な場合は、無理をせず、崖から離れた場所や浸水しにくい高い場所など、今いる場所よりも少しでも安全な空間に移動するなど、命を守る行動を最優先してください。\n\n先般の令和８年８月千葉豪雨では、内水氾濫が発生し、道路のアンダーパスや低地が浸水する等の被害が発生しています。\n外出にあたっては足元の安全に十分注意し、また運転中の方におかれましては、冠水している道路には進入しないようにお願いします。\n\n政府としては、官邸危機管理センターに設置した「８月27日からの大雨に関する官邸連絡室」において情報収集にあたっており、危機管理に万全の対応をしてまいります。"}}},"rest_id":"2092738848690446700","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"764049","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092738848690446700","sortIndex":"2092912418958081921"},{"