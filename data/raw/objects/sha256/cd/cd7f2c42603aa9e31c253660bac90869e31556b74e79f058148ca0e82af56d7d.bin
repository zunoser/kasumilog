0},"medium":{"h":720,"resize":"fit","w":960},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/pUlkBtmG01"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/pUlkBtmG01","expanded_url":"https://x.com/ModJapan_saigai/status/2092772262969790876/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2092772179813478400","indices":[112,135],"media_key":"3_2092772179813478400","media_results":{"result":{"media_key":"3_2092772179813478400"}},"media_url_https":"https://pbs.twimg.com/media/HQsFNaWaMAACZM2.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":43},{"h":720,"w":720,"x":0,"y":0},{"h":720,"w":632,"x":44,"y":0},{"h":720,"w":360,"x":180,"y":0},{"h":720,"w":960,"x":0,"y":0}],"height":720,"width":960},"sizes":{"large":{"h":720,"resize":"fit","w":960},"medium":{"h":720,"resize":"fit","w":960},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/pUlkBtmG01"}]},"favorite_count":1053,"favorited":false,"full_text":"石川県・富山県では、線状降水帯の影響により記録的な大雨となっており、石川県の４市町（羽咋市、志賀町、宝達志水町、中能登町）と富山県氷見市には、レベル５の大雨特別警報が発表されており、最大級の警戒を要する状況となっています。 https://t.co/pUlkBtmG01","id_str":"2092772262969790876","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"quoted_status_id_str":"2092752893560660471","quoted_status_permalink":{"display":"x.com/ModJapan_saiga…","expanded":"https://twitter.com/ModJapan_saigai/status/2092752893560660471","url":"https://t.co/2zD4G0CQXT"},"reply_count":23,"retweet_count":350,"retweeted":false,"user_id_str":"1182556649120075776"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI3NzIyNjI5MTk0NDI0MzI=","richtext":{"richtext_tags":[]},"text":"石川県・富山県では、線状降水帯の影響により記録的な大雨となっており、石川県の４市町（羽咋市、志賀町、宝達志水町、中能登町）と富山県氷見市には、レベル５の大雨特別警報が発表されており、最大級の警戒を要する状況となっています。\n小泉防衛大臣の指示を踏まえ、自衛隊は陸上自衛隊第１０師団（愛知）をはじめ各地で情報収集態勢を強化しています。\nまた、石川県庁には陸上自衛隊第１４普通科連隊（石川）、富山県庁には陸上自衛隊第１４普通科連隊と富山地方協力本部の連絡員が到着し、自治体と緊密に連携しながら対応に当たっています。\n自衛隊は、引き続き、自治体や関係機関と緊密に連携し、今後の状況の推移に対応できるよう万全の態勢を維持しています。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2456},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182592351472013314/X9jVEv2u_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1182556649120075776/1570786963"},"core":{"created_at":"Fri Oct 11 07:21:20 +0000 2019","name":"防衛省・自衛隊（災害対策）","screen_name":"ModJapan_saigai"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTgyNTU2NjQ5MTIwMDc1Nzc2","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省・自衛隊の災害対策公式アカウント／災害派遣活動や災害対策に関する最新情報をお届けします。皆さまの安全と暮らしを守るため、災害現場で対応する部隊・隊員たちの姿を迅速にお伝えしていきます。\n災害派遣以外の自衛隊の活動は、統合幕僚監部のアカウントで発信中　https://t.co/P7BIrjGuU5","entities":{"description":{"urls":[{"display_url":"x.com/jointstaffpa","expanded_url":"https://x.com/jointstaffpa","indices":[128,151],"url":"https://t.co/P7BIrjGuU5"}]},"url":{"urls":[{"display_url":"mod.go.jp/js/activity/do…","expanded_url":"https://www.mod.go.jp/js/activity/domestic.html","indices":[0,23],"url":"https://t.co/7Fx4sySSJE"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts"