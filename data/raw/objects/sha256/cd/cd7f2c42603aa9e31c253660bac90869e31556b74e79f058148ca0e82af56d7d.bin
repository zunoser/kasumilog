:[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2092772603119501312","indices":[54,77],"media_key":"3_2092772603119501312","media_results":{"result":{"media_key":"3_2092772603119501312"}},"media_url_https":"https://pbs.twimg.com/media/HQsFmDSbgAADDIr.png","original_info":{"focus_rects":[{"h":566,"w":1011,"x":69,"y":0},{"h":566,"w":566,"x":514,"y":0},{"h":566,"w":496,"x":584,"y":0},{"h":566,"w":283,"x":694,"y":0},{"h":566,"w":1080,"x":0,"y":0}],"height":566,"width":1080},"sizes":{"large":{"h":566,"resize":"fit","w":1080},"medium":{"h":566,"resize":"fit","w":1080},"small":{"h":356,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/SlRKAubn3J"}]},"favorite_count":1020,"favorited":false,"full_text":"ネパール中部ラスワ郡及び中国チベット自治区シガツェ市で発生した水害についての茂木外務大臣のメッセージです。 https://t.co/SlRKAubn3J","id_str":"2092776840452886809","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":11,"retweet_count":317,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI3NzY4NDAzODk4Njk1Njg=","richtext":{"richtext_tags":[]},"text":"ネパール中部ラスワ郡及び中国チベット自治区シガツェ市で発生した水害についての茂木外務大臣のメッセージです。\n　8月26日（現地時間）、ネパール中部ラスワ郡及び中国チベット自治区シガツェ市で発生した水害に際し、犠牲となられた方々に哀悼の意を捧げ、被害に遭われた皆様に心からお見舞いを申し上げます。 \n　行方不明者の中に、日本人が含まれるとの昨夜のネパール政府の発表を受け、ただちに、日本時間昨日23時付けで、現地では前田徹駐ネパール大使をヘッドとした現地対策本部を、外務省本省では、領事局長をヘッドとした外務省対策室を立ち上げ、至急の対応を開始しています。邦人保護に全力を挙げるべく、私から海外緊急展開チーム（ERT）要員の派遣を指示しました。 \n　日本は、被害に遭われた皆様への強い連帯の意を表明するとともに、必要な対応を急ぎ進めているところです。"}}},"rest_id":"2092776840452886809","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"56442","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092776840452886809","sortIndex":"2092912418958081945"},{"content":{"__