one"},"relationship_counts":{"followers":261409,"following":24},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1182556649120075776","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1411,"tweets":3521},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/7Fx4sySSJE"}}}},"edit_control":{"edit_tweet_ids":["2092752893560660471"],"editable_until_msecs":"1787789745000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":25,"bookmarked":false,"conversation_id_str":"2092752893560660471","created_at":"Wed Aug 26 23:15:45 +0000 2026","display_text_range":[0,126],"entities":{},"favorite_count":1351,"favorited":false,"full_text":"石川県、富山県で発生した線状降水帯の影響により、北陸地方で大雨となっており、本日（２７日）６時２０分以降、石川県の４市町（羽咋市、志賀町、宝達志水町、中能登町）、富山県の１市（氷見市）にレベル５大雨特別警報が発表され、警戒を要する状況となっております。","id_str":"2092752893560660471","is_quote_status":true,"lang":"ja","quote_count":20,"quoted_status_id_str":"2092736968060961221","quoted_status_permalink":{"display":"x.com/ModJapan_saiga…","expanded":"https://twitter.com/ModJapan_saigai/status/2092736968060961221","url":"https://t.co/Cudlw6Jvio"},"reply_count":24,"retweet_count":663,"retweeted":false,"user_id_str":"1182556649120075776"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI3NTI4OTM1MTg3MjEwMjQ=","richtext":{"richtext_tags":[]},"text":"石川県、富山県で発生した線状降水帯の影響により、北陸地方で大雨となっており、本日（２７日）６時２０分以降、石川県の４市町（羽咋市、志賀町、宝達志水町、中能登町）、富山県の１市（氷見市）にレベル５大雨特別警報が発表され、警戒を要する状況となっております。\n小泉防衛大臣の指示を踏まえ、陸自第１０師団（愛知）をはじめ各地の自衛隊は情報収集態勢を強化し、情報収集に当たっております。\nまた、石川県庁と富山県庁に陸自第１４普通科連隊（石川）から連絡員を前進させております。\nすでに、石川県庁には連絡員が到着し、自治体と緊密な連携を図っております。引き続き緊張感をもって、対応してまいります。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2456},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182592351472013314/X9jVEv2u_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1182556649120075776/1570786963"},"core":{"created_at":"Fri Oct 11 07:21:20 +0000 2019","name":"防衛省・自衛隊（災害対策）","screen_name":"ModJapan_saigai"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTgyNTU2NjQ5MTIwMDc1Nzc2","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省・自衛隊の災害対策公式アカウント／災害派遣活動や災害対策に関する最新情報をお届けします。皆さまの安全と暮らしを守るため、災害現場で対応する部隊・隊員たちの姿を迅速にお伝えしていきます。\n災害派遣以外の自衛隊の活動は、統合幕僚監部のアカウントで発信中　https://t.co/P7BIrjGuU5","entities":{"description":{"urls":[{"display_url":"x.com/jointstaffpa","expanded_url":"https://x.com/jointstaffpa","indices":[128,151],"url":"https://t.co/P7BIrjGuU5"}]},"url":{"urls":[{"display_url":"mod.go.jp/js/activity/do…","expanded_url":"https://www.mod.go.jp/js/activity/domestic.html","indices":[0,23],"url":"https://t.co/7Fx4sySSJE"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":261409,"following":24},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1182556649120075776","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1411,"tweets":3521},"verificat