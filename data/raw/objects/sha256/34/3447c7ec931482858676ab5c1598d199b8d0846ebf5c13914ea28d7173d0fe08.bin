d_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":569,"tweets":1844},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2107034276483248164"],"editable_until_msecs":"1791194692000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":207,"bookmarked":false,"conversation_id_str":"2107034276483248164","created_at":"Mon Oct 05 09:04:52 +0000 2026","display_text_range":[0,129],"entities":{},"favorite_count":11459,"favorited":false,"full_text":"１０月２日夜に、Ｇ７オンライン首脳会議が行われました。\n\nディーゼル価格の高騰が国際的な課題となっている中、「欧州の備蓄放出が遅れていること」を背景として開催されたものであり、特に「欧米等のディーゼル価格などへの対応」について焦点を当てた議論が行われました。","id_str":"2107034276483248164","is_quote_status":false,"lang":"ja","quote_count":633,"reply_count":1011,"retweet_count":1417,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDcwMzQyNzY0MzcwOTAzMDQ=","richtext":{"richtext_tags":[]},"text":"１０月２日夜に、Ｇ７オンライン首脳会議が行われました。\n\nディーゼル価格の高騰が国際的な課題となっている中、「欧州の備蓄放出が遅れていること」を背景として開催されたものであり、特に「欧米等のディーゼル価格などへの対応」について焦点を当てた議論が行われました。\n\nこの会議は、議長国のフランスが当日直前に急遽設定したもので、代理出席が認められていました。\n\nバーナム英国首相は欠席・代理出席となり、コスタ欧州理事会議長も欠席されたと聞いています。\n\n我が国からは、米国出張中で直接本件の調整にも当たったＧ７シェルパたる遠藤外務審議官が代理出席してくれました。\n\nなお、今回の会議の結果、「１億バレルの石油備蓄の協調放出を実施すること」となりましたが、日本は、予てより「備蓄放出」を実施してきており、今回新たな放出措置の予定はありません。\n\n世界の経済、エネルギー安全保障及び市場の安定に向けて、引き続きしっかりと対応してまいります。"}}},"rest_id":"2107034276483248164","unmention_data":{},"views":{"count":"905457","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107034276483248164","sortIndex":"2107238862232223728"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1674231387166220288/iK7GwtIr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/180585090/1680484704"},"core":{"created_at":"Fri Aug 20 00:19:17 +0000 2010","name":"厚生労働省","screen_name":"MHLWitter"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODA1ODUwOTA=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"厚生労働省の公式アカウントです。\n健康・医療、福祉・介護、雇用・労働、年金など、皆さまの暮らしを支える情報をお届けします。\n\n※このXに寄せられたコメントへの返信はしておりません。\n\n【運用方針】\nhttps://t.co/dQtOdVs4pp","entities":{"description":{"urls":[{"display_url":"mhlw.go.jp/content/102000…","expanded_url":"https://www.mhlw.go.jp/content/10200000/001350977.pdf","indices":[99,122],"url":"https://t.co/dQtOdVs4pp"}]},"url":{"urls":[{"display_url":"mhlw.go.jp","expanded_url":"http://www.mhlw.go.jp/","indices":[0,23],"url":"https://t.co/XJir5J4Swz"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1036097,"following":15},"relationship_perspec