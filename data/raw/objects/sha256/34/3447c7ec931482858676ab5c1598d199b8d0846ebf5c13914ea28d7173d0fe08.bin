tps":"https://pbs.twimg.com/media/HTyS16laQAAH-ic.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":92},{"h":1366,"w":1366,"x":0,"y":0},{"h":1366,"w":1198,"x":0,"y":0},{"h":1366,"w":683,"x":0,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GiFYkeBbYF"}]},"favorite_count":1636,"favorited":false,"full_text":"10月4日、小泉防衛大臣は、陸上自衛隊高等工科学校創立71周年記念行事に出席し、生徒や学校職員などに対して訓示を行いました。 https://t.co/GiFYkeBbYF","id_str":"2106720192097399062","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":20,"retweet_count":205,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[220,227],"text":"高等工科学校"},{"indices":[229,233],"text":"入校式"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/gsdf/yt_sch/","expanded_url":"https://www.mod.go.jp/gsdf/yt_sch/","indices":[251,274],"url":"https://t.co/Mh2DNoCixA"},{"display_url":"mod.go.jp/gsdf/yt_sch/pd…","expanded_url":"https://www.mod.go.jp/gsdf/yt_sch/pdf/2026panhu.pdf","indices":[293,316],"url":"https://t.co/LtcsAPDHzB"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY3MjAxOTIwMTM0MjI1OTI=","text":"10月4日、小泉防衛大臣は、陸上自衛隊高等工科学校創立71周年記念行事に出席し、生徒や学校職員などに対して訓示を行いました。\n本校は、昭和30年に「生徒制度」を発足させて以来、優れた人材の育成に取り組み、日本の防衛を担う人材を数多く輩出しています。これからも歴史と伝統を継承しつつ、時代の変化に伴う教育の充実に努め、将来の防衛力を支える人材育成の歩みを進めます。\n高等工科学校は、令和10年度から陸海空共同、男女共学の学校になります。\n \n#高等工科学校　\n#入校式　\n \n👇高等工科学校HPはこちら\nhttps://t.co/Mh2DNoCixA\n👇高等工科学校パンフレットはこちら\nhttps://t.co/LtcsAPDHzB"}}},"rest_id":"2106720192097399062","unmention_data":{},"views":{"count":"87721","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106720192097399062","sortIndex":"2107238862232223658"},{"content":{"__typename"