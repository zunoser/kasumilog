026,"w":900,"x":0,"y":0},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/SBdhscX0UB"}]},"favorite_count":14,"favorited":false,"full_text":"/\n📢産業界とともに、地域インフラを支える人材を育成\n\\\n連携協定に基づくプロジェクト第一弾として、JEEDの職業訓練指導員がJR東日本総合研修センターを見学しました。✨ https://t.co/SBdhscX0UB","id_str":"2107023983036289076","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":3,"retweeted":false,"user_id_str":"1917822093556867072"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[298,304],"text":"JR東日本"},{"indices":[305,310],"text":"人材育成"},{"indices":[311,318],"text":"重要インフラ"},{"indices":[319,324],"text":"JEED"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDcwMjM5ODI5ODE3NjMwNzI=","richtext":{"richtext_tags":[]},"text":"/\n📢産業界とともに、地域インフラを支える人材を育成\n\\\n連携協定に基づくプロジェクト第一弾として、JEEDの職業訓練指導員がJR東日本総合研修センターを見学しました。✨\n\n🚃電車線・変電・信号・通信などの実習設備を見学し、安全を最優先とした人材育成や、実際の設備を活用した指導方法について意見交換を行いました。⚡\n\n✍今回学んだ、安全確認の声掛けや危険な取扱いの具体例を示す指導方法、実際の設備を活用した実践的な研修方法を、企業の従業員を対象とした在職者訓練の充実や、次世代を担うポリテクカレッジの学生向け訓練の質の向上に生かし、地域産業の現場を支える実践的な人材の育成を進めていきます。📈\n\n#JR東日本 #人材育成 #重要インフラ #JEED"}}},"rest_id":"2107023983036289076","unmention_data":{},"views":{"count":"10473","state":"EnabledWithCount"}}},"user_id_str":"180585090"},"rest_id":"2107036278604943553","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2034","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107036278604943553","sortIndex":"2107238862232223731"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelines