ai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":590893,"following":204},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20248,"tweets":48962},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2106650442226958597"],"editable_until_msecs":"1791103179000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":93,"bookmarked":false,"conversation_id_str":"2106650442226958597","created_at":"Sun Oct 04 07:39:39 +0000 2026","display_text_range":[0,90],"entities":{},"favorite_count":2649,"favorited":false,"full_text":"10月3日に沖縄県那覇市で発生した強盗殺人事件に関して米海兵隊員が逮捕されたことを受け、10月4日、茂木外務大臣は、ジョージ・グラス駐日米国大使を外務省に召致し、抗議を行いました。","id_str":"2106650442226958597","is_quote_status":false,"lang":"ja","quote_count":56,"reply_count":108,"retweet_count":669,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04254.html","indices":[224,247],"url":"https://t.co/seC7tLmYfa"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY2NTA0NDIxMTc4NDA4OTY=","richtext":{"richtext_tags":[]},"text":"10月3日に沖縄県那覇市で発生した強盗殺人事件に関して米海兵隊員が逮捕されたことを受け、10月4日、茂木外務大臣は、ジョージ・グラス駐日米国大使を外務省に召致し、抗議を行いました。\n茂木大臣からは、本件のような極めて残忍で凶悪な事件の発生は極めて遺憾であり、強い憤りを覚えるとして強く抗議しました。その上で、捜査への全面的な協力を求め、このような惨事が二度と繰り返されることのないよう米軍関係者の綱紀粛正及び事件の再発防止の徹底を強く求めました。\nhttps://t.co/seC7tLmYfa"}}},"rest_id":"2106650442226958597","unmention_data":{},"views":{"count":"297949","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2107238862232223833-tweet-2106665032692203692","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/6ctCqBcqtX"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2105555282164429138"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj