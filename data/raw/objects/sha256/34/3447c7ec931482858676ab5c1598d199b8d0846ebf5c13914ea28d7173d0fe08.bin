"relationship_counts":{"followers":1265161,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7723,"tweets":21742},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2106704725781688719"],"editable_until_msecs":"1791116121000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":54,"bookmarked":false,"conversation_id_str":"2106704725781688719","created_at":"Sun Oct 04 11:15:21 +0000 2026","display_text_range":[0,90],"entities":{},"favorite_count":2701,"favorited":false,"full_text":"本日（10月4日）、小泉防衛大臣は防衛省に在日米軍のジョスト司令官を呼び、沖縄県那覇市で発生した強盗殺人事件について極めて深刻に受け止めている旨を直接伝え、米側に強く抗議しました。","id_str":"2106704725781688719","is_quote_status":false,"lang":"ja","quote_count":19,"reply_count":62,"retweet_count":511,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY3MDQ3MjU3Mzk3MDAyMjQ=","text":"本日（10月4日）、小泉防衛大臣は防衛省に在日米軍のジョスト司令官を呼び、沖縄県那覇市で発生した強盗殺人事件について極めて深刻に受け止めている旨を直接伝え、米側に強く抗議しました。\nその上で、ご遺族に対する適切な対応と捜査への全面的な協力を求め、このような惨事が二度と繰り返されることのないよう徹底した綱紀粛正と再発防止策を講じるよう強く申し入れました。\n防衛省としては、引き続き外務省や関係機関と緊密に連携しながら対応してまいります。"}}},"rest_id":"2106704725781688719","unmention_data":{},"views":{"count":"110921","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106704725781688719","sortIndex":"2107238862232223657"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","det