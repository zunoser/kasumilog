723,"tweets":21742},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2106658641466347723"],"editable_until_msecs":"1791105134607","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2106658641466347723","created_at":"Sun Oct 04 08:12:14 +0000 2026","display_text_range":[0,140],"entities":{"user_mentions":[{"id_str":"2070308568658767872","indices":[3,17],"name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"}]},"favorite_count":0,"favorited":false,"full_text":"RT @PressSec_JMOD: 【10月4日　小泉防衛大臣臨時会見】\n陸上自衛隊高等工科学校創立７１周年記念行事への出席及び神奈川県・千葉県における土砂災害等に伴う災害派遣部隊視察に伴い、陸上自衛隊武山駐屯地において、臨時会見を行いました。  \n\n↓発表事項の全文はこちら…","id_str":"2106658641466347723","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":54,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39958,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":95,"tweets":405},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2106656569299779899"],"editable_until_msecs":"1791104640000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":12,"bookmarked":false,"conversation_id_str":"2106656569299779899","created_at":"Sun Oct 04 08:04:00 +0000 2026","display_text_range":[0,122],"entities":{},"favorite_count":403,"favorited":false,"full_text":"【10月4日　小泉防衛大臣臨時会見】\n陸上自衛隊高等工科学校創立７１周年記念行事への出席及び神奈川県・千葉県における土砂災害等に伴う災害派遣部隊視察に伴い、陸上自衛隊武山駐屯地において、臨時会見を行いました。  \n\n↓発表事項の全文はこちら\n○","id_str":"2106656569299779899","is_quote_status":false,"lang":"ja","quote_count":3,"reply_count":1,"retweet_count":54,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY2NTY1NjkyMDMyMzI3Njg=","text":"【10月4日　小泉防衛大臣臨時会見】\n陸上自衛隊高等工科学校創立７１周年記念行事への出席及び神奈川県・千葉県における土砂災害等に伴う災害派遣部隊視察に伴い、陸上自衛隊武山駐屯地において、臨時会見を行いました。  \n\n↓発表事項の全文はこちら\n○　本日、高等工科学校の創立７１周年記念行事に出席をして訓示を行いました。私は地元、横須賀出身ですから、今まで何度も大臣になる前に出席をしてきた行事でもあります。そんな中、特に最近ですね、１０月１日からアクティブ・サイバー・ディフェンス、この新たな任務を付与されたと。こういった中において、今、サイバー専修コースもある高等工科学校の生徒に、この新たな道を切り開いていくという、その重い使命、重要な使命を持っているということも含めて、訓示ができたことを大変うれしく思っています。また、特にですね、今回の行事には、先日の台風２５号、この災害で、現場で任務に当たった武山駐屯地の第３１普通科連隊、そして第１１７教育大隊、また、座間駐屯地の第４施設群の隊員の皆さんも参加していただき、地域の皆さん挙げてですね、この任務に当たった隊員の皆さんを見ていただく、そして激励いただくと。この自衛隊の活動を知っていただくという機会にもあわせてできたことも、良かったことだと思っています。そして、先ほどは、その現場に従事した隊員たちと意見交換をさせていただき、激励もさせていただきました。多くの隊員の皆さんからは、「行方不明となった方々を一刻も早く見つけ、御家族を安心させたい。その一心で捜索活動に当たっていた。」「いつ終わるか分からない災害派遣であったけれども、人を助けなければならない使命があったからこそ、任務を遂行できた。」とか、「被災者の涙を見て、自分がやらなければと奮起をした。」と、こういった話がありました。私が強く感じましたのは、絶対に見つけ、救助しなければならないという気迫を感じました。この厳しい環境の中でも、黙々と任務に向き合う隊員の姿を見て、大変頼もしく、誇りに感じました。一方で、行方不明となった方々の生存につなげることができなかったことへの隊員たちの無念さも、同時に強く伝わってきました。今回の災害派遣は、非常に厳しい現場となりました。台風が来る前から大雨が降り続き、台風が過ぎた後も大雨が続きました。そうした中でも、武山駐屯地の部隊は、平素の訓練の成果を発揮し、速やかに現場に入り、任務に当たり、訓練の重要性を証明してみせました。今回の活動で得られた良い経験は、全国の部隊にも共有していきたいと思います。また、今回の活動では、地元の消防や警察などの関係機関、そして地元の建設業界の皆さんと力を合わせて、一刻も早い発見を目指して捜索に当たりました。私のもとには、２４時間体制で現場の状況が報告をされてきます。その度に、一刻も早く、行方不明となった方々を見つけたいという思いを胸に、現場で黙々と任務に向き合う隊員たちの姿が目に浮かびました。自衛官の仕事は、目立つためでも、誰かに褒めてもらうためでもありません。助けを必要としている人がいれば、その人のために自分のできることを精一杯やる。今回、正にそうした自衛官の姿を、私は現場で見せてもらったと思っています。厳しい現場で最後まで任務に向き合った隊員一人一人を誇りに思います。そして、その隊員たちを支えてくださった御家族の皆様にも、心から感謝をしたいと思います。そして、一昨日、千葉県の災害の現場もありましたが、千葉県知事から災害派遣の撤収の要請があり、自衛隊の活動は終了しました。この後、上空から千葉県内の自衛隊の活動現場を視察し、その後、習志野駐屯地に移動して、千葉県内で行方不明者の捜索や、冠水した地域でボートによる救助活動、電力の早期回復のための倒木撤去の任務に当たった隊員たちに直接会って、激励をする予定です。本日はお疲れ様でした。\n○　また、最後になりますけれども、また１件、私からコメントを発出したいと思います。１０月の３日の未明、那覇市内のホテルにおいて、女性の遺体が発見され、本日、強盗殺人の容疑でアメリカ海兵隊上等兵が逮捕されました。御遺族の皆様には、衷心より哀悼の意を表します。このような事件は言語道断で許されず、強い憤りを覚えます。この事案を受け、アメリカ側に対し、強く抗議するとともに、隊員に対する教育の徹底、綱紀粛正、事件・事故防止の徹底、被害者の御遺族に対する迅速かつ適切な対応を厳正に申し入れました。いずれにせよ、アメリカ軍人等による事件・事故は、地元の皆様に大きな不安を与えるものであり、あってはならないものです。防衛省としては、アメリカ側に対し、引き続き、様々な機会に事件・事故防止の徹底を求めていく考えです。今後、外務省と連携し、対応してまいります。以上です。"}}},"rest_id":"2106656569299779899","unmention_data":{},"views":{"count":"29635","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2106658641466347723","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"5196","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106658641466347723","sortIndex":"2107238862232223654"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3011268,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":569,"tweets":1844},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2106632726363414996"],"editable_until_msecs":"1791098955000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":130,"bookmarked":false,"conversation_id_str":"2106632726363414996","created_at":"Sun Oct 04 06:29:15 +0000 2026","display_text_range":[0,64],"entities":{},"favorite_count":10245,"favorited":false,"full_text":"本日、「第20回アジア競技大会（2026/愛知・名古屋）」が閉幕します。\n\n今大会は、32年ぶりの日本での開催となり、「TEAM","id_str":"2106632726363414996","is_quote_status":false,"lang":"ja","quote_count":190,"reply_count":1655,"retweet_count":999,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY2MzI3MjYzMTMxMzIwMzI=","text":"本日、「第20回アジア競技大会（2026/愛知・名古屋）」が閉幕します。\n\n今大会は、32年ぶりの日本での開催となり、「TEAM JAPAN」の皆様の御活躍により、日本人選手による世界新記録の更新、当該競技における初の金メダル獲得、アジア大会史上最年少金メダリストの誕生など、記録に残る大会となりました。\n\n選手の皆様が、晴れの大舞台で自らの限界に果敢に挑み続ける姿、仲間と支え合いながら最後まで諦めずに勝利を目指す姿、そして競い合った相手への敬意を忘れず健闘をたたえ合う姿は、スポーツの素晴らしさを改めて私たちに感じさせてくれました。\n\n日本中に多くの勇気と感動を届けて下さった選手の皆様に、心から感謝申し上げます。\nこれまで選手の挑戦を支え続けてこられた御家族、指導者、関係者の皆様にも、深く敬意を表します。\n\n2年後の「ロサンゼルスオリンピック」、4年後にカタール・ドーハで開催される次回「アジア競技大会」など、次なる舞台において「TEAM JAPAN」の皆様が一層御活躍されることを願っております。\n\nさて、10月18日からは、日本で初めての開催となる「第5回アジアパラ競技大会（2026／愛知・名古屋）」が開幕します。\n「アジア競技大会」の熱気と感動が「アジアパラ競技大会」へと引き継がれ、選手の皆様による熱き戦いが繰り広げられることを、今から楽しみにしております。"}}},"rest_id":"2106632726363414996","unmention_data":{},"views":{"count":"676968","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106632726363414996","sortIndex":"2107238862232223653"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265161,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7723,"tweets":21742},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2106631125451878475"],"editable_until_msecs":"1791098574000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":394,"bookmarked":false,"conversation_id_str":"2106631125451878475","created_at":"Sun Oct 04 06:22:54 +0000 2026","display_text_range":[0,140],"entities":{},"favorite_count":10077,"favorited":false,"full_text":"沖縄での米海兵隊員による極めて残忍で凶悪な事件を受け、強い憤りを覚えます。米側に対し強く抗議するとともに、綱紀粛正や再発防止の徹底、御遺族への迅速な対応を厳正に申し入れました。亡くなられた方のご冥福をお祈りするとともに、御遺族の皆様に、心より哀悼の意を表します。防衛省としては、引","id_str":"2106631125451878475","is_quote_status":false,"lang":"ja","quote_count":170,"reply_count":334,"retweet_count":1707,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY2MzExMjU0MDk5MjcxNjg=","text":"沖縄での米海兵隊員による極めて残忍で凶悪な事件を受け、強い憤りを覚えます。米側に対し強く抗議するとともに、綱紀粛正や再発防止の徹底、御遺族への迅速な対応を厳正に申し入れました。亡くなられた方のご冥福をお祈りするとともに、御遺族の皆様に、心より哀悼の意を表します。防衛省としては、引き続き外務省や関係機関と連携し対応していくとともに、徹底した再発防止策を求めていきます。"}}},"rest_id":"2106631125451878475","unmention_data":{},"views":{"count":"676606","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106631125451878475","sortIndex":"2107238862232223652"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHT5qlKBAJxEKAAIdPe7SF1pR-wgAAwAAAAEAAA"},"entryId":"cursor-top-2107238862232223745","sortIndex":"2107238862232223745"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHT5qlKA__6EKAAIdPEHY4VcwSwgAAwAAAAIAAA"},"entryId":"cursor-bottom-2107238862232223651","sortIndex":"2107238862232223651"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}