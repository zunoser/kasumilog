:178},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8661,"tweets":19614},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2106664816119251292"],"editable_until_msecs":"1791106606000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"data":{"associated_data":{},"destination_language":"ja","entities":{"hashtags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/press/release/…","expanded_url":"https://www.mofa.go.jp/press/release/pressite_000001_02706.html","indices":[243,266],"url":"https://t.co/JqsZPwYuTc"}],"user_mentions":[]},"preview_translation":"10月4日、MOTEGI外務大臣は外務省において、駐日米国大使であるGeorge GLASS氏を召喚し、10月3日に那覇市で発生した強盗殺人容疑による米海兵隊員の逮捕事案を受け、抗議を行いました。\nMOTEGI外務大臣はこのような極めて残虐かつ卑劣な事案の発生は極めて遺憾であるとして、強い抗議を表明しました。","source_language":"en","translation":"10月4日、MOTEGI外務大臣は外務省において、駐日米国大使であるGeorge GLASS氏を召喚し、10月3日に那覇市で発生した強盗殺人容疑による米海兵隊員の逮捕事案を受け、抗議を行いました。\nMOTEGI外務大臣はこのような極めて残虐かつ卑劣な事案の発生は極めて遺憾であるとして、強い抗議を表明しました。\nMOTEGI外務大臣は、米側に対し、進行中の捜査への全面的な協力を求めるとともに、規律の強化と事案の再発防止を図り、このような悲劇が二度と繰り返されないよう強く求めました。\nhttps://t.co/JqsZPwYuTc"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":22,"bookmarked":false,"conversation_id_str":"2106664816119251292","created_at":"Sun Oct 04 08:36:46 +0000 2026","display_text_range":[0,275],"entities":{},"favorite_count":210,"favorited":false,"full_text":"On October 4, FM MOTEGI summoned Mr. George GLASS, Ambassador of the U.S., at the Ministry of Foreign Affairs and issued a protest following the arrest of a U.S. marine member on a suspicion of robbery-murder that occurred in Naha city on October 3.\nFM MOTEGI lodged a strong","id_str":"2106664816119251292","is_quote_status":false,"lang":"en","quote_count":5,"reply_count":10,"retweet_count":92,"retweeted":false,"user_id_str":"303735625"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/press/release/…","expanded_url":"https://www.mofa.go.jp/press/release/pressite_000001_02706.html","indices":[624,647],"url":"https://t.co/JqsZPwYuTc"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY2NjQ4MTU5NzY3MDE5NTI=","richtext":{"richtext_tags":[]},"text":"On October 4, FM MOTEGI summoned Mr. George GLASS, Ambassador of the U.S., at the Ministry of Foreign Affairs and issued a protest following the arrest of a U.S. marine member on a suspicion of robbery-murder that occurred in Naha city on October 3.\nFM MOTEGI lodged a strong protest expressing that the occurrence of such an extremely brutal and heinous incident is extremely regrettable. \nFM MOTEGI urged the U.S. side’s full cooperation with the ongoing investigation. He also strongly urged the U.S. side to strengthen discipline and to prevent the recurrence of incidents so that such a tragedy will never be repeated.\nhttps://t.co/JqsZPwYuTc"}}},"rest_id":"2106664816119251292","unmention_data":{},"views":{"count":"20933","state":"EnabledWithCount"}}},"rest_id":"2106665032692203692","unmention_data":{},"views":{"count":"12833","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2106650442226958597","2106665032692203692"],"enableDeduplication":true}}},"entryId":"list-conversation-2107238862232223833","sortIndex":"2107238862232223655"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__t