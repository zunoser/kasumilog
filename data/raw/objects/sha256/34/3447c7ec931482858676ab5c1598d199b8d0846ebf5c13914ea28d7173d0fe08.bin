esults":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1853716532645535744/nByOEnD7_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1853694958383050752/1731399557"},"core":{"created_at":"Tue Nov 05 07:08:10 +0000 2024","name":"内閣府政策統括官（共生・共助担当）","screen_name":"kyoseikyojo_cao"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODUzNjk0OTU4MzgzMDUwNzUy","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府共生・共助担当の公式アカウントです。\n内閣府政策統括官（共生・共助担当）が管理・運営しております。\n運用方針（https://t.co/nSooMa6Gc5）を御確認のうえ御利用ください。","entities":{"description":{"urls":[{"display_url":"www8.cao.go.jp/souki/sns/x.ht…","expanded_url":"https://www8.cao.go.jp/souki/sns/x.html","indices":[58,81],"url":"https://t.co/nSooMa6Gc5"}]},"url":{"urls":[{"display_url":"www8.cao.go.jp/souki/index.ht…","expanded_url":"https://www8.cao.go.jp/souki/index.html","indices":[0,23],"url":"https://t.co/wBzrJ8ehrX"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1117,"following":12},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1853694958383050752","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":143,"tweets":336},"verification":{"verified":false},"website":{"url":"https://t.co/wBzrJ8ehrX"}}}},"edit_control":{"edit_tweet_ids":["2107007626324349367"],"editable_until_msecs":"1791188339000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"kyoseikyojo_cao"}}},"policy":"ByInvitation"},"conversation_id_str":"2073983952931713488","created_at":"Mon Oct 05 07:18:59 +0000 2026","display_text_range":[0,154],"entities":{"hashtags":[{"indices":[0,9],"text":"障害者差別解消法"},{"indices":[87,93],"text":"つなぐ窓口"},{"indices":[124,130],"text":"障害者施策"}],"media":[{"display_url":"pic.x.com/13qmHR00Vi","expanded_url":"https://x.com/kyoseikyojo_cao/status/2107007626324349367/photo/1","ext_alt_text":"リーフレットの表紙です。タイトルは「知っていますか？障害者差別解消法」で、中央に「街の風景を背景に、各店舗の前で様々な障害をもつ人たちがお店の人とやりとりなどしている場面のイラスト」があります。\n表紙下部に「障害者差別解消法とは、障害を理由とする差別をなくすことで、障害のある人もない人も共に生きる社会をつくることを目的とした法律です。この法律では、障害者への差別として、「不当な差別的取扱い」「合理的配慮の不提供」を規定しています。」と説明があり、さらに「＊障害のある人が日常生活などで受ける制限は、社会の側にバリア（社会的障壁）があることによって生じるもの、という「障害の社会モデル」の考え方に基づいています。」と注釈があります。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2107006206229504000","indices":[155,178],"media_key":"3_2107006206229504000","media_results":{"result":{"media_key":"3_2107006206229504000"}},"media_url_https":"https://pbs.twimg.com/media/HT2W-y3aYAAhqyq.png","original_info":{"focus_rects":[{"h":1394,"w":2489,"x":0,"y":0},{"h":2489,"w":2489,"x":0,"y":0},{"h":2837,"w":2489,"x":0,"y":0},{"h":3520,"w":1760,"x":616,"y":0},{"h":3520,"w":2489,"x":0,"y":0}],"height":3520,"width":2489},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/13qmHR00Vi"}],"urls":[{"display_url":"www8.cao.go.jp/shougai/suishi…","ex