ow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":95,"tweets":405},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2106700204615291216"],"editable_until_msecs":"1791115044000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":9,"bookmarked":false,"conversation_id_str":"2106700204615291216","created_at":"Sun Oct 04 10:57:24 +0000 2026","display_text_range":[0,72],"entities":{},"favorite_count":535,"favorited":false,"full_text":"【10月4日　小泉防衛大臣臨時会見】\n在日米軍司令官への米海兵隊上等兵逮捕に関する申入れに伴い臨時会見を行いました。\n\n↓発表事項の全文はこちら","id_str":"2106700204615291216","is_quote_status":false,"lang":"ja","quote_count":8,"reply_count":13,"retweet_count":115,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/S6T9TViViLw?si…","expanded_url":"https://youtu.be/S6T9TViViLw?si=5b7w8Stdi8pEYuzR","indices":[324,347],"url":"https://t.co/Av0v5VGYqX"},{"display_url":"mod.go.jp/j/press/kisha/…","expanded_url":"https://www.mod.go.jp/j/press/kisha/2026/1004b_r.html","indices":[358,381],"url":"https://t.co/rw6dil7hs6"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY3MDAyMDQ0ODk0OTA0MzI=","text":"【10月4日　小泉防衛大臣臨時会見】\n在日米軍司令官への米海兵隊上等兵逮捕に関する申入れに伴い臨時会見を行いました。\n\n↓発表事項の全文はこちら\n本日16時50分頃、防衛省に在日米軍のジョスト司令官を呼び、この度、沖縄県那覇市で発生した強盗殺人事件について、日本側として極めて深刻に受け止めていると直接伝え、アメリカ側に強く抗議しました。その上で、御遺族に対する適切な対応を求めるとともに、捜査への全面的な協力を求め、このような惨事が二度と繰り返されることのないよう、徹底した綱紀粛正と再発防止策を講じるよう強く申し入れました。防衛省としては、引き続き、外務省や関係機関と緊密に連携しながら対応してまいります。私からは以上です。\n\n↓動画はこちら\nhttps://t.co/Av0v5VGYqX\n\n↓詳しくはこちら\nhttps://t.co/rw6dil7hs6"}}},"rest_id":"2106700204615291216","unmention_data":{},"views":{"count":"40871","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2106701593018323260","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4887","state":"EnabledWithCount"}}}}},"entryId":"tweet-2106701593018323260","sortIndex":"2107238862232223656"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2107238862232223833-tweet-2106650442226958597","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2105435585750118400/bGGw0ru8?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2105435585750118400/bGGw0ru8?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2105435585750118400/bGGw0ru8?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2105435585750118400/bGGw0ru8?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2105435585750118400/bGGw0ru8?format=png&name=2048x2048_2_exp","wid