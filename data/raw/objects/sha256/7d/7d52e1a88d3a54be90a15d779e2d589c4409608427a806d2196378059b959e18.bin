問題の未来を考えるイベント「地球規模の水破産に関する国際政策フォーラム」を開催いたします。\n国連大学（東京・渋谷）での対面参加に加え、オンラインでの視聴も可能です。ぜひご参加ください。\n 詳細・登録はこちら👇"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":10451},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1706917070934568960/SDXRGFhq_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/397713136/1768205670"},"core":{"created_at":"Tue Oct 25 02:08:15 +0000 2011","name":"国連大学","screen_name":"UNU_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozOTc3MTMxMzY=","is_blue_verified":false,"location":{"location":"東京"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2119715777024589889"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国際連合大学（こくさいれんごうだいがく、United Nations University）は、緊急性の高い地球規模の共通課題の解決に取り組むため、研究や政策提言、人材育成を行う国連のシンクタンク/研究教育機関です。本部を東京に置き、世界中に研究所があります。English account: @UNUniversity","entities":{"description":{},"url":{"urls":[{"display_url":"jp.unu.edu","expanded_url":"http://jp.unu.edu/","indices":[0,23],"url":"https://t.co/GTvq183GDL"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":8429,"following":533},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"397713136","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":2348,"tweets":12809},"verification":{"verified":false},"website":{"url":"https://t.co/GTvq183GDL"}}}},"edit_control":{"edit_tweet_ids":["212394493