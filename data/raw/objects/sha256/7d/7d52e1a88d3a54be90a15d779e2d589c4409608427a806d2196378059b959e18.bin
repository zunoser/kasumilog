734,"y":433}]},"orig":{"faces":[{"h":52,"w":52,"x":734,"y":433}]},"small":{"faces":[{"h":29,"w":29,"x":416,"y":245}]}},"id_str":"2110915048801783808","indices":[114,137],"media_key":"3_2110915048801783808","media_results":{"result":{"media_key":"3_2110915048801783808"}},"media_url_https":"https://pbs.twimg.com/media/HUt6DYLbUAAmhq0.jpg","original_info":{"focus_rects":[{"h":671,"w":1199,"x":0,"y":0},{"h":675,"w":675,"x":232,"y":0},{"h":675,"w":592,"x":273,"y":0},{"h":675,"w":338,"x":400,"y":0},{"h":675,"w":1199,"x":0,"y":0}],"height":675,"width":1199},"sizes":{"large":{"h":675,"resize":"fit","w":1199},"medium":{"h":675,"resize":"fit","w":1199},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/aM1ePazdPt"}]},"favorite_count":9,"favorited":false,"full_text":"【あなたの行動が物流を支える｜第8回】\n\nこれまで、商品が店頭へ届くまでの流れ、モノづくりを支える資材の輸送、買いだめによる需要集中、食品ロス、モノの修理、ごみの回収、リサイクルなど、暮らしと物流のつながりを紹介してきました。 https://t.co/aM1ePazdPt","id_str":"2125786623434453412","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":2,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[928,938],"text":"あなたが支える物流"},{"indices":[939,950],"text":"トラック・物流Gメン"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU3ODY2MjMwNTI4NjE0NDA=","text":"【あなたの行動が物流を支える｜第8回】\n\nこれまで、商品が店頭へ届くまでの流れ、モノづくりを支える資材の輸送、買いだめによる需要集中、食品ロス、モノの修理、ごみの回収、リサイクルなど、暮らしと物流のつながりを紹介してきました。\n\n物流は、トラックや倉庫の中だけにあるものではありません。商品を買うとき、食品を使うとき、モノを手入れするとき、ごみを出すとき。私たちの日々の選択は、さまざまな形で物流とつながっています。\n\n必要な量だけ購入すれば、短期間に物量が集中することを抑え、店舗、倉庫、輸送の負担軽減につながります。食品を無駄なく使い切れば、食品廃棄物の量が減り、回収や処理施設までの運搬を抑えることにつながります。モノを修理して長く使えば、新しい製品の輸送や、不要品の回収・運搬を減らすことにつながります。ごみを決められた方法で出すことは、安全で円滑な収集を支えます。\n\n一人の行動だけで、物流の課題がすべて解決するわけではありません。それでも、多くの人が日々の暮らしの中で少しずつ意識し、無理なく行動を続けることは、物流で働く人たちの負担を抑え、必要なモノを必要な場所へ安定して届けることにつながります。\n\n買う、使う、直す、手放す。その一つひとつの場面で、物流とのつながりを考えてみる。できることから、無理なく続けてみませんか。あなたの日々の行動が、これからの物流を支える力になります。\n\n物流を持続可能なものにしていくためには、物流事業者や荷主企業による取組に加え、商品やサービスを利用する私たちの理解と協力も大切です。物流の現場では、限られた人員や車両、時間の中で、多くのモノを安全かつ確実に運んでいます。需要や廃棄物が一時期に集中すれば、その影響は倉庫、輸送、店舗、回収、処理など幅広い現場へ及びます。\n\n大きなことを一度だけ行う必要はありません。買物の前に必要な量を確認する、食品を手前から選ぶ、モノを手入れする、ごみ出しのルールを確認する。今日からできる小さな行動を、暮らしの中で続けることが大切です。物流を社会全体で支えるという視点を、これからも一緒に広げていきましょう。\n※本画像の内容は、生成AIにより作成・加工されています。\n\n#あなたが支える物流\n#トラック・物流Gメン"}}},"rest_id":"2125786623434453412","unmention_data":{},"views":{"count":"2102","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125786623434453412","sortIndex":"2125817755226603510"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2123372392798142557"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https