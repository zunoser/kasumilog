ize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/qJradBGZ2t"}]},"favorite_count":69,"favorited":false,"full_text":"／\n今夜、フジテレビほかで放送📺！\n「ニッポン 今だ！ラボ」\n※地域により放送日時が異なります。\n＼\n\n今回のテーマは【何が本当？偽・誤情報の今！】🔎\n\n今田耕司さん・森香澄さんがナビゲート！\nナレーションは男性ブランコの浦井のりひろさん。 https://t.co/qJradBGZ2t","id_str":"2125386486455681514","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"reply_count":67,"retweet_count":19,"retweeted":false,"user_id_str":"461064204"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"fujitv.co.jp/nippon_imada_l…","expanded_url":"https://www.fujitv.co.jp/nippon_imada_labo/","indices":[194,217],"url":"https://t.co/ysZVWbHtn5"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUzODY0ODYzODg0OTQzMzY=","text":"／\n今夜、フジテレビほかで放送📺！\n「ニッポン 今だ！ラボ」\n※地域により放送日時が異なります。\n＼\n\n今回のテーマは【何が本当？偽・誤情報の今！】🔎\n\n今田耕司さん・森香澄さんがナビゲート！\nナレーションは男性ブランコの浦井のりひろさん。\n難しく思われがちな国の政策を「自分ゴト」として解説。\n「知るのは、今だ！」\n\n▼番組公式サイト\n（各地域での放送スケジュールや番組情報はこちら）\nhttps://t.co/ysZVWbHtn5\n\n放送後には、番組公式サイトで放送内容動画を公開するほか、\nTVerでも過去放送を配信中です！\n※再生できない場合はブラウザからご覧ください。"}}},"rest_id":"2125386486455681514","unmention_data":{},"views":{"count":"15084","state":"EnabledWithCount"}}},"user_id_str":"1469058582"},"rest_id":"2125454461485350997","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"300","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125454461485350997","sortIndex":"2125817755226603451"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Twe