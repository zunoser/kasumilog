l":"https://t.co/4K6OqFHXiv"},{"display_url":"pic.x.com/4K6OqFHXiv","expanded_url":"https://x.com/ModJapan_jp/status/2125575786820493498/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2125575781158162432","indices":[94,117],"media_key":"3_2125575781158162432","media_results":{"result":{"media_key":"3_2125575781158162432"}},"media_url_https":"https://pbs.twimg.com/media/HX-P6UMbEAAJufF.jpg","original_info":{"focus_rects":[{"h":444,"w":793,"x":0,"y":0},{"h":576,"w":576,"x":108,"y":0},{"h":576,"w":505,"x":144,"y":0},{"h":576,"w":288,"x":252,"y":0},{"h":576,"w":793,"x":0,"y":0}],"height":576,"width":793},"sizes":{"large":{"h":576,"resize":"fit","w":793},"medium":{"h":576,"resize":"fit","w":793},"small":{"h":494,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/4K6OqFHXiv"},{"display_url":"pic.x.com/4K6OqFHXiv","expanded_url":"https://x.com/ModJapan_jp/status/2125575786820493498/photo/3","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":120,"w":120,"x":548,"y":292}]},"medium":{"faces":[{"h":120,"w":120,"x":548,"y":292}]},"orig":{"faces":[{"h":120,"w":120,"x":548,"y":292}]},"small":{"faces":[{"h":86,"w":86,"x":396,"y":211}]}},"id_str":"2125575781086830592","indices":[94,117],"media_key":"3_2125575781086830592","media_results":{"result":{"media_key":"3_2125575781086830592"}},"media_url_https":"https://pbs.twimg.com/media/HX-P6T7aoAArsNw.jpg","original_info":{"focus_rects":[{"h":526,"w":940,"x":0,"y":101},{"h":627,"w":627,"x":227,"y":0},{"h":627,"w":550,"x":265,"y":0},{"h":627,"w":314,"x":383,"y":0},{"h":627,"w":940,"x":0,"y":0}],"height":627,"width":940},"sizes":{"large":{"h":627,"resize":"fit","w":940},"medium":{"h":627,"resize":"fit","w":940},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/4K6OqFHXiv"}]},"favorite_count":1332,"favorited":false,"full_text":"令和８年１１月２５日（水）午後、中国軍の情報収集機（Ｙ－９）×１機が大陸方面から飛来し、東シナ海上の長崎県男女群島沖の南方まで飛行した後、反転し、大陸方面に向けて飛行したことを確認した。 https://t.co/4K6OqFHXiv","id_str":"2125575786820493498","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":16,"quoted_status_id_str":"2125575237127548986","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2125575237127548986","url":"https://t.co/B4QhjZMGHw"},"reply_count":24,"retweet_count":319,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU1NzU3ODY3NjE3MTU3MTI=","text":"令和８年１１月２５日（水）午後、中国軍の情報収集機（Ｙ－９）×１機が大陸方面から飛来し、東シナ海上の長崎県男女群島沖の南方まで飛行した後、反転し、大陸方面に向けて飛行したことを確認した。\nまた、同日午後、中国軍の偵察／攻撃型無人機（ＴＢ－００１）×１機が大陸方面から飛来し、長崎県男女群島沖で変針し、大陸方面に飛行したことを確認した。\nこれに対し、航空自衛隊の南西航空方面隊等の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3294},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":362810,"following":32},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6471,"tweets":12524},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2125575237127548986"],"editable_until_msecs":"1795615202000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":29,"bookmarked":false,"conversation_id_str":"2125575237127548986","created_at":"Wed Nov 25 13:00:02 +0000 2026","display_text_range":[0,93],"entities":{"media":[{"display_url":"pic.x.com/nCLZ56M5T8","expanded_url":"https://x.com/jointstaffpa/status/2125575237127548986/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":66,"w":66,"x":534,"y":430},{"h":95,"w":95,"x":564,"y":301}]},"medium":{"faces":[{"h":66,"w":66,"x":534,"y":430},{"h":95,"w":95,"x":564,"y":301}]},"orig":{"faces":[{"h":66,"w":66,"x":534,"y":430},{"h":95,"w":95,"x":564,"y":301}]},"small":{"faces":[{"h":47,"w":47,"x":386,"y":311},{"h":68,"w":68,"x":408,"y":217}]}},"id_str":"2125570693366771712","indices":[94,117],"media_key":"3_2125570693366771712","media_results":{"result":{"media_key