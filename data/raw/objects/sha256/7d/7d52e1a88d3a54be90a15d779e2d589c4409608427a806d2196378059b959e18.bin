l":"https://t.co/exNdaL12Bp"},{"display_url":"pic.x.com/exNdaL12Bp","expanded_url":"https://x.com/ModJapan_jp/status/2125799107709337927/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2125795693629734912","indices":[132,155],"media_key":"3_2125795693629734912","media_results":{"result":{"media_key":"3_2125795693629734912"}},"media_url_https":"https://pbs.twimg.com/media/HYBX65_bAAA2_S2.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1242,"w":1242,"x":806,"y":0},{"h":1242,"w":1089,"x":959,"y":0},{"h":1242,"w":621,"x":1379,"y":0},{"h":1242,"w":2048,"x":0,"y":0}],"height":1242,"width":2048},"sizes":{"large":{"h":1242,"resize":"fit","w":2048},"medium":{"h":728,"resize":"fit","w":1200},"small":{"h":412,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/exNdaL12Bp"}]},"favorite_count":112,"favorited":false,"full_text":"11月25日、小田原防衛副大臣は、日本船主協会主催「海賊対処行動に対する感謝の集い」に出席しました。\n\n自衛隊は15年以上にわたりソマリア沖・アデン湾に部隊を派遣し、海賊対処行動を実施しています。今月には、海賊対処行動を１年間継続することが閣議で決定されました。 https://t.co/exNdaL12Bp","id_str":"2125799107709337927","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":0,"retweet_count":12,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU3OTkxMDc2NTkwMTgyNDA=","text":"11月25日、小田原防衛副大臣は、日本船主協会主催「海賊対処行動に対する感謝の集い」に出席しました。\n\n自衛隊は15年以上にわたりソマリア沖・アデン湾に部隊を派遣し、海賊対処行動を実施しています。今月には、海賊対処行動を１年間継続することが閣議で決定されました。\n引き続き、日本にとって極めて重要な海上交通路における航行の安全確保に万全を期すとともに、国際社会の平和と安定に貢献するため取り組んでまいります。"}}},"previous_counts":{"bookmark_count":2,"favorite_count":35,"quote_count":0,"reply_count":1,"retweet_count":4},"rest_id":"2125799107709337927","unmention_data":{},"views":{"count