タケと見分けがつきにくく、誤食による食中毒が発生していることを紹介。確実に食用と判断できないときは「採らない・食べない・売らない・人にあげない」と呼びかけている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":44,"w":44,"x":363,"y":422}]},"medium":{"faces":[{"h":44,"w":44,"x":363,"y":422}]},"orig":{"faces":[{"h":44,"w":44,"x":363,"y":422}]},"small":{"faces":[{"h":31,"w":31,"x":257,"y":298}]}},"id_str":"2096085836798607360","indices":[141,164],"media_key":"3_2096085836798607360","media_results":{"result":{"media_key":"3_2096085836798607360"}},"media_url_https":"https://pbs.twimg.com/media/HRbK9okbwAAmkfK.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":720,"w":720,"x":0,"y":0},{"h":720,"w":632,"x":0,"y":0},{"h":720,"w":360,"x":84,"y":0},{"h":720,"w":960,"x":0,"y":0}],"height":720,"width":960},"sizes":{"large":{"h":720,"resize":"fit","w":960},"medium":{"h":720,"resize":"fit","w":960},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/SZAakppmNB"}],"urls":[{"display_url":"maff.go.jp/j/syouan/seisa…","expanded_url":"https://www.maff.go.jp/j/syouan/seisaku/foodpoisoning/mushroom.html","indices":[117,140],"url":"https://t.co/lwf1EPzGvc"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/SZAakppmNB","expanded_url":"https://x.com/MAFF_JAPAN/status/2096086066482848096/photo/1","ext_alt_text":"毒きのこを見分けるクイズの画像。１ムキタケ、２ツキヨタケ、３ヒラタケの写真が並び、毒キノコは２のツキヨタケ。ツキヨタケは食用のムキタケやヒラタケと見分けがつきにくく、誤食による食中毒が発生していることを紹介。確実に食用と判断できないときは「採らない・食べない・売らない・人にあげない」と呼びかけている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":44,"w":44,"x":363,"y":422}]},"medium":{"faces":[{"h":44,"w":44,"x":363,"y":422}]},"orig":{"faces":[{"h":44,"w":44,"x":363,"y":422}]},"small":{"faces":[{"h":31,"w":31,"x":257,"y":298}]}},"id_str":"2096085836798607360","indices":[141,164],"media_key":"3_2096085836798607360","media_results":{"result":{"media_key":"3_2096085836798607360"}},"media_url_https":"https://pbs.twimg.com/media/HRbK9okbwAAmkfK.jpg