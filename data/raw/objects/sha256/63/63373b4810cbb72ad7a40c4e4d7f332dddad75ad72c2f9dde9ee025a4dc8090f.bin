灯籠、砂利敷きの小径が広がる。画像左下に、「秋は、京都の迎賓館へ」と白文字で記載されている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2095792681779879936","indices":[136,159],"media_key":"3_2095792681779879936","media_results":{"result":{"media_key":"3_2095792681779879936"}},"media_url_https":"https://pbs.twimg.com/media/HRXAVxBaYAA3zhq.jpg","original_info":{"focus_rects":[{"h":925,"w":1651,"x":0,"y":41},{"h":966,"w":966,"x":218,"y":0},{"h":966,"w":847,"x":278,"y":0},{"h":966,"w":483,"x":460,"y":0},{"h":966,"w":1651,"x":0,"y":0}],"height":966,"width":1651},"sizes":{"large":{"h":966,"resize":"fit","w":1651},"medium":{"h":702,"resize":"fit","w":1200},"small":{"h":398,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/c3IShkfO0M"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/c3IShkfO0M","expanded_url":"https://x.com/Kyoto_Geihinkan/status/2095792758636310781/photo/1","ext_alt_text":"紅葉の見頃を迎えた京都迎賓館の日本庭園を背景にした、来館を促すバナー画像。赤や橙に色づいた低木、手入れされた松の木、石灯籠、砂利敷きの小径が広がる。画像左下に、「秋は、京都の迎賓館へ」と白文字で記載されている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2095792681779879936","indices":[136,159],"media_key":"3_2095792681779879936","media_results":{"result":{"media_key":"3_2095792681779879936"}},"media_url_https":"https://pbs.twimg.com/media/HRXAVxBaYAA3zhq.jpg","original_info":{"focus_rects":[{"h":925,"w":1651,"x":0,"y":41},{"h":966,"w":966,"x":218,"y":0},{"h":966,"w":847,"x":278,"y":0},{"h":966,"w":483,"x":460,"y":0},{"h":966,"w":1651,"x":0,"y":0}],"height":966,"width":1651},"sizes":{"large":{"h":966,"resize":"fit","w":1651},"medium":{"h":702,"resize":"fit","w":1200},"small":{"h":398,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/c3IShkfO0M"}]},"favorite_count":167,"favorited":false,"full_text":"／\n#秋は京都の迎賓館へ\n📢2026秋のイベント情報 part1\n＼\n\n京都迎賓館では、紅葉の見頃を迎える11月後半から、この秋だけの特別なイベントを開催します！\n\nまずご紹介するのは、\n11月28日から12月8日まで（休館日の12月2日は除く）期間限定の「自由参観」🍁 https://t.co/c3IShkfO0M","id_str":"2095792758636310781","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":1,"retweet_count":38,"retweeted":false,"user_id_str":"803146955757010944"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[2,12],"text":"秋は京都の迎賓館へ"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"geihinkan.go.jp/kyoto/2026autu…","expanded_url":"https://www.geihinkan.go.jp/kyoto/2026autumn/","indices":[358,381],"url":"https://t.co/xfCxgimKPX"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTU3OTI3NTg0ODUzODUyMTY=","richtext":{"richtext_tags":[]},"text":"／\n#秋は京都の迎賓館へ\n📢2026秋のイベント情報 part1\n＼\n\n京都迎賓館では、紅葉の見頃を迎える11月後半から、この秋だけの特別なイベントを開催します！\n\nまずご紹介するのは、\n11月28日から12月8日まで（休館日の12月2日は除く）期間限定の「自由参観」🍁\n\n開催期間中は、10:00から17:00まで（16:00受付終了）のお好きな時間に、ご自身のペースで館内をご覧いただけます。\n\n事前予約は必要ありません！\n「ゆったりとお庭を眺めたい」、「写真撮影を楽しみたい」、そんなあなたにぴったりな秋の京都を満喫できる参観プランです。\n京都迎賓館の魅力を心ゆくまでご堪能ください。\n\n明日以降もイベント情報を順次ご紹介していきます。\n特設ページも作りましたので、京都迎賓館HPも是非チェックしてください♪\nhttps://t.co/xfCxgimKPX"}}},"rest_id":"2095792758636310781","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"10816","state":"EnabledWithCount"}}},"user_id_str":"2904127170"},"rest_id":"2096754271119446455","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"283","state":"EnabledWithCount"}}}}},"entryId":"tweet-2096754271119446455","sortIndex":"2096821461460189139"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"Timeli