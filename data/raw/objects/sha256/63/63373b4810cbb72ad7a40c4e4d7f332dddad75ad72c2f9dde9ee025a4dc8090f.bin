"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uhpdfbx0Ca"}]},"favorite_count":152,"favorited":false,"full_text":"⚠️アンダーパスの冠水に注意⚠️\n立体交差で道路や鉄道の下を通る「アンダーパス」は、大雨の際に冠水する危険があります。見た目以上に水位が高い場合があり、車両が進入するとエンジン停止や車内浸水のおそれがあります。無理な通行は控え、安全なルートを選択してください。＃消防庁 ＃大雨 #道路冠水 https://t.co/uhpdfbx0Ca","id_str":"2090354151297614263","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":2,"retweet_count":94,"retweeted":false,"user_id_str":"137272821"},"rest_id":"2090354151297614263","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"183233","state":"EnabledWithCount"}}},"rest_id":"2092739912521199787","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"134506","state":"EnabledWithCount"}}},"user_id_str":"137272821"},"rest_id":"2096719307006947352","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"state":"Enabled"}}}}},"entryId":"tweet-2096719307006947352","sortIndex":"2096821461460189134"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/LiaoYE9IEC"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twim