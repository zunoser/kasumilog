278,"w":1121,"x":0,"y":0},{"h":1495,"w":748,"x":186,"y":0},{"h":1495,"w":1121,"x":0,"y":0}],"height":1495,"width":1121},"sizes":{"large":{"h":1495,"resize":"fit","w":1121},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/bsl0MwPMfu"},{"display_url":"pic.x.com/bsl0MwPMfu","expanded_url":"https://x.com/Kyoto_Geihinkan/status/2096510235850822136/photo/1","ext_alt_text":"能楽金剛流　若宗家・金剛 龍謹（こんごう たつのり）氏のプロフィール写真","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":644,"w":644,"x":434,"y":394}]},"medium":{"faces":[{"h":377,"w":377,"x":254,"y":230}]},"orig":{"faces":[{"h":1288,"w":1288,"x":868,"y":788}]},"small":{"faces":[{"h":213,"w":213,"x":144,"y":130}]}},"id_str":"2096510098147569664","indices":[153,176],"media_key":"3_2096510098147569664","media_results":{"result":{"media_key":"3_2096510098147569664"}},"media_url_https":"https://pbs.twimg.com/media/HRhM05Qa8AAACz1.jpg","original_info":{"focus_rects":[{"h":1720,"w":3072,"x":0,"y":676},{"h":3072,"w":3072,"x":0,"y":0},{"h":3502,"w":3072,"x":0,"y":0},{"h":4096,"w":2048,"x":512,"y":0},{"h":4096,"w":3072,"x":0,"y":0}],"height":4096,"width":3072},"sizes":{"large":{"h":2048,"resize":"fit","w":1536},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/bsl0MwPMfu"}]},"favorite_count":87,"favorited":false,"full_text":"／\n#秋は京都の迎賓館へ\n📢2026秋のイベント情報 part3\n＼\n\n今日9月6日は、「寛永行幸」からちょうど400年を迎える節目の日です。\nこの行幸をきっかけに、能楽、茶の湯、いけばななど、のちの日本文化に多大な影響をもたらす「寛永文化」が花開きました。\n\n京都迎賓館では、この秋、#寛永行幸四百年祭 https://t.co/bsl0MwPMfu","id_str":"2096510235850822136","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":18,"retweeted":false,"user_id_str":"803146955757010944"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[2,12],"text":"秋は京都の迎賓館へ"},{"indices":[143,152],"text":"寛永行幸四百年祭"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"geihinkan.go.jp/kyoto/2026autu…","expanded_url":"https://www.geihinkan.go.jp/kyoto/2026autumn/","indices":[339,362],"url":"https://t.co/xfCxgimKPX"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTY1MTAyMzU3NTQzNDAzNTI=","richtext":{"richtext_tags":[]},"text":"／\n#秋は京都の迎賓館へ\n📢2026秋のイベント情報 part3\n＼\n\n今日9月6日は、「寛永行幸」からちょうど400年を迎える節目の日です。\nこの行幸をきっかけに、能楽、茶の湯、いけばななど、のちの日本文化に多大な影響をもたらす「寛永文化」が花開きました。\n\n京都迎賓館では、この秋、#寛永行幸四百年祭 とタイアップし、一日限定の特別イベントを実施します！\n\n第13回 文化サロン🍁\n「能楽 －京都のまちに深く根差した伝統芸能－」\n\n能楽金剛流 二十六世宗家・人間国宝　金剛 永謹 氏 及び 若宗家・金剛 龍謹 氏による特別講演と、通常非公開の「水明の間」を加えた京都迎賓館ガイドツアーの2部構成です。\n\n申込方法などの詳細は、決まり次第、京都迎賓館HPにてお知らせします！\nhttps://t.co/xfCxgimKPX\n\n※ 寛永行幸とは：\n寛永3年(1626年)9月6日、徳川幕府が後水尾天皇を二条城にお迎えし、5日間にわたって様々にもてなした、江戸時代を通じて最大級とも言えるイベント。"}}},"rest_id":"2096510235850822136","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3986","state":"EnabledWithCount"}}},"user_id_str":"2904127170"},"rest_id":"2096754389629415801","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"325","state":"EnabledWithCount"}}}}},"entryId":"tweet-2096754389629415801","sortIndex":"2096821461460189141"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j