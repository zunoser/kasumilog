pan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2095650141558768004"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":586640,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20131,"tweets":48784},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2096149653263917310"],"editable_until_msecs":"1788599596000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":497,"bookmarked":false,"conversation_id_str":"2096149653263917310","created_at":"Sat Sep 05 08:13:16 +0000 2026","display_text_range":[0,73],"entities":{"media":[{"display_url":"pic.x.com/ooog0UxKIB","expanded_url":"https://x.com/MofaJapan_jp/status/2096149653263917310/photo/1","ext_alt_text":"９月４日、ロシア・ハバロフスク市内において、菊花紋章が型取られた標石をソ連兵が破壊する様子を表現した対日戦勝記念碑の銅像の除幕式が開催されました。 \n\n　このような像は我が国との関係上建設的なものではなく、特に、菊花紋章は日本を象徴する紋章として広く認識されており、その破壊を表現する記念碑を設置することは、日本の国民感情の観点から受け入れられず、極めて遺憾です。外交ルートを通じて、ロシア側に対し、設置の中止及び撤去を強く要請しました。 \n\n　ロシア側が、現時点まで日本側の要請に応じていないことは極めて遺憾であり、引き続き撤去をロシア側に強く働きかけていきます。 ","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2096149646343299072","indices":[74,97],"media_key":"3_2096149646343299072","media_results":{"result":{"media_key":"3_2096149646343299072"}},"media_url_https":"https://pbs.twimg.com/media/HRcE_1paYAA3MDe.jpg","original_info":{"focus_rects":[{"h":368,"w":657,"x":0,"y":0},{"h":368,"w":368,"x":86,"y":0},{"h":368,"w":323,"x":109,"y":0},{"h":368,"w":184,"x":178,"y":0},{"h":368,"w":1200,"x":0,"y":0}],"height":368,"width":1200},"sizes":{"large":{"h":368,"resize":"fit","w":1200},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/ooog0UxKIB"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/ooog0UxKIB","expanded_url":"https://x.com/MofaJapan_jp/status/2096149653263917310/photo/1","ext_alt_text":"９月４日、ロシア・ハバロフスク市内において、菊花紋章が型取られた標石をソ連兵が破壊する様子を表現した対日戦勝記念碑の銅像の除幕式が開催されました。 \n\n　このような像は我が国との関係上建設的なものではなく、特に、菊花紋章は日本を象徴する紋章として広く認識されており、その破壊を表現する記念碑を設置することは、日本の国民感情の観点から受け入れられず、極めて遺憾です。外交ルートを通じて、ロシア側に対し、設置の中止及び撤去を強く要請しました。 \n\n　ロシア側が、現時点まで日本側の要請に応じていないことは極めて遺憾であり、引き続き撤去をロシア側に強く働きかけていきます。 ","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2096149646343299072","indices":[74,97],"media_key":"3_2096149646343299072","media_results":{"resul