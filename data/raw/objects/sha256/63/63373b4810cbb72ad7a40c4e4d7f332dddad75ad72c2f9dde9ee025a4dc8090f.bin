:"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/H8fxS3nFN5"}]},"favorite_count":134,"favorited":false,"full_text":"／\n#秋は京都の迎賓館へ\n📢2026秋のイベント情報 part2\n＼\n\n京都迎賓館では、11月28日から12月1日までの4日間限定で、「夜間延長公開」を実施します🌖 https://t.co/H8fxS3nFN5","id_str":"2096146747676631363","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":22,"retweeted":false,"user_id_str":"803146955757010944"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[2,12],"text":"秋は京都の迎賓館へ"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"geihinkan.go.jp/kyoto/2026autu…","expanded_url":"https://www.geihinkan.go.jp/kyoto/2026autumn/","indices":[260,283],"url":"https://t.co/xfCxgimKPX"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTYxNDY3NDc2MDExNzQ1Mjg=","richtext":{"richtext_tags":[]},"text":"／\n#秋は京都の迎賓館へ\n📢2026秋のイベント情報 part2\n＼\n\n京都迎賓館では、11月28日から12月1日までの4日間限定で、「夜間延長公開」を実施します🌖\n\n柔らかな灯りで照らされた日本庭園の紅葉や、綴れ織の技法で織られた壁面装飾『麗花』が水面に映る姿など、水鏡の美しさに心癒される、秋の京都迎賓館の魅力が存分に詰まった参観プランとなっています。\n\n事前予約は必要ありません！\n京都観光のかたはもちろん、お仕事帰りや学校帰りのかたも是非、日中とは趣の異なる晩秋の彩りをどうぞご堪能ください。\n\n詳細はこちら：\nhttps://t.co/xfCxgimKPX"}}},"rest_id":"2096146747676631363","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"5916","state":"EnabledWithCount"}}},"user_id_str":"2904127170"},"rest_id":"2096754320574480770","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"276","state":"EnabledWithCount"}}}}},"entryId":"tweet-2096754320574480770","sortIndex":"2096821461460189140"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTime