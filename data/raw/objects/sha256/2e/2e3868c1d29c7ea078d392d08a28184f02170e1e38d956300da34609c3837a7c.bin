y_count":3,"retweet_count":18,"retweeted":false,"user_id_str":"970485094111522816"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[206,215],"text":"令和８年熊本地震"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk0MjUyMzQzNjU2NTcwODg=","richtext":{"richtext_tags":[]},"text":"被災井戸の早期復旧に向け、9月7日から(一社)熊本県地質調査業協会の会員企業19社による事前調査が行われていましたが、その体制に新たに(一社)九州地質調査業協会の会員企業12社が加わりました。\n本日、(一社)熊本地質調査業協会が、一定の水準で調査が可能になるよう結果判定基準に関する意思統一の説明会を行い、早速、各自が現地踏査に向かわれました。\n国、県、市、関係団体が一体となって、復旧の促進を進めていきます。\n#令和８年熊本地震"}}},"rest_id":"2099425234420212103","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"4590","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2099666538337026486","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"612","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099666538337026486","sortIndex":"2099766465237352398"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=