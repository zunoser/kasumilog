tatus":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2099465448047976449","indices":[141,164],"media_key":"3_2099465448047976449","media_results":{"result":{"media_key":"3_2099465448047976449"}},"media_url_https":"https://pbs.twimg.com/media/HSLMs5kbIAEA63A.jpg","original_info":{"focus_rects":[{"h":786,"w":1403,"x":0,"y":0},{"h":1139,"w":1139,"x":26,"y":0},{"h":1139,"w":999,"x":96,"y":0},{"h":1139,"w":570,"x":310,"y":0},{"h":1139,"w":1403,"x":0,"y":0}],"height":1139,"width":1403},"sizes":{"large":{"h":1139,"resize":"fit","w":1403},"medium":{"h":974,"resize":"fit","w":1200},"small":{"h":552,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/slZmIqYAI3"}]},"favorite_count":156,"favorited":false,"full_text":"本日、上野大臣は筑波記念病院と県南病院を視察。\n急性期から生活期までのリハビリ体制や、障害のある方の就労支援・運転再開支援などの現場を拝見しました。\nリハビリは「攻めの予防医療」です。\n\n厚労省は、予防・医療・介護を通じた切れ目のないリハビリの推進に引き続き取り組んでまいります。 https://t.co/slZmIqYAI3","id_str":"2099465454465249496","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":11,"reply_count":23,"retweet_count":37,"retweeted":false,"user_id_str":"180585090"},"rest_id":"2099465454465249496","source":"<a href=\"https://social.userlocal.jp/\" rel=\"nofollow\">Userlocal SocialInsight</a>","unmention_data":{},"views":{"count":"34356","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099465454465249496","sortIndex":"2099766465237352386"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_c