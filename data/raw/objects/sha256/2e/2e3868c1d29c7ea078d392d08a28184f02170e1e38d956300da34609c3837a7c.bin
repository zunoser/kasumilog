dices":[246,249],"text":"防災"},{"indices":[250,253],"text":"防犯"},{"indices":[254,262],"text":"ぼうさい探検隊"},{"indices":[263,271],"text":"地域安全マップ"},{"indices":[272,277],"text":"損保協会"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTkyODkwNjA2MzY1MjQ1NDQ=","richtext":{"richtext_tags":[]},"text":"【この秋は、子どもたちとまちを歩いて、地域安全マップを作ろう🗺️🔍】\n\n暑さも少しずつ和らいだ今こそ、子どもたちとまちを歩いてみませんか？\n「第23回 小学生のぼうさい探検隊マップコンクール」では、作品を募集中です！\n締切は11月20日（金）！まだまだ間に合います🍂\n\n地震や大雨などの災害が多い今、子ども達との探検を通じて、地域の通学路や街なかの「危険な場所」を改めて見直してみませんか？\n\nこれまでのぼうさい探検隊入賞作品や応募詳細などについては、リプ欄をご参照ください👇\n\n#交通安全 #防災 #防犯 #ぼうさい探検隊 #地域安全マップ #損保協会"}}},"rest_id":"2099289060691083348","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"7638","state":"EnabledWithCount"}}}},"user_id_str":"137272821"},"rest_id":"2099660742257787288","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1695","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2099660742257787288","sortIndex":"2099766465237352391"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1788223971"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_ac