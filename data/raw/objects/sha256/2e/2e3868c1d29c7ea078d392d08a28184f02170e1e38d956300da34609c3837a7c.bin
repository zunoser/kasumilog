":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2099697979762614272","indices":[91,114],"media_key":"3_2099697979762614272","media_results":{"result":{"media_key":"3_2099697979762614272"}},"media_url_https":"https://pbs.twimg.com/media/HSOgMBtbIAAP2e_.jpg","original_info":{"focus_rects":[{"h":404,"w":722,"x":0,"y":0},{"h":481,"w":481,"x":0,"y":0},{"h":481,"w":422,"x":0,"y":0},{"h":481,"w":241,"x":0,"y":0},{"h":481,"w":722,"x":0,"y":0}],"height":481,"width":722},"sizes":{"large":{"h":481,"resize":"fit","w":722},"medium":{"h":481,"resize":"fit","w":722},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/zapCsdzXds"}]},"favorite_count":369,"favorited":false,"full_text":"防衛省市ヶ谷地区（東京都）に所在する自衛隊殉職者慰霊碑地区（メモリアルゾーン）を、10月29日（木）に一般公開いたします。\n一般公開は本年7月の公開に続き、2回目の実施となります。 https://t.co/zapCsdzXds","id_str":"2099709800351154322","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":3,"retweet_count":75,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"mod.go.jp/j/profile/memo…","expanded_url":"https://www.mod.go.jp/j/profile/memorial_zone/index.html","indices":[227,250],"url":"https://t.co/ZIsTexS3qu"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk3MDk4MDAyNDYyOTI0ODA=","text":"防衛省市ヶ谷地区（東京都）に所在する自衛隊殉職者慰霊碑地区（メモリアルゾーン）を、10月29日（木）に一般公開いたします。\n一般公開は本年7月の公開に続き、2回目の実施となります。\n \n自衛隊殉職者慰霊碑は、尊い命を国家に捧げた殉職隊員の功績を永久に顕彰し、深甚なる敬意と哀悼の意を捧げることを目的に建立されたものです。\n \n事前申し込み制で、申し込み多数の場合には抽選となります。\n \n⇊お申し込みや詳細はこちら（本日～９/25（金）18:00締切）\nhttps://t.co/ZIsTexS3qu"}}},"rest_id":"2099709800351154322","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"17460","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099709800351154322","sortIndex":"20997