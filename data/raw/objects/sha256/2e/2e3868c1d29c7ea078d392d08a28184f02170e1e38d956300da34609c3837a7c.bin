ull_text":"警察とJAFが合同でチャイルドシート使用状況等の調査を行いました。\n６歳未満の幼児を乗車させる際は必ずチャイルドシートを使用しましょう。\n６歳以上のこどもでも、シートベルトを適切に着用できない場合はチャイルドシートを使用しましょう！\nhttps://t.co/gbdFSPfnmk\n＃チャイルドシート　＃警察","id_str":"2099679601785962876","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":7,"retweet_count":38,"retweeted":false,"user_id_str":"2891516809"},"rest_id":"2099679601785962876","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"4967","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099679601785962876","sortIndex":"2099766465237352400"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092927185678127486"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"農林水産省の公式アカウントです。ご意見・ご質問は、総合窓口にお寄せください。\n総合窓口→https://t.co/XLQwxIPiHh\n運用方針→https://t.co/2SnzXCNurZ","entities":{"description":{"urls":[{"display_url":"contactus.maff.go.jp/voice/sogo.html","expanded_url":"https://www.contactus.maff.go.jp/voice/sogo.html","indices":[44,67],"url":"https://t.co/XLQwxIPiHh"},{"display_url":"maff.go.jp/j/pr/social_me…","expanded_url":"https://www.maff.go.jp/j/pr/social_media/policy.html","indices":[73,96],"url":"https://t.co/2SnzXCNurZ"}]},"url":{"urls":[{"display_url":"maff.go.jp","expanded_url":"https://www.maff.go.jp/","indices":[0,23],"url":"https://t.co/cPtrdtbo0N"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":269298,"following":57},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2335919749","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8261,"tweets":17704},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/cPtrdtbo0N"}}}},"edit_control":{"edit_tweet_ids":["2099679599940583811"],"editable_until_msecs":"1789441201000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2099679599940583811","created_at":"Tue Sep 15 02:00:01 +0000 2026","display_text_range":[0,144],"entities":{},"favorite_count":19,"favorited":false,"full_text":"🌲海辺の森が、地域の暮らしを守っていることをご存じでしたか？\n\n11月13日（金）に仙台湾の海岸防災林を巡りながら、その役割や東日本大震災からの再生の歩みを学べる見学会を開催\n\n 📍震災遺構仙台市立荒浜小学校 ほか\n\n自然や防災に関心のある皆さま、ぜひご参加ください（9月30日申込〆）👇","id_str":"2099679599940583811","is_quote_status":true,"lang":"ja","quote_count":0,"quoted_status_id_str":"2080487532580716839","quoted_status_permalink":{"display":"x.com/rinya_to/statu…","expanded":"https://twitter.com/rinya_to/status/2080487532580716839","url":"https://t.co/A307OuiW0L"},"reply_count":2,"retweet_count":3,"retweeted":false,"user_id_str":"2335919749"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":11},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1676481821918494720/scy2Aq0e_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1676446979784863744/1688538473"},"core":{"created_at":"Wed Jul 05 04:26:05 +0000 2023","name":"林野庁　東北森林管理局（公式）🌲","screen_name":"rinya_to"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNjc2NDQ2OTc5Nzg0ODYzNzQ0","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2080487532580716839"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"東北森林管理局の公式アカウントです。\n林野庁の地方支分部局として、青森県、岩手県、宮城県、秋田県、山形県の国有林野の管理経営をとりまとめています。日本の国土の約７割を占める森林には、国土の保全、地球温暖化の防止、といった多面的な機能があります。その森林の適切な整備・保全にかかわる仕事をしています。","entities":{"description":{},"url":{"urls":[{"display_url":"rinya.maff.go.jp/tohoku/","expanded_url":"https://www.rinya.maff.go.jp/tohoku/","indices":[0,23],"url":"https://t.co/pFoPjpyEbz"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":229,"following":3},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1676446979784863744","super_follow_eligible":false,"super_followed_by":false,"supe