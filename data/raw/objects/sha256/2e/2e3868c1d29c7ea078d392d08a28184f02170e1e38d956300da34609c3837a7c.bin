"h":380,"resize":"fit","w":1164},"medium":{"h":380,"resize":"fit","w":1164},"small":{"h":222,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/5Hpks9fICS"}]},"favorite_count":946,"favorited":false,"full_text":"令和８年９月１２日から１３日にかけて、ロシア海軍ステレグシチー級フリゲート１隻が、対馬海峡を南西進し、東シナ海へ向けて航行したことを確認しました。 https://t.co/5Hpks9fICS","id_str":"2099449498581991480","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"quoted_status_id_str":"2099446559578763659","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2099446559578763659","url":"https://t.co/lvRZpURoXR"},"reply_count":9,"retweet_count":202,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk0NDk0OTg1MzE2NjM4NzI=","text":"令和８年９月１２日から１３日にかけて、ロシア海軍ステレグシチー級フリゲート１隻が、対馬海峡を南西進し、東シナ海へ向けて航行したことを確認しました。\n防衛省・自衛隊は、海上自衛隊の第３哨戒防備隊所属「おおたか」（佐世保）及び第４航空群所属「Ｐ－１」（厚木）により、警戒監視・情報収集を行いました。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360548,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6324,"tweets":12369},"verification":{"verified":false},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2099446559578763659"],"editable_until_msecs":"1789385640000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":14,"bookmarked":false,"conversation_id_str":"2099446559578763659","created_at":"Mon Sep 14 10:34:00 +0000 2026","display_text_range":[0,73],"entities":{"media":[{"display_url":"pic.x.com/hpBo3t6tQA","expanded_url":"https://x.com/jointstaffpa/status/2099446559578763659/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2099444349583216640","indices":[74,97],"media_key":"3_2099444349583216640","media_results":{"result":{"media_key":"3_2099444349583216640"}},"media_url_https":"https://pbs.twimg.com/media/HSK5gzqb0AAvC7V.png","original_info":{"focus_rects":[{"h":280,"w":500,"x":0,"y":