antei/status/2099457237853114552/video/1","ext_media_availability":{"status":"Available"},"id_str":"2099456802643664896","indices":[137,160],"media_key":"13_2099456802643664896","media_results":{"result":{"media_key":"13_2099456802643664896"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2099456802643664896/img/n_p91mmKHvyDc1qJ.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/auZKmdeECn","video_info":{"aspect_ratio":[16,9],"duration_millis":205833,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2099456802643664896/pl/G0qs9nNZiMCVF7BZ.m3u8?tag=29&v=aaf"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099456802643664896/vid/avc1/480x270/ufPU4xvexJQH6KUJ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099456802643664896/vid/avc1/640x360/D8KX2Wd9hyLSa2Fk.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099456802643664896/vid/avc1/1280x720/Jy0x7DDVBOo2s60p.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/auZKmdeECn","expanded_url":"https://x.com/kantei/status/2099457237853114552/video/1","ext_media_availability":{"status":"Available"},"id_str":"2099456802643664896","indices":[137,160],"media_key":"13_2099456802643664896","media_results":{"result":{"media_key":"13_2099456802643664896"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2099456802643664896/img/n_p91mmKHvyDc1qJ.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/auZKmdeECn","video_info":{"aspect_ratio":[16,9],"duration_millis":205833,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2099456802643664896/pl/G0qs9nNZiMCVF7BZ.m3u8?tag=29&v=aaf"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099456802643664896/vid/avc1/480x270/ufPU4xvexJQH6KUJ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099456802643664896/vid/avc1/640x360/D8KX2Wd9hyLSa2Fk.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099456802643664896/vid/avc1/1280x720/Jy0x7DDVBOo2s60p.mp4?tag=29"}]}}]},"favorite_count":2194,"favorited":false,"full_text":"【お知らせ】\n９月１４日、高市総理はビロル国際エネルギー機関（ＩＥＡ）事務局長による表敬を受けました。\n\n冒頭発言要旨(速報版、仮訳)\n(高市総理)\n　ビロル事務局長とは３月以来の再会で嬉しく思っております。エネルギーを取り巻く国際情勢は先が見通せない状況が続いています。 https://t.co/auZKmdeECn","id_str":"2099457237853114552","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":15,"reply_count":50,"retweet_count":262,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk0NTcyMzc3NzMzMzI0ODA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n９月１４日、高市総理はビロル国際エネルギー機関（ＩＥＡ）事務局長による表敬を受けました。\n\n冒頭発言要旨(速報版、仮訳)\n(高市総理)\n　ビロル事務局長とは３月以来の再会で嬉しく思っております。エネルギーを取り巻く国際情勢は先が見通せない状況が続いています。\n　そのような中で私は、ビロル事務局長にも御支持をいただいたパワー・アジアの下での取組に加えまして、世界のエネルギー安全保障の確保に向けた３つの柱として、①自由で透明なエネルギー貿易の確保、②ＩＥＡとの連携を含む石油備蓄の国際協調、③生産国と消費国の連携強化を、Ｇ７の場を含めて国際社会に呼びかけております。\n　また、先月２６日ですけれども、日本のエネルギー需給構造の更なる強靱化のために、「化石燃料の調達安定性の強靱化」に加えまして「ＧＸの加速・強化」を掲げた、パワーＧＸというパッケージを打ち出しました。今後、このパワーＧＸの取組を世界に広めて、グローバルな需給構造の強靱化を進めたいと考えております。 ぜひ一緒にやってまいりましょう。\n\n（ビロル事務局長）※日本語仮訳\n　高市総理、改めて私自身及びＩＥＡ事務局をお迎えいただき感謝いたします。\n　日本の取組は詳しくフォローしており、日本のみならずアジア地域における貴総理の取組及び素晴らしいリーダーシップに感謝と祝意を申し上げます。\n　パワー・アジア及びパワーＧＸの主要なイニシアティブはアジアだけでなく、アジア太平洋、そして世界のエネルギー安全保障にとって時宜に適った素晴らしい取組であり、我々としても最大限支援する準備ができています。\n　今般の危機は想定以上に長期化しており、アジアが最も影響を受けています。そのため、私は今回、ＡＰＥＣエネルギー大臣会合に出席した後訪日し、本日、経済産業大臣とも会談しており、外務大臣ともこのあと会談します。明日、韓国に移動し、李大統領にも面会を予定しています。"}}},"rest_id":"2099457237853114552","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"55408","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099457237853114552","sortIndex":"2099766465237352384"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 htt