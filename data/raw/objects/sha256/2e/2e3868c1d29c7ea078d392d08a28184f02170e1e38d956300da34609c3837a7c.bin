translation":{"translator_type":"none"},"relationship_counts":{"followers":296712,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4944,"tweets":12928},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6ku2s"}}}},"edit_control":{"edit_tweet_ids":["2099362505521082474"],"editable_until_msecs":"1789365600000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":21,"bookmarked":false,"conversation_id_str":"2099362505521082474","created_at":"Mon Sep 14 05:00:00 +0000 2026","display_text_range":[0,159],"entities":{"media":[{"display_url":"pic.x.com/hvnJ8KQZTL","expanded_url":"https://x.com/gov_online/status/2099362505521082474/photo/1","ext_alt_text":"上部に「自然災害でローンの返済が困難になったかたへ。「自然災害債務整理ガイドライン」という選択肢があります。※「災害救助法」が適用された自然災害により被災した、個人又は個人事業者のかたが対象。※そのほかにいくつかの要件を満たす必要があります」と記載されており、その下に、家が倒壊してしまい「ローンが残っているのに...」と困っている様子の男性イラストが描かれている。その下には、次のように記載されている。3つのメリット。個人信用情報として登録されず、その後の新たな借入れにも影響が及ばない。登録支援専門家の支援を無料で受けられる。預貯金などの財産の一部を手元に残すことができる。※個別事情により異なります。希望する場合は、ローンの借入先の金融機関にお問い合わせください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":71,"w":71,"x":496,"y":95}]},"medium":{"faces":[{"h":65,"w":65,"x":457,"y":87}]},"orig":{"faces":[{"h":71,"w":71,"x":496,"y":95}]},"small":{"faces":[{"h":37,"w":37,"x":259,"y":49}]}},"id_str":"2099358620433661952","indices":[160,183],"media_key":"3_2099358620433661952","media_results":{"result":{"media_key":"3_2099358620433661952"}},"media_url_https":"https://pbs.twimg.com/media/HSJritsaQAAepN1.jpg","original_info":{"focus_rects":[{"h":546,"w":975,"x":0,"y":734},{"h":975,"w":975,"x":0,"y":325}