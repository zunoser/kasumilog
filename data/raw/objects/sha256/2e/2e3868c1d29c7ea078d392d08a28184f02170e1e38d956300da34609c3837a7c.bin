8,"w":496,"x":0,"y":345},{"h":496,"w":496,"x":0,"y":223},{"h":565,"w":496,"x":0,"y":154},{"h":719,"w":360,"x":0,"y":0},{"h":719,"w":496,"x":0,"y":0}],"height":719,"width":496},"sizes":{"large":{"h":719,"resize":"fit","w":496},"medium":{"h":719,"resize":"fit","w":496},"small":{"h":680,"resize":"fit","w":469},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/1piG8YOcpV"},{"display_url":"pic.x.com/1piG8YOcpV","expanded_url":"https://x.com/ModJapan_jp/status/2099450057724776739/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2099450049671692288","indices":[72,95],"media_key":"3_2099450049671692288","media_results":{"result":{"media_key":"3_2099450049671692288"}},"media_url_https":"https://pbs.twimg.com/media/HSK-smJbgAAWXTs.jpg","original_info":{"focus_rects":[{"h":388,"w":693,"x":234,"y":0},{"h":388,"w":388,"x":386,"y":0},{"h":388,"w":340,"x":410,"y":0},{"h":388,"w":194,"x":483,"y":0},{"h":388,"w":1160,"x":0,"y":0}],"height":388,"width":1160},"sizes":{"large":{"h":388,"resize":"fit","w":1160},"medium":{"h":388,"resize":"fit","w":1160},"small":{"h":227,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/1piG8YOcpV"}]},"favorite_count":810,"favorited":false,"full_text":"令和８年９月１３日、中国海軍ドンディアオ級情報収集艦１隻が、奄美大島と横当島との間の海域を北東進し、太平洋へ向けて航行したことを確認しました。 https://t.co/1piG8YOcpV","id_str":"2099450057724776739","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"quoted_status_id_str":"2099447062823842266","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2099447062823842266","url":"https://t.co/NcrrMXPJPo"},"reply_count":18,"retweet_count":200,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk0NTAwNTc2Nzg1MjQ0MTY=","text":"令和８年９月１３日、中国海軍ドンディアオ級情報収集艦１隻が、奄美大島と横当島との間の海域を北東進し、太平洋へ向けて航行したことを確認しました。\n防衛省・自衛隊は、海上自衛隊の第１航空群所属「Ｐ－１」（鹿屋）及び第４航空群所属「Ｐ－１」（厚木）により、警戒監視・情報収集を行いました。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360548,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_cou