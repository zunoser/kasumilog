ble"},"features":{"large":{"faces":[{"h":141,"w":141,"x":1001,"y":311},{"h":171,"w":171,"x":229,"y":429},{"h":183,"w":183,"x":1123,"y":247}]},"medium":{"faces":[{"h":83,"w":83,"x":587,"y":182},{"h":100,"w":100,"x":134,"y":251},{"h":107,"w":107,"x":658,"y":144}]},"orig":{"faces":[{"h":180,"w":180,"x":1272,"y":396},{"h":218,"w":218,"x":291,"y":545},{"h":233,"w":233,"x":1426,"y":314}]},"small":{"faces":[{"h":47,"w":47,"x":332,"y":103},{"h":57,"w":57,"x":76,"y":142},{"h":60,"w":60,"x":372,"y":82}]}},"id_str":"2100168353537232896","indices":[135,158],"media_key":"3_2100168353537232896","media_results":{"result":{"media_key":"3_2100168353537232896"}},"media_url_https":"https://pbs.twimg.com/media/HSVL_YkakAAgrma.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":22,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/sryEbUp3Fz"}]},"favorite_count":3195,"favorited":false,"full_text":"本日、「2027国際園芸博覧会（横浜グリーンエクスポ）を成功させる国会議員連盟」の設立総会に出席し、御挨拶申し上げました。\n\n開幕まで半年となるこのタイミングで、党派を超えた議員連盟が設立され、「横浜グリーンエクスポ」を応援いただけますことに、感謝の気持ちで一杯です。 https://t.co/sryEbUp3Fz","id_str":"2100168389700554978","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":31,"reply_count":194,"retweet_count":332,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDAxNjgzODk2Mzc2NjQ3Njg=","richtext":{"richtext_tags":[]},"text":"本日、「2027国際園芸博覧会（横浜グリーンエクスポ）を成功させる国会議員連盟」の設立総会に出席し、御挨拶申し上げました。\n\n開幕まで半年となるこのタイミングで、党派を超えた議員連盟が設立され、「横浜グリーンエクスポ」を応援いただけますことに、感謝の気持ちで一杯です。\n\n私からは、「美しい花と緑」、「食と農の魅力」があふれる「みんなが楽しめる万博」とするとともに、「強い経済」の構築に向けて、我が国の優れた「グリーン技術」が披露されるいわば「産業見本市」としていく旨を申し上げました。\n\nグリーンエクスポには、全ての都道府県と政令市を含む、多くの自治体が出展を予定しており、地域の魅力を国内外に発信する絶好の機会にもなります。\n\n議員連盟の皆様とも連携しながら、「オールジャパン体制」で準備に万全を期してまいります。"}}},"rest_id":"2100168389700554978","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"107678","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100168389700554978","sortIndex":"2100186710905192446"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府の公式アカウントです。内閣府大臣官房政策評価広報課が運営しています。運営方針 https://t.co/LtXxYQ4rJW を御確認のうえ御利用ください。問い合わせは https://t.co/ANlK6wet0H","entities":{"description":{"urls":[{"display_url":"cao.go.jp/others/seihyou…","expanded_url":"https://www.cao.go.jp/others/seihyou/sns/x.html",