resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EO40WDnwfd"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/EO40WDnwfd","expanded_url":"https://x.com/takaichi_sanae/status/2099808235113136511/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2099808136689553409","indices":[55,78],"media_key":"3_2099808136689553409","media_results":{"result":{"media_key":"3_2099808136689553409"}},"media_url_https":"https://pbs.twimg.com/media/HSQEYAPbEAEk89r.jpg","original_info":{"focus_rects":[{"h":358,"w":640,"x":0,"y":93},{"h":480,"w":480,"x":160,"y":0},{"h":480,"w":421,"x":219,"y":0},{"h":480,"w":240,"x":312,"y":0},{"h":480,"w":640,"x":0,"y":0}],"height":480,"width":640},"sizes":{"large":{"h":480,"resize":"fit","w":640},"medium":{"h":480,"resize":"fit","w":640},"small":{"h":480,"resize":"fit","w":640},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EO40WDnwfd"}]},"favorite_count":11788,"favorited":false,"full_text":"本日、「防災功労者　内閣総理大臣表彰式」を開催し、16名の個人と25の団体の皆様を表彰させていただきました。 https://t.co/EO40WDnwfd","id_str":"2099808235113136511","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":63,"reply_count":895,"retweet_count":1084,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk4MDgyMzUwNTQ0MTU4NzI=","richtext":{"richtext_tags":[]},"text":"本日、「防災功労者　内閣総理大臣表彰式」を開催し、16名の個人と25の団体の皆様を表彰させていただきました。\n\n「防災功労者表彰」を受けられた皆様は、様々な災害に際し、危険や困難に直面しながらも、ひるむことなく、人命救助、住民の安全確保などに取り組まれた方々、また、防災に関する講習会の開催や地域の防災訓練の実施などに尽力され、災害による被害の防止・軽減に大きく寄与された方々です。\n\nそのご貢献、ご労苦に対し、心より敬意を表しますとともに、深く感謝申し上げます。\n\n災害への対応に万全を期すためには、全ての関係者の皆様の知恵と力を結集して、取り組む必要があり、「産官学民」の連携が不可欠です。\n\n表彰を受けられた皆様が、それぞれの分野において、益々ご活躍されることをお祈り致しますとともに、災害に強い国づくりに、一層ご尽力いただけますよう、お願い申し上げたところです。\n\n※熊本市消防団の皆様から、可愛らしい手作りの人形がついたキーホルダーを頂戴しました。\n大切にいたします。ありがとうございました。"}}},"rest_id":"2099808235113136511","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"302156","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099808235113136511","sortIndex":"2100186710905192371"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti