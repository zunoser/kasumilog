l_text":"／ \nトゥンクトゥンクカラーに染まる、東京の夜景🌙\n東京スカイツリー® 特別ライティングが決定！\n＼\n\n世界有数のランドマークである東京スカイツリー®と\nトゥンクトゥンクとのコラボが決定しました⭐\n\nトゥンクトゥンクをイメージした、\nグリーン・ブルー・ピンク・イエローの４色で彩った https://t.co/8wjrL6f8hF","id_str":"2095019866038091876","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":21,"reply_count":2,"retweet_count":298,"retweeted":false,"user_id_str":"1551723376557031424"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[384,389],"text":"トゥン活"},{"indices":[390,402],"text":"トゥンクトゥンク応援団"},{"indices":[464,478],"text":"withGREENEXPO"},{"indices":[479,492],"text":"2027年国際園芸博覧会"},{"indices":[493,507],"text":"greenexpo2027"},{"indices":[508,517],"text":"トゥンクトゥンク"},{"indices":[518,523],"text":"トゥン活"},{"indices":[524,536],"text":"トゥンクトゥンク応援団"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"expo2027yokohama.or.jp/assets/docs/ne…","expanded_url":"https://expo2027yokohama.or.jp/assets/docs/news/press_20260902_1.pdf","indices":[333,356],"url":"https://t.co/H95arW9Xia"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTUwMTk4NjU4NzAzNDQxOTU=","richtext":{"richtext_tags":[]},"text":"／ \nトゥンクトゥンクカラーに染まる、東京の夜景🌙\n東京スカイツリー® 特別ライティングが決定！\n＼\n\n世界有数のランドマークである東京スカイツリー®と\nトゥンクトゥンクとのコラボが決定しました⭐\n\nトゥンクトゥンクをイメージした、\nグリーン・ブルー・ピンク・イエローの４色で彩った\n東京スカイツリー®の特別ライティングを点灯します。\n\n気になる点灯日時は…👀\n・開幕約半年前  2026年9月15日(火)19：00～24：00\n・開幕100日前   2026年12月9日(水)17：30～24：00\n・開幕当日  　　2027年3月19日(金)18：45～24：00\n\nGREEN×EXPO 2027の記念日に、特別な一夜をお楽しみください😊\n\n詳しくはこちら\n👉https://t.co/H95arW9Xia\n\n現在、トゥンクトゥンク推し活キャンペーンを実施中！\n#トゥン活 #トゥンクトゥンク応援団 の２つのハッシュタグをつけて、\n東京スカイツリー®を背景にみなさんが撮影したトゥンクトゥンクの写真を、ぜひ投稿してね！\n\n#withGREENEXPO\n#2027年国際園芸博覧会\n#greenexpo2027\n#トゥンクトゥンク\n#トゥン活\n#トゥンクトゥンク応援団"}}},"previous_counts":{"bookmark_count":0,"favorite_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"rest_id":"2095019866038091876","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"137813","state":"EnabledWithCount"}}},"rest_id":"2099800652402528337","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"74822","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099800652402528337","sortIndex":"2100186710905192365"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profil