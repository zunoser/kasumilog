w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/dZ8XyUBX5S","video_info":{"aspect_ratio":[16,9],"duration_millis":42842,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2099807357115224064/pl/ko6U9fxcfsICoY2G.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099807357115224064/vid/avc1/480x270/5BUqMVyQCRpdb2t1.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099807357115224064/vid/avc1/640x360/muX2P2FUrHBV5E8k.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099807357115224064/vid/avc1/1280x720/TRpltG0jxxwPZf8f.mp4?tag=29"}]}}]},"favorite_count":3182,"favorited":false,"full_text":"9月15日、防衛省が借り上げている民間船舶「はくおうⅡ」は、任務を終え、熊本県の八代港を出港しました。\n岸壁には、多くの市民の皆様がお見送りに駆けつけてくださり、温かい感謝の言葉をいただきました。 https://t.co/dZ8XyUBX5S","id_str":"2099807772938485896","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":33,"quoted_status_id_str":"2099136262296969508","quoted_status_permalink":{"display":"x.com/ModJapan_saiga…","expanded":"https://twitter.com/ModJapan_saigai/status/2099136262296969508","url":"https://t.co/2JtaOawOk5"},"reply_count":36,"retweet_count":712,"retweeted":false,"user_id_str":"1182556649120075776"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk4MDc3NzI4Nzk4NDMzMjg=","richtext":{"richtext_tags":[]},"text":"9月15日、防衛省が借り上げている民間船舶「はくおうⅡ」は、任務を終え、熊本県の八代港を出港しました。\n岸壁には、多くの市民の皆様がお見送りに駆けつけてくださり、温かい感謝の言葉をいただきました。\n\n避難生活を余儀なくされる中、多くの皆様に入浴・宿泊・食事支援などをご利用いただきました。\n「はくおうⅡ」の活動が、厳しい避難生活の中で、少しでも皆様の安らぎにつながっていたのであれば幸いです。\n\nご協力いただいた医療関係団体や関係機関の皆様に改めて感謝申し上げます。\n防衛省・自衛隊は、今回いただいた多くの激励を胸に、今後も国民の皆様の安心と安全のため全力を尽くしてまいります。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2455},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182592351472013314/X9jVEv2u_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1182556649120075776/1570786963"},"core":{"created_at":"Fri Oct 11 07:21:20 +0000 2019","name":"防衛省・自衛隊（災害対策）","screen_name":"ModJapan_saigai"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTgyNTU2NjQ5MTIwMDc1Nzc2","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省・自衛隊の災害対策公式アカウント／災害派遣活動や災害対策に関する最新情報をお届けします。皆さまの安全と暮らしを守るため、災害現場で対応する部隊・隊員たちの姿を迅速にお伝えしていきます。\n災害派遣以外の自衛隊の活動は、統合幕僚監部のアカウントで発信中　https://t.co/P7BIrjGuU5","entities":{"description":{"urls":[{"display_url":"x.com/jointstaffpa","expanded_url":"https://x.com/jointstaffpa","indices":[128,151],"url":"https://t.co/P7BIrjGuU5"}]},"url":{"urls":[{"display_url":"mod.go.jp/js/activity/do…","expanded_url":"https://www.mod.go.jp/js/activity/domestic.html","indices":[0,23],"url":"https://t.co/7Fx4sySSJE"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":262020,"following":24},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1182556649120075776","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1448,"tweets":3565},"verification":{"v