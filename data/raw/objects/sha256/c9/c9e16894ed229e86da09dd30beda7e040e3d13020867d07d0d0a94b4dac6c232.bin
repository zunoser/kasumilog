ue,"id":"VXNlcjoxMjgzMjIxODYyNzU1OTEzNzI4","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2072244701676413223"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の自衛官募集公式アカウントです。自衛官等の採用に関する情報をわかりやすく発信します。自衛官という職業の魅力をお届けしていきます。【Instagram】https://t.co/u5vSN1If7K","entities":{"description":{"urls":[{"display_url":"instagram.com/jsdf_recruit","expanded_url":"https://www.instagram.com/jsdf_recruit","indices":[84,107],"url":"https://t.co/u5vSN1If7K"}]},"url":{"urls":[{"display_url":"mod.go.jp/gsdf/jieikanbo…","expanded_url":"https://www.mod.go.jp/gsdf/jieikanbosyu/","indices":[0,23],"url":"https://t.co/ymurbTMASP"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":12524,"following":249},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1283221862755913728","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":479,"tweets":1115},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/ymurbTMASP"}}}},"edit_control":{"edit_tweet_ids":["2121164511709397404"],"editable_until_msecs":"1794563603000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":8,"bookmarked":false,"conversation_id_str":"2121164511709397404","created_at":"Fri Nov 13 08:53:23 +0000 2026","display_text_range":[0,139],"entities":{},"favorite_count":171,"favorited":false,"full_text":"なぜ、自衛隊に音楽隊があるのか。\n \n川口市立高校・吹奏楽部の高校生特派員が、中央音楽隊・副隊長を取材。\n「指揮者って、音を出していないんですよ。」\n指揮の役割から、音楽隊が存在する理由、そして\n「誰かのために演奏する。何かの目的のために演奏する。」\nという思いまで聞きました。","id_str":"2121164511709397404","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":44,"retweeted":false,"user_id_str":"1283221862755913728"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[213,223],"text":"自衛CANNEWS"},{"indices":[224,230],"text":"自衛官募集"},{"indices":[231,238],"text":"高校生特派員"},{"indices":[239,246],"text":"川口市立高校"},{"indices":[247,252],"text":"吹奏楽部"},{"indices":[253,259],"text":"中央音楽隊"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/gsdf/jieikanbo…","expanded_url":"https://www.mod.go.jp/gsdf/jieikanbosyu/jcannews/","indices":[187,210],"url":"https://t.co/hn4ZjeUSL2"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExNjQ1MTE2NDY1Njg0NDg=","text":"なぜ、自衛隊に音楽隊があるのか。\n \n川口市立高校・吹奏楽部の高校生特派員が、中央音楽隊・副隊長を取材。\n「指揮者って、音を出していないんですよ。」\n指揮の役割から、音楽隊が存在する理由、そして\n「誰かのために演奏する。何かの目的のために演奏する。」\nという思いまで聞きました。\n自衛隊の音楽が届けようとしているものとは。\n動画でご覧ください。\n \n🔗自衛CAN NEWS\nhttps://t.co/hn4ZjeUSL2\n \n#自衛CANNEWS #自衛官募集 #高校生特派員 #川口市立高校 #吹奏楽部 #中央音楽隊"}}},"rest_id":"2121164511709397404","unmention_data":{},"views":{"count":"14184","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2121166463113535952","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4409","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121166463113535952","sortIndex":"2121441624188780503"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"co