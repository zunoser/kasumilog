ounts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075709,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":637,"tweets":1962},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2121142487242915987"],"editable_until_msecs":"1794558352000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":75,"bookmarked":false,"conversation_id_str":"2121142487242915987","created_at":"Fri Nov 13 07:25:52 +0000 2026","display_text_range":[0,125],"entities":{},"favorite_count":6665,"favorited":false,"full_text":"山崎正昭先生のご逝去の報に接し、謹んで哀悼の誠を捧げます。\n\n山崎先生は、参議院議員として長きにわたり国政の要職を歴任されました。\nとりわけ、第30代参議院議長として、公正かつ円満な議会運営に尽力され、我が国憲政の発展に多大なるご功績を残されました。","id_str":"2121142487242915987","is_quote_status":false,"lang":"ja","quote_count":40,"reply_count":604,"retweet_count":605,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExNDI0ODcxOTI2MjUxNTI=","richtext":{"richtext_tags":[]},"text":"山崎正昭先生のご逝去の報に接し、謹んで哀悼の誠を捧げます。\n\n山崎先生は、参議院議員として長きにわたり国政の要職を歴任されました。\nとりわけ、第30代参議院議長として、公正かつ円満な議会運営に尽力され、我が国憲政の発展に多大なるご功績を残されました。\nまた、郷土福井の発展にも心血を注がれ、そのお人柄は多くの方々から深く敬愛されました。\n\nここに生前のご功績を偲び、深い敬意と感謝の意を表します。\n\n山崎正昭先生のご冥福を、心よりお祈り申し上げます。"}}},"rest_id":"2121142487242915987","unmention_data":{},"views":{"count":"333933","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121142487242915987","sortIndex":"2121441624188780476"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":15},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/960685038957244417/qRIY3RTr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/719219671/1597226136"},"core":{"created_at":"Fri Jul 27 02:08:13 +0000 2012","name":"原子力規制委員会 / NRA Japan","screen_name":"gensiryokukisei"},"dm_permissions":{"can_dm":false},"follow_requ