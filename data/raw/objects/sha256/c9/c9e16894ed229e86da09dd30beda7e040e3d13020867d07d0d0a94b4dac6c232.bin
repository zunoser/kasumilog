,"w":39,"x":279,"y":510},{"h":40,"w":40,"x":1082,"y":519},{"h":51,"w":51,"x":75,"y":467},{"h":65,"w":65,"x":385,"y":438}]},"orig":{"faces":[{"h":54,"w":54,"x":110,"y":646},{"h":53,"w":53,"x":373,"y":681},{"h":54,"w":54,"x":1443,"y":692},{"h":68,"w":68,"x":101,"y":623},{"h":87,"w":87,"x":514,"y":584}]},"small":{"faces":[{"h":22,"w":22,"x":46,"y":274},{"h":22,"w":22,"x":158,"y":289},{"h":22,"w":22,"x":613,"y":294},{"h":28,"w":28,"x":42,"y":264},{"h":36,"w":36,"x":218,"y":248}]}},"id_str":"2121150052307738624","indices":[133,156],"media_key":"3_2121150052307738624","media_results":{"result":{"media_key":"3_2121150052307738624"}},"media_url_https":"https://pbs.twimg.com/media/HW_Wu_caoAANAMJ.jpg","original_info":{"focus_rects":[{"h":896,"w":1600,"x":0,"y":304},{"h":1200,"w":1200,"x":400,"y":0},{"h":1200,"w":1053,"x":547,"y":0},{"h":1200,"w":600,"x":940,"y":0},{"h":1200,"w":1600,"x":0,"y":0}],"height":1200,"width":1600},"sizes":{"large":{"h":1200,"resize":"fit","w":1600},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/U1k7qQ9GNH"}]},"favorite_count":268,"favorited":false,"full_text":"11月12日、防衛省・自衛隊は #ACICE の専門家を招き、サイバーセキュリティセミナーを実施しました。\nサイバー脅威に関する情報共有や各国との協力強化の重要性を再認識しました。\n今後も信頼醸成や能力構築などを通じて実践的な協力を推進していきます。\n\nACICE https://t.co/U1k7qQ9GNH","id_str":"2121150071228002815","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":42,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[16,22],"text":"ACICE"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"acice-asean.org","expanded_url":"https://www.acice-asean.org/","indices":[268,291],"url":"https://t.co/1E2AJiwFH2"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExNTAwNzEwOTM3NzYzODQ=","text":"11月12日、防衛省・自衛隊は #ACICE の専門家を招き、サイバーセキュリティセミナーを実施しました。\nサイバー脅威に関する情報共有や各国との協力強化の重要性を再認識しました。\n今後も信頼醸成や能力構築などを通じて実践的な協力を推進していきます。\n\nACICE （ADMMサイバーセキュリティ情報センター）とは、サイバー攻撃や偽・誤情報の脅威を背景に、ASEAN 防衛当局間の協力強化のために設立された機関です。\n2021年の第15回 ASEAN 国防相会議（ADMM）で設置が承認され、シンガポール国防省の主導で設立されました。\nhttps://t.co/1E2AJiwFH2"}}},"rest_id":"2121150071228002815","unmention_data":{},"views":{"count":"23260","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121150071228002815","sortIndex":"2121441624188780482"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2121135978303611239"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府の公式アカウントです。内閣府大臣官房政策評価広報課が運営しています。運営方針 https://t.co/LtXxYQ4rJW を御確認のうえ御利用ください。問い合わせは https://t.co/ANlK6wet0H","entities":{"description":{"urls":[{"display_url":"cao.go.jp/others/seihyou…","expanded_url":"https://www.cao.go.jp/others/seihyou/sns/x.html","ind