_count":1470,"favorited":false,"full_text":"令和８年１１月１２日、中国海軍ルーヤンⅢ級ミサイル駆逐艦及びフユ級高速戦闘支援艦の計２隻が、沖縄本島と宮古島との間の海域を南東進し、太平洋に向けて航行したことを確認しました。 https://t.co/J4Bd5A5Ixz","id_str":"2121128429512696127","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":18,"reply_count":22,"retweet_count":453,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExMjg0Mjk0NzUwMjQ4OTY=","text":"令和８年１１月１２日、中国海軍ルーヤンⅢ級ミサイル駆逐艦及びフユ級高速戦闘支援艦の計２隻が、沖縄本島と宮古島との間の海域を南東進し、太平洋に向けて航行したことを確認しました。\n防衛省・自衛隊は、海上自衛隊の第１航空群所属「Ｐ－１」（鹿屋）及び第５航空群所属「Ｐ－３Ｃ」（那覇）により、警戒監視・情報収集を行いました。"}}},"rest_id":"2121128429512696127","unmention_data":{},"views":{"count":"62293","state":"EnabledWithCount"}}},"rest_id":"2121132070387019987","unmention_data":{},"views":{"count":"33028","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121132070387019987","sortIndex":"2121441624188780464"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/875540374780911616/70s-ef5h_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1469058582/1398238011"},"core":{"created_at":"Thu May 30 06:31:59 +0000 2013","name":"総務省","screen_name":"MIC_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNDY5MDU4NTgy","is_blue_verified":