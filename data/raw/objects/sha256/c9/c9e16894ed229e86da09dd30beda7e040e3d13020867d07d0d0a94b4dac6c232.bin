_at":"Fri Nov 13 10:25:39 +0000 2026","display_text_range":[0,100],"entities":{},"favorite_count":12,"favorited":false,"full_text":"／\n「Japan Innovation Campus Showcase in Tokyo」\nを開催しました！\n＼\n米国・シリコンバレーに設置したスタートアップ支援拠点「Japan Innovation","id_str":"2121187731263131853","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":2,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/11/…","expanded_url":"https://www.meti.go.jp/press/2026/11/20261113002.html","indices":[239,262],"url":"https://t.co/UuyZnWCwsu"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExODc3MzExNDE1NDU5ODQ=","richtext":{"richtext_tags":[]},"text":"／\n「Japan Innovation Campus Showcase in Tokyo」\nを開催しました！\n＼\n米国・シリコンバレーに設置したスタートアップ支援拠点「Japan Innovation Campus」開設から約3年間の活動状況や、現地で挑戦する日本のスタートアップの取組を紹介するとともに、各セッションでは、グローバル展開における実体験や課題、シリコンバレーにおける日本人プロフェッショナル同士の連携の重要性など、活発な意見交換が行われました。\n👇詳細はこちら\nhttps://t.co/UuyZnWCwsu"}}},"rest_id":"2121187731263131853","unmention_data":{},"views":{"count":"7428","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2121441624188780571-tweet-2121187733695758411","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPP