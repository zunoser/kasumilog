b":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/fMmq15EwI3"}]},"favorite_count":2175,"favorited":false,"full_text":"＼全自衛官の年収がUPします✨／\n\n11月13日、防衛省の給与改正法が成立し、\n全自衛官の給与が上がります！\n\n📌高卒の初任給は約25万円に☺️\n📌生涯収入は約2.9億円から約3.1億円に☺️\n\nこれらはいずれも過去最高の金額です⭐️ https://t.co/fMmq15EwI3","id_str":"2121126435339612574","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":67,"reply_count":63,"retweet_count":429,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExMjY0MzUyNzI1MDMyOTY=","richtext":{"richtext_tags":[]},"text":"＼全自衛官の年収がUPします✨／\n\n11月13日、防衛省の給与改正法が成立し、\n全自衛官の給与が上がります！\n\n📌高卒の初任給は約25万円に☺️\n📌生涯収入は約2.9億円から約3.1億円に☺️\n\nこれらはいずれも過去最高の金額です⭐️\nまた、今回の法律改正で上がった分の給与は本年4月からさかのぼって支給されます！\n\nさらに、自衛官の給与体系の\n独自の見直しを現在検討中💪"}}},"rest_id":"2121126435339612574","unmention_data":{},"views":{"count":"165872","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121126435339612574","sortIndex":"2121441624188780461"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"card":{"rest_id":"https://t.co/rZI9UuLLoW"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2121125787655127538"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":384992,"following":478},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"571429134","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8112,"tweets":88746},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/yYaoVyKjKO"}}}},"edit_control":{"edit_tweet_ids":["2121125787655127538"],"editable_until_msecs":"1794554371000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":21,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"MLIT_JAPAN"}}},"policy":"Community"},"conversation_id_str":"2121125787655127538","created_at":"Fri Nov 13 06:19:31 +0000 2026","display_text_range":[0,121],"entities":{},"favorite_count":305,"favorited":false,"full_text":"【Microsoft365の大規模障害に伴うメールシステムの不具合】\n本日未明からのMicrosoft社の障害に伴い、国土交通省においても、メールの送受信ができない状況です。当省へのお問合せは、代表電話もしくは担当各課の電話をご利用ください。","id_str":"2121125787655127538","is_quote_status":false,"lang":"ja","quote_count":13,"reply_count":0,"retweet_count":142,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mlit.go.jp/page/kanbo01_h…","expanded_url":"https://www.mlit.go.jp/page/kanbo01_hy_011225.html","indices":[236,259],"url":"https://t.co/rZI9UuLLoW"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExMjU3ODc1MzM1MTI3MDQ=","richtext":{"richtext_tags":[]},"text":"【Microsoft365の大規模障害に伴うメールシステムの不具合】\n本日未明からのMicrosoft社の障害に伴い、国土交通省においても、メールの送受信ができない状況です。当省へのお問合せは、代表電話もしくは担当各課の電話をご利用ください。 \nまた、本日、当省にメール送信されていた場合、受信できていない可能性があります。電話をご活用いただき、ご連絡いただくようお願いいたします。なお、公式ウェブサイトの閲覧は支障ありません。\n\n代表電話番号　03-5253-8111\nhttps://t.co/rZI9UuLLoW"}}},"rest_id":"2121125787655127538","unmention_data":{},"views":{"count":"36019","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2121125787655127538","sortIndex":"2121441624188780460"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2120257333750267905/vDHIITbI?format=jpg&n