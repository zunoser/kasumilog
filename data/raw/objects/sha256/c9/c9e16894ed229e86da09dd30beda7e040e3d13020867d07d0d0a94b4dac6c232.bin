],"entities":{},"favorite_count":6,"favorited":false,"full_text":"◇━━━━━━━━━━━━━━━◇\nJapan Innovation Campus　とは\n◇━━━━━━━━━━━━━━━◇","id_str":"2121187733695758411","in_reply_to_screen_name":"meti_NIPPON","in_reply_to_status_id_str":"2121187731263131853","in_reply_to_user_id_str":"266566401","is_quote_status":false,"lang":"ca","quote_count":0,"reply_count":0,"retweet_count":1,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExODc3MzM2NTM5MDEzMTI=","richtext":{"richtext_tags":[]},"text":"◇━━━━━━━━━━━━━━━◇\nJapan Innovation Campus　とは\n◇━━━━━━━━━━━━━━━◇\n日本のスタートアップの海外展開を支援するために、2023年11月に経済産業省が米国・シリコンバレーに設置した拠点です。シリコンバレーでの資金調達成功事例が生まれるとともに、現地の投資家や専門家等とのネットワークが広がるなどの成果が出ています。"}}},"rest_id":"2121187733695758411","unmention_data":{},"views":{"count":"2912","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2121187731263131853","2121187733695758411"],"enableDeduplication":true}}},"entryId":"list-conversation-2121441624188780571","sortIndex":"2121441624188780517"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=280x150","width":225},"type":"IMAGE"}},{"key":"description","value":{"string_value":"高級織物の代名詞的存在で、国指定の伝統工芸品「西陣織」には、長い伝統を守り続けてきた和装の最高峰というイメージ","type":"STRING"}},{"key":"domain","value":{"string_value":"journal.meti.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=800x320_1","width":480},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=orig","width":1080},"type":"IMAGE"}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"summary_photo_image_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":67,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=100x100","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=png&name=2048x2048_2_exp","width":1080},"type":"IMAGE"}},{"key":"photo_image_full_size_original","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=orig","width":1080},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"journal.meti.go.jp","type":"STRING"}},{"key":"photo_image_full_size","value":{"image_value":{"height":314,"url":"https://pbs.twimg.com/card_img/2121187009666707456/mJ9HtfZE?format=jpg&name=600x314","width":6