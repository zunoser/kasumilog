e":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/t3WsbutjBt"}]},"favorite_count":3510,"favorited":false,"full_text":"【日本列島を、強く豊かに。：北海道芽室町編】\n\n本日は、『地域未来戦略』に基づき北海道芽室町が策定した、「食・観光分野における地場産業成長プラン」をご紹介します。\n\n令和6年に、「日高山脈襟裳十勝国立公園」が新たに国立公園に指定されました。 https://t.co/t3WsbutjBt","id_str":"2121406228308152786","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":41,"reply_count":312,"retweet_count":399,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[708,720],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjE0MDYyMjgyMjgzNjIyNDA=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：北海道芽室町編】\n\n本日は、『地域未来戦略』に基づき北海道芽室町が策定した、「食・観光分野における地場産業成長プラン」をご紹介します。\n\n令和6年に、「日高山脈襟裳十勝国立公園」が新たに国立公園に指定されました。\n日高山脈や十勝平野の雄大な姿を芽室町から一望でき、雄大な自然や美しい景観を地場の観光資源として活用できるポテンシャルを有しています。\n\nこのため、芽室町は、雄大な自然と美しい景観を活かすため、誘客の核となる施設の整備を図るとともに、食や観光に関連する事業の集積に取り組むことで、地域経済の拡大を図る「地場産業成長プラン」を策定しました。\n\nこの計画では、『地域未来戦略』の国の支援も活用し、ショップ、ビジターセンターなどの核となる誘客施設や、スキー場の整備への投資を行うとともに、農産物の6次産業化や加工・流通事業者との連携に取り組むことで、芽室町の観光消費や地域経済の拡大を図るとともに、十勝地域全体に効果を波及させることを目指しています。\n\n私自身、手島町長から以下の意気込みを伺いました。\n\n「この計画により、官民投資を推進し、道内外からの観光の受け皿となる魅力的な観光拠点施設を作るとともに、スキー場やキャンプ場などのさらなる魅力向上、まちなか再生などにより、広域観光に寄与し、地域経済の力強い成長の実現を目指してまいります。地域未来戦略は、小規模自治体のチャレンジの後押しとなります。我々地域のチャレンジへのご支援をお願いいたします。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を全力で応援してまいります。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2121406228308152786","unmention_data":{},"views":{"count":"122188","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121406228308152786","sortIndex":"2121441624188780535"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__t