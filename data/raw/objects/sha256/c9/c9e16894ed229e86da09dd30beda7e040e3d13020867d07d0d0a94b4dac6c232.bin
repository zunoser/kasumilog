":2400,"w":3600,"x":0,"y":0}],"height":2400,"width":3600},"sizes":{"large":{"h":1365,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0pOQAzfNku"}]},"favorite_count":16,"favorited":false,"full_text":"石井苗子政務官は、11/12に令和8年度製品安全対策優良企業表彰20周年記念式典に出席。製品安全対策優良企業表彰（#PSアワード）を受賞された皆様に表彰状を授与するとともに、挨拶では、製品安全を企業価値の向上につなげながら、安全・安心な社会の実現を目指していく重要性を述べました。 https://t.co/0pOQAzfNku","id_str":"2121193344286212602","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":1,"retweet_count":5,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[57,64],"text":"PSアワード"},{"indices":[321,326],"text":"製品安全"},{"indices":[327,335],"text":"プラスあんしん"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/product_safety…","expanded_url":"https://meti.go.jp/product_safety/ps-award/3-consumer/r8_award.html","indices":[258,281],"url":"https://t.co/SOcd6q1f3t"},{"display_url":"meti.go.jp/product_safety…","expanded_url":"https://meti.go.jp/product_safety/ps-award/risksystem/award.html","indices":[297,320],"url":"https://t.co/IpeyNhDoOw"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExOTMzNDQxNTIwMDI1NjA=","richtext":{"richtext_tags":[]},"text":"石井苗子政務官は、11/12に令和8年度製品安全対策優良企業表彰20周年記念式典に出席。製品安全対策優良企業表彰（#PSアワード）を受賞された皆様に表彰状を授与するとともに、挨拶では、製品安全を企業価値の向上につなげながら、安全・安心な社会の実現を目指していく重要性を述べました。\n \nPSアワードは製品安全の実現に向け、優れた取り組みを行う企業や団体を表彰する制度です。\n受賞企業・団体は、私たちの暮らしに安心・安全な製品を届けるため、日々さまざまな挑戦や工夫に取り組んでいます。\n👉PSアワード受賞企業はこちら\nhttps://t.co/SOcd6q1f3t\n👉＋あんしん受賞製品はこちら\nhttps://t.co/IpeyNhDoOw\n#製品安全 #プラスあんしん"}}},"rest_id":"2121193344286212602","unmention_data":{},"views":{"count":"6151","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121193344286212602","sortIndex":"2121441624188780521"},{"content":{"__typename":"Timeli