":0}],"height":2204,"width":3130},"sizes":{"large":{"h":1442,"resize":"fit","w":2048},"medium":{"h":845,"resize":"fit","w":1200},"small":{"h":479,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/e4r6JVfYJC"}]},"favorite_count":41,"favorited":false,"full_text":"髙木副大臣は、在日メキシコ商工会議所設立記念イベントに出席。設立に祝意を表するとともに、日メキシコ間の経済関係が一層発展することへの期待を述べました。また、イベントに先立ち、メキシコ合衆国のベラスコ（H.E. Mr. Roberto Velasco https://t.co/e4r6JVfYJC","id_str":"2121191790472737202","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":9,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExOTE3OTA0MTQxMTg5MTI=","richtext":{"richtext_tags":[]},"text":"髙木副大臣は、在日メキシコ商工会議所設立記念イベントに出席。設立に祝意を表するとともに、日メキシコ間の経済関係が一層発展することへの期待を述べました。また、イベントに先立ち、メキシコ合衆国のベラスコ（H.E. Mr. Roberto Velasco Álvarez）外務大臣と会談。在メキシコ日系企業のビジネス環境や鉄鋼製品の輸入・通関に係る問題について意見交換を行うとともに、CPTPPにおける連携を含む両国の経済関係の更なる強化を確認しました。"}}},"rest_id":"2121191790472737202","unmention_data":{},"views":{"count":"6337","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121191790472737202","sortIndex":"2121441624188780519"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://p