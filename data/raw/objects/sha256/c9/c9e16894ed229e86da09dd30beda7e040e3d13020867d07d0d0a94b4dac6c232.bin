636547","created_at":"Fri Nov 13 13:35:13 +0000 2026","display_text_range":[0,141],"entities":{"hashtags":[{"indices":[6,15],"text":"笹川博義環境大臣"},{"indices":[18,27],"text":"令和８年熊本地震"}]},"favorite_count":16,"favorited":false,"full_text":"11/13、#笹川博義環境大臣 は「#令和８年熊本地震 非常災害復旧復興本部(第２回)」に出席しました。\n熊本県が公表した「復旧・復興プラン」に基づき、公費解体を含む災害廃棄物の処理終了目標を達成できるよう、引き続き課題を丁寧に把握し、熊本県とともに被災自治体を支援してまいります。","id_str":"2121235436236636547","is_quote_status":true,"lang":"ja","quote_count":0,"quoted_status_id_str":"2121189313258074124","quoted_status_permalink":{"display":"x.com/kantei/status/…","expanded":"https://twitter.com/kantei/status/2121189313258074124","url":"https://t.co/oENtexlVMu"},"reply_count":1,"retweet_count":2,"retweeted":false,"user_id_str":"286056244"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_descriptio