h":798,"w":700,"x":0,"y":0},{"h":798,"w":399,"x":130,"y":0},{"h":798,"w":1200,"x":0,"y":0}],"height":798,"width":1200},"sizes":{"large":{"h":798,"resize":"fit","w":1200},"medium":{"h":798,"resize":"fit","w":1200},"small":{"h":452,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/RbyS0u8Fdt"}]},"favorite_count":22,"favorited":false,"full_text":"令和8年11月11日、藤井総務大臣は「第70回町村議会議長全国大会」に出席し、祝辞を述べました。\n挨拶では、出席された町村議会議長の皆様に対し、日頃の地方自治発展のためのご尽力に敬意と感謝の意を表し、町村議会議長の皆様と意思疎通を図りながら、地域の発展に全力で取り組む旨を述べました。 https://t.co/RbyS0u8Fdt","id_str":"2121131754601992445","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":2,"retweeted":false,"user_id_str":"1469058582"},"rest_id":"2121131754601992445","unmention_data":{},"views":{"count":"3664","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121131754601992445","sortIndex":"2121441624188780463"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":9},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":