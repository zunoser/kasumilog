op","w":150}},"type":"video","url":"https://t.co/Ysft5r8lx3","video_info":{"aspect_ratio":[16,9],"duration_millis":190333,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2113203636193083392/pl/5tvS4WimhvpkZfKE.m3u8?tag=29&v=bcc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113203636193083392/vid/avc1/480x270/PRk1kMfgHD1S5lAc.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113203636193083392/vid/avc1/640x360/Zxc12Rfmg1yRkPRq.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113203636193083392/vid/avc1/1280x720/oNPi-lYCqiRCvw_a.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/Ysft5r8lx3","expanded_url":"https://x.com/kantei/status/2113205419766431845/video/1","ext_media_availability":{"status":"Available"},"id_str":"2113203636193083392","indices":[89,112],"media_key":"13_2113203636193083392","media_results":{"result":{"media_key":"13_2113203636193083392"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2113203636193083392/img/jdnT1NsoL6MUGNhq.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/Ysft5r8lx3","video_info":{"aspect_ratio":[16,9],"duration_millis":190333,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2113203636193083392/pl/5tvS4WimhvpkZfKE.m3u8?tag=29&v=bcc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113203636193083392/vid/avc1/480x270/PRk1kMfgHD1S5lAc.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113203636193083392/vid/avc1/640x360/Zxc12Rfmg1yRkPRq.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113203636193083392/vid/avc1/1280x720/oNPi-lYCqiRCvw_a.mp4?tag=29"}]}}]},"favorite_count":1503,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２２日）、木原官房長官は、第１回ＡＩ・デジタル改革推進会議に出席しました。\n\n※木原官房長官発言要旨（速報版）\n　本日はどうもありがとうございました。 https://t.co/Ysft5r8lx3","id_str":"2113205419766431845","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":15,"reply_count":105,"retweet_count":177,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTMyMDU0MTk2Njk4NTYyNTY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２２日）、木原官房長官は、第１回ＡＩ・デジタル改革推進会議に出席しました。\n\n※木原官房長官発言要旨（速報版）\n　本日はどうもありがとうございました。\n　ＡＩの急速な発達を踏まえまして、社会全体のＡＸ・ＤＸを強力に推進していくため、本日、『ＡＩ・デジタル改革推進会議』を始動いたしました。\n　本日の会議では、今月１日の「日本成長戦略会議」における高市総理からの指示を踏まえた検討状況につきまして、各大臣から説明があったところです。有識者の皆様からも活発なご議論をいただき、改めて感謝を申し上げます。\n　本日の議論を踏まえ、①ＡＸの具体像、②ＡＩ・デジタル改革原則、③ＡＸ社会実装の加速化、この３点を、特に優先的に進めるべき事項として、年末までに「中間整理」のかたちで取りまとめることとしたいと思います。\n　また、「ＡＩガバナンスの強化」など、残された論点についても、年明け以降速やかに具体化し、関連する計画等の改定につなげていきたいと思います。\n　そのため、関係大臣には、以下の点をお願いします。\n　まず、ＡＸの具体像について。古川大臣は、２０３０年時点のＡＸが実現された行政、産業、暮らしの姿などの具体像を年末までに明確化するとともに、「信頼できるＡＩ」の確立に向けたＡＩ法を含む関連法制度の見直しや、ＡＩＳＩ（エイシー）の更なる機能強化を進めてください。\n　次に、規制・制度改革について、でありますが、古川大臣は、「ＡＸに対応した構造改革を進めるための原則」、これを年末までに策定してください。\n　古川大臣と中司大臣におかれては、関係大臣とも連携し、ＡＩと「人」のベストミックスの実現に向けた規制・制度の整備を、府省庁の垣根を越えて速やかに進めてください。\n　また、各府省庁による「アナログ規制の見直し」の再点検も含め、法制度検証・改革担当の観点から、山下大臣と連携して進めてください。\n　ＡＸの社会実装について。赤澤大臣は、年末までに、ＡＸ実装を加速する、即効性のあるアクションプランを取りまとめ、速やかに、人手不足問題の緩和と成長戦略の実現を図ってください。\n　その際、古川大臣と連携して、フィジカルＡＩ・ＡＩロボットなどの日本の強みを確固たるものとする具体策の検討を進めてください。\n　また、古川大臣は、関係大臣と連携し、自動運転を始めとする公共や準公共分野のＡＸの方策を、順次具体化してください。\n　以上を中心として、関係大臣は、年末の「中間整理」に向けて、効果的なＡＸ・ＤＸの推進方策の検討加速をお願いいたします。私からは以上になります。"}}},"rest_id":"2113205419766431845","unmention_data":{},"views":{"count":"54251","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113205419766431845","sortIndex":"2113493180203663300"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2112845618712609268"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"p