m":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3061719,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1891},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2113417599396823238"],"editable_until_msecs":"1792716595000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":88,"bookmarked":false,"conversation_id_str":"2113417599396823238","created_at":"Thu Oct 22 23:49:55 +0000 2026","display_text_range":[0,66],"entities":{},"favorite_count":9616,"favorited":false,"full_text":"大型で非常に強い「台風第30号」が、本日（23日（金））から明日（24日（土））にかけて沖縄地方の先島諸島付近に接近する見込みです。","id_str":"2113417599396823238","is_quote_status":false,"lang":"ja","quote_count":82,"reply_count":581,"retweet_count":1289,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"disaportal.gsi.go.jp/maps/?ll=35.35","expanded_url":"http://disaportal.gsi.go.jp/maps/?ll=35.35","indices":[418,441],"url":"https://t.co/3azGQi3gtU"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM0MTc1OTkyMzMyMjQ3MDQ=","richtext":{"richtext_tags":[]},"text":"大型で非常に強い「台風第30号」が、本日（23日（金））から明日（24日（土））にかけて沖縄地方の先島諸島付近に接近する見込みです。\n\n台風が接近する沖縄・奄美地方では、明日（24日（土））にかけて暴風や高波、土砂災害、高潮に厳重に警戒するほか、低い土地の浸水、河川の増水や氾濫にも警戒が必要です。\n\nまた、西日本や東日本では前線の影響で台風が接近する前から大雨となり、台風の接近によりさらに雨量が多くなるおそれがあります。\n予想は大きく変わる可能性があるようですが、これらの地域では、本日（23日（金））から26日（月）にかけて、大雨や土砂災害に注意・警戒が必要です。\n\n官邸では、「台風第30号」や前線による大雨などに備え、官邸危機管理センターに「情報連絡室」を設置して、情報収集に当たっており、必要に応じて体制を強化し、危機管理に万全の対応をしてまいります。\n\n国民の皆様におかれましては、地元自治体が作成しているハザードマップ\nhttps://t.co/3azGQi3gtU\nなどにより、\n・お住まいのご自宅や地域、滞在先が安全な場所かどうか、\n・避難する場所や経路、\n・避難情報の把握手段など、\n避難に備えて自らの避難行動を確認し、備蓄品の確認、避難の際に持参する荷物をまとめるなども含め、事前の備えを進めて下さい。\n\nまた、ラジオ・テレビ・インターネットなどで、最新の防災気象情報や自治体からの避難情報に十分注意し、夜暗くなる前や、少しでも危険を感じれば、躊躇せず、早め早めに自らの命を守る行動をとっていただくよう、お願いします。"}}},"rest_id":"2113417599396823238","unmention_data":{},"views":{"count":"279815","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113417599396823238","sortIndex":"2113493180203663316"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2113493180203663405-tweet-2113405046255960369","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"re