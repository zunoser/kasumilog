つ、ハードとソフトの両面から防災に取り組むことの重要性と、記憶と教訓を次世代に語り継ぐことの大切さについて述べました。\n\nhttps://t.co/JgPYittYEB"}}},"rest_id":"2113178381504147483","unmention_data":{},"views":{"count":"9450","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113178381504147483","sortIndex":"2113493180203663285"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府の公式アカウントです。内閣府大臣官房政策評価広報課が運営しています。運営方針 https://t.co/LtXxYQ4rJW を御確認のうえ御利用ください。問い合わせは https://t.co/ANlK6wet0H","entities":{"description":{"urls":[{"display_url":"cao.go.jp/others/seihyou…","expanded_url":"https://www.cao.go.jp/others/seihyou/sns/x.html","indices":[42,65],"url":"https://t.co/LtXxYQ4rJW"},{"display_url":"cao.go.jp/goiken.html","expanded_url":"https://www.cao.go.jp/goiken.html","indices":[88,111],"url":"https://t.co/ANlK6wet0H"}]},"url":{"urls":[{"display_url":"