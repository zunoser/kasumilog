to","url":"https://t.co/WohSE1dLvg"}]},"favorite_count":11,"favorited":false,"full_text":"╋━━━━━━━\n\n　YouTube　『#放課後ゲンバミッション！』\n\n　　　　　　　　　　　　　　━━━━━━╋\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「 #ゲンミ！（現場ミッション）」に挑戦✨\n\n今回は https://t.co/WohSE1dLvg","id_str":"2113440199166607608","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":2,"retweet_count":2,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[20,32],"text":"放課後ゲンバミッション"},{"indices":[100,104],"text":"ゲンミ"},{"indices":[377,381],"text":"ゲンミ"},{"indices":[383,393],"text":"国交省建設産業PR"},{"indices":[394,405],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/ewarQDAynJc","expanded_url":"https://youtu.be/ewarQDAynJc","indices":[252,275],"url":"https://t.co/z4KdMgjVkN"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[352,375],"url":"https://t.co/kPJLLRPIOH"}],"user_mentions":[{"id_str":"2100746664126648320","indices":[406,421],"name":"放課後ゲンバミッション","screen_name":"houkago_gennmi"}]},"id":"Tm90ZVR3ZWV0OjIxMTM0NDAxOTkwMDcxNTgyNzI=","richtext":{"richtext_tags":[]},"text":"╋━━━━━━━\n\n　YouTube　『#放課後ゲンバミッション！』\n\n　　　　　　　　　　　　　　━━━━━━╋\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「 #ゲンミ！（現場ミッション）」に挑戦✨\n\n今回は 建物に水の侵入などを防ぐ「シーリング防水工事」で活躍する職人さんをリポート！\nシーリングガンという工具で空気が入らないよう隙間にシーリング材を入れる作業に挑戦！\n\n職人さんが「すごく誇らしい」と語るその理由──\n知ると、建設現場の見え方が変わるかも👀\n📺https://t.co/z4KdMgjVkN\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPIOH\n\n#ゲンミ！\n#国交省建設産業PR\n#MLIT建設産業PR\n@houkago_gennmi"}}},"rest_id":"2113440199166607608","unmention_data":{},"views":{"count":"2827","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113440199166607608","sortIndex":"2113493180203663336"},{"content":{"__typename":"TimelineTim