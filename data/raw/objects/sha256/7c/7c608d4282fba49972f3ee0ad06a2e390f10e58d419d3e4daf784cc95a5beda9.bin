atus":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":0,"retweet_count":8,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[199,206],"text":"伝統的工芸品"},{"indices":[215,226],"text":"KOUGEIEXPO"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/10/…","expanded_url":"https://www.meti.go.jp/press/2026/10/20261022001.html","indices":[169,192],"url":"https://t.co/XNWSy5YwEV"},{"display_url":"kougei-expo.com/kanagawa/","expanded_url":"https://kougei-expo.com/kanagawa/","indices":[244,267],"url":"https://t.co/KMl4dV58zt"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTMyMTc3NDc5NDk2OTA4ODA=","richtext":{"richtext_tags":[]},"text":"／\n新たな伝統的工芸品に\n「箱根小田原からくり細工」「京竹工芸」「京七宝」を\n指定しました🎉\n＼\nこれにより、経済産業大臣が指定する伝統的工芸品は247品目となりました。\n併せて、既に指定されている「京人形」「九谷焼」「加賀友禅」「宮古上布」において、時代の変化に合わせた技術・技法における指定内容の変更を行いました。\n 詳細はこちら👇\nhttps://t.co/XNWSy5YwEV\n 👇全国の #伝統的工芸品 が一堂に会する #KOUGEIEXPO は11/7(土)～9(月)開催！\nhttps://t.co/KMl4dV58zt"}}},"rest_id":"2113217748071276625","unmention_data":{},"views":{"count":"5574","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113217748071276625","sortIndex":"2113493180203663308"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2113216776695922688/F9qyMJm5?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/21132167766959