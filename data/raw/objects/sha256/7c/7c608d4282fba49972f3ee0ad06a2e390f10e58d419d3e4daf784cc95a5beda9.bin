:[0,147],"entities":{"media":[{"display_url":"pic.x.com/Bxt1g4vncc","expanded_url":"https://x.com/gov_online/status/2113435239208907095/photo/1","ext_alt_text":"10月25日（日曜日）放送テーマは、「大人もこどもも食育を！　知っておきたいこれからの「食」」。番組パーソナリティの杉浦太陽さん、松井玲奈さんが、農林水産省のポスターを持って並んで立っている。杉浦太陽さんが持つポスターには、「食べる、生きる、楽しむ。ニッポンの食育。」「身近な食から考えてみませんか？忙しい毎日を過ごす中で、食べること、生きることを楽しむために、「大人の食育」が大切です。」などと書かれている。松井玲奈さんが持つポスターには、「大人も子供も食育を！改正食育基本法」などと書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":108,"w":108,"x":735,"y":114},{"h":120,"w":120,"x":341,"y":161},{"h":319,"w":319,"x":623,"y":471}]},"medium":{"faces":[{"h":108,"w":108,"x":735,"y":114},{"h":120,"w":120,"x":341,"y":161},{"h":319,"w":319,"x":623,"y":471}]},"orig":{"faces":[{"h":108,"w":108,"x":735,"y":114},{"h":120,"w":120,"x":341,"y":161},{"h":319,"w":319,"x":623,"y":471}]},"small":{"faces":[{"h":61,"w":61,"x":416,"y":64},{"h":68,"w":68,"x":193,"y":91},{"h":180,"w":180,"x":353,"y":266}]}},"id_str":"2112731943855083520","indices":[148,171],"media_key":"3_2112731943855083520","media_results":{"result":{"media_key":"3_2112731943855083520"}},"media_url_https":"https://pbs.twimg.com/media/HVHuglsaUAAVDpJ.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":114},{"h":1200,"w":1200,"x":0,"y":0},{"h":1200,"w":1053,"x":147,"y":0},{"h":1200,"w":600,"x":570,"y":0},{"h":1200,"w":1200,"x":0,"y":0}],"height":1200,"width":1200},"sizes":{"large":{"h":1200,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1200},"small":{"h":680,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Bxt1g4vncc"}],"urls":[{"display_url":"gov-online.go.jp/media/radio_pr…","expanded_url":"https://www.gov-online.go.jp/media/radio_programs/radio_introduction/time_sc/","indices":[124,147],"url":"https://t.co/DrcX5qhnrc"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/Bxt1g4vncc","expanded_url":"https://x.com/gov_online/status/2113435239208907095/photo/1","ext_alt_text":"1