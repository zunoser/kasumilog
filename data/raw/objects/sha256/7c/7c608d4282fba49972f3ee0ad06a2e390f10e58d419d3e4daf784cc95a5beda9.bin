？？\n＼\n\n難しそうなイメージがあるサイバーコンテスト。\n実際は、謎解き要素を含む～ゲーム感覚で挑戦できる～コンテストです！\nネットワークやプログラミングなどの問題が出題予定ですが、さらに防衛省らしさを意識した問題を鋭意制作中です。新しい分野の問題も出題するかも？！\nご期待ください！"}}},"rest_id":"2112728829605433530","unmention_data":{},"views":{"count":"41320","state":"EnabledWithCount"}}},"rest_id":"2113453605219160373","unmention_data":{},"views":{"count":"14384","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113453605219160373","sortIndex":"2113493180203663341"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1595652744500908032/vw4r2sfI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/242156036/1412822664"},"core":{"created_at":"Mon Jan 24 02:43:14 +0000 2011","name":"文部科学省　MEXT","screen_name":"mextjapan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDIxNTYwMzY=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2082314655360504287"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"文部科学省の公式アカウントです。\n教育、科学技術・学術、スポーツ、文化に関する情報を広く発信していきます。\nMinistry of Education, Culture, Sports, Science and Technology（MEXT）\n公式サイト：https://t.co/O94D1M8l91","entities":{"description":{"urls":[{"display_url":"mext.go.jp","expanded_url":"https://www.mext.go.jp/","indices":[129,152],"u