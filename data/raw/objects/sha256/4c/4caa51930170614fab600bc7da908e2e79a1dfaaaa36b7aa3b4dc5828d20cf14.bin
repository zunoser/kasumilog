unt":61,"favorited":false,"full_text":"【勤務間インターバル制度 導入促進シンポジウム】\n(オンライン開催)\n\n「休息は攻めの経営戦略」をテーマに、為末大氏と小室淑恵氏が、戦略的な休息と活躍し続ける組織の在り方についてお話しします。\n\n■11/18（水）13:30～15:30(参加無料)\n▼詳細・お申し込みはこちら\nhttps://t.co/qGQ68RIYg8 https://t.co/keZfoK489H","id_str":"2118176899570778393","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":15,"retweet_count":17,"retweeted":false,"user_id_str":"180585090"},"rest_id":"2118176899570778393","unmention_data":{},"views":{"count":"17527","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118176899570778393","sortIndex":"2118598293196898138"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":1},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/3692310981/5e84849fe6a5c60bc3a3818c6f4cbec4_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/286056244/1791195170"},"core":{"created_at":"Fri Apr 22 08:05:55 +0000 2011","name":"環境省","screen_name":"Kankyo_Jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODYwNTYyNDQ=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2117849199001911362"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"環境省の公式アカウントです。皆さまにお知らせしたい情報を発信していきます。なお、Xによせられたコメントへの返信はしておりません