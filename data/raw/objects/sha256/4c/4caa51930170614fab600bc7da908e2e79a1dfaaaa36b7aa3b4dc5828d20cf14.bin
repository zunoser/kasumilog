://video.twimg.com/amplify_video/2118299755852001280/vid/avc1/640x360/-p9ON_Q2SN3RmoGu.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2118299755852001280/vid/avc1/1280x720/_59FKor_4lbuyO59.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/dNFJIeny3J","expanded_url":"https://x.com/kantei/status/2118300888141885451/video/1","ext_media_availability":{"status":"Available"},"id_str":"2118299755852001280","indices":[125,148],"media_key":"13_2118299755852001280","media_results":{"result":{"media_key":"13_2118299755852001280"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2118299755852001280/img/Hj0CRzu97Yot8Qro.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/dNFJIeny3J","video_info":{"aspect_ratio":[16,9],"duration_millis":183266,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2118299755852001280/pl/yX9hs4L-gRC4sbKk.m3u8?tag=29&v=368"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2118299755852001280/vid/avc1/480x270/p0-hrpoGq6SWv-FN.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2118299755852001280/vid/avc1/640x360/-p9ON_Q2SN3RmoGu.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2118299755852001280/vid/avc1/1280x720/_59FKor_4lbuyO59.mp4?tag=29"}]}}]},"favorite_count":3234,"favorited":false,"full_text":"【お知らせ】\n本日（１１月５日）、高市総理は、日仏首脳電話会談等についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（記者）\n　総理は先ほどフランスのマクロン大統領と電話会談をされました。どのような話題が出たかお伺いします。\n\n（高市総理） https://t.co/dNFJIeny3J","id_str":"2118300888141885451","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":50,"reply_count":248,"retweet_count":453,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTgzMDA4ODgwNDEyNDY3MjA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月５日）、高市総理は、日仏首脳電話会談等についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（記者）\n　総理は先ほどフランスのマクロン大統領と電話会談をされました。どのような話題が出たかお伺いします。\n\n（高市総理）\n　先ほど、１７時３５分から約３０分間、フランスのマクロン大統領との間で電話会談を行いました。\n　日本とフランスの間で、安全保障、ＡＩ、宇宙、経済安全保障といった分野において、具体的な協力が進展しています。\n　そういった話をした上で、特別なパートナーであるフランスと、一層連携をしていきたいと考えております。\n　その上で、私から、特に申し上げたことなのですが、ＥＵの「産業加速化法案」に関する我が国の強い懸念を伝達しました。そしてフランス側の適切な対応を求めました。この懸案の解決に向けては緊密に連携を続けてまいります。\n　また、中東情勢につきましても議論をしました。基本的に事態の早期沈静化・安定化が重要であり、中東地域全体の安定のために連携していくということで、一致をしました。\n　さらに、エネルギー安全保障についても意見交換をしました。\n　世界のエネルギー安全保障及び市場の安定のため、フランスとも緊密に意思疎通をしてまいります。\n　とにかく国際秩序は大きく揺らぐ中ですから、マクロン大統領と一層連携していくという考えでございます。以上です。\n\n（記者）\n　１０月２日の夜に総理がG7オンライン首脳会議を欠席した件について、議長国であるマクロン大統領とは、フランスのマクロン大統領とはやり取りがありましたでしょうか？\n\n（高市総理）\n　そのようなやり取りは一切ございませんでした。\n\n（記者）\n　先方からもお話はありませんでしたでしょうか。\n\n（高市総理）\n　全くなかったです。\n\n（記者）\n　アメリカの中間選挙で民主党が上院・下院の両院を制しておりますが、受け止めをお願いいたします。\n\n（高市総理）\n　はい。アメリカの中間選挙で上院・下院とも民主党が過半数という結果でございますけれども、これは他国の内政にかかることでございますので、日本政府として特にコメントをすることはございません。いずれにしましても日米同盟というのは非常に大切な外交安全保障の基軸でございますので、これからもしっかり日米関係を強化すべくトランプ大統領とも協力をしていきたいと考えております。"}}},"rest_id":"2118300888141885451","unmention_data":{},"views":{"count":"119062","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118300888141885451","sortIndex":"2118598293196898200"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tw