0149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20450,"tweets":49228},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2118290614353875023"],"editable_until_msecs":"1793878413000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":10,"bookmarked":false,"conversation_id_str":"2118290614353875023","created_at":"Thu Nov 05 10:33:33 +0000 2026","display_text_range":[0,142],"entities":{},"favorite_count":197,"favorited":false,"full_text":"高市総理大臣は、エマニュエル・マクロン・フランス大統領と電話会談を行いました。高市総理から、EUの産業加速化法案（IAA）への我が国の強い懸念を伝達し、フランス側の適切な対応を求めました。また、両首脳は、中東地域全体の安定のため連携するとともに、世界のエネルギー安全保障及び市場の安定","id_str":"2118290614353875023","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":29,"retweet_count":43,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/erp/erp_…","expanded_url":"https://www.mofa.go.jp/mofaj/erp/erp_1/fr/pageit_000001_03297.html","indices":[169,192],"url":"https://t.co/RxhYodUlfp"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTgyOTA2MTQyNDA1NzEzOTI=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、エマニュエル・マクロン・フランス大統領と電話会談を行いました。高市総理から、EUの産業加速化法案（IAA）への我が国の強い懸念を伝達し、フランス側の適切な対応を求めました。また、両首脳は、中東地域全体の安定のため連携するとともに、世界のエネルギー安全保障及び市場の安定について緊密に意思疎通していくことで一致しました。\n\nhttps://t.co/RxhYodUlfp"}}},"rest_id":"2118290614353875023","unmention_data":{},"views":{"count":"11760","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118290614353875023","sortIndex":"2118598293196898193"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075284,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":612,"tweets":1929},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2118284060175069293"],"editable_until_msecs":"1793876850000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":419,"bookmarked":false,"conversation_id_str":"2118284060175069293","created_at":"Thu Nov 05 10:07:30 +0000 2026","display_text_range":[0,123],"entities":{},"favorite_count":20949,"favorited":false,"full_text":"先ほど、フランスのマクロン大統領との間で電話会談を行いました。\n\n日本とフランスの間では、安全保障、ＡＩ、宇宙、経済安全保障といった分野において、具体的な協力が進展しており、「特別なパートナー」であるフランスと一層連携していきたいと考えています。","id_str":"2118284060175069293","is_quote_status":false,"lang":"ja","quote_count":546,"reply_count":2623,"retweet_count":2029,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTgyODQwNjAxMjg5NTIzMjA=","richtext":{"richtext_tags":[]},"text":"先ほど、フランスのマクロン大統領との間で電話会談を行いました。\n\n日本とフランスの間では、安全保障、ＡＩ、宇宙、経済安全保障といった分野において、具体的な協力が進展しており、「特別なパートナー」であるフランスと一層連携していきたいと考えています。\n\nその上で、私から、ＥＵの『産業加速化法案』に関する我が国の強い懸念を伝達し、フランス側の適切な対応を求めました。\n懸案の解決に向けて、緊密に協議を続けていきます。\n\nまた、中東情勢に関しても議論し、「事態の早期沈静化・安定化」が重要であり、中東地域全体の安定のため連携していくことで一致しました。\n\nさらに、エネルギー安全保障についても意見交換しました。\n世界のエネルギー安全保障及び市場の安定のため、フランスとも緊密に意思疎通してまいります。\n\n国際秩序が大きく揺らぐ中、マクロン大統領と一層連携していく考えです。"}}},"rest_id":"2118284060175069293","unmention_data":{},"views":{"count":"1307035","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118284060175069293","sortIndex":"2118598293196898192"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_resul