e":11.73,"rgb":{"blue":59,"green":82,"red":37}},{"percentage":6.46,"rgb":{"blue":149,"green":178,"red":215}},{"percentage":6.28,"rgb":{"blue":248,"green":200,"red":161}},{"percentage":5.88,"rgb":{"blue":36,"green":43,"red":192}}]},"type":"IMAGE_COLOR"}},{"key":"photo_image_full_size_x_large","value":{"image_value":{"height":1132,"url":"https://pbs.twimg.com/card_img/2117874528772931584/DRNCTrGE?format=png&name=2048x2048_2_exp","width":2048},"type":"IMAGE"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/HH7sV2TOAg","type":"STRING"}},{"key":"summary_photo_image_original","value":{"image_value":{"height":1142,"url":"https://pbs.twimg.com/card_img/2117874528772931584/DRNCTrGE?format=jpg&name=orig","width":2066},"type":"IMAGE"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary_large_image","url":"https://t.co/HH7sV2TOAg","user_refs_results":[]},"rest_id":"https://t.co/HH7sV2TOAg"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":7},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1882628813462630400/gGcA0cdy_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1881236908820647936/1737689539"},"core":{"created_at":"Mon Jan 20 07:07:15 +0000 2025","name":"【公式】農林水産省「おいしい日本、届け隊」","screen_name":"todoketai_maff"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODgxMjM2OTA4ODIwNjQ3OTM2","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1912691537554862326"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"おいしい日本、届け隊 官民共創プロジェクト\n\n農林水産省主導プロジェクト「おいしい日本、届け隊」の公式アカウントです。\n日本の食材や食文化を世界へ届けるための情報発信を行います！","entities":{"description":{}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":475,"following":8},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1881236908820647936","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":13,"tweets":112},"verification":{"verified":false},"website":{"url":""}}}},"edit_control":{"edit_tweet_ids":["2117876644895768997"],"editable_until_msecs":"1793779715000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2117876644895768997","created_at":"Wed Nov 04 07:08:35 +0000 2026","display_text_range":[0,147],"entities":{},"favorite_count":10,"favorited":false,"full_text":"日本食品を、ベトナムで「売れ続ける商品」にするには？\n\n【11/25（水）19:00〜｜無料オンラインセミナー開催】\n\n人口約1億人、経済成長とともに日本食品への関心が高まるベトナム市場。\n\n一方で、\n「展示会では好評だったのに、商談につながらない」\n「現地の店頭に並んでも、なかなか売れない」","id_str":"2117876644895768997","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":3,"retweeted":false,"user_id_str":"1881236908820647936"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[582,592],"text":"おいしい日本届け隊"},{"indices":[593,598],"text":"食品輸出"},{"indices":[599,606],"text":"ベトナム市場"},{"indices":[607,612],"text":"セミナー"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"maff.export-hr.maff.go.jp/topic/vietnam_…","expanded_url":"https://maff.export-hr.maff.go.jp/topic/vietnam_onlineseminar/","indices":[517,540],"url":"https://t.co/HH7sV2TOAg"},{"display_url":"forms.cloud.microsoft/Pages/Response…","expanded_url":"https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=R5B41lCZ2kG8J2vrNmGefO0JV8Yz8z5Cq-5puvUz9DFUREJTNUtZVklVWkxVMkhaNTE3Q1NaNzc5WS4u","indices":[557,580],"url":"https://t.co/wNa6djSvzX"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTc4NzY2NDQ3ODY2MDE5ODQ=","richtext":{"richtext_tags":[]},"text":"日本食品を、ベトナムで「売れ続ける商品」にするには？\n\n【11/25（水）19:00〜｜無料オンラインセミナー開催】\n\n人口約1億人、経済成長とともに日本食品への関心が高まるベトナム市場。\n\n一方で、\n「展示会では好評だったのに、商談につながらない」\n「現地の店頭に並んでも、なかなか売れない」\n「販路開拓やパートナー選びの進め方がわからない」\n\nそんな課題を抱えていませんか？\n\n今回のセミナーでは、ベトナムで約30年にわたり食品製造・流通・小売・外食事業を展開してきたロータスグループが、現地市場のリアルと販路開拓のポイントを解説！\n\n📌 セミナーで学べること\n✓ ベトナム食品市場の最新動向\n✓ 現地消費者の購買行動とトレンド\n✓ 現地で「売れる仕組み」のつくり方\n✓ パートナー選びと継続的な販路開拓\n✓ 日本ブランドの成功事例\n\n🎤 登壇：Le Van May 氏（LOTUS FOOD GROUP CEO & PRESIDENT）\n\n📅 11月25日（水）19:00〜20:00\n💻 オンライン｜参加無料\n\nこれから輸出を始めたい方も、すでにベトナム市場に挑戦している方も、ぜひご参加ください！\n\n▼セミナー詳細はこちら\nhttps://t.co/HH7sV2TOAg\n\n▼お申し込みはこちら（無料）\nhttps://t.co/wNa6djSvzX\n\n#おいしい日本届け隊 #食品輸出 #ベトナム市場 #セミナー"}}},"rest_id":"2117876644895768997","unmention_data":{},"views":{"count":"4120","state":"EnabledWithCount"}}},"user_id_str":"2335919749"},"rest_id":"2118246402585493755","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"853","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118246402585493755","sortIndex":"2118598293196898172"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"