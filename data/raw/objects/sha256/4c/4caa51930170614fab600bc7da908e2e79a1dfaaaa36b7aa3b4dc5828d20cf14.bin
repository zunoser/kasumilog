h":480,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GxotXBtr8L"}]},"favorite_count":1225,"favorited":false,"full_text":"令和８年１１月５日（木）午後、中国軍の偵察／攻撃型無人機（ＴＢ－００１）が大陸方面から飛来し、東シナ海上を長崎県男女群島南西沖まで飛行した後、南西進し、沖縄本島沖で旋回・変針し、大陸方面に飛行したことを確認した。 https://t.co/GxotXBtr8L","id_str":"2118324415809163607","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":15,"quoted_status_id_str":"2118322437821465061","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2118322437821465061","url":"https://t.co/hSM8QXUykp"},"reply_count":25,"retweet_count":342,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTgzMjQ0MTU3NTQ1OTYzNTI=","text":"令和８年１１月５日（木）午後、中国軍の偵察／攻撃型無人機（ＴＢ－００１）が大陸方面から飛来し、東シナ海上を長崎県男女群島南西沖まで飛行した後、南西進し、沖縄本島沖で旋回・変針し、大陸方面に飛行したことを確認した。\nこれに対し、航空自衛隊の南西航空方面隊等の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3294},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":362039,"following":32},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6428,"tweets":12476},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2118322437821465061"],"editable_until_msecs":"1793886000000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":34,"bookmarked":false,"conversation_id_str":"2118322437821465061","created_at":"Thu Nov 05 12:40:00 +0000 2026","display_text_range":[0,106],"entities":{"media":[{"display_url":"pic.x.com/0Xw0Qir5gJ","expanded_url":"https://x.com/jointstaffpa/status/2118322437821465061/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2118320578893651968","indices":[107,130],"media_key":"3_2118320578893651968","media_results":{"result":{"media_key":"3_2118320578893651968"}},"media_url_https":"https://pbs.twimg.com/media/HWXJV9lbIAAQt8i.jpg","original_info":{"focus_rects":[{"h":595,"w":1062,"x":0,"y":243},{"h":838,"w":838