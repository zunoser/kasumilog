:{"entity_set":{"hashtags":[{"indices":[209,221],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTgzNDk5ODY0Njc2MTQ3MjA=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、クウェート国のルーミー（H.E. Tareq Al-Roumi）石油大臣とオンラインにて会談。赤澤大臣から、産油国共同備蓄の活用を含め、クウェートから日本への原油供給が続いていることに謝意を伝達。また、両大臣は、AZEC閣僚会合で合意したアジアの石油備蓄に関するワークプログラムについて、「パワー・アジア」（POWERR Asia）の下で、エネルギーの安定供給の実現のために連携していくことを確認しました。#meti_daijin"}}},"rest_id":"2118349986522087762","unmention_data":{},"views":{"count":"8292","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118349986522087762","sortIndex":"2118598293196898207"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instag