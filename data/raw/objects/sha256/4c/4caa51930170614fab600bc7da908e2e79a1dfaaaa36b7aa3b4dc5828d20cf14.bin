]},"id":"Tm90ZVR3ZWV0OjIxMTgzMDUyMzY0Mjc0MzYwMzM=","richtext":{"richtext_tags":[]},"text":"髙木副大臣は、11/1～4にアラブ首長国連邦に出張。アブダビ国際石油展示会議（ADIPEC）開会式に出席するとともに、経済産業省が「エネルギー安全保障強化のためのソリューション」をテーマに出展した日本パビリオン等を視察。また、UAEのジャーベル（H.E. Dr. Sultan Ahmed Al-Jaber） アブダビ国営石油会社（ADNOC）Group CEO兼産業・先端技術大臣兼日本特使、マズルーイ（H.E. Suhail Mohamed Al-Mazrouei） エネルギー・インフラ大臣等と会談し、今後の更なる協力深化について意見交換しました。"}}},"rest_id":"2118305236502901158","unmention_data":{},"views":{"count":"6903","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118305236502901158","sortIndex":"2118598293196898204"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"disp