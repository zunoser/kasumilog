"possibly_sensitive_editable":true,"quote_count":12,"reply_count":31,"retweet_count":216,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"mod.go.jp/j/approach/exc…","expanded_url":"https://www.mod.go.jp/j/approach/exchange/area/2026/20261105_ukr-j.html","indices":[169,192],"url":"https://t.co/Dqz4e1hwNg"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTgzMDM1NTI3MTYzODYzMDU=","text":"11月5日、小泉防衛大臣は、ウクライナのフマラ国防大臣とテレビ会談を行い、日本はウクライナと共にあるという姿勢に変わりはないことを伝えました。また、防衛省・自衛隊として、引き続き国際社会と緊密に連携していくことを伝えました。\nフマラ大臣からは、防衛省・自衛隊による継続的な支援について、改めて深い謝意が述べられました🇯🇵🤝🇺🇦\n結果概要：https://t.co/Dqz4e1hwNg"}}},"rest_id":"2118303552833757622","unmention_data":{},"views":{"count":"41072","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118303552833757622","sortIndex":"2118598293196898203"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/MTDLwUeFIG"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_ta