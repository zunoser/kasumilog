、新時代のエネルギー安全保障と共通の目標を全体テーマに、エネルギー安全保障や持続可能なエネルギー・ソリューションへの投資と貿易等について議論が行われました。\n\nhttps://t.co/pmhz1mmiaO"}}},"rest_id":"2109951454719197625","unmention_data":{},"views":{"count":"6720","state":"EnabledWithCount"}}}}},"entryId":"tweet-2109951454719197625","sortIndex":"2110037747405160435"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/p5uA86gN9qE","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":627,"url":"https://pbs.twimg.com/card_img/2109948037703589888/uD_B1KG0?format=jpg&name=1200x627","width":1200},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":210,"url":"https://pbs.twimg.com/card_img/2109948037703589888/uD_B1KG0?format=jpg&name=280x280","width":280},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.6656","type":"STRING"}},{"key":"description","value":{"string_value":"Enjoy the videos and music you love, upload original content, and share it all with friends, family, and the world on YouTube.","type":"STRING"}},{"key":"player_width","value":{"string_value":"1280","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"10228272","path":[]}}},{"key":"player_image_original","value":{"image_value":{"height":360,"url":"https://pbs.twimg.com/card_img/2109948037703589888/uD_B1KG0?format=jpg&name=orig","width":480},"type":"IMAGE"}},{"key":"app_num_ratings","value":{"st