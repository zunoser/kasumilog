ラブル】https://t.co/hQzXO9UHNM\n\n#台風 #自然災害 #鹿児島 #相談窓口 #損害保険 #火災保険 #自動車保険 #傷害保険 #消費者トラブル #災害便乗商法 #損保協会"}}},"rest_id":"2105200411825312104","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1715","state":"EnabledWithCount"}}},"user_id_str":"276848601"},"rest_id":"2105491598926880855","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"541","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105491598926880855","sortIndex":"2105536971681038313"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1674231387166220288/iK7GwtIr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/180585090/1680484704"},"core":{"created_at":"Fri Aug 20 00:19:17 +0000 2010","name":"厚生労働省","screen_name":"MHLWitter"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODA1ODUwOTA=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"厚生労働省の公式アカウントです。\n健康・医療、福祉・介護、雇用・労働、年金など、皆さまの暮らしを支える情報をお届けします。\n\n※このXに寄せられたコメントへの返信はしておりません。\n\n【運用方針】\nhttps://t.co/dQtOdVs4pp","entities":{"description":{"urls":[{"di