edia":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/PzrsaZN45P","expanded_url":"https://x.com/takaichi_sanae/status/2105251429602709755/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":73,"w":73,"x":1579,"y":75}]},"medium":{"faces":[{"h":42,"w":42,"x":925,"y":44}]},"orig":{"faces":[{"h":93,"w":93,"x":2005,"y":96}]},"small":{"faces":[{"h":24,"w":24,"x":524,"y":25}]}},"id_str":"2105251351504777216","indices":[49,72],"media_key":"3_2105251351504777216","media_results":{"result":{"media_key":"3_2105251351504777216"}},"media_url_https":"https://pbs.twimg.com/media/HTda8zlacAA7P8d.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":278},{"h":1734,"w":1734,"x":238,"y":0},{"h":1734,"w":1521,"x":345,"y":0},{"h":1734,"w":867,"x":672,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/PzrsaZN45P"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/PzrsaZN45P","expanded_url":"https://x.com/takaichi_sanae/status/2105251429602709755/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":143,"w":143,"x":221,"y":251},{"h":165,"w":165,"x":1263,"y":573},{"h":207,"w":207,"x":225,"y":417}]},"medium":{"faces":[{"h":84,"w":84,"x":129,"y":147},{"h":96,"w":96,"x":740,"y":336},{"h":121,"w":121,"x":132,"y":244}]},"orig":{"faces":[{"h":182,"w":182,"x":281,"y":319},{"h":210,"w":210,"x":1604,"y":728},{"h":264,"w":264,"x":286,"y":530}]},"small":{"faces":[{"h":47,"w":47,"x":73,"y":83},{"h":54,"w":54,"x":419,"y":190},{"h":69,"w":69,"x":74,"y":138}]}},"id_str":"2105251351668334592","indices":[49,72],"media_key":"3_2105251351668334592","media_results":{"result":{"media_key":"3_2105251351668334592"}},"media_url_https":"https://pbs.twimg.com/media/HTda80MaIAAbuVb.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":995,"y":0},{"h":1734,"w":867,"x":1322,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/PzrsaZN45P"}]},"favorite_count":5751,"favorited":false,"full_text":"本日、第7回「地域未来戦略関係副大臣等会議」に出席し、『地域未来戦略』に関する報告を受けました。 https://t.co/PzrsaZN45P","id_str":"2105251429602709755","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":51,"reply_count":595,"retweet_count":673,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"cas.go.jp/jp/seisaku/chi…","expanded_url":"https://www.cas.go.jp/jp/seisaku/chiikimirai/kankei_fukudaijin/dai7/shiryo2-1.pdf","indices":[259,282],"url":"https://t.co/1yUFjPqzlk"},{"display_url":"cas.go.jp/jp/seisaku/chi…","expanded_url":"https://www.cas.go.jp/jp/seisaku/chiikimirai/kankei_fukudaijin/dai7/shiryo2-2.pdf","indices":[283,306],"url":"https://t.co/93rO7IqA3I"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDUyNTE0Mjk0NjQzNjMwMDg=","richtext":{"richtext_tags":[]},"text":"本日、第7回「地域未来戦略関係副大臣等会議」に出席し、『地域未来戦略』に関する報告を受けました。\n\n会議では、9人の知事や町長の皆様より、宇宙産業クラスターから食・観光クラスターまで、各地域の特色を活かした大変意欲的な『地域産業クラスター計画』や『地場産業成長プラン』をご説明いただきました。\n誠にありがとうございました。\n\n※今回ご説明いただいた、茨城県、神奈川県、岩手県、栃木県、奈良県、島根県、愛媛県、北海道芽室町、鳥取県智頭町の計画や、これまでの会議で報告済みの自治体の2件目以降の計画等の概要はこちらです。\nhttps://t.co/1yUFjPqzlk\nhttps://t.co/93rO7IqA3I\n\n『地域未来戦略』をきっかけに、地域ならではの技術や観光資源を中核として、これまでは独自に取組を進めてこられた事業者や人材が繋がり、新たな「産業クラスター」を形成するという、自治体の皆様の非常に強い決意が感じられ、とても頼もしく思っています。\n\nこうした「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」をしっかりと受け止めて、高市内閣は全力で応援してまいります。\n\n今も、日本全国の自治体で、計画策定が進められていると承知しています。\n今後、更なるお話を伺えることを、楽しみにしています。"}}},"rest_id":"2105251429602709755","unmention_data":{},"views":{"count":"222119","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105251429602709755","sortIndex":"2105536971681038267"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3007535,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed