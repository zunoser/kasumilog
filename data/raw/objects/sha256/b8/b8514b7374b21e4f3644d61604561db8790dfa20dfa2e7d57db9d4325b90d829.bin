日より全ての企業でカスハラ・セクハラ対策が義務化・拡充。セクハラ対策の対象に求職者等が追加されます。」と記載されている。下部に「これらもハラスメントです」と記載され、その周りにイラストと合わせて「不当な要求」「電話やSNSでの暴言」「求職者等への性的な発言」と記載されている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2105096602176364544","indices":[146,169],"media_key":"3_2105096602176364544","media_results":{"result":{"media_key":"3_2105096602176364544"}},"media_url_https":"https://pbs.twimg.com/media/HTbONNaaoAA-NdO.jpg","original_info":{"focus_rects":[{"h":348,"w":621,"x":0,"y":0},{"h":621,"w":621,"x":0,"y":0},{"h":708,"w":621,"x":0,"y":0},{"h":781,"w":391,"x":230,"y":0},{"h":781,"w":621,"x":0,"y":0}],"height":781,"width":621},"sizes":{"large":{"h":781,"resize":"fit","w":621},"medium":{"h":781,"resize":"fit","w":621},"small":{"h":680,"resize":"fit","w":541},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xnXDjOer4n"}],"urls":[{"display_url":"no-harassment.mhlw.go.jp","expanded_url":"https://www.no-harassment.mhlw.go.jp/","indices":[82,105],"url":"https://t.co/bAUsOi03h0"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/xnXDjOer4n","expanded_url":"https://x.com/gov_online/status/2105432502298955876/photo/1","ext_alt_text":"政府広報、厚生労働省の新聞突出し広告。上部に「10月1日より全ての企業でカスハラ・セクハラ対策が義務化・拡充。セクハラ対策の対象に求職者等が追加されます。」と記載されている。下部に「これらもハラスメントです」と記載され、その周りにイラストと合わせて「不当な要求」「電話やSNSでの暴言」「求職者等への性的な発言」と記載されている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2105096602176364544","indices":[146,169],"media_key":"3_2105096602176364544","media_results":{"result":{"media_key":"3_2105096602176364544"}},"media_url_https":"https://pbs.twimg.com/media/HTbONNaaoAA-NdO.jpg","original_info":{"focus_rects":[{"h":348,"w":621,"x":0,"y":0},{"h":621,"w":621,"x":0,"y":0},{"h":708,"w":621,"x":0,"y":0},{"h":781,"w":391,"x":230,"y":0},{"h":781,"w":621,"x":0,"y":0}],"height":781,"width":621},"sizes":{"large":{"h":781,"resize":"fit","w":621},"medium":{"h":781,"resize":"fit","w":621},"small":{"h":680,"resize":"fit","w":541},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xnXDjOer4n"}]},"favorite_count":282,"favorited":false,"full_text":"10月1日から、全ての企業で、カスハラ及び求職者等に対するセクハラ対策が義務化されます。\n\nハラスメントについて詳しくは、厚生労働省ウェブサイトをご確認ください👇\nhttps://t.co/bAUsOi03h0\n\n※10月1日から4日にかけて、新聞各紙にモノクロの広告を順次掲載しています。 https://t.co/xnXDjOer4n","id_str":"2105432502298955876","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":27,"reply_count":10,"retweet_count":206,"retweeted":false,"user_id_str":"461064204"},"rest_id":"2105432502298955876","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"41613","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105432502298955876","sortIndex":"2105536971681038271"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"not