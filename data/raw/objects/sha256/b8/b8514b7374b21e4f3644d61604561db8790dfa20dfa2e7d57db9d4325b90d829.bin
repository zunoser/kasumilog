,"w":175,"x":649,"y":1267}]},"medium":{"faces":[{"h":102,"w":102,"x":380,"y":742}]},"orig":{"faces":[{"h":200,"w":200,"x":742,"y":1447}]},"small":{"faces":[{"h":58,"w":58,"x":215,"y":421}]}},"id_str":"2097473528593547265","indices":[167,190],"media_key":"3_2097473528593547265","media_results":{"result":{"media_key":"3_2097473528593547265"}},"media_url_https":"https://pbs.twimg.com/media/HRu5D7WagAETS9V.jpg","original_info":{"focus_rects":[{"h":926,"w":1653,"x":0,"y":881},{"h":1653,"w":1653,"x":0,"y":518},{"h":1884,"w":1653,"x":0,"y":402},{"h":2338,"w":1169,"x":0,"y":0},{"h":2338,"w":1653,"x":0,"y":0}],"height":2338,"width":1653},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/S4KpkCdFRL"},{"display_url":"pic.x.com/S4KpkCdFRL","expanded_url":"https://x.com/IMMI_OSAKA/status/2097473560889774358/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097473528337682432","indices":[167,190],"media_key":"3_2097473528337682432","media_results":{"result":{"media_key":"3_2097473528337682432"}},"media_url_https":"https://pbs.twimg.com/media/HRu5D6ZaUAAjhZX.jpg","original_info":{"focus_rects":[{"h":926,"w":1653,"x":0,"y":0},{"h":1653,"w":1653,"x":0,"y":0},{"h":1884,"w":1653,"x":0,"y":0},{"h":2338,"w":1169,"x":58,"y":0},{"h":2338,"w":1653,"x":0,"y":0}],"height":2338,"width":1653},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/S4KpkCdFRL"}]},"favorite_count":12,"favorited":false,"full_text":"【１０月１６日、京都府で相談会があります】\n外国人や企業の方も相談することができます。\n在留資格、日本での就職、法律、日本語学習、外国人雇用などいろいろな相談ができます。\nオンラインでも相談ができます。\n外国人の方の予約\nhttps://t.co/qQlRQVhErB\n企業の方の予約\nhttps://t.co/9lj24DkiVu https://t.co/S4KpkCdFRL","id_str":"2097473560889774358","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":6,"retweeted":false,"user_id_str":"709696841311367168"},"rest_id":"2097473560889774358","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2907","state":"EnabledWithCount"}}},"user_id_str":"3720424033"},"rest_id":"2105242462461854119","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"209","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105242462461854119","sortIndex":"2105536971681038264"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3007535,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":561,"tweets":1830},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2105240075277877469"],"editable_until_msecs":"1790766922000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":718,"bookmarked":false,"conversation_id_str":"2105240075277877469","created_at":"Wed Sep 30 10:15:22 +0000 2026","display_text_range":[0,142],"entities":{},"favorite_count":21110,"favorited":false,"full_text":"近年、サイバー攻撃は急速に巧妙化・高度化しており、国家を背景とする攻撃グループによる活動も活発化しています。\n\nこうした情勢の中、明日（10/1）、昨年の通常国会で成立した『サイバー対処能力強化法』及び『サイバー対処能力強化法整備法』の一部が施行されますので、その内容をご紹介します。","id_str":"2105240075277877469","is_quote_status":false,"lang":"ja","quote_count":336,"reply_count":721,"retweet_count":3277,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDUyNDAwNzUyMDIzNjc0ODg=","richtext":{"richtext_tags":[]},"text":"近年、サイバー攻撃は急速に巧妙化・高度化しており、国家を背景とする攻撃グループによる活動も活発化しています。\n\nこうした情勢の中、明日（10/1）、昨年の通常国会で成立した『サイバー対処能力強化法』及び『サイバー対処能力強化法整備法』の一部が施行されますので、その内容をご紹介します。\n\n＜「官民連携の強化」について＞\n\n『サイバー対処能力強化法』により、「官民連携の強化」の新たな枠組みとして、「サイバー協議会」が新たに設置されるほか、「資産届出」、「インシデント報告」の義務付けが新たに導入されます。\n\n「サイバー協議会」は、関係省庁、自治体、電力・ガスなどの基幹インフラ事業者などが参画する協議体です。\n協議会を通じ、国が入手した脅威情報などを含め、積極的な情報共有が可能となり、サイバー攻撃による被害の防止・軽減に官民共同で取り組むことが可能となります。\n\n「資産届出」は、基幹インフラ事業者の皆様から、導入しているVPN装置や重要なデータを保存するサーバなどについて、「資産情報」として国に届け出ていただく制度です。\n国が入手した脆弱性情報と突合することにより、脆弱性があるサーバなどを特定し、導入している事業者にピンポイントで注意喚起を行うことが可能となります。\n\n「インシデント報告」は、重要なデータを保存するサーバなどについて、不正アクセスなどの「サイバーインシデント」が発生した場合などに、基幹インフラ事業者の皆様などから、国に報告をしていただく制度です。\n国が情報の整理・分析を行い、必要な情報をタイムリーに横展開することで、他の事業者への被害拡大を抑えることが可能となるほか、脅威の未然の把握にもつなげることが期待されます。\n\n＜「アクセス・無害化措置」について＞\n\n「アクセス・無害化措置」は、国、基幹インフラなどに対する重大なサイバー攻撃の未然防止や被害拡大の防止を行うため、攻撃サーバなどに対して、警察、自衛隊が、ネットワークを介してアクセスした後、\n・不正プログラムの消去、\n・攻撃者が当該サーバにアクセスできないような設定変更\nなどの措置を実施するもので、『サイバー対処能力強化法整備法』で新たに導入された対処手法です。\n\n「注意喚起」や「パブリック・アトリビューション」など、サイバー攻撃に対処するためのこれまでのオプションに、「アクセス・無害化措置」が新たに加わることで、我が国を標的とするサイバー攻撃に実効的に対処することが可能となります。\n\n厳しさを増すサイバー脅威に対し、官だけ、民だけ、そして一国だけで対応することは困難です。\n国際的に共通する課題として、相互信頼関係にある同志国・同盟国とも、従来にも増して、緊密に連携していく必要があります。\n\nサイバー空間をめぐる脅威は常に変化し続けています。\n国民の皆様の暮らしや安全、経済活動、そして我が国の国益を守るため、サイバー攻撃などの脅威に対する対処能力の向上や施策の改善に不断に取り組んでまいります。"}}},"rest_id":"2105240075277877469","unmention_data":{},"views":{"count":"868345","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105240075277877469","sortIndex":"2105536971681038263"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":395124,"following":90},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"266566401","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":5409,"tweets":23225},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/3tgZ0wGHvI"}}}},"edit_control":{"edit_tweet_ids":["2105237636491481105"],"editable_until_msecs":"1790766340620","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_wit