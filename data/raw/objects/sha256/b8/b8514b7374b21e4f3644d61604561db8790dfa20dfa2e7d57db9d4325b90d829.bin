{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105225721035796480/vid/avc1/640x360/LmEoKc1KvhNGTaIk.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105225721035796480/vid/avc1/1280x720/Ws3AU88MG5fkXmSg.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/QE4WP0cwAN","expanded_url":"https://x.com/kantei/status/2105225947502850161/video/1","ext_media_availability":{"status":"Available"},"id_str":"2105225721035796480","indices":[96,119],"media_key":"13_2105225721035796480","media_results":{"result":{"media_key":"13_2105225721035796480"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2105225721035796480/img/ok_HhYKRUc0uyhhd.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/QE4WP0cwAN","video_info":{"aspect_ratio":[16,9],"duration_millis":94600,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2105225721035796480/pl/w1haejzf8N5A2sQ3.m3u8?tag=29&v=22b"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105225721035796480/vid/avc1/480x270/hhAACwrmQ6_OTrtW.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105225721035796480/vid/avc1/640x360/LmEoKc1KvhNGTaIk.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105225721035796480/vid/avc1/1280x720/Ws3AU88MG5fkXmSg.mp4?tag=29"}]}}]},"favorite_count":6604,"favorited":false,"full_text":"【お知らせ】\n本日（９月３０日）、高市総理は、第７回地域未来戦略に関する関係副大臣会議・地域未来戦略に関する総理報告に出席しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございます。 https://t.co/QE4WP0cwAN","id_str":"2105225947502850161","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":40,"reply_count":179,"retweet_count":875,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDUyMjU5NDc0Mzk4NzQwNDg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（９月３０日）、高市総理は、第７回地域未来戦略に関する関係副大臣会議・地域未来戦略に関する総理報告に出席しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございます。\n　本日は、知事の皆様、また、町長の皆様から、様々なご提案をいただきました。特に宇宙産業クラスターから農業、観光クラスターまで、各地域の特色を活かした、大変意欲的な『地域産業クラスター計画』や『地場産業成長プラン』をご説明いただき、本当にありがとうございました。\n　『地域未来戦略』をきっかけにして、地域ならではの技術や観光資源を中核として、これまでは独自に取組を進めてこられていた事業者、また人材が繋がって、新たな「産業クラスター」を形成するという、自治体の皆様の非常に強い決意が感じられて、とても頼もしく思っております。\n　こうした「地域の景色を一変させよう、地方を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」をしっかりと受け止めて、全力で応援をしてまいります。\n　今も、日本全国の自治体で、この計画策定が進められていると承知していますけれども、今後更なるお話が伺えるということを楽しみにいたします。私たちもしっかりと応援をしてまいりましょう。\n　お疲れ様でした。"}}},"previous_counts":{"bookmark_count":1,"favorite_count":13,"quote_count":0,"reply_count":0,"retweet_count":3},"rest_id":"2105225947502850161","unmention_data":{},"views":{"count":"130552","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105225947502850161","sortIndex":"2105536971681038253"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/57