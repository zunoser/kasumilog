"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/5Liv0nj3xy"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/5Liv0nj3xy","expanded_url":"https://x.com/takaichi_sanae/status/2105878830191984919/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2105878783786106880","indices":[98,121],"media_key":"3_2105878783786106880","media_results":{"result":{"media_key":"3_2105878783786106880"}},"media_url_https":"https://pbs.twimg.com/media/HTmVmK-aQAABOhm.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":0,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/5Liv0nj3xy"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/5Liv0nj3xy","expanded_url":"https://x.com/takaichi_sanae/status/2105878830191984919/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":137,"w":137,"x":1047,"y":29}]},"medium":{"faces":[{"h":80,"w":80,"x":613,"y":17}]},"orig":{"faces":[{"h":175,"w":175,"x":1330,"y":38}]},"small":{"faces":[{"h":45,"w":45,"x":347,"y":9}]}},"id_str":"2105878795622510592","indices":[98,121],"media_key":"3_2105878795622510592","media_results":{"result":{"media_key":"3_2105878795622510592"}},"media_url_https":"https://pbs.twimg.com/media/HTmVm3EbcAAH4Wy.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/5Liv0nj3xy"}]},"favorite_count":6527,"favorited":false,"full_text":"今朝、第45回復興推進会議を開催しました。\n\n「東日本大震災」及び「福島第一原子力発電所の事故」から15年6か月が経過しました。\n\n福島の本格的な復興・再生、東北の復興は、政府の最重要課題です。 https://t.co/5Liv0nj3xy","id_str":"2105878830191984919","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":48,"reply_count":318,"retweet_count":728,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU4Nzg4MzAxMTY0OTEyNjQ=","richtext":{"richtext_tags":[]},"text":"今朝、第45回復興推進会議を開催しました。\n\n「東日本大震災」及び「福島第一原子力発電所の事故」から15年6か月が経過しました。\n\n福島の本格的な復興・再生、東北の復興は、政府の最重要課題です。\n\n被災地の方々の絶え間ない御努力により復興は着実に進展していますが、一方で、地域によって状況は様々です。\n\n福島の「原子力災害被災地域」については、引き続き国が前面に立って、本格的な復興・再生に取り組んでいきます。\n\nそれぞれの地域の実情を踏まえながら、「避難者の帰還」や「生活環境の整備」、「産業・なりわいの再生」などの取組を一層進めていきます。\n\n除去土壌等の県外最終処分の実現に向けては、理解醸成を通じた「復興再生土」の利用を促進するため、全閣僚が全面的に協力するよう指示しました。\nまた、福島県外最終処分に向けた2030年以降の道筋を具体化していきます。\n\n「地震・津波被災地域」については、「ハード整備」などは概ね完了した一方で、「心のケア」など、中長期的な対応が必要な課題については、丁寧に取り組んでまいります。\n\n今年度は、「第3期復興・創生期間」の初年度として、非常に重要な時期です。\n\n昨年6月に閣議決定された『復興の基本方針』に基づき、復興に向けた様々な課題について、まずは「第3期復興・創生期間」でこれまで以上に被災地の復興に全力で、またスピーディーに取り組んでまいります。\n\n「福島の復興なくして、東北の復興なし。東北の復興なくして、日本の再生なし。」\n\nこの強い決意の下、「現場主義」に徹底したきめ細かな対応により、被災地の復興のための取組を責任貫徹の思いで進めてまいります。"}}},"rest_id":"2105878830191984919","unmention_data":{},"views":{"count":"195253","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105878830191984919","sortIndex":"2106049024569114538"},{"cont