profile_images/1853716532645535744/nByOEnD7_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1853694958383050752/1731399557"},"core":{"created_at":"Tue Nov 05 07:08:10 +0000 2024","name":"内閣府政策統括官（共生・共助担当）","screen_name":"kyoseikyojo_cao"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODUzNjk0OTU4MzgzMDUwNzUy","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府共生・共助担当の公式アカウントです。\n内閣府政策統括官（共生・共助担当）が管理・運営しております。\n運用方針（https://t.co/nSooMa6Gc5）を御確認のうえ御利用ください。","entities":{"description":{"urls":[{"display_url":"www8.cao.go.jp/souki/sns/x.ht…","expanded_url":"https://www8.cao.go.jp/souki/sns/x.html","indices":[58,81],"url":"https://t.co/nSooMa6Gc5"}]},"url":{"urls":[{"display_url":"www8.cao.go.jp/souki/index.ht…","expanded_url":"https://www8.cao.go.jp/souki/index.html","indices":[0,23],"url":"https://t.co/wBzrJ8ehrX"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1114,"following":12},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1853694958383050752","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":142,"tweets":335},"verification":{"verified":false},"website":{"url":"https://t.co/wBzrJ8ehrX"}}}},"edit_control":{"edit_tweet_ids":["2105906700977099258"],"editable_until_msecs":"1790925858000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"kyoseikyojo_cao"}}},"policy":"ByInvitation"},"conversation_id_str":"2079419560898470328","created_at":"Fri Oct 02 06:24:18 +0000 2026","display_text_range":[0,162],"entities":{"hashtags":[{"indices":[146,152],"text":"ともフェス"},{"indices":[153,157],"text":"内閣府"},{"indices":[158,162],"text":"丸の内"}],"media":[{"display_url":"pic.x.com/Hn2EW6eryX","expanded_url":"https://x.com/kyoseikyojo_cao/status/2105906700977099258/photo/1","ext_alt_text":"キャッチコピー「出会う、ふれあう、未来がかわる」を掲げた、障害の有無にかかわらず、こどもから大人まで、誰もが、一緒に楽しみ、交流できるインクルーシブイベント「ともともフェスタ2026（Tomotomo Festa 2026）」の告知ポスターです。開催日時は2026年10月9日(金)11:00〜19:00（行幸通りは17:00まで）及び10日(土)11:00〜17:00、入場無料です。会場は東京駅丸の内口 行幸通り及び丸ビル1階マルキューブを予定しており、音楽ステージ・体験型ワークショップ・展示などの楽しいコンテンツやみんなで遊べる遊具もあります。行幸通りは、東京都千代田区丸の内２丁目２番地、各線「東京駅」丸の内中央口より徒歩１分、東京メトロ千代田線「二重橋前駅」より徒歩3分です。丸ビルは東京都千代田区丸の内２丁目４番地１号、各線「東京駅」から地下で直結、徒歩４分、東京メトロ千代田線「二重橋前駅」より徒歩４分です。主催：内閣府・ともともフェスタ2026実行委員会、協力：東京法務局・全国人権擁護委員連合会・東京都人権擁護委員連合会・株式会社アイシン・味の素株式会社・錦城護謨株式会社・株式会社講談社・タカオ株式会社・株式会社乃村工藝社　未来創造研究所・株式会社毎日新聞社、後援：こども家庭庁・法務省・文部科学省・厚生労働省・国土交通省・東京都・鳥取県・千代田区。特設WEBサイト: https://www.tomotomo.go.jp/festa2026/。バリアフリー情報や出展・出演・イベント情報は特設ホームページを御覧ください。イベントへのお問い合わせは、ともともフェスタ2026運営事務局 info@tomotomo.go.jp ,03-5730-3157までお寄せください。受付時間は平日10時から17時（土日祝日、年末年始は除く）です。ポスターには、車いすユーザー・白杖ユーザーを含む多様な年齢・背景の人々のイラストが描かれています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2105906656458735616","indices":[163,186],"media_key":"3_2105906656458735616","media_results":{"result":{"media_key":"3_2105906656458735616"}},"media_url_https":"https://pbs.twimg.com/media/HTmu8kxagAAZ_v9.jpg","original_info":{"focus_rects":[{"h":496,"w":885,"x":0,"y":0},{"h":885,"w":885,"x":0,"y":0},{"h":1009,"w":885,"x":0,"y":0},{"h":1250,"w":625,"x":260,"y":0},{