6,9],"duration_millis":103400,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2114661005972418560/pl/tvXPgfp-Pubfm7dl.m3u8?tag=29&v=481"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114661005972418560/vid/avc1/480x270/7C79W7Th14nX5TAO.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114661005972418560/vid/avc1/640x360/jxDU6gxqtwlY5ez5.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114661005972418560/vid/avc1/1280x720/7rxJ0oQq6pGicBFL.mp4?tag=29"}]}}]},"favorite_count":1420,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２６日）、高市総理は、福田元内閣総理大臣の逝去についてのぶらさがり会見を行いました。\n \n※要旨（速報版）\n（記者） https://t.co/3MhyITDfjf","id_str":"2114661503043543509","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":22,"reply_count":86,"retweet_count":196,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ2NjE1MDI5ODQ4OTY1MTI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２６日）、高市総理は、福田元内閣総理大臣の逝去についてのぶらさがり会見を行いました。\n \n※要旨（速報版）\n（記者）\n　第９１代内閣総理大臣を務めた福田康夫氏がお亡くなりになられました。ご功績も踏まえて、ご逝去をどのように受け止めていらっしゃるか教えてください。\n\n（高市総理）\n　今程、ご遺族のもとにお伺いをし、福田康夫元総理にお別れをしてまいりました。 \n　悲しみの念を禁じ得ません。 \n　福田康夫元総理は、内閣総理大臣として国政を担われました。\n　そしてまた、長らく内閣官房長官としても活躍をされまして、その豊かな経験と、また卓越した識見のもと、本当に困難な課題に直面しながらも、１つ１つ力を尽くして取組みを続けてこられました。\n　内閣総理大臣としては、特に、消費者行政に力を入れられ、国民の皆様の安心を作るために頑張ってくださいました。 \n　また、北海道洞爺湖サミットの議長として国際社会の諸課題に取り組むとともに、我が国の存在感を大きく世界に発信をしてくださいました。 \n　その偉大なご功績を偲びつつ、改めまして、謹んで哀悼の誠を捧げさせていただきます。"}}},"rest_id":"2114661503043543509","unmention_data":{},"views":{"count":"63636","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114661503043543509","sortIndex":"2114706329535774716"},