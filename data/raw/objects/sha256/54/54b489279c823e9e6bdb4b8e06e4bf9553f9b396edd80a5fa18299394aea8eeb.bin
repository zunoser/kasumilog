オ「杉浦太陽・松井玲奈　日曜まなびより」では、食べ物を安定して手に入れるためには、生産や流通などのコストが価格に適切に反映される「合理的な価格形成」の重要性などについてご紹介します。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.gov-online.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":540,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=jpg&name=orig","width":960},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"461064204","path":[]}}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"summary_photo_image_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":81,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=jpg&name=144x144","width":144},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":540,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=png&name=2048x2048_2_exp","width":960},"type":"IMAGE"}},{"key":"photo_image_full_size_original","value":{"image_value":{"height":540,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=jpg&name=orig","width":960},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"gov-online.go.jp","type":"STRING"}},{"key":"photo_image_full_size","value