":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OhF61aLCOi"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/OhF61aLCOi","expanded_url":"https://x.com/takaichi_sanae/status/2114668906699010482/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2114668833445482496","indices":[93,116],"media_key":"3_2114668833445482496","media_results":{"result":{"media_key":"3_2114668833445482496"}},"media_url_https":"https://pbs.twimg.com/media/HVjQGZsbkAAfLUR.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1612,"w":1612,"x":429,"y":0},{"h":1612,"w":1414,"x":528,"y":0},{"h":1612,"w":806,"x":832,"y":0},{"h":1612,"w":2600,"x":0,"y":0}],"height":1612,"width":2600},"sizes":{"large":{"h":1270,"resize":"fit","w":2048},"medium":{"h":744,"resize":"fit","w":1200},"small":{"h":422,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OhF61aLCOi"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/OhF61aLCOi","expanded_url":"https://x.com/takaichi_sanae/status/2114668906699010482/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":85,"w":85,"x":889,"y":839},{"h":127,"w":127,"x":337,"y":63},{"h":119,"w":119,"x":943,"y":559}]},"medium":{"faces":[{"h":50,"w":50,"x":521,"y":492},{"h":74,"w":74,"x":198,"y":37},{"h":70,"w":70,"x":552,"y":327}]},"orig":{"faces":[{"h":109,"w":109,"x":1129,"y":1066},{"h":162,"w":162,"x":429,"y":81},{"h":152,"w":152,"x":1198,"y":710}]},"small":{"faces":[{"h":28,"w":28,"x":295,"y":278},{"h":42,"w":42,"x":112,"y":21},{"h":39,"w":39,"x":313,"y":185}]}},"id_str":"2114668833449631744","indices":[93,116],"media_key":"3_2114668833449631744","media_results":{"result":{"media_key":"3_2114668833449631744"}},"media_url_https":"https://pbs.twimg.com/media/HVjQGZta4AAYDy-.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OhF61aLCOi"}]},"favorite_count":9724,"favorited":false,"full_text":"本日18時から、「サイバーセキュリティに関する関係閣僚会議」を開催しました。\n\n我が国の企業などに対する相次ぐサイバー攻撃によって、大規模な「情報漏えい被害」などが多数、生じています。 https://t.co/OhF61aLCOi","id_str":"2114668906699010482","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":205,"reply_count":706,"retweet_count":1367,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ2Njg5MDY1ODU2NjU1MzY=","richtext":{"richtext_tags":[]},"text":"本日18時から、「サイバーセキュリティに関する関係閣僚会議」を開催しました。\n\n我が国の企業などに対する相次ぐサイバー攻撃によって、大規模な「情報漏えい被害」などが多数、生じています。\n\n漏えいした情報を悪用した二次被害への不安が高まるなど、深刻な事態となっており、早急に対策を強化する必要があります。\n各大臣には、必要な対策について、財政措置を含め早急に検討・調整を進め、来週中を目途に、政府としての『緊急対策パッケージ』を取りまとめるよう、指示をしました。\n\n＜被害企業などに対する支援の強化＞\n\n「被害企業などへの支援」については、IPA（独立行政法人情報処理推進機構）や警察の相談対応を充実させ、民間機関や地方自治体との連携も強化し、どこに相談しても必要なサポートを得られる体制を整える必要があります。\n\nまた、国家サイバー統括室には、経済産業省の協力も得て、初動から復旧まで「民間の高度な専門能力を活用するための仕組み」の構築を進めるよう、指示をしました。\n\n赤沢経済産業大臣には、「サイバーセキュリティお助け隊」を中小企業や小規模事業者が、十分に活用できるよう、体制や支援策の拡充を速やかに検討するよう、指示をしました。\n\n＜情報集約体制の強化・的確な情報発信＞\n\n「情報収集体制、捜査・分析調査体制の強化」と「的確な情報発信」も重要です。\n\n古川サイバー安全保障担当大臣には、サイバー協議会へのセキュリティベンダー企業などの参加拡大を促すなどして、情報収集力を高めるよう、指示をしました。\nまた、各大臣には、基幹インフラ・重要インフラに限らず、所管業界の被害企業から迅速に情報を収集し、国家サイバー統括室への情報集約を徹底するよう、指示をしました。\n\nその上で、国家サイバー統括室では、集約した情報を分析し、想定される脅威やリスクに応じて、経営層、専門家、国民の皆様向けなど、対象を明確にした情報発信を強化してまいります。\n\nまた、赤沢大臣には、中小企業や小規模事業者に対して、「相談窓口」の抜本的な拡充をはじめ、プッシュ型での情報提供を行うよう、指示をしました。\n\n＜「アクセス・無害化措置」などの対処オプションの戦略的な実施＞\n\n実態を解明したサイバー攻撃に対しては、「アクセス・無害化措置」も含め、あらゆる対処オプションを戦略的に選択し、実行します。\n\n古川大臣の調整の下、同盟国・同志国や海外の関係機関とも緊密に連携して、攻撃主体の特定など国際社会と一体となった取組を進めてまいります。\n\n＜システムの脆弱性の検証＞\n\n被害を未然に防ぐためには、「システムの脆弱性の検証」も重要です。\n\n赤沢大臣には、IPAの知見・人材を活用して、高性能AIも活用しながら、システムの脆弱性を見つけるトップガン人材が「模擬的な攻撃テスト」を行うことで、システムの脆弱性を発見し、対策を講じる取組と、サプライチェーン全体でサイバー攻撃の観測網を整備し、中小企業を含めた迅速な対策につなげる取組を、前倒しで実施するよう、指示をしました。\nまた、古川大臣には、こうした取組を横展開するための方策を検討するよう、指示をしました。\n\nまた、政府自身のシステムについても、サイバーセキュリティの確保が不可欠です。\n各大臣には、古川大臣を中心に、AISIの知見も活用しながら、「高性能AIを用いた脆弱性チェック」を前倒しで実施し、担当する府省庁のシステムの安全確保を改めて徹底するよう、指示をしました。\n\n政府の総力を結集し、取組を加速してまいります。"}}},"rest_id":"2114668906699010482","unmention_data":{},"views":{"count":"406932","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114668906699010482","sortIndex":"2114706329535774717"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_ve