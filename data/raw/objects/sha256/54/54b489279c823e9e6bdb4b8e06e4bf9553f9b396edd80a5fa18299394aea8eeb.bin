":{"media_tweets":13297,"tweets":17313},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/0KdI8WnpkW"}}}},"edit_control":{"edit_tweet_ids":["2113216987535204563"],"editable_until_msecs":"1792668766000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"data":{"associated_data":{},"destination_language":"ja","entities":{"hashtags":[],"symbols":[],"urls":[],"user_mentions":[]},"preview_translation":"ASEAN事務局長のカオ・キム・ホーン博士は、2026年10月22日、日本訪問中に東京で日本の環境大臣、笹川博義殿下と会談しました。この会談では、両者はASEAN日本気候・環境戦略プログラム（SPACE）の実施について見解を交換し、共有する環境および気候の優先事項について議論し、ASEANと日本の協力をさら","source_language":"en","translation":"ASEAN事務局長のカオ・キム・ホーン博士は、2026年10月22日、日本訪問中に東京で日本の環境大臣、笹川博義殿下と会談しました。この会談では、両者はASEAN日本気候・環境戦略プログラム（SPACE）の実施について見解を交換し、共有する環境および気候の優先事項について議論し、ASEANと日本の協力をさらに強化する機会を探りました。"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2113216987535204563","created_at":"Thu Oct 22 10:32:46 +0000 2026","display_text_range":[0,277],"entities":{"media":[{"display_url":"pic.x.com/hApfrzwFzW","expanded_url":"https://x.com/ASEAN/status/2113216987535204563/photo/1","ext_media_availability":{"status":"Available"},"features":{"all":{"tags":[{"name":"DR KAO KIM HOURN","screen_name":"hourn_kao","type":"user","user_id":"1343605959092912128"}]},"large":{"faces":[{"h":57,"w":57,"x":557,"y":648},{"h":83,"w":83,"x":462,"y":185},{"h":87,"w":87,"x":646,"y":176},{"h":170,"w":170,"x":615,"y":10}]},"medium":{"faces":[{"h":53,"w":53,"x":522,"y":607},{"h":77,"w":77,"x":433,"y":173},{"h":81,"w":81,"x":605,"y":165},{"h":159,"w":159,"x":576,"y":9}]},"orig":{"faces":[{"h":57,"w":57,"x":557,"y":648},{"h":83,"w":83,"x":462,"y":185},{"h":87,"w":87,"x":646,"y":176},{"h":170,"w":170,"x":615,"y":10}]},"small":{"faces":[{"h":30,"w":30,"x":295,"y":344},{"h":44,"w":44,"x":245,"y":98},{"h":46,"w":46,"x":343,"y":93},{"h":90,"w":90,"x":326,"y":5}]}},"id_str":"211