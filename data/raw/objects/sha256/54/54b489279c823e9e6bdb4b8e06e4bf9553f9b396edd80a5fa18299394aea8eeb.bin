"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2114560146496192715"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39809,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":100,"tweets":449},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2114560146496192715"],"editable_until_msecs":"1792989000000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":18,"bookmarked":false,"conversation_id_str":"2114560146496192715","created_at":"Mon Oct 26 03:30:00 +0000 2026","display_text_range":[0,135],"entities":{"hashtags":[{"indices":[1,12],"text":"わたしの自衛隊記念日"}]},"favorite_count":490,"favorited":false,"full_text":"【#わたしの自衛隊記念日】\n私が、小学生だったころ、長崎県にある陸上自衛隊大村駐屯地を見学しました。\n \n「自衛隊とはどんなところなのだろう」\n「おもしろそうだな」\n \nそんな認識しかもっていなかった私でしたが、そこで出会った隊員の皆さんの姿は今でも鮮明に覚えています。","id_str":"2114560146496192715","is_quote_status":true,"lang":"ja","quote_count":5,"quoted_status_id_str":"2114552601970909634","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2114552601970909634","url":"https://t.co/B3JNFgli1I"},"reply_count":2,"retweet_count":78,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[1,12],"text":"わたしの自衛隊記念日"},{"indices":[578,589],"text":"わたしの自衛隊記念日"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ1NjAxNDY0NTQyNDEyODA=","text":"【#わたしの自衛隊記念日】\n私が、小学生だったころ、長崎県にある陸上自衛隊大村駐屯地を見学しました。\n \n「自衛隊とはどんなところなのだろう」\n「おもしろそうだな」\n \nそんな認識しかもっていなかった私でしたが、そこで出会った隊員の皆さんの姿は今でも鮮明に覚えています。\n \n規律正しい生活、そして私たちに気さくに声を掛けてくださる隊員の方々の温かさ。\n普段の生活とは少し違った緊張感の中、その一つひとつが新鮮で、大きな感動を覚えました。\n \n特に印象に残っているのは、ある隊員の方から伺った「国を守るとは、人々の毎日のくらしを守ること」という言葉です。当時は十分に理解できなかったかもしれませんが、年月を重ねる中で、その重みを実感するようになりました。\n \nご縁があって防衛省に勤めることになりましたが、自衛隊員の「服務の宣誓」をし、「国民の皆様の命と平和なくらしを守り抜く」ため、職務に励んでいます。\nそして、防衛省の報道官となった今、当時の隊員の方にいただいたような言葉が、若い方々や若い職員にも伝えられているか、いつも考えています。\n \n私にとっての自衛隊記念日は、あの日の大村駐屯地での思い出と、自衛隊を身近に感じるきっかけを与えてくださった隊員の皆さんを思い出す日でもあります。\n \n皆さんにも心に残る自衛隊との思い出はありますか。\n \nぜひ「#わたしの自衛隊記念日」を付けてお聞かせください。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2114552601970909634"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1264348,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7799,"tweets":21851},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2114