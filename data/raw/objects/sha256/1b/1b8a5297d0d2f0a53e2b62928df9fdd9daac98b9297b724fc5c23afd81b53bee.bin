":232},{"h":1200,"w":1200,"x":400,"y":0},{"h":1200,"w":1053,"x":547,"y":0},{"h":1200,"w":600,"x":860,"y":0},{"h":1200,"w":1600,"x":0,"y":0}],"height":1200,"width":1600},"sizes":{"large":{"h":1200,"resize":"fit","w":1600},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/1wHzt09f31"}]},"favorite_count":57,"favorited":false,"full_text":"【社会が支える海難救助】\n\nドイツのブレーメンMRCCを訪問し、海難救助の体制や人材育成などについて意見交換。\n\nブレーメンMRCCを運営するのは、150年以上の歴史を持つ民間の公益組織、ドイツ海難救助協会（DGzRS）です。\n\n救助調整本部（MRCC）による救助調整、\n現場で活動する救助船、 https://t.co/1wHzt09f31","id_str":"2095010239862931910","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":7,"retweeted":false,"user_id_str":"1526122312872894464"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"linkedin.com/posts/dgzrs-se…","expanded_url":"https://www.linkedin.com/posts/dgzrs-seeenotretter-teamseenotretter-share-7500584278515154944-iJ-k?utm_medium=ios_app&rcm=ACoAAEBX_2YB8Ta5lwGK_GLEfwc5nOnG2ixT-1g&utm_source=social_share_send&utm_campaign=x","indices":[347,370],"url":"https://t.co/muuaVtxsQZ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTUwMTAyMzk3MjQ1MzE3MTk=","text":"【社会が支える海難救助】\n\nドイツのブレーメンMRCCを訪問し、海難救助の体制や人材育成などについて意見交換。\n\nブレーメンMRCCを運営するのは、150年以上の歴史を持つ民間の公益組織、ドイツ海難救助協会（DGzRS）です。\n\n救助調整本部（MRCC）による救助調整、\n現場で活動する救助船、\n救助要員の養成・訓練、\n救助技術の研究、\n救助船の建造・修繕、\nそして活動を支える資金集めまで。\n\n海難救助に必要な「人・船・技術・資金」を自ら整え、一貫して海の人命救助を支えています。\n\nその根底にあるのは、人命救助という公共的な使命を支える社会の力と、その使命を担う彼らの救助に対する誇り。\n\n150年以上にわたり受け継がれてきた、ドイツの海難救助の強さ。その源泉に触れる機会となりました。\n\nhttps://t.co/muuaVtxsQZ"}}},"rest_id":"2095010239862931910","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"3882","state":"EnabledWithCount"}}},"user_id_