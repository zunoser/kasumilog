ge_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2095001307644059858","created_at":"Wed Sep 02 04:10:09 +0000 2026","display_text_range":[0,147],"entities":{"hashtags":[{"indices":[18,30],"text":"国環研一般公開2026"}]},"favorite_count":23,"favorited":false,"full_text":"10/25(日)、国立環境研究所で #国環研一般公開2026 が開催されます✨\n普段は見ることができない研究現場や装置の公開、研究者との対話、実験・観察体験、展示やトークイベントなど、環境研究の魅力に触れられる企画が盛りだくさん！\n子どもも大人も楽しめる特別な1日、ぜひ足を運んでみてください😊","id_str":"2095001307644059858","is_quote_status":true,"lang":"ja","quote_count":0,"quoted_status_id_str":"2094620152658837837","quoted_status_permalink":{"display":"x.com/NIES_JP/status…","expanded":"https://twitter.com/NIES_JP/status/2094620152658837837","url":"https://t.co/t2UpZG27Em"},"reply_count":0,"retweet_count":8,"retweeted":false,"user_id_str":"286056244"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":174},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/870106768512241665/PjOakx3__normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/841503398235066368/1775007771"},"core":{"created_at":"Tue Mar 14 04:16:59 +0000 2017","name":"国立環境研究所","screen_name":"NIES_JP"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NDE1MDMzOTgyMzUwNjYzNjg=","is_blue_verified":true,"location":{"location":"茨城つくば市小野川16-2"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2094620152658837837"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[{"icon_name":"IconBriefcaseStroke","id":713,"name":"科学・テクノロジー"}],"professional_type":"Business","rest_id":"1648488048051777536"},"profi