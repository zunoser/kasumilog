特別自動車警ら部隊は熊本の安全・安心を確保すべく、絶えず警戒の手を緩めません。写真は愛知県警察の部隊がパトロールに向かう様子と大阪府警察の部隊が宇城市小川町付近をパトロールする様子です。夜間帯や警戒要望場所のパトロールも欠かさず行います。…","id_str":"2095093339662275007","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":141,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":244},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1744651893413236736/ARtnUwkl_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Tue Jan 09 09:26:12 +0000 2024","name":"警察庁（災害情報専用）","screen_name":"NPA_saigaiKOHO"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNzQ0NjUwNjE1NjQzNjM5ODA5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2丁目1番2号"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"警察庁公式アカウントです。 発信する情報は「国内災害情報」「災害時警察活動」等です。発信専用のため返信等は行っておりません。ご利用にあたっては「警察庁（災害情報専用）X（旧：Twitter）運用ポリシーhttps://t.co/PluqK5Z3rXをご覧ください。","entities":{"description":{"urls":[{"display_url":"npa.go.jp/twitter/NPAsai…","expanded_url":"https://www.npa.go.jp/twitter/NPAsaigaipolicy.html","indices":[101,124],"url":"https://t.co/PluqK5Z3rX"}]},"url":{"urls":[{"display_url":"npa.go.jp","expanded_url":"https://www.npa.go.jp/","indices":[0,23],"url":"https://t.co/MHizgQoxXX"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":29539,"following":57},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"17446