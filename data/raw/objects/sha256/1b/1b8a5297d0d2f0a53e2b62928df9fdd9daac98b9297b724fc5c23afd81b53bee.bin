"w":683,"x":1365,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EYvBZbabhG"},{"display_url":"pic.x.com/EYvBZbabhG","expanded_url":"https://x.com/ModJapan_jp/status/2094754113364140367/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":80,"w":80,"x":204,"y":518},{"h":74,"w":74,"x":762,"y":758}]},"medium":{"faces":[{"h":46,"w":46,"x":119,"y":303},{"h":43,"w":43,"x":446,"y":444}]},"orig":{"faces":[{"h":80,"w":80,"x":204,"y":518},{"h":74,"w":74,"x":762,"y":758}]},"small":{"faces":[{"h":26,"w":26,"x":67,"y":171},{"h":24,"w":24,"x":253,"y":251}]}},"id_str":"2094754097761296384","indices":[132,155],"media_key":"3_2094754097761296384","media_results":{"result":{"media_key":"3_2094754097761296384"}},"media_url_https":"https://pbs.twimg.com/media/HRIPwODbIAAaZUb.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":682,"y":0},{"h":1366,"w":1198,"x":850,"y":0},{"h":1366,"w":683,"x":1365,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EYvBZbabhG"}]},"favorite_count":1379,"favorited":false,"full_text":"小泉防衛大臣は、９月１日の「#防災の日」に実施された総合防災訓練に参加しました。\n首都直下地震を想定した徒歩参集訓練や、北海道十勝沖を震源とする大規模地震を想定した緊急災害対策本部会議を通じて、関係機関との連携や人命救助活動など、災害発生時の対応を確認しました。 https://t.co/EYvBZbabhG","id_str":"2094754113364140367","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":19,"retweet_count":164,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[14,19],"text":"防災の日"},{"indices":[182,190],"text":"防衛省・自衛隊"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ3NTQxMTMzMDEyMDkwODg=","text":"小泉防衛大臣は、９月１日の「#防災の日」に実施された総合防災訓練に参加しました。\n首都直下地震を想定した徒歩参集訓練や、北海道十勝沖を震源とする大規模地震を想定した緊急災害対策本部会議を通じて、関係機関との連携や人命救助活動など、災害発生時の対応を確認しました。\n\nまた、神奈川県厚木市で行われた九都県市合同防災訓練を視察し、訓練に取り組む隊員達を激励しました。\n#防衛省・自衛隊 は、各種訓練を通じて大規模災害発生時における対処能力の向上に努めるとともに、関係機関との連携を一層強化してまいります。\n\n※九都県市合同防災訓練は、国や自治体等が連携して実施する総合的な防災訓練であり、毎年、九都県市（東京都、埼玉県、千葉県、神奈川県、横浜市、川崎市、千葉市、さいたま市及び相模原市）が持ち回りで開催しています。"}}},"rest_id":"2094754113364140367","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"95188","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094754113364140367","sortIndex":"2095304926618976163"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHRQEurdAJxEKAAIdFAAXSxvQmAgAAwAAAAEAAA"},"entryId":"cursor-top-2095304926618976257","sortIndex":"2095304926618976257"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHRQEurc__6AKAAIdEg_EgtuhTwgAAwAAAAIAAA"},"entryId":"cursor-bottom-2095304926618976162","sortIndex":"2095304926618976162"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}