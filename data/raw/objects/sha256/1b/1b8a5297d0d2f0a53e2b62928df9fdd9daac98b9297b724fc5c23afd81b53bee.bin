13_2095092326347759616"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2095092326347759616/img/3axNsoEPee0MTS4-.jpg","original_info":{"focus_rects":[],"height":2160,"width":3840},"sizes":{"large":{"h":1152,"resize":"fit","w":2048},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/kKSUtcwnJg","video_info":{"aspect_ratio":[16,9],"duration_millis":15033,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2095092326347759616/pl/XL7DcISjditCN6Wg.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095092326347759616/vid/avc1/480x270/GrkuvEiWZOLyr0Oe.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095092326347759616/vid/avc1/640x360/NYuO4OReha_Ft9lm.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095092326347759616/vid/avc1/1280x720/Tpiu8okIX0tSCpiN.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095092326347759616/vid/avc1/1920x1080/wq-Z0QwhP1b6Ztiu.mp4?tag=29"},{"bitrate":25128000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095092326347759616/vid/avc1/3840x2160/Fw36DrYNpJgrj6qd.mp4?tag=29"}]}}]},"favorite_count":506,"favorited":false,"full_text":"9月2日、神奈川県横浜市で根岸住宅地区返還記念式典が開催されました。\n\n根岸住宅地区は、約79年にわたり米軍施設・区域として使用されてきた土地であり、今年6月にアメリカ側から返還されました。 https://t.co/kKSUtcwnJg","id_str":"2095092562092527698","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":10,"retweet_count":96,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTUwOTI1NjIwMjk2NzA0MDA=","text":"9月2日、神奈川県横浜市で根岸住宅地区返還記念式典が開催されました。\n\n根岸住宅地区は、約79年にわたり米軍施設・区域として使用されてきた土地であり、今年6月にアメリカ側から返還されました。\n\n今回の返還は、日米同盟の下で必要な抑止力を維持しながら米軍施設・区域の整理を進めるとともに、地域の新たなまちづくりや発展につながる重要な節目となります。"}}},"rest_id":"2095092562092527698","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"40068","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095092562092527698","sortIndex":"2095304926618976248"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.j