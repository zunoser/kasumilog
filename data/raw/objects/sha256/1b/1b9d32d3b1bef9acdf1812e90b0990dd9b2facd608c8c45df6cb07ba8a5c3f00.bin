たGX（グリーン・トランスフォーメーション）は、エネルギー安定供給、経済成長、そして脱炭素を同時 https://t.co/4T3h83aVGx","id_str":"2110913891144491310","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":10,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/ic/ge/pa…","expanded_url":"https://www.mofa.go.jp/mofaj/ic/ge/pageit_000001_00004.html","indices":[218,241],"url":"https://t.co/orWK7D0DGS"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA5MTM4OTEwMzExOTE1NTI=","richtext":{"richtext_tags":[]},"text":"生稲外務大臣政務官は、飯倉公館において地球環境行動会議（GEA）国際会議2026の参加者をお迎えして、歓迎レセプションを開催しました。生稲政務官は、挨拶において、今般会議のテーマに取り上げられたGX（グリーン・トランスフォーメーション）は、エネルギー安定供給、経済成長、そして脱炭素を同時に実現させようとする現代の喫緊の要請であるとした上で、GXによる成長投資を通じた諸問題の解決に向けて、引き続き、取組を推進していく旨述べました。\n\nhttps://t.co/orWK7D0DGS"}}},"rest_id":"2110913891144491310","unmention_data":{},"views":{"count":"5203","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110913891144491310","sortIndex":"2110991743452184517"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_reques