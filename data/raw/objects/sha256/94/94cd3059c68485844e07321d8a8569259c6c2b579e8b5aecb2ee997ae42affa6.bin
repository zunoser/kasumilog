tures":{"large":{"faces":[{"h":82,"w":82,"x":308,"y":290},{"h":104,"w":104,"x":1104,"y":304},{"h":102,"w":102,"x":1484,"y":336},{"h":112,"w":112,"x":972,"y":362},{"h":152,"w":152,"x":1638,"y":54}]},"medium":{"faces":[{"h":48,"w":48,"x":180,"y":169},{"h":60,"w":60,"x":646,"y":178},{"h":59,"w":59,"x":869,"y":196},{"h":65,"w":65,"x":569,"y":212},{"h":89,"w":89,"x":959,"y":31}]},"orig":{"faces":[{"h":82,"w":82,"x":308,"y":290},{"h":104,"w":104,"x":1104,"y":304},{"h":102,"w":102,"x":1484,"y":336},{"h":112,"w":112,"x":972,"y":362},{"h":152,"w":152,"x":1638,"y":54}]},"small":{"faces":[{"h":27,"w":27,"x":102,"y":96},{"h":34,"w":34,"x":366,"y":100},{"h":33,"w":33,"x":492,"y":111},{"h":37,"w":37,"x":322,"y":120},{"h":50,"w":50,"x":543,"y":17}]}},"id_str":"2115423341511376896","indices":[145,168],"media_key":"3_2115423341511376896","media_results":{"result":{"media_key":"3_2115423341511376896"}},"media_url_https":"https://pbs.twimg.com/media/HVt-UjRbAAAxvnz.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1365,"w":1365,"x":683,"y":0},{"h":1365,"w":1197,"x":851,"y":0},{"h":1365,"w":683,"x":1143,"y":0},{"h":1365,"w":2048,"x":0,"y":0}],"height":1365,"width":2048},"sizes":{"large":{"h":1365,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/t6Zuwij6ou"}]},"favorite_count":480,"favorited":false,"full_text":"10月28日、小泉防衛大臣は、インドのシン国防大臣と防衛相会談を行いました。シン大臣とは、本年8月にインドのデリーで会談して以来2回目の会談です。両大臣は、8月の会談において一致した方向性に沿って日本とインドの防衛協力が着実に進展していることを歓迎するとともに、本年中に東京において第4回 https://t.co/t6Zuwij6ou","id_str":"2115423353628659876","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"quoted_status_id_str":"2115387374721188261","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2115387374721188261","url":"https://t.co/Y5H44TEDOu"},"reply_count":10,"retweet_count":78,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU0MjMzNTM1NjU3NjU2MzI=","text":"10月28日、小泉防衛大臣は、インドのシン国防大臣と防衛相会談を行いました。シン大臣とは、本年8月にインドのデリーで会談して以来2回目の会談です。両大臣は、8月の会談において一致した方向性に沿って日本とインドの防衛協力が着実に進展していることを歓迎するとともに、本年中に東京において第4回日印外務・防衛閣僚会合（「2＋2」）と防衛相会談を実施すべく、議論をさらに加速していくことで一致しました。"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2115387374721188261"}},"rest_id":"2115423353628659876","unmention_data":{},"views":{"count":"58146","state":"EnabledWithCount"}}},"rest_id":"2115427428843790585","unmention_data":{},"views":{"count":"67975","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2116281523115130865-tweet-2115728053834006706","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7837,"tweets":21910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115728053834006706"],"editable_until_msecs":"1793267451000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2115427428843790585","created_at":"Thu Oct 29 08:50:51 +0000 2026","display_text_range":[0,81],"entities":{},"favorite_count":104,"favorited":false,"full_text":"結果概要：\n\n令和８年１０月２８日（水）、小泉防衛大臣は、フィリピン・セブで開催された第１０回日ＡＳＥＡＮ防衛担当大臣会合に出席したところ、概要以下のとおりです。","id_str":"2115728053834006706","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2115427428843790585","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":14,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3MjgwNTM3MzMzOTY0ODA=","text":"結果概要：\n\n令和８年１０月２８日（水）、小泉防衛大臣は、フィリピン・セブで開催された第１０回日ＡＳＥＡＮ防衛担当大臣会合に出席したところ、概要以下のとおりです。\n\n（１）フィリピン、セブで第１０回日ＡＳＥＡＮ防衛担当大臣会合が行われ、「変化する国際情勢を踏まえたＡＤＭＭプラスにおける地域協力の今後の在り方」をテーマに意見交換が行われました。\n（２）冒頭、議長国フィリピンのギルベルト・テオドロ国防大臣より、日本とＡＳＥＡＮの長年の協力が、地域の安全、繁栄、強靱性に不可欠であるとの認識が表明され、日本のゆるぎない支援に謝意が述べられました。\n（３）また小泉大臣は、概要以下のように述べました。\n\nＡＳＥＡＮを取り巻く安全保障環境\n（４）ＡＳＥＡＮを取り巻く安全保障環境は、急速に悪化。その理由は三つある。\n（５）①自然災害は激化し、通信、医療、輸送を一度に直撃しています。世界各地の紛争は、供給網やエネルギー供給にまで及ぶ。②軍事バランスは急速に変化し、立場の弱い国への威圧や、危険な誤算のリスクを高めている。③これらの危機は、単に積み重なるだけではなく、互いに重なり、増幅し合う。\n\n守るべきもの\n（６）その中で守るべきは、ＡＳＥＡＮの一体性、中心性、そして強靱性。\n（７）一体性とは、違いがあっても、協力を続けること。中心性とは、地域の課題を自ら定め、域外のパートナーをその周りに結びつけること。強靱性とは、危機の中でも、不可欠な機能と自律性を保つこと。一体性が、共通の意思を生む。中心性が、その意思を共通の行動に変える。強靱性が、嵐が来ても、その行動を生かし続ける。\n（８）これは、ＡＳＥＡＮだけの利益ではない。地域の平和、繁栄、そしてすべての国の選択の自由を守る、国際公共財。日本は、この三つを大切にしている。\n\n日本の支援とその目的\n（９）ＡＳＥＡＮ各国は、自ら対処し、抑止する力を強化。ＡＳＥＡＮ全体としても、災害対応から海洋安全保障まで、共通の課題に取り組んでいる。この二つの努力は互いに補い合うものであり、日本は、プラス国として、その双方を支援する。\n（１０）私たちの目的は、シンプルであり、ＡＳＥＡＮ、そして各加盟国が、自ら把握し、自ら判断し、自ら行動できる、その選択肢を広げること。\n（１１）だからこそ、ＡＤＭＭプラスがあり、その制度的な背骨が、ＡＳＥＡＮ加盟国とプラス国が共同議長を務める専門家会合（Expert Working Group: EWG）。\n（１２）ＥＷＧは、ＡＳＥＡＮの優先課題と、パートナーの知見をつなぐもの。１０年にわたり、七つの分野で、ＥＷＧは確かな成果を上げてきた。この実績を、地域が変わる中で、その信頼性と対応力を高め続けながらさらに大きな力に変えなければならない。\n\nＥＷＧの強化―日本の三つの視点\n（１３）もちろん、方向を決めるのはＡＳＥＡＮである。今日、結論を求めるつもりはないが、日本の視点として三つ申し上げる。\n（１４）第一に、協力分野を更新すること。日本は、２０２４年以来ＡＳＥＡＮが進めているＥＷＧの優先順位の見直しを支持しており、現在の七つの分野は、減少するとされる。しかし、複合的な自然災害、ＡＩと無人システム、そして重要な海底インフラの防護など、新たな課題は増えている。課題が変われば、協力も変わらなければならない。既存のＥＷＧの対象範囲を柔軟に見直すことも、期間を限ったアドホックな取組を立ち上げることも考えられる。\n（１５）第二に、ＥＷＧ間の協力を、定着した習慣にすること。本年９月、インドネシアでのトライデント・リゾルブ演習では、史上初めて、三つのＥＷＧが共同で実動訓練を行った。各国の人員や予算の負担に配慮しつつ、こうした協力を促し、継続させる仕組みを考えてもよいのではないか。\n（１６）第三に、ＡＳＥＡＮ域外との関与を広げること。条件と手続きを定めるのはＡＳＥＡＮであり、ＥＷＧへの参加は、ＡＤＭＭプラスの参加国拡大とは切り離すべきであるが、その原則の下で、域外国や関係機関を迎え入れることは、ＡＳＥＡＮの中心性を弱めるのではなく、むしろ強めると考える。ＥＷＧには、既にオブザーバーの仕組みがあるが、これを基礎に、活動ごとに参加を広げてはどうか。"}}},"rest_id":"2115728053834006706","unmention_data":{},"views":{"count":"11858","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2116281523115130865-tweet-2115728063212519455","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2113395423876694016/-IvgMw9R?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mod.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2113395423876694016/-IvgMw9R?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":540,"url":"https://pbs.twimg.com/card_img/2113395423876694016/-IvgMw9R?format=jpg&name=orig","width":960},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"268732024","path":[]}}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2113395423876694016/-IvgMw9R?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":540,"url":"https://pbs.twimg.com/card_img/2113395423876694016/-IvgMw9R?format=png&name=2048x2048_2_exp","width":960},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mod.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_colo