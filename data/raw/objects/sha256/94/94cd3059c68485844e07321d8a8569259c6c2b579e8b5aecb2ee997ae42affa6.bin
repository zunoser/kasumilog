w.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39812,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":100,"tweets":470},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2115983250053386289"],"editable_until_msecs":"1793328294000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":6,"bookmarked":false,"conversation_id_str":"2115983250053386289","created_at":"Fri Oct 30 01:44:54 +0000 2026","display_text_range":[0,122],"entities":{},"favorite_count":346,"favorited":false,"full_text":"【10月30日　小泉防衛大臣会見】\n冒頭、沖縄県道104号線越え155ミリ榴弾砲実弾射撃訓練の分散・実施について発表しました。\n \nその他、\n○日米共同訓練\n○アメリカ軍人による事件\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら","id_str":"2115983250053386289","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":4,"retweet_count":66,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/X0hNdR-Vm1s?si…","expanded_url":"https://youtu.be/X0hNdR-Vm1s?si=zOH3Fw6uFf_mp7gw","indices":[549,572],"url":"https://t.co/lpLpHKV7uh"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU5ODMyNDk4ODU2MTQwODA=","text":"【10月30日　小泉防衛大臣会見】\n冒頭、沖縄県道104号線越え155ミリ榴弾砲実弾射撃訓練の分散・実施について発表しました。\n \nその他、\n○日米共同訓練\n○アメリカ軍人による事件\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「今日は冒頭１件です。１１月２５日から１２月６日までのうち１０日間、矢臼別演習場において、アメリカ海兵隊が実弾射撃訓練を実施します。\n \n本訓練は、かつて沖縄県道１０４号線を封鎖して行われていたアメリカ海兵隊による実弾射撃訓練を、ＳＡＣＯ最終報告に基づいて、本土に所在する５つの自衛隊演習場に分散して実施するものであり、訓練実施に伴う危険性の低減や、円滑な交通の確保の観点において、沖縄県の負担の軽減に資するものです。\n \n戦後８０年以上を経た今もなお、沖縄の皆様には大きな基地負担を担っていただいていることを重く受け止めています。\n \n防衛省としては、今後とも基地負担軽減策を一つ一つ着実に実施してまいります。同時に、訓練を受け入れていただく矢臼別演習場周辺の皆様の御理解と御協力が重要であり、訓練の実施に当たっては、安全確保に万全を期すとともに、地域に与える影響が最小限となるように努めていきたいと思います。冒頭は以上です。」\n \n↓動画はこちら\nhttps://t.co/lpLpHKV7uh"}}},"rest_id":"2115983250053386289","unmention_data":{},"views":{"count":"25858","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2115983474930987258","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4510","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115983474930987258","sortIndex":"2116281523115130761"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3074876,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":606,"tweets":1917},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2115976755672731972"],"editable_until_msecs":"1793326746000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":397,"bookmarked":false,"conversation_id_str":"2115976755672731972","created_at":"Fri Oct 30 01:19:06 +0000 2026","display_text_range":[0,23],"entities":{},"favorite_count":15537,"favorited":false,"full_text":"本日の閣議において、中東情勢等対応予備費より、","id_str":"2115976755672731972","is_quote_status":false,"lang":"ja","quote_count":228,"reply_count":1236,"retweet_count":1888,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU5NzY3NTU2MjY2MDY1OTI=","richtext":{"richtext_tags":[]},"text":"本日の閣議において、中東情勢等対応予備費より、\n・中東情勢が依然として不透明である中、原油価格の見通しが困難である状況を踏まえ、ガソリン等燃料油（ガソリン・軽油・重油・灯油・航空機燃料）の価格を抑制する激変緩和措置を継続するため、「燃料油価格激変緩和対策事業」として、1兆1,459億円、\n・LPガス価格高騰によるタクシー事業者の燃料費負担を抑制する観点から、ガソリン等燃料油に対する支援と同様に激変緩和措置を継続するため、「タクシーLPガス激変緩和対策事業」として、23億円、\n合計で、1兆1,481億円を支出する旨を閣議決定いたしました。\n\n引き続き、政府としては、\n・中東情勢が物価動向や経済に与える影響を注視し、\n・「予備費」の活用も含め、必要な時にはタイミングを逸することなく、\n国民の皆様の暮らしや経済活動に影響がないよう、対応してまいります。"}}},"rest_id":"2115976755672731972","unmention_data":{},"views":{"count":"1305124","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115976755672731972","sortIndex":"2116281523115130760"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.j