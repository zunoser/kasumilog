ts":{"followers":39812,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":100,"tweets":470},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2115968902983492075"],"editable_until_msecs":"1793324873000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":7,"bookmarked":false,"conversation_id_str":"2115968902983492075","created_at":"Fri Oct 30 00:47:53 +0000 2026","display_text_range":[0,56],"entities":{},"favorite_count":227,"favorited":false,"full_text":"【10月29日　小泉防衛大臣臨時会見】\nフィリピン訪問に伴い、臨時会見を行いました。\n\n↓発表事項の全文はこちら","id_str":"2115968902983492075","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":1,"retweet_count":38,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/ZuJRgyDWars?si…","expanded_url":"https://youtu.be/ZuJRgyDWars?si=-T3-qSEkwvl8DXgs","indices":[1999,2022],"url":"https://t.co/udIsOWe16F"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU5Njg5MDI3MTkyMDk0NzM=","text":"【10月29日　小泉防衛大臣臨時会見】\nフィリピン訪問に伴い、臨時会見を行いました。\n\n↓発表事項の全文はこちら\n「本日は、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス）に出席するとともに、日豪防衛相会談を行いました。まず、ＡＤＭＭプラスでは、地域及び国際社会が直面する安全保障課題について、各国の国防大臣と率直な意見交換を行いました。\n \n私からは、国際法に基づく自由で開かれた秩序を守り、全ての国が自らの意思で将来を選択できる地域こそが目指すべき姿であること、そのためには、危機に直面しても対話を続けることが必要であると訴えました。\n \nその上で、我が国は本年春の防衛装備移転三原則の見直しや、本年末までに行う戦略三文書の改定を通じ、厳しい安全保障環境の中で地域に積極的に貢献する能力を強化していく決意を述べました。\n \nまた、こうした取組は、各国に対しての説明を行いながら、透明性を持った形で行っていく旨を伝えたところです。私からも各国にですね、もしも説明が必要だったらいつでも連絡をいただきたいということを申し上げました。\n \nそして、マールズ副首相兼国防大臣とは今回で８回目の会談となりました。会談では、厳しさを増す地域の安全保障環境について認識を共有するとともに、日豪の特別な戦略的パートナーシップの下、防衛協力を更に具体化していくことを確認しました。\n \nまた、８月の日豪防衛相会談において議論したオーストラリアの「もがみ」型護衛艦の着実な進展を確認するとともに、日本の極超音速誘導弾のオーストラリアの試験場の活用について、本年９月に現地調査団をオーストラリアへ派遣するなど、防衛装備・技術協力が引き続き、進展していることを歓迎しました。\n \n更に、日豪が同志国連携の中核として多層的な協力関係を築いていく重要性を改めて確認するとともに、インド太平洋の平和と安定のために引き続き、貢献していくことで一致しました。\n \nまた、日豪に加え、日豪韓、また、日豪印という新たな形で対話を実施することができたことも、将来に向けた大きな成果でありました。なお、先ほどインドのシン大臣が自らのＸでその様子については発信をしてくれていることも、先ほど私とマールズ大臣の会合ではお互いに歓迎をしたところであります。\n \nこの２日間、日ＡＳＥＡＮ防衛担当相会合、ＡＤＭＭプラス、この会議への出席に加え、アメリカ、韓国、インド、フィリピン、ベトナム、シンガポール、オーストラリアの計７か国とのバイ会談、そして、日米豪比会談という多くの重要な会談の機会を持つことができました。\n \n例えば、アメリカとの間では、これまでの日米間の調整がようやく実を結び、Ｆ－３５に不可欠な空対空ミサイルＡＭＲＡＡＭについて、日本国内における最終組立・検査施設の設置という画期的な合意をすることができました。\n \nまた、インドとの間では、機雷対処能力の強化や海軍種の造船設計における共同開発の可能性を含め、海洋安全保障や空自の戦闘機の初のインド訪問の実現など、８月の訪印において一致した方向性に沿って、日印防衛協力が着実に進展していることを確認する共同プレスステートメントを発出することができ、本年内の「２＋２」や防衛相会談に向けた意義深い意見交換ができました。\n \n厳しい安全保障環境に直面しているからこそ、対話を重ね、信頼を築き、それを具体的な協力と行動につなげることが重要です。地域の平和と安定の要であるＡＳＥＡＮ諸国、そして同盟国・同志国のカウンターパートとの率直な意見交換により、防衛協力を具体的に前進させるための検討を加速させることができました。今回の成果を一つ一つ着実に行動に移してまいります。\n \nまた、本日は北朝鮮から弾道ミサイルが発射されました。既に発表したとおり、総理の指示を受け、私からも直ちに必要な指示を出し、防衛省・自衛隊として万全の態勢をとっています。\n \nちょうどＡＤＭＭプラスの会議の最中でしたので、私の指示の下、その場でパパロアメリカインド太平洋軍司令官や韓国のカン長官をはじめとする、アメリカ代表団、そして韓国代表団と直ちに必要な情報交換を行うとともに、改めて緊密に連携していくことを直接タイムリーに確認することができました。\n \n加えまして、一昨日、ミサイル駆逐艦を含む中国海軍艦艇３隻が中国海警船１隻とともに鹿児島県沖の大隅海峡を通過しました。防衛省がこのような事例を確認し、公表したのは今回が初めてです。今回のＡＤＭＭプラスでのスピーチにおいても、地域の厳しい安全保障環境を示す一例として、この事案に言及したところです。\n \n防衛省としては、引き続き、警戒監視に万全を期すとともに、このような動向について高い関心を持って注視してまいります。冒頭は以上です。」\n \n↓動画はこちら\nhttps://t.co/udIsOWe16F"}}},"rest_id":"2115968902983492075","unmention_data":{},"views":{"count":"21982","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2115969696017355146","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4570","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115969696017355146","sortIndex"