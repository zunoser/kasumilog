,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7837,"tweets":21910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115728063212519455"],"editable_until_msecs":"1793267453000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2115427428843790585","created_at":"Thu Oct 29 08:50:53 +0000 2026","display_text_range":[0,138],"entities":{},"favorite_count":94,"favorited":false,"full_text":"結語\n（１７）日本は、ＡＳＥＡＮに成り代わって、その将来を決めるつもりはない。方向を定めるのは、ＡＳＥＡＮの皆様であり、日本は、皆様の選択を確かな力に変えるため、全力を尽くしたい。\n（１８）自ら決める力を、共に行動する力へと変えていきましょう。\n\nＡＳＥＡＮ各国からの意見表明","id_str":"2115728063212519455","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2115728053834006706","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":8,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/approach/exc…","expanded_url":"https://www.mod.go.jp/j/approach/exchange/dialogue/j-asean/admm_10.html","indices":[314,337],"url":"https://t.co/gUhQRLwEOi"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3MjgwNjMwODI0MDk5ODQ=","text":"結語\n（１７）日本は、ＡＳＥＡＮに成り代わって、その将来を決めるつもりはない。方向を定めるのは、ＡＳＥＡＮの皆様であり、日本は、皆様の選択を確かな力に変えるため、全力を尽くしたい。\n（１８）自ら決める力を、共に行動する力へと変えていきましょう。\n\nＡＳＥＡＮ各国からの意見表明\n（１９）ＡＳＥＡＮ加盟国からは、「ビエンチャン・ビジョン」や「防衛協力強化のための日ＡＳＥＡＮ大臣イニシアティヴ：ジャスミン」等の下、これまでの日本の貢献に対する高い評価が表されるとともに、今回の小泉大臣による今後の防衛協力の方向性に関する日本の提案への歓迎・支持が示され、ＡＤＭＭプラスのさらなる発展に向けた日本の貢献への期待が表明されました。\n\nhttps://t.co/gUhQRLwEOi"}}},"rest_id":"2115728063212519455","unmention_data":{},"views":{"count":"10994","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115427428843790585","2115728053834006706","2115728063212519455"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130865","sortIndex":"2116281523115130713"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2115163920206094336/TDZm3UFW?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2115163920206094336/TDZm3UFW?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2115163920206094336/TDZm3UFW?format=jpg&na