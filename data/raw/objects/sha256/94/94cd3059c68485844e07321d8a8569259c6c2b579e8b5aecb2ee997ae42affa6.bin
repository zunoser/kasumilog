w":1366,"x":682,"y":0},{"h":1366,"w":1198,"x":850,"y":0},{"h":1366,"w":683,"x":1246,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Ttd1iHkcWQ"},{"display_url":"pic.x.com/Ttd1iHkcWQ","expanded_url":"https://x.com/trahmanbnp/status/2115122922301890865/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":90,"w":90,"x":522,"y":438},{"h":176,"w":176,"x":360,"y":240}]},"medium":{"faces":[{"h":52,"w":52,"x":305,"y":256},{"h":103,"w":103,"x":210,"y":140}]},"orig":{"faces":[{"h":90,"w":90,"x":522,"y":438},{"h":176,"w":176,"x":360,"y":240}]},"small":{"faces":[{"h":29,"w":29,"x":173,"y":145},{"h":58,"w":58,"x":119,"y":79}]}},"id_str":"2115122914643017728","indices":[278,301],"media_key":"3_2115122914643017728","media_results":{"result":{"media_key":"3_2115122914643017728"}},"media_url_https":"https://pbs.twimg.com/media/HVptFZ-WAAAplmD.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":0,"y":0},{"h":1366,"w":1198,"x":0,"y":0},{"h":1366,"w":683,"x":222,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Ttd1iHkcWQ"},{"display_url":"pic.x.com/Ttd1iHkcWQ","expanded_url":"https://x.com/trahmanbnp/status/2115122922301890865/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115122918233354241","indices":[278,301],"media_key":"3_2115122918233354241","media_results":{"result":{"media_key":"3_2115122918233354241"}},"media_url_https":"https://pbs.twimg.com/media/HVptFnWWMAEobMx.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":392,"y":0},{"h":1366,"w":1198,"x":476,"y":0},{"h":1366,"w":683,"x":734,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Ttd1iHkcWQ"}]},"favorite_count":3140,"favorited":false,"full_text":"My historic visit to Japan marks an important step forward in strengthening the longstanding friendship and strategic partnership between Bangladesh and Japan.\n\nBangladesh and Japan share a longstanding friendship built on mutual respect and trust. My father, Shaheed President https://t.co/Ttd1iHkcWQ","id_str":"2115122922301890865","is_quote_status":false,"lang":"en","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":44,"reply_count":414,"retweet_count":278,"retweeted":false,"user_id_str":"91877252"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"218434058","indices":[565,580],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"id":"Tm90ZVR3ZWV0OjIxMTUxMjI5MjE5NzA1MTU5Njg=","text":"My historic visit to Japan marks an important step forward in strengthening the longstanding friendship and strategic partnership between Bangladesh and Japan.\n\nBangladesh and Japan share a longstanding friendship built on mutual respect and trust. My father, Shaheed President Ziaur Rahman, helped lay the foundations of this relationship. My late mother, Prime Minister Begum Khaleda Zia, built on that foundation and further strengthened our ties through her visits and engagement with Japan.\n\nToday, I had a highly productive summit meeting with Prime Minister @takaichi_sanae, where we reaffirmed our shared commitment to democracy, the rule of law, economic development, and a peaceful, stable and prosperous Indo-Pacific.\n\nOur discussions focused on translating this partnership into tangible opportunities for the people of Bangladesh.\n\nWe explored emergency financial assistance of JPY 50 billion (approximately USD 320 million) under Japan’s Partnership for Power Asia initiative to strengthen Bangladesh’s energy security.\n\nWe also held encouraging discussions on the potential for up to JPY 1 trillion (approximately USD 6.3 billion) in Japanese private-sector investment over the next five years, with the prospect of creating around 200,000 jobs in Bangladesh. These investments could accelerate industrialisation, expand manufacturing capacity, and create new opportunities for our young workforce.\n\nI proposed establishing a Bangladesh–Japan Tech Park to advance cooperation in artificial intelligence, cloud computing, robotics, electronics manufacturing, and advanced technologies. We also discussed cooperation in space science and satellite engineering, alongside Japanese technical and financial support for high-speed rail connectivity linking six major divisional cities and the development of modern transport infrastructure.\n\nA significant outcome of our summit was our shared commitment to advance the Bay of Bengal Industrial Growth Belt (BIG-B) initiative into a new framework for shared prosperity. This renewed cooperation will focus on integrated development of energy, deep-sea ports, industrial infrastructure, technology, and regional connectivity, strengthening Bangladesh’s position as a bridge between South and Southeast Asia.\n\nWe also discussed the early implementation of the Bangladesh–Japan Economic Partnership Agreement, stronger institutional cooperation, and the proposed establishment of a ministerial-level joint commission to translate our shared priorities into concrete results.\n\nI expressed Bangladesh’s appreciation for Japan’s continued humanitarian assistance to the Rohingya population and called for its sustained engagement in securing their voluntary, safe, dignified and sustainable return to Myanmar.\n\nJapan was among the first countries to recognise Bangladesh’s independence and has remained a trusted development partner throughout our journey. I conveyed the sincere gratitude of the people of Bangladesh for Japan’s friendship, generosity, and longstanding support.\n\nAs Bangladesh moves forward following democratic elections, my government is determined to build an economy driven by investment, innovation, infrastructure development, and meaningful employment opportunities.\n\nOn behalf of the people and the Government of Bangladesh, I thank Prime Minister Sanae Takaichi, the Government of Japan, and the Japanese people for their warm hospitality and continued confidence in Bangladesh.\n\nLet's deepen the multifaceted ties between Bangladesh and Japan for a stronger, much better, and more prosperous future together."}}},"rest_id":"2115122922301890865","unmention_data":{},"views":{"count":"221462","state":"EnabledWithCount"}}},"user_id_str":"218434058"},"rest_id":"2115821408463081827","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"38789","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115821408463081827","sortIndex":"2116281523115130744"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2112627098561187842/yptttgOF?format=jpg&name=144x144_2","width":144},"ty