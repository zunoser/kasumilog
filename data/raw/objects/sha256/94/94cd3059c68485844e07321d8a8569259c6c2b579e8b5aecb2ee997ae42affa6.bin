a_url_https":"https://pbs.twimg.com/media/HVzaNYhaQAAhpyP.png","original_info":{"focus_rects":[{"h":1310,"w":2339,"x":0,"y":344},{"h":1654,"w":1654,"x":685,"y":0},{"h":1654,"w":1451,"x":888,"y":0},{"h":1654,"w":827,"x":1512,"y":0},{"h":1654,"w":2339,"x":0,"y":0}],"height":1654,"width":2339},"sizes":{"large":{"h":1448,"resize":"fit","w":2048},"medium":{"h":849,"resize":"fit","w":1200},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/BpBFbqpZv3"},{"display_url":"pic.x.com/BpBFbqpZv3","expanded_url":"https://x.com/kantei/status/2115810870999777397/video/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115805918587977729","indices":[143,166],"media_key":"3_2115805918587977729","media_results":{"result":{"media_key":"3_2115805918587977729"}},"media_url_https":"https://pbs.twimg.com/media/HVzaRd8bAAEVao_.png","original_info":{"focus_rects":[{"h":1310,"w":2339,"x":0,"y":0},{"h":1654,"w":1654,"x":167,"y":0},{"h":1654,"w":1451,"x":269,"y":0},{"h":1654,"w":827,"x":581,"y":0},{"h":1654,"w":2339,"x":0,"y":0}],"height":1654,"width":2339},"sizes":{"large":{"h":1448,"resize":"fit","w":2048},"medium":{"h":849,"resize":"fit","w":1200},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/BpBFbqpZv3"},{"display_url":"pic.x.com/BpBFbqpZv3","expanded_url":"https://x.com/kantei/status/2115810870999777397/video/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115805941891469313","indices":[143,166],"media_key":"3_2115805941891469313","media_results":{"result":{"media_key":"3_2115805941891469313"}},"media_url_https":"https://pbs.twimg.com/media/HVzaS0waEAENrLn.png","original_info":{"focus_rects":[{"h":1310,"w":2339,"x":0,"y":222},{"h":1654,"w":1654,"x":685,"y":0},{"h":1654,"w":1451,"x":888,"y":0},{"h":1654,"w":827,"x":1512,"y":0},{"h":1654,"w":2339,"x":0,"y":0}],"height":1654,"width":2339},"sizes":{"large":{"h":1448,"resize":"fit","w":2048},"medium":{"h":849,"resize":"fit","w":1200},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/BpBFbqpZv3"}]},"favorite_count":4534,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２９日）、高市総理は、中東情勢を踏まえた「緊急的激変緩和措置」についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（高市総理）\n　皆様、お疲れ様でございます。\n　中東情勢を踏まえた「緊急的激変緩和措置」について、今後の対応について、説明をいたします。 https://t.co/BpBFbqpZv3","id_str":"2115810870999777397","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":79,"reply_count":294,"retweet_count":720,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU4MTA4NzA4MDI2OTAwNDg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２９日）、高市総理は、中東情勢を踏まえた「緊急的激変緩和措置」についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（高市総理）\n　皆様、お疲れ様でございます。\n　中東情勢を踏まえた「緊急的激変緩和措置」について、今後の対応について、説明をいたします。\n　燃料油に対する「激変緩和措置」については、与党の自由民主党、日本維新の会に加え、国民民主党、中道、立憲民主党など、野党の皆様からも、｢段階的な見直し｣や｢出口戦略｣を考えるべきとの御指摘をいただいてきましたことも受けまして、今後の｢支援の在り方｣を検討するように、赤澤経済産業大臣に指示をしておりました。\n　昨日には、自由民主党と日本維新の会から、官邸に提言をお届けいただき、赤澤大臣とともに検討を進めました。\n　スライド１をご覧ください。\n　これまで、高市内閣は｢物価高｣への対応を最優先課題として取り組んできており、各種政策の効果もあり、\n・「物価上昇率」はG７の中で最も「低い」水準を実現しております。\n・また、「物価の伸びを上回る賃金の上昇分」である｢実質賃金上昇率｣は｢９か月連続のプラス｣で推移しており、Ｇ７の中で最も｢高い｣水準を実現しています。\n　また、スライド２の通り、中東情勢緊迫化後の｢物価上昇率｣については、\n・アメリカ、ユーロ圏、英国は､エネルギー価格の上昇により３％を超えている一方、\n・我が国ではエネルギー価格の抑制策を実施してきたこと\nにより、諸外国よりも低く抑えられている状況です。\n　こうした中、\n・燃料油に対する支援はあくまで「激変緩和措置」であるということ、\n・また、今年の年末調整でお届けする納税者お１人あたり３万円から６万円の｢所得税｣負担の軽減、\n・来年４月以降の「飲食料品の消費税率引下げ」など、切れ目ない物価高対策を講じたいと考えていることを踏まえ、\n「電気・ガス料金」に対する支援や、燃料油に対する｢激変緩和措置」の今後の支援の｢在り方」を検討しました。\n　まず、「電気・ガス料金」については、冬の需要期を迎えるにあたり、今季も負担軽減策を実施することといたしました。\n　前回は１月からの支援でございましたが、今季は、寒さが本格化する１２月に前倒しして支援を開始します。電気料金については、１kWh当たり、１２月は１円、１月は４．５円、そして２月は４．５円の支援を実施することとします。\n　あわせて、ガス料金についても支援をいたします。\n　これによって、標準的なご家庭において、１２月から２月までの３か月間で、電気・ガスあわせて、｢７，０００円程度｣の負担引下げ効果を実現できます。\n　その上で、３月につきましては、｢気候の状況｣や｢エネルギー価格の動向｣など様々な状況を見極めた上で、対応を検討いたします。\n　また、寒さが特に厳しい地域の生活に不可欠な｢灯油｣についても、「供給の偏り」や「流通の目詰まり」が発生しないよう、特に価格が高い「輸入灯油」に対する財政措置をはじめ、｢流通円滑化対策｣を強化してまいります。\n　次に、ガソリンなど「燃料油」に対する｢激変緩和措置｣については、当面のガソリン支援に必要な「基金規模」を確保するため、｢中東情勢等対応予備費｣の使用を指示いたしました。\n　その上で、スライド３の通り、我が国のガソリン価格は、フランスやドイツと比べて｢半分以下｣であります。産油国である米国をも下回る、国際的にも低い水準となっています。\n　他方、スライド４の通り、ガソリンの補助単価は、足元では１リットル当たり５０円を超えており、令和４年１月の燃料油の｢激変緩和措置｣の開始以降、過去最高の水準に達しています。\n　これは､国民の皆様の貴重な税金を､１日あたり１００億円を超えるペースで使用して価格を抑えているということを意味します。\n　これまでの燃料油支援のための「基金」への支出額は、本措置の開始以降、累計で約９．６兆円、そのうち、高市内閣では、約１．４兆円に達しています。\n　こうしたことを踏まえまして、｢ガソリン等の燃料油に対する補助｣について、与野党の皆様から「措置の出口」を見据えた様々なご提案やご意見をいただいてきました。\n　よって、今後の支援にあたっては、１２月以降、｢原油価格の動向｣を注視しつつ、春先に向けて｢基準価格｣を毎月５円ずつ引き上げていくことを基本に対応してまいります。\n　こうした｢持続可能な制度｣への円滑な移行にあたっては、｢国民生活や経済活動への影響｣に十分配慮するとともに、｢原油価格の動向｣も注視しつつ、進めてまいります。\n　再掲となりますけれども、スライド５の通り、各国と比較して、エネルギー価格とは異なり、｢食料品の物価上昇率｣が特に高止まりしております。そうした中、４月以降の「飲食料品の消費税率引下げ」は必要な措置だと、私は考えております。\n　国民の皆様の暮らしと経済をしっかりと守るべく、取り組んでまいります。\n　私からは以上でございます。\n\n（記者）\n　ガソリン価格につきましてですね、春先に向けて５円ずつ引き上げていくとおっしゃってましたけれども、そちらガソリン価格は３月末で引き上げを停止するという意味でしょうか。それともその時点で再度判断するという意味でしょうか。またですね、あの年度末でその場合、ガソリン価格はいくらぐらいになる想定でしょうか。合わせてお答えいただければと思います。\n\n（高市総理）\n　まずですね、先ほども申し上げましたが、高市内閣、物価高への対応を最優先で取り組んでまいりました。\n　燃料油に関する支援、これはあくまでも「激変緩和措置」であるということ、また今年の年末調整では納税者お１人当たり３万円から６万円の「所得税」負担の軽減をお届けできること、また「電気・ガス料金」について支援をする取り組みですが、今期は１２月に前倒しして支援を開始することとしました。\n　その上で今のお尋ねですが、ガソリンの補助単価が足元ではリッター当たり５０円を超えて過去最高の水準となっています。基金への支出額も令和４年の開始以降、累計で約９．６兆円、高市内閣でも約１．４兆円に上がっています。\n　先ほど申し上げました通り、与野党の皆様からも、措置の出口を見据えた様々なご提案をいただきました。\n　そういったことも踏まえまして、今後の支援にあたりましては、１２月以降、原油価格の動向を注視しつつ、春先に向けて基準価格を毎月５円ずつ引き上げていくということを基本に対応してまいります。\n　ですから、その基準価格の引き上げ期間ですとか、補助金の完全終了の見通し、そういったことにつきましては、予断をもって申し上げることはいたしません。\n　いずれにしましても切れ目のない物価高対策を講じてまいりますので、しっかりとですね、今回の燃料補助についても、その価格の動向をしっかりと注視をしながら判断をしてまいります。\n\n（記者）\n　価格の動向を注視していかれるということですけども、あまりにも価格が上がってしまうとですね、国民の負担というのはかなり大きくなってしまうと思います。いくらまで引き上げたら、その補助について考えるっていう、この金額の目安などはありますでしょうか。\n\n（高市総理）\n　こればかりはですね、今予断を持って申し上げることはできません。\n　つまり、国際価格との比較も先ほどお示しをいたしました。本当に日本は特に安いという状況でございます。\n　とにかくこの燃料の支援を、まだ中東情勢の先が見通せない中で、持続可能な制度に円滑に移行させるために、基準価格を引き上げていくということでございます。そこはご理解をいただきたいと思います。\n　でも国民の皆様の生活は守らなければなりませんから、ですから「電気・ガス料金」の支援も１２月に前倒しをして開始をいたしますし、また、先ほど申し上げました年末調整についても３万円から６万円の所得税負担の軽減もございます。\n　また、４月以降は、今、国会でご審議をいただいておりますけれども、私は飲食料品が特に国際的に比較しても高いということから、この消費税率の引き下げが必要だと考えるものでございます。\n　あらゆる方向から切れ目ない物価高対策、ベストな姿を追求して参りたいと思っております。\n\n（記者）\n　縮小の理由に関してなんですけれども、３月の再開以降ですね、これまで１兆円を超える国費を投入されてきたと思います。今回の見直しというのはですね、政府の財政負担が限界に近づいているという判断なのでしょうか。\n\n（高市総理）\n　そういう判断ではございません。国がお金持ちになっても仕方がないわけで、やはり国民の皆様がですね、生活が豊かにならなきゃいけないし、国民の皆様に安心して暮らしていただかなければならないということです。\n　ただ、おっしゃったように、確かに基金への支出額っていうのは非常に大きなものになってますよ。令和４年の開始以降で累計で９．６兆円です。高市内閣になってからも、また約１．４兆円ということでございます。\n　でも、これは国民の皆様の貴重な税金でございますから、その使途について賢く考えて、そして、より必要なところにお金を入れていくという判断になると、こう考えております。"}}},"rest_id":"2115810870999777397","unmention_data":{},"views":{"count":"577842","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2116281523115130836-tweet-2115810873747046776","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI