},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7837,"tweets":21910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115788613527196127"],"editable_until_msecs":"1793281889000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2115788596435456156","created_at":"Thu Oct 29 12:51:29 +0000 2026","display_text_range":[0,102],"entities":{},"favorite_count":114,"favorited":false,"full_text":"結果概要：\n\n令和８年１０月２９日、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス）出席のためフィリピンを訪問中の小泉防衛大臣は、オーストラリア・マールズ副首相兼国防大臣と日豪防衛相会談を実施しました。","id_str":"2115788613527196127","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2115788596435456156","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":18,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/approach/exc…","expanded_url":"https://www.mod.go.jp/j/approach/exchange/area/2026/20261029_aus-j.html","indices":[475,498],"url":"https://t.co/A4oKRj2Rxs"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3ODg2MTMzOTI5MzI4NjQ=","text":"結果概要：\n\n令和８年１０月２９日、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス）出席のためフィリピンを訪問中の小泉防衛大臣は、オーストラリア・マールズ副首相兼国防大臣と日豪防衛相会談を実施しました。\n\n・両大臣は、厳しさを増す地域の安全保障環境について認識を共有するとともに、日豪の「特別な戦略的パートナーシップ」の下、防衛協力を更に具体化していくことを確認しました。\n\n・また、防衛装備・技術協力に関して、８月の日豪防衛相会談において議論したオーストラリアの汎用フリゲート事業の着実な進展を確認するとともに、日本の極超音速誘導弾事業などに関するオーストラリアの試験場の活用について、本年９月に現地調査団をオーストラリアへ派遣するなど現場レベルでの調整も進展していることを歓迎し、オーストラリアにおける試験を目指し引き続き連携していくことで一致しました。\n\n・さらに、両大臣は、日豪が同志国連携の中核として、多層的な協力関係を築いていく重要性を改めて確認するとともに、インド太平洋の平和と安定のために引き続き貢献していくことで一致しました。\n\nhttps://t.co/A4oKRj2Rxs"}}},"rest_id":"2115788613527196127","unmention_data":{},"views":{"count":"15436","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115788596435456156","2115788613527196127"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130839","sortIndex":"2116281523115130739"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1770794,"following":47},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8368,"tweets":23489},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2115773737090031888"],"editable_until_msecs":"1793278342000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":20,"bookmarked":false,"conversation_id_str":"2115773737090031888","created_at":"Thu Oct 29 11:52:22 +0000 2026","display_text_range":[0,81],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/xY2uFflHUM","expanded_url":"https://x.com/kantei/status/2115773737090031888/video/1","ext_media_availability":{"status":"Available"},"id_str":"2115772001260638208","indices":[82,105],"media_key":"13_2115772001260638208","media_results":{"result":{"media_key":"13_2115772001260638208"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2115772001260638208/img/XwxGvbIwgGvEaJ8D.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/xY2uFflHUM","video_info":{"aspect_ratio":[16,9],"duration_millis":178433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2115772001260638208/pl/_qzFiXqt059hOLdj.m3u8?tag=29&v=b50"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115772001260638208/vid/avc1/480x270/gCUHviFKUsuNfp6T.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115772001260638208/vid/avc1/640x360/1i70FW1CkpcrREiu.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115772001260638208/vid/avc1/1280x720/dyQAGW0aIed6_S6L.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/xY2uFflHUM","expanded_url":"https://x.com/kantei/status/2115773737090031888/video/1","ext_media_availability":{"status":"Available"},"id_str":"2115772001260638208","indices":[82,105],"media_key":"13_2115772001260638208","media_results":{"result":{"media_key":"13_2115772001260638208"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2115772001260638208/img/XwxGvbIwgGvEaJ8D.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/xY2uFflHUM","video_info":{"aspect_ratio":[16,9],"duration_millis":178433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2115772001260638208/pl/_qzFiXqt059hOLdj.m3u8?tag=29&v=b50"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115772001260638208/vid/avc1/480x270/gCUHviFKUsuNfp6T.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115772001260638208/vid/avc1/640x360/1i70FW1CkpcrREiu.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115772001260638208/vid/avc1/1280x720/dyQAGW0aIed6_S6L.mp4?tag=29"}]}}]},"favorite_count":1201,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２９日）、高市総理は、全国中小企業団体中央会創立７０周年記念祝賀会に出席しました。\n\n※高市総理発言要旨（速報版）\n　皆様、こんばんは。 https://t.co/xY2uFflHUM","id_str":"2115773737090031888","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"reply_count":67,"retweet_count":168,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3NzM3MzcwMDE5NTEyMzI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２９日）、高市総理は、全国中小企業団体中央会創立７０周年記念祝賀会に出席しました。\n\n※高市総理発言要旨（速報版）\n　皆様、こんばんは。\n　「全国中小企業団体中央会」のご創立７０周年ということで、心よりお慶びを申し上げます。また、本日、栄えある表彰をお受けになられました皆様、誠におめでとうございます。\n　中小企業はこの１０年間以上ですけれども、相次ぐ自然災害ですとか、新型コロナウイルス感染症の拡大、また物価高騰など、厳しい経営環境に直面してきました。\n　そうした中で、「中央会」の皆様は、中小企業の幅広い連携を促すことで、「中小企業組合」の活動を支え、また、「中小企業の成長・発展」と「経済的地位の向上」に大きく貢献してこられました。\n　皆様の長年のご尽力に敬意を表します。\n　今、もう世界各国が、国を挙げて、「長期的かつ大規模」な「産業政策」を競い合っている中で、日本だけが足踏みをしていては、それこそ「雇用」も「投資」も海外に流れます。企業もそうです。日本が再び「停滞の時代」に逆戻りしかねない、そういった危機感を強く持っております。\n　高市内閣では、『日本成長戦略』と『地域未来戦略』、これを両輪として、「責任ある積極財政」の下で、「国内投資」を引き出して、日本の「潜在成長率」を上げて、\n・「良質な雇用と所得」を増やして、\n・「消費マインド」も改善して、\nそして\n・「事業収益」がその結果上がっていって、\nまた、\n・「税収」は自然増に向かっていく、\nまさに「GDP拡大の下での好循環」を実現してまいります。\n　とりわけ、『日本成長戦略』の「分野横断的な課題」としまして、\n・官公需を含む「価格転嫁・取引適正化」へのさらなる取り組み\n・そして、「成長志向の企業」ですとか、「生産性向上」への支援を強化すること\n・また、M＆A・事業承継と、この「事業再編」の推進をすること\n・そしてまた、「伴走支援体制」を強化すること\nこういった取り組みで、中小企業、小規模事業者への支援を進めさせていただきます。\n　本日お集まりの皆様の、益々のご活躍と「中央会」の更なる発展を心よりお祈り申し上げます。\n　誠におめでとうございました。ありがとうございます。"}}},"rest_id":"2115773737090031888","unmention_data":{},"views":{"count":"54809","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115773737090031888","sortIndex":"2116281523115130738"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3074876,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":606,