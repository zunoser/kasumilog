ともに考え、ともに備え、ともに守る。」と書かれ、その下には防災庁のロゴマークがついた旗の写真がある。また、松井玲奈さんは、ぼうさい応援キャラクター、なまぼ～のぬいぐるみを持っている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":137,"w":137,"x":707,"y":93},{"h":134,"w":134,"x":346,"y":134},{"h":169,"w":169,"x":201,"y":126}]},"medium":{"faces":[{"h":137,"w":137,"x":707,"y":93},{"h":134,"w":134,"x":346,"y":134},{"h":169,"w":169,"x":201,"y":126}]},"orig":{"faces":[{"h":137,"w":137,"x":707,"y":93},{"h":134,"w":134,"x":346,"y":134},{"h":169,"w":169,"x":201,"y":126}]},"small":{"faces":[{"h":77,"w":77,"x":400,"y":52},{"h":75,"w":75,"x":196,"y":75},{"h":95,"w":95,"x":113,"y":71}]}},"id_str":"2115734414709915649","indices":[168,191],"media_key":"3_2115734414709915649","media_results":{"result":{"media_key":"3_2115734414709915649"}},"media_url_https":"https://pbs.twimg.com/media/HVyZPZPagAEefvX.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":1200,"w":1200,"x":0,"y":0},{"h":1200,"w":1053,"x":0,"y":0},{"h":1200,"w":600,"x":90,"y":0},{"h":1200,"w":1200,"x":0,"y":0}],"height":1200,"width":1200},"sizes":{"large":{"h":1200,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1200},"small":{"h":680,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/oJ1n67zxGq"},{"display_url":"pic.x.com/oJ1n67zxGq","expanded_url":"https://x.com/gov_online/status/2115971952297099608/photo/1","ext_alt_text":"番組収録時の一コマ。番組パーソナリティの松井玲奈さんが防災服のジャケットを着て、手にはぼうさい応援キャラクター、なまぼ～のぬいぐるみを持っている写真。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":274,"w":274,"x":532,"y":222}]},"medium":{"faces":[{"h":274,"w":274,"x":532,"y":222}]},"orig":{"faces":[{"h":274,"w":274,"x":532,"y":222}]},"small":{"faces":[{"h":155,"w":155,"x":301,"y":125}]}},"id_str":"2115734414730891264","indices":[168,191],"media_key":"3_2115734414730891264","media_results":{"result":{"media_key":"3_2115734414730891264"}},"media_url_https":"https://pbs.twimg.com/media/HVyZPZUakAAuDEb.jp