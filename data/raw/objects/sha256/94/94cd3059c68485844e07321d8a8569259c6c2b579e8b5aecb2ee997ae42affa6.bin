"x":551,"y":319}]}},"id_str":"2115765267284541440","indices":[141,164],"media_key":"3_2115765267284541440","media_results":{"result":{"media_key":"3_2115765267284541440"}},"media_url_https":"https://pbs.twimg.com/media/HVy1TQCawAAo_14.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":108,"y":0},{"h":1734,"w":1521,"x":215,"y":0},{"h":1734,"w":867,"x":542,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/gRRDZzwfuf"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/gRRDZzwfuf","expanded_url":"https://x.com/takaichi_sanae/status/2115765328437461168/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":287,"w":287,"x":1157,"y":283}]},"medium":{"faces":[{"h":168,"w":168,"x":678,"y":166}]},"orig":{"faces":[{"h":365,"w":365,"x":1470,"y":360}]},"small":{"faces":[{"h":95,"w":95,"x":384,"y":94}]}},"id_str":"2115765267276189696","indices":[141,164],"media_key":"3_2115765267276189696","media_results":{"result":{"media_key":"3_2115765267276189696"}},"media_url_https":"https://pbs.twimg.com/media/HVy1TQAbUAA5Go3.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":758,"y":0},{"h":1734,"w":1521,"x":865,"y":0},{"h":1734,"w":867,"x":1192,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/gRRDZzwfuf"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/gRRDZzwfuf","expanded_url":"https://x.com/takaichi_sanae/status/2115765328437461168/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":115,"w":115,"x":1819,"y":397},{"h":117,"w":117,"x":1659,"y":961}]},"medium":{"faces":[{"h":67,"w":67,"x":1066,"y":233},{"h":68,"w":68,"x":972,"y":563}]},"orig":{"faces":[{"h":147,"w":147,"x":2310,"y":505},{"h":149,"w":149,"x":2107,"y":1221}]},"small":{"faces":[{"h":38,"w":38,"x":604,"y":132},{"h":38,"w":38,"x":551,"y":319}]}},"id_str":"2115765267284541440","indices":[141,164],"media_key":"3_2115765267284541440","media_results":{"result":{"media_key":"3_2115765267284541440"}},"media_url_https":"https://pbs.twimg.com/media/HVy1TQCawAAo_14.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":108,"y":0},{"h":1734,"w":1521,"x":215,"y":0},{"h":1734,"w":867,"x":542,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/gRRDZzwfuf"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/gRRDZzwfuf","expanded_url":"https://x.com/takaichi_sanae/status/2115765328437461168/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":287,"w":287,"x":1157,"y":283}]},"medium":{"faces":[{"h":168,"w":168,"x":678,"y":166}]},"orig":{"faces":[{"h":365,"w":365,"x":1470,"y":360}]},"small":{"faces":[{"h":95,"w":95,"x":384,"y":94}]}},"id_str":"2115765267276189696","indices":[141,164],"media_key":"3_2115765267276189696","media_results":{"result":{"media_key":"3_2115765267276189696"}},"media_url_https":"https://pbs.twimg.com/media/HVy1TQAbUAA5Go3.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":758,"y":0},{"h":1734,"w":1521,"x":865,"y":0},{"h":1734,"w":867,"x":1192,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/gRRDZzwfuf"}]},"favorite_count":7409,"favorited":false,"full_text":"本日、『全国中小企業団体中央会創立70周年記念祝賀会』にお招きいただきました。\n\n「全国中小企業団体中央会」の創立70周年を、心よりお慶び申し上げます。\n\n中小企業は、この10年余り、相次ぐ自然災害や新型コロナウイルス感染症の拡大、物価高騰など、厳しい経営環境に直面してきました。 https://t.co/gRRDZzwfuf","id_str":"2115765328437461168","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":51,"reply_count":539,"retweet_count":754,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3NjUzMjgzNzg4MTQ0NjQ=","richtext":{"richtext_tags":[]},"text":"本日、『全国中小企業団体中央会創立70周年記念祝賀会』にお招きいただきました。\n\n「全国中小企業団体中央会」の創立70周年を、心よりお慶び申し上げます。\n\n中小企業は、この10年余り、相次ぐ自然災害や新型コロナウイルス感染症の拡大、物価高騰など、厳しい経営環境に直面してきました。\n\nそうした中で、「中央会」の皆様は、中小企業の幅広い連携を促すことで、「中小企業組合」の活動を支え、「中小企業の成長・発展」と「経済的地位の向上」に大きく貢献されてきました。\n\n皆様の長年のご尽力に、敬意を表します。\n\n『日本成長戦略』の「分野横断的な課題」として、\n・官公需を含む「価格転嫁・取引適正化」の更なる徹底、\n・「成長志向の企業」や「生産性向上」への支援強化、\n・М＆Ａ・事業承継等の「事業再編」の推進、\n・「伴走支援体制」の強化\nなどの中小企業・小規模事業者への支援を進めていきます。"}}},"rest_id":"2115765328437461168","unmention_data":{},"views":{"count":"271607","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115765328437461168","sortIndex":"2116281523115130736"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliat