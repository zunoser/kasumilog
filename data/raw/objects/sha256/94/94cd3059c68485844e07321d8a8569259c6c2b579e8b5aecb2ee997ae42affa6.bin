.com/ModJapan_jp/status/2115710812459303243/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115710788577198080","indices":[99,122],"media_key":"3_2115710788577198080","media_results":{"result":{"media_key":"3_2115710788577198080"}},"media_url_https":"https://pbs.twimg.com/media/HVyDwLCbAAA6oQB.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":682,"y":0},{"h":1366,"w":1198,"x":850,"y":0},{"h":1366,"w":683,"x":1348,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0WI1h0n2uL"}]},"favorite_count":749,"favorited":false,"full_text":"～寒冷地がつなぐ、日フィンランド防衛協力～\n \n日フィンランド防衛相会談の翌27日、フィンランドのハッカネン国防大臣は空自千歳基地と陸自北千歳駐屯地をそれぞれ視察しました。\n \n【空自千歳基地✈】 https://t.co/0WI1h0n2uL","id_str":"2115710812459303243","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"quoted_status_id_str":"2115074550849556795","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2115074550849556795","url":"https://t.co/J2BnTgIqSp"},"reply_count":7,"retweet_count":124,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3MTA4MTIzOTYzMzkyMDA=","text":"～寒冷地がつなぐ、日フィンランド防衛協力～\n \n日フィンランド防衛相会談の翌27日、フィンランドのハッカネン国防大臣は空自千歳基地と陸自北千歳駐屯地をそれぞれ視察しました。\n \n【空自千歳基地✈】\n日本の北の空の守りの最前線を担う千歳基地では、我が国を取り巻く安全保障環境や即応態勢について説明を受けたほか、F-15などの装備品を視察し、双方の取組について意見交換を実施しました。\n【陸自北千歳駐屯地❄️】\n陸上自衛隊最大の方面隊を擁する北部方面総監との意見交換のほか、フィンランド製のアキオ（そり）や大雪上車をはじめとする冬季装備品などを視察しました。寒冷地での訓練・活動という共通点を持つ両国は、共通する経験や知見も活かし、🇯🇵🇫🇮防衛協力をさらに発展させていきます。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":fal