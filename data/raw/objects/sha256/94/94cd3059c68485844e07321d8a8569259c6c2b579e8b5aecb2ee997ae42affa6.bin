s.twimg.com/media/HVwlYZIbcAAeyYd.jpg","original_info":{"focus_rects":[{"h":1270,"w":2268,"x":0,"y":272},{"h":2268,"w":2268,"x":0,"y":0},{"h":2586,"w":2268,"x":0,"y":0},{"h":4032,"w":2016,"x":0,"y":0},{"h":4032,"w":2268,"x":0,"y":0}],"height":4032,"width":2268},"sizes":{"large":{"h":2048,"resize":"fit","w":1152},"medium":{"h":1200,"resize":"fit","w":675},"small":{"h":680,"resize":"fit","w":383},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/cLcuEqkFal"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/cLcuEqkFal","expanded_url":"https://x.com/genkiichioka/status/2115607043130450040/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":233,"w":233,"x":635,"y":389}]},"medium":{"faces":[{"h":136,"w":136,"x":372,"y":228}]},"orig":{"faces":[{"h":460,"w":460,"x":1252,"y":767}]},"small":{"faces":[{"h":77,"w":77,"x":211,"y":129}]}},"id_str":"2115607025946439680","indices":[99,122],"media_key":"3_2115607025946439680","media_results":{"result":{"media_key":"3_2115607025946439680"}},"media_url_https":"https://pbs.twimg.com/media/HVwlYZHbsAAeCHK.jpg","original_info":{"focus_rects":[{"h":2258,"w":4032,"x":0,"y":0},{"h":2268,"w":2268,"x":579,"y":0},{"h":2268,"w":1989,"x":719,"y":0},{"h":2268,"w":1134,"x":1146,"y":0},{"h":2268,"w":4032,"x":0,"y":0}],"height":2268,"width":4032},"sizes":{"large":{"h":1152,"resize":"fit","w":2048},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/cLcuEqkFal"}]},"favorite_count":123,"favorited":false,"full_text":"昨日、日本原子力研究開発機構（JAEA）の報告会に登壇してきました！！\n\n今回はいつものサイエンスライブとは全く違って、会場にはスーツを着た大人の方々がずらり！！\n\nめちゃくちゃ緊張しました！！笑 https://t.co/cLcuEqkFal","id_str":"2115607043130450040","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":8,"retweeted":false,"user_id_str":"2401755259"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2MDcwNDMwNTQ5MzYwNjQ=","text":"昨日、日本原子力研究開発機構（JAEA）の報告会に登壇してきました！！\n\n今回はいつものサイエンスライブとは全く違って、会場にはスーツを着た大人の方々がずらり！！\n\nめちゃくちゃ緊張しました！！笑\n\n言わなくてはいけないことを言い忘れてしまったり、途中でいつも通りクイズを出したらまさかの全て全員正解！！ですよね😂\n\n普段は子どもたちに科学の面白さを伝えることが多いのですが、今回は科学技術に詳しい方々や国会議員の方々もたくさんいらっしゃる中での登壇。\n\n今までで一番ハードな回だったかもしれません！！\n\nそれでもなんとかJAEAの研究者の皆さんが取り組んでいる研究を、僕なりに分かりやすく解説させていただきました！\n\nそして今回とても印象に残ったのが、JAEAの若手研究者の皆さんの発表です！\n\nこの日のために何度も練習を重ねてきたんだろうなということが伝わってきました。\n\n難しい研究内容も分かりやすく説明されていて、実験の様子もとても伝わってきました！\n\n正直、僕がいなくてもJAEAの研究の面白さはたくさんの方に届くんじゃないかと思うくらい素晴らしかったです！！\n\n僕自身も身が引き締まる思いでした！\n\nJAEAさんの研究は本当に未来につながるものばかりで、もっとたくさんの人に知ってもらいたいことが山ほどあります！\n\n普段なかなか知る機会のない研究の中にも、これからの日本や世界を大きく変える可能性を持った技術がたくさんあるんです！\n\nだからこそ今回の報告会だけで終わらせず、これからもサイエンスコンテンツクリエイターとして、こうした研究の面白さや可能性を動画にして皆さんに届けていきたいと思います！！\n\n最近は子ども向けのサイエンスライブだけでなく大人向けの講演も増えてきました。\n\n相手が変われば伝え方も変わるし、まだまだ勉強しなくてはいけないことがたくさんあるなと実感しました！\n\nもっと経験を積んで、子どもから大人までどんな方にも科学の面白さを伝えられるようになりたいです！\n\nまだまだ精進して頑張ります！！\n\nそして最後にお知らせです！！\n\n11月14日（土）は福井県敦賀市で開催される「つるが国際シンポジウム2026」でサイエンスライブを行います！！🔬\n\n今回の報告会とはまた違って、皆さんと一緒に科学の面白さを体験できるライブにしたいと思っています！\n\nお近くの方はぜひ遊びに来てください！！"}}},"rest_id":"2115607043130450040","unmention_data":{},"views":{"count":"7260","state":"EnabledWithCount"}}},"user_id_str":"242156036"},"rest_id":"2116019939622662483","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"473","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116019939622662483","sortIndex":"2116281523115130784"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tw