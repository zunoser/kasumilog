:{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115771070754201600","indices":[103,126],"media_key":"3_2115771070754201600","media_results":{"result":{"media_key":"3_2115771070754201600"}},"media_url_https":"https://pbs.twimg.com/media/HVy6lDpaIAAB6DF.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/O1yPj6cva8"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/O1yPj6cva8","expanded_url":"https://x.com/takaichi_sanae/status/2115771158482305432/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":155,"w":155,"x":1383,"y":661}]},"medium":{"faces":[{"h":91,"w":91,"x":810,"y":387}]},"orig":{"faces":[{"h":198,"w":198,"x":1757,"y":840}]},"small":{"faces":[{"h":51,"w":51,"x":459,"y":219}]}},"id_str":"2115771043382214656","indices":[103,126],"media_key":"3_2115771043382214656","media_results":{"result":{"media_key":"3_2115771043382214656"}},"media_url_https":"https://pbs.twimg.com/media/HVy6jdrawAAj4Hb.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1645,"w":1645,"x":673,"y":0},{"h":1645,"w":1443,"x":774,"y":0},{"h":1645,"w":823,"x":1084,"y":0},{"h":1645,"w":2600,"x":0,"y":0}],"height":1645,"width":2600},"sizes":{"large":{"h":1296,"resize":"fit","w":2048},"medium":{"h":759,"resize":"fit","w":1200},"small":{"h":430,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/O1yPj6cva8"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/O1yPj6cva8","expanded_url":"https://x.com/takaichi_sanae/status/2115771158482305432/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115771070754201600","indices":[103,126],"media_key":"3_2115771070754201600","media_results":{"result":{"media_key":"3_2115771070754201600"}},"media_url_https":"https://pbs.twimg.com/media/HVy6lDpaIAAB6DF.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/O1yPj6cva8"}]},"favorite_count":9120,"favorited":false,"full_text":"本日、経済財政諮問会議を開催し、「予算編成の抜本見直し」の具体化や「AIによる経済･社会の変革を見据えた政策形成」について議論を行いました。\n\nまず、「予算編成の抜本見直し」について、民間議員の皆様から、 https://t.co/O1yPj6cva8","id_str":"2115771158482305432","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":111,"reply_count":1315,"retweet_count":1085,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3NzExNTgzOTAwNDI2MjQ=","richtext":{"richtext_tags":[]},"text":"本日、経済財政諮問会議を開催し、「予算編成の抜本見直し」の具体化や「AIによる経済･社会の変革を見据えた政策形成」について議論を行いました。\n\nまず、「予算編成の抜本見直し」について、民間議員の皆様から、\n・令和9年度予算編成に当たって、「歳入・歳出両面から財政の全体像」を明らかにすべきこと､\n・｢新規国債発行額｣は、「歳入・歳出両面での取組」を反映した結果として示すとともに､「経費の内訳」も含め､財政運営の実態を的確に説明すべきこと､\n・「長期投資に必要な政府のコミットメント」を損なわないよう留意しつつ、「基金の見直し」や「国庫債務負担行為の活用拡大」を図ること\nなどのご提案をいただきました。\n\n本日の議論を踏まえ、\n・「歳出」に止まらず､「歳入・歳出両面」を総合的に捉え、「財政の全体像」を明らかにするものとして、『令和9年度予算編成の基本方針』の策定を進めます｡\n・その際、『日本成長戦略 実行計画』と連動する形で、「複数年度の財政措置」、「政策の質を高める予算編成の考え方」、「外部の専門的知見の活用」などについて､具体化します。\n・『補正予算』については､｢当初予算中心｣の運営に転換する一方で､災害時や予算編成後の経済・物価情勢等の変化への対応などについての考え方を明確化します。\n・「当初予算中心」の運営を支えるため、内閣府に、「マクロ経済見通し」に基づく分析を行うなど、財務省と緊密に連携し、「税収見積もりの精度向上」に貢献するよう指示しました。\n・財務省に、内閣府との連携を通じて、「見積もりの精度」と「透明性」を高め、その結果を、令和9年度予算編成に反映するよう指示しました。\n\nまた、「AIによる経済･社会の変革を見据えた政策形成」について、民間議員の皆様から、\n・官民でAIを最大限活用した「生産性向上」、\n・「雇用･人材育成への影響」の継続的な把握､\n・AIでの攻撃を前提とした「サイバーセキュリティ強化」､\n・「中長期的な経済･社会の姿」と､それに伴い「必要となる対応」\nなどのご提案をいただきました。\n\n本日の議論を踏まえ、\n・年末までに、「AXが実現した行政･産業･暮らしの姿」などの具体像を示し、『人工知能基本計画』の改定を行います。\n・日本企業へのサイバー攻撃が相次いでいることを踏まえ、国民の皆様への「タイムリーな情報発信」を引き続き行っていきます。\n・AIやロボットの活用など、「必要な労働力」への対応について、「分野横断的な推進体制」を『人口総合戦略』に盛り込んでまいります。\n・｢AIの影響｣を含む中長期的な「経済･社会のあり方｣について検討する体制を整備し､来年の『骨太方針』に反映します。"}}},"rest_id":"2115771158482305432","unmention_data":{},"views":{"count":"363530","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115771158482305432","sortIndex":"2116281523115130737"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"p