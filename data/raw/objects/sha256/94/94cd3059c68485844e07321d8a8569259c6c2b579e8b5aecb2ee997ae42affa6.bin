sults":{"result":{"media_key":"3_2115806005695225856"}},"media_url_https":"https://pbs.twimg.com/media/HVzaWicaIAAGn_I.jpg","original_info":{"focus_rects":[{"h":1310,"w":2339,"x":0,"y":105},{"h":1654,"w":1654,"x":0,"y":0},{"h":1654,"w":1451,"x":0,"y":0},{"h":1654,"w":827,"x":0,"y":0},{"h":1654,"w":2339,"x":0,"y":0}],"height":1654,"width":2339},"sizes":{"large":{"h":1448,"resize":"fit","w":2048},"medium":{"h":849,"resize":"fit","w":1200},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uzcsTFopFz"},{"display_url":"pic.x.com/uzcsTFopFz","expanded_url":"https://x.com/kantei/status/2115810873747046776/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115806027102957568","indices":[0,23],"media_key":"3_2115806027102957568","media_results":{"result":{"media_key":"3_2115806027102957568"}},"media_url_https":"https://pbs.twimg.com/media/HVzaXyMaMAArJG-.png","original_info":{"focus_rects":[{"h":1310,"w":2339,"x":0,"y":0},{"h":1654,"w":1654,"x":167,"y":0},{"h":1654,"w":1451,"x":269,"y":0},{"h":1654,"w":827,"x":581,"y":0},{"h":1654,"w":2339,"x":0,"y":0}],"height":1654,"width":2339},"sizes":{"large":{"h":1448,"resize":"fit","w":2048},"medium":{"h":849,"resize":"fit","w":1200},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uzcsTFopFz"}]},"favorite_count":304,"favorited":false,"full_text":"https://t.co/uzcsTFopFz","id_str":"2115810873747046776","in_reply_to_screen_name":"kantei","in_reply_to_status_id_str":"2115810870999777397","in_reply_to_user_id_str":"412940784","is_quote_status":false,"lang":"zxx","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":22,"retweet_count":54,"retweeted":false,"user_id_str":"412940784"},"rest_id":"2115810873747046776","unmention_data":{},"views":{"count":"41