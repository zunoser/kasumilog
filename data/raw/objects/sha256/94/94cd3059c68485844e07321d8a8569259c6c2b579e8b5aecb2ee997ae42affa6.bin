lse},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3074876,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":606,"tweets":1917},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2115997148970111012"],"editable_until_msecs":"1793331608000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":613,"bookmarked":false,"conversation_id_str":"2115997148970111012","created_at":"Fri Oct 30 02:40:08 +0000 2026","display_text_range":[0,76],"entities":{},"favorite_count":13548,"favorited":false,"full_text":"本日、労働力調査結果が公表されました。\n\n「就業者数」は、6,896万人と、1年前に比べ33万人増加し、比較可能な昭和28年以降で過去最多となりました。","id_str":"2115997148970111012","is_quote_status":false,"lang":"ja","quote_count":900,"reply_count":3796,"retweet_count":1764,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU5OTcxNDg4OTg4MDM3MTI=","richtext":{"richtext_tags":[]},"text":"本日、労働力調査結果が公表されました。\n\n「就業者数」は、6,896万人と、1年前に比べ33万人増加し、比較可能な昭和28年以降で過去最多となりました。\n\n産業別にみると、「医療・福祉」（29万人増）、「サービス業（他に分類されないもの）」（14万人増）、「情報通信業」（8万人増）などが増加しています。\n\n9月の「完全失業率」は、季節調整値で2.4％と、前月に比べ0.1ポイントの低下となっています。\n\nまた、同時に公表された9月の「有効求人倍率」は、季節調整値で1.19倍と、前月を0.01ポイント上回っています。\n\nこうした指標を踏まえ、現在の雇用情勢については、\n・　有効求人倍率はおおむね横ばいで、求人が引き続き求職を上回って推移しており、緩やかに持ち直している\n・　物価上昇・中東情勢等が雇用に与える影響に留意する必要がある\nとしています。\n\nこうした状況を注視しながら、国民の皆様の雇用と生活をしっかりと守っていくため、求職者の方が置かれている状況に応じたきめ細かな就労支援や、事業主の方に対する人材確保支援などに取り組んでまいります。"}}},"rest_id":"2115997148970111012","unmention_data":{},"views":{"count":"1788169","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115997148970111012","sortIndex":"2116281523115130770"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2115994040072347648/xtAPjKud?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2115994040072347648/xtAPjKud?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"官房長官の定例記者会見の様子などをご覧になれます。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.kantei.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2115994040072347648/xtAPjKud?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2115994040072347