size":"crop","w":150}},"type":"photo","url":"https://t.co/l4HMdeX4Gk"}]},"favorite_count":29,"favorited":false,"full_text":"🎥 YouTube配信中『 #放課後ゲンバミッション！』\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「 #ゲンミ！（現場ミッション）」に挑戦✨\n▶️https://t.co/60zkzN5mpk\n\n今回は 庭園や公園を築造・維持管理する「造園業」で活躍する職人さんをリポート！ https://t.co/l4HMdeX4Gk","id_str":"2115958740499550381","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":1,"retweet_count":6,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[14,26],"text":"放課後ゲンバミッション"},{"indices":[71,75],"text":"ゲンミ"},{"indices":[359,369],"text":"国交省建設産業PR"},{"indices":[370,381],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/4leLOtfZjOU","expanded_url":"https://youtu.be/4leLOtfZjOU","indices":[93,116],"url":"https://t.co/GECxUNULfd"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[318,341],"url":"https://t.co/kPJLLRPIOH"}],"user_mentions":[{"id_str":"2100746664126648320","indices":[343,358],"name":"放課後ゲンバミッション","screen_name":"houkago_gennmi"}]},"id":"Tm90ZVR3ZWV0OjIxMTU5NTg3NDAzMzE3MTY2MDk=","richtext":{"richtext_tags":[]},"text":"🎥 YouTube配信中『 #放課後ゲンバミッション！』\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「 #ゲンミ！（現場ミッション）」に挑戦✨\n▶️https://t.co/GECxUNULfd\n\n今回は 庭園や公園を築造・維持管理する「造園業」で活躍する職人さんをリポート！\n実際に庭師さんが最初に学ぶ作業の一つ“下草のお手入れ”に挑戦✂️\n\n性別・年齢にとらわれず、自分らしく活躍できる造園の仕事。 \n知ると、その魅力や見え方が変わるかも👀\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPIOH\n\n@houkago_gennmi\n#国交省建設産業PR\n#MLIT建設産業PR"}}},"rest_id":"2115958740499550381","unmention_data":{},"views":{"count":"6575","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115958740499550381","sortIndex":"2116281523115130748"},{"content":{"__typename":"TimelineTimelineItem","clientE