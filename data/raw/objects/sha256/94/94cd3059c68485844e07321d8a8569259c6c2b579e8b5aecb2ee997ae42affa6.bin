AVTif.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":0,"y":0},{"h":1366,"w":1198,"x":66,"y":0},{"h":1366,"w":683,"x":324,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KUz2EU6l81"}]},"favorite_count":669,"favorited":false,"full_text":"10月29日、小泉防衛大臣は、第13回拡大ASEAN国防相会議（ADMMプラス）に出席し、参加各国の国防大臣などと、地域や国際社会における安全保障上の課題や防衛協力・交流などについて議論しました。小泉大臣からは、国際法に基づく自由で開かれた秩序を守り、対話を通じて問題を解決することや、全ての国 https://t.co/KUz2EU6l81","id_str":"2115774364985765889","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"quoted_status_id_str":"2115740767985737941","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2115740767985737941","url":"https://t.co/uh7D0Ogyux"},"reply_count":17,"retweet_count":112,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3NzQzNjQ5MzEyNDQwMzI=","text":"10月29日、小泉防衛大臣は、第13回拡大ASEAN国防相会議（ADMMプラス）に出席し、参加各国の国防大臣などと、地域や国際社会における安全保障上の課題や防衛協力・交流などについて議論しました。小泉大臣からは、国際法に基づく自由で開かれた秩序を守り、対話を通じて問題を解決することや、全ての国が自らの意思で将来を選択できる地域を築くことの重要性を強調し、各国からも賛同が得られました。"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2115740767985737941"}},"rest_id":"2115774364985765889","unmention_data":{},"views":{"count":"80513","state":"EnabledWithCount"}}},"rest_id":"2115788596435456156","unmention_data":{},"views":{"count":"34773","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2116281523115130839-tweet-2115788613527196127","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesD