75452928/img/kn76lOYoBYu5D_7f.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/oECAVMqALo","video_info":{"aspect_ratio":[16,9],"duration_millis":196533,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2115801478275452928/pl/BZsA4oePLfRMzIkC.m3u8?tag=29&v=082"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115801478275452928/vid/avc1/480x270/6tjMd4BXsS7TQxU4.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115801478275452928/vid/avc1/640x360/fRLQrVgiGKhOmbIM.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115801478275452928/vid/avc1/1280x720/XAIZTEMi_ptK1VOT.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/oECAVMqALo","expanded_url":"https://x.com/kantei/status/2115802577891922023/video/1","ext_media_availability":{"status":"Available"},"id_str":"2115801478275452928","indices":[124,147],"media_key":"13_2115801478275452928","media_results":{"result":{"media_key":"13_2115801478275452928"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2115801478275452928/img/kn76lOYoBYu5D_7f.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/oECAVMqALo","video_info":{"aspect_ratio":[16,9],"duration_millis":196533,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2115801478275452928/pl/BZsA4oePLfRMzIkC.m3u8?tag=29&v=082"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115801478275452928/vid/avc1/480x270/6tjMd4BXsS7TQxU4.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115801478275452928/vid/avc1/640x360/fRLQrVgiGKhOmbIM.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115801478275452928/vid/avc1/1280x720/XAIZTEMi_ptK1VOT.mp4?tag=29"}]}}]},"favorite_count":2258,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２９日）、高市総理は、第１５回経済財政諮問会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございます。\n　本日はまず、「予算編成の抜本見直し」の具体化に向けて、議論を行いました。\n　民間議員の皆様から、 https://t.co/oECAVMqALo","id_str":"2115802577891922023","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":20,"reply_count":119,"retweet_count":343,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU4MDI1Nzc3Nzg3NDEyNDg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２９日）、高市総理は、第１５回経済財政諮問会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございます。\n　本日はまず、「予算編成の抜本見直し」の具体化に向けて、議論を行いました。\n　民間議員の皆様から、\n・令和９年度予算編成に当たって、「歳入・歳出両面から財政の全体像」を明らかにすべきこと、\n・「新規国債発行額」は、「歳入・歳出両面での取組」を反映した結果として示すとともに、「経費の内訳」も含め、 財政運営の実態を的確に説明すべきこと、\n・「長期投資に必要な政府のコミットメント」を損なわないよう留意しつつ、「基金の見直し」や「国庫債務負担行為の活用拡大」を図ること\nなどのご提案をいただきました。\n　本日のご議論も踏まえ、城内大臣は、\n・「歳出」に止まらず、「歳入・歳出両面」を総合的に捉え、「財政の全体像」を明らかにするものとして、『令和９年度予算編成の基本方針』の策定を進めてください。\n・その際、『日本成長戦略実行計画』と連動する形で、「複数年度の財政措置」、「政策の質を高める予算編成の考え方」、「外部の専門的知見の活用」などについて具体化してください。\n・『補正予算』につきましては、「当初予算中心」の運営に転換する一方で、災害時や予算編成後の経済・物価情勢等の変化への対応などについての考え方を明確化してください。\n・「当初予算中心」の運営を支えるため、「マクロ経済見通し」に基づく分析を行うなど、財務省と緊密に連携し、「税収見積もりの精度向上」に貢献してください。\n　片山大臣は、内閣府との連携を通じて、「見積もりの精度」と「透明性」を高め、その結果を、令和９年度予算編成に反映してください。\n　本日、２つ目の議題では、「ＡＩによる経済社会の変革を見据えた政策形成」について、議論をしました。\n　民間議員の皆様からは、\n・官民でＡＩを最大限活用した「生産性向上」、\n・「雇用、人材育成への影響」の継続的な把握、\n・ＡＩでの攻撃を前提とした「サイバーセキュリティ強化」、\n・「中長期的な経済・社会の姿」と、それに伴い「必要となる対応」\nなどのご提案をいただきました。\n　本日の議論も踏まえ、古川大臣は、\n・年末までに「ＡＸが実現した行政・産業・暮らしの姿」などの具体像を示し、『人工知能基本計画』の改定を行って下さい。\n・日本企業へのサイバー攻撃が相次いでいることを踏まえ、国民の皆様への「タイムリーな情報発信」をお願いします。\n　城内大臣は、\n・ＡＩやロボットの活用など、「必要な労働力」への対応について、「分野横断的な推進体制」を『人口総合戦略』に盛り込んで下さい。\n・「ＡＩの影響」を含む中長期的な「経済・社会のあり方」について検討する体制を整備し、来年の『骨太方針』に反映して下さい。\n　以上です。"}}},"rest_id":"2115802577891922023","unmention_data":{},"views":{"count":"61767","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115802577891922023","sortIndex":"2116281523115130741"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","enti