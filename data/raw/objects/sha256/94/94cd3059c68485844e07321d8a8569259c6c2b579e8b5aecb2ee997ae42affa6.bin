ount":45,"favorited":false,"full_text":"宮本副大臣は、10/26に工作機械の世界三大見本市である「JIMTOF2026」の開会式に出席。挨拶では、JIMTOF及び工作機械業界への期待と、ものづくりのAX推進への決意を述べました。その後、会場を視察し、AIを活用した最先端の技術に触れるとともに、出展各社の担当者から開発の状況や今後の展望について https://t.co/IAArvgVAA1","id_str":"2115750261847478367","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":2,"retweet_count":15,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3NTAyNjE4MDEzMzY4MzM=","richtext":{"richtext_tags":[]},"text":"宮本副大臣は、10/26に工作機械の世界三大見本市である「JIMTOF2026」の開会式に出席。挨拶では、JIMTOF及び工作機械業界への期待と、ものづくりのAX推進への決意を述べました。その後、会場を視察し、AIを活用した最先端の技術に触れるとともに、出展各社の担当者から開発の状況や今後の展望について説明を受けました。"}}},"rest_id":"2115750261847478367","unmention_data":{},"views":{"count":"8410","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2116281523115130847-tweet-2115750265219686471","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true}