2093268111583805440","indices":[98,121],"media_key":"3_2093268111583805440","media_results":{"result":{"media_key":"3_2093268111583805440"}},"media_url_https":"https://pbs.twimg.com/media/HQzIQcKbAAAePZw.jpg","original_info":{"focus_rects":[{"h":868,"w":1550,"x":0,"y":0},{"h":1033,"w":1033,"x":452,"y":0},{"h":1033,"w":906,"x":515,"y":0},{"h":1033,"w":517,"x":710,"y":0},{"h":1033,"w":1550,"x":0,"y":0}],"height":1033,"width":1550},"sizes":{"large":{"h":1033,"resize":"fit","w":1550},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/lqGY6HNJ76"}]},"favorite_count":4126,"favorited":false,"full_text":"政府は、インドネシアのカリマンタン島などで深刻な被害が生じている山林火災に対し、インドネシア共和国政府からの支援要請を受け、国際緊急援助活動として自衛隊機による消火活動支援の実施を決定しました。 https://t.co/lqGY6HNJ76","id_str":"2093268122593829179","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":82,"reply_count":99,"retweet_count":938,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/press/news/2…","expanded_url":"https://www.mod.go.jp/j/press/news/2026/08/28h.html","indices":[179,202],"url":"https://t.co/LmrtoCjk96"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTMyNjgxMjI0NzYzNjM3NzY=","text":"政府は、インドネシアのカリマンタン島などで深刻な被害が生じている山林火災に対し、インドネシア共和国政府からの支援要請を受け、国際緊急援助活動として自衛隊機による消火活動支援の実施を決定しました。\n\n準備が整い次第、できるだけ速やかに、陸自CH-47輸送ヘリ3機を搭載した海自輸送艦「くにさき」を、インドネシアに向けて出発させる予定です。\n（写真はイメージ）\nhttps://t.co/LmrtoCjk96"}}},"rest_id":"2093268122593829179","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"280646","state":"EnabledWithCount"}}},"rest_id":"2093966642627883275","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data"