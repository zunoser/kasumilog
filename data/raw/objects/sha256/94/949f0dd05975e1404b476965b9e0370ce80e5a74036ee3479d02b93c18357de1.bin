ects":[{"h":472,"w":842,"x":0,"y":79},{"h":638,"w":638,"x":204,"y":0},{"h":638,"w":560,"x":282,"y":0},{"h":638,"w":319,"x":493,"y":0},{"h":638,"w":842,"x":0,"y":0}],"height":638,"width":842},"sizes":{"large":{"h":638,"resize":"fit","w":842},"medium":{"h":638,"resize":"fit","w":842},"small":{"h":515,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/O4Y6to1Tok"}]},"favorite_count":209,"favorited":false,"full_text":"【実地疫学専門家(FETP)の活動】\n災害時は、感染症の拡大リスクが高まります。#令和8年熊本地震 では避難所等での新型コロナウイルス感染症の発生も認められました。\n\nFETPは避難所等における感染症の発生動向や衛生環境を評価し、感染症の発生やまん延の防止に向けて専門的な知見を提供しています。 https://t.co/O4Y6to1Tok","id_str":"2093275926763323684","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":31,"retweet_count":70,"retweeted":false,"user_id_str":"180585090"},"rest_id":"2093275926763323684","source":"<a href=\"https://social.userlocal.jp/\" rel=\"nofollow\">Userlocal SocialInsight</a>","unmention_data":{},"views":{"count":"62579","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093275926763323684","sortIndex":"2094046129887903702"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"