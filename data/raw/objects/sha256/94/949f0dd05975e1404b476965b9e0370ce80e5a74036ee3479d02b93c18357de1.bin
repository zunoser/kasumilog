a":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"regular"},"relationship_counts":{"followers":68831519,"following":1142},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"10228272","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":16185,"tweets":61423},"verification":{"verified":false,"verified_type":"Business"},"website":{"url":"https://t.co/GIOK0JwagA"}}}]},"rest_id":"https://t.co/Doqd3PhjN9"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39570,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":76,"tweets":310},"verification":{"verified":false},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2093292740436193677"],"editable_until_msecs":"1787918455000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":9,"bookmarked":false,"conversation_id_str":"2093292740436193677","created_at":"Fri Aug 28 11:00:55 +0000 2026","display_text_range":[0,112],"entities":{},"favorite_count":566,"favorited":false,"full_text":"【8月28日　小泉防衛大臣臨時会見】\n石川県・富山県大雨特別警報、ネパール中部及び中国チベット自治区で発生した大規模洪水、インドネシア共和国における国際緊急援助活動に伴い、臨時会見を行いました。\n \n↓発表事項の全文はこちら","id_str":"2093292740436193677","is_quote_status":false,"lang":"ja","quote_count":5,"reply_count":16,"retweet_count":104,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/dITzlIuUi4M?si…","expanded_url":"https://youtu.be/dITzlIuUi4M?si=0sQC4UNRXSDjpYnY","indices":[1062,1085],"url":"https://t.co/Doqd3PhjN9"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTMyOTI3NDAyNDc1Mzk3MTI=","text":"【8月28日　小泉防衛大臣臨時会見】\n石川県・富山県大雨特別警報、ネパール中部及び中国チベット自治区で発生した大規模洪水、インドネシア共和国における国際緊急援助活動に伴い、臨時会見を行いました。\n \n↓発表事項の全文はこちら\n「こちらから３点災害関連で御報告があります。まず１点目ですが、国内では、石川県と富山県で記録的な大雨となりました。自衛隊は、速やかに各地の部隊が情報収集態勢を強化し、石川県庁、富山県庁、そして、孤立地域が発生しているとの情報があった氷見市役所に連絡員を派遣するなど、自治体と緊密に連携しております。現時点で災害派遣要請はありませんが、今朝、氷見市において被害状況を確認するための情報収集を行うなど、必要な対応を実施しております。\n \nそして、２点目になりますが、ネパール中部及び中国チベット自治区で大規模洪水が発生しています。犠牲となられた方々に謹んで哀悼の意を表するとともに、被災された皆様に心から御見舞いを申し上げます。行方不明となっている方々の一刻も早い救助・発見を願っています。また、邦人が行方不明となっているとの情報もあり、政府として情報収集に全力で取り組んでいるところ、必要な対応を急ぎ進めているところです。防衛省・自衛隊としても、関係機関と連携しつつ、引き続き、周辺国の防衛駐在官を通じて情報収集を行うとともに、必要な待機態勢を維持してまいります。\n \nそして最後に、現在、インドネシアで大規模な山林火災が発生し、深刻な被害が生じています。インドネシアとの間では、今年５月に、シャフリィ国防大臣と私との間で防衛協力取決め（ＤＣＡ）に署名し、災害救援分野における協力を拡大することとしました。このＤＣＡを踏まえ、今回、シャフリィ国防大臣から自衛隊による協力を検討して欲しいとの連絡がありました。その後、インドネシア政府からの正式な依頼があり、日本政府内で検討・調整を進めた結果、本日、外務大臣から国際緊急援助活動の実施について協議を受けました。私から、この協議に対し同意する旨の回答を行うとともに、統合作戦司令官にその実施を命じたところです。準備が整い次第、陸上自衛隊のＣＨ－４７輸送ヘリコプター３機を搭載した海上自衛隊輸送艦「くにさき」をインドネシアに向けて出発させ、現地で消火活動を実施する予定です。防衛省・自衛隊としては、本活動を通じて、被災されたインドネシアの人々のために、また、被害の拡大防止に向けて、全力で取り組んでまいります。３点は以上となります。」\n \n↓動画はこちら\nhttps://t.co/Doqd3PhjN9"}}},"rest_id":"2093292740436193677","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"43017","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2093293200077389991","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"5228","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093293200077389991","sortIndex":"2094046129887903715"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1595652744500908032/vw4r2sfI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/242156036/1412822664"},"core":{"created_at":"Mon Jan 24 02:43:14 +0000 2011","name":"文部科学省　MEXT","screen_name":"mextjapan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_acc