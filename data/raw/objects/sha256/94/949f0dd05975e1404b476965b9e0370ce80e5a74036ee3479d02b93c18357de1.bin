通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":382865,"following":477},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"571429134","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7917,"tweets":88236},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/yYaoVyKjKO"}}}},"edit_control":{"edit_tweet_ids":["2093801508299239527"],"editable_until_msecs":"1788039755000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2093801508299239527","created_at":"Sat Aug 29 20:42:35 +0000 2026","display_text_range":[0,130],"entities":{},"favorite_count":98,"favorited":false,"full_text":"令和8年8月29日からの大雨について、大臣指示を行いました。\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、被害が発生した場合は、人命第一の方針の下、災害応急対策に全力で取り組むこと。","id_str":"2093801508299239527","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":5,"retweet_count":35,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTM4MDE1MDgyNjE1MzE2NDg=","richtext":{"richtext_tags":[]},"text":"令和8年8月29日からの大雨について、大臣指示を行いました。\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、被害が発生した場合は、人命第一の方針の下、災害応急対策に全力で取り組むこと。\n\n２．地方自治体とのホットライン等を通じて情報を収集\nし、要請に応じて迅速に地方自治体への支援等を実施すること。"}}},"rest_id":"2093801508299239527","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"33741","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093801508299239527","sortIndex":"2094046129887903730"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/KR6AEk--_U4","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2093788009347092480/li5_lChR?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":158,"url":"https://pbs.twimg.com/card_img/2093788009347092480/li5_lChR?format=jpg&name=280x280","width":280},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66794","type":"STRING"}},{"key":"description","value":{"string_value":"「福井県にレベル５大雨特別警報発表」の緊急会見映像です。＃気象庁　＃緊急記者会見","type":"STRING"}},{"key":"player_width","value":{"string_value":"480","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"10228272","path":[]}}},{"key":"player_image_original","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2093788009347092480/li5_lChR?format=jpg&name=orig","width":1280},"type":"IMAGE"}},{"key":"ap