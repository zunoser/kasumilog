y":"3_2093990096202829824","media_results":{"result":{"media_key":"3_2093990096202829824"}},"media_url_https":"https://pbs.twimg.com/media/HQ9Y5edbEAAbH4j.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":92},{"h":1888,"w":1888,"x":0,"y":0},{"h":1888,"w":1656,"x":0,"y":0},{"h":1888,"w":944,"x":0,"y":0},{"h":1888,"w":2048,"x":0,"y":0}],"height":1888,"width":2048},"sizes":{"large":{"h":1888,"resize":"fit","w":2048},"medium":{"h":1106,"resize":"fit","w":1200},"small":{"h":627,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/n4AIekwEhi"}]},"favorite_count":569,"favorited":false,"full_text":"8月30日、若林防衛大臣政務官は、海上自衛隊佐世保地区を訪問し、トマホーク発射能力獲得のためアメリカに派遣されていた護衛艦「ちょうかい」の帰国行事に出席し、隊員の労をねぎらいました。\nまた、佐世保地方総監部を視察し、令和8年熊本地震への対応を含む活動状況について報告を受けました。 https://t.co/n4AIekwEhi","id_str":"2093990108051669415","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":7,"retweet_count":98,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[211,217],"text":"ちょうかい"},{"indices":[218,224],"text":"トマホーク"},{"indices":[225,231],"text":"佐世保基地"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTM5OTAxMDc5OTMwMTgzNjg=","text":"8月30日、若林防衛大臣政務官は、海上自衛隊佐世保地区を訪問し、トマホーク発射能力獲得のためアメリカに派遣されていた護衛艦「ちょうかい」の帰国行事に出席し、隊員の労をねぎらいました。\nまた、佐世保地方総監部を視察し、令和8年熊本地震への対応を含む活動状況について報告を受けました。\n \n護衛艦「ちょうかい」は、令和7年9月から約1年間にわたりアメリカに派遣されており、本年7月にはトマホークの実射試験を実施しました。\n \n#ちょうかい #トマホーク #佐世保基地"}}},"rest_id":"2093990108051669415","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"35786","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093990108051669415","sortIndex":"2094046129887903741"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2990242,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":523,"tweets":1743},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2093973761758564529"],"editable_until_msecs":"1788080823000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":456,"bookmarked":false,"conversation_id_str":"2093973761758564529","created_at":"Sun Aug 30 08:07:03 +0000 2026","display_text_range":[0,64],"entities":{},"favorite_count":31579,"favorited":false,"full_text":"先日、知人から「ペルシャ湾内に取り残されている日本人船員の命や健康は大丈夫なのですか？長期間になって気の毒です」と言われました。","id_str":"2093973761758564529","is_quote_status":false,"lang":"ja","quote_count":418,"reply_count":1010,"retweet_count":3915,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTM5NzM3NjE3MDM5NDgyODk=","richtext":{"richtext_tags":[]},"text":"先日、知人から「ペルシャ湾内に取り残されている日本人船員の命や健康は大丈夫なのですか？長期間になって気の毒です」と言われました。\n\nこれまでは、乗組員の方々のプライバシーにも配慮して、特に私から国民の皆様にタイムリーに報告を申し上げる事はしていなかったのですが、知人の話を聞いて、報道等を細かくフォローしておられない方もおられる事に気付かせていただきましたので、現状を書いておきます。\n\nホルムズ海峡が事実上閉鎖された時点では、日本関係船舶45隻（うち日本籍船は5隻）、日本人乗組員24人がペルシャ湾内に滞留されていました。\n\n私自身と茂木外務大臣、日本政府職員が、イランや関係国のカウンターパートへの働きかけを続けるなど最大限の努力した結果、6月19日までに全ての日本人乗組員、7月9日までに全ての日本籍船は無事にペルシャ湾から出ています。\n\n船の故障など様々な事情から、まだ3隻の日本関係船舶（他国籍船）がペルシャ湾内に残っていますが、外国人乗組員の方々の安全と健康は確認できています。\n\n全ての国の船舶について、ホルムズ海峡における自由で安全な航行を確保するべく、日本政府として、これからも最大限の努力を続けてまいります。"}}},"rest_id":"2093973761758564529","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1916889","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093973761758564529","sortIndex":"2094046129887903740"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"ent