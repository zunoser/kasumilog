id":"Tm90ZVR3ZWV0OjIwOTMyODUxOTgxNjMzMjQ5Mjg=","richtext":{"richtext_tags":[]},"text":"令和8年熊本地震の影響により、JR九州鹿児島本線（宇土～八代間）で運休が発生しています。\nJR九州では、宇土～八代間で実施している代行バス輸送について、新学期に対応するため9/1より運行本数の増便および一部の便の時刻変更を実施します。\nなお、JR九州では、利用状況や利用者の皆様からのご要望を踏まえ、バス事業者の協力のもと、必要に応じて代行バスの運行ダイヤの見直しを行うこととしております。詳細はJR九州のHPをご確認ください。\n\n▼JR九州\nhttps://t.co/SOfn4Ugt5f"}}},"rest_id":"2093285198217842855","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"12359","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093285198217842855","sortIndex":"2094046129887903708"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2091863190011621376/6E1ibs0j?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":147,"url":"https://pbs.twimg.com/card_img/2091863190011621376/6E1ibs0j?format=jpg&name=280x150","width":280},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mext.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":314,"url":"https://pbs.twimg.com/card_img/2091863190011621376/6E1ibs0j?format=jpg&name=600x600","width":600},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2091863190011621376/6E1ibs0j?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":670,"url":"https://pbs.twimg.com/card_img/2091863190011621376/6E1ibs0j?