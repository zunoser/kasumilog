,"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMDIyODI3Mg==","is_blue_verified":true,"location":{"location":"San Bruno, CA"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2064694071537352925"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"like & subscribe","entities":{"description":{},"url":{"urls":[{"display_url":"youtube.com","expanded_url":"http://youtube.com/","indices":[0,23],"url":"https://t.co/GIOK0JwagA"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"regular"},"relationship_counts":{"followers":68831519,"following":1142},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"10228272","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":16185,"tweets":61423},"verification":{"verified":false,"verified_type":"Business"},"website":{"url":"https://t.co/GIOK0JwagA"}}}]},"rest_id":"https://t.co/B5HnrY7xrK"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1153541724804792320/1IxAaRLZ_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Tue Dec 09 09:21:37 +0000 2014","name":"気象庁","screen_name":"JMA_kishou"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTIzNjU4MDEy","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"気象庁 (JMA:Japan Meteorological Agency) 公式アカウントです。報道発表やイベント案内などをお届けします。\n警報などの防災気象情報は気象庁ホームページをご覧ください。\n※運用ポリシー：https://t.co/v07vjnVmr5","entities":{"description":{"urls":[{"display_url":"jma.go.jp/jma/menu/socia…","expanded_url":"https://www.jma.go.jp/jma/menu/social_info.html","indices":[108,131],"url":"https://t.co/v07vjnVmr5"}]},"url":{"urls":[{"display_url":"jma.go.jp/jma/index.html","expanded_url":"https://www.jma.go.jp/jma/index.html","indices":[0,23],"url":"https://t.co/3abXj9G0Rj"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":788240,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2923658012","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":618,"tweets":3257},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/3abXj9G0Rj"}}}},"edit_control":{"edit_tweet_ids":["2093790493163630631"],"editable_until_msecs":"1788037128000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":16,"bookmarked":false,"conversation_id_str":"2093790493163630631","created_at":"Sat Aug 29 19:58:48 +0000 2026","display_text_range":[0,96],"entities":{"urls":[{"display_url":"youtube.com/live/KR6AEk--_…","expanded_url":"https://youtube.com/live/KR6AEk--_U4?feature=share","indices":[73,96],"url":"https://t.co/B5HnrY7xrK"}]},"favorite_count":297,"favorited":false,"full_text":"福井県にレベル５大雨特別警報を発表したことについて、本日（8月30日）5:30より記者会見を行います。\n会見は以下のURLからご覧いただけます。\nhttps://t.co/B5HnrY7xrK","id_str":"2093790493163630631","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":16,"reply_count":5,"retweet_count":237,"retweeted":false,"user_id_str":"2923658012"},"rest_id":"2093790493163630631","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"99728","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093790493163630631","sortIndex":"2094046129887903729"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2990242,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":523,"tweets":1743},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2093788685632475321"],"editable_until_msecs":"1788036698000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":190,"bookmarked":false,"conversation_id_str":"2093788685632475321","created_at":"Sat Aug 29 19:51:38 +0000 2026","display_text_range":[0,118],"entities":{},"favorite_count":18579,"favorited":false,"full_text":"現在、福井県福井市、大野市、勝山市にレベル５大雨特別警報が発表されています。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、命の危険が迫っています。\n\n地方自治体の指示に従い、直ちに身の安全を確保してください。","id_str":"2093788685632475321","is_quote_status":false,"lang":"ja","quote_count":380,"reply_count":1140,"retweet_count":2737,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTM3ODg2ODU1NzM3MTgwMTY=","richtext":{"richtext_tags":[]},"text":"現在、福井県福井市、大野市、勝山市にレベル５大雨特別警報が発表されています。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、命の危険が迫っています。\n\n地方自治体の指示に従い、直ちに身の安全を確保してください。\n\n避難所までの移動がかえって危険な場合は、無理をせず、崖から離れた場所や浸水しにくい高い場所など、今いる場所よりも少しでも安全な空間に移動するなど、命を守る行動を最優先してください。\n\nまた、レベル５大雨特別警報が発表されていない周辺地域の皆様も、これから大雨による災害のおそれがあります。\n\n不要不急の外出を控えるとともに、地方自治体の避難情報のほか、テレビ・ラジオ・インターネットなどの最新の防災気象情報に十分注意し、少しでも危険を感じた場合など、空振りをおそれず、自らの判断で主体的に早めに避難するなど、早め早めに自らの命を守る行動をとっていただくようお願いします。\n\n政府としては、レベル５大雨特別警報の発表を受け、「官邸危機管理センター」に設置していた「官邸連絡室」において、地方自治体とも連携し、被害状況の把握、国民の皆様に対する情報提供、被害が発生した場合の救命・救助などの対応に当たっています。"}}},"rest_id":"2093788685632475321","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1678808","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093788685632475321","sortIndex":"2094046129887903728"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2990242,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":523,"tweets":1743},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2093682208976535682"],"editable_until_msecs":"1788011312000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":205,"bookmarked":false,"conversation_id_str":"2093682208976535682","created_at":"Sat Aug 29 12:48:32 +0000 2026","display_text_range":[0,108],"entities":{},"favorite_count":20883,"favorited":false,"full_text":"ネパールの甚大な洪水被害に関して、犠牲になられた方々に改めて哀悼の誠を捧げるとともに、被害に遭われた皆様に対して心からお見舞いを申し上げます。\n\n8月26日の発災以降、ネパール政府により捜索・救出作業が進んでいます。","id_str":"2093682208976535682","is_quote_status":false,"lang":"ja","quote_count":205,"reply_count":776,"retweet_count":1870,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTM2ODIyMDg3NTg1MzgyNDA=","richtext":{"richtext_tags":[]},"text":"ネパールの甚大な洪水被害に関して、犠牲になられた方々に改めて哀悼の誠を捧げるとともに、被害に遭われた皆様に対して心からお見舞いを申し上げます。\n\n8月26日の発災以降、ネパール政府により捜索・救出作業が進んでいます。\n連絡が取れていない邦人5名の捜索についても、ネパール政府に最大限の努力を依頼するとともに、日本政府としても全力で安否確認にあたっています。\n行方不明者が無事に救出されますようにと、お祈りしています。\n\nまた、日本政府は、ネパール国政府からの要請を受け、緊急援助物資(テント、毛布等)を供与することを決定しました。\n人道的観点及びネパールとの友好関係に鑑み、被災者の方々を支援すべく、我が国が海外に備蓄している援助物資を活用して緊急援助を行うこととしたものです。\n今後も、同国のニーズに応じて必要な支援を検討してまいります。\n\n日本はネパールと共にあります。\n\nIn response to the devastating damage caused by the flash flood in Nepal, I once again offer my heartfelt condolences to those who lost their lives and extend my deepest sympathies to all those affected by the disaster.\n\nSince the disaster struck on 26 August, search and rescue operations have been underway under the leadership of the Government of Nepal.\nThe Government of Japan has requested the Government of Nepal to make full efforts in the search for 5 Japanese nationals with whom contact has been lost while also continuing its utmost effort to confirm their safety.\nI sincerely pray for the safety of those who remain missing.\n\nThe Government of Japan has also decided, upon the request of the Government of Nepal, to provide emergency relief goods (tents, blankets, etc.) to Nepal, based on humanitarian considerations and in light of the friendly relations between the two countries.\nThis emergency assistance utilizes relief goods stored overseas to support the people affected by the flash flood.\nThe Government of Japan will continue to consider providing necessary support in accordance with the needs of Nepal.\n\nJapan stands with Nepal.\n\nपालमा आएको विनाशकारी बाढीमा परी ज्यान गुमाउनेहरूप्रति म फेरि एकपटक हार्दिक समवेदना व्यक्त गर्दछु र विपत्तिबाट प्रभावित सबैप्रति गहिरो सहानुभूति व्यक्त गर्दछु।\nअगस्ट २६ तारिखमा विपत्ति आएदेखि, नेपाल सरकारको नेतृत्वमा खोज तथा उद्धार कार्यहरू भइरहेका छन्। सम्पर्कविहीन भएका पाँच जापानी नागरिकहरूको खोजीमा हामीले नेपाल सरकारको अधिकतम प्रयासको लागि अनुरोध गर्नुका साथै, ती पाँच जापानी नागरिकहरूको सुरक्षा पुष्टि गर्न जापान सरकारको निरन्तर कोशिश जारी छ।\nसम्पर्कविहीन भएका व्यक्तिहरूको सुरक्षित उद्दारका लागि हृदयदेखि प्रार्थना गर्दछु।\n\nयसका साथै, नेपाल सरकारको अनुरोधमा जापान सरकारले नेपाललाई आपतकालीन राहत सामग्री (पाल, कम्बल, आदि) प्रदान गर्ने निर्णय गरेको छ। मानवीय दृष्टिकोणबाट तथा जापान र नेपालबीचको मैत्रीपूर्ण सम्बन्धलाई ध्यानमा राख्दै, बाढीबाट प्रभावित व्यक्तिहरूलाई सहयोग गर्न विदेशमा सञ्चित राहत सामग्रीको उपयोग गरी आपतकालीन सहायता प्रदान गर्ने निर्णय गरेका छौं । नेपालको आवश्यकता अनुसार आवश्यक सहयोग प्रदान गर्ने विषयमा जापान सरकारले निरन्तर विचार गरिरहनेछ।\n\nजापान नेपालको साथमा छ।"}}},"rest_id":"2093682208976535682","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1021520","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093682208976535682","sortIndex":"2094046129887903727"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2092739028756160513/uhqTF0o0?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2092739028756160513/uhqTF0o0?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2092739028756160513/uhqTF0o0?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2092739028756160513/uhqTF0o0?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2092739028756160513/uhqTF0o0?format=png&name=2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"vanity_url","v