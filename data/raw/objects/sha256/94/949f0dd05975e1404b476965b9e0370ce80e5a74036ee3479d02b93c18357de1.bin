","indices":[207,230],"url":"https://t.co/z0cyTYeK7V"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTM1ODM2MzIzMzAwMzkyOTY=","richtext":{"richtext_tags":[]},"text":"茂木外務大臣は、トルクメニスタン訪問に際し、「信頼と互恵に基づく日本とトルクメニスタンの絆」と題して、中立トルクメニスタン紙及びトルクメニスタン紙に寄稿しました。1992年の外交関係樹立以降、よき友人として様々な分野で関係を発展させてきたトルクメニスタンとの間で、互恵的な経済協力や、「中央アジア＋日本」対話（CA+JAD）を通じた地域協力を推進し、二国間関係を更に高いレベルに引き上げていく決意を示しました。\n\nhttps://t.co/z0cyTYeK7V"}}},"rest_id":"2093583632447467564","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"18667","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093583632447467564","sortIndex":"2094046129887903726"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092435069474607112"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"descripti