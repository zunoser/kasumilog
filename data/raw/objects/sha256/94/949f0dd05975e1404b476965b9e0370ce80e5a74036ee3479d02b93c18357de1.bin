unt":262,"favorited":false,"full_text":"茂木外務大臣の記者会見が行われ、ネパール・中国における洪水被害、トルクメニスタン、スロバキア、オーストリア及びモンゴル訪問に関する冒頭発言を行った他、ネパール・中国における洪水被害、イラン情勢、米国による国際刑事裁判所（ＩＣＣ）赤根所長への制裁、包括的核実験禁止条約（ＣＴＢＴ）、","id_str":"2093271582466822355","is_quote_status":false,"lang":"ja","quote_count":3,"reply_count":11,"retweet_count":64,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/XjDJ40U60gE","expanded_url":"https://youtu.be/XjDJ40U60gE","indices":[190,213],"url":"https://t.co/z6XDrBhsU2"},{"display_url":"mofa.go.jp/mofaj/press/ka…","expanded_url":"https://www.mofa.go.jp/mofaj/press/kaiken/kaikenw_000001_00250.html","indices":[233,256],"url":"https://t.co/mLw7upOWLl"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTMyNzE1ODIzNDUyNDA1NzY=","richtext":{"richtext_tags":[]},"text":"茂木外務大臣の記者会見が行われ、ネパール・中国における洪水被害、トルクメニスタン、スロバキア、オーストリア及びモンゴル訪問に関する冒頭発言を行った他、ネパール・中国における洪水被害、イラン情勢、米国による国際刑事裁判所（ＩＣＣ）赤根所長への制裁、包括的核実験禁止条約（ＣＴＢＴ）、サウジアラビア・オマーンに対する危険情報、中国における邦人の拘束事案に関する質疑応答を行いました。\nhttps://t.co/z6XDrBhsU2\n\n会見記録はこちらをご確認ください。\nhttps://t.co/mLw7upOWLl"}}},"rest_id":"2093271582466822355","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"29431","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093271582466822355","sortIndex":"2094046129887903695"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":99},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/530187236663250944/sN73nkH6_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Thu Nov 06 01:42:29 +0000 2014","name":"警察庁","screen_name":"NPA_KOHO"},"dm_permissions":{"can_dm":true},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODkxNTE2ODA5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2-1-2"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2091691969994985599"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"警察庁公式アカウントです。\n\n発信する情報は「報道発表資料」「新着情報」を基本としています。当アカウントは発信専用のため警察庁からの返信等は行っておりません。ご利用にあたっては「警察庁X（旧：Twitter）運用ポリシー」https://t.co/i1GUZVK3RZをご覧ください。","entities":{"description":{"urls":[{"display_url":"npa.go.jp/twitter/policy…","expanded_url":"https://www.npa.go.jp/twitter/policy.html","indices":[111,134],"url":"https://t.co/i1GUZVK3RZ"}]},"url":{"urls":[{"display_url":"npa.go.jp","expanded_url":"http://www.npa.go.jp/","indices":[0,23],"url":"https://t.co/nXofBu7sEB"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":319705,"following":3},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2891516809","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1848,"tweets":5876},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/nXofBu7sEB"}}}},"edit_control":{"edit_tweet_ids":["2093270162149634254"],"editable_until_msecs":"1787913072392","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_ava