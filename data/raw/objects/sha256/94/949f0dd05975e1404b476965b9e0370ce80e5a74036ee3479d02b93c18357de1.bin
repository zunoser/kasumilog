7,130],"url":"https://t.co/bcInB2ld5A"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/G1keIv8LjM","expanded_url":"https://x.com/mextjapan/status/2093272602630623471/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":59,"w":59,"x":266,"y":189},{"h":57,"w":57,"x":404,"y":225},{"h":64,"w":64,"x":557,"y":169},{"h":72,"w":72,"x":847,"y":169},{"h":64,"w":64,"x":701,"y":198},{"h":70,"w":70,"x":130,"y":176},{"h":76,"w":76,"x":1023,"y":183}]},"medium":{"faces":[{"h":59,"w":59,"x":266,"y":189},{"h":57,"w":57,"x":404,"y":225},{"h":64,"w":64,"x":557,"y":169},{"h":72,"w":72,"x":847,"y":169},{"h":64,"w":64,"x":701,"y":198},{"h":70,"w":70,"x":130,"y":176},{"h":76,"w":76,"x":1023,"y":183}]},"orig":{"faces":[{"h":59,"w":59,"x":266,"y":189},{"h":57,"w":57,"x":404,"y":225},{"h":64,"w":64,"x":557,"y":169},{"h":72,"w":72,"x":847,"y":169},{"h":64,"w":64,"x":701,"y":198},{"h":70,"w":70,"x":130,"y":176},{"h":76,"w":76,"x":1023,"y":183}]},"small":{"faces":[{"h":33,"w":33,"x":150,"y":107},{"h":32,"w":32,"x":228,"y":127},{"h":36,"w":36,"x":315,"y":95},{"h":40,"w":40,"x":479,"y":95},{"h":36,"w":36,"x":397,"y":112},{"h":39,"w":39,"x":73,"y":99},{"h":43,"w":43,"x":579,"y":103}]}},"id_str":"2093272594925633537","indices":[147,170],"media_key":"3_2093272594925633537","media_results":{"result":{"media_key":"3_2093272594925633537"}},"media_url_https":"https://pbs.twimg.com/media/HQzMVZ6aQAEv7f4.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":800,"w":800,"x":230,"y":0},{"h":800,"w":702,"x":279,"y":0},{"h":800,"w":400,"x":430,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/G1keIv8LjM"}]},"favorite_count":16,"favorited":false,"full_text":"🆕松本大臣は、全国連合小学校長会・全日本中学校長会、熊本県小学校長会・熊本県中学校長会から令和8年熊本地震に伴う学校教育活動の継続及び施設復旧等に関する要望を受け、復興支援に全力を尽くすと伝えました。（8/28）\nhttps://t.co/bcInB2ld5A\n\n#文部科学省　#今日の出来事 https://t.co/G1keIv8LjM","id_str":"2093272602630623471","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":4,"retweeted":false,"user_id_str":"242156036"},"rest_id":"2093272602630623471","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"11653","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093272602630623471","sortIndex":"2094046129887903697"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp