80,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xfxK7G8oG7"}]},"favorite_count":2070,"favorited":false,"full_text":"【八代港での給水支援を本日で終了しました】 https://t.co/xfxK7G8oG7","id_str":"2093247424143950127","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":13,"reply_count":32,"retweet_count":349,"retweeted":false,"user_id_str":"1750343228828844032"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[571,576],"text":"熊本地震"},{"indices":[577,583],"text":"国土交通省"},{"indices":[584,588],"text":"八代港"},{"indices":[589,594],"text":"給水支援"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"city.yatsushiro.lg.jp/kinkyu.html","expanded_url":"https://city.yatsushiro.lg.jp/kinkyu.html","indices":[192,215],"url":"https://t.co/j26GXz2d1X"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTMyNDc0MjM5NzIwNjUyODE=","richtext":{"richtext_tags":[]},"text":"【八代港での給水支援を本日で終了しました】\nこれまで九州地方整備局が所有する船舶「海輝（かいき）」「海煌（かいこう）」から給水を行ってきましたが、8月25日に八代市水道局が水道水を供給している地域の断水が解消されたことから、今後は両船舶の本来の業務である、有明海及び八代海の環境整備等を実施してまいります。\nなお、八代市においては、以下URLの通り引き続き応急給水を行っております。\nhttps://t.co/j26GXz2d1X\n\n7/31から、延べ1,769名の方々にお越しいただき、80,100Lの給水を実施させていただきました。\n一昨日には最高気温39.2℃となるなど記録的猛暑の中でしたが、船員とTEC-FORCE隊員が一致団結し、一人の体調不良者も出すことなく無事に任務を終えました。\nまた、ドライブスルー方式が助かった、職員が気さくでありがたかったなどの感謝の言葉も多数いただき、時にはかき氷の差し入れをいただくなど職員側の方が励まされることも多くありました。\n\n被災された皆さまに心よりお見舞い申し上げますとともに、一日も早い復旧・復興と、安寧な日々が戻りますことをお祈り申し上げます。\n九州地方整備局港湾空港部は、引き続き、物流拠点として地域経済を動かすための港湾利用の本格化に向け、港湾施設の早期復旧を進めてまいります。\n#熊本地震 #国土交通省 #八代港 #給水支援"}}},"rest_id":"2093247424143950127","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"37376","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2093252856631705738","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"739","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093252856631705738","sortIndex":"2094046129887903680"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092927185678127486"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"農林水産省の公式アカウントです。ご意見・ご質問は、総合窓口にお寄せください。\n総合窓口→https://t.co/XLQwxIPiHh\n運用方針→https://t.co/2SnzXCNurZ","entities":{"description":{"urls":[{"display_url":"contactus.maff.go.jp/voice/sogo.html","expanded_url":"https://www.contactus.maff.go.jp/voice/sogo.html","indices":[44,67],"url":"https://t.co/XLQwxIPiHh"},{"display_url":"maff.go.jp/j/pr/social_me…","expanded_url":"https://www.maff.go.jp/j/pr/social_media/policy.html","indices":[73,96],"url":"https://t.co/2SnzXCNurZ"}]},"url":{"urls":[{"display_url":"maff.go.jp","expanded_url":"https://www.maff.go.jp/","indices":[0,23],"url":"https://t.co/cPtrdtbo0N"}]}}},"profile_desc