s_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":31,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":1297},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/820781478959120384/56mQa6_n_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/818669205205549056/1742379857"},"core":{"created_at":"Tue Jan 10 04:02:03 +0000 2017","name":"国土交通省　福井河川国道事務所","screen_name":"mlit_fukui"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4MTg2NjkyMDUyMDU1NDkwNTY=","is_blue_verified":true,"location":{"location":"日本 福井市"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省福井河川国道事務所です。\n当事務所は、「福井の社会課題と向き合い、未来を再生する」ことを目標に、質の高い河川・道路行政サービスを通じて、県民一人一人の生命や財産を守り、安定的な社会経済活動が確保される「真の地方創生」の実現を目指します。\n発信専用のため、お問い合わせにつきましては事務所ＨＰからお願い致します。","entities":{"description":{},"url":{"urls":[{"display_url":"kkr.mlit.go.jp/fukui/","expanded_url":"https://www.kkr.mlit.go.jp/fukui/","indices":[0,23],"url":"https://t.co/xut22J7b0L"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":21323,"following":59},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"818669205205549056","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":3021,"tweets":7223},"verification":{"verified":false,"verified_type":"Government"},"website":{