41,"w":141,"x":1335,"y":309}]},"medium":{"faces":[{"h":61,"w":61,"x":16,"y":468},{"h":58,"w":58,"x":447,"y":578},{"h":83,"w":83,"x":782,"y":181}]},"orig":{"faces":[{"h":134,"w":134,"x":35,"y":1015},{"h":126,"w":126,"x":969,"y":1254},{"h":180,"w":180,"x":1696,"y":393}]},"small":{"faces":[{"h":35,"w":35,"x":9,"y":265},{"h":32,"w":32,"x":253,"y":327},{"h":47,"w":47,"x":443,"y":102}]}},"id_str":"2098332618840514560","indices":[143,166],"media_key":"3_2098332618840514560","media_results":{"result":{"media_key":"3_2098332618840514560"}},"media_url_https":"https://pbs.twimg.com/media/HR7GZj6aoAAAUQo.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1452,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/fuMyKH1CYz"}]},"favorite_count":8475,"favorited":false,"full_text":"「横浜グリーンエクスポ」の開幕まで、来週の9月19日であと半年となりました。\n\n世界中、そして日本全国の皆様を横浜にお迎えする日が近づいていることを、大変うれしく思っています。\n\nそうした中、官邸のトゥンクトゥンクも、最近おしゃべりが上手になったとのことで、私も今朝、話してみました。 https://t.co/fuMyKH1CYz","id_str":"2098332630941118579","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":127,"quoted_status_id_str":"2098315918736752653","quoted_status_permalink":{"display":"x.com/kantei/status/…","expanded":"https://x.com/kantei/status/2098315918736752653","url":"https://t.co/PMIdmrblBF"},"reply_count":601,"retweet_count":880,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"x.com/kantei/status/…","expanded_url":"https://x.com/kantei/status/2098315918736752653","indices":[527,550],"url":"https://t.co/PMIdmrblBF"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTgzMzI2MzA3ODU5MzMzMTI=","richtext":{"richtext_tags":[]},"text":"「横浜グリーンエクスポ」の開幕まで、来週の9月19日であと半年となりました。\n\n世界中、そして日本全国の皆様を横浜にお迎えする日が近づいていることを、大変うれしく思っています。\n\nそうした中、官邸のトゥンクトゥンクも、最近おしゃべりが上手になったとのことで、私も今朝、話してみました。\n\nグリーンエクスポの魅力などを頑張って説明してくれて、私も気分が上がりました。\n\nこれからは、官邸外のイベントなどに「出張」する機会も出てくるそうです。\n\n今月24日～27日には、「ツーリズムEXPOジャパン2026」（東京ビックサイト）に出張予定だそうですので、もしトゥンクトゥンクに会う機会があれば、ぜひ話しかけて、やり取りしてみてください。\n\n一緒に写真も撮るのも楽しいかと思います。\n\n「横浜グリーンエクスポ」は、人と自然が共生する持続可能な社会の「日本モデル」を世界に示し、「カーボンニュートラル」や「ネイチャーポジティブ」、「サーキュラーエコノミー」の実現を先導する貴重な機会です。\n\n美しい花と緑で彩られた、「みんなが楽しめる万博」とするとともに、日本経済の新たな成長に向け、我が国の優れた「グリーン技術」や「食と農の魅力」を広く発信してまいります。\n\nhttps://t.co/PMIdmrblBF"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""}