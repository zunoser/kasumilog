"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04166.html","indices":[200,223],"url":"https://t.co/O4n3P62ekS"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTgyOTU2MDcwNDM3NzI0MTY=","richtext":{"richtext_tags":[]},"text":"2024年9月に我が国と国際原子力機関（IAEA）との間で実施することで一致したIAEAの枠組みの下での追加的モニタリングの一環として、IAEA関係者及び第三国分析機関の専門家が来日し、試料の採取を実施しました。日本政府は、今後ともIAEAと連携し、国際社会に対して透明性高く情報提供を行っていくとともに、ALPS処理水の海洋放出の安全性について、国内外の一層の理解を醸成していくことに努めます。\n\nhttps://t.co/O4n3P62ekS"}}},"previous_counts":{"bookmark_count":0,"favorite_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"rest_id":"2098295607102431469","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"10059","state":"EnabledWithCount"}}}}},"entryId":"tweet-2098295607102431469","sortIndex":"2098417956106010569"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":15},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/960685038957244417/qRIY3RTr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/719219671/1597226136"},"core":{"created_at":"Fri Jul 27 02:08:13 +0000 2012","name":"原子力規制委員会 / NRA Japan","screen_name":"gensiryokukisei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo3MTkyMTk2NzE=","is_blue_