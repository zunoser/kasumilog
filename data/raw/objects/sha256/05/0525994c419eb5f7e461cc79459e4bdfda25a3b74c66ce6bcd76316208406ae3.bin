vid/avc1/720x1280/aPEoofin2WFF4QI8.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2098315627870269441/vid/avc1/1080x1920/mwnlQJdd2i1rG3xx.mp4?tag=29"}]}}]},"favorite_count":2919,"favorited":false,"full_text":"開幕まで半年に迫った横浜グリーンエクスポの公式マスコットキャラクター、トゥンクトゥンクとの会話を楽しみました。\nはるか宇宙の彼方からやってきたトゥンクトゥンクも、地球の言葉をこれまで以上に覚えて、たくさん会話ができるようになりました。 https://t.co/1v06re1JaF","id_str":"2098315918736752653","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":379,"reply_count":437,"retweet_count":490,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTgzMTU5MTg2OTA3MDk1MDQ=","richtext":{"richtext_tags":[]},"text":"開幕まで半年に迫った横浜グリーンエクスポの公式マスコットキャラクター、トゥンクトゥンクとの会話を楽しみました。\nはるか宇宙の彼方からやってきたトゥンクトゥンクも、地球の言葉をこれまで以上に覚えて、たくさん会話ができるようになりました。\n開幕に向けて、オールジャパン体制で準備に万全を期してまいります。"}}},"rest_id":"2098315918736752653","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"582823","state":"EnabledWithCount"}}},"rest_id":"2098332630941118579","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"328423","state":"EnabledWithCount"}}}}},"entryId":"tweet-2098332630941118579","sortIndex":"2098417956106010590"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorit