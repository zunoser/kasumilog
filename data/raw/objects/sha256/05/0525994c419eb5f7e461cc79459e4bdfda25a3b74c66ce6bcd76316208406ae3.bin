ia":[{"display_url":"pic.x.com/Ig7Cg4UkJ8","expanded_url":"https://x.com/ModJapan_jp/status/2098333141673112041/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":74,"w":74,"x":722,"y":184}]},"medium":{"faces":[{"h":43,"w":43,"x":423,"y":107}]},"orig":{"faces":[{"h":74,"w":74,"x":722,"y":184}]},"small":{"faces":[{"h":24,"w":24,"x":239,"y":61}]}},"id_str":"2098333128138092544","indices":[134,157],"media_key":"3_2098333128138092544","media_results":{"result":{"media_key":"3_2098333128138092544"}},"media_url_https":"https://pbs.twimg.com/media/HR7G3NMa8AA5cuh.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1152,"w":1152,"x":0,"y":0},{"h":1152,"w":1011,"x":58,"y":0},{"h":1152,"w":576,"x":275,"y":0},{"h":1152,"w":2048,"x":0,"y":0}],"height":1152,"width":2048},"sizes":{"large":{"h":1152,"resize":"fit","w":2048},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Ig7Cg4UkJ8"},{"display_url":"pic.x.com/Ig7Cg4UkJ8","expanded_url":"https://x.com/ModJapan_jp/status/2098333141673112041/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2098333128117161984","indices":[134,157],"media_key":"3_2098333128117161984","media_results":{"result":{"media_key":"3_2098333128117161984"}},"media_url_https":"https://pbs.twimg.com/media/HR7G3NHbkAAiTFK.jpg","original_info":{"focus_rects":[{"h":358,"w":640,"x":0,"y":93},{"h":480,"w":480,"x":160,"y":0},{"h":480,"w":421,"x":219,"y":0},{"h":480,"w":240,"x":400,"y":0},{"h":480,"w":640,"x":0,"y":0}],"height":480,"width":640},"sizes":{"large":{"h":480,"resize":"fit","w":640},"medium":{"h":480,"resize":"fit","w":640},"small":{"h":480,"resize":"fit","w":640},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Ig7Cg4UkJ8"}]},"favorite_count":228,"favorited":false,"full_text":"理系の仕事と進路のヒントに出会う。\n✧「Girls Meet STEM for School」を防衛省で開催✧\n \n9月1日、杉並区立富士見丘中学校２年生の女子生徒を防衛省に迎え、市ヶ谷のオフィス見学や理工系分野出身の女性技官・女性自衛官との懇談などを実施しました。 https://t.co/Ig7Cg4UkJ8","id_str":"2098333141673112041","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"quoted_status_id_str":"2095805826376343913","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2095805826376343913","url":"https://t.co/i1lI34NVsj"},"reply_count":5,"retweet_count":27,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTgzMzMxNDE2MjI3NDcxMzY=","text":"理系の仕事と進路のヒントに出会う。\n✧「Girls Meet STEM for School」を防衛省で開催✧\n \n9月1日、杉並区立富士見丘中学校２年生の女子生徒を防衛省に迎え、市ヶ谷のオフィス見学や理工系分野出身の女性技官・女性自衛官との懇談などを実施しました。\n \n懇談では、女性技官・女性自衛官の進路選択の決め手や仕事のやりがいなどについて質問が出され、参加した皆さんが熱心にメモを取っていました。\n \n今回のイベントが、参加者の皆さんの将来の仕事や進路について考えるきっかけとなれば幸いです。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛