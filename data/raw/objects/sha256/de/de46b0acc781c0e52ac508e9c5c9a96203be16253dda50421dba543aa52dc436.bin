4","url":"https://video.twimg.com/amplify_video/2123751394813591552/vid/avc1/480x852/Pe0M9-sQbj_ZJrEX.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123751394813591552/vid/avc1/720x1280/eWsEdOaYmDRbnGxO.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123751394813591552/vid/avc1/1080x1920/7VQBrP-cnU-rvgDF.mp4?tag=29"}]}}]},"favorite_count":6783,"favorited":false,"full_text":"日・チリ首脳会談等の様子です。 https://t.co/MFDnZ51fQP","id_str":"2123751564804604021","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":52,"reply_count":141,"retweet_count":1017,"retweeted":false,"user_id_str":"412940784"},"rest_id":"2123751564804604021","unmention_data":{},"views":{"count":"113411","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123751564804604021","sortIndex":"2124588589558792176"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifica