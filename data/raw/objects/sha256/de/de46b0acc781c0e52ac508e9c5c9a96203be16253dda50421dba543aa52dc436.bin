ag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123773492240031744/vid/avc1/640x360/PnyLfvGVJh5SRMwy.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123773492240031744/vid/avc1/1280x720/pMngrtoCZbUvO2Lz.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/OYjqvYXcUQ","expanded_url":"https://x.com/kantei/status/2123773864337605115/video/1","ext_media_availability":{"status":"Available"},"id_str":"2123773492240031744","indices":[131,154],"media_key":"13_2123773492240031744","media_results":{"result":{"media_key":"13_2123773492240031744"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123773492240031744/img/VY2o6yqW6rz90eLL.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/OYjqvYXcUQ","video_info":{"aspect_ratio":[16,9],"duration_millis":536133,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2123773492240031744/pl/rEHh-hDkfLDVCP0Y.m3u8?tag=29&v=ce4"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123773492240031744/vid/avc1/480x270/wEbu7SKDNajLRK7y.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123773492240031744/vid/avc1/640x360/PnyLfvGVJh5SRMwy.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123773492240031744/vid/avc1/1280x720/pMngrtoCZbUvO2Lz.mp4?tag=29"}]}}]},"favorite_count":3937,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２０日）、高市総理とチリのホセ・アントニオ・カスト・リスト大統領は、日・チリ共同記者発表を行いました。\n\n※両首脳による発言（速報版、仮訳）\n（高市総理）\n　皆様、こんばんは。本日、チリのカスト大統領をお迎えし、首脳会談を行いました。 https://t.co/OYjqvYXcUQ","id_str":"2123773864337605115","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":28,"reply_count":224,"retweet_count":600,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM3NzM4NjQxOTkyNjIyMDg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２０日）、高市総理とチリのホセ・アントニオ・カスト・リスト大統領は、日・チリ共同記者発表を行いました。\n\n※両首脳による発言（速報版、仮訳）\n（高市総理）\n　皆様、こんばんは。本日、チリのカスト大統領をお迎えし、首脳会談を行いました。\n　自由や民主主義といった基本的価値や原則を共有するチリと『進化したＦＯＩＰ』の下、「共に、強く豊かに」なるための協力についてカスト大統領と率直に議論できたことを大変嬉しく思います。\n　特に、１００年以上にわたり日本とチリの間で培ってきた友好関係を基礎に、法の支配に基づく自由で開かれた国際秩序を共に維持・強化することが、太平洋を挟んだ海洋国家である両国にとって極めて重要であることを再確認しました。\n　また、日本とチリは、戦略的パートナーとして、経済面においても、様々な協力が進展しています。\n　日本への銅やリチウムの主要な供給国として、チリは、重要鉱物のサプライチェーンの強靱化で日本と協力・連携を深めていくことを確認しました。\n　鉱業・水産業・エネルギーといった幅広い分野で日本企業がチリに進出しており、貿易・投資の更なる拡大が期待されます。\n　情報通信技術分野では、『ＦＯＩＰデジタル回廊構想』の下で、日本は次世代通信技術を活用して、チリの銅鉱山での遠隔作業の実現を目指す共同プロジェクトが進展しています。\n　このほか、同構想の下、ＩＣＴを活用した災害リスク管理の協力も進めてまいります。\n　天文学や南極を始め科学分野でも協力を進めていきます。\n　カスト大統領からは、平和国家としての日本の戦後一貫した取組につき評価いただいたところですが、チリとの間では、防衛交流も着実に進展しており、更なる協力に向けた、新たな文書への署名が行われました。\n　今般、両国間で署名されたそれぞれの文書に基づき、両国の協力が更に深まることを期待します。\n　来年は、日本・チリ外交関係樹立１３０周年です。ロゴマークの公募に両国から多数の応募がありました。そしてこちらのデザインが選ばれました。\n　折り鶴は両国に紡がれてきた絆を象徴し、外交関係と友好の１３０周年を祝う両国民の平和や協力、相互理解の決意を表しています。\n　この機会に二国間の交流がますます活発化し、良好な二国間関係が更に深まっていくことを願います。\n　今回のカスト大統領の訪日を機に、両国の戦略的パートナーシップをより強固なものとしてまいります。\n　ありがとうございました。\n\n（ホセ・アントニオ・カスト・リスト大統領）※日本語仮訳\n　高市内閣総理大臣、並びに両国の出席閣僚の皆様。\n　高市総理、そして日本政府及び日本国民の皆様が、私達の代表団を温かいおもてなしで迎えてくださったことに感謝いたします。高市総理、１年余り前、女性として初めて日本政府の代表に就任され、今年、日本国民は高市総理のリーダーシップに対する信頼を新たにしました。生まれ故郷である奈良から国家の代表に至るまで、３０年以上の公務における歩みは、困難な決断を厭わない確固たる信念を持った指導者であることを物語っています。高市総理は、国家の強さは規律、安全、そして長期的な視野によって築かれるものであると理解されています。そして、チリはその精神を高く評価しています。\n　本日の会談において、私は率直で明快、かつ私たちの関係を前進させる決意を持った対話相手に出会うことができました。チリと日本は１３０年以上の伝統を持つ友人であり、１８９７年の修好通商航海条約は、チリがアジア太平洋地域の国と締結した最初の条約でした。本日、高市総理が述べられたように、私たちは２０２７年の１３０周年に向けたロゴを発表し、この１３０周年が単に過去を振り返るだけでなく、未来への推進力となるよう合意しました。また、何世代にもわたり両国民を結ぶ真の架け橋となってきたチリの日本人コミュニティに対しても、感謝の意を表します。私達の戦略的パートナーシップは、今日、非常に具体的な内容を有しています。日本は、チリにおけるアジア最大の投資国です。私達は、日本の次世代通信技術を導入した銅鉱山の共同プロジェクトを高く評価し、世界のサプライチェーンに一貫性と安定性をもたらすため、銅を含む重要鉱物における協力を強化することを約束します。そのため、私は日本企業に対し、２０２７年３月に開催される「Ｃｈｏｏｓｅ　Ｃｈｉｌｅ　Ｓｕｍｍｉｔ」への参加を呼びかけたいと思います。チリは投資、技術、そして人材に対して開かれており、日本がこのイベントにおいて重要な位置を占めることを望んでいます。また、安全で信頼できるデジタル・インフラに向けて前進するため、情報通信技術の協力に関する覚書に署名しました。さらに、南極、科学、防災、そして防衛における共同の取組を再確認しました。\n　私達はまた、繁栄はルールによって守られるという信念を共有しています。作業部会が設置されたばかりのＲＣＥＰへのチリの加盟に対し、日本が示してくれた支持に感謝いたします。また、ＣＰＴＰＰの高い基準を維持し、それに合致する新たな加盟国へ拡大するために、引き続き共同で取り組んでまいります。私達は、太平洋によって結ばれた2つの海洋国家です。私達は、法の支配、航行の自由、および国連海洋法条約に基づく、自由で開かれた国際秩序の重要性において一致しています。私達は、平和で安定し、繁栄したアジア太平洋地域を望んでおり、日本の同地域に対するビジョンの根底にある原則を共有しています。その精神に基づき、海洋生物多様性を保護するため、ベルギーと共にバルパライソに国連公海等生物多様性協定（ＢＢＮＪ協定）の事務局を誘致するチリの立候補に対する日本の支持に、特に深く感謝いたします。\n　最後に、高市総理に対し、多忙を極める日本の政界において、機会がある際には、チリを訪問していただくよう招待を伝えました。これは、２０１４年に行われた、記憶に新しい、安倍晋三総理大臣の素晴らしい訪問を思い起こさせるものでもあります。高市総理を我が国にお迎えできることは、私達にとって光栄なことです。高市総理の友情とリーダーシップに心から感謝いたします。ありがとうございました。"}}},"rest_id":"2123773864337605115","unmention_data":{},"views":{"count":"75953","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123773864337605115","sortIndex":"2124588589558792178"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1774870,"following":48},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8418,"tweets":23605},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2123767665688739916"],"editable_until_msecs":"1795184243000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":38,"bookmarked":false,"conversation_id_str":"2123767665688739916","created_at":"Fri Nov 20 13:17:23 +0000 2026","display_text_range":[0,131],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/fXJzGSmcEN","expanded_url":"https://x.com/kantei/status/2123767665688739916/video/1","ext_media_availability":{"status":"Available"},"id_str":"2123767477100539904","indices":[132,155],"media_key":"13_2123767477100539904","media_results":{"result":{"media_key":"13_2123767477100539904"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123767477100539904/img/E5hlftUwEARed-Nd.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/fXJzGSmcEN","video_info":{"aspect_ratio":[16,9],"duration_millis":213100,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2123767477100539904/pl/Cn0iloGT2b9gWCpR.m3u8?tag=29&v=72c"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123767477100539904/vid/avc1/480x270/WE-8AeHxhVElQBWm.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123767477100539904/vid/avc1/640x360/ddaVGB0PrwqeFhbK.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123767477100539904/vid/avc1/1280x720/5hcF39XHcEPuoFe_.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/fXJzGSmcEN","expanded_url":"https://x.com/kantei/status/2123767665688739916/video/1","ext_media_availability":{"status":"Available"},"id_str":"2123767477100539904","indices":[132,155],"media_key":"13_2123767477100539904","media_results":{"result":{"media_key":"13_2123767477100539904"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123767477100539904/img/E5hlftUwEARed-Nd.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/fXJzGSmcEN","video_info":{"aspect_ratio":[16,9],"duration_millis":213100,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2123767477100539904/pl/Cn0iloGT2b9gWCpR.m3u8?tag=29&v=72c"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123767477100539904/vid/avc1/480x270/WE-8AeHxhVElQBWm.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123767477100539904/vid/avc1/640x360/ddaVGB0PrwqeFhbK.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123767477100539904/vid/avc1/1280x720/5hcF39XHcEPuoFe_.mp4?tag=29"}]}}]},"favorite_count":1854,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２０日）、高市総理は、チリのホセ・アントニオ・カスト・リスト大統領と会談を行いました。\n\n※両首脳による冒頭発言（速報版、仮訳）\n（高市総理）\n　カスト大統領の初めての訪日を心より歓迎します。再び日本でお目にかかれて、とても嬉しいです。 https://t.co/fXJzGSmcEN","id_str":"2123767665688739916","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":75,"retweet_count":262,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM3Njc2NjU2MDA2OTIyMjQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２０日）、高市総理は、チリのホセ・アントニオ・カスト・リスト大統領と会談を行いました。\n\n※両首脳による冒頭発言（速報版、仮訳）\n（高市総理）\n　カスト大統領の初めての訪日を心より歓迎します。再び日本でお目にかかれて、とても嬉しいです。\n　両国は太平洋を挟んだ隣国であり、海洋国家でございます。戦略的パートナーとして、両国の協力は、経済、科学、安全保障を始め、幅広い分野で進展しております。\n　来年は日本とチリ、外交関係樹立１３０周年であります。関係を一層深めていきたいと思っております。\n　法の支配に基づく、自由で開かれた国際秩序の維持というのは重要です。『進化したＦＯＩＰ』の下、経済安全保障を含む課題に対応すべく、連携していきたいと考えております。\n　この後の会談で具体的な話ができることを楽しみにしております。ありがとう。\n\n（ホセ・アントニオ・カスト・リスト大統領）※日本語仮訳\n　高市内閣総理大臣、まず、このように心のこもった、行き届いたおもてなしをしていただき、誠にありがとうございました。\n　外務大臣、国防大臣、農業大臣、経済・鉱業大臣をはじめとするチリの代表団にとって、130年近くにわたる両国の関係、すなわち信頼に基づき、明確なルールに立脚した関係を強化していくことは、非常に重要です。\n　自由貿易のためにサプライチェーンを常に開かれた自由なものとして維持し、自国の平和と繁栄を追求するという点について、日本と同じ問題意識を共有しています。"}}},"rest_id":"2123767665688739916","unmention_data":{},"views":{"count":"59422","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123767665688739916","sortIndex":"2124588589558792177"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1774870,"following":48},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8418,"tweets":23605},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2123751564804604021"],"editable_until_msecs":"1795180405000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":137,"bookmarked":false,"conversation_id_str":"2123751564804604021","created_at":"Fri Nov 20 12:13:25 +0000 2026","display_text_range":[0,15],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/MFDnZ51fQP","expanded_url":"https://x.com/kantei/status/2123751564804604021/video/1","ext_media_availability":{"status":"Available"},"id_str":"2123751394813591552","indices":[16,39],"media_key":"13_2123751394813591552","media_results":{"result":{"media_key":"13_2123751394813591552"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123751394813591552/img/uR6L7nx8-VrwmplA.jpg","original_info":{"focus_rects":[],"height":1920,"width":1080},"sizes":{"large":{"h":1920,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":675},"small":{"h":680,"resize":"fit","w":383},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/MFDnZ51fQP","video_info":{"aspect_ratio":[9,16],"duration_millis":