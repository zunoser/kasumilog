,"x":741,"y":163}]},"orig":{"faces":[{"h":243,"w":243,"x":1226,"y":538},{"h":236,"w":236,"x":759,"y":464},{"h":246,"w":246,"x":1607,"y":355}]},"small":{"faces":[{"h":63,"w":63,"x":320,"y":140},{"h":61,"w":61,"x":198,"y":121},{"h":64,"w":64,"x":420,"y":92}]}},"id_str":"2123739484953120768","indices":[54,77],"media_key":"3_2123739484953120768","media_results":{"result":{"media_key":"3_2123739484953120768"}},"media_url_https":"https://pbs.twimg.com/media/HXkJzzwaEAATFi2.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1795,"w":1795,"x":77,"y":0},{"h":1795,"w":1575,"x":187,"y":0},{"h":1795,"w":898,"x":525,"y":0},{"h":1795,"w":2600,"x":0,"y":0}],"height":1795,"width":2600},"sizes":{"large":{"h":1414,"resize":"fit","w":2048},"medium":{"h":828,"resize":"fit","w":1200},"small":{"h":469,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yF2k39ow1Q"}]},"favorite_count":24016,"favorited":false,"full_text":"本日夕刻、訪日中のカスト・チリ共和国大統領をお迎えし、首脳会談をはじめとする一連の首脳行事を実施しました。 https://t.co/yF2k39ow1Q","id_str":"2123739517169308077","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":92,"reply_count":909,"retweet_count":2578,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM3Mzk1MTcwOTM5MDAyODg=","richtext":{"richtext_tags":[]},"text":"本日夕刻、訪日中のカスト・チリ共和国大統領をお迎えし、首脳会談をはじめとする一連の首脳行事を実施しました。\n\n私から、訪日を歓迎申し上げ、日本とチリとの協力が、「戦略的パートナー」として幅広い分野で進展していることに触れつつ、来年外交関係樹立130周年を迎える二国間関係を一層深化させたい旨を申し上げました。\n\nまた、法の支配に基づく自由で開かれた国際秩序の維持・強化は重要であり、「進化したFOIP」の下、連携していきたい旨をお伝えしました。\n\n会談では、「重要鉱物資源のサプライチェーン強靭化」に向けた経済安全保障上の課題への対処を含め、両国の連携を一層強化していくことで一致しました。\n\nこの機会に署名された、情報通信技術分野での協力を推進するための協力覚書や防衛協力・交流に関する意図表明文書を歓迎しました。\n\nまた、私から、「FOIPデジタル回廊構想」の下、日本の次世代通信技術を活用し、チリの銅鉱山での遠隔作業の実現などを目指す共同プロジェクトを含む具体的協力を進めていきたい旨を申し上げました。\n\nさらに、インド太平洋情勢についても意見交換を行い、核・ミサイル開発や拉致問題、悪意あるサイバー活動といった北朝鮮への対応を含め、緊密に連携していくことを確認しました。"}}},"rest_id":"2123739517169308077","unmention_data":{},"views":{"count":"502418","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123739517169308077","sortIndex":"2124588589558792170"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":52},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1697575938316529664/Iob6ICh3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/331514169/1655191913"},"core":{"created_at":"Fri Jul 08 08:59:28 +0000 2011","name":"財務省","screen_name":"MOF_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMzE1MTQxNjk=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関3-1-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"財務省の公式アカウントです。財務省ホームページに掲載する情報を中心に発信していきます。\n【運用ポリシー】https://t.co/Mk40iFUuyb\n【財務省note】https://t.co/PEuOEDD4Nu","entities":{"description":{"urls":[{"display_url":"mof.go.jp/about_mof/soci…","expanded_url":"http://www.mof.go.jp/about_mof/social_media_account/index.html","indices":[52,75],"url":"https://t.co/Mk40iFUuyb"},{"display_url":"mof-gov.note.jp","expanded_url":"https://mof-gov.note.jp/","indices":[85,108],"url":"https://t.co/PEuOEDD4Nu"}]},"url":{"urls":[{"display_url":"mof.go.jp",