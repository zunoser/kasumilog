"result":{"media_key":"3_2123969307118096384"}},"media_url_https":"https://pbs.twimg.com/media/HXna1OCbUAARvYw.jpg","original_info":{"focus_rects":[{"h":1019,"w":1819,"x":0,"y":0},{"h":1819,"w":1819,"x":0,"y":0},{"h":2074,"w":1819,"x":0,"y":0},{"h":2573,"w":1287,"x":0,"y":0},{"h":2573,"w":1819,"x":0,"y":0}],"height":2573,"width":1819},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/JvLzoCXWhO"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/JvLzoCXWhO","expanded_url":"https://x.com/takaichi_sanae/status/2123969329415016706/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":91,"w":91,"x":341,"y":636}]},"medium":{"faces":[{"h":53,"w":53,"x":199,"y":372}]},"orig":{"faces":[{"h":115,"w":115,"x":429,"y":799}]},"small":{"faces":[{"h":30,"w":30,"x":113,"y":211}]}},"id_str":"2123969307118030848","indices":[106,129],"media_key":"3_2123969307118030848","media_results":{"result":{"media_key":"3_2123969307118030848"}},"media_url_https":"https://pbs.twimg.com/media/HXna1OCaUAAse1g.jpg","original_info":{"focus_rects":[{"h":1019,"w":1819,"x":0,"y":1099},{"h":1819,"w":1819,"x":0,"y":699},{"h":2074,"w":1819,"x":0,"y":499},{"h":2573,"w":1287,"x":0,"y":0},{"h":2573,"w":1819,"x":0,"y":0}],"height":2573,"width":1819},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/JvLzoCXWhO"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/JvLzoCXWhO","expanded_url":"https://x.com/takaichi_sanae/status/2123969329415016706/photo/3","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2123969307118100480","indices":[106,129],"media_key":"3_2123969307118100480","media_results":{"result":{"media_key":"3_2123969307118100480"}},"media_url_https":"https://pbs.twimg.com/media/HXna1OCbYAALDw1.jpg","original_info":{"focus_rects":[{"h":1019,"w":1819,"x":0,"y":1554},{"h":1819,"w":1819,"x":0,"y":754},{"h":2074,"w":1819,"x":0,"y":499},{"h":2573,"w":1287,"x":532,"y":0},{"h":2573,"w":1819,"x":0,"y":0}],"height":2573,"width":1819},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/JvLzoCXWhO"}]},"favorite_count":24907,"favorited":false,"full_text":"本格的な雪の季節を迎えるにあたり、車を利用される全ての皆様にお願いです。\n\n雪道での立ち往生は、人命に関わるだけでなく、後続車両の滞留や通行止めにつながり、地域の暮らしや物流に大きな影響を及ぼすことがあります。 https://t.co/JvLzoCXWhO","id_str":"2123969329415016706","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":494,"reply_count":1847,"retweet_count":3793,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mlit.go.jp/report/press/j…","expanded_url":"https://www.mlit.go.jp/report/press/jidosha08_hh_005895.html","indices":[508,531],"url":"https://t.co/DbtwxnO37f"},{"display_url":"mlit.go.jp/report/press/j…","expanded_url":"https://www.mlit.go.jp/report/press/jidosha09_hh_000365.html","indices":[532,555],"url":"https://t.co/8DXr7LYPPz"},{"display_url":"npa.go.jp/bureau/traffic…","expanded_url":"https://www.npa.go.jp/bureau/traffic/seibi2/saigaiji/yukimitiunten.html","indices":[556,579],"url":"https://t.co/O4yRBAHOod"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM5NjkzMjkyNzY1MzA2ODg=","richtext":{"richtext_tags":[]},"text":"本格的な雪の季節を迎えるにあたり、車を利用される全ての皆様にお願いです。\n\n雪道での立ち往生は、人命に関わるだけでなく、後続車両の滞留や通行止めにつながり、地域の暮らしや物流に大きな影響を及ぼすことがあります。\n\nこのため、「冬用タイヤ」の装着と十分な溝の確認、「タイヤチェーン」の携行・早めの装着をお願い申し上げます。\n\nまた、大型車の車輪の脱落事故が依然として多数発生しています。\n\n冬用タイヤへの交換時のさび取りや潤滑剤の塗布、保守管理における増し締めなど、タイヤ脱着時の確実な作業と保守管理の徹底をお願い申し上げます。\n\n先々の気象予報や道路情報を確認し、大雪が予想される場合には、予定や経路の変更、運転の取りやめを含め、安全を最優先に判断なさって下さい。\n\n運送事業者の皆様には、無理な運行を行わないこと、荷主の皆様には、配送時間や経路の変更、運送の中止を柔軟に認めていただくことをお願い申し上げます。\n\n一人一人の事前の備えと早めの判断、そして確実な点検整備が、命を守り、大規模な立ち往生を防ぎます。\n皆様のご協力をお願い申し上げます。\n\n詳しくは、国土交通省、警察庁のホームページをご覧下さいませ。\n\nhttps://t.co/DbtwxnO37f\nhttps://t.co/8DXr7LYPPz\nhttps://t.co/O4yRBAHOod"}}},"rest_id":"2123969329415016706","unmention_data":{},"views":{"count":"1146747","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123969329415016706","sortIndex":"2124588589558792186"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2124588589558792199-tweet-2123733000022364207","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enab