,"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM1NTE4OTk1NzIxMzM4ODg=","text":"📢INPIT広報が現地取材｜函館高専 1日目\n\n＼学生の気づきに、専門家たちが応える。／\n\n函館高専における知財教育の取組に、INPITの知財戦略エキスパートが参画しています。\n\n1日目は学生の皆さんが探究活動の成果報告を通じて感じたことや学んだことを発表。\n\n知財戦略エキスパートや2名の弁理士、北海道経産局の知財室長等が、それぞれの経験や専門的な視点からコメントしています。\n\n関心の輪をどう広げ、仲間を増やし、次の挑戦につなげるか。知財を学ぶ意義を学生の皆さんと一緒に考えています💡\n\n#函館高専 #知財教育 #高専"}}},"rest_id":"2123551899672867142","unmention_data":{},"views":{"count":"1099","state":"EnabledWithCount"}}},"user_id_str":"281874178"},"rest_id":"2123682887535128929","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"163","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123682887535128929","sortIndex":"2124588589558792122"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2124588589558792263-tweet-2123680438296400360","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/875540374780911616/70s-ef5h_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1469058582/1398238011"},"core":{"created_at":"Thu May 30 06:31:59 +0000 2013","name":"総務省","screen_name":"MIC_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNDY5MDU4NTgy","is_blue_verified":false,"locatio