,"y":0},{"h":2272,"w":3408,"x":0,"y":0}],"height":2272,"width":3408},"sizes":{"large":{"h":1365,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/V0JRTYKUFj"}]},"favorite_count":16,"favorited":false,"full_text":"／\nNEXUS Japan-GS Forum（日・グローバルサウス経済共創フォーラム）の\nレポート「フォーラム・ハイライト」と、録画映像を公表しました！\n＼\n👇「フォーラム・ハイライト」はこちら！\nhttps://t.co/sXBKU0xzXx\n👇録画映像はこちら！\nhttps://t.co/xC8Z7fuJcM https://t.co/V0JRTYKUFj","id_str":"2123730205185597766","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":3,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/policy/externa…","expanded_url":"https://www.meti.go.jp/policy/external_economy/cooperation/oda/nexus/highlights_jp.pdf","indices":[99,122],"url":"https://t.co/oOXWrragxW"},{"display_url":"youtube.com/playlist?list=…","expanded_url":"https://www.youtube.com/playlist?list=PLaUMlbKErq1Y","indices":[134,157],"url":"https://t.co/A4qeQst3xD"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM3MzAyMDUwNTEzMzQ2NTY=","richtext":{"richtext_tags":[]},"text":"／\nNEXUS Japan-GS Forum（日・グローバルサウス経済共創フォーラム）の\nレポート「フォーラム・ハイライト」と、録画映像を公表しました！\n＼\n👇「フォーラム・ハイライト」はこちら！\nhttps://t.co/oOXWrragxW\n👇録画映像はこちら！\nhttps://t.co/A4qeQst3xD\n\n本フォーラムは、日本とグローバルサウス諸国の共創に関わる産官学のプレイヤーが一堂に会する結節点（NEXUS）となることを目的として10/19に開催。日本及びグローバルサウスの4か国から産官学のリーダー27名がパネリストとして参加しました。\n登壇者の発言や議論の内容をまとめた「フォーラム・ハイライト」と、当日の様子を録画映像でご覧いただけます。"}}},"rest_id":"2123730205185597766","unmention_data":{},"views":{"count":"4687","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123730205185597766","sortIndex":"2124588589558792161"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tw