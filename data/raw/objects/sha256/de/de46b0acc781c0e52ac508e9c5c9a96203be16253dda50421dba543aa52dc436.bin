ia":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/snzps4DpmP","expanded_url":"https://x.com/takaichi_sanae/status/2124292304576061540/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":124,"w":124,"x":726,"y":1104},{"h":108,"w":108,"x":734,"y":1256}]},"medium":{"faces":[{"h":72,"w":72,"x":425,"y":646},{"h":63,"w":63,"x":430,"y":735}]},"orig":{"faces":[{"h":248,"w":248,"x":1452,"y":2208},{"h":216,"w":216,"x":1468,"y":2512}]},"small":{"faces":[{"h":41,"w":41,"x":241,"y":366},{"h":35,"w":35,"x":243,"y":417}]}},"id_str":"2124292108647620608","indices":[81,104],"media_key":"3_2124292108647620608","media_results":{"result":{"media_key":"3_2124292108647620608"}},"media_url_https":"https://pbs.twimg.com/media/HXsAavcbYAAUPiZ.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":0,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/snzps4DpmP"}]},"favorite_count":9318,"favorited":false,"full_text":"【日本列島を、強く豊かに。：鳥取県智頭町編】\n\n本日は、『地域未来戦略』に基づき鳥取県智頭町が策定した、「農林業分野における地場産業成長プラン」をご紹介します。 https://t.co/snzps4DpmP","id_str":"2124292304576061540","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":76,"reply_count":689,"retweet_count":1019,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[777,789],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjQyOTIzMDQ0ODgwODM0NTY=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：鳥取県智頭町編】\n\n本日は、『地域未来戦略』に基づき鳥取県智頭町が策定した、「農林業分野における地場産業成長プラン」をご紹介します。\n\n智頭町は、町面積の9割以上を森林が占めており、豊富な森林資源をはじめとする地域資源を活用し、従来の林業経営にとらわれない先進的な取組に挑戦してきました。\n\n他方で、林業収益性は低迷しており、付加価値の向上が課題となっています。\nまた、豪雪地帯という特性から、冬期には農業生産や観光需要が減少し、季節的な雇用の断絶が発生するため、若年層の流出や担い手不足を招く一因となっています。\n\nこうした課題に対して、智頭町は、森林整備で生じた低質な木材や未利用材を熱源化し、コーヒーなど高付加価値農産物の栽培に活用することで、付加価値の向上や、冬期における雇用機会の創出を図るなど、森林・林業を起点とし、農業や観光など複数の分野が連携する産業構造の形成を目指しています。\n\n『地域未来戦略』の国の支援も活用し、低質な木材等をエネルギーとして利用するための木質チップの生産拠点、木質チップを熱源とする温室ハウス、販売拠点の整備などに対する官民投資を行うとともに、高齢者や障がい者を含む多様な地域人材が参画できる体制の構築、新規事業の創出などに取り組むこととしています。\n\n私自身、金兒町長から以下の意気込みを伺いました。\n\n「この度の提案は、森林・林業を起点とし、農業や観光など複数の分野を横断した『地域循環成長モデル』の構築を目指すものです。木質チップ材の熱源利用によって雪深いエリアのハンデを克服し、『国産コーヒー』を御旗に掲げた、新たな産業・地域づくりを成し遂げます。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を全力で応援してまいります。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2124292304576061540","unmention_data":{},"views":{"count":"269921","state":"EnabledWithCount"}}}}},"entryId":"tweet-2124292304576061540","sortIndex":"2124588589558792189"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notificati