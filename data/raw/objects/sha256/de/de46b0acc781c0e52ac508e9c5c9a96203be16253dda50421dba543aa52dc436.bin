AASLjj.jpg","original_info":{"focus_rects":[{"h":1029,"w":1837,"x":0,"y":461},{"h":1837,"w":1837,"x":0,"y":57},{"h":2094,"w":1837,"x":0,"y":0},{"h":2600,"w":1300,"x":0,"y":0},{"h":2600,"w":1837,"x":0,"y":0}],"height":2600,"width":1837},"sizes":{"large":{"h":2048,"resize":"fit","w":1447},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":480},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/TTHqjPpYR6"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/TTHqjPpYR6","expanded_url":"https://x.com/takaichi_sanae/status/2123683162433912942/photo/4","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":81,"w":81,"x":1427,"y":431},{"h":217,"w":217,"x":1089,"y":755}]},"medium":{"faces":[{"h":48,"w":48,"x":836,"y":252},{"h":127,"w":127,"x":638,"y":442}]},"orig":{"faces":[{"h":104,"w":104,"x":1812,"y":548},{"h":276,"w":276,"x":1383,"y":959}]},"small":{"faces":[{"h":27,"w":27,"x":473,"y":143},{"h":72,"w":72,"x":361,"y":250}]}},"id_str":"2123683130683109376","indices":[129,152],"media_key":"3_2123683130683109376","media_results":{"result":{"media_key":"3_2123683130683109376"}},"media_url_https":"https://pbs.twimg.com/media/HXjWjjvbMAAh0mu.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1452,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/TTHqjPpYR6"}]},"favorite_count":39819,"favorited":false,"full_text":"本日午後、訪日中のケイコ・フジモリ・ペルー共和国大統領と、首脳会談を行いました。\n若手議員時代に複数回お目にかかったことがある、アルベルト・フジモリ元大統領の御令嬢であり、4回目の挑戦で大統領に就任されたケイコ・フジモリ大統領にお会いできて嬉しかったです。 https://t.co/TTHqjPpYR6","id_str":"2123683162433912942","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":148,"reply_count":898,"retweet_count":4255,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM2ODMxNjIzNTg0Mjc2NDg=","richtext":{"richtext_tags":[]},"text":"本日午後、訪日中のケイコ・フジモリ・ペルー共和国大統領と、首脳会談を行いました。\n若手議員時代に複数回お目にかかったことがある、アルベルト・フジモリ元大統領の御令嬢であり、4回目の挑戦で大統領に就任されたケイコ・フジモリ大統領にお会いできて嬉しかったです。\n\n私から、訪日を歓迎申し上げるとともに、両国は150年以上の友好的な外交関係を有し、価値や原則を共有する「戦略的パートナー」であり、「進化したFOIP」の下、各国の自律性と強靱性を高めるべく、共に協力していきたい旨をお伝えしました。\n\nまた、約20万人の在ペルー日系社会は両国の懸け橋であり、日系社会との連携をより一層強化していく旨を申し上げました。\n\nさらに、重要鉱物の恣意的な輸出規制はグローバルなサプライチェーンに影響する喫緊の課題であり、豊富な鉱物資源（銅や亜鉛など）を有するペルーと経済安全保障分野で協力していきたい旨を申し上げました。\n\n会談では、二国間関係の更なる発展のために連携していくことを確認し、防災、情報通信、投資促進、教育、農業といった様々な分野の交換公文・協力文書が署名されることを歓迎しました。\n\n銅を含む重要鉱物のサプライチェーン強靱化に向けた連携を更に推進することや、経済や防衛、AI、防災を始め諸分野で協力を強化していくことで一致しました。\n\nこのほか、インド太平洋情勢等の地域情勢についても意見交換を行い、核・ミサイル開発や拉致問題、悪意あるサイバー活動といった北朝鮮への対応に関する緊密な連携を含め、地域や国際社会の諸課題に取り組んでいくことを確認しました。\n\nケイコ・フジモリ大統領の甥御様と姪御様から激励のお手紙をいただいたことも嬉しく存じました。"}}},"rest_id":"2123683162433912942","unmention_data":{},"views":{"count":"969099","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123683162433912942","sortIndex":"2124588589558792123"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/p