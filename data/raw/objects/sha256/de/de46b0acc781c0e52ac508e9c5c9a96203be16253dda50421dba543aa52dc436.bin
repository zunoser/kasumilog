23746558332301312"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123746558332301312/img/sqEdmFzlmZVlW45P.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/ze83qIwkig","video_info":{"aspect_ratio":[16,9],"duration_millis":272533,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2123746558332301312/pl/keZfsjrOztpuX9YH.m3u8?tag=29&v=3f8"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123746558332301312/vid/avc1/480x270/8_JsGbeRd34MvcR5.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123746558332301312/vid/avc1/640x360/cK9fl91LcG0DjSp_.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123746558332301312/vid/avc1/1280x720/vya0EVzlJT2ntvtg.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/ze83qIwkig","expanded_url":"https://x.com/kantei/status/2123746952752058743/video/1","ext_media_availability":{"status":"Available"},"id_str":"2123746558332301312","indices":[88,111],"media_key":"13_2123746558332301312","media_results":{"result":{"media_key":"13_2123746558332301312"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123746558332301312/img/sqEdmFzlmZVlW45P.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/ze83qIwkig","video_info":{"aspect_ratio":[16,9],"duration_millis":272533,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2123746558332301312/pl/keZfsjrOztpuX9YH.m3u8?tag=29&v=3f8"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123746558332301312/vid/avc1/480x270/8_JsGbeRd34MvcR5.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123746558332301312/vid/avc1/640x360/cK9fl91LcG0DjSp_.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123746558332301312/vid/avc1/1280x720/vya0EVzlJT2ntvtg.mp4?tag=29"}]}}]},"favorite_count":1687,"favorited":false,"full_text":"本日（１１月２０日）、高市総理は、ペルーのフジモリ大統領と会談を行いました。\n\n※両首脳による冒頭発言（速報版、仮訳）\n（高市総理）\n　フジモリ大統領の訪日を歓迎いたします。 https://t.co/ze83qIwkig","id_str":"2123746952752058743","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":49,"retweet_count":260,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM3NDY5NTI2MzQ1OTMyODA=","richtext":{"richtext_tags":[]},"text":"本日（１１月２０日）、高市総理は、ペルーのフジモリ大統領と会談を行いました。\n\n※両首脳による冒頭発言（速報版、仮訳）\n（高市総理）\n　フジモリ大統領の訪日を歓迎いたします。\n　日本とペルーは太平洋を隔てた友人でございます。１５０年以上の友好的な外交関係を基盤として、価値や原則を共有する戦略的パートナーでございます。\n『進化したＦＯＩＰ』の下で、各国の自律性と強靱性を高めるべく、共に協力していきたいと思っています。\n　また、共にCPTPPのメンバーとして、ルールに基づく自由で公正な経済秩序の維持・強化のために連携をしていきたいと思っております。\n　約２０万人のペルー日系社会は、両国の懸け橋でございます。日系社会との連携もより一層強化していきたいと考えております。\n　心からの歓迎の挨拶にいたします。ようこそ。\n\n（フジモリ大統領）※日本語仮訳\n　本日、閣僚、国会議員、そして我が国の大使とともに高市総理にお会いすることができ大変光栄に思います。\n　まず、ペルーが非常に困難であった時期に、長年にわたり日本から支援をいただいたことに感謝申し上げます。そして多くの日本国民の皆様が、ペルーにおける何百もの学校の建設などに協力してくださいました。この協力により、多くの若者たちが学ぶのにふさわしい環境で勉強する機会を得ることができました。そして現在、私たちがエルニーニョ現象の問題に直面する中、日本政府から、技術協力を通じ、再び寛大なご支援をいただいています。私は、これまでのすべての支援に対して感謝を伝えるために参りました。\n　また、高市総理大臣がおっしゃるとおり、貿易の開放性を維持し、日本とペルー双方にとっての機会を生み出せる場を維持することがいかに重要であるかを感じております。常にペルーを南米への玄関口とみなしていただきたいと思っています。なぜなら、ペルーには現在、新しいリマ空港、カヤオ港の改修、また、アジアと中南米の所要日数を35日間から23日間に短縮するチャンカイ港の開港といった物流拠点が整っているからです。これらは、両国が理念として支持する貿易の開放を進める上で、多くの機会を生み出し、ひいてはビジネスチャンスの拡大につながると考えています。そして、これらのビジネスチャンスは経済成長につながり、さらに多くの雇用機会を生み出します。これは、生活の質を向上させ、ペルーの貧困削減にもつながるものです。\n　さらに、高市総理大臣がおっしゃるとおり、ペルーには、日本にルーツを持つ大きな日系人コミュニティが存在します。日系人は文化、芸術、食文化を通じてペルー社会に溶け込み、今では政治の分野でも活躍しています。私の父はかつて大統領を務め、今は私自身がペルーの大統領として、国を代表する栄誉にあずかっています。\n　改めまして、感謝申し上げます。今回の訪問を機に、ペルーと日本の素晴らしい関係を新たに一層発展させていくことができると確信しております。"}}},"rest_id":"2123746952752058743","unmention_data":{},"views":{"count":"76900","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123746952752058743","sortIndex":"2124588589558792175"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profi