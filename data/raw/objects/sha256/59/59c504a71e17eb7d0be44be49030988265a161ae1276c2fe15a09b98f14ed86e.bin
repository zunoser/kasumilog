,"width":3840},"sizes":{"large":{"h":1152,"resize":"fit","w":2048},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/AHlWbINzyb","video_info":{"aspect_ratio":[16,9],"duration_millis":81066,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2111475007234981888/pl/R03YpUyQWY6C6ZHl.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111475007234981888/vid/avc1/480x270/dsLfCWsgu1DZh815.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111475007234981888/vid/avc1/640x360/yARWFz6DYuBNgkwi.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111475007234981888/vid/avc1/1280x720/RnGlPpTGQhelOyqP.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111475007234981888/vid/avc1/1920x1080/VvKA8HaB7ELqcGz5.mp4?tag=29"},{"bitrate":25128000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111475007234981888/vid/avc1/3840x2160/o_yxnCvEdNRl_03Z.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/AHlWbINzyb","expanded_url":"https://x.com/ModJapan_jp/status/2111475415282078022/video/1","ext_media_availability":{"status":"Available"},"id_str":"2111475007234981888","indices":[108,131],"media_key":"13_2111475007234981888","media_results":{"result":{"media_key":"13_2111475007234981888"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2111475007234981888/img/VJyXc-ld13PGr5p0.jpg","original_info":{"focus_rects":[],"height":2160,"width":3840},"sizes":{"large":{"h":1152,"resize":"fit","w":2048},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},