ontent_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111334638551711744/vid/avc1/640x360/7-SvZ2_25fYVJin7.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111334638551711744/vid/avc1/1280x720/a6PTdQtGHcBWe8r7.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/rctfNJyezl","expanded_url":"https://x.com/kantei/status/2111335149237657916/video/1","ext_media_availability":{"status":"Available"},"id_str":"2111334638551711744","indices":[129,152],"media_key":"13_2111334638551711744","media_results":{"result":{"media_key":"13_2111334638551711744"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2111334638551711744/img/1a8yA69CFqH8L6Ua.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/rctfNJyezl","video_info":{"aspect_ratio":[16,9],"duration_millis":218333,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2111334638551711744/pl/RaoIlcEU-zKjAd_0.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111334638551711744/vid/avc1/480x270/ZBWy7F35SWKEWqax.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111334638551711744/vid/avc1/640x360/7-SvZ2_25fYVJin7.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111334638551711744/vid/avc1/1280x720/a6PTdQtGHcBWe8r7.mp4?tag=29"}]}}]},"favorite_count":4322,"favorited":false,"full_text":"【お知らせ】\n本日（１０月１７日）、高市総理は、自衛隊殉職隊員追悼式に参列しました。\n\n※高市総理追悼の辞 (速報版) \n　令和８年度自衛隊殉職隊員追悼式にあたり、国の存立を担う崇高な職務に殉ぜられた自衛隊員の御霊に対し、ここに謹んで、追悼の誠を捧げます。 https://t.co/rctfNJyezl","id_str":"2111335149237657916","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":12,"reply_count":103,"retweet_count":558,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTEzMzUxNDkxNTc5MDQzODQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月１７日）、高市総理は、自衛隊殉職隊員追悼式に参列しました。\n\n※高市総理追悼の辞 (速報版) \n　令和８年度自衛隊殉職隊員追悼式にあたり、国の存立を担う崇高な職務に殉ぜられた自衛隊員の御霊に対し、ここに謹んで、追悼の誠を捧げます。\n\n　この度、新たに祀られた御霊は、十六柱です。\n\n　戦後最も厳しく複雑な安全保障環境にある中、自衛隊員は、「我が国の平和と独立を守り、国の安全を保つため、我が国を防衛する」という最も重要な任務を果たすため、それぞれの持ち場で昼夜を問わず真摯に職務に励んでおります。\n\n　本日顕彰させていただいた方々をはじめ、幾多の方々が、自らの職務の完遂に全身全霊を捧げ、職に殉じられました。\n\n　かけがえのない御家族を失われた御遺族の皆様の深いお悲しみを拝察致しますと、本当に胸が締めつけられる思いでございます。\n\n　最後の最後まで、自衛隊員として、強い覚悟を持って使命を全うされたその姿は、我が国の誇りであります。\n\n　かくも有為な隊員を失ったことは、自衛隊にとって、そして我が国にとって、誠に大きな痛手です。\n\n　改めて、ここに祀られた、二千百五十八柱の御霊に対し、深甚なる敬意と感謝の意を表します。\n\n　その尊い犠牲を無にすることなく、御遺志を受け継ぎ、国民の皆様の命と平和な暮らしを守り抜くために全力を尽くすことを、自衛隊の最高指揮官として、ここに固くお誓いいたします。\n\n　いま一度、御霊の安らかならんことを、そして、御遺族の御平安と、末永い御健勝を心よりお祈り申し上げます。\n\n令和８年１０月１７日\n内閣総理大臣　高市　早苗"}}},"rest_id":"2111335149237657916","unmention_data":{},"views":{"count":"86610","state":"EnabledWithCount"}}}}},"entryId":"tweet-2111335149237657916","sortIndex":"2112088178339872694"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3014235,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":586,"tweets":1874},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2111330649982242864"],"editable_until_msecs":"1792219028000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":189,"bookmarked":false,"conversation_id_str":"2111330649982242864","created_at":"Sat Oct 17 05:37:08 +0000 2026","display_text_range":[0,137],"entities":{"media":[{"allow_download_status":{"allow_downlo