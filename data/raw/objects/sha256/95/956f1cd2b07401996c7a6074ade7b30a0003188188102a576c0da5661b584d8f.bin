":false,"conversation_id_str":"2115355386484277302","created_at":"Wed Oct 28 08:10:00 +0000 2026","display_text_range":[0,144],"entities":{"hashtags":[{"indices":[136,144],"text":"交通空白解消へ"}]},"favorite_count":42,"favorited":false,"full_text":"◥◣人と荷物を同時に運ぶ！？👥📦◢◤\n\n宮崎交通とヤマト運輸が、路線バス型の公共ライドシェア「ねこみやバス」の実証運行を開始！\n\n人を乗せて路線バスと同じルートで運行しながら、車両後部には荷物を載せる貨物専用スペースが💡\n\n地域交通の確保と集配業務の効率化を目指します🚌\n#交通空白解消へ","id_str":"2115355386484277302","is_quote_status":true,"lang":"ja","quote_count":1,"quoted_status_id_str":"2112787650650513643","quoted_status_permalink":{"display":"x.com/kyushu_unyu/st…","expanded":"https://twitter.com/kyushu_unyu/status/2112787650650513643","url":"https://t.co/YJZ0EZ4kVu"},"reply_count":1,"retweet_count":15,"retweeted":false,"user_id_str":"571429134"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":634},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1145599449822986240/cucpaN2G_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1143700704982265856/1679029753"},"core":{"created_at":"Wed Jun 26 02:01:11 +0000 2019","name":"国土交通省九州運輸局","screen_name":"kyushu_unyu"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTQzNzAwNzA0OTgyMjY1ODU2","is_blue_verified":false,"location":{"location":"福岡 福岡市 博多区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"九州運輸局の公式アカウントです。\nイベント情報、バス・鉄道・船などの公共交通、観光、災害関連情報を発信しています。Instagramでも情報発信中。\n#運輸と観光で九州の元気を創ります","entities":{"description":{},"url":{"urls":[{"display_url":"wwwtb.mlit.go.jp/kyushu/","expanded_url":"http://wwwtb.mlit.go.jp/kyushu/","indices":[0,23],"url":"https://t.co/SKJpPFnJvf"}]}}},"profile_description_language