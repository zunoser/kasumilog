13138702897152"}},"media_url_https":"https://pbs.twimg.com/media/HVsaF50aUAASZlt.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1152,"w":1152,"x":0,"y":0},{"h":1152,"w":1011,"x":0,"y":0},{"h":1152,"w":576,"x":0,"y":0},{"h":1152,"w":2048,"x":0,"y":0}],"height":1152,"width":2048},"sizes":{"large":{"h":1152,"resize":"fit","w":2048},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yO6S5l8I6v"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/yO6S5l8I6v","expanded_url":"https://x.com/ModJapan_jp/status/2115314674992615717/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115313138702897152","indices":[137,160],"media_key":"3_2115313138702897152","media_results":{"result":{"media_key":"3_2115313138702897152"}},"media_url_https":"https://pbs.twimg.com/media/HVsaF50aUAASZlt.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1152,"w":1152,"x":0,"y":0},{"h":1152,"w":1011,"x":0,"y":0},{"h":1152,"w":576,"x":0,"y":0},{"h":1152,"w":2048,"x":0,"y":0}],"height":1152,"width":2048},"sizes":{"large":{"h":1152,"resize":"fit","w":2048},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yO6S5l8I6v"}]},"favorite_count":1587,"favorited":false,"full_text":"10月28日、静岡県の東富士演習場においてアメリカ陸軍が高機動ロケット砲システム（HIMARS）の射撃訓練を行いました。\n \n日本周辺の安全保障環境が厳しさを増す中、抑止力・対処力を強化し、即応性を一層高めるためには、射程が長い装備による実践的な射撃訓練が必要となります。 https://t.co/yO6S5l8I6v","id_str":"2115314674992615717","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":12,"reply_count":22,"retweet_count":246,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTUzMTQ2NzQ5NDIyNzk2ODA=","text":"10月28日、静岡県の東富士演習場においてアメリカ陸軍が高機動ロケット砲システム（HIMARS）の射撃訓練を行いました。\n \n日本周辺の安全保障環境が厳しさを増す中、抑止力・対処力を強化し、即応性を一層高めるためには、射程が長い装備による実践的な射撃訓練が必要となります。\n \n東富士演習場における今回の訓練の実施に当たっては、一般交通の安全のため、国道の一部を一時的に交通規制しました。\n地元の皆様にはご負担をおかけしましたが、防衛省として、交通規制に伴う影響をしっかりと検証するとともに、引き続き、誠実な協議と丁寧な説明を行い、ご理解をいただけるよう努めてまいります。"}}},"rest_id":"2115314674992615717","unmention_data":{},"views":{"count":"90483","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115314674992615717","sortIndex":"2116281523115130572"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go