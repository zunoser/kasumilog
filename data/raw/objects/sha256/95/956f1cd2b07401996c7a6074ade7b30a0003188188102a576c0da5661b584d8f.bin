し日ルーマニアの協力・連携を確認したほか、各国の関係者と懇談しました🇯🇵🤝🇷🇴 https://t.co/miDUGl2NXf","id_str":"2115371870531002873","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":4,"retweet_count":46,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTUzNzE4NzA0ODA3MDc1ODQ=","text":"10月27日、小田原防衛副大臣は、ルーマニア国防軍の日レセプションに出席し、ルーマニアのオヴィディウ・ラエツキ駐日大使やチョバヌ・コルネリウ武官と懇談し日ルーマニアの協力・連携を確認したほか、各国の関係者と懇談しました🇯🇵🤝🇷🇴\n\nルーマニアとの関係は、2023年に戦略的パートナーシップへと引き上げられ、日々着実に深化しています。防衛省・自衛隊 は、今後も二国間の防衛協力・交流をさらに推進していきます。"}}},"rest_id":"2115371870531002873","unmention_data":{},"views":{"count":"27577","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115371870531002873","sortIndex":"2116281523115130606"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":607},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1432867630298419206/Uez_q2Zx_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1312820383532294144/1679630740"},"core":{"created_at":"Sun Oct 04 18:22:33 +0000 2020","name":"デジタル庁","screen_name":"digital_jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzEyODIwMzgzNTMyMjk0MTQ0","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"par