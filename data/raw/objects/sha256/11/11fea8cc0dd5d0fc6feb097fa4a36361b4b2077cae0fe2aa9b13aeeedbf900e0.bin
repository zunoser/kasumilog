"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04292.html","indices":[213,236],"url":"https://t.co/pmhz1mmiaO"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDk5NTE0NTQ2MDE3MjM5MDU=","richtext":{"richtext_tags":[]},"text":"サウジアラビアのリヤドにおいて、第17回国際エネルギー・フォーラム（IEF）閣僚級会合が開催されました。我が国からは、赤澤経済産業大臣がオンラインで出席したほか、森野駐サウジアラビア大使が現地で参加し、堀井外務副大臣のステートメントを代読しました。\n本閣僚級会合では、新時代のエネルギー安全保障と共通の目標を全体テーマに、エネルギー安全保障や持続可能なエネルギー・ソリューションへの投資と貿易等について議論が行われました。\n\nhttps://t.co/pmhz1mmiaO"}}},"rest_id":"2109951454719197625","unmention_data":{},"views":{"count":"10738","state":"EnabledWithCount"}}}}},"entryId":"tweet-2109951454719197625","sortIndex":"2110251552827506632"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/p5uA86gN9qE","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":627,"url":"https://pbs.twimg.com/card_img/2109948037703589888/uD_B1KG0?format=jpg&name=1200x627","width":1200},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":210,"url":"https://pbs.twimg.com/card_img/2109948037703589888/uD_B1KG0?format=jpg&name=280x280","width":280},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66558","type":"STRING"}},{"key":"description","value":{"string_value":"Enjoy the videos and music you love, upload original content, and share it all with friends, family, and the world on YouTube.","type":"STRING"}},{"key":"player_width","value"