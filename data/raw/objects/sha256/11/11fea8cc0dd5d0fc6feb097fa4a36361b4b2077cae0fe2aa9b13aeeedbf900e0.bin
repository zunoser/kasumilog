rig":{"faces":[]},"small":{"faces":[]}},"id_str":"2109928592725757952","indices":[88,111],"media_key":"3_2109928592725757952","media_results":{"result":{"media_key":"3_2109928592725757952"}},"media_url_https":"https://pbs.twimg.com/media/HUf44E7b0AA6NAn.jpg","original_info":{"focus_rects":[{"h":1729,"w":3088,"x":0,"y":139},{"h":2056,"w":2056,"x":0,"y":0},{"h":2056,"w":1804,"x":101,"y":0},{"h":2056,"w":1028,"x":489,"y":0},{"h":2056,"w":3088,"x":0,"y":0}],"height":2056,"width":3088},"sizes":{"large":{"h":1364,"resize":"fit","w":2048},"medium":{"h":799,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EhX8MYMjBG"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/EhX8MYMjBG","expanded_url":"https://x.com/takaichi_sanae/status/2109935799437582734/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2109928592692142080","indices":[88,111],"media_key":"3_2109928592692142080","media_results":{"result":{"media_key":"3_2109928592692142080"}},"media_url_https":"https://pbs.twimg.com/media/HUf44Eza4AA3d-2.jpg","original_info":{"focus_rects":[{"h":755,"w":1348,"x":0,"y":0},{"h":1229,"w":1229,"x":0,"y":0},{"h":1229,"w":1078,"x":33,"y":0},{"h":1229,"w":615,"x":265,"y":0},{"h":1229,"w":1348,"x":0,"y":0}],"height":1229,"width":1348},"sizes":{"large":{"h":1229,"resize":"fit","w":1348},"medium":{"h":1094,"resize":"fit","w":1200},"small":{"h":620,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EhX8MYMjBG"}]},"favorite_count":22437,"favorited":false,"full_text":"秋の味覚、さつまいもの季節になりました。\n江戸時代の焼き芋屋には「栗（9里）より（4里）うまい十三里」ということで、さつまいもを「十三里」と呼んで売るところがあったそうです。 https://t.co/EhX8MYMjBG","id_str":"2109935799437582734","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1095,"reply_count":2465,"retweet_count":2360,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDk5MzU3OTkzNDk1MDE5NTI=","richtext":{"richtext_tags":[]},"text":"秋の味覚、さつまいもの季節になりました。\n江戸時代の焼き芋屋には「栗（9里）より（4里）うまい十三里」ということで、さつまいもを「十三里」と呼んで売るところがあったそうです。\n\n本日13日は、今が旬のさつまいもが、高市内閣の目指す｢稼げる農林水産業・食品産業｣や｢農林水産物・食品の輸出拡大｣と関わっているというお話です。\n\nかつては、さつまいもと言えば、ほっくりとした食感の「ベニアズマ」等が主流でした。\nこれに対し、近年、甘くねっとりした「べにはるか」等の品種が登場し、店舗での焼き芋機の普及と合わせ、焼き芋ブームが広がりました。\nスーパーに行くと、入ってすぐに焼き芋機をみることも多く、甘くて香ばしい香りについつい手が伸びてしまう方も多いのではないでしょうか。\n\n「べにはるか」以降も、鮮やかなオレンジ色の「ハロウィンスイート」、紫色の果肉で料理に彩りを添える「ふくむらさき」など、用途に応じた多彩な品種が生まれ、付加価値向上を通じて｢稼げる農林水産業・食品産業｣にも貢献しています。\n\nまた、さつまいもは、我が国の「輸出重点品目」として海外でも人気を集めており、甘くて美味しい日本産焼き芋はアジアを中心に世界で高い評価を受け、輸出額がこの10年で約7.5倍と大きく増加し、｢農林水産物・食品の輸出拡大｣にも貢献しています。\n\n高市内閣は、｢稼げる農林水産業・食品産業｣や｢農林水産物・食品の輸出拡大｣を実現しつつ、消費者の皆様にも美味しいさつまいもを届けられるよう、「新品種の開発」や「生産体制の強化」を通じ、産地の発展を後押ししてまいります。"}}},"rest_id":"2109935799437582734","unmention_data":{},"views":{"count":"784235","state":"EnabledWithCount"}}}}},"entryId":"tweet-2109935799437582734","sortIndex":"2110251552827506624"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","scre