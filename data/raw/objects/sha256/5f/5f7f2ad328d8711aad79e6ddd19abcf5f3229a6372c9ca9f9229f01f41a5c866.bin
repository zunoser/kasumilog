66401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[196,208],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTMyMTg1ODM3NzM5NzA0MzI=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、島根原子力発電所2号機でのプルサーマルに関して、鳥取県の平井知事と面談。同発電所の安全確保、使用済燃料の再処理や最終処分の確実な実施について、国が責任をもって取り組むこと、プルサーマルなどの核燃料サイクルの確立に向けた対応状況を県民に分かりやすく説明すること、といったご要望をいただきました。経済産業省としても、いただいたご要望をしっかりと受け止め、必要な対応を行ってまいります。#meti_daijin"}}},"rest_id":"2113218583824326712","unmention_data":{},"views":{"count":"7311","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113218583824326712","sortIndex":"2113288628460322813"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1907032035689996327"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」