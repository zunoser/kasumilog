から人権DDの取組の開示を求められたけど、どう対応したらいいだろう… https://t.co/0CyrJ2SVV5","id_str":"2104799580353405013","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":4,"retweet_count":19,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/fp/hr_ha…","expanded_url":"https://www.mofa.go.jp/mofaj/fp/hr_ha/page22_001608_00001.html","indices":[290,313],"url":"https://t.co/UdIyl7lWFR"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ3OTk1ODAyMjc1MDYxNzY=","richtext":{"richtext_tags":[]},"text":"／\n📢外務省主催【知識を実践へ落とし込む！「ビジネスと人権」実務セミナー】を名古屋で開催します！\n＼\n💬社内で人権課題に取り組み始めたけど、社内の理解を得ながらどうやって進めればいいのか…\n💬海外の取引先から人権DDの取組の開示を求められたけど、どう対応したらいいだろう…\n✅そんなお悩みを持つ企業様向けに、外務省主催で、企業の人権対応を他社のリアルな取組事例から学ぶセミナーを名古屋にてハイブリッド形式で開催します。ビジネスと人権に取り組み始めたばかりの企業様や、取組方に悩んでいる企業様は、ぜひ御参加ください！\n●開催日：2026年10月29日(木)於:名古屋　\n●申込方法：https://t.co/UdIyl7lWFR\n●対面・オンラインのハイブリッド開催"}}},"rest_id":"2104799580353405013","unmention_data":{},"views":{"count":"22741","state":"EnabledWithCount"}}},"rest_id":"2113077785145323527","unmention_data":{},"views":{"count":"7974","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113077785145323527","sortIndex":"2113288628460322733"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs