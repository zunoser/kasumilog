x.com/UbpAl8oCye","expanded_url":"https://x.com/gov_online/status/2118508669864448084/photo/1","ext_alt_text":"１１月８日（日曜日）放送テーマは、「みんなで支えよう。体罰などによらない子育て」。番組パーソナリティの杉浦太陽さん、松井玲奈さんがこども家庭庁のパネルを持って並んで立っている。松井玲奈さんが持つパネルには、「「ぎゃくたいかも」と思ったら、“いちはやく”お電話を」、「小さくてもいい　その声をどうか、いちはちきゅうに届けてください」、「親や子の支援につながる電話です」と書かれ、「いちはちきゅう番、いちはやく」に糸電話するイラストが描かれている。杉浦太陽さんが持つパネルには、「親子をささえるLINEです。」、「誰にも言えない家族のモヤモヤに寄り添います」、「まずはLINEともだち登録を」と書かれ、「相談LINE」に連絡するイラストが描かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":237,"w":237,"x":549,"y":351},{"h":227,"w":227,"x":1281,"y":237}]},"medium":{"faces":[{"h":139,"w":139,"x":322,"y":206},{"h":133,"w":133,"x":750,"y":139}]},"orig":{"faces":[{"h":348,"w":348,"x":805,"y":515},{"h":333,"w":333,"x":1877,"y":348}]},"small":{"faces":[{"h":78,"w":78,"x":182,"y":116},{"h":75,"w":75,"x":425,"y":78}]}},"id_str":"2118179428178313216","indices":[168,191],"media_key":"3_2118179428178313216","media_results":{"result":{"media_key":"3_2118179428178313216"}},"media_url_https":"https://pbs.twimg.com/media/HWVI96MbwAAB9oW.jpg","original_info":{"focus_rects":[{"h":1680,"w":3000,"x":0,"y":1320},{"h":3000,"w":3000,"x":0,"y":0},{"h":3000,"w":2632,"x":0,"y":0},{"h":3000,"w":1500,"x":375,"y":0},{"h":3000,"w":3000,"x":0,"y":0}],"height":3000,"width":3000},"sizes":{"large":{"h":2048,"resize":"fit","w":2048},"medium":{"h":1200,"resize":"fit","w":1200},"small":{"h":680,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/UbpAl8oCye"},{"display_url":"pic.x.com/UbpAl8oCye","expanded_url":"https://x.com/gov_online/status/2118508669864448084/photo/1","ext_alt_text":"番組収録時の一コマとして、杉浦太陽さんと松井玲奈さんが今回のテーマの特に注目したことやイラストをスケッチブックにかき、「成長日誌」を作成している写真。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2118179521958694912","indices":[168,191],"media_key":"3_2118179521958694912","media_results":{"result":{"media_key":