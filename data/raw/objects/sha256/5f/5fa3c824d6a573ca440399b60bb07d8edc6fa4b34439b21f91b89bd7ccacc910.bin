2AORjY2","id_str":"2118569065128013983","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"quoted_status_id_str":"2067193781309628457","quoted_status_permalink":{"display":"x.com/ModJapan_jp/st…","expanded":"https://twitter.com/ModJapan_jp/status/2067193781309628457","url":"https://t.co/wNuAG9XEx2"},"reply_count":1,"retweet_count":43,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg1NjkwNjUwODE4NzIzODQ=","text":"【家族と過ごす時間を大切に👪】\n\n11月15日は防衛省の「家族の日」、11月8日～21日は「家族の週間」です。\n\n日々、様々な場所で任務にあたる自衛隊員。\n\nその一人ひとりを一番身近で支えてくださっている御家族も、我が国の防衛を支える大切な一員です。\n\n日頃から隊員を支えてくださる御家族への感謝と、これからの家族支援への思いを、小泉防衛大臣から動画メッセージでお届けします。\n\nぜひ御覧ください。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"faceboo