"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2116683491505225728/NqVvBjZt?format=jpg&name=orig","width":150},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2116683491505225728/NqVvBjZt?format=jpg&name=144x144","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"2026年10月30日秋の味覚であるギンナンはイチョウ（学名︓Ginkgo biloba）の種⼦で、9月から11月頃に旬を迎えます。でんぷん、カロテン、ビタミンCなどを含む栄養価の高い食材ですが、⼀度に⾷べ過ぎると有毒成分である4ʼ-O-メチルピリドキシンにより嘔吐やけいれんなどの中毒症状が出現することがあります。中毒110番では、秋になるとギンナンに関する相談が増加します。事故防止のために...","type":"STRING"}},{"key":"domain","value":{"string_value":"www.j-poison-ic.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":627,"url":"https://pbs.twimg.com/card_img/2116683491505225728/NqVvBjZt?format=jpg&name=1200x627","width":1200},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2116683491505225728/NqVvBjZt?format=jpg&name=orig","width":150},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2116683491505225728/NqVvBjZt?format=jpg&name=orig","width":150},"type":"IMAGE"}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2116683491505225728/NqVvBjZt?format=jpg&name=orig","width":150},"type":"IMAGE"}},{"key":"summary_photo_image_large","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2116683491505225728/NqVvBjZt?format=jpg&name=orig","width":150},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2116683491505225728/NqVvBjZt?format=jpg&name=100x100","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card