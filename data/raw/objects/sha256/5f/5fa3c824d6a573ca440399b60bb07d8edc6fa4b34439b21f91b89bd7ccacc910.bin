h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/8ExhFfLkXi"}]},"favorite_count":6429,"favorited":false,"full_text":"【隊員の御家族も大切にする防衛省・自衛隊であるために👪】\n\n防衛力の中核は自衛隊員であり、その隊員の御家族も日本の防衛を支える大切な一員です。 https://t.co/8ExhFfLkXi","id_str":"2067193781309628457","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":126,"reply_count":103,"retweet_count":1327,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwNjcxOTM3ODEyNTkzMDkwNTY=","text":"【隊員の御家族も大切にする防衛省・自衛隊であるために👪】\n\n防衛力の中核は自衛隊員であり、その隊員の御家族も日本の防衛を支える大切な一員です。\n\nこのため、防衛省の全職員が家族の大切さを確認するとともに、職員を日頃から支える御家族に防衛省・自衛隊として感謝や敬意を示すため、毎年11月第3日曜日を防衛省の「家族の日」、その前後1週間を「家族の週間」として新たに設定しました。\n\n今後、「家族の週間」（11/8～21）に向けて、全職員に対して家族の大切さについて理解を深める取組を進めてまいります。"}}},"rest_id":"2067193781309628457","unmention_data":{},"views":{"count":"188751","state":"EnabledWithCount"}}},"rest_id":"2118569065128013983","unmention_data":{},"views":{"count":"17602","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118569065128013983","sortIndex":"2118598293196898271"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/649hBj8f2Q"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1595652744500908032/vw4r2sfI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/