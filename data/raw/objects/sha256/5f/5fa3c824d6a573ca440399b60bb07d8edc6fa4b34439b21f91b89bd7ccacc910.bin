ted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2117814260235698469"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39767,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":101,"tweets":484},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2118525882503696485"],"editable_until_msecs":"1793934505000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2118525882503696485","created_at":"Fri Nov 06 02:08:25 +0000 2026","display_text_range":[0,133],"entities":{},"favorite_count":191,"favorited":false,"full_text":"【11月6日　小泉防衛大臣会見】\n冒頭、海賊対処行動、情報収集活動及び多国籍部隊・監視団（MFO）への司令部要員の活動期間の延長、日ベトナム防衛相会談の実施について発表しました。\n \nその他、\n○アメリカ中間選挙\n○沖縄政策協議会\n○16式機動戦闘車（MCV）の配備","id_str":"2118525882503696485","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":3,"retweet_count":35,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/SNJ_Yo1mFR4?si…","expanded_url":"https://youtu.be/SNJ_Yo1mFR4?si=3oEPRELT4bMbxQAC","indices":[1151,1174],"url":"https://t.co/lSPMAk8jzw"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg1MjU4ODIzMjc1Mjc0MjQ=","text":"【11月6日　小泉防衛大臣会見】\n冒頭、海賊対処行動、情報収集活動及び多国籍部隊・監視団（MFO）への司令部要員の活動期間の延長、日ベトナム防衛相会談の実施について発表しました。\n \nその他、\n○アメリカ中間選挙\n○沖縄政策協議会\n○16式機動戦闘車（MCV）の配備\nなどに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「本日、国家安全保障会議及び閣議において、次の３件について活動期間の１年延長が決定されました。１件目はソマリア沖・アデン湾における海賊対処行動、２件目は中東地域における情報収集活動、３件目はシナイ半島における多国籍部隊・監視団（ＭＦＯ）への司令部要員の派遣です。\n \nまず、海賊対処については、我が国をはじめ、国際社会の取組により、海賊事案はピーク時に比べ低い水準で推移しています。しかし、海賊を生み出す根本的な原因の解決には至っておらず、引き続き、海上交通路における航行の安全確保に万全を期すため、海賊対処行動を実施していく必要があります。\n \nまた、日本の原油輸入の多くを支える中東地域において、航行の安全を確保することは非常に重要です。同地域では、本年に入ってから情勢の悪化に伴い、緊張状態が継続していることから、引き続き、日本関係船舶の安全確保のための情報収集活動を継続することが必要です。\n \nさらに、ＭＦＯへの司令部要員の派遣については、我が国の平和と繁栄の土台である中東の平和と安定に資する活動であり、アメリカ等の他の要員派遣国１３か国との連携の促進や人材育成の機会の確保等の観点から、継続する意義があるものです。\n \n防衛省・自衛隊としては、引き続き、これらの活動を通じて日本関係船舶の安全確保に取り組むとともに、国際社会の平和と安定に貢献してまいります。\n \n冒頭２件目は、来週１１月８日から１１日まで、ベトナムのトー・ラム書記長兼国家主席の訪日に合わせ、ベトナムのファン・ヴァン・ザン副首相兼国防大臣が訪日し、９日には日・ベトナム防衛相会談を実施する予定です。\n \nザン大臣とは、７月の東京での防衛相会談と、先週のフィリピンで開催されたＡＤＭＭプラスの際に実施した会談に続いて、３回目の会談となります。\n \nベトナムは、我が国と基本的な価値や原則を共有する包括的・戦略的パートナーであり、防衛大臣同士が、このように定期的に対面でのコミュニケーションの機会を持つことは大変重要だと思っています。\n \n防衛相会談では、人的交流や防衛装備・技術協力をはじめ、今後の日・ベトナム防衛協力について率直で具体的な議論を行う予定です。また、ザン大臣との信頼関係の下、日・ベトナム間の防衛協力を一層強固なものにしていきます。冒頭は以上です。」\n \n↓動画はこちら\nhttps://t.co/lSPMAk8jzw"}}},"rest_id":"2118525882503696485","unmention_data":{},"views":{"count":"17533","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2118526268081840524","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"3312","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118526268081840524","sortIndex":"2118598293196898236"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2116635098196193280/k1UjBsQX?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.fsa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2116635098196193280/k1UjBsQX?format=png&name=420x420_2","width":400},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2116635098196193280/k1UjBsQX?format=png&name=orig","width":401},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"276848601","path":[]}}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2116635098196193280/k1UjBsQX?format=png&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2116635098196193280/k1UjBsQX?format=png&name=2048x2048_