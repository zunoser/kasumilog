_count":21,"bookmarked":false,"conversation_id_str":"2118531319558766737","created_at":"Fri Nov 06 02:30:01 +0000 2026","display_text_range":[0,138],"entities":{"media":[{"display_url":"pic.x.com/n46e1Zs3yq","expanded_url":"https://x.com/gov_online/status/2118531319558766737/photo/1","ext_alt_text":"上部に「その電話、本当に警察官ですか？増加する「ニセ警察詐欺」に注意！」と記載されており、その下に、「本物の警察は、しません！」と記載され、警察をかたる詐欺の見分け方を示したイラストがある。イラストには次のように記載されている。「捜査や逮捕の情報を電話で伝えません。ビデオ通話をかけません。SNSで連絡をとりません。警察手帳や逮捕状の画像を送りません。金融機関への送金を指示しません。暗号資産や金などを要求しません。少しでも怪しいと感じたら、すぐに電話やビデオ通話を切ることが大切です。最寄りの警察署、警察相談専用電話「シャープキューイチイチゼロ」にご連絡ください。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2118160201136377856","indices":[139,162],"media_key":"3_2118160201136377856","media_results":{"result":{"media_key":"3_2118160201136377856"}},"media_url_https":"https://pbs.twimg.com/media/HWU3ev4akAAtF0R.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":198},{"h":900,"w":900,"x":0,"y":0},{"h":1026,"w":900,"x":0,"y":0},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/n46e1Zs3yq"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/n46e1Zs3yq","expanded_url":"https://x.com/gov_online/status/2118531319558766737/photo/1","ext_alt_text":"上部に「その電話、本当に警察官ですか？増加する「ニセ警察詐欺」に注意！」と記載されており、その下に、「本物の警察は、しません！」と記載され、警察をかたる詐欺の見分け方を示したイラストがある。イラストには次のように記載されている。「捜査や逮捕の情報を電話で伝えません。ビデオ通話をかけません。SNSで連絡をとりません。警察手帳や逮捕状の画像を送りません。金融機関への送金を指示しません。暗号資産や金などを要求しません。少しでも怪しいと感じたら、すぐに電話やビデオ通話を切ることが大切です。最寄りの警察署、警察相談専用電話「シャープキューイチイチゼロ」にご連絡ください。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2118160201136377856","indices":[139,162],"media_key":"3_2118160201136377856","media_results":{"result":{"media_key":"3_2118160201136377856"}},"media_url_https":"https://pbs.twimg.com/media/HWU3ev4akAAtF0R.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":198},{"h":900,"w":900,"x":0,"y":0},{"h":1026,"w":900,"x":0,"y":0},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/n46e1Zs3yq"}]},"favorite_count":118,"favorited":false,"full_text":"「ニセ警察詐欺」に注意🚨\n\n警察官を名乗る人物から突然電話があり、お金を振り込ませたり、個人情報を聞きだしたりする被害が増えています。\n\n被害は高齢者だけでなく、幅広い年代に及んでいます。\n\n安易に「本物」と判断せず、少しでも怪しいと感じたら、すぐに電話を切ることが大切です。 https://t.co/n46e1Zs3yq","id_str":"2118531319558766737","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":0,"retweet_count":90,"retweeted":false,"user_id_str":"461064204"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"gov-online.go.jp/article/202610…","expanded_url":"https://www.gov-online.go.jp/article/202610/entry-11718.html","indices":[139,162],"url":"https://t.co/CjFxPdwefV"}],"user_mentions":[{"id_str":"2891516809","indices":[163,172],"name":"警察庁","screen_name":"NPA_KOHO"}]},"id":"Tm90ZVR3ZWV0OjIxMTg1MzEzMTkyMzU3Mzk2NTA=","text":"「ニセ警察詐欺」に注意🚨\n\n警察官を名乗る人物から突然電話があり、お金を振り込ませたり、個人情報を聞きだしたりする被害が増えています。\n\n被害は高齢者だけでなく、幅広い年代に及んでいます。\n\n安易に「本物」と判断せず、少しでも怪しいと感じたら、すぐに電話を切ることが大切です。\nhttps://t.co/CjFxPdwefV\n@NPA_KOHO"}}},"rest_id":"2118531319558766737","unmention_data":{},"views":{"count":"6062","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118531319558766737","sortIndex":"2118598293196898241"},{"content":{"__typename":"TimelineTimelineItem","clientEventInf