撤収セレモニーを開催いただきました。\n末松・宇城市長からは、「皆さんからいただいたご支援は決して忘れることはありません」との温かいお言葉をいただきました。\n活動期間中、被災者の皆様から寄せられた「ありがとう」の言葉は、隊員たちの大きな励みとなりました。\n防衛省・自衛隊の活動を支えてくださった、すべての宇城市民の皆様に心から感謝申し上げます。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2455},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182592351472013314/X9jVEv2u_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1182556649120075776/1570786963"},"core":{"created_at":"Fri Oct 11 07:21:20 +0000 2019","name":"防衛省・自衛隊（災害対策）","screen_name":"ModJapan_saigai"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTgyNTU2NjQ5MTIwMDc1Nzc2","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省・自衛隊の災害対策公式アカウント／災害派遣活動や災害対策に関する最新情報をお届けします。皆さまの安全と暮らしを守るため、災害現場で対応する部隊・隊員たちの姿を迅速にお伝えしていきます。\n災害派遣以外の自衛隊の活動は、統合幕僚監部のアカウントで発信中　https://t.co/P7BIrjGuU5","entities":{"description":{"urls":[{"display_url":"x.com/jointstaffpa","expanded_url":"https://x.com/jointstaffpa","indices":[128,151],"url":"https://t.co/P7BIrjGuU5"}]},"url":{"urls":[{"display_url":"mod.go.jp/js/activity/do…","expanded_url":"https://www.mod.go.jp/js/activity/domestic.html","indices":[0,23],"url":"https://t.co/7Fx4sySSJE"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":262023,"following":24},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"11825566491200