bs.twimg.com/amplify_video_thumb/2099136216805625856/img/vRfcgAttDtoTlR9u.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/FIHhfES8Kp","video_info":{"aspect_ratio":[16,9],"duration_millis":69824,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2099136216805625856/pl/iO8IWhINJoMwJSi1.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099136216805625856/vid/avc1/480x270/fKGxjJuOJwEE9w6z.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099136216805625856/vid/avc1/640x360/_H0qdGlH5dqhOf8d.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099136216805625856/vid/avc1/1280x720/95GzUKJfSk4ocg8t.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/FIHhfES8Kp","expanded_url":"https://x.com/ModJapan_saigai/status/2099136262296969508/video/1","ext_media_availability":{"status":"Available"},"id_str":"2099136216805625856","indices":[137,160],"media_key":"13_2099136216805625856","media_results":{"result":{"media_key":"13_2099136216805625856"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2099136216805625856/img/vRfcgAttDtoTlR9u.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/FIHhfES8Kp","video_info":{"aspect_ratio":[16,9],"duration_millis":69824,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2099136216805625856/pl/iO8IWhINJoMwJSi1.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099136216805625856/vid/avc1/480x270/fKGxjJuOJwEE9w6z.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099136216805625856/vid/avc1/640x360/_H0qdGlH5dqhOf8d.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099136216805625856/vid/avc1/1280x720/95GzUKJfSk4ocg8t.mp4?tag=29"}]}}]},"favorite_count":10244,"favorited":false,"full_text":"9月13日、熊本県知事から災害派遣の撤収要請を受け、自衛隊は活動を終了しました。\n\n防衛省・自衛隊は、発災直後から人命救助や行方不明者の捜索、給水・入浴支援、物資輸送などに取り組み、「できることは全てやる」との決意の下、最大約5,100人態勢で全力を尽くしてまいりました。 https://t.co/FIHhfES8Kp","id_str":"2099136262296969508","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":154,"reply_count":224,"retweet_count":2427,"retweeted":false,"user_id_str":"1182556649120075776"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTkxMzYyNjIyMzQxMTYwOTY=","richtext":{"richtext_tags":[]},"text":"9月13日、熊本県知事から災害派遣の撤収要請を受け、自衛隊は活動を終了しました。\n\n防衛省・自衛隊は、発災直後から人命救助や行方不明者の捜索、給水・入浴支援、物資輸送などに取り組み、「できることは全てやる」との決意の下、最大約5,100人態勢で全力を尽くしてまいりました。\n\nまた、自治体や関係省庁、民間企業、米軍をはじめ、多くの方々と連携しながら支援活動を実施しました。\nご協力いただいた全ての関係者の皆様に、深く感謝申し上げます。\n\n防衛省・自衛隊は、被災された皆様が一日も早く平穏な生活を取り戻されることを心より願うとともに、今後もあらゆる事態に即応できるよう万全を期してまいります。"}}},"rest_id":"2099136262296969508","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"622140","state":"EnabledWithCount"}}},"rest_id":"2099807772938485896","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"93568","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2099809655224713370","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4326","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099809655224713370","sortIndex":"2100017074788106234"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0