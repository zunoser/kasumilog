732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"mod.go.jp/j/profile/memo…","expanded_url":"https://www.mod.go.jp/j/profile/memorial_zone/index.html","indices":[227,250],"url":"https://t.co/ZIsTexS3qu"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk3MDk4MDAyNDYyOTI0ODA=","text":"防衛省市ヶ谷地区（東京都）に所在する自衛隊殉職者慰霊碑地区（メモリアルゾーン）を、10月29日（木）に一般公開いたします。\n一般公開は本年7月の公開に続き、2回目の実施となります。\n \n自衛隊殉職者慰霊碑は、尊い命を国家に捧げた殉職隊員の功績を永久に顕彰し、深甚なる敬意と哀悼の意を捧げることを目的に建立されたものです。\n \n事前申し込み制で、申し込み多数の場合には抽選となります。\n \n⇊お申し込みや詳細はこちら（本日～９/25（金）18:00締切）\nhttps://t.co/ZIsTexS3qu"}}},"rest_id":"2099709800351154322","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"51805","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099709800351154322","sortIndex":"2100017074788106162"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notificatio