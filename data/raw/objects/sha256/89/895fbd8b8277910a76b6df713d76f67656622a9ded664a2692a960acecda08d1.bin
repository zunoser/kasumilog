ssibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":587160,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20166,"tweets":48838},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2099755423549346086"],"editable_until_msecs":"1789459279000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":69,"bookmarked":false,"conversation_id_str":"2099755423549346086","created_at":"Tue Sep 15 07:01:19 +0000 2026","display_text_range":[0,108],"entities":{},"favorite_count":116,"favorited":false,"full_text":"令和8（2026）年9月10日に実施した「『たびレジ』及び在留届に関する広報動画の公開」及び「官民合同テロ・誘拐対策実施訓練（国内）」に関する外務省報道発表における犯人役の写真について、様々な発信がなされております。","id_str":"2099755423549346086","is_quote_status":true,"lang":"ja","quote_count":257,"quoted_status_id_str":"2097981094427795788","quoted_status_permalink":{"display":"x.com/MofaJapan_jp/s…","expanded":"https://twitter.com/MofaJapan_jp/status/2097981094427795788","url":"https://t.co/USj3ekxVLV"},"reply_count":100,"retweet_count":95,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/ca/ss/pa…","expanded_url":"https://www.mofa.go.jp/mofaj/ca/ss/pageit_000001_03196.html","indices":[475,498],"url":"https://t.co/mfjZKAzd1g"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk3NTU0MjM0MTA4MjcyNjQ=","richtext":{"richtext_tags":[]},"text":"令和8（2026）年9月10日に実施した「『たびレジ』及び在留届に関する広報動画の公開」及び「官民合同テロ・誘拐対策実施訓練（国内）」に関する外務省報道発表における犯人役の写真について、様々な発信がなされております。\n今回の訓練における犯人役については、日本人及び外国人で構成される等、その衣装を含め特定の民族や地域、宗教等を念頭に置いたものではありません。誤解が生じたとすれば全く本意ではありませんので、関連の写真を削除することといたします。\n「官民合同テロ・誘拐対策実施訓練（国内）」については、緊急事態発生時における官と民の連携強化を目的に、平成28（2016）年7月のダッカ襲撃テロ事件の教訓を踏まえ、中堅・中小企業関係者を主な対象として平成30（2018）年から国内における訓練を、毎年実施しているものです。海外に渡航・滞在する邦人への脅威が多様化する中で、当該訓練の意義は益々重要になっているものと認識しており、先般当該訓練を実施したものです。\n海外邦人の保護は外務省の最重要責務の一つであり、今後とも引き続き全力を尽くして参ります。\n\nhttps://t.co/mfjZKAzd1g"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2097855073892147218"]},"possibly_sensitive":false,"pr