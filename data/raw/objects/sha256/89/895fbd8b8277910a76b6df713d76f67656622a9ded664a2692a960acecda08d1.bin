/docs/news/press_20260902_1.pdf","indices":[333,356],"url":"https://t.co/H95arW9Xia"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTUwMTk4NjU4NzAzNDQxOTU=","richtext":{"richtext_tags":[]},"text":"／ \nトゥンクトゥンクカラーに染まる、東京の夜景🌙\n東京スカイツリー® 特別ライティングが決定！\n＼\n\n世界有数のランドマークである東京スカイツリー®と\nトゥンクトゥンクとのコラボが決定しました⭐\n\nトゥンクトゥンクをイメージした、\nグリーン・ブルー・ピンク・イエローの４色で彩った\n東京スカイツリー®の特別ライティングを点灯します。\n\n気になる点灯日時は…👀\n・開幕約半年前  2026年9月15日(火)19：00～24：00\n・開幕100日前   2026年12月9日(水)17：30～24：00\n・開幕当日  　　2027年3月19日(金)18：45～24：00\n\nGREEN×EXPO 2027の記念日に、特別な一夜をお楽しみください😊\n\n詳しくはこちら\n👉https://t.co/H95arW9Xia\n\n現在、トゥンクトゥンク推し活キャンペーンを実施中！\n#トゥン活 #トゥンクトゥンク応援団 の２つのハッシュタグをつけて、\n東京スカイツリー®を背景にみなさんが撮影したトゥンクトゥンクの写真を、ぜひ投稿してね！\n\n#withGREENEXPO\n#2027年国際園芸博覧会\n#greenexpo2027\n#トゥンクトゥンク\n#トゥン活\n#トゥンクトゥンク応援団"}}},"previous_counts":{"bookmark_count":0,"favorite_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"rest_id":"2095019866038091876","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"102692","state":"EnabledWithCount"}}},"rest_id":"2099800652402528337","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"39912","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099800652402528337","sortIndex":"2100017074788106226"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://p