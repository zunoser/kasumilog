"y":269},{"h":111,"w":111,"x":1737,"y":383}]},"medium":{"faces":[{"h":46,"w":46,"x":575,"y":271},{"h":50,"w":50,"x":826,"y":166},{"h":48,"w":48,"x":546,"y":157},{"h":65,"w":65,"x":1018,"y":224}]},"orig":{"faces":[{"h":101,"w":101,"x":1246,"y":589},{"h":109,"w":109,"x":1790,"y":360},{"h":104,"w":104,"x":1183,"y":342},{"h":142,"w":142,"x":2206,"y":487}]},"small":{"faces":[{"h":26,"w":26,"x":325,"y":154},{"h":28,"w":28,"x":468,"y":94},{"h":27,"w":27,"x":309,"y":89},{"h":37,"w":37,"x":576,"y":127}]}},"id_str":"2099808116351406080","indices":[55,78],"media_key":"3_2099808116351406080","media_results":{"result":{"media_key":"3_2099808116351406080"}},"media_url_https":"https://pbs.twimg.com/media/HSQEW0ebkAAGUKM.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":282,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EO40WDnwfd"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/EO40WDnwfd","expanded_url":"https://x.com/takaichi_sanae/status/2099808235113136511/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2099808136689553409","indices":[55,78],"media_key":"3_2099808136689553409","media_results":{"result":{"media_key":"3_2099808136689553409"}},"media_url_https":"https://pbs.twimg.com/media/HSQEYAPbEAEk89r.jpg","original_info":{"focus_rects":[{"h":358,"w":640,"x":0,"y":93},{"h":480,"w":480,"x":160,"y":0},{"h":480,"w":421,"x":219,"y":0},{"h":480,"w":240,"x":312,"y":0},{"h":480,"w":640,"x":0,"y":0}],"height":480,"width":640},"sizes":{"large":{"h":480,"resize":"fit","w":640},"medium":{"h":480,"resize":"fit","w":640},"small":{"h":480,"resize":"fit","w":640},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EO40WDnwfd"}]},"favorite_count":9433,"favorited":false,"full_text":"本日、「防災功労者　内閣総理大臣表彰式」を開催し、16名の個人と25の団体の皆様を表彰させていただきました。 https://t.co/EO40WDnwfd","id_str":"2099808235113136511","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":48,"reply_count":614,"retweet_count":855,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk4MDgyMzUwNTQ0MTU4NzI=","richtext":{"richtext_tags":[]},"text":"本日、「防災功労者　内閣総理大臣表彰式」を開催し、16名の個人と25の団体の皆様を表彰させていただきました。\n\n「防災功労者表彰」を受けられた皆様は、様々な災害に際し、危険や困難に直面しながらも、ひるむことなく、人命救助、住民の安全確保などに取り組まれた方々、また、防災に関する講習会の開催や地域の防災訓練の実施などに尽力され、災害による被害の防止・軽減に大きく寄与された方々です。\n\nそのご貢献、ご労苦に対し、心より敬意を表しますとともに、深く感謝申し上げます。\n\n災害への対応に万全を期すためには、全ての関係者の皆様の知恵と力を結集して、取り組む必要があり、「産官学民」の連携が不可欠です。\n\n表彰を受けられた皆様が、それぞれの分野において、益々ご活躍されることをお祈り致しますとともに、災害に強い国づくりに、一層ご尽力いただけますよう、お願い申し上げたところです。\n\n※熊本市消防団の皆様から、可愛らしい手作りの人形がついたキーホルダーを頂戴しました。\n大切にいたします。ありがとうございました。"}}},"rest_id":"2099808235113136511","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"244721","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099808235113136511","sortIndex":"2100017074788106232"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_