ties":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/CWaiAZXdeW","expanded_url":"https://x.com/kantei/status/2099799205980336267/video/1","ext_media_availability":{"status":"Available"},"id_str":"2099798489802960896","indices":[100,123],"media_key":"13_2099798489802960896","media_results":{"result":{"media_key":"13_2099798489802960896"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2099798489802960896/img/8jZ_M1owhS2NGWCV.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/CWaiAZXdeW","video_info":{"aspect_ratio":[16,9],"duration_millis":154933,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2099798489802960896/pl/x2cBjljMNf44WY1j.m3u8?tag=29&v=e39"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099798489802960896/vid/avc1/480x270/RquiAhtLC4IA2tyb.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099798489802960896/vid/avc1/640x360/9ze2dlrdRmeieL8c.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099798489802960896/vid/avc1/1280x720/OxlQ3uHiwlLTyUoT.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/CWaiAZXdeW","expanded_url":"https://x.com/kantei/status/2099799205980336267/video/1","ext_media_availability":{"status":"Available"},"id_str":"2099798489802960896","indices":[100,123],"media_key":"13_2099798489802960896","media_results":{"result":{"media_key":"13_2099798489802960896"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2099798489802960896/img/8jZ_M1owhS2NGWCV.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/CWaiAZXdeW","video_info":{"aspect_ratio":[16,9],"duration_millis":154933,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2099798489802960896/pl/x2cBjljMNf44WY1j.m3u8?tag=29&v=e39"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099798489802960896/vid/avc1/480x270/RquiAhtLC4IA2tyb.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099798489802960896/vid/avc1/640x360/9ze2dlrdRmeieL8c.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099798489802960896/vid/avc1/1280x720/OxlQ3uHiwlLTyUoT.mp4?tag=29"}]}}]},"favorite_count":1821,"favorited":false,"full_text":"【お知らせ】\n本日（９月１５日）、高市総理は、防災功労者内閣総理大臣表彰を行いました。\n\n※高市総理発言要旨（速報版）\n　本日、「防災功労者表彰」を受けられました皆様に、心からお祝いを申し上げます。 https://t.co/CWaiAZXdeW","id_str":"2099799205980336267","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":82,"retweet_count":204,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk3OTkyMDU5MDA2NzcxMjA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（９月１５日）、高市総理は、防災功労者内閣総理大臣表彰を行いました。\n\n※高市総理発言要旨（速報版）\n　本日、「防災功労者表彰」を受けられました皆様に、心からお祝いを申し上げます。\n　皆様は、様々な災害に際し、危険や困難に直面しながらもひるむことなく、人命救助、住民の安全確保などに取り組まれたほか、防災に関する講習会の開催や地域の防災訓練の実施などに尽力され、災害による被害の防止・軽減に大きく寄与されました。\n　皆様のご貢献、ご労苦に対し、心より敬意を表しますとともに、深く感謝申し上げます。\n　本年も、「令和８年熊本地震」、「令和８年８月千葉豪雨」などの災害が発生し、多くのかけがえのない命が失われています。\n　政府では、激甚化・頻発化する自然災害に対し、国民の皆様の生命と財産を守り抜くため、全力で災害対応に取り組んでおります。\n　年内には、先の国会で成立した「防災庁設置関連法」に基づきまして、平時からの徹底した「事前防災」、発災時から復旧復興までの一貫した災害対応の「司令塔」となる「防災庁」を設置し、防災体制の抜本的な強化に取り組んでまいります。\n　災害への対応に万全を期すためには、全ての関係者の皆様の知恵と力を結集して取り組む必要があり、「産官学民」の連携が不可欠でございます。\n　皆様におかれましては、それぞれの分野において、ますますご活躍をいただき、災害に強い国づくりに一層のご尽力を賜りますよう、お願い申し上げます。\n　皆様の献身的なご貢献に、改めて感謝を申し上げます。そして、どうかお身体を大事にお過ごしくださいませ。\n　本日は、誠におめでとうございます。\n令和８年９月１５日\n内閣総理大臣・高市早苗"}}},"rest_id":"2099799205980336267","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"48107","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099799205980336267","sortIndex":"2100017074788106225"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 h