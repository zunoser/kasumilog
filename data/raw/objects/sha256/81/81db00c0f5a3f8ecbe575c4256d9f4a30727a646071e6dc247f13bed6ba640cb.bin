,{"h":1500,"w":1500,"x":0,"y":0},{"h":1500,"w":1316,"x":0,"y":0},{"h":1500,"w":750,"x":0,"y":0},{"h":1500,"w":2167,"x":0,"y":0}],"height":1500,"width":2167},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/7pG1ftctAU"}]},"favorite_count":792,"favorited":false,"full_text":"【中東情勢・重要物資】\nこれまでも相談窓口を設置して、様々な分野で重要物資の供給確保に全力で取り組んでいます。引き続き各省庁の相談窓口でお困りごとを受け付けています。\n■医療機関等の皆様、医薬品・医療機器及び医療物資等の事業者の皆様はこちら\nhttps://t.co/6songW4kUW（厚生労働省HP） https://t.co/7pG1ftctAU","id_str":"2092601869474660432","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":50,"retweet_count":132,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mhlw.go.jp/stf/chuto-jose…","expanded_url":"https://www.mhlw.go.jp/stf/chuto-josei.html","indices":[121,144],"url":"https://t.co/L9lLKqN9av"},{"display_url":"mlit.go.jp/sogoseisaku/ch…","expanded_url":"https://www.mlit.go.jp/sogoseisaku/chuto_josei_00001.html","indices":[199,222],"url":"https://t.co/fAQQOXFv9q"},{"display_url":"maff.go.jp/chuto_josei.ht…","expanded_url":"https://www.maff.go.jp/chuto_josei.html","indices":[266,289],"url":"https://t.co/g7LCozSOMf"},{"display_url":"env.go.jp/page_00348.html","expanded_url":"https://www.env.go.jp/page_00348.html","indices":[335,358],"url":"https://t.co/ssldc497PP"},{"display_url":"enecho.meti.go.jp/category/other…","expanded_url":"https://www.enecho.meti.go.jp/category/others/energysecurity/index.html","indices":[411,434],"url":"https://t.co/0C15eUPdXU"},{"display_url":"chusho.meti.go.jp/keiei/antei/ko…","expanded_url":"https://www.chusho.meti.go.jp/keiei/antei/kokusai_josei/index.html","indices":[467,490],"url":"https://t.co/5y6YYurNMl"},{"display_url":"meti.go.jp/chuto_josei/in…","expanded_url":"https://www.meti.go.jp/chuto_josei/index.html#localdesk","indices":[529,552],"url":"https://t.co/6jC4l7k7Sa"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI2MDE4NjkyNzc1NjkwMjQ=","richtext":{"richtext_tags":[]},"text":"【中東情勢・重要物資】\nこれまでも相談窓口を設置して、様々な分野で重要物資の供給確保に全力で取り組んでいます。引き続き各省庁の相談窓口でお困りごとを受け付けています。\n■医療機関等の皆様、医薬品・医療機器及び医療物資等の事業者の皆様はこちら\nhttps://t.co/L9lLKqN9av（厚生労働省HP）\n■運送事業、自動車整備業、造船事業、上下水道事業、建設業、住宅事業の事業者の皆様はこちら\nhttps://t.co/fAQQOXFv9q（国土交通省HP）\n■農畜産業、林業・木材産業、水産業、食品産業の事業者の皆様はこちら\nhttps://t.co/g7LCozSOMf（農林水産省HP）\n■廃棄物処理業、動物取扱業・ペットフード関連事業の事業者の皆様はこちら\nhttps://t.co/ssldc497PP（環境省HP）\n■燃料油や石油由来の化学品・製品等の供給に関する事業者や消費者の皆様からの情報提供の受付\nhttps://t.co/0C15eUPdXU（資源エネルギー庁HP）\n■中小企業・小規模事業者の皆様はこちら\nhttps://t.co/5y6YYurNMl（中小企業庁HP）\n■このほか、全国の経済産業局でも相談窓口を設けています。\nhttps://t.co/6jC4l7k7Sa（経済産業省HP）"}}},"rest_id":"2092601869474660432","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"53045","state":"EnabledWithCount"}}},"user_id_str":"2335919749"},"rest_id":"2092880357804872159","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"446","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092880357804872159","sortIndex":"2092912418958082023"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"http