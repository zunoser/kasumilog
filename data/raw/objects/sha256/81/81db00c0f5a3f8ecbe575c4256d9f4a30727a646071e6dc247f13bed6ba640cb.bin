":532,"y":0},{"h":566,"w":1080,"x":0,"y":0}],"height":566,"width":1080},"sizes":{"large":{"h":566,"resize":"fit","w":1080},"medium":{"h":566,"resize":"fit","w":1080},"small":{"h":356,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/w1u3tDo3pJ"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/w1u3tDo3pJ","expanded_url":"https://x.com/MofaJapan_en/status/2092815332838940834/photo/1","ext_alt_text":"Message from the Minister for Foreign Affairs of Japan\n\nThe Flooding in Raswa District in Central Nepal and Shigatse City in the Tibet Autonomous Region of China","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2092815298655305728","indices":[277,300],"media_key":"3_2092815298655305728","media_results":{"result":{"media_key":"3_2092815298655305728"}},"media_url_https":"https://pbs.twimg.com/media/HQssbQjaQAAPP6I.png","original_info":{"focus_rects":[{"h":566,"w":1011,"x":69,"y":0},{"h":566,"w":566,"x":390,"y":0},{"h":566,"w":496,"x":425,"y":0},{"h":566,"w":283,"x":532,"y":0},{"h":566,"w":1080,"x":0,"y":0}],"height":566,"width":1080},"sizes":{"large":{"h":566,"resize":"fit","w":1080},"medium":{"h":566,"resize":"fit","w":1080},"small":{"h":356,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/w1u3tDo3pJ"}]},"favorite_count":48,"favorited":false,"full_text":"The following is a message from FM MOTEGI regarding the Flooding in Raswa District in Central Nepal and Shigatse City in the Tibet Autonomous Region of China\nIn response to the flooding that occurred in Raswa District in central Nepal and Shigatse City in the Tibet Autonomous https://t.co/w1u3tDo3pJ","id_str":"2092815332838940834","is_quote_status":false,"lang":"en","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":1,"retweet_count":26,"retweeted":false,"user_id_str":"303735625"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI4MTUzMzI3MTczMDE3NjA=","richtext":{"richtext_tags":[]},"text":"The following is a message from FM MOTEGI regarding the Flooding in Raswa District in Central Nepal and Shigatse City in the Tibet Autonomous Region of China\nIn response to the flooding that occurred in Raswa District in central Nepal and Shigatse City in the Tibet Autonomous Region of China on August 26 (local time), I offer my deepest condolences to those who lost their lives and extend my heartfelt sympathy to all those affected.\nFollowing an announcement by the Government of Nepal on August 26 that Japanese nationals are among those missing, at 11:00 p.m. JST on the same day, we set up an on-site response headquarters in Nepal headed by Mr. MAEDA Toru, Ambassador of Japan to Nepal, and a response office at the Ministry of Foreign Affairs headed by the Director-General of the Consular Bureau, and have started taking immediate action. I have instructed the dispatch of personnel from the Emergency Response Team (ERT) to spare no effort in saving Japanese nationals’ lives.\nJapan expresses its strong solidarity with all those affected by this disaster and is urgently proceeding with necessary measures."}}},"rest_id":"2092815332838940834","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"10387","state":"EnabledWithCount"}}},"rest_id":"2092815672527266160","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"7195","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2092776840452886809","2092815672527266160"],"enableDeduplication":true}}},"entryId":"list-conversation-2092912418958082117","sortIndex":"2092912418958081979"},{"content":{