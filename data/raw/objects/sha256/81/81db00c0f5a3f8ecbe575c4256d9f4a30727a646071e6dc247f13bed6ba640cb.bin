"x":72,"y":177}]},"orig":{"faces":[{"h":52,"w":52,"x":694,"y":63},{"h":82,"w":82,"x":109,"y":402},{"h":137,"w":137,"x":87,"y":213}]},"small":{"faces":[{"h":24,"w":24,"x":327,"y":29},{"h":38,"w":38,"x":51,"y":189},{"h":64,"w":64,"x":41,"y":100}]}},"id_str":"2085289901743128576","indices":[139,162],"media_key":"3_2085289901743128576","media_results":{"result":{"media_key":"3_2085289901743128576"}},"media_url_https":"https://pbs.twimg.com/media/HPBwHgcbwAAGBfA.jpg","original_info":{"focus_rects":[{"h":605,"w":1080,"x":0,"y":22},{"h":1080,"w":1080,"x":0,"y":0},{"h":1231,"w":1080,"x":0,"y":0},{"h":1440,"w":720,"x":108,"y":0},{"h":1440,"w":1080,"x":0,"y":0}],"height":1440,"width":1080},"sizes":{"large":{"h":1440,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/4Z1XllQoAg"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/4Z1XllQoAg","expanded_url":"https://x.com/ModJapan_jp/status/2085289945972031574/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":52,"w":52,"x":694,"y":63},{"h":82,"w":82,"x":109,"y":402},{"h":137,"w":137,"x":87,"y":213}]},"medium":{"faces":[{"h":43,"w":43,"x":578,"y":52},{"h":68,"w":68,"x":90,"y":335},{"h":114,"w":114,"x":72,"y":177}]},"orig":{"faces":[{"h":52,"w":52,"x":694,"y":63},{"h":82,"w":82,"x":109,"y":402},{"h":137,"w":137,"x":87,"y":213}]},"small":{"faces":[{"h":24,"w":24,"x":327,"y":29},{"h":38,"w":38,"x":51,"y":189},{"h":64,"w":64,"x":41,"y":100}]}},"id_str":"2085289901743128576","indices":[139,162],"media_key":"3_2085289901743128576","media_results":{"result":{"media_key":"3_2085289901743128576"}},"media_url_https":"https://pbs.twimg.com/media/HPBwHgcbwAAGBfA.jpg","original_info":{"focus_rects":[{"h":605,"w":1080,"x":0,"y":22},{"h":1080,"w":1080,"x":0,"y":0},{"h":1231,"w":1080,"x":0,"y":0},{"h":1440,"w":720,"x":108,"y":0},{"h":1440,"w":1080,"x":0,"y":0}],"height":1440,"width":1080},"sizes":{"large":{"h":1440,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/4Z1XllQoAg"}]},"favorite_count":426,"favorited":false,"full_text":"【なぜいまシリーズ⑲】\n第19弾は、「防衛と経済の好循環の実現」について☝\n\n「新しい守り方」の実現や「持続的な対応能力」の強化といった今後の防衛力強化を行う上では、防衛への投資がデュアルユース技術・サービスの創出・普及にもつながるといった視点が重要です。\n\nこの結果として、 https://t.co/4Z1XllQoAg","id_str":"2085289945972031574","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"quoted_status_id_str":"2084572787369472020","quoted_status_permalink":{"display":"x.com/ModJapan_jp/st…","expanded":"https://twitter.com/ModJapan_jp/status/2084572787369472020","url":"https://t.co/IxTlcTzDly"},"reply_count":17,"retweet_count":98,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[310,315],"text":"なぜいま"},{"indices":[466,472],"text":"防衛力変革"},{"indices":[473,477],"text":"三文書"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwODUyODk5NDU5MTc0NjQ1NzY=","text":"【なぜいまシリーズ⑲】\n第19弾は、「防衛と経済の好循環の実現」について☝\n\n「新しい守り方」の実現や「持続的な対応能力」の強化といった今後の防衛力強化を行う上では、防衛への投資がデュアルユース技術・サービスの創出・普及にもつながるといった視点が重要です。\n\nこの結果として、\n①防衛力強化のための投資が\n②国内外の民生市場における競争力の強化につながり\n③国内外の民生市場の獲得により強化された生産・技術基盤が\n④防衛装備品の質と量の向上につながる、\n「防衛と経済の好循環」の実現が可能になると考えています。\n\n国民の皆様の命と平和な暮らしを守り抜くための重要なポイントを\n「なぜいま防衛力の変革が必要なのか（略して「#なぜいま」）」\nというシリーズでお伝えしています。\n\n普段の生活には関係ないと思われるかもしれませんが、日本を取り巻く安全保障環境が厳しさを増す中で、防衛省・自衛隊の取組は国民の平和な暮らしに直結するものです。\n本年中の三文書改定に向けて検討が進められる今、\nこの機会に、知っていただきたいと思っています。\n\n#防衛力変革\n#三文書"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2084572787369472020"}},"rest_id":"2085289945972031574","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"8