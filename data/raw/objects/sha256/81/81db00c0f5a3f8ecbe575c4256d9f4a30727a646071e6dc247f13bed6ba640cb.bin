go.jp/copyright/soci…","expanded_url":"https://www.fsa.go.jp/copyright/socialmedia.html","indices":[80,103],"url":"https://t.co/atLkhj7eFv"}]},"url":{"urls":[{"display_url":"fsa.go.jp/ordinary/chuui…","expanded_url":"https://www.fsa.go.jp/ordinary/chuui/kinyu_chuui.html","indices":[0,23],"url":"https://t.co/LzledB9M9a"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":5598,"following":5},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1186871382442831872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":2770,"tweets":4045},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/LzledB9M9a"}}}},"edit_control":{"edit_tweet_ids":["2092794897279705168"],"editable_until_msecs":"1787799760000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2092794897279705168","created_at":"Thu Aug 27 02:02:40 +0000 2026","display_text_range":[0,152],"entities":{"hashtags":[{"indices":[30,34],"text":"無登録"},{"indices":[56,67],"text":"店頭デリバティブ取引"},{"indices":[115,129],"text":"Nihon_Markets"},{"indices":[130,146],"text":"Vantage_Trading"},{"indices":[147,152],"text":"カワ金融"}],"media":[{"display_url":"pic.x.com/vB1taXfngB","expanded_url":"https://x.com/fsa_attention/status/2092794897279705168/photo/1","ext_alt_text":"金融庁ウェブサイトでは、無登録で金融商品取引業を行う者の名称等について公表しております。\n掲載されている無登録業者は、警告書の発出を行った時点で無登録営業を行っていることが確認できた者に限られています。そのため、掲載されていない者であっても、無登録営業に該当する行為を行っていることがあり得ますのでご注意ください。\n掲載されている無登録業者について、必ずしも、現在の無登録営業の状況を示すものではありません。また、その名称及び所在地等についても、現時点のものでない場合があります。\n掲載されている無登録業者は、財務省の総合出先機関である財務局が、金融庁の委任を受け、警告を行ったものを含みます。\n警告書の発出は行っていないものの、証券取引等監視委員会において、金融商品取引法第192条第1項に基づく裁判所への禁止及び停止命令発出の申立てを行った無登録業者については、広く周知する観点から、証券取引等監視委員会の公表にあわせ掲載されています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2092794888895266816","indices":[153,176],"media_key":"3_2092794888895266816","media_results":{"result":{"media_key":"3_2092794888895266816"}},"media_url_https":"https://pbs.twimg.com/media/HQsZ3QRbAAA1X35.png","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":675,"w":675,"x":525,"y":0},{"h":675,"w":592,"x":608,"y":0},{"h":675,"w":338,"x":821,"y":0},{"h":675,"w":1200,"x":0,"y":0}],"height":675,"width":1200},"sizes":{"large":{"h":675,"resize":"fit","w":1200},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/vB1taXfngB"},{"display_url":"pic.x.com/vB1taXfngB","expanded_url":"https://x.com/fsa_attention/status/2092794897279705168/photo/1","ext_alt_text":"金融庁ウェブサイトでは、無登録で金融商品取引業を行う者の名称等について公表しております。\n掲載されている無登録業者は、警告書の発出を行った時点で無登録営業を行っていることが確認できた者に限られています。そのため、掲載されていない者であっても、無登録営業に該当する行為を行っていることがあり得ますのでご注意ください。\n掲載されている無登録業者について、必ずしも、現在の無登録営業の状況を示すものではありません。また、その名称及び所在地等についても、現時点のものでない場合があります。\n掲載されている無登録業者は、財務省の総合出先機関である財務局が、金融庁の委任を受け、警告を行ったものを含みます。\n警告書の発出は行っていないものの、証券取引等監視委員会において、金融商品取引法第192条第1項に基づく裁判所への禁止及び停止命令発出の申立てを行った無登録業者については、広く周知する観点から、証券取引等監視委員会の公表にあわせ掲載されています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2092794888849174528","indices":[153,176],"media_key":"3_2092794888849174528","media_results":{"result":{"media_key":"3_2092794888849174528"}},"media_url_https":"https://pbs.twimg.com/media/HQsZ3QGbsAAwFgH.png","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":675,"w":675,"