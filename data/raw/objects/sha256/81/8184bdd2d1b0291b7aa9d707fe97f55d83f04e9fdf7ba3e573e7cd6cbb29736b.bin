ied":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2121750668394582207"],"editable_until_msecs":"1794703354000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1164,"bookmarked":false,"conversation_id_str":"2121750668394582207","created_at":"Sat Nov 14 23:42:34 +0000 2026","display_text_range":[0,137],"entities":{},"favorite_count":51665,"favorited":false,"full_text":"今日11月15日で、横田めぐみさんが北朝鮮に拉致されてから49年になります。\n\n様々な機会に、お母様の横田早紀江さん、弟の横田拓也さんと横田哲也さんから、「帰国を待ちわびる切実な思い」、「痛切なお声」をお伺いしながら、ご帰国を果たせていないことを、大変心苦しく感じています。","id_str":"2121750668394582207","is_quote_status":false,"lang":"ja","quote_count":674,"reply_count":2371,"retweet_count":6281,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjE3NTA2NjgzNDQyMTc2MDA=","text":"今日11月15日で、横田めぐみさんが北朝鮮に拉致されてから49年になります。\n\n様々な機会に、お母様の横田早紀江さん、弟の横田拓也さんと横田哲也さんから、「帰国を待ちわびる切実な思い」、「痛切なお声」をお伺いしながら、ご帰国を果たせていないことを、大変心苦しく感じています。\n\n主権国家の責務として、拉致被害者の皆様に一刻も早く祖国の土を踏んでいただく。\nそれが私に課せられた使命です。\n\n政府一丸となって懸命に取り組むことをお誓い申し上げるとともに、「再会の日」まで、ご家族、関係者の皆様のご健勝をお祈り申し上げます。"}}},"rest_id":"2121750668394582207","unmention_data":{},"views":{"count":"3943848","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121750668394582207","sortIndex":"2122149296508764124"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag