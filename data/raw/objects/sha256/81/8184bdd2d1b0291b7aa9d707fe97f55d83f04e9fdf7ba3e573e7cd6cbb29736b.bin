ok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":8,"bookmarked":false,"conversation_id_str":"2122132550118154462","created_at":"Mon Nov 16 01:00:01 +0000 2026","display_text_range":[0,104],"entities":{"media":[{"display_url":"pic.x.com/nVkNFdJHif","expanded_url":"https://x.com/gov_online/status/2122132550118154462/photo/1","ext_alt_text":"政府広報、警察庁の新聞つきだし広告。上部には「トクリュウの犯行下見かも！？小さな違和感でも迷わず、すぐ110番を！※トクリュウとは匿名・流動型犯罪グループの通称。」と書かれている。中部にはイラストとともに「非通知や無言の電話がある、インターホンが鳴ったのに誰もいない、表札やポストに見慣れない印がある、家の周りで知らない人や車を何度も見る」と書かれている。下部には「普段と異なる違和感・気づきが犯罪を未然に防ぎます！」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":37,"w":37,"x":243,"y":668},{"h":46,"w":46,"x":17,"y":489}]},"medium":{"faces":[{"h":37,"w":37,"x":243,"y":668},{"h":46,"w":46,"x":17,"y":489}]},"orig":{"faces":[{"h":37,"w":37,"x":243,"y":668},{"h":46,"w":46,"x":17,"y":489}]},"small":{"faces":[{"h":32,"w":32,"x":211,"y":580},{"h":40,"w":40,"x":14,"y":425}]}},"id_str":"2121213868919967744","indices":[105,128],"media_key":"3_2121213868919967744","media_results":{"result":{"media_key":"3_2121213868919967744"}},"media_url_https":"https://pbs.twimg.com/media/HXAQxm2bUAAju4l.jpg","original_info":{"focus_rects":[{"h":348,"w":621,"x":0,"y":353},{"h":621,"w":621,"x":0,"y":161},{"h":708,"w":621,"x":0,"y":74},{"h":782,"w":391,"x":215,"y":0},{"h":782,"w":621,"x":0,"y":0}],"height":782,"width":621},"sizes":{"large":{"h":782,"resize":"fit","w":621},"medium":{"h":782,"resize":"fit","w":621},"small":{"h":680,"resize":"fit","w":540},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/nVkNFdJHif"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/nVkNFdJHif","expanded_url":"https://x.com/gov_online/status/2122132550118154462/photo/1","ext_alt_text":"政府広報、警察庁の新聞つきだし広告。上部には「トクリュウの犯行下見かも！？小さな違和感でも迷わず、すぐ110番を！※トクリュウとは匿名・流動型犯罪グループの通称。」と書かれている。中部にはイラストとともに「非通知や無言の電話がある、インターホンが鳴ったのに誰もいない、表札やポストに見慣れない印がある、家の周りで知らない人