nt":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2121211480494239744/9AdZAXd1?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"11月17日は世界さい帯血の日です。臍帯血は白血病などの血液疾患の治療に用いられる造血幹細胞を豊富に含んでいます。公的さい帯血バンクの役割や臍帯血提供について紹介します。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.mhlw.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2121211480494239744/9AdZAXd1?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":4870,"url":"https://pbs.twimg.com/card_img/2121211480494239744/9AdZAXd1?format=jpg&name=orig","width":3444},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2121211480494239744/9AdZAXd1?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":2048,"url":"https://pbs.twimg.com/card_img/2121211480494239744/9AdZAXd1?format=png&name=2048x2048_2_exp","width":1448},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mhlw.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":95.18,"rgb":{"blue":255,"green":255,"red":255}},{"percentage":2.12,"rgb":{"blue":31,"green":26,"red":230}},{"percentage":1.72,"rgb":{"blue":157,"green":153,"red":239}},{"percentage":0.58,"rgb":{"blue":106,"green":106,"red":235}},{"percentage":0.4,"rgb":{"blue":134,"green":139,"red":141}}]},"type":"IMAGE_COLOR"}},{"key":"title","value":{"string_value":"2026年11月17日は世界さい帯血の日（World cord blood day）","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/GYlp7hrAsJ","type":"STRING"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary","url":"https://t.co/GYlp7hrAsJ","user_refs_results":[]},"rest_id":"https://t.co/GYlp7hrAsJ"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3077166,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":637,"tweets":1965},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2121762656952746280"],"editable_until_msecs":"1794706212000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":135,"bookmarked":false,"conversation_id_str":"2121762656952746280","created_at":"Sun Nov 15 00:30:12 +0000 2026","display_text_range":[0,143],"entities":{},"favorite_count":10342,"favorited":false,"full_text":"11月17日は「世界さい帯血の日」です。\n\nさい帯血は、赤ちゃんの誕生後に胎盤やへその緒の中に残っている血液です。\n\nさい帯血には、血液をつくるもとになる「造血幹細胞」が豊富に含まれていて、白血病や再生不良性貧血などの血液の病気を抱える患者さんに対する造血幹細胞移植に活用されています。","id_str":"2121762656952746280","is_quote_status":false,"lang":"ja","quote_count":116,"reply_count":1095,"retweet_count":1239,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mhlw.go.jp/stf/seisakunit…","expanded_url":"https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/kenkou_iryou/kenkou/ishoku/zouketukansaibo_00005.html","indices":[542,565],"url":"https://t.co/GYlp7hrAsJ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjE3NjI2NTY3OTc0ODcxMDQ=","richtext":{"richtext_tags":[]},"text":"11月17日は「世界さい帯血の日」です。\n\nさい帯血は、赤ちゃんの誕生後に胎盤やへその緒の中に残っている血液です。\n\nさい帯血には、血液をつくるもとになる「造血幹細胞」が豊富に含まれていて、白血病や再生不良性貧血などの血液の病気を抱える患者さんに対する造血幹細胞移植に活用されています。\n\n非血縁者間の造血幹細胞移植において、｢さい帯血移植｣の割合は約6割を占めています。\n｢さい帯血移植｣は、あらかじめ保存されたさい帯血を必要に応じて迅速に提供することができるほか、適合する条件が比較的緩やかで移植につながりやすいという特徴があります。\n\n一方で、「さい帯血移植」については十分に知られていない（言葉は知っていた約40％、内容も知っていた約11％、知らなかった約48％）状況です。\n\n移植を必要とする患者さんにさい帯血を継続的に提供していくためには、多様なＨＬＡ型（白血球の型）のさい帯血を安定的に確保することが必要です。\n\n公的さい帯血バンク（全国で6か所）は、妊婦さんからの善意による提供によって支えられています。\n\nこの機会に、妊婦さんやそのご家族をはじめ、多くの国民の皆様にさい帯血について知っていただければ幸いです。\n\n世界さい帯血の日についての厚生労働省のホームページ：https://t.co/GYlp7hrAsJ"}}},"rest_id":"2121762656952746280","unmention_data":{},"views":{"count":"395085","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121762656952746280","sortIndex":"2122149296508764127"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"description":{},"url":{"urls":[{"display_url":"fdma.go.jp","expanded_url":"http://www.fdma.go.jp/","indices":[0,23],"url":"https://t.co/YCgAnjuA83"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":876535,"following":19},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"137272821","super_follow_eligible":f