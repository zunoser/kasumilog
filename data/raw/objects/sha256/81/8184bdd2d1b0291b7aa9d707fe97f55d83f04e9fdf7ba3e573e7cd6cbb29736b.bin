19,"reply_count":33,"retweet_count":291,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjE3OTgyMjI2MDc5OTQ4ODA=","text":"【今月発表へ】防衛省・自衛隊の新たなAI戦略について\n\n防衛省は、今月、「防衛省AI活用推進基本方針」を見直し、新たな「Defense AI Vision」を発表します。\nAIは今、防衛力の発揮の仕方そのものを変えています。\nこの大きな変化を、日本を守る力に変えていく。\n防衛省・自衛隊は、AIによってどう変わるのか。\nその新たな方向性を、このビジョンで示します。"}}},"rest_id":"2121798222666727589","unmention_data":{},"views":{"count":"135204","state":"EnabledWithCount"}}},"rest_id":"2122001407956169117","unmention_data":{},"views":{"count":"27598","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122001407956169117","sortIndex":"2122149296508764139"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzY2ODI3OTE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関 "},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2001095001481076943"]},"