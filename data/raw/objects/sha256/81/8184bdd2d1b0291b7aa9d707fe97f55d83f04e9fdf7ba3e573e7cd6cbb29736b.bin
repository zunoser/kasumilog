0,"y":0}],"height":960,"width":720},"sizes":{"large":{"h":960,"resize":"fit","w":720},"medium":{"h":960,"resize":"fit","w":720},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/2rNmpT9cHJ"},{"display_url":"pic.x.com/2rNmpT9cHJ","expanded_url":"https://x.com/MAFF_JAPAN/status/2121804466710327427/photo/2","ext_alt_text":"エントリーシート\n氏名：昆布\n生年月日：だしとしては約8,000年前\n主な出身地：北海道（国内生産の約9割）\n現住所：日本の食卓\n志望動機：古くから日本の食文化を支えてきた経験をいかし、これからも多くの方の食卓に、うま味とおいしさ、そして豊かな食の時間をお届けしたく、応募いたしました。\n職務経歴：\n（約8,000年前から）縄文時代の頃から、だしの素材として日本の食文化を支える。\n（江戸時代）北前船で大阪へ。北陸・関西のだし文化の発展に貢献\n（現在）鍋、おでん、湯豆腐、煮物、昆布締め、佃煮など、広い分野で活躍\n得意な業務：だしはもちろん、なべ、おにぎり、昆布巻き、煮物、昆布締め、天ぷら、カレー、パスタなど和食以外にも、またおやつや昆布茶などにも幅広く活躍できます。\n保有スキル・資格：\n〇うま味成分「グルタミン酸」所有\n〇素材の味を引き立てる香り\n〇長期保存可能\nチームでの実績：仲間と取り組むことでうま味がさらにアップします。\nかつお節（イノシン酸）⇒うま味約７倍に\n干ししいたけ（グアニル酸）⇒うま味約10倍に\n自己PR：\n私は日ごろから、料理の味を引き立てる全体のムードメーカーとして働いています。また、だしを取るだけでなく、佃煮や天ぷらなど自らがメイン食材となって食卓に美味しさを届けることができ、最後まで無駄なく使える持続可能な食材です。これからも、日本の食材に美味しさを豊かさを届けて参ります。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2121804455503097856","indices":[43,66],"media_key":"3_2121804455503097856","media_results":{"result":{"media_key":"3_2121804455503097856"}},"media_url_https":"https://pbs.twimg.com/media/HXIp6RUacAAy70C.jpg","original_info":{"focus_rects":[{"h":475,"w":849,"x":0,"y":0},{"h":849,"w":849,"x":0,"y":0},{"h":968,"w":849,"x":0,"y":0},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":849,"x":0,"y":0}],"height":1200,"width":849},"sizes":{"large":{"h":1200,"resize":"fit","w":849},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/2rNmpT9cHJ"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/2rNmpT9cHJ","expanded_url":"https://x.com/MAFF_JAPAN/status/2121804466710327427/photo/1","ext_alt_text":"証明写真風のポートレート。ただし、スーツを着た男性の頭部が昆布に置き換わっている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2121804455498969088","indices":[43,66],"media_key":"3_2121804455498969088","media_results":{"result":{"media_key":"3_2121804455498969088"}},"media_url_https":"https://pbs.twimg.com/media/HXIp6RTbcAA8Ku7.jpg","original_info":{"focus_rects":[{"h":403,"w":720,"x":0,"y":15},{"h":720,"w":720,"x":0,"y":0},{"h":821,"w":720,"x":0,"y":0},{"h":960,"w":480,"x":0,"y":0},{"h":960,"w":720,"x":0,"y":0}],"height":960,"width":720},"sizes":{"large":{"h":960,"resize":"fit","w":720},"medium":{"h":960,"resize":"fit","w":720},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/2rNmpT9cHJ"},{"display_url":"pic.x.com/2rNmpT9cHJ","expanded_url":"https://x.com/MAFF_JAPAN/status/2121804466710327427/photo/2","ext_alt_text":"エントリーシート\n氏名：昆布\n生年月日：だしとしては約8,000年前\n主な出身地：北海道（国内生産の約9割）\n現住所：日本の食卓\n志望動機：古くから日本の食文化を支えてきた経験をいかし、これからも多くの方の食卓に、うま味とおいしさ、そして豊かな食の時間をお届けしたく、応募いたしました。\n職務経歴：\n（約8,000年前から）縄文時代の頃から、だしの素材として日本の食文化を支える。\n（江戸時代）北前船で大阪へ。北陸・関西のだし文化の発展に貢献\n（現在）鍋、おでん、湯豆腐、煮物、昆布締め、佃煮など、広い分野で活躍\n得意な業務：だしはもちろん、なべ、おにぎり、昆布巻き、煮物、昆布締め、天ぷら、カレー、パスタなど和食以外にも、またおやつや昆布茶などにも幅広く活躍できます。\n保有スキル・資格：\n〇うま味成分「グルタミン酸」所有\n〇素材の味を引き立てる香り\n〇長期保存可能\nチームでの実績：仲間と取り組むことでうま味がさらにアップします。\nかつお節（イノシン酸）⇒うま味約７倍に\n干ししいたけ（グアニル酸）⇒うま味約10倍に\n自己PR：\n私は日ごろから、料理の味を引き立てる全体のムードメーカーとして働いています。また、だしを取るだけでなく、佃煮や天ぷらなど自らがメイン食材となって食卓に美味しさを届けることができ、最後まで無駄なく使える持続可能な食材です。これからも、日本の食材に美味しさを豊かさを届けて参ります。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2121804455503097856","indices":[43,66],"media_key":"3_2121804455503097856","media_results":{"result":{"media_key":"3_2121804455503097856"}},"media_url_https":"https://pbs.twimg.com/media/HXIp6RUacAAy70C.jpg","original_info":{"focus_rects":[{"h":475,"w":849,"x":0,"y