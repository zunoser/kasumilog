621,"w":1016,"x":0,"y":0}],"height":621,"width":1016},"sizes":{"large":{"h":621,"resize":"fit","w":1016},"medium":{"h":621,"resize":"fit","w":1016},"small":{"h":416,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/AdsdozMASv"}]},"favorite_count":1452,"favorited":false,"full_text":"【🛰防衛×宇宙🚀シリーズ㉗】\n第27弾は、「宇宙（そら）を監視する衛星📷」\n\n8月11日、H3ロケット9号機により高精度な測位を提供する準天頂衛星システム「みちびき7号機」が無事打ち上げられました🎊\n\n防衛省も今年度中にH3ロケットで衛星を打ち上げる予定です🚀その名も「SDA（宇宙領域把握）衛星」！ https://t.co/AdsdozMASv","id_str":"2090739909606928743","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"quoted_status_id_str":"2085674903664279745","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2085674903664279745","url":"https://t.co/tqLfS8Hcxm"},"reply_count":8,"retweet_count":273,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[372,377],"text":"宇宙安保"},{"indices":[378,392],"text":"SDF_SpaceYear"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTA3Mzk5MDk1NDgyODE4NTY=","text":"【🛰防衛×宇宙🚀シリーズ㉗】\n第27弾は、「宇宙（そら）を監視する衛星📷」\n\n8月11日、H3ロケット9号機により高精度な測位を提供する準天頂衛星システム「みちびき7号機」が無事打ち上げられました🎊\n\n防衛省も今年度中にH3ロケットで衛星を打ち上げる予定です🚀その名も「SDA（宇宙領域把握）衛星」！\n\n航空自衛隊は、地上から宇宙を観測するSSA（宇宙状況把握）レーダーなどをすでに運用し、宇宙物体の位置や軌道などを把握しています。\n\nこれに加えて、静止軌道上に打ち上げられるSDA衛星により、地上からでは把握が困難な宇宙物体の形状を近くで観測できるようになり、位置や軌道だけでなく、その意図・能力も把握することが可能になります💡\n\n防衛省・自衛隊は宇宙空間の安定的利用を確保するため、宇宙領域を把握するためのSDA能力を強化していきます！\n\n#宇宙安保\n#SDF_SpaceYear"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1263033,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7567,"tweets":21445},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2085674903664279745"],"editable_until_msecs":"1786102221000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availab