:true,"id":"VXNlcjozMDM3MzU2MjU=","is_blue_verified":true,"location":{"location":"Tokyo"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2090732535760437454"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"The Official English Account of the Ministry of Foreign Affairs of Japan.\nSocial Media List: https://t.co/PnH9N7WcqL","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/about/list_en.…","expanded_url":"https://www.mofa.go.jp/about/list_en.html","indices":[93,116],"url":"https://t.co/PnH9N7WcqL"}]},"url":{"urls":[{"display_url":"mofa.go.jp","expanded_url":"http://www.mofa.go.jp/","indices":[0,23],"url":"https://t.co/jDWRcTicQE"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":150988,"following":179},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8502,"tweets":19391},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2090778798027640882"],"editable_until_msecs":"1787319084000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":true,"legacy":{"bookmark_count":6,"bookmarked":false,"conversation_id_str":"2090778798027640882","created_at":"Fri Aug 21 12:31:24 +0000 2026","display_text_range":[0,121],"entities":{"media":[{"display_url":"pic.x.com/YlvPxghJt6","expanded_url":"https://x.com/MofaJapan_en/status/2090778798027640882/photo/1","ext_alt_text":"\n1.    The Government of Japan is deeply concerned about progress in the settlement construction plan in the E1 area of the West Bank. The Government of Japan reiterates its deep regret over the continuing unilateral acts including settlement activities by the Government of Israel despite repeated calls by the international community, including Japan, and once again strongly urges the Government of Israel to reverse the plan and fully freeze its settlement activities. The Government of Japan also calls on the Government of Israel to take appropriate measures promptly to prevent settler violence.\n\n2.    Settlement activities are in violation of international law and undermine the viability of a two-state solution. The Government of Japan reiterates the significance of achieving peace in the Middle East through a two-state solution and, working with the international community, will make every diplomatic efforts to halt the Israeli government's settlement activities.","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":79,"w":79,"x":200,"y":874},{"h":299,"w":299,"x":54,"y":190}]},"medium":{"faces":[{"h":72,"w":72,"x":184,"y":807},{"h":276,"w":276,"x":49,"y":175}]},"orig":{"faces":[{"h":79,"w":79,"x":200,"y":874},{"h":299,"w":299,"x":54,"y":190}]},"small":{"faces":[{"h":41,"w":41,"x":104,"y":457},{"h":156,"w":156,"x":28,"y":99}]}},"id_str":"2090778603021881344","indices":[122,145],"media_key":"3_2090778603021881344","media_results":{"result":{"media_key":"3_2090778603021881344"}},"media_url_https":"https://pbs.twimg.com/media/HQPwD-EbUAAsCVQ.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":66},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":389,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YlvPxghJt6"}],"urls":[{"display_url":"mofa.go.jp/press/statemen…","expanded_url":"https://www.mofa.go.jp/press/statement/pageite_000001_01773.html","indices":[98,121],"url":"https://t.co/CncA58lxIN"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/YlvPxghJt6","expanded_url":"https://x.com/MofaJapan_en/status/2090778798027640882/photo/1","ext_alt_text":"\n1.    The Government of Japan is deeply concerned about progress in the settlement construction plan in the E1 area of the West Bank. The Government of Japan reiterates its deep regret over the continuing unilateral acts including settlement activities by the Government of Israel despite repeated calls by the international community, including Japan, and once again strongly urges the Government of Israel to reverse the plan and fully freeze its settlement activities. The Government of Japan also calls on the Government of Israel to take appropriate measures promptly to prevent settler violence.\n\n2.    Settlement activities are in violation of international law and undermine the viability of a two-state solution. The Government of Japan reiterates the significance of achieving peace in the Middle East through a two-state solution and, working with the international community, will make every diplomatic efforts to halt the Israeli government's settlement activities.","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":79,"w":79,"x":200,"y":874},{"h":299,"w":299,"x":54,"y":190}]},"medium":{"faces":[{"h":72,"w":72,"x":184,"y":807},{"h":276,"w":276,"x":49,"y":175}]},"orig":{"faces":[{"h":79,"w":79,"x":200,"y":874},{"h":299,"w":299,"x":54,"y":190}]},"small":{"faces":[{"h":41,"w":41,"x":104,"y":457},{"h":156,"w":156,"x":28,"y":99}]}},"id_str":"2090778603021881344","indices":[122,145],"media_key":"3_2090778603021881344","media_results":{"result":{"media_key":"3_2090778603021881344"}},"media_url_https":"https://pbs.twimg.com/media/HQPwD-EbUAAsCVQ.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":66},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":389,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YlvPxghJt6"}]},"favorite_count":69,"favorited":false,"full_text":"Press Secretary KITAMURA issued the following statement on the recent situation in the West Bank.\nhttps://t.co/CncA58lxIN https://t.co/YlvPxghJt6","id_str":"2090778798027640882","is_quote_status":false,"lang":"en","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":3,"retweet_count":28,"retweeted":false,"user_id_str":"303735625"},"rest_id":"2090778798027640882","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"20518","state":"EnabledWithCount"}}},"rest_id":"2090779003569446916","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"13541","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2090779001346568332","2090779003569446916"],"enableDeduplication":true}}},"entryId":"list-conversation-2091535995869593646","sortIndex":"2091535995869593554"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/3692310981/5e84849fe6a5c60bc3a3818c6f4cbec4_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/286056244/1782437584"},"core":{"created_at":"Fri Apr 22 08:05:55 +0000 2011","name":"環境省","screen_name":"Kankyo_Jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODYwNTYyNDQ=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"環境省の公式アカウントです。皆さまにお知らせしたい情報を発信していきます。なお、Xによせられたコメントへの返信はしておりません。運用方針はこちらhttps://t.co/5x04ocrXoq\n英語版Xはこちら @MOEJ_Climate","entities":{"description":{"urls":[{"display_url":"env.go.jp/info/sns/twitt…","expanded_url":"https://www.env.go.jp/info/sns/twitter.html","indices":[72,95],"url":"https://t.co/5x04ocrXoq"}]},"url":{"urls":[{"display_url":"env.go.jp/index.html","expanded_url":"https://www.env.go.jp/index.html","indices":[0,23],"url":"https://t.co/uhfdD6xGb1"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":354583,"following":65},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"286056244","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4940,"tweets":9444},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/uhfdD6xGb1"}}}},"edit_control":{"edit_tweet_ids":["2090773588358082684"],"editable_until_msecs":"1787317842000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2090773588358082684","created_at":"Fri Aug 21 12:10:42 +0000 2026","display_text_range":[0,144],"entities":{"hashtags":[{"indices":[5,14],"text":"石原宏高環境大臣"}]},"favorite_count":35,"favorited":false,"full_text":"8/21、#石原宏高環境大臣 は「令和８年熊本地震第12回非常災害対策本部会議」・「令和８年８月千葉豪雨に関する関係閣僚会議（第２回）」に出席しました。昨日、熊本県を訪問し現地の状況を確認等したこと、千葉県庁への職員派遣の状況等を報告しました。引き続き被災自治体への支援を行っていきます。","id_str":"2090773588358082684","is_quote_status":true,"lang":"ja","quote_count":0,"quoted_status_id_str":"2090770748168384684","quoted_status_permalink":{"display":"x.com/Kantei_Saigai/…","expanded":"https://twitter.com/Kantei_Saigai/status/2090770748168384684","url":"https://t.co/2PZ52mkRXl"},"reply_count":0,"retweet_count":16,"retweeted":false,"user_id_str":"286056244"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929443244641021952/eOVlys0Q_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/265205959/1355386027"},"core":{"created_at":"Sun Mar 13 05:22:07 +0000 2011","name":"首相官邸(災害・危機管理情報)","screen_name":"Kantei_Saigai"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjUyMDU5NTk=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。災害・危機管理関連の政府活動情報をお届けします。なお、このアカウントで発信やリポストした情報のうち被災者応援に関するものは、被災者の方が必要な情報に容易にアクセスできるよう、首相官邸（被災者応援情報）アカウント@kantei_hisaiでもリポストしますので、ご活用ください。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/L24EN3HjH7"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3122435,"following":25},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"265205959","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":682,"tweets":10803},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/L24EN3HjH7"}}}},"edit_control":{"edit_tweet_ids":["2090770748168384684"],"editable_until_msecs":"1787317165000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":22,"bookmarked":false,"conversation_id_str":"2090770748168384684","created_at":"Fri Aug 21 11:59:25 +0000 2026","display_text_range":[0,101],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/g4PjXh2O4T","expanded_url":"https://x.com/Kantei_Saigai/status/2090770748168384684/video/1","ext_media_availability":{"status":"Available"},"id_str":"2090768238837923840","indices":[102,125],"media_key":"13_2090768238837923840","media_results":{"result":{"media_key":"13_2090768238837923840"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2090768238837923840/img/sIAnlNwfGuLHAgkW.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/g4PjXh2O4T","video_info":{"aspect_ratio":[16,9],"duration_millis":398066,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2090768238837923840/pl/QZ956XRy-bmoFPvo.m3u8?tag=29&v=ba9"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2090768238837923840/vid/avc1/480x270/2gvE4aHtrB_XltjK.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2090768238837923840/vid/avc1/640x360/p36oS2dXciJ7PgCN.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2090768238837923840/vid/avc1/1280x720/J39rbt6CRo9Pq-wJ.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/g4PjXh2O4T","expanded_url":"https://x.com/Kantei_Saigai/status/2090770748168384684/video/1","ext_media_availability":{"status":"Available"},"id_str":"2090768238837923840","indices":[102,125],"media_key":"13_2090768238837923840","media_results":{"result":{"media_key":"13_2090768238837923840"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2090768238837923840/img/sIAnlNwfGuLHAgkW.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/g4PjXh2O4T","video_info":{"aspect_ratio":[16,9],"duration_millis":398066,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2090768238837923840/pl/QZ956XRy-bmoFPvo.m3u8?tag=29&v=ba9"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2090768238837923840/vid/avc1/480x270/2gvE4aHtrB_XltjK.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2090768238837923840/vid/avc1/640x360/p36oS2dXciJ7PgCN.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2090768238837923840/vid/avc1/1280x720/J39rbt6CRo9Pq-wJ.mp4?tag=29"}]}}]},"favorite_count":1181,"favorited":false,"full_text":"【お知らせ】\n本日（８月２１日）、高市総理は、令和８年熊本地震に関する非常災害対策本部会議（第１２回）・令和８年８月千葉豪雨に関する関係閣僚会議（第２回）を開催しました。\n\n※高市総理発言要旨（速報版） https://t.co/g4PjXh2O4T","id_str":"2090770748168384684","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":33,"retweet_count":182,"retweeted":false,"user_id_str":"265205959"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTA3NzA3NDgwNTUxMjE5MjA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（８月２１日）、高市総理は、令和８年熊本地震に関する非常災害対策本部会議（第１２回）・令和８年８月千葉豪雨に関する関係閣僚会議（第２回）を開催しました。\n\n※高市総理発言要旨（速報版）\n　本日も令和８年熊本地震に係る非常災害対策本部会議と令和８年８月千葉豪雨に係る関係閣僚会議を開催しました。\n　熊本地震ですが、発災から３週間以上が経過して、被災地では夏の暑さと長引く避難生活により、精神的にも体力的にも厳しい環境が続いています。\n　避難されている方々は、様々な事情を抱えておられまして、避難生活の長期化に伴い、ニーズも多様化しております。\n　また、地域経済を再生するために、被災地の地場産業の雇用を維持し、事業の継続を支えるための支援が必要です。\n　各大臣におかれては、被災地、被災された方々のお声を的確に把握して、それに応える取組を先手・先手で進めてください。\n　「個人の井戸の復旧」についても、今般新たに、「災害救助費」などにより、支援ができるようにしました。\n　また、「現地対策本部」に設置した「井戸水対応チーム」を中心に、井戸の洗浄が開始されております。\n　金子大臣は、「水道施設の復旧」に加えて、この「井戸の復旧」についても、工事業者の確保などの支援をしっかり行ってください。\n　ＪＲ九州、肥薩おれんじ鉄道については、一部区間の運休が続いています。\n　金子大臣は、早期の「全線復旧」を後押しするとともに、運休区間における「代替輸送」の確保について、対応を進めてください。\n　基幹産業である農林水産分野にも、大きな被害が確認されています。\n　山本大臣政務官（農林水産省）は、集出荷施設などの共同利用施設に対して、単純な復旧だけではなくて、将来を見据えた再編集約・合理化に向けた支援を継続・検討してください。\n　また、いぐさの織機などの農業用機械や施設の再取得・修繕、種子・種苗といった資材調達などの支援も検討して、農林漁業者が将来に希望を持って、生業を継続・再開できるように、必要な対策を速やかに取りまとめてください。\n　赤澤大臣は、「被災中小企業・小規模事業者支援」については、熊本県と連携して、被災事業者などの実態を踏まえて、「補助対象となる事業者の範囲」や「多重被災された方々」への支援を含め、丁寧かつ柔軟な支援に取り組んでください。\n　また、「雇用維持支援の強化」のため、上野大臣は、「雇用調整助成金の特例措置」が幅広く利用されるように、周知・広報にしっかり取り組んでください。\n　これまでの皆様の懸命の取組によりまして、「被災された方々への支援」や「生活インフラの復旧」などは着実に進んできておりますが、今なお多くの方が避難生活を余儀なくされています。\n　被災された方々に、１日も早く元の暮らしを取り戻していただけるよう、『支援策のパッケージ』を今月中に取りまとめ、政府として全力で支援をいたします。\n　各大臣、副大臣、政務官は、先日、熊本県の木村知事や「九州経済４団体」から頂戴したご要望、被災された方々、被災自治体から伺ったお声などを踏まえて、「できることは、全てやる」という決意の下で、必要な支援策について、早急に検討・調整を進めてください。\n　政府の総力を結集して、取組を加速してまいりましょう。\n　次に、「令和８年８月千葉豪雨」につきまして、各大臣は、千葉県を始めとする被災自治体などと緊密に連携をして、地元のニーズを的確に把握をしながら、１日も早い復旧に向けて全力で対応に当たってください。\n　被災自治体に対する支援として、本日、総額８７億円の「普通交付税の繰上げ交付」を行いました。\n　林大臣は、被災自治体が、財政上、安心して復旧に取り組むことができるよう、対応をお願いいたします。\n　今後の大雨に備えて、金子大臣、あかま大臣を中心に、「被災した施設の点検」と「応急対策」を早急に進めるとともに、被害把握と原因分析を進めてください。\n　また、前回お願いしたとおり、「内水氾濫発生時の危険性」を日本全国に広く周知してください。\n　金子大臣、あかま大臣は、道路のアンダーパス部の冠水について、「予防的な事前通行規制の導入」や「遮断機の設置」を含めて、「進入防止対策の強化」などの取組と、これも全国への周知を速やかに進めてください。\n　それから、「道路上の被災車両」でございますが、関係機関で構成される「プロジェクトチーム」を設置して撤去に取り組んでおります。\n　国管理道路、県管理道路、千葉市管理の「幹線道路」においては、路肩に残るこの被災車両を含めて、撤去が完了しています。\n　金子大臣には、関係団体と連携して「レッカー車両の確保」も進めながら、生活道路など残りの被災車両の早期解消に取り組んでください。\n　大雨などによる災害が多く発生する時期が続きます。\n　日本の南の海上では「台風第１８号」が発生しています。\n　金子大臣、あかま大臣におかれては、大雨などによる災害に備えた、「防災気象情報の発信」、「警戒態勢の確保」をお願いします。\n　今日御出席の関係大臣についても、必要に応じて協力をお願いします。\n　とにかくこの時期ですから、警戒を怠らず、緊張感を持って臨んでまいりましょう。\n　以上です。お疲れ様でした。"}}},"rest_id":"2090770748168384684","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"253372","state":"EnabledWithCount"}}},"rest_id":"2090773588358082684","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"11607","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090773588358082684","sortIndex":"2091535995869593553"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"use