":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2085674891723059201","indices":[146,169],"media_key":"3_2085674891723059201","media_results":{"result":{"media_key":"3_2085674891723059201"}},"media_url_https":"https://pbs.twimg.com/media/HPHOQ34asAE0B7V.jpg","original_info":{"focus_rects":[{"h":840,"w":1500,"x":0,"y":285},{"h":1125,"w":1125,"x":375,"y":0},{"h":1125,"w":987,"x":513,"y":0},{"h":1125,"w":563,"x":937,"y":0},{"h":1125,"w":1500,"x":0,"y":0}],"height":1125,"width":1500},"sizes":{"large":{"h":1125,"resize":"fit","w":1500},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/jv3Zj6rDBj"}]},"favorite_count":419,"favorited":false,"full_text":"【🛰防衛×宇宙🚀シリーズ㉖】\n第26弾は、「宇宙領域アドバイザリーボード」\n \n7月28日、防衛省は第3回宇宙領域アドバイザリーボードを開催🛰\n有識者の皆様と、防衛と経済の好循環、防衛イノベーションの促進に向けた国研・大学等との連携強化、光衛星通信の最新動向について、意見交換を行いました。 https://t.co/jv3Zj6rDBj","id_str":"2085674903664279745","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"quoted_status_id_str":"2080230677870780422","quoted_status_permalink":{"display":"x.com/ModJapan_jp/st…","expanded":"https://twitter.com/ModJapan_jp/status/2080230677870780422","url":"https://t.co/XrS6PVpqJy"},"reply_count":11,"retweet_count":72,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[195,200],"text":"宇宙安保"},{"indices":[201,215],"text":"SDF_SpaceYear"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/space_domain/index.html","indices":[169,192],"url":"https://t.co/2I3QuGHDva"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwODU2NzQ5MDM1NTA5OTIzODQ=","text":"【🛰防衛×宇宙🚀シリーズ㉖】\n第26弾は、「宇宙領域アドバイザリーボード」\n \n7月28日、防衛省は第3回宇宙領域アドバイザリーボードを開催🛰\n有識者の皆様と、防衛と経済の好循環、防衛イノベーション