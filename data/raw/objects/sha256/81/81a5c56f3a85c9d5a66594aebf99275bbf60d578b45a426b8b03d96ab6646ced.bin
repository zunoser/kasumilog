_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2979885,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":516,"tweets":1721},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2090731294904762595"],"editable_until_msecs":"1787307759000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":90,"bookmarked":false,"conversation_id_str":"2090731294904762595","created_at":"Fri Aug 21 09:22:39 +0000 2026","display_text_range":[0,101],"entities":{},"favorite_count":12502,"favorited":false,"full_text":"本日は、「令和８年８月千葉豪雨　第２回　関係閣僚会議」を開催しました。\n\n＜普通交付税の繰上げ交付について＞\n\n被災自治体に対する支援として、本日、総額87億円の「普通交付税の繰上げ交付」を行いました。","id_str":"2090731294904762595","is_quote_status":false,"lang":"ja","quote_count":100,"reply_count":810,"retweet_count":1262,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTA3MzEyOTQ4MzM0ODc4NzI=","richtext":{"richtext_tags":[]},"text":"本日は、「令和８年８月千葉豪雨　第２回　関係閣僚会議」を開催しました。\n\n＜普通交付税の繰上げ交付について＞\n\n被災自治体に対する支援として、本日、総額87億円の「普通交付税の繰上げ交付」を行いました。\n\n林大臣には、被災自治体が財政上、安心して復旧に取り組むことができるよう、対応をするよう、指示しました。\n\n＜内水対策について＞\n\n今後の大雨に備えて、金子大臣、あかま大臣を中心に、「被災した施設の点検」と「応急対策」を早急に進めるとともに、被害把握と原因分析を進めるよう、指示しました。\n\nまた、「内水氾濫発生時の危険性」を日本全国に広く周知するよう、指示しました。\n\n＜アンダーパス進入対策について＞\n\n金子大臣、あかま大臣には、道路のアンダーパス部の冠水について、「予防的な事前通行規制の導入」や「遮断機の設置」を含め、「進入防止対策の強化」などの取組と、日本全国への周知を速やかに進めるよう、指示しました。\n\n＜道路上の被災車両の解消状況について＞\n\n道路上の「被災車両」については、関係機関で構成される「プロジェクトチーム」を設置して撤去に取り組んでおり、国管理道路、県管理道路、千葉市管理の「幹線道路」においては、路肩に残る「被災車両」を含め、撤去が完了しています。\n\n金子大臣には、関係団体とも連携して「レッカー車両の確保」などを進めながら、「生活道路」など、残りの「被災車両」の早期解消に取り組むよう、指示しました。\n\n＜今後の災害への備えについて＞\n\n大雨などによる災害が多く発生する時期が続いています。\n\n日本の南の海上では、「台風第18号」が発生しています。\n\n金子大臣、あかま大臣には、大雨などによる災害に備えた「防災気象情報の発信」と「警戒態勢の確保」を行うよう、指示しました。\n関係大臣についても、必要に応じた協力をお願いしています。\n\n政府として、警戒を怠らず、緊張感を持って臨んでまいります。"}}},"rest_id":"2090731294904762595","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"621050","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090731294904762595","sortIndex":"2091535995869593534"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results