す。\n時刻表を確認し時間までに受付を済…","id_str":"2091483430102208624","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":72,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1921748497898082304/BoMcyaWB_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1921727316897726464/1747015579"},"core":{"created_at":"Mon May 12 00:42:47 +0000 2025","name":"第十管区海上保安本部【公式】","screen_name":"JCG_10th_RCGH"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxOTIxNzI3MzE2ODk3NzI2NDY0","is_blue_verified":false,"location":{"location":"鹿児島県鹿児島市東郡元町4番1号"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"海上保安庁第十管区海上保安本部公式アカウントです。鹿児島県、熊本県、宮崎県の海の安心・安全に関する情報及び海上保安官の活動・業務について発信していきます。運用ポリシーはこちら\nhttps://t.co/Xvmf24KqIa","entities":{"description":{"urls":[{"display_url":"kaiho.mlit.go.jp/10kanku/info/s…","expanded_url":"https://www.kaiho.mlit.go.jp/10kanku/info/sns.html","indices":[88,111],"url":"https://t.co/Xvmf24KqIa"}]},"url":{"urls":[{"display_url":"kaiho.mlit.go.jp/10kanku/","expanded_url":"https://www.kaiho.mlit.go.jp/10kanku/","indices":[0,23],"url":"https://t.co/ChnfcSPItG"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2577,"following":19},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1921727316897726464","