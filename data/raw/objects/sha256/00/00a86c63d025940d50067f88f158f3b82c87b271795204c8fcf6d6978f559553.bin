://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":383711,"following":477},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"571429134","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7969,"tweets":88382},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/yYaoVyKjKO"}}}},"edit_control":{"edit_tweet_ids":["2099332311607038336"],"editable_until_msecs":"1789358401000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2099332311607038336","created_at":"Mon Sep 14 03:00:01 +0000 2026","display_text_range":[0,141],"entities":{"hashtags":[{"indices":[2,13],"text":"逆さまなてるてる坊主"},{"indices":[31,36],"text":"まいはに"}]},"favorite_count":7,"favorited":false,"full_text":"🌦️#逆さまなてるてる坊主☔️\n\n毎日はにかむ僕たちは。\n（”#まいはに”）にて、\n日本テレビが手がける\nショートドラマ配信中📺（全2話）\n\nぜひ最後までお楽しみください✨\n\n《概要》\n親の仕事が恥ずかしいと\n思ったことはありますか？\n女子高生のルナは、\n工事現場で働く父親のことが","id_str":"2099332311607038336","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":2,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[2,13],"text":"逆さまなてるてる坊主"},{"indices":[31,36],"text":"まいはに"},{"indices":[559,570],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"vt.tiktok.com/ZSV2mF61C/","expanded_url":"https://vt.tiktok.com/ZSV2mF61C/","indices":[262,285],"url":"https://t.co/lEXRQdpFHO"},{"display_url":"vt.tiktok.com/ZSV2mJPdc/","expanded_url":"https://vt.tiktok.com/ZSV2mJPdc/","indices":[289,312],"url":"https://t.co/hOJjXWLTxT"},{"display_url":"instagram.com/reel/Db9Zq42yg…","expanded_url":"https://www.instagram.com/reel/Db9Zq42yg9w/?igsh=OGttZWxweGZ3am9u&igsi=OGttZWxweGZ3am9u","indices":[328,351],"url":"https://t.co/DbNNuMvZX3"},{"display_url":"instagram.com/reel/Db_-draS3…","expanded_url":"https://www.instagram.com/reel/Db_-draS3e6/?igsh=MXV3eWRxNDRodTVzcQ==&igsi=MXV3eWRxNDRodTVzcQ==","indices":[355,378],"url":"https://t.co/0PwEh1TU8n"},{"display_url":"youtube.com/shorts/Vecz0AH…","expanded_url":"https://youtube.com/shorts/Vecz0AHy2ZA?si=1FWA9k2T8dKPvgjL","indices":[393,416],"url":"https://t.co/AeRDMFo0Q1"},{"display_url":"youtube.com/shorts/E3SJ0FU…","expanded_url":"https://youtube.com/shorts/E3SJ0FUNx_Q?si=ry5hTFKd0dSiu-sV","indices":[420,443],"url":"https://t.co/TB0SJbjKqt"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[534,557],"url":"https://t.co/kPJLLRPaZ9"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTkzMzIzMTE0NDc3NTI3MDY=","text":"🌦️#逆さまなてるてる坊主☔️\n\n毎日はにかむ僕たちは。\n（”#まいはに”）にて、\n日本テレビが手がける\nショートドラマ配信中📺（全2話）\n\nぜひ最後までお楽しみください✨\n\n《概要》\n親の仕事が恥ずかしいと\n思ったことはありますか？\n女子高生のルナは、\n工事現場で働く父親のことが\nなんだか恥ずかしくて、\n友達にも父親の仕事を知られたくない。\nある日の帰り道、友達・あゆの前で、\n偶然父に声をかけられたルナだったが、\nとっさに他人のふりをしてしまう……\n＿＿＿＿＿＿＿＿＿\n\n≪視聴はこちらから≫\n\n🎵TikTok\n１話\nhttps://t.co/lEXRQdpFHO\n２話\nhttps://t.co/hOJjXWLTxT\n\n📷Instagram\n１話\nhttps://t.co/DbNNuMvZX3\n２話\nhttps://t.co/0PwEh1TU8n\n\n▶️YouTube\n１話\nhttps://t.co/AeRDMFo0Q1\n２話\nhttps://t.co/TB0SJbjKqt\n＿＿＿＿＿＿＿＿＿\n\n国土交通省は「建設業への入職促進に向けた\n魅力発信事業」における\n「中高生・保護者向けPR」の一環として、\n本コンテンツに提供しています。\n\n詳しくはこちら\nhttps://t.co/kPJLLRPaZ9\n\n#MLIT建設産業PR"}}},"rest_id":"2099332311607038336","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"3169","state":"EnabledWithCount"}}}}},"entryId":"tweet-