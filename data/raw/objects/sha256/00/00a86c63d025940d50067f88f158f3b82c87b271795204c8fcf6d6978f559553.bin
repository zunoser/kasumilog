0}},"type":"photo","url":"https://t.co/ILr9hpLqW1"}]},"favorite_count":62,"favorited":false,"full_text":"＼その著名人、本物ですか？ ／\n著名人になりすまして投資に誘導する詐欺の被害が多発しています。実際になりすまされているアジア開発銀行の神田眞人総裁も「私がSNSで投資を指南することはありません。」と注意を呼び掛けています。\nhttps://t.co/aWnu7Zdnk6 https://t.co/ILr9hpLqW1","id_str":"2099362507907338749","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":3,"retweet_count":30,"retweeted":false,"user_id_str":"2891516809"},"rest_id":"2099362507907338749","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3493","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099362507907338749","sortIndex":"2099382174250696695"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1788223971"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2098547136887452121"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6ku2s"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":296702,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4942,"tweets":12922},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6ku2s"}}}},"edit_control":{"edit_tweet_ids":["2099362505521082474"],"editable_until_msecs":"1789365600000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2099362505521082474","created_at":"Mon Sep 14 05:00:00 +0000 2026","display_text_range":[0,159],"entities":{"media":[{"display_url":"pic.x.com/hvnJ8KQZTL","expanded_url":"https://x.com/gov_online/status/2099362505521082474/photo/1","ext_alt_text":"上部に「自然災害でローンの返済が困難になったかたへ。「自然災害債務整理ガイドライン」という選択肢があります。※「災害救助法」が適用された自然災害により被災した、個人又は個人事業者のかたが対象。※そのほかにいくつかの要件を満たす必要があります」と記載されており、その下に、家が倒壊してしまい「ローンが残っているのに...」と困っている様子の男性イラストが描かれている。その下には、次のように記載されている。3つのメリット。個人信用情報として登録されず、その後の新たな借入れにも影響が及ばない。登録支援専門家の支援を無料で受けられる。預貯金などの財産の一部を手元に残すことができる。※個別事情により異なります。希望する場合は、ローンの借入先の金融機関にお問い合わせください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":71,"w":71,"x":496,"y":95}]},"medium":{"faces":[{"h":65,"w":65,"x":457,"y":87}]},"orig":{"faces":[{"h":71,"w":71,"x":496,"y":95}]},"small":{"faces":[{"h":37,"w":37,"x":259,"y":49}]}},"id_str":"2099358620433661952","indices":[160,183],"media_key":"3_2099358620433661952","media_results":{"result":{"media_key":"3_2099358620433661952"}},"media_url_https":"https://pbs.twimg.com/media/HSJritsaQAAepN1.jpg","original_info":{"focus_rects":[{"h":546,"w":975,"x":0,"y":734},{"h":975,"w":975,"x":0,"y":325},{"h":1112,"w":975,"x":0,"y":188},{"h":1300,"w":650,"x":0,"y":0},{"h":1300,"w":975,"x":0,"y":0}],"height":1300,"width":975},"sizes":{"large":{"h":1300,"resize":"fit","w":975},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/hvnJ8KQZTL"}],"urls":[{"display_url":"gov-online.go.jp/article/201607…","expanded_url":"https://www.gov-online.go.jp/article/201607/entry-10613.html","indices":[125,148],"url":"https://t.co/B0GeT2dIcy"}],"user_mentions":[{"id_str":"276848601","indices":[149,159],"name":"金融庁","screen_name":"fsa_JAPAN"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/hvnJ8KQZTL","expanded_url":"https://x.com/gov_online/status/2099362505521082474/photo/1","ext_alt_text":"上部に「自然災害でローンの返済が困難になったかたへ。「自然災害債務整理ガイドライン」という選択肢があります。※「災害救助法」が適用された自然災害により被災した、個人又は個人事業者のかたが対象。※そのほかにいくつかの要件を満たす必要があります」と記載されており、その下に、家が倒壊してしまい「ローンが残っているのに...」と困っている様子の男性イラストが描かれている。その下には、次のように記載されている。3つのメリット。個人信用情報として登録されず、その後の新たな借入れにも影響が及ばない。登録支援専門家の支援を無料で受けられる。預貯金などの財産の一部を手元に残すことができる。※個別事情により異なります。希望する場合は、ローンの借入先の金融機関にお問い合わせください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":71,"w":71,"x":496,"y":95}]},"medium":{"faces":[{"h":65,"w":65,"x":457,"y":87}]},"orig":{"faces":[{"h":71,"w":71,"x":496,"y":95}]},"small":{"faces":[{"h":37,"w":37,"x":259,"y":49}]}}