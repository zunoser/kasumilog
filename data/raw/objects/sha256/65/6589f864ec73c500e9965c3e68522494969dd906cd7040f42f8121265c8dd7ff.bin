5,"y":314}]},"small":{"faces":[{"h":22,"w":22,"x":251,"y":131},{"h":22,"w":22,"x":42,"y":177}]}},"id_str":"2100729125258563584","indices":[111,134],"media_key":"3_2100729125258563584","media_results":{"result":{"media_key":"3_2100729125258563584"}},"media_url_https":"https://pbs.twimg.com/media/HSdKAmBakAA_XYV.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":54},{"h":800,"w":800,"x":200,"y":0},{"h":800,"w":702,"x":249,"y":0},{"h":800,"w":400,"x":400,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OYULJ4j5yI"},{"display_url":"pic.x.com/OYULJ4j5yI","expanded_url":"https://x.com/jointstaffpa/status/2100880007233241371/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":158,"w":158,"x":843,"y":97},{"h":186,"w":186,"x":480,"y":160}]},"medium":{"faces":[{"h":158,"w":158,"x":843,"y":97},{"h":186,"w":186,"x":480,"y":160}]},"orig":{"faces":[{"h":158,"w":158,"x":843,"y":97},{"h":186,"w":186,"x":480,"y":160}]},"small":{"faces":[{"h":89,"w":89,"x":477,"y":54},{"h":105,"w":105,"x":272,"y":90}]}},"id_str":"2100729125317246976","indices":[111,134],"media_key":"3_2100729125317246976","media_results":{"result":{"media_key":"3_2100729125317246976"}},"media_url_https":"https://pbs.twimg.com/media/HSdKAmPaAAAfbYG.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":800,"w":800,"x":400,"y":0},{"h":800,"w":702,"x":498,"y":0},{"h":800,"w":400,"x":730,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OYULJ4j5yI"}]},"favorite_count":342,"favorited":false,"full_text":"９月１５日、白川統幕副長は、第３回　日ASEAN WPS協力プロジェクトに参加し、挨拶を述べました。また、９月１５日～１７日、統幕ジェンダーアドバイザー中田１空佐は、本プロジェクトにグループ討議の教官として参加しました。 https://t.co/OYULJ4j5yI","id_str":"2100880007233241371","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":30,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA4ODAwMDcxOTU0NDcyOTY=","text":"９月１５日、白川統幕副長は、第３回　日ASEAN WPS協力プロジェクトに参加し、挨拶を述べました。また、９月１５日～１７日、統幕ジェンダーアドバイザー中田１空佐は、本プロジェクトにグループ討議の教官として参加しました。\n\n東南アジア諸国、フィジー、ケニア、モンゴル、PNG、トンガ、イエメン及びEUに対して、WPS（女性・平和・安全保障）をテーマとした協力プロジェクトを日本が提供することで、各国のWPS取組推進を支援するとともに、関係諸国との関係を更に強化しました。"}}},"rest_id":"2100880007233241371","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"22901","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2100991614881853857","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"3426","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100991614881853857","sortIndex":"2101104449140293629"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profil