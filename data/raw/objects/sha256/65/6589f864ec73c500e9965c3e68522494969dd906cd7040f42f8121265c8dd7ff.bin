:229},{"h":73,"w":73,"x":522,"y":595}]},"orig":{"faces":[{"h":129,"w":129,"x":1389,"y":463},{"h":144,"w":144,"x":1789,"y":473},{"h":131,"w":131,"x":1059,"y":478},{"h":153,"w":153,"x":1088,"y":1240}]},"small":{"faces":[{"h":35,"w":35,"x":377,"y":125},{"h":39,"w":39,"x":486,"y":128},{"h":35,"w":35,"x":288,"y":130},{"h":41,"w":41,"x":295,"y":337}]}},"id_str":"2100879202698596353","indices":[85,108],"media_key":"3_2100879202698596353","media_results":{"result":{"media_key":"3_2100879202698596353"}},"media_url_https":"https://pbs.twimg.com/media/HSfSgQDbEAEg54P.jpg","original_info":{"focus_rects":[{"h":1400,"w":2500,"x":0,"y":0},{"h":1667,"w":1667,"x":0,"y":0},{"h":1667,"w":1462,"x":0,"y":0},{"h":1667,"w":834,"x":0,"y":0},{"h":1667,"w":2500,"x":0,"y":0}],"height":1667,"width":2500},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Zp5uud1TLa"}]},"favorite_count":338,"favorited":false,"full_text":"#陸上自衛隊 は、９月１５日から１７日の間、防衛省が主催する第３回日ＡＳＥＡＮ #ＷＰＳ(#WomenPeaceandSecurity)協力プロジェクトに参加しました。 https://t.co/Zp5uud1TLa","id_str":"2100902656516747338","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":3,"retweet_count":31,"retweeted":false,"user_id_str":"265814534"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[0,6],"text":"陸上自衛隊"},{"indices":[40,44],"text":"ＷＰＳ"},{"indices":[45,67],"text":"WomenPeaceandSecurity"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA5MDI2NTY0NzQ3OTE5MzY=","text":"#陸上自衛隊 は、９月１５日から１７日の間、防衛省が主催する第３回日ＡＳＥＡＮ #ＷＰＳ(#WomenPeaceandSecurity)協力プロジェクトに参加しました。\n防衛省・自衛隊を含む各国取組紹介においては、陸自のジェンダー･アドバイザー等が災害現場に進出して被災者目線の支援に繋がる取組を紹介したほか、ＡＳＥＡＮやインド太平洋地域の国々からの発表や意見交換を通じて、様々な知見や経験を学ぶことができました。\nその後に実施した災害対応に係る机上検討においては、関係部隊等からの参加を得て直近の災害派遣の教訓を取り込みながら、被災者に寄り添った支援のあり方について議論を交わし、他の参加者とともにＷＰＳに係る理解を深めることができました。"}}},"rest_id":"2100902656516747338","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"26744","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2100991663317627215","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"3856","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100991663317627215","sortIndex":"2101104449140293630"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display