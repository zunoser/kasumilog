e,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6ku2s"}}}},"edit_control":{"edit_tweet_ids":["2100866163643183139"],"editable_until_msecs":"1789724100000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":10,"bookmarked":false,"conversation_id_str":"2100866163643183139","created_at":"Fri Sep 18 08:35:00 +0000 2026","display_text_range":[0,142],"entities":{"media":[{"display_url":"pic.x.com/tIQCcGB7Lh","expanded_url":"https://x.com/gov_online/status/2100866163643183139/photo/1","ext_alt_text":"上部に「クマに出会わないための3つの対策。」と記載されており、その下に、クマの生息域と人の生活圏の境界を示し、クマに出会わないための対策や、クマと人のすみ分けの重要性を表したイラストが描かれている。その下には、次のように記載されている。「1。クマを寄せ付けない。・収穫しない果実や生ゴミなど、クマを引き寄せるものは取り除く。・クマが身を隠しやすい草や木を刈る。・畑や果樹園に近づけないために電気柵の設置も有効。2。人の存在を知らせる。・音が出るものを持ち歩いたり、複数人で会話をしながら歩いたりする。3。クマの出没情報を調べる。・外出前に、移動経路や目的地周辺の出没情報を確認する。・出没情報がある場合は、不要不急の外出を控える。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100864824490233856","indices":[143,166],"media_key":"3_2100864824490233856","media_results":{"result":{"media_key":"3_2100864824490233856"}},"media_url_https":"https://pbs.twimg.com/media/HSfFbVDakAA2vak.jpg","original_info":{"focus_rects":[{"h":526,"w":940,"x":0,"y":708},{"h":940,"w":940,"x":0,"y":314},{"h":1072,"w":940,"x":0,"y":182},{"h":1254,"w":627,"x":0,"y":0},{"h":1254,"w":940,"x":0,"y":0}],"height":1254,"width":940},"sizes":{"large":{"h":1254,"resize":"fit","w":940},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/tIQCcGB7Lh"}],"urls":[{"display_url":"gov-online.go.jp/article/202609…","expanded_url":"https://www.gov-online.go.jp/article/202609/entry-11625.html","indices":[107,130],"url":"https://t.co/2rznRPuqKn"}],"user_mentions":[{"id_str":"286056244","indices":[131,142],"name":"環境省","screen_name":"Kankyo_Jpn"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/tIQCcGB7Lh","expanded_url":"https://x.com/gov_online/status/2100866163643183139/photo/1","ext_alt_text":"上部に「クマに出会わないための3つの対策。」と記載されており、その下に、クマの生息域と人の生活圏の境界を示し、クマに出会わないための対策や、クマと人のすみ分けの重要性を表したイラストが描かれている。その下には、次のように記載されている。「1。クマを寄せ付けない。・収穫しない果実や生ゴミなど、クマを引き寄せるものは取り除く。・クマが身を隠しやすい草や木を刈る。・畑や果樹園に近づけないために電気柵の設置も有効。2。人の存在を知らせる。・音が出るものを持ち歩いたり、複数人で会話をしながら歩いたりする。3。クマの出没情報を調べる。・外出前に、移動経路や目的地周辺の出没情報を確認する。・出没情報がある場合は、不要不急の外出を控える。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100864824490233856","indices":[143,166],"media_key":"3_2100864824490233856","media_results":{"result":{"media_key":"3_2100864824490233856"}},"media_url_https":"https://pbs.twimg.com/media/HSfFbVDakAA2vak.jpg","original_info":{"focus_rects":[{"h":526,"w":940,"x":0,"y":708},{"h":940,"w":940,"x":0,"y":314},{"h":1072,"w":940,"x":0,"y":182},{"h":1254,"w":627,"x":0,"y":0},{"h":1254,"w":940,"x":0,"y":0}],"height":1254,"width":940},"sizes":{"large":{"h":1254,"resize":"fit","w":940},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/tIQCcGB7Lh"}]},"favorite_count":182,"favorited":false,"full_text":"クマに出会わないための3つの対策\n\n近年は、市街地や住宅街など、私たちの生活圏にもクマが出没しています⚠️\n\nこれまで出没がなかった地域でも遭遇する可能性があります。\nもしもに備えて、対策を確認しておきましょう。\nhttps://t.co/2rznRPuqKn\n@Kankyo_Jpn https://t.co/tIQCcGB7Lh","id_str":"2100866163643183139","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":0,"retweet_count":63,"retweeted":false,"user_id_str":"461064204"},"rest_id":"2100866163643183139","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unme