.x.com/YKIYr0M6F0","expanded_url":"https://x.com/takaichi_sanae/status/2108757333950275855/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108757285883564032","indices":[114,137],"media_key":"3_2108757285883564032","media_results":{"result":{"media_key":"3_2108757285883564032"}},"media_url_https":"https://pbs.twimg.com/media/HUPPlC6bUAAOcQm.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":599},{"h":2893,"w":2893,"x":0,"y":0},{"h":2893,"w":2538,"x":0,"y":0},{"h":2893,"w":1447,"x":403,"y":0},{"h":2893,"w":4096,"x":0,"y":0}],"height":2893,"width":4096},"sizes":{"large":{"h":1447,"resize":"fit","w":2048},"medium":{"h":848,"resize":"fit","w":1200},"small":{"h":480,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YKIYr0M6F0"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/YKIYr0M6F0","expanded_url":"https://x.com/takaichi_sanae/status/2108757333950275855/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108757285883564032","indices":[114,137],"media_key":"3_2108757285883564032","media_results":{"result":{"media_key":"3_2108757285883564032"}},"media_url_https":"https://pbs.twimg.com/media/HUPPlC6bUAAOcQm.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":599},{"h":2893,"w":2893,"x":0,"y":0},{"h":2893,"w":2538,"x":0,"y":0},{"h":2893,"w":1447,"x":403,"y":0},{"h":2893,"w":4096,"x":0,"y":0}],"height":2893,"width":4096},"sizes":{"large":{"h":1447,"resize":"fit","w":2048},"medium":{"h":848,"resize":"fit","w":1200},"small":{"h":480,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YKIYr0M6F0"}]},"favorite_count":10916,"favorited":false,"full_text":"【日本列島を、強く豊かに。：十勝編】\n\n高市内閣では、『日本成長戦略』に掲げた「戦略17分野」における官民投資の促進や、『地域未来戦略』に基づく「産業クラスターの形成」につなげるため、「国家戦略特区制度」の活用を進めています。 https://t.co/YKIYr0M6F0","id_str":"2108757333950275855","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":737,"reply_count":1970,"retweet_count":1513,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[694,706],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg3NTczMzM4NjIxOTkyOTY=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：十勝編】\n\n高市内閣では、『日本成長戦略』に掲げた「戦略17分野」における官民投資の促進や、『地域未来戦略』に基づく「産業クラスターの形成」につなげるため、「国家戦略特区制度」の活用を進めています。\n\n「国家戦略特区制度」とは、大胆な規制・制度改革によって、ビジネス・投資環境を整備し、経済成長につなげるための仕組みです。\n\n例えば、『地域未来戦略』に基づき、戦略17分野に関連する企業の大規模投資を起点に、広域の産業クラスター計画を策定する「戦略産業クラスター計画」として、今年7月、「AI・半導体戦略産業クラスター計画（北海道地域）」を策定しました。\n\nこの計画では、十勝のポテンシャルを活かして、「AI農業」を実現することや、この実現に向けて、「国家戦略特区制度」を活用して、AI農業技術の開発・実証、社会実装のための規制・制度改革を推進していくことが掲げられました。\n\nこのため、民間有識者による議論を経て、先月9月、北海道帯広市など十勝地方の19市町村を、「十勝AI農業特区」に指定しました。\n\n「AI農業特区」を活用してロボット・トラクタの公道自動走行や、ドローンを活用した農薬散布などによるAI農業の実証が進められ、AI農業を全国に普及していくAI農業先進地がスピード感をもって実現されていくことを期待しています。\n\n高市内閣では、このような「国家戦略特区制度」を活用する自治体の取組を、『日本成長戦略』に基づく『官民投資ロードマップ』や、『地域未来戦略』に基づく3類型の「産業クラスター計画」においても、積極的に位置づけ、応援していきます。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2108757333950275855","unmention_data":{},"views":{"count":"1150342","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108757333950275855","sortIndex":"2109704447532728284"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typena