"expanded_url":"https://x.com/meti_NIPPON/status/2109303374244151371/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":409,"w":409,"x":863,"y":295}]},"medium":{"faces":[{"h":240,"w":240,"x":505,"y":173}]},"orig":{"faces":[{"h":417,"w":417,"x":879,"y":301}]},"small":{"faces":[{"h":136,"w":136,"x":286,"y":98}]}},"id_str":"2109299073169944576","indices":[108,131],"media_key":"3_2109299073169944576","media_results":{"result":{"media_key":"3_2109299073169944576"}},"media_url_https":"https://pbs.twimg.com/media/HUW8VN1a8AAoxCT.jpg","original_info":{"focus_rects":[{"h":1168,"w":2085,"x":0,"y":0},{"h":1702,"w":1702,"x":243,"y":0},{"h":1702,"w":1493,"x":348,"y":0},{"h":1702,"w":851,"x":669,"y":0},{"h":1702,"w":2085,"x":0,"y":0}],"height":1702,"width":2085},"sizes":{"large":{"h":1672,"resize":"fit","w":2048},"medium":{"h":980,"resize":"fit","w":1200},"small":{"h":555,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/oMFPIrjjsi"},{"display_url":"pic.x.com/oMFPIrjjsi","expanded_url":"https://x.com/meti_NIPPON/status/2109303374244151371/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":87,"w":87,"x":581,"y":259},{"h":143,"w":143,"x":317,"y":81}]},"medium":{"faces":[{"h":87,"w":87,"x":581,"y":259},{"h":143,"w":143,"x":317,"y":81}]},"orig":{"faces":[{"h":87,"w":87,"x":581,"y":259},{"h":143,"w":143,"x":317,"y":81}]},"small":{"faces":[{"h":49,"w":49,"x":332,"y":148},{"h":81,"w":81,"x":181,"y":46}]}},"id_str":"2109299102186192896","indices":[108,131],"media_key":"3_2109299102186192896","media_results":{"result":{"media_key":"3_2109299102186192896"}},"media_url_https":"https://pbs.twimg.com/media/HUW8W57bwAAs2tP.jpg","original_info":{"focus_rects":[{"h":665,"w":1188,"x":0,"y":0},{"h":780,"w":780,"x":0,"y":0},{"h":780,"w":684,"x":44,"y":0},{"h":780,"w":390,"x":191,"y":0},{"h":780,"w":1188,"x":0,"y":0}],"height":780,"width":1188},"sizes":{"large":{"h":780,"resize":"fit","w":1188},"medium":{"h":780,"resize":"fit","w":1188},"small":{"h":446,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/oMFPIrjjsi"}]},"favorite_count":164,"favorited":false,"full_text":"10月11日（日曜日）、第17回国際エネルギー・フォーラム（IEF）閣僚会合に赤澤大臣がオンライン出席しました。#meti_daijin\n赤澤大臣は、開会セッションでサウジアラビアのアブドルアジーズ・ビン・サルマン https://t.co/oMFPIrjjsi","id_str":"2109303374244151371","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":13,"retweet_count":45,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[56,68],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/10/…","expanded_url":"https://www.meti.go.jp/press/2026/10/20261012001.html","indices":[359,382],"url":"https://t.co/GX7hFPevqq"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDkzMDMzNzQxMDE1Nzc3Mjg=","richtext":{"richtext_tags":[]},"text":"10月11日（日曜日）、第17回国際エネルギー・フォーラム（IEF）閣僚会合に赤澤大臣がオンライン出席しました。#meti_daijin\n赤澤大臣は、開会セッションでサウジアラビアのアブドルアジーズ・ビン・サルマン エネルギー大臣の直後にスピーチを行い、中東情勢の緊迫化を踏まえ、エネルギー安全保障の重要性及び産油国と消費国の協力の必要性を訴えました。その上で、「パワー・アジア」のもと、アジアのエネルギー強靱化に向けた石油備蓄制度・インフラ整備、産油国との連携強化、緊急時の連携対応等に関するAZEC（アジア・ゼロエミッション共同体）の取組方針を紹介するとともに、日本が中東の産油国とアジア諸国の結節点として地域間連携を強化し、世界のエネルギー安定供給に貢献していく考えを発信しました。\n\n👇プレスリリースはこちら\nhttps://t.co/GX7hFPevqq"}}},"rest_id":"2109303374244151371","unmention_data":{},"views":{"count":"14744","state":"EnabledWithCount"}}}}},"entryId":"tweet-2109303374244151371","sortIndex":"2109704447532728303"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2109704447532728338-tweet-2109294134498669039","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2107316172916130039"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":591313,"following":204},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20290,"tweets":49020},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2109294134498669039"],"editable_until_msecs":"1791733485000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":118,"bookmarked":false,"conversation_id_str":"2109294134498669039","created_at":"Sun Oct 11 14:44:45 +0000 2026","display_text_range":[0,38],"entities":{"media":[{"display_url":"pic.x.com/u7tNHeRZrK","expanded_url":"https://x.com/MofaJapan_jp/status/2109294134498669039/photo/1","ext_alt_text":"外務大臣談話：サウジアラビアにおけるホーシー派の攻撃について\n令和8年10月11日\n１ 10月7日から10日にかけて、サウジアラビアの複数の国際空港がイエメンのホーシー派によって攻撃され、民間人の死傷者及び民間施設への被害が発生しています。特に、10日のリヤドのキング・ハーリド国際空港に対する攻撃では、現時点で民間人を含む12名の死者及び300名以上の負傷者が発生した旨発表されています。\n\n２ 日本は、サウジアラビア政府及び犠牲者の御遺族に対し、心から哀悼の意を表するとともに、負傷者の一刻も早い回復を祈念します。民間人や民間施設に対する攻撃は決して容認できず、日本はホーシー派による一連の攻撃を改めて強く非難します。同時に、ホーシー派に対し、イエメン内外における事態のエスカレーションを直ちに控えるよう重ねて強く求めます。\n\n３ 中東地域全体の平和と安定は、エネルギー安全保障の観点からも、日本を含む国際社会全体にとって極めて重要です。日本として、引き続きサウジアラビア及びイエメンをはじめとする関係各国と連携しながら、事態の早期沈静化・安定化に向け、あらゆる外交努力を重ねていきます。\n\n４ また、政府として、中東地域における邦人保護に引き続き万全を期していきます。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2109291883298226176","indices":[39,62],"media_key":"3_2109291883298226176","media_results":{"result":{"media_key":"3_2109291883298226176"}},"media_url_https":"https://pbs.twimg.com/media/HUW1ytebAAAS2ck.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":960,"w":960,"x":0,"y":0},{"h":1094,"w":960,"x":0,"y":0},{"h":1200,"w":600,"x":360,"y":0},{"h":1200,"w":960,"x":0,"y":0}],"h