ue,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1005shoshinhyomei.html","indices":[280,303],"url":"https://t.co/VLOHmIUPX1"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1MzAyNjQyNjM4NDM4NDA=","richtext":{"richtext_tags":[]},"text":"【高市総理・所信表明演説（外交、防衛力・インテリジェンス機能の強化）】\n法の支配の重要性を発信するとともに、和平調停の取組を含め、紛争の平和的解決に、より積極的な役割を果たすなど、法の支配に基づく国際秩序を維持・強化してまいります。\n平和は、願うだけで実現するものではありません。高市内閣は、平和と安定のための外交努力を重ねるとともに、防衛力の強化を着実に進め、国民の皆様の生命と財産、そして日本の領土・領海・領空を断固として守り抜いてまいります。\n\n10月5日に行われた高市総理の所信表明演説の動画及びテキストは、官邸HPに掲載しています。\n▼詳細はこちら\nhttps://t.co/VLOHmIUPX1"}}},"rest_id":"2108530264335065470","unmention_data":{},"views":{"count":"59145","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108530264335065470","sortIndex":"2109704447532728269"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_