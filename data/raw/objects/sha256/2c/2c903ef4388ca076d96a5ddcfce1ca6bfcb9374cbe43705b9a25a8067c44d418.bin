.co/OJgHuDwqLZ"}]},"favorite_count":29,"favorited":false,"full_text":"【#国民の祝日】 \n\n10月12日は「#スポーツの日」です。スポーツを楽しみ、他者を尊重する精神を培うとともに、健康で活力ある社会の実現を願う日です（祝日法）。\nこれを機会に、各地で開催されるスポーツイベントなどに参加してみてはいかがでしょうか。\n\n「国民の祝日」\nhttps://t.co/OJgHuDwqLZ","id_str":"2108467507430625750","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":7,"retweet_count":17,"retweeted":false,"user_id_str":"2904127170"},"rest_id":"2108467507430625750","unmention_data":{},"views":{"count":"9197","state":"EnabledWithCount"}}},"rest_id":"2109433871427092538","unmention_data":{},"views":{"count":"9993","state":"EnabledWithCount"}}}}},"entryId":"tweet-2109433871427092538","sortIndex":"2109704447532728305"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3015158,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":579,"tweets":1864},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2109424460520640548"],"editable_until_msecs":"1791764557000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":113,"bookmarked":false,"conversation_id_str":"2109424460520640548","created_at":"Sun Oct 11 23:22:37 +0000 2026","display_text_range":[0,85],"entities":{},"favorite_count":12827,"favorited":false,"full_text":"今日は、「スポーツの日」です。\n\nスポーツ政策については、『スポーツ基本法』と、同法を踏まえて策定されている『スポーツ基本計画』に基づいて、様々な取組が進められています。","id_str":"2109424460520640548","is_quote_status":false,"lang":"ja","quote_count":393,"reply_count":1160,"retweet_count":1220,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDk0MjQ0NjA0NTM1NDM5MzY=","richtext":{"richtext_tags":[]},"text":"今日は、「スポーツの日」です。\n\nスポーツ政策については、『スポーツ基本法』と、同法を踏まえて策定されている『スポーツ基本計画』に基づいて、様々な取組が進められています。\n\n現在、来年度からの5年間を対象とする、『第4期スポーツ基本計画』の検討が進められおり、本『計画』では、国民の皆様お一人お一人がスポーツの「素晴らしさ」や「楽しさ」を実感され、スポーツを通して、人や地域の可能性を見出し、未来を切り拓いていかれることをねらいとしています。\n\nスポーツは、選手の皆様が、努力を積み重ね、限界に挑戦する姿などを通して、私たちに「感動」や「喜び」をもたらしてくれます。\nこのため、高市内閣では、我が国の「国際競技力」の向上に向けた選手の皆様への支援、国際大会の日本への招致や開催支援、スポーツによる国際交流、「パラスポーツ」の振興などに取り組んでいます。\n\nまた、スポーツは、心身の健康の維持・増進、病気の予防にも有効です。\nこのため、従業員の「運動・スポーツ」を推進する企業への支援、地域スポーツの振興、子供の頃からの「運動習慣づくり」などの施策を進めており、国民の皆様が健康で元気に過ごすことができる「健康インフラ」の構築にも取り組んでいます。\n\nさらに、スポーツによる「地域活性化」やスポーツの「成長産業化」などにも取り組んでいます。\n具体的には、「スタジアム」や「アリーナ」を核とした「まちづくり」、スポーツによる地域の「賑わい」創出への支援、スポーツ団体が行う事業の「収益性」を高める取組への支援などの各種施策を進めています。\n\n今後も、しっかりとスポーツを応援していきます。"}}},"rest_id":"2109424460520640548","unmention_data":{},"views":{"count":"642937","state":"EnabledWithCount"}}}}},"entryId":"tweet-2109424460520640548","sortIndex":"2109704447532728304"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":