ntei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1005shoshinhyomei.html","indices":[227,250],"url":"https://t.co/VLOHmIUi7t"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg4MzAxMTUwNjA3MTk2MTY=","richtext":{"richtext_tags":[]},"text":"【高市総理・所信表明演説】\n高市内閣は、「経世済民」の志を貫き、時代の変化から決して目を背けることなく、必要な政策については躊躇なく決断し、果敢に挑戦してまいります。\n「日本列島を、強く豊かに。」\n日本列島の隅々まで活発な経済活動が行き渡り、国民の皆様お一人おひとりが安心して安全に暮らせる、そして希望を持って前進できる国を築いてまいります。\n\n10月5日に行われた高市総理の所信表明演説の動画及びテキストは、官邸HPに掲載しています。\n▼詳細はこちら\nhttps://t.co/VLOHmIUi7t"}}},"rest_id":"2108830115123597757","unmention_data":{},"views":{"count":"87766","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108830115123597757","sortIndex":"2109704447532728291"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経