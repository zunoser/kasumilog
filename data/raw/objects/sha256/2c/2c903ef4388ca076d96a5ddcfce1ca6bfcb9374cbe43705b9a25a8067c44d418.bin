:{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3015158,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":579,"tweets":1864},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2108507707892212181"],"editable_until_msecs":"1791545986000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":687,"bookmarked":false,"conversation_id_str":"2108507707892212181","created_at":"Fri Oct 09 10:39:46 +0000 2026","display_text_range":[0,44],"entities":{},"favorite_count":33409,"favorited":false,"full_text":"今日の閣議において、公務員の給与改定に関する取扱方針と、関係法案の改正案を決定しました。","id_str":"2108507707892212181","is_quote_status":false,"lang":"ja","quote_count":739,"reply_count":2367,"retweet_count":3391,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1MDc3MDc4NDYwNTM4ODg=","richtext":{"richtext_tags":[]},"text":"今日の閣議において、公務員の給与改定に関する取扱方針と、関係法案の改正案を決定しました。\n\n私自身は、総理に就任した昨年10月21日から、総理大臣給与を自主返納していましたが、高市内閣としては、昨年末から閣僚、副大臣、政務官等については、「議員歳費を超える分を受け取らない措置」を開始しており、これを継続します。\n\nちなみに、この措置により、年間約6.5億円の節約になります。"}}},"rest_id":"2108507707892212181","unmention_data":{},"views":{"count":"4291650","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108507707892212181","sortIndex":"2109704447532728256"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":147,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=280x150","width":280},"type":"IMAGE"}},{"key":"description","value":{"string_value":"近年、猛暑や豪雨、地震などの自然災害や、住宅や店舗を狙う犯罪への不安が高まる中、暮らしを守る「窓」に注目が集ま","type":"STRING"}},{"key":"domain","value":{"string_value":"journal.meti.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":315,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=600x600","width":600},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":447,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=orig","width":852},"type":"IMAGE"}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=386x202","width":