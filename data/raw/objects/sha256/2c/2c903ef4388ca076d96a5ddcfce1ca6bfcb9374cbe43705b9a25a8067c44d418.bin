/2108535583572434944/vid/avc1/640x360/8hQx5QE3s_hUqdWc.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108535583572434944/vid/avc1/1280x720/9fbGW3UjCS-mAK46.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/IcHPvWFy6t","expanded_url":"https://x.com/kantei/status/2108537549874700492/video/1","ext_media_availability":{"status":"Available"},"id_str":"2108535583572434944","indices":[132,155],"media_key":"13_2108535583572434944","media_results":{"result":{"media_key":"13_2108535583572434944"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2108535583572434944/img/87SfSDdjlu-f2RZJ.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/IcHPvWFy6t","video_info":{"aspect_ratio":[16,9],"duration_millis":149133,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2108535583572434944/pl/t3iJ-guZagNqGFBL.m3u8?tag=29&v=076"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108535583572434944/vid/avc1/480x270/46Ulr1odI1wbJ1v9.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108535583572434944/vid/avc1/640x360/8hQx5QE3s_hUqdWc.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108535583572434944/vid/avc1/1280x720/9fbGW3UjCS-mAK46.mp4?tag=29"}]}}]},"favorite_count":2490,"favorited":false,"full_text":"【お知らせ】\n本日（１０月９日）、高市総理は、第１４回経済財政諮問会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございました。ありがとうございます。\n　本日は、「責任ある積極財政に基づく『中長期経済財政計画』の実行」について議論を行いました。 https://t.co/IcHPvWFy6t","id_str":"2108537549874700492","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":20,"reply_count":121,"retweet_count":316,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1Mzc1NDk3OTkxODY0MzI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月９日）、高市総理は、第１４回経済財政諮問会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございました。ありがとうございます。\n　本日は、「責任ある積極財政に基づく『中長期経済財政計画』の実行」について議論を行いました。\n　民間議員の皆様から、その具体化に向けて、\n・各｢重要戦略｣の経済財政の目指す姿との整合性､\n・各重要分野の施策の｢分析・検証｣と予算などへの反映、\n・｢経済・財政一体改革推進委員会」の再構築\nに関するご提案をいただきました。\n　また、『中長期経済財政計画』については、\n・｢政策効果や不確実性｣の検証結果と｢政策判断｣への反映､\n・経済が想定と異なった場合における対応\n・財政運営における一定の｢柔軟性｣確保\nに関するご提言もいただきました。\n　高市内閣では、『骨太方針２０２６』に盛り込んだ\n・『中長期経済財政計画』を具体化していく中で、 ｢経済・財政の状況｣と｢政策効果｣を継続的に点検し、必要な見直しにつなげるとともに、\n・中長期的な経済財政運営（※）の｢考え方｣や｢見通し｣を、透明性高く、一貫してお示ししてまいります。\n　城内大臣を中心に、関係閣僚が連携し、政府の様々な『戦略』の道行きとの整合性を確保しつつ､ 『計画』の具体化と推進体制の再編を進めて下さい｡\n　そうした検討に当たっては、\n・各重要分野の取組を整合的に推進し、多角的な ｢分析･検証｣を｢政策判断｣につなげる仕組みを構築すること、\n・異なる前提の複数のケースを予め分析し、経済が想定と異なった場合に、歳出歳入の見直し等、政策対応につなげる運営の仕組みを構築すること、\n・各種｢ショック｣に備え、様々な指標を多角的に点検し、複数年度の視点を持って､｢経済・財政の状況｣などに応じた｢経済財政運営｣を行うことを基本とする､\nといった点に留意しながら､諸外国の例も参考に検討し､ その結果を経済財政諮問会議に報告してください。以上です。\n\n※「中長期的な財政運営」と発言しましたが、正しくは「中長期的な経済財政運営」です。"}}},"previous_counts":{"bookmark_count":1,"favorite_count":35,"quote_count":0,"reply_count":0,"retweet_count":3},"rest_id":"2108537549874700492","unmention_data":{},"views":{"count":"58903","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108537549874700492","sortIndex":"2109704447532728272"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_at