false,"tweet_counts":{"media_tweets":20290,"tweets":49020},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2108911398734766223"],"editable_until_msecs":"1791642233000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":22,"bookmarked":false,"conversation_id_str":"2108911398734766223","created_at":"Sat Oct 10 13:23:53 +0000 2026","display_text_range":[0,140],"entities":{},"favorite_count":640,"favorited":false,"full_text":"茂木外務大臣は、マルコ・ルビオ米国国務長官と電話会談を行いました。今般、沖縄県で発生した強盗殺人事件に関して、茂木大臣から改めて本件に関する遺憾の意を含め日本政府の立場を伝え、両外相は、事件の発生防止のために実効性のある措置を取るべく、日米間で協議していくことを確認しました。また","id_str":"2108911398734766223","is_quote_status":false,"lang":"ja","quote_count":14,"reply_count":42,"retweet_count":139,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04277.html","indices":[293,316],"url":"https://t.co/ofy5iMsVx0"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg5MTEzOTg2NjMzODUwODk=","richtext":{"richtext_tags":[]},"text":"茂木外務大臣は、マルコ・ルビオ米国国務長官と電話会談を行いました。今般、沖縄県で発生した強盗殺人事件に関して、茂木大臣から改めて本件に関する遺憾の意を含め日本政府の立場を伝え、両外相は、事件の発生防止のために実効性のある措置を取るべく、日米間で協議していくことを確認しました。また、国際刑事裁判所（ICC）について、茂木大臣から今般の米国の組織制裁に関する日本政府の立場を伝えた上で、両外相は緊密に意思疎通を継続していくことで一致しました。両外相は、厳しい安全保障環境の中で日米同盟を更に強固なものにし、幅広い日米協力を進めていくため、引き続き共に取り組んでいくことを確認しました。\n\nhttps://t.co/ofy5iMsVx0"}}},"rest_id":"2108911398734766223","unmention_data":{},"views":{"count":"52709","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108911398734766223","sortIndex":"2109704447532728296"},{"content":{"__typename":"TimelineTimelineItem"