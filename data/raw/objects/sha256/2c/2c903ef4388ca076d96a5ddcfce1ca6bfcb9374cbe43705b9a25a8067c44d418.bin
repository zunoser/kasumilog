7","quoted_status_permalink":{"display":"x.com/Shokuhin_ANZEN…","expanded":"https://twitter.com/Shokuhin_ANZEN/status/2108448625974018067","url":"https://t.co/LHOnVvgDFN"},"reply_count":14,"retweet_count":65,"retweeted":false,"user_id_str":"2335919749"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":7},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1673957304532869120/ThjZ8eEd_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/816799985538768896/1687928538"},"core":{"created_at":"Thu Jan 05 00:14:26 +0000 2017","name":"厚生労働省食品安全情報","screen_name":"Shokuhin_ANZEN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4MTY3OTk5ODU1Mzg3Njg4OTY=","is_blue_verified":false,"location":{"location":"東京 千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"厚生労働省が行う食品安全対策を中心に情報発信する公式アカウントです。国民の皆様へ、食中毒に関する注意喚起に加え、報道発表情報や審議会・意見交換会の開催情報などをつぶやきます。なお、ツイッターに寄せられたコメントへの返信はしていません。","entities":{"description":{},"url":{"urls":[{"display_url":"mhlw.go.jp/stf/seisakunit…","expanded_url":"http://www.mhlw.go.jp/stf/seisakunitsuite/bunya/kenkou_iryou/shokuhin/index.html","indices":[0,23],"url":"https://t.co/FGfVIOOfAr"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":16624,"following":14},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"816799985538768896","super_follow_eligible":false,"super_followed_by":false,"super_following":f