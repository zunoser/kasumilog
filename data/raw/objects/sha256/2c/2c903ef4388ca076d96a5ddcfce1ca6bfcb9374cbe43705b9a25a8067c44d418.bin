":"265205959"},"rest_id":"2109488895377506470","unmention_data":{},"views":{"count":"177348","state":"EnabledWithCount"}}},"user_id_str":"412940784"},"rest_id":"2109489033961496632","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"4428","state":"EnabledWithCount"}}}}},"entryId":"tweet-2109489033961496632","sortIndex":"2109704447532728313"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3015158,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":579,"tweets":1864},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2109479770954355080"],"editable_until_msecs":"1791777744000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":76,"bookmarked":false,"conversation_id_str":"2109479770954355080","created_at":"Mon Oct 12 03:02:24 +0000 2026","display_text_range":[0,138],"entities":{},"favorite_count":8626,"favorited":false,"full_text":"明日、10月13日は国連が定めた「国際防災の日」です。\n\n（「防災技術の海外展開」について）\n\n日本は、これまで数多くの災害を経験し、そのたびに復興を遂げてきました。\nその経験から蓄積してきた防災に関する技術、知見、ノウハウの海外展開は、我が国の経済成長にも貢献するものです。","id_str":"2109479770954355080","is_quote_status":false,"lang":"ja","quote_count":182,"reply_count":821,"retweet_count":870,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDk0Nzk3NzA4ODcyMzc2MzI=","richtext":{"richtext_tags":[]},"text":"明日、10月13日は国連が定めた「国際防災の日」です。\n\n（「防災技術の海外展開」について）\n\n日本は、これまで数多くの災害を経験し、そのたびに復興を遂げてきました。\nその経験から蓄積してきた防災に関する技術、知見、ノウハウの海外展開は、我が国の経済成長にも貢献するものです。\n\n内閣府では、海外への防災技術の展開を進める日本の民間企業に対し、海外の実情に応じた防災技術の開発、製品やサービスの展開、外国語でのマニュアル整備などに関する支援を行っています。\n\n例えば、高層ビルにおける地震対策が課題となっているタイでは、日本企業が開発した地震計の実証実験が官民一体で行われ、実装に向けての取組も進んでいます。\n\n（国際機関と連携した取組の成果について）\n\n国際機関とも連携しながら国際協力を進めており、各地で着実に成果を上げています。\n\n一例として、アルメニアでは、国連開発計画（UNDP）と連携し、日本企業の技術により、雨量や河川の水位などを観測する仕組みや早期警報システムを整備するとともに、約200名の防災専門家に対する能力構築支援を行いました。\n\nフィリピンでは、日本企業の技術を活用して、洪水・治水対策に資する水門建設、洪水予報システムの整備、人材育成を組み合わせて実施することにより、被害額及び被害者数の大幅削減に貢献しており、日本に対する高い信頼に繋がっています。\n\n（「仙台防災枠組2015-2030」などについて）\n\n防災への取組の国際的な議論も主導しています。\n\n2015年3月に、私は総務大臣として、仙台市における「第3回国連防災世界会議」に出席しました。\nその際、世界の国々が取り組むべき防災の枠組・指針である「仙台防災枠組2015-2030」が日本の主導によって採択されました。\n\n来年10月には、この枠組が生まれた仙台市で、「アジア太平洋防災閣僚級会合」を日本が国連と共催し、アジア太平洋地域における取組状況について議論します。\n海外の要人を含む約5,000人の来場者に、世界に貢献する日本の防災技術を積極的に紹介します。\n\n次世代を担う若者との連携も重要です。\n\n国連訓練調査研究所（UNITAR）と毎年開催している、「世界津波の日」高校生サミットは本年で8回目を迎えます。\n今月下旬に、東日本大震災による甚大な被害から15年の節目となる岩手の地で、国内外の高校生が、災害の教訓を学ぶ予定です。\n\n第2次高市内閣では、細野大臣を「国際防災協力担当大臣」として新たに任命し、国際防災協力の推進を指示しました。\n\n「日本成長戦略」では、17の戦略分野の一つに「防災・国土強靭化」を位置付けています。\n\n人命・人権を最優先する防災立国を実現するため、また、世界一の防災大国を目指して、官民一体となった海外展開に取り組んでまいります。"}}},"rest_id":"2109479770954355080","unmention_data":{},"views":{"count":"318704","state":"EnabledWithCount"}}}}},"entryId":"tweet-2109479770954355080","sortIndex":"2109704447532728312"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{