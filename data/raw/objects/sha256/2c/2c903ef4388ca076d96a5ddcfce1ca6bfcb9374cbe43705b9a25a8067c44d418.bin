s":[{"h":50,"w":50,"x":202,"y":100}]}},"id_str":"2108509122312445952","indices":[136,159],"media_key":"3_2108509122312445952","media_results":{"result":{"media_key":"3_2108509122312445952"}},"media_url_https":"https://pbs.twimg.com/media/HULt4BkaoAA_GaN.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uWfQeZO0Ac"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/uWfQeZO0Ac","expanded_url":"https://x.com/takaichi_sanae/status/2108509150120656938/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108509104222466048","indices":[136,159],"media_key":"3_2108509104222466048","media_results":{"result":{"media_key":"3_2108509104222466048"}},"media_url_https":"https://pbs.twimg.com/media/HULt2-LbcAA-B75.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":108,"y":0},{"h":1734,"w":1521,"x":215,"y":0},{"h":1734,"w":867,"x":542,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uWfQeZO0Ac"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/uWfQeZO0Ac","expanded_url":"https://x.com/takaichi_sanae/status/2108509150120656938/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":151,"w":151,"x":611,"y":301}]},"medium":{"faces":[{"h":88,"w":88,"x":358,"y":176}]},"orig":{"faces":[{"h":192,"w":192,"x":776,"y":383}]},"small":{"faces":[{"h":50,"w":50,"x":202,"y":100}]}},"id_str":"2108509122312445952","indices":[136,159],"media_key":"3_2108509122312445952","media_results":{"result":{"media_key":"3_2108509122312445952"}},"media_url_https":"https://pbs.twimg.com/media/HULt4BkaoAA_GaN.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uWfQeZO0Ac"}]},"favorite_count":8866,"favorited":false,"full_text":"本日、経済財政諮問会議を開催し、「責任ある積極財政に基づく『中長期経済財政計画』の実行」について議論を行いました。\n\nまず、民間議員の皆様から、その具体化に向けて、\n・各｢重要戦略｣の経済財政の目指す姿との整合性､\n・各重要分野の施策の｢分析・検証｣と予算などへの反映、 https://t.co/uWfQeZO0Ac","id_str":"2108509150120656938","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":110,"reply_count":808,"retweet_count":1039,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1MDkxNTAwNTc4MjQyNTY=","richtext":{"richtext_tags":[]},"text":"本日、経済財政諮問会議を開催し、「責任ある積極財政に基づく『中長期経済財政計画』の実行」について議論を行いました。\n\nまず、民間議員の皆様から、その具体化に向けて、\n・各｢重要戦略｣の経済財政の目指す姿との整合性､\n・各重要分野の施策の｢分析・検証｣と予算などへの反映、\n・｢経済・財政一体改革推進委員会」の再構築\nに関するご提案をいただきました。\n\nまた、『中長期経済財政計画』については、\n・｢政策効果や不確実性｣の検証結果と｢政策判断｣への反映､\n・経済が想定と異なった場合における対応、\n・財政運営における一定の｢柔軟性｣確保\nに関するご提言もいただきました。\n\n高市内閣では、『骨太方針2026』に盛り込んだ\n・『中長期経済財政計画』を具体化していく中で、｢経済・財政の状況｣と｢政策効果｣を継続的に点検し、必要な見直しにつなげるとともに、\n・中長期的な経済財政運営の｢考え方｣や｢見通し｣を、透明性高く、一貫して示してまいります。\n\n政府の様々な『戦略』の道行きとの整合性を確保しつつ､『計画』の具体化と推進体制の再編を進めていきます。\n\nそうした検討に当たっては、\n・各重要分野の取組を整合的に推進し、多角的な｢分析･検証｣を｢政策判断｣につなげる仕組みを構築する、\n・異なる前提の複数のケースを予め分析し、経済が想定と異なった場合に、歳出・歳入の見直しなどの政策対応につなげる運営の仕組みを構築する、\n・各種｢ショック｣に備え、様々な指標を多角的に点検し、複数年度の視点を持って､｢経済・財政の状況｣などに応じた｢経済財政運営｣を行うことを基本とする､\nといった点に留意しつつ､諸外国の例も参考に検討し､その結果を経済財政諮問会議で議論してまいります。"}}},"rest_id":"2108509150120656938","unmention_data":{},"views":{"count":"296913","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108509150120656938","sortIndex":"2109704447532728259"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2108508873867018240/fMIihL9E?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2108508873867018240/fMIihL9E?format=jpg&name=280x150","width":225},"type":"IMAGE"}},{"key":"description","value":{"string_value":"障がい者の就労支援事業からスタートした「KEIPE株式会社（KEIPE）」（山梨県甲府市）は、飲食、児童の発達","type":"STRING"}},{"key":"domain","value":{"string_value":"journal.meti.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2108508873867018240/fMIihL9E?format=jpg&name=800x320_1","width":480},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2108508873867018240/fMIihL9E?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":1708,"url":"https://pbs.twimg.com/card_img/2108508873867018240/fMIihL9E