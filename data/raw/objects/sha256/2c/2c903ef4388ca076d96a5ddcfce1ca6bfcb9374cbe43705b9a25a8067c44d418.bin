{"data":{"list":{"tweets_timeline":{"timeline":{"instructions":[{"entries":[{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3015158,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":579,"tweets":1864},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2109615893810749613"],"editable_until_msecs":"1791810198000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":858,"bookmarked":false,"conversation_id_str":"2109615893810749613","created_at":"Mon Oct 12 12:03:18 +0000 2026","display_text_range":[0,121],"entities":{},"favorite_count":33411,"favorited":false,"full_text":"この度、世界銀行・IMF合同開発委員会の次期議長に片山さつき財務大臣が就任することになりました。\n\n開発委員会は、世界銀行及びIMFの主要加盟国の閣僚が集い、世界経済に重要な役割を果たす両機関に、開発政策について大所高所から助言するものです。","id_str":"2109615893810749613","is_quote_status":false,"lang":"ja","quote_count":413,"reply_count":668,"retweet_count":4544,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDk2MTU4OTM3NzI5NDc0NTY=","richtext":{"richtext_tags":[]},"text":"この度、世界銀行・IMF合同開発委員会の次期議長に片山さつき財務大臣が就任することになりました。\n\n開発委員会は、世界銀行及びIMFの主要加盟国の閣僚が集い、世界経済に重要な役割を果たす両機関に、開発政策について大所高所から助言するものです。\n\n1974年の委員会設置以来、日本からの議長就任は初めてです。\n\n半世紀を超える歴史を有するこの権威ある同委員会において片山大臣が議長を務められることを、とても誇りに思います。\n\n世界の不確実性が高まり、開発課題が複雑化する中で、片山大臣のリーダーシップの下、開発課題の解決に向けた議論が一層深まり、国際社会の発展に役立つとともに、その成果が日本企業の国際的な活躍や日本経済の持続的な発展にもつながることを期待します。"}}},"rest_id":"2109615893810749613","unmention_data":{},"views":{"count":"1237500","state":"EnabledWithCount"}}}}},"entryId":"tweet-2109615893810749613","sortIndex":"2109704447532728320"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem",