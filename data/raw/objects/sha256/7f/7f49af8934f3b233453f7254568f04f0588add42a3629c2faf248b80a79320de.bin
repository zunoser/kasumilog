4613585181/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120814662128435200","indices":[108,131],"media_key":"3_2120814662128435200","media_results":{"result":{"media_key":"3_2120814662128435200"}},"media_url_https":"https://pbs.twimg.com/media/HW6lstqbAAAxcXQ.jpg","original_info":{"focus_rects":[{"h":1120,"w":2000,"x":0,"y":0},{"h":1500,"w":1500,"x":500,"y":0},{"h":1500,"w":1316,"x":684,"y":0},{"h":1500,"w":750,"x":1250,"y":0},{"h":1500,"w":2000,"x":0,"y":0}],"height":1500,"width":2000},"sizes":{"large":{"h":1500,"resize":"fit","w":2000},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yGt82ZM6Pq"}]},"favorite_count":6967,"favorited":false,"full_text":"＜物価・消費の状況＞\n\n我が国の「物価の状況」については、\n・「電気・ガス料金支援」、「ガソリン・軽油の暫定税率の廃止」などの対策によりエネルギー価格が抑制され、足元の「物価上昇率」は前年比2％程度で推移しており、 https://t.co/yGt82ZM6Pq","id_str":"2120814744613585181","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":151,"reply_count":906,"retweet_count":929,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4MTQ3NDQ1MDQ2MDI2MjQ=","richtext":{"richtext_tags":[]},"text":"＜物価・消費の状況＞\n\n我が国の「物価の状況」については、\n・「電気・ガス料金支援」、「ガソリン・軽油の暫定税率の廃止」などの対策によりエネルギー価格が抑制され、足元の「物価上昇率」は前年比2％程度で推移しており、\n・本年の中東情勢緊迫化後も、エネルギー価格は押し上げ要因となっておらず、その結果、主要国に比べれば、物価の上昇幅は限定的であり、「物価上昇率」は、「G7で最も低い水準」を実現（対前年同月比+2.1%、9月時点）となっている、\nといったことが示されています。\n\n他方、諸外国と比較すると、日本は「個人消費に占める食料品・飲料の比率」が高く、本年3月以降の「物価上昇率」では「食料価格の上昇寄与」が大きく、物価上昇の実感は大きくなっているおそれがあると指摘されています。\n\n加えて、「消費の状況」については、\n・「個人消費」は、所得の増加に支えられ持ち直しの動きがみられるが、その伸びは緩やかであり、\n・これは、中東情勢の緊迫化に伴い、「予想物価の上昇」が消費者の景況感を抑えている可能性がある、\n・食料品を中心とする近年の物価上昇は、「低価格品」への切り替えなど「節約余地」の小さい低所得世帯にとって、より大きな負担になっているとみられる、\nとの分析も示されています。\n\nそうした中、政府としては、切れ目のない｢物価高対策｣として、かつ｢中所得｣･｢低所得｣の方の負担を直接軽減するため､「飲食料品の消費税率」を8％から1％に引き下げることを含む『消費税･支援金法案』を今国会に提出し、ご審議いただいています。\n\n政府としては、引き続き、\n・中東情勢が、物価動向や経済に与える影響を注視し、\n・｢予備費」の活用も含め､必要な時にはタイミングを逸することなく、\n国民の皆様の暮らしや経済活動に影響が生じないよう、対応してまいります。"}}},"rest_id":"2120814744613585181","unmention_data":{},"views":{"count":"351212","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120814744613585181","sortIndex":"2120953654151217123"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075518,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":636,"tweets":1959},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2120813157451235694"],"editable_until_msecs":"1794479834000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":212,"bookmarked":false,"conversation_id_str":"2120813157451235694","created_at":"Thu Nov 12 09:37:14 +0000 2026","display_text_range":[0,117],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/p6Lr3i7aZC","expanded_url":"https://x.com/takaichi_sanae/status/2120813157451235694/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120813091101536256","indices":[118,141],"media_key":"3_2120813091101536256","media_results":{"result":{"media_key":"3_2120813091101536256"}},"media_url_https":"https://pbs.twimg.com/media/HW6kRRIa8AA3HN7.jpg","original_info":{"focus_rects":[{"h":1120,"w":2000,"x":0,"y":0},{"h":1500,"w":1500,"x":250,"y":0},{"h":1500,"w":1316,"x":342,"y":0},{"h":1500,"w":750,"x":625,"y":0},{"h":1500,"w":2000,"x":0,"y":0}],"height":1500,"width":2000},"sizes":{"large":{"h":1500,"resize":"fit","w":2000},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/p6Lr3i7aZC"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/p6Lr3i7aZC","expanded_url":"https://x.com/takaichi_sanae/status/2120813157451235694/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120813091101536256","indices":[118,141],"media_key":"3_2120813091101536256","media_results":{"result":{"media_key":"3_2120813091101536256"}},"media_url_https":"https://pbs.twimg.com/media/HW6kRRIa8AA3HN7.jpg","original_info":{"focus_rects":[{"h":1120,"w":2000,"x":0,"y":0},{"h":1500,"w":1500,"x":250,"y":0},{"h":1500,"w":1316,"x":342,"y":0},{"h":1500,"w":750,"x":625,"y":0},{"h":1500,"w":2000,"x":0,"y":0}],"height":1500,"width":2000},"sizes":{"large":{"h":1500,"resize":"fit","w":2000},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/p6Lr3i7aZC"}]},"favorite_count":7528,"favorited":false,"full_text":"＜財政面での前向きな変化＞\n\nまた、財政面でも「前向きな変化」が見られます。\n\n具体的には、\n・2025年度の税収は84.2兆円であり、「過去最高」を記録した、\n・我が国の「財政収支」、「債務残高対GDP比」は、ともに改善傾向にある、 https://t.co/p6Lr3i7aZC","id_str":"2120813157451235694","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":330,"reply_count":1174,"retweet_count":1047,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4MTMxNTczNzk4NzA3MjA=","richtext":{"richtext_tags":[]},"text":"＜財政面での前向きな変化＞\n\nまた、財政面でも「前向きな変化」が見られます。\n\n具体的には、\n・2025年度の税収は84.2兆円であり、「過去最高」を記録した、\n・我が国の「財政収支」、「債務残高対GDP比」は、ともに改善傾向にある、\n・2026年の「財政赤字対GDP比」はG7で最も小さく、「債務残高対GDP比」はG7で最も改善する見込みである、\n・日本の「純債務残高対GDP比」は、G7諸国の中で最も高い水準でしたが、2026年にはイタリアを下回る見込み、\nといった点も示されています。\n\n民間議員の方々からは、こうした動きは、これまでの官民の取組や様々な政策対応の積み重ねの中で、日本経済が「成長型経済」への移行に向けて着実に変化していることの証であると分析されています。"}}},"rest_id":"2120813157451235694","unmention_data":{},"views":{"count":"451991","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120813157451235694","sortIndex":"2120953654151217122"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2119906513020129280/7B6dCVV4?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2119906513020129280/7B6dCVV4?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2119906513020129280/7B6dCVV4?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2119906513020129280/7B6dCVV4?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2119906513020129280/7B6dCVV4?format=png&name=2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":75.17,"rgb":{"blue":255,"green":255,"red":255}},{"percentage":14.68,"rgb":{"blue":