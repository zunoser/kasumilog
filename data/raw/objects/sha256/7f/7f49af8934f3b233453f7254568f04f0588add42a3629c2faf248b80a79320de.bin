indices":[1,8],"text":"IPBASE"},{"indices":[31,39],"text":"スタートアップ"},{"indices":[48,51],"text":"知財"},{"indices":[93,98],"text":"大迫瑞季"}]},"favorite_count":0,"favorited":false,"full_text":"◤#IPBASE YouTubeチャンネルで動画公開中！◢\n\n#スタートアップ に知ってほしい、#知財 に関するコンテンツを配信する「IP BASEチャンネル」。今回、チャンネルMCの #大迫瑞季 がインタビューしたのはこのお二人です。\n\n慶應大学発スタートアップ DigitalArchi\n代表取締役 CEO 松岡康友さん👨‍💻","id_str":"2120320608454209685","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":1,"retweet_count":1,"retweeted":false,"user_id_str":"938375954149261312"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[1,8],"text":"IPBASE"},{"indices":[31,39],"text":"スタートアップ"},{"indices":[48,51],"text":"知財"},{"indices":[93,98],"text":"大迫瑞季"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtube.com/watch?v=KPFEZr…","expanded_url":"https://www.youtube.com/watch?v=KPFEZr9Rvr0","indices":[520,543],"url":"https://t.co/EbWnFXl8dY"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjAzMjA2MDgzMjAwMTYzODQ=","text":"◤#IPBASE YouTubeチャンネルで動画公開中！◢\n\n#スタートアップ に知ってほしい、#知財 に関するコンテンツを配信する「IP BASEチャンネル」。今回、チャンネルMCの #大迫瑞季 がインタビューしたのはこのお二人です。\n\n慶應大学発スタートアップ DigitalArchi\n代表取締役 CEO 松岡康友さん👨‍💻\n\n慶應義塾大学発VC\n慶應イノベーション・イニシアティブ（KII）\nプリンシパル 大竹遼さん🧑‍💼\n\n慶応内のDigitalArchiオフィスに伺い、建築部材製造のために独自開発した大型3Dプリンタを見学！\nまた、その中枢をになうソフトに関してや\n知財を守るための特許取得・国際出願についてお話をいただきました。\n\nさらに、DigitalArchiの出資VCであるKIIの大竹さんからは\n研究開発段階のスタートアップとの関わり方や\n『VC-IPAS』の採択を受け、支援を受ける中で得た手応えなどをお聞きしました。\n\nスタートアップと投資家、どちらの視点でもご参考いただける動画になっています。\nぜひご視聴ください！👇\n\n▼【知財が会社の価値を高める！？】大学発スタートアップ＆大学VCに聞く知財活用の重要性\nhttps://t.co/EbWnFXl8dY"}}},"rest_id":"2120320608454209685","unmention_data":{},"views":{"count":"3011","state":"EnabledWithCount"}}}},"rest_id":"2120788697436016944","unmention_data":{},"views":{"count":"2403","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120788697436016944","sortIndex":"2120953654151217103"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2120953654151217202-tweet-2120788696383270922","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1595652744500908032/vw4r2sfI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/242156036/1412822664"},"core":{"created_at":"Mon Jan 24 02:43:14 +0000 2011","name":"文部科学省　MEXT","screen_name":"mextjapan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDIxNTYwMzY=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"文部科学省の公式アカウントです。\n教育、科学技術・学術、スポーツ、文化に関する情報を広く発信していきます。\nMinistry of Education, Culture, Sports, Science and Technology（MEXT）\n公式サイト：https://t.co/O94D1M8l91","entities":{"description":{"urls":[{"display_url":"mext.go.jp","expanded_url":"https://www.mext.go.jp/","indices":[129,152],"url":"https://t.co/O94D1M8l91"}]},"url":{"urls":[{"display_url":"mext.go.jp/social/index.h…","expanded_url":"https://www.mext.go.jp/social/index.htm","indices":[0,23],"url":"https://t.co/Pln4zCyK96"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"pr