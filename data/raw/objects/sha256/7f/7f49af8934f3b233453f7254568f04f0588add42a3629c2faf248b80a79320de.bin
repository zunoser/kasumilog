05775/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120811739738705920","indices":[123,146],"media_key":"3_2120811739738705920","media_results":{"result":{"media_key":"3_2120811739738705920"}},"media_url_https":"https://pbs.twimg.com/media/HW6jCm6akAAygvS.jpg","original_info":{"focus_rects":[{"h":1120,"w":2000,"x":0,"y":0},{"h":1500,"w":1500,"x":250,"y":0},{"h":1500,"w":1316,"x":342,"y":0},{"h":1500,"w":750,"x":625,"y":0},{"h":1500,"w":2000,"x":0,"y":0}],"height":1500,"width":2000},"sizes":{"large":{"h":1500,"resize":"fit","w":2000},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/01QOY6CFCr"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/01QOY6CFCr","expanded_url":"https://x.com/takaichi_sanae/status/2120812503454105775/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120811739755511808","indices":[123,146],"media_key":"3_2120811739755511808","media_results":{"result":{"media_key":"3_2120811739755511808"}},"media_url_https":"https://pbs.twimg.com/media/HW6jCm-bAAAuTT5.jpg","original_info":{"focus_rects":[{"h":1120,"w":2000,"x":0,"y":190},{"h":1500,"w":1500,"x":500,"y":0},{"h":1500,"w":1316,"x":684,"y":0},{"h":1500,"w":750,"x":1175,"y":0},{"h":1500,"w":2000,"x":0,"y":0}],"height":1500,"width":2000},"sizes":{"large":{"h":1500,"resize":"fit","w":2000},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/01QOY6CFCr"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/01QOY6CFCr","expanded_url":"https://x.com/takaichi_sanae/status/2120812503454105775/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120811739738705920","indices":[123,146],"media_key":"3_2120811739738705920","media_results":{"result":{"media_key":"3_2120811739738705920"}},"media_url_https":"https://pbs.twimg.com/media/HW6jCm6akAAygvS.jpg","original_info":{"focus_rects":[{"h":1120,"w":2000,"x":0,"y":0},{"h":1500,"w":1500,"x":250,"y":0},{"h":1500,"w":1316,"x":342,"y":0},{"h":1500,"w":750,"x":625,"y":0},{"h":1500,"w":2000,"x":0,"y":0}],"height":1500,"width":2000},"sizes":{"large":{"h":1500,"resize":"fit","w":2000},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/01QOY6CFCr"}]},"favorite_count":4792,"favorited":false,"full_text":"昨日の経済財政諮問会議に、民間議員の方々が提出された資料（「高市内閣一年間の振り返りを踏まえた今後のマクロ経済財政運営」）において、「成長型経済」への移行に向けた「確かな変化」が見受けられましたので、御紹介します。\n\n＜経済面での前向きな変化＞ https://t.co/01QOY6CFCr","id_str":"2120812503454105775","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":59,"reply_count":311,"retweet_count":632,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4MTI1MDMzNjYwOTA3NTI=","richtext":{"richtext_tags":[]},"text":"昨日の経済財政諮問会議に、民間議員の方々が提出された資料（「高市内閣一年間の振り返りを踏まえた今後のマクロ経済財政運営」）において、「成長型経済」への移行に向けた「確かな変化」が見受けられましたので、御紹介します。\n\n＜経済面での前向きな変化＞\n\nまず、「日本経済に現れ始めている前向きな変化｣として、\n・GDPは、名目・実質ともに「過去最高水準」であり、「名目700兆円経済」が視野に入っている、\n・2022年以降前年比で減少傾向にあった「実質賃金上昇率」は、25年12月から10か月連続で増加し、「G7で最も高い水準」を実現（対前年同月比＋2.3%、9月時点）している、\nといった点が挙げられています。\n\nまた、\n・「企業収益」についても、大企業、中堅企業、中小企業ともに改善傾向にあり、\n・企業の旺盛な「投資需要」を受け、「民間企業設備投資」の名目値は「過去最高水準」に達している、\n・今年度の「設備投資計画」は堅調な見通しであり、これを着実に実現していくことが重要、\nといった点が示されています。"}}},"rest_id":"2120812503454105775","unmention_data":{},"views":{"count":"193030","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120812503454105775","sortIndex":"2120953654151217120"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":15},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/960685038957244417/qRIY3RTr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/719219671/1597226136"},"core":{"created_at":"Fri Jul 27 02:08:13 +0000 2012","name":"原子力規制委員会 / NRA Japan","screen_name":"gensiryokukisei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo3MTkyMTk2NzE=","is_blue_verified":false,"location":{"location":"日本"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2094746972964209101"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[{"icon_name":"IconBriefcaseStroke","id":713,"name":"科学・テクノロジー"}],"professional_type":"Business","rest_id":"1538427574485131264"},"profile_bio":{"description":"本アカウントは原子力規制委員会の公式アカウントです。委員会の活動や原子力規制に関わる情報をお届けします。～人と環境を守る、確かな規制へ～\n#NRAJapan","entities":{"description":{},"url":{"urls":[{"display_url":"nra.go.jp","expanded_url":"https://www.nra.go.jp/","indices":[0,23],"url":"https://t.co/B83mYLvtXz"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"trans