405","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":2,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDQxMzk1OTIwNDg2NDA=","richtext":{"richtext_tags":[]},"text":"若山政務官は、米国ワシントン州のヘック副知事（Lieutenant Governor Denny Heck）と会談。ワシントン州に進出している日本企業の地域経済への貢献や、航空宇宙分野をはじめとする幅広い連携について確認するとともに、教育・スポーツを通じた交流や、幅広い分野における日米協力及び投資拡大の可能性について意見交換を行いました。"}}},"rest_id":"2120844139642454405","unmention_data":{},"views":{"count":"4589","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120844139642454405","sortIndex":"2120953654151217137"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":1},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/3692310981/5e84849fe6a5c60bc3a3818c6f4cbec4_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/286056244/1791195170"},"core":{"created_at":"Fri Apr 22 08:05:55 +0000 2011","name":"環境省","screen_name":"Kankyo_Jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODYwNTYyNDQ=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2117849199001911362"