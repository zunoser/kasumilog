9],"duration_millis":224433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2120822748146716672/pl/Te_9X-rrBU7sc1Sp.m3u8?tag=29&v=00d"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120822748146716672/vid/avc1/480x270/ZkFnCAzSSZvV486Y.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120822748146716672/vid/avc1/640x360/W-Cd6fDh0zoPeLI2.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120822748146716672/vid/avc1/1280x720/v0d3mjLY7rYN_aV-.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/r1P2F6VGFk","expanded_url":"https://x.com/kantei/status/2120823195871879255/video/1","ext_media_availability":{"status":"Available"},"id_str":"2120822748146716672","indices":[96,119],"media_key":"13_2120822748146716672","media_results":{"result":{"media_key":"13_2120822748146716672"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2120822748146716672/img/7OcW5mMLsQWm1kIN.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/r1P2F6VGFk","video_info":{"aspect_ratio":[16,9],"duration_millis":224433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2120822748146716672/pl/Te_9X-rrBU7sc1Sp.m3u8?tag=29&v=00d"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120822748146716672/vid/avc1/480x270/ZkFnCAzSSZvV486Y.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120822748146716672/vid/avc1/640x360/W-Cd6fDh0zoPeLI2.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120822748146716672/vid/avc1/1280x720/v0d3mjLY7rYN_aV-.mp4?tag=29"}]}}]},"favorite_count":1199,"favorited":false,"full_text":"【お知らせ】\n本日（１１月１２日）、高市総理は、フィジカルAI関連企業との意見交換会を行いました。\n\n※高市総理発言要旨（速報版）\n　本日は皆様ご多用のところ、本当にありがとうございました。 https://t.co/r1P2F6VGFk","id_str":"2120823195871879255","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":23,"reply_count":41,"retweet_count":194,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4MjMxOTU3ODM4NTYxMjg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月１２日）、高市総理は、フィジカルAI関連企業との意見交換会を行いました。\n\n※高市総理発言要旨（速報版）\n　本日は皆様ご多用のところ、本当にありがとうございました。\n　製造、小売、またご家庭。様々な現場で活躍するＡＩロボットが社会実装される未来はもうここまで来ていると感じさせていただきました。\n　「フィジカルＡＩ」は、人の仕事を奪うものではなくて、人とロボットが協調する現場を実現して、特に地域で深刻化している「人手不足」を解消するものでもあります。\n　また、「フィジカルＡＩ」は、現場で働く方の肉体的な負荷ですとか、また危険が大きい業務を減らして、創造的で付加価値の高い仕事で活躍する未来も創っていくことができます。\n　さらに今日は、「関係性構築型」の「フィジカルＡＩ」に触れさせていただきましたが、日本ならではの、この「創造性」も活かすことができると思います。\n　日本には、ものづくりの文化、精密さへの情熱、そして品質への誇りを土台とした「現場力」があります。「フィジカルＡＩ」の「勝ち筋」となるデータもあります。\n　高市内閣では、「フィジカルＡＩ」を『日本成長戦略』の「戦略１７分野」に位置づけております。２０４０年までに、１，０００万台規模のＡＩロボットの導入と、世界シェアの３割超となる２０兆円の市場獲得、こういう目標を掲げました。\n　皆様からは、\n①我が国が世界のロボットサプライチェーンの中核を担うために、国産ロボット・主要部品の研究開発・実証から量産拠点の整備まで一貫した支援が必要であること、\nまた、②ＡＩロボティクスの社会実装を促進するために、国産ＡＩ基盤の開発加速に期待しておられること、\nまた、③ＧＥＮＩＡＣ(ジーニアック)の取組のような、政府が「データ集積」を促す仕組みが不可欠であること、\nそれから、④初期需要を支える複数年にわたる導入支援が必要であること、\nなどなど、様々大切な問題意識についてお話をいただきました。\n　城内大臣は、まずは政府の取組として、この「フィジカルＡＩ」の国内投資を着実に引き出すように、『日本成長戦略実行計画』の中に、今日伺った御指摘をしっかり反映させるということとともに、国の支援の内容ですとか必要な予算額などについて、予見可能性のある形で明らかにしてください。\n　その上で、官民の力を結集して、なんとしても世界に先駆けた「フィジカルＡＩ」の社会実装を「大規模」かつ「戦略的」に推進してまいりましょう。\n　そして、日本が誇る「現場力」に根差した技術革新を国内市場はもとより、世界市場へと展開して、日本発のイノベーションで世界の課題解決にも貢献するとともにですね、しっかり外貨も稼がなきゃいけませんので、新たな成長の原動力を創り出してまいりましょう。\n　今日は、本当にありがとうございました。短時間でしたが、とても素晴らしい経験をさせていただきました。多くの方に触れていただく機会を作らなきゃいけませんね。併せて検討いたしましょう。ありがとうございます。"}}},"rest_id":"2120823195871879255","unmention_data":{},"views":{"count":"47802","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120823195871879255","sortIndex":"2120953654151217124"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075518,"following":0},"relationship_perspectives":{"blocked_by":fal