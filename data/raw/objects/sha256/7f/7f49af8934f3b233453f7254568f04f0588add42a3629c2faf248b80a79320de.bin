{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":74,"bookmarked":false,"conversation_id_str":"2120849499983925614","created_at":"Thu Nov 12 12:01:38 +0000 2026","display_text_range":[0,118],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/uGoPQfj3dD","expanded_url":"https://x.com/takaichi_sanae/status/2120849499983925614/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":111,"w":111,"x":909,"y":115}]},"medium":{"faces":[{"h":65,"w":65,"x":533,"y":67}]},"orig":{"faces":[{"h":142,"w":142,"x":1155,"y":147}]},"small":{"faces":[{"h":37,"w":37,"x":302,"y":38}]}},"id_str":"2120849465494179840","indices":[119,142],"media_key":"3_2120849465494179840","media_results":{"result":{"media_key":"3_2120849465494179840"}},"media_url_https":"https://pbs.twimg.com/media/HW7FWiTbkAA8_Mm.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":22,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uGoPQfj3dD"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/uGoPQfj3dD","expanded_url":"https://x.com/takaichi_sanae/status/2120849499983925614/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":111,"w":111,"x":909,"y":115}]},"medium":{"faces":[{"h":65,"w":65,"x":533,"y":67}]},"orig":{"faces":[{"h":142,"w":142,"x":1155,"y":147}]},"small":{"faces":[{"h":37,"w":37,"x":302,"y":38}]}},"id_str":"2120849465494179840","indices":[119,142],"media_key":"3_2120849465494179840","media_results":{"result":{"media_key":"3_2120849465494179840"}},"media_url_https":"https://pbs.twimg.com/media/HW7FWiTbkAA8_Mm.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":22,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uGoPQfj3dD"}]},"favorite_count":2801,"favorited":false,"full_text":"【フィジカルAI関連企業との意見交換会⑥】\n\nGenki Robotics合同会社代表取締役CEOのAndy Rubin様とCTOの西脇 光一 様からは、ヒューマノイドの実機を展示いただくとともに、以下のお話を伺いました。\n\n「Andy https://t.co/uGoPQfj3dD","id_str":"2120849499983925614","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":25,"reply_count":72,"retweet_count":337,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDk0OTk5MDAwMzUwNzI=","richtext":{"richtext_tags":[]},"text":"【フィジカルAI関連企業との意見交換会⑥】\n\nGenki Robotics合同会社代表取締役CEOのAndy Rubin様とCTOの西脇 光一 様からは、ヒューマノイドの実機を展示いただくとともに、以下のお話を伺いました。\n\n「Andy Rubinは『Android（オープンソースのモバイル向けオペレーティング・システム）』の開発者です。\nプラットフォームとして全世界の人口の半分以上に使っていただく方法を知っている彼と、去年5月に会社を立ち上げました。\n色々と試行を繰り返し、年末に向けて最初の製品モデルを作ろうとしているところで、今日は出来立ての製品をお持ちしました。\n先週金曜に全部の部品が届いて、土日で組み立てて月曜に歩いたものです。\nソフトウェアのプラットフォームを作り、色々な方に参入いただき、幅広く使っていただくことも大事ですが、ハードウェアもすごく大事です。\n関節を動かす部品やカメラをはじめ、自分たちで設計から全て行っており、日本の強みである様々な要素技術、ものづくりの強み、日本のサプライチェーンを活かして、世界に打って出ていければと思っております。\n平地も階段も歩き、巡回したり、物を持ったりなど、人間がバランスを取りながら普通にやっている動きをすることが大事です。\n国内の通信会社とも話をしており、国内の通信環境、いわゆる携帯電話のネットワークに入るような形にしていけるとよいと思っています。」\n\n「Androidではオープンエコシステムを作ることによって、色々な開発者を巻き込んで世界的に使われるようになってきました。\nヒューマノイドも同じような戦略をとって、色々な方々が参加できるプラットフォームを作っていきたいと思っています。\n日本発でAndroidを作ったAndy Rubinがいる会社ですので、どうやってソフトウェアの世界で勝っていくかということに関してはすごく深く考えていますが、ハードウェアについては、日本の素晴らしい要素技術の蓄積を使っていきたいと考えています。\n\n このロボットをいよいよ製品化して売っていく段階です。\nその初期段階で使ってみたいと思うような方々による市場の創出が重要と思います。」"}}},"rest_id":"2120849499983925614","unmention_data":{},"views":{"count":"146018","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120849499983925614","sortIndex":"2120953654151217148"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075518,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":636,"tweets":1959},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2120849239496597594"],"editable_until_msecs":"1794488436000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":43,"bookmarked":false,"conversation_id_str":"2120849239496597594","created_at":"Thu Nov 12 12:00:36 +0000 2026","display_text_range":[0,131],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/QbMLP1AzZ8","expanded_url":"https://x.com/takaichi_sanae/status/2120849239496597594/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":333,"w":333,"x":837,"y":361}]},"medium":{"faces":[{"h":195,"w":195,"x":490,"y":211}]},"orig":{"faces":[{"h":424,"w":424,"x":1063,"y":459}]},"small":{"faces":[{"h":110,"w":110,"x":278,"y":120}]}},"id_str":"2120849194399432704","indices":[132,155],"media_key":"3_2120849194399432704","media_results":{"result":{"media_key":"3_2120849194399432704"}},"media_url_https":"https://pbs.twimg.com/media/HW7FGwZaAAAUkbO.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/QbMLP1AzZ8"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/QbMLP1AzZ8","expanded_url":"https://x.com/takaichi_sanae/status/2120849239496597594/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":333,"w":333,"x":837,"y":361}]},"medium":{"faces":[{"h":195,"w":195,"x":490,"y":211}]},"orig":{"faces":[{"h":424,"w":424,"x":1063,"y":459}]},"small":{"faces":[{"h":110,"w":110,"x":278,"y":120}]}},"id_str":"2120849194399432704","indices":[132,155],"media_key":"3_2120849194399432704","media_results":{"result":{"media_key":"3_2120849194399432704"}},"media_url_https":"https://pbs.twimg.com/media/HW7FGwZaAAAUkbO.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/QbMLP1AzZ8"}]},"favorite_count":2197,"favorited":false,"full_text":"【フィジカルAI関連企業との意見交換会⑤】\n\nNoetra株式会社の代表取締役社長の丹波 廣寅 様からは、以下のお話を伺いました。\n\n「（ロボットが）初めての動作を、様々な環境、予想外や未知な環境でも動作することを可能にするためのAI基盤モデルを開発しています。 https://t.co/QbMLP1AzZ8","id_str":"2120849239496597594","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":15,"reply_count":51,"retweet_count":239,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDkyMzk0MjExNTczNzY=","richtext":{"richtext_tags":[]},"text":"【フィジカルAI関連企業との意見交換会⑤】\n\nNoetra株式会社の代表取締役社長の丹波 廣寅 様からは、以下のお話を伺いました。\n\n「（ロボットが）初めての動作を、様々な環境、予想外や未知な環境でも動作することを可能にするためのAI基盤モデルを開発しています。\nAIは学習したことを決めた場所でやることが得意でしたが、実際に社会にロボットを入れる、作業させるとなると、初めてのことを予想外の場所で自律的にできる、この基盤モデルが必要になります。\nこの技術を構築できれば、世の中に公開し、使っていただくことで、産業の競争力が上がるし、経済が活性化されますので、この分野で貢献していきたいと思っています。\nAI基盤モデルを作るためには、相当大きな計算機が必要になります。\n大阪府堺市にある国内最大規模の計算資源を活用して、世界最先端のAI基盤モデルの開発に取り組んでいきます。」\n\n「デジタル主権の確立と日本の産業競争力の観点から、国内で完結するフィジカルAIのエコシステムの構築が肝要だと思っています。\nNoetraとしては、ここに使われる基盤モデル言語を開発、構築してリリースしていくことになりますが、AIモデルをより進化させるため、ユーザー企業からフィードバックを受けて、それを開発に活かすことを進めていきたいと思っています。\n\n フィジカルAIは、2030年に10兆円を超えるGDP押し上げ効果があります。」"}}},"rest_id":"2120849239496597594","unmention_data":{},"views":{"count":"133288","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120849239496597594","sortIndex":"2120953654151217147"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075518,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":636,"tweets":1959},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2120849104431661117"],"editable_until_msecs":"1794488404000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":55,"bookmarked":false,"conversation_id_str":"2120849104431661117","created_at":"Thu Nov 12 12:00:04 +0000 2026","display_text_range":[0,93],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/f8oOSG2z0i","expanded_url":"https://x.com/takaichi_sanae/status/2120849104431661117/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":73,"w":73,"x":1529,"y":237},{"h":81,"w":81,"x":875,"y":315}]},"medium":{"faces":[{"h":42,"w":42,"x":896,"y":139},{"h":48,"w":48,"x":513,"y":185}]},"orig":{"faces":[{"h":93,"w":93,"x":1942,"y":302},{"h":104,"w":104,"x":1112,"y":401}]},"small":{"faces":[{"h":24,"w":24,"x":507,"y":78},{"h":27,"w":27,"x":290,"y":104}]}},"id_str":"2120848992213078016","indices":[94,117],"media_key":"3_2120848992213078016","media_results":{"result":{"media_key":"3_2120848992213078016"}},"media_url_https":"https://pbs.twimg.com/media/HW7E6_MbEAAUei6.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/f8oOSG2z0i"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/f8oOSG2z0i","expanded_url":"https://x.com/takaichi_sanae/status/2120849104431661117/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":73,"w":73,"x":1529,"y":237},{"h":81,"w":81,"x":875,"y":315}]},"medium":{"faces":[{"h":42,"w":42,"x":896,"y":139},{"h":48,"w":48,"x":513,"y":185}]},"orig":{"faces":[{"h":93,"w":93,"x":1942,"y":302},{"h":104,"w":104,"x":1112,"y":401}]},"small":{"faces":[{"h":24,"w":24,"x":507,"y":78},{"h":27,"w":27,"x":290,"y":104}]}},"id_str":"2120848992213078016","indices":[94,117],"media_key":"3_2120848992213078016","media_results":{"result":{"media_key":"3_2120848992213078016"}},"media_url_https":"https://pbs.twimg.com/media/HW7E6_MbEAAUei6.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/f8oOSG2z0i"}]},"favorite_count":2615,"favorited":false,"full_text":"【フィジカルAI関連企業との意見交換会④】\n\nミネベアミツミ株式会社の代表取締役会長CEOの貝沼 由久 様からは、自社開発のロボットハンドを実演いただくとともに、以下のお話を伺いました。 https://t.co/f8oOSG2z0i","id_str":"2120849104431661117","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":18,"reply_count":58,"retweet_count":311,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDkxMDQzNjAzNjYwODA=","richtext":{"richtext_tags":[]},"text":"【フィジカルAI関連企業との意見交換会④】\n\nミネベアミツミ株式会社の代表取締役会長CEOの貝沼 由久 様からは、自社開発のロボットハンドを実演いただくとともに、以下のお話を伺いました。\n\n「今日は、イーロン・マスク氏がヒューマノイドで作るのは一番難しいと言われるハンド（手）をお持ちしました。\n昨年、CES（コンシューマー・エレクトロニクス・ショー）で初出展して大好評を得たハンドで、非常に速く指が動き、指1本で約5キロの重さを持ち上げることができます。\nその中身は、モーター11個、ベアリング107個、センサー7個です。\nカメラに映した手にシンクロして指が動く仕組みで、今後、人の手の動きを通じて、指先を使う作業をロボットに教えることにも活用できる可能性があります。\n指1本で5キロですから、指だけで25キロまで上げることができます。\nまた、指に荷重センサーをつけており、瓶が重くなると自然にグリップ力が強くなります。\nどのぐらいの重さが入ったのかが分かり、それに合わせてグリップ力が強くなります。\n色々なセンサーがつくと、人間のハンドにどんどん近づいていくと思います。」\n\n「フィジカルAIは、日本のような少子高齢化の中で社会的課題を色々解決できる、その一丁目一番地だというふうに確信いたしております。\nそのためには、高精度な部品が間違いなく必要であり、フィジカルAIには、ベアリングだけでなく、アクチュエーター、センサーなど様々なものが中に入っております。\n\n こういった部品をより発展させて、世界でかけがえのない会社になっていきたいという夢を持っております。」"}}},"rest_id":"2120849104431661117","unmention_data":{},"views":{"count":"142681","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120849104431661117","sortIndex":"2120953654151217146"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075518,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":636,"tweets":1959},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2120848714172346435"],"editable_until_msecs":"1794488311000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":126,"bookmarked":false,"conversation_id_str":"2120848714172346435","created_at":"Thu Nov 12 11:58:31 +0000 2026","display_text_range":[0,131],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/hmcLmuDkmd","expanded_url":"https://x.com/takaichi_sanae/status/2120848714172346435/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120848202585034752","indices":[132,155],"media_key":"3_2120848202585034752","media_results":{"result":{"media_key":"3_2120848202585034752"}},"media_url_https":"https://pbs.twimg.com/media/HW7ENBmbUAABUXa.jpg","original_info":{"focus_rects":[{"h":596,"w":1064,"x":0,"y":0},{"h":710,"w":710,"x":354,"y":0},{"h":710,"w":623,"x":441,"y":0},{"h":710,"w":355,"x":592,"y":0},{"h":710,"w":1064,"x":0,"y":0}],"height":710,"width":1064},"sizes":{"large":{"h":710,"resize":"fit","w":1064},"medium":{"h":710,"resize":"fit","w":1064},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/hmcLmuDkmd"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/hmcLmuDkmd","expanded_url":"https://x.com/takaichi_sanae/status/2120848714172346435/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120848202585034752","indices":[132,155],"media_key":"3_2120848202585034752","media_results":{"result":{"media_key":"3_2120848202585034752"}},"media_url_https":"https://pbs.twimg.com/media/HW7ENBmbUAABUXa.jpg","original_info":{"focus_rects":[{"h":596,"w":1064,"x":0,"y":0},{"h":710,"w":710,"x":354,"y":0},{"h":710,"w":623,"x":441,"y":0},{"h":710,"w":355,"x":592,"y":0},{"h":710,"w":1064,"x":0,"y":0}],"height":710,"width":1064},"sizes":{"large":{"h":710,"resize":"fit","w":1064},"medium":{"h":710,"resize":"fit","w":1064},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/hmcLmuDkmd"}]},"favorite_count":4428,"favorited":false,"full_text":"【フィジカルAI関連企業との意見交換会③】\n\nGROOVE X株式会社の代表取締役CEOの林 要 様からは、「LOVOT」を実演いただくとともに、以下のお話を伺いました。\n\n「LOVOTは、家庭用としては最高クラスのAIが人との信頼関係を築くために動いています。 https://t.co/hmcLmuDkmd","id_str":"2120848714172346435","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":60,"reply_count":113,"retweet_count":510,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDg3MTQwOTI2NjI3ODQ=","richtext":{"richtext_tags":[]},"text":"【フィジカルAI関連企業との意見交換会③】\n\nGROOVE X株式会社の代表取締役CEOの林 要 様からは、「LOVOT」を実演いただくとともに、以下のお話を伺いました。\n\n「LOVOTは、家庭用としては最高クラスのAIが人との信頼関係を築くために動いています。\n5,000個以上のコンポーネント、50以上のセンサーが入っており、2万体がもう稼働し、年間の稼働時間は1億時間にも及びます。\nそのデータを使って日々改善をしています。\nただ、カメラやマイクが家庭に入るという、家庭のプライバシーを守るという意味で、国産であるべきではないかと思っています。\nフィジカルAIは、今までは作業するための『タスク遂行型』が注目されていましたが、人との関係性構築のためにも非常に有効です。\n長時間の関係性構築は他国にない、今、我が国がリードしている領域です。\n3年使っていただいて、使用を止めたのは10%の方だけで、１日平均1時間も抱っこされています。\n健康になる、会話が増える、ストレスが減る、といった効果が出ており、不登校の減少、認知機能の改善、看護ストレスの改善といった効果も現れています。\n実は世界でも使われており、デンマーク国王にも抱っこされて、海外からも日本にしか実現できないと言っていただいています。」\n\n「日本は2020年頃まで『タスク遂行型』のロボットで先行していましたが、今となっては米中が追い抜いてしまっている領域です。\n『関係性構築型ロボット』は、今は日本がリードしていますが、このままいくと米中が追い上げてきて追い抜くという、まさに端境期におります。\n最大の理由は日本のスタートアップのエコシステムにあります。\nBtoC向けのハードウェア、さらにレイターステージのスタートアップへの資金供給が今ほとんどない状況です。\n弊社は今から2030年に向けて約1,000億円の売上、100億円の投資をしていこうとしています。\n\n 日本初のウェルビーイングテックとして世界に発信して、自動車産業に次ぐ外貨を稼ぐ産業に育て上げたいと思います。」"}}},"rest_id":"2120848714172346435","unmention_data":{},"views":{"count":"181446","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120848714172346435","sortIndex":"2120953654151217145"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"use