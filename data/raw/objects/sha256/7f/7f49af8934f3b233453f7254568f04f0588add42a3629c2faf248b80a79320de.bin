52,"x":256,"y":233},{"h":62,"w":62,"x":618,"y":1050}]},"orig":{"faces":[{"h":90,"w":90,"x":438,"y":398},{"h":106,"w":106,"x":1056,"y":1792}]},"small":{"faces":[{"h":29,"w":29,"x":145,"y":132},{"h":35,"w":35,"x":350,"y":595}]}},"id_str":"2120351695230390272","indices":[143,166],"media_key":"3_2120351695230390272","media_results":{"result":{"media_key":"3_2120351695230390272"}},"media_url_https":"https://pbs.twimg.com/media/HW0Aofka0AAO3v-.jpg","original_info":{"focus_rects":[{"h":1004,"w":1792,"x":0,"y":1044},{"h":1792,"w":1792,"x":0,"y":256},{"h":2043,"w":1792,"x":0,"y":5},{"h":2048,"w":1024,"x":358,"y":0},{"h":2048,"w":1792,"x":0,"y":0}],"height":2048,"width":1792},"sizes":{"large":{"h":2048,"resize":"fit","w":1792},"medium":{"h":1200,"resize":"fit","w":1050},"small":{"h":680,"resize":"fit","w":595},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xNMUDR2u7B"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/xNMUDR2u7B","expanded_url":"https://x.com/jftc/status/2120351710690607450/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":90,"w":90,"x":438,"y":398},{"h":106,"w":106,"x":1056,"y":1792}]},"medium":{"faces":[{"h":52,"w":52,"x":256,"y":233},{"h":62,"w":62,"x":618,"y":1050}]},"orig":{"faces":[{"h":90,"w":90,"x":438,"y":398},{"h":106,"w":106,"x":1056,"y":1792}]},"small":{"faces":[{"h":29,"w":29,"x":145,"y":132},{"h":35,"w":35,"x":350,"y":595}]}},"id_str":"2120351695230390272","indices":[143,166],"media_key":"3_2120351695230390272","media_results":{"result":{"media_key":"3_2120351695230390272"}},"media_url_https":"https://pbs.twimg.com/media/HW0Aofka0AAO3v-.jpg","original_info":{"focus_rects":[{"h":1004,"w":1792,"x":0,"y":1044},{"h":1792,"w":1792,"x":0,"y":256},{"h":2043,"w":1792,"x":0,"y":5},{"h":2048,"w":1024,"x":358,"y":0},{"h":2048,"w":1792,"x":0,"y":0}],"height":2048,"width":1792},"sizes":{"large":{"h":2048,"resize":"fit","w":1792},"medium":{"h":1200,"resize":"fit","w":1050},"small