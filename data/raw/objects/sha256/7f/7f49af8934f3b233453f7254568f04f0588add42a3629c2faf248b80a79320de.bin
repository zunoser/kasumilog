ote_count":0,"reply_count":0,"retweet_count":3,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[29,41],"text":"放課後ゲンバミッション"},{"indices":[90,94],"text":"ゲンミ"},{"indices":[394,404],"text":"国交省建設産業PR"},{"indices":[405,416],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/tzzNC0GBRns","expanded_url":"https://youtu.be/tzzNC0GBRns","indices":[113,136],"url":"https://t.co/mdgyXGWnnn"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[353,376],"url":"https://t.co/kPJLLRPIOH"}],"user_mentions":[{"id_str":"2100746664126648320","indices":[378,393],"name":"放課後ゲンバミッション","screen_name":"houkago_gennmi"}]},"id":"Tm90ZVR3ZWV0OjIxMjA3ODIyODkxODU3ODM4MDg=","richtext":{"richtext_tags":[]},"text":"|◤   　    🎥 YouTube配信中\n 　　　　　#放課後ゲンバミッション！   　◢|\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「#ゲンミ！（現場ミッション）」に挑戦✨\n▶️ https://t.co/mdgyXGWnnn\n\n今回は、私たちの暮らしに欠かせない「水道工事」のゲンバへ！\n水道管の接続作業に挑戦し、職人さんの技術を体験🔧\nさらに、水をスムーズに流すための配管の工夫も教えてもらいました。\n\n毎日使う水道の裏側には、知られざる職人さんの技術がいっぱい✨\nぜひ動画でチェックしてみてください👀\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPIOH\n\n@houkago_gennmi\n#国交省建設産業PR\n#MLIT建設産業PR"}}},"rest_id":"2120782289328357845","unmention_data":{},"views":{"count":"5846","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120782289328357845","sortIndex":"2120953654151217098"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_c