aces":[{"h":71,"w":71,"x":423,"y":489},{"h":73,"w":73,"x":79,"y":497},{"h":71,"w":71,"x":257,"y":505},{"h":71,"w":71,"x":1039,"y":505},{"h":69,"w":69,"x":761,"y":512},{"h":69,"w":69,"x":1285,"y":512},{"h":71,"w":71,"x":1489,"y":535},{"h":67,"w":67,"x":1179,"y":549}]},"medium":{"faces":[{"h":42,"w":42,"x":248,"y":287},{"h":42,"w":42,"x":46,"y":291},{"h":42,"w":42,"x":150,"y":296},{"h":42,"w":42,"x":609,"y":296},{"h":40,"w":40,"x":446,"y":300},{"h":40,"w":40,"x":753,"y":300},{"h":42,"w":42,"x":872,"y":313},{"h":39,"w":39,"x":691,"y":322}]},"orig":{"faces":[{"h":91,"w":91,"x":538,"y":622},{"h":93,"w":93,"x":101,"y":632},{"h":91,"w":91,"x":327,"y":642},{"h":91,"w":91,"x":1320,"y":642},{"h":88,"w":88,"x":967,"y":650},{"h":88,"w":88,"x":1632,"y":650},{"h":91,"w":91,"x":1891,"y":680},{"h":86,"w":86,"x":1498,"y":698}]},"small":{"faces":[{"h":23,"w":23,"x":140,"y":162},{"h":24,"w":24,"x":26,"y":165},{"h":23,"w":23,"x":85,"y":167},{"h":23,"w":23,"x":345,"y":167},{"h":23,"w":23,"x":252,"y":170},{"h":23,"w":23,"x":426,"y":170},{"h":23,"w":23,"x":494,"y":177},{"h":22,"w":22,"x":391,"y":182}]}},"id_str":"2120849641600376832","indices":[142,165],"media_key":"3_2120849641600376832","media_results":{"result":{"media_key":"3_2120849641600376832"}},"media_url_https":"https://pbs.twimg.com/media/HW7FgyWa4AAsekQ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1712,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/XBgHDbusI2"}]},"favorite_count":2986,"favorited":false,"full_text":"【フィジカルAI関連企業との意見交換会⑦】\n\n製造、小売、家庭。\n様々な現場で活躍するAIロボットが社会実装される未来は近いことを実感しました。\n\n「フィジカルAI」は、人の仕事を奪うものではなく、人とロボットが協調する現場を実現し、地域で深刻化する「人手不足」を解消するものです。 https://t.co/XBgHDbusI2","id_str":"2120849746365682102","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":42,"reply_count":324,"retweet_count":355,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDk3NDYyNzM0NTYxMjk=","richtext":{"richtext_tags":[]},"text":"【フィジカルAI関連企業との意見交換会⑦】\n\n製造、小売、家庭。\n様々な現場で活躍するAIロボットが社会実装される未来は近いことを実感しました。\n\n「フィジカルAI」は、人の仕事を奪うものではなく、人とロボットが協調する現場を実現し、地域で深刻化する「人手不足」を解消するものです。\n\nまた、「フィジカルAI」は、現場で働く方々の肉体的負荷や危険が大きい業務を減らし、創造的で付加価値の高い仕事で活躍する未来も創ります。\n\nさらに、「関係性構築型」の「フィジカルAI」など、日本ならではの「創造性」も活かすことができます。\n\n日本には、ものづくりの文化、精密さへの情熱、品質への誇りを土台とした「現場力」があり、「フィジカルAI」の「勝ち筋」となるデータがあります。\n\n高市内閣では、「フィジカルAI」を『日本成長戦略』の「戦略17分野」に位置づけており、2040年までに、\n・1,000万台規模のAIロボットの導入と、\n・世界シェアの3割超となる20兆円の市場獲得\nとの目標を掲げました。\n\n皆様からは、\n\n①我が国が世界のロボットサプライチェーンの中核を担うため、国産ロボット・主要部品の研究開発・実証から量産拠点整備まで一貫した支援が必要であること、\n\n②AIロボティクスの社会実装を促進するため、国産ＡＩ基盤の開発加速に期待すること、\n\n③GENIACの取組のような、政府が「データ集積」を促す仕組みが不可欠であること、\n\n④初期需要を支える複数年にわたる導入支援が必要であること、\n\nなど、貴重な御指摘をいただきました。\n\nまずは政府の取組として、「フィジカルAI」の国内投資を着実に引き出すよう、『日本成長戦略実行計画』の中に\n・こうした御指摘をしっかり反映させるとともに、\n・国の支援の内容や必要な予算額などについて予見可能性のある形で明らかにしてまいります。\n\nその上で、官民の力を結集し、世界に先駆けた「フィジカルAI」の社会実装を「大規模」かつ「戦略的」に推進してまいります。\n\nそして、日本が誇る「現場力」に根差した技術革新を世界市場へと展開し、日本発のイノベーションで世界の課題解決に貢献するとともに、新たな成長の原動力を創り出してまいります。\n\nご来訪下さった皆様に、感謝申し上げます。"}}},"rest_id":"2120849746365682102","unmention_data":{},"views":{"count":"163711","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120849746365682102","sortIndex":"2120953654151217149"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"