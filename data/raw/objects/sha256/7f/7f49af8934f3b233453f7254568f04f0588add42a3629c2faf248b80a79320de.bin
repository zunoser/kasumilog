826,"x":0,"y":0}],"height":620,"width":826},"sizes":{"large":{"h":620,"resize":"fit","w":826},"medium":{"h":620,"resize":"fit","w":826},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/8S1rzCBzrS"}]},"favorite_count":19,"favorited":false,"full_text":"【写真で見る動き】 \n令和8年11月11日(水)、古川内閣府特命担当大臣(科学技術政策)は、17の戦略分野の一つである「創薬・先端医療」分野の取組を行っている株式会社ニコン・セル・イノベーションの細胞受託生産施設を視察しました。\nhttps://t.co/nkqvcfiXwp\n#内閣府 https://t.co/8S1rzCBzrS","id_str":"2120713688839786780","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":4,"retweet_count":4,"retweeted":false,"user_id_str":"2904127170"},"rest_id":"2120713688839786780","unmention_data":{},"views":{"count":"2238","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120713688839786780","sortIndex":"2120953654151217073"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2120953654151217232-tweet-2120713202665418927","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"農林水産省の公式アカウントです。ご意見・ご質問は、総合窓口にお寄せください。\n総合窓口→https://t.co/XLQwxIPiHh\n運用方針→https://t.co/2SnzXCNurZ","entities":{"description":{"urls":[{"display_url":"contactus.maff.go.jp/voice/sogo.html","expanded_url":"https://www.contactus.maff.go.jp/voice/sogo.html","indices":[44,67],"url":"https://t.co/XLQwxIPiHh"},{"display_url":"maff.go.jp/j/pr/social_me…","expanded_url":"https://www.maff.go.jp/j/pr/social_media/policy.html","indices":[73,96],"url":"https://t.co/2SnzXCNurZ"}]},"url":{"urls":[{"display_url":"maff.go.jp","expanded_url":"https://www.maff.go.jp/","indices":[0,23],"url":"https://t.co/cPtrdtbo0N"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":270369,"following":57},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2335919749","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8356,"tweets":17868},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/cPtrdtbo0N"}}}},"edit_control":{"edit_tweet_ids":["2120713202665418927"],"editable_until_msecs":"1794456003000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2120713202665418927","created_at":"Thu Nov 12 03:00:03 +0000 2026","display_text_range":[0,133],"entities":{"media":[{"display_url":"pic.x.com/NwxHZ5jVYT","expanded_url":"https://x.com/MAFF_JAPAN/status/2120713202665418927/photo/1","ext_alt_text":"2枚組のイベントチラシの1枚目。1枚目は「スマート農業技術を活用した新たな生産方式推進シンポジウム（土地利用型農業編）in 神戸・淡路島」の案内。\n先進的な技術を活用した栽培体系への転換事例や最新技術を学べるイベントで、参加無料。開催日は2026年12月3日（木）と4日（金）。\n神戸市のザ マーカススクエア神戸で開催。講演・展示会を実施。 株式会社つじ農園 代表取締役 辻武史氏による基調講演「水稲栽培におけるスマート農業への取り組み」のほか、農研機構研究者による露地野菜や有機水稲でのスマート農業技術活用に関する講演、株式会社農社による農業支援サービスの取組紹介を実施。\n兵庫県淡路島の株式会社農社圃場で現地検討会を開催。 トラクタ後付け自動操舵システム、農業用ドローン、小型うね間作業用ロボット、害虫予察システム、ラジコン草刈機などのスマート農業技術を展示・実演。\n定員は講演・展示会200名、現地検討会90名、オンライン参加500名。申込締切は11月27日（金）。主催は一般社団法人全国農業改良普及支援協会。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120398927870754816","indices":[134,157],"media_key":"3_2120398927870754816","media_results":{"result":{"media_key":"3_2120398927870754816"}},"media_url_https":"https://pbs.twimg.com/media/HW0rly3bAAA3bfO.jpg","original_info":{"focus_rects":[{"h":695,"w":1241,"x":0,"y":310},{"h":1241,"w":1241,"x":0,"y":37},{"h":1415,"w":1241,"x":0,"y":0},{"h":1754,"w":877,"x":0,"y":0},{"h":1754,"w":1241,"x":0,"y":0}],"height":1754,"width":1241},"sizes":{"large":{"h":1754,"resize":"fit","w":1241},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/NwxHZ5jVYT"},{"display_url":"pic.x.com/NwxHZ5jVYT","expanded_url":"https://x.com/MAFF_JAPAN/status/2120713202665418927/photo/1","ext_alt_text":"2枚組のイベントチラシの2枚目。講師プロフィールと現地検討会で紹介するスマート農業技術の詳細。\n講師は株式会社つじ農園の辻武史氏、農研機構の深山大介氏・斎藤岳士氏、株式会社農社の奥野竜平氏。現地ではAGMO自動操舵システム、クボタの農業用ドローンT70K・T25K、FieldWorksのウネマキ・ウネカル、農社のムシミエールBI、アテックスのラジコン草刈機「神刈」などを紹介する。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":541,"w":541,"x":3,"y":1221}]},"medium":