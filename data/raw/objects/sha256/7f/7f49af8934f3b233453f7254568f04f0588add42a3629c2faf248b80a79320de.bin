7}]},"medium":{"faces":[{"h":80,"w":80,"x":411,"y":303}]},"orig":{"faces":[{"h":254,"w":254,"x":1292,"y":954}]},"small":{"faces":[{"h":45,"w":45,"x":232,"y":171}]}},"id_str":"2120702832441704448","indices":[148,171],"media_key":"3_2120702832441704448","media_results":{"result":{"media_key":"3_2120702832441704448"}},"media_url_https":"https://pbs.twimg.com/media/HW4__XnaQAAbiuQ.jpg","original_info":{"focus_rects":[{"h":2112,"w":3772,"x":0,"y":169},{"h":2515,"w":2515,"x":1100,"y":0},{"h":2515,"w":2206,"x":1254,"y":0},{"h":2515,"w":1258,"x":1728,"y":0},{"h":2515,"w":3772,"x":0,"y":0}],"height":2515,"width":3772},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/9sVfZSQhpZ"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/9sVfZSQhpZ","expanded_url":"https://x.com/MAFF_JAPAN/status/2120703674058260636/photo/1","ext_alt_text":"「農林水産省鳥インフルエンザ防疫対策本部」の様子（左から保岡大臣政務官、小寺副大臣、武部大臣、藤木副大臣、森下大臣政務官）","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":137,"w":137,"x":701,"y":517}]},"medium":{"faces":[{"h":80,"w":80,"x":411,"y":303}]},"orig":{"faces":[{"h":254,"w":254,"x":1292,"y":954}]},"small":{"faces":[{"h":45,"w":45,"x":232,"y":171}]}},"id_str":"2120702832441704448","indices":[148,171],"media_key":"3_2120702832441704448","media_results":{"result":{"media_key":"3_2120702832441704448"}},"media_url_https":"https://pbs.twimg.com/media/HW4__XnaQAAbiuQ.jpg","original_info":{"focus_rects":[{"h":2112,"w":3772,"x":0,"y":169},{"h":2515,"w":2515,"x":1100,"y":0},{"h":2515,"w":2206,"x":1254,"y":0},{"h":2515,"w":1258,"x":1728,"y":0},{"h":2515,"w":3772,"x":0,"y":0}],"height":2515,"width":3772},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"htt