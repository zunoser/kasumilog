"w":156,"x":2616,"y":448},{"h":168,"w":168,"x":1160,"y":464},{"h":160,"w":160,"x":1752,"y":472},{"h":164,"w":164,"x":2288,"y":532},{"h":180,"w":180,"x":284,"y":532},{"h":152,"w":152,"x":1384,"y":580},{"h":144,"w":144,"x":2000,"y":596},{"h":184,"w":184,"x":716,"y":396},{"h":184,"w":184,"x":3272,"y":492},{"h":172,"w":172,"x":2932,"y":540},{"h":172,"w":172,"x":3728,"y":532},{"h":156,"w":156,"x":2144,"y":1288}]},"small":{"faces":[{"h":25,"w":25,"x":434,"y":74},{"h":27,"w":27,"x":192,"y":77},{"h":26,"w":26,"x":290,"y":78},{"h":27,"w":27,"x":379,"y":88},{"h":29,"w":29,"x":47,"y":88},{"h":25,"w":25,"x":229,"y":96},{"h":23,"w":23,"x":332,"y":98},{"h":30,"w":30,"x":118,"y":65},{"h":30,"w":30,"x":543,"y":81},{"h":28,"w":28,"x":486,"y":89},{"h":28,"w":28,"x":618,"y":88},{"h":25,"w":25,"x":355,"y":213}]}},"id_str":"2120847889979326464","indices":[99,122],"media_key":"3_2120847889979326464","media_results":{"result":{"media_key":"3_2120847889979326464"}},"media_url_https":"https://pbs.twimg.com/media/HW7D61DawAAPsIV.jpg","original_info":{"focus_rects":[{"h":2163,"w":3863,"x":219,"y":0},{"h":2163,"w":2163,"x":1069,"y":0},{"h":2163,"w":1897,"x":1202,"y":0},{"h":2163,"w":1082,"x":1609,"y":0},{"h":2163,"w":4096,"x":0,"y":0}],"height":2163,"width":4096},"sizes":{"large":{"h":1082,"resize":"fit","w":2048},"medium":{"h":634,"resize":"fit","w":1200},"small":{"h":359,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6EcXozsHqj"}]},"favorite_count":67,"favorited":false,"full_text":"赤澤大臣は、自由民主党北海道支部連合会の鈴木貴子会長代行ほかと面談。積雪寒冷地である北海道において極めて重要なライフラインである灯油の安定供給の確保等に向けた対応等に関する御要望をいただきました。 https://t.co/6EcXozsHqj","id_str":"2120848414019891231","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":1,"retweet_count":10,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[179,191],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDg0MTM5NjUzNzM0NDA=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、自由民主党北海道支部連合会の鈴木貴子会長代行ほかと面談。積雪寒冷地である北海道において極めて重要なライフラインである灯油の安定供給の確保等に向けた対応等に関する御要望をいただきました。\n経済産業省では引き続き寒冷地の皆様に寄り添い、10月に新設した「灯油直販スキーム」を活用した供給の偏り解消を行う等、支障が生じないよう、万全を期してまいります。#meti_daijin"}}},"rest_id":"2120848414019891231","unmention_data":{},"views":{"count":"7268","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120848414019891231","sortIndex":"2120953654151217144"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"pro