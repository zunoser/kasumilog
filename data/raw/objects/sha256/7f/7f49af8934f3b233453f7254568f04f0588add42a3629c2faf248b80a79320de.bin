pg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/dA5JIEkTju"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/dA5JIEkTju","expanded_url":"https://x.com/takaichi_sanae/status/2120847446976930283/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":67,"w":67,"x":1825,"y":911},{"h":97,"w":97,"x":933,"y":253},{"h":77,"w":77,"x":1805,"y":931},{"h":103,"w":103,"x":645,"y":287},{"h":107,"w":107,"x":381,"y":307},{"h":111,"w":111,"x":1401,"y":327},{"h":93,"w":93,"x":1177,"y":377}]},"medium":{"faces":[{"h":39,"w":39,"x":1069,"y":534},{"h":57,"w":57,"x":546,"y":148},{"h":45,"w":45,"x":1057,"y":546},{"h":60,"w":60,"x":378,"y":168},{"h":63,"w":63,"x":223,"y":180},{"h":65,"w":65,"x":821,"y":192},{"h":54,"w":54,"x":690,"y":221}]},"orig":{"faces":[{"h":86,"w":86,"x":2318,"y":1157},{"h":124,"w":124,"x":1185,"y":322},{"h":99,"w":99,"x":2292,"y":1183},{"h":132,"w":132,"x":820,"y":365},{"h":137,"w":137,"x":484,"y":391},{"h":142,"w":142,"x":1779,"y":416},{"h":119,"w":119,"x":1495,"y":479}]},"small":{"faces":[{"h":22,"w":22,"x":606,"y":302},{"h":32,"w":32,"x":309,"y":84},{"h":25,"w":25,"x":599,"y":309},{"h":34,"w":34,"x":214,"y":95},{"h":35,"w":35,"x":126,"y":102},{"h":37,"w":37,"x":465,"y":108},{"h":31,"w":31,"x":391,"y":125}]}},"id_str":"2120847360620388352","indices":[96,119],"media_key":"3_2120847360620388352","media_results":{"result":{"media_key":"3_2120847360620388352"}},"media_url_https":"https://pbs.twimg.com/media/HW7DcBCaYAAp8lC.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":995,"y":0},{"h":1734,"w":867,"x":1322,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/dA5JIEkTju"}]},"favorite_count":3349,"favorited":false,"full_text":"本日午後、自民党・AZEC議員連盟の皆様、日本経済団体連合会の皆様から、それぞれ、AZEC（アジア・ゼロエミッション共同体）推進のための提言をいただきました。\n\n「自由で開かれたインド太平洋 https://t.co/dA5JIEkTju","id_str":"2120847446976930283","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":13,"reply_count":125,"retweet_count":346,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDc0NDY5MDE0ODU1Njg=","richtext":{"richtext_tags":[]},"text":"本日午後、自民党・AZEC議員連盟の皆様、日本経済団体連合会の皆様から、それぞれ、AZEC（アジア・ゼロエミッション共同体）推進のための提言をいただきました。\n\n「自由で開かれたインド太平洋 FOIP」を更に進化させ、同盟国・同志国との連携を強化し、地域の国々と共に、インド太平洋を、「自律性」と「強靱性」を備え、「共に強く豊かに」なっていく地域にしていくことが重要です。\n\n来週、共同議長として出席する「AZEC首脳会合」では、今年4月に私が発表した『パワー・アジア』を強化する日本のイニシアティブを発信予定です。\n\nパートナー国と連携し、「経済・エネルギー強靱化の視点」を強化した「パワー・アジア」を推進することで、「脱炭素」「経済成長」「エネルギー安全保障」の同時実現を目指すAZECを、\n・「エネルギー強靭化」と\n・「経済強靭化・GX投資の加速化」\nを一層強化した「AZEC2.0」へと進化させていきます。\n\nいただいた御提言を受け止め、「AZEC2.0」のもと、アジア地域全体の経済・エネルギー強靭化を進めていきます。"}}},"rest_id":"2120847446976930283","unmention_data":{},"views":{"count":"138377","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120847446976930283","sortIndex":"2120953654151217141"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Twe