inal_info":{"focus_rects":[{"h":596,"w":1064,"x":0,"y":0},{"h":710,"w":710,"x":0,"y":0},{"h":710,"w":623,"x":34,"y":0},{"h":710,"w":355,"x":168,"y":0},{"h":710,"w":1064,"x":0,"y":0}],"height":710,"width":1064},"sizes":{"large":{"h":710,"resize":"fit","w":1064},"medium":{"h":710,"resize":"fit","w":1064},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/7KEMV2ujpW"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/7KEMV2ujpW","expanded_url":"https://x.com/takaichi_sanae/status/2120848097412866509/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":80,"w":80,"x":395,"y":33},{"h":76,"w":76,"x":314,"y":128},{"h":272,"w":272,"x":573,"y":290}]},"medium":{"faces":[{"h":80,"w":80,"x":395,"y":33},{"h":76,"w":76,"x":314,"y":128},{"h":272,"w":272,"x":573,"y":290}]},"orig":{"faces":[{"h":80,"w":80,"x":395,"y":33},{"h":76,"w":76,"x":314,"y":128},{"h":272,"w":272,"x":573,"y":290}]},"small":{"faces":[{"h":51,"w":51,"x":252,"y":21},{"h":48,"w":48,"x":200,"y":81},{"h":173,"w":173,"x":366,"y":185}]}},"id_str":"2120847978705649664","indices":[128,151],"media_key":"3_2120847978705649664","media_results":{"result":{"media_key":"3_2120847978705649664"}},"media_url_https":"https://pbs.twimg.com/media/HW7D__lbAAAHnc0.jpg","original_info":{"focus_rects":[{"h":596,"w":1064,"x":0,"y":0},{"h":710,"w":710,"x":0,"y":0},{"h":710,"w":623,"x":34,"y":0},{"h":710,"w":355,"x":168,"y":0},{"h":710,"w":1064,"x":0,"y":0}],"height":710,"width":1064},"sizes":{"large":{"h":710,"resize":"fit","w":1064},"medium":{"h":710,"resize":"fit","w":1064},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/7KEMV2ujpW"}]},"favorite_count":2689,"favorited":false,"full_text":"【フィジカルAI関連企業との意見交換会②】\n\nTELEXISTENCE株式会社の代表取締役CEOの富岡 仁 様からは、「TX G2」を実演いただくとともに、以下のお話を伺いました。\n\n「NVIDIAと一緒に作っている、小売のレジの精算業務のロボットです。 https://t.co/7KEMV2ujpW","id_str":"2120848097412866509","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"reply_count":63,"retweet_count":295,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDgwOTczNDE0NzI3Njg=","richtext":{"richtext_tags":[]},"text":"【フィジカルAI関連企業との意見交換会②】\n\nTELEXISTENCE株式会社の代表取締役CEOの富岡 仁 様からは、「TX G2」を実演いただくとともに、以下のお話を伺いました。\n\n「NVIDIAと一緒に作っている、小売のレジの精算業務のロボットです。\n今は自律的に我々のモデルで動かしており、人がロボットを操作して収集したデータを丸ごと学習しています。\nまだ完璧ではないですが、どれだけデータを集めて学習できるかが重要ですので、今、経産省で進めている大規模な現場データの収集の取組が重要です。\n我々自身も今、セブンイレブンと組んで、全国の2万店の店舗でのデータ収集を行っています。\n2029年までには実用化して、店舗の事務の労働力を解放し、特に小売・物流の人手不足の解決を図っていく考えです。\nまた、物流のロボットは、コンビニの裏側で飲料を陳列しています。\n自律的に動いていますが、もっと精度を上げていきたいと思っています。」\n\n「我々はスタートアップですが、小売・物流分野で最低限100億強を投資する計画があります。\nロボットモデル自体は我々自分たちで作りますけれども、ロボットを実用化する時に環境認識や人の言語を理解するモデルは、現状ではほとんど外国産のものしかないので、今後、海外に頼らず国産のものを使っていく。\nまさにNoetraさんが開発をされるモデルも、選択肢として考えています。」"}}},"rest_id":"2120848097412866509","unmention_data":{},"views":{"count":"120984","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120848097412866509","sortIndex":"2120953654151217143"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075518,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":636,"tweets":1959},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2120847732026085569"],"editable_until_msecs":"1794488077000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":70,"bookmarked":false,"conversation_id_str":"2120847732026085569","created_at":"Thu Nov 12 11:54:37 +0000 2026","display_text_range":[0,125],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/NyqI139PWx","expanded_url":"https://x.com/takaichi_sanae/status/2120847732026085569/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":48,"w":48,"x":1150,"y":712},{"h":57,"w":57,"x":1142,"y":196},{"h":61,"w":61,"x":781,"y":236}]},"medium":{"faces":[{"h":43,"w":43,"x":1036,"y":641},{"h":51,"w":51,"x":1029,"y":176},{"h":54,"w":54,"x":704,"y":212}]},"orig":{"faces":[{"h":48,"w":48,"x":1150,"y":712},{"h":57,"w":57,"x":1142,"y":196},{"h":61,"w":61,"x":781,"y":236}]},"small":{"faces":[{"h":24,"w":24,"x":587,"y":363},{"h":29,"w":29,"x":583,"y":100},{"h":31,"w":31,"x":399,"y":120}]}},"id_str":"2120847654007795712","indices":[126,149],"media_key":"3_2120847654007795712","media_results":{"result":{"media_key":"3_2120847654007795712"}},"media_url_https":"https://pbs.twimg.com/media/HW7DtF_a8AADj0B.jpg","original_info":{"focus_rects":[{"h":745,"w":1331,"x":0,"y":0},{"h":887,"w":887,"x":0,"y":0},{"h":887,"w":778,"x":0,"y":0},{"h":887,"w":444,"x":77,"y":0},{"h":887,"w":1331,"x":0,"y":0}],"height":887,"width":1331},"sizes":{"large":{"h":887,"resize":"fit","w":1331},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/NyqI139PWx"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/NyqI139PWx","expanded_url":"https://x.com/takaichi_sanae/status/2120847732026085569/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":48,"w":48,"x":1150,"y":712},{"h":57,"w":57,"x":1142,"y":196},{"h":61,"w":61,"x":781,"y":236}]},"medium":{"faces":[{"h":43,"w":43,"x":1036,"y":641},{"h":51,"w":51,"x":1029,"y":176},{"h":54,"w":54,"x":704,"y":212}]},"orig":{"faces":[{"h":48,"w":48,"x":1150,"y":712},{"h":57,"w":57,"x":1142,"y":196},{"h":61,"w":61,"x":781,"y":236}]},"small":{"faces":[{"h":24,"w":24,"x":587,"y":363},{"h":29,"w":29,"x":583,"y":100},{"h":31,"w":31,"x":399,"y":120}]}},"id_str":"2120847654007795712","indices":[126,149],"media_key":"3_2120847654007795712","media_results":{"result":{"media_key":"3_2120847654007795712"}},"media_url_https":"https://pbs.twimg.com/media/HW7DtF_a8AADj0B.jpg","original_info":{"focus_rects":[{"h":745,"w":1331,"x":0,"y":0},{"h":887,"w":887,"x":0,"y":0},{"h":887,"w":778,"x":0,"y":0},{"h":887,"w":444,"x":77,"y":0},{"h":887,"w":1331,"x":0,"y":0}],"height":887,"width":1331},"sizes":{"large":{"h":887,"resize":"fit","w":1331},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/NyqI139PWx"}]},"favorite_count":2453,"favorited":false,"full_text":"【フィジカルAI関連企業との意見交換会①】\n\n本日午前、ugo株式会社、TELEXISTENCE株式会社、GROOVE X株式会社、ミネベアミツミ株式会社、Noetra株式会社、Genki Robotics合同会社の皆様が、官邸にお越し下さりました。 https://t.co/NyqI139PWx","id_str":"2120847732026085569","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":18,"reply_count":71,"retweet_count":318,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4NDc3MzE5NTg4OTA0OTY=","richtext":{"richtext_tags":[]},"text":"【フィジカルAI関連企業との意見交換会①】\n\n本日午前、ugo株式会社、TELEXISTENCE株式会社、GROOVE X株式会社、ミネベアミツミ株式会社、Noetra株式会社、Genki Robotics合同会社の皆様が、官邸にお越し下さりました。\n\n「フィジカルAI」の最前線で活躍されている皆様から、ロボットが実際に社会で使われる様子を実演いただくとともに、今後の取組についてお話をお伺いしました。\n\nugo株式会社の代表取締役CEOの松井 健 様からは、「ugo Nova」を実演いただくとともに、以下のお話を伺いました。\n\n「フィジカルAIを構築するためのデータ収集や製造業、工場でのライン周辺業務を担う国産セミヒューマノイド、『ugo Nova』です。\n日本のものづくりの知恵をロボットの知能に変え、現場で使い、改善し続ける。\nさらに、国内の事業者がフィジカルAIやロボットを活用し、RX、ロボットトランスフォーメーションを進める。\nこれにより、高付加価値な製品を作り出して、日本の生産性を高めることこそが、日本におけるフィジカルAIの勝ち筋だと考えています。\n私たちは製造業向けのフィジカルAIを開発しており、AIロボットがAIロボットを作る工場の実現を目指しています。\nugoは日本の人手不足に配慮し、新しいロボット産業の成長を実現してまいります。」\n\n「ugoは、国内の社会インフラ事業者様から累計50億円調達し、ロボットの社会実装を進めてまいりました。\n今後も我々は資金調達をスタートアップとして進め、フィジカルAIの社会実装に向けて30億円以上の規模の投資をしていこうと考えています。\n最近、ugo Novaを販売・商談していると、『国産ロボットを待っていた』という国内の事業者様が多く、国産への強いニーズに応えていく必要があると感じております。\nさらに、社会実装にあたっては、Noetra社が開発される国産AI基盤の活用も積極的に行ってまいりたいと思っております。\n📷   \n 国産ロボットとAIを結び、日本の現場で価値を生み出していきたいと考えております。」"}}},"rest_id":"2120847732026085569","unmention_data":{},"views":{"count":"134051","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120847732026085569","sortIndex":"2120953654151217142"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts