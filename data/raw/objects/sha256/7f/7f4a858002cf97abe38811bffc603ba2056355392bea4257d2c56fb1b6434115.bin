DR2Cf"},{"display_url":"pic.x.com/eUfjEDR2Cf","expanded_url":"https://x.com/ModJapan_jp/status/2094376473423683754/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":106,"w":106,"x":308,"y":1046},{"h":210,"w":210,"x":1206,"y":242},{"h":236,"w":236,"x":650,"y":248},{"h":162,"w":162,"x":694,"y":426},{"h":280,"w":280,"x":1100,"y":570}]},"medium":{"faces":[{"h":62,"w":62,"x":180,"y":612},{"h":123,"w":123,"x":706,"y":141},{"h":138,"w":138,"x":380,"y":145},{"h":94,"w":94,"x":406,"y":249},{"h":164,"w":164,"x":644,"y":333}]},"orig":{"faces":[{"h":106,"w":106,"x":308,"y":1046},{"h":210,"w":210,"x":1206,"y":242},{"h":236,"w":236,"x":650,"y":248},{"h":162,"w":162,"x":694,"y":426},{"h":280,"w":280,"x":1100,"y":570}]},"small":{"faces":[{"h":35,"w":35,"x":102,"y":347},{"h":69,"w":69,"x":400,"y":80},{"h":78,"w":78,"x":215,"y":82},{"h":53,"w":53,"x":230,"y":141},{"h":92,"w":92,"x":365,"y":189}]}},"id_str":"2094376460773662720","indices":[79,102],"media_key":"3_2094376460773662720","media_results":{"result":{"media_key":"3_2094376460773662720"}},"media_url_https":"https://pbs.twimg.com/media/HRC4S2paoAAQSIk.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":219},{"h":1366,"w":1366,"x":0,"y":0},{"h":1366,"w":1198,"x":0,"y":0},{"h":1366,"w":683,"x":0,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/eUfjEDR2Cf"}]},"favorite_count":612,"favorited":false,"full_text":"8月31日、小泉防衛大臣は、連合海上部隊（CMF）派遣隊長・米中央海軍司令部（NAVCENT）連絡官として派遣されていた髙橋1等海佐の帰国報告を受けました。 https://t.co/eUfjEDR2Cf","id_str":"2094376473423683754","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":11,"retweet_count":77,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/profile/mini…","expanded_url":"https://www.mod.go.jp/j/profile/minister/koizumi/2026_08.html","indices":[395,418],"url":"https://t.co/gB2FKHbGXQ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQzNzY0NzMyNzI2ODA0NDg=","text":"8月31日、小泉防衛大臣は、連合海上部隊（CMF）派遣隊長・米中央海軍司令部（NAVCENT）連絡官として派遣されていた髙橋1等海佐の帰国報告を受けました。\n\n髙橋1佐は、CMFにおいて連絡官として勤務し、各国軍との連絡調整などを行い、海賊対処行動に貢献するとともに、中東情勢に関する情報収集などを的確に実施しました。\n\n特に、緊迫する中東情勢の中においても、臨機応変に情報収集を実施し、現地の実状に基づく重要な情報を日本へ報告するなど、防衛省・自衛隊の活動を支える重要な役割を果たしました。\n\nこうした連絡官の対応は、厳しい状況においても職務を全うするという平素からの強い使命感の賜物です。防衛省・自衛隊は引き続き自衛官の派遣等を通じて、国際社会の平和と安定に貢献していきます。\n\n☆CMFとは：バーレーンに司令部を置く、中東地域の海域の安全のために組織された多国籍部隊\n👇詳細はこちら\nhttps://t.co/gB2FKHbGXQ"}}},"rest_id":"2094376473423683754","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"25770","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094376473423683754","sortIndex":"2094516997101453302"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo