a01RGYUQXf","id_str":"2094364115540291700","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":235,"reply_count":549,"retweet_count":716,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQzNjQxMTU0ODE1ODM2MTY=","richtext":{"richtext_tags":[]},"text":"本日午後、ミス・ユニバース・ジャパン2026の伊藤さんとナショナルディレクターの美馬さんが官邸にお越し下さりました。\n\nミス・ユニバースは、1952年にカリフォルニア州ロングビーチで行われて以来、70年間以上にわたり、世界で活躍する女性リーダーを発掘し、育成されてきたと承知しています。\n\n伊藤さんは、今年11月にプエルトリコで開催されるミス・ユニバースの世界大会に、日本代表として出場されると伺いました。\n\nお二人とは、日本の魅力をどのように世界に発信していくか、お二人が目指しておられる世界で活躍する女性リーダーとなるための心構え、日本の米粉などノングルテン食品の世界展開、といった話題で大いに盛り上がりました。\n\nミス・ユニバース・ジャパンの皆様の御健勝と更なる御活躍を祈念しています。"}}},"rest_id":"2094364115540291700","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"478806","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094364115540291700","sortIndex":"2094516997101453289"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/OI0zkPrk9a"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":fal