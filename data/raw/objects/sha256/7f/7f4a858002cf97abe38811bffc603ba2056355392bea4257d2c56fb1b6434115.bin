":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":585916,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20092,"tweets":48732},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2094370909591417018"],"editable_until_msecs":"1788175511000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":23,"bookmarked":false,"conversation_id_str":"2094370909591417018","created_at":"Mon Aug 31 10:25:11 +0000 2026","display_text_range":[0,66],"entities":{"media":[{"display_url":"pic.x.com/imRf7fOTVO","expanded_url":"https://x.com/MofaJapan_jp/status/2094370909591417018/photo/1","ext_alt_text":"ノルウェー王国ハラルド5世国王陛下の崩御に関する高市内閣総理大臣の談話\n令和8年8月31日\nノルウェー王国ハラルド5世国王陛下の崩御の報に接し、日本国政府及び日本国民を代表して、ノルウェー王室、ノルウェー政府及びノルウェー国民の皆様に対し、心から哀悼の誠をささげます。\n\n　ハラルド5世国王陛下は、1991年の御即位以降、常に国民と共にあり、温かなお人柄をもって国を導かれ、ノルウェーの発展と国際社会の平和と繁栄のために極めて大きな役割を果たされてきました。\n\n　日ノルウェー関係は、皇室・王室の伝統的な友好関係に支えられて発展してきましたが、ハラルド5世国王陛下は、皇太子時代に1964年東京オリンピックに選手として御出場になるなどスポーツを通じた交流の象徴ともなられ、また、計6回にわたり御訪日され、産業・文化交流や我が国の儀式への御参列、国賓としての御訪日等を通じて、両国の友好親善の更なる深化に大いに貢献されました。\n\n　激動の世界情勢においてノルウェーを導いたハラルド5世国王陛下の崩御は、ノルウェー国民のみならず国際社会にとっての大きな損失です。ノルウェー国民の皆様が、この深い悲しみを乗り越えるに当たり、日本は常にノルウェーと共にあります。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":402,"w":402,"x":76,"y":25}]},"medium":{"faces":[{"h":371,"w":371,"x":70,"y":23}]},"orig":{"faces":[{"h":402,"w":402,"x":76,"y":25}]},"small":{"faces":[{"h":210,"w":210,"x":39,"y":13}]}},"id_str":"2094370686680842240","indices":[67,90],"media_key":"3_2094370686680842240","media_results":{"result":{"media_key":"3_2094370686680842240"}},"media_url_https":"https://pbs.twimg.com/media/HRCzCweaQAASMxp.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":0},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":194,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/imRf7fOTVO"}],"urls":[{"display_url":"mofa.go.jp/mofaj/press/da…","expanded_url":"https://www.mofa.go.jp/mofaj/press/danwa/pageit_000001_03169.html","indices":[43,66],"url":"https://t.co/L4vUVdR6Yf"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/imRf7fOTVO","expanded_url":"https://x.com/MofaJapan_jp/status/2094370909591417018/photo/1","ext_alt_text":"ノルウェー王国ハラルド5世国王陛下の崩御に関する高市内閣総理大臣の談話\n令和8年8月31日\nノルウェー王国ハラルド5世国王陛下の崩御の報に接し、日本国政府及び日本国民を代表して、ノルウェー王室、ノルウェー政府及びノルウェー国民の皆様に対し、心から哀悼の誠をささげます。\n\n　ハラルド5世国王陛下は、1991年の御即位以降、常に国民と共にあり、温かなお人柄をもって国を導かれ、ノルウェーの発展と国際社会の平和と繁栄のために極めて大きな役割を果たされてきました。\n\n　日ノルウェー関係は、皇室・王室の伝統的な友好関係に支えられて発展してきましたが、ハラルド5世国王陛下は、皇太子時代に1964年東京オリンピックに選手として御出場になるなどスポーツを通じた交流の象徴ともなられ、また、計6回にわたり御訪日され、産業・文化交流や我が国の儀式への御参列、国賓としての御訪日等を通じて、両国の友好親善の更なる深化に大いに貢献されました。\n\n　激動の世界情勢においてノルウェーを導いたハラルド5世国王陛下の崩御は、ノルウェー国民のみならず国際社会にとっての大きな損失です。ノルウェー国民の皆様が、この深い悲しみを乗り越えるに当たり、日本は常にノルウェーと共にあります。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":402,"w":402,"x":76,"y":25}]},"medium":{"faces":[{"h":371,"w":371,"x":70,"y":23}]},"orig":{