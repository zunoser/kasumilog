":[253,276],"url":"https://t.co/8QaHMGAGdJ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQzNzk3MjY2ODk0ODA3MDQ=","text":"8月31日、小泉防衛大臣は「省議・防衛力変革推進本部（第10回）」を開催📣\n今回は、令和9年度概算要求、イラン情勢でみられた戦い方や課題について議論。\n国内外の情勢は現行の三文書の策定当時に想定していた以上の速度と複雑性をもって変化しており、イランなどでみられる「新しい戦い方」は今や世界におけるスタンダードになっています。\n今回のイラン情勢で得られた教訓も踏まえ、日本として、「新しい戦い方」にどう対応していくか、引き続きスピード感を持って検討を進めて行きます。\n\n📌防衛力変革推進本部についてはこちら\nhttps://t.co/8QaHMGAGdJ"}}},"rest_id":"2094379726748217605","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"24559","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094379726748217605","sortIndex":"2094516997101453304"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2094193876357833214"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（En