"},"conversation_id_str":"2092268465797439729","created_at":"Tue Aug 25 15:10:49 +0000 2026","display_text_range":[0,275],"entities":{},"favorite_count":835,"favorited":false,"full_text":"On August 24, PM Takaichi participated in the Leaders Meeting of the Coalition of the Willing held on the occasion of the 35th anniversary of Ukraine’s independence. President Zelenskyy subsequently posted the following message regarding PM Takaichi’s remarks at the meeting.","id_str":"2092268465797439729","is_quote_status":true,"lang":"en","quote_count":11,"quoted_status_id_str":"2092169050210123983","quoted_status_permalink":{"display":"x.com/ZelenskyyUa/st…","expanded":"https://twitter.com/ZelenskyyUa/status/2092169050210123983","url":"https://t.co/3rJsd6ZVXG"},"reply_count":1,"retweet_count":113,"retweeted":false,"user_id_str":"2050016551945052160"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":215},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1585550046740848642/OpGKpqx9_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1120633726478823425/1692773060"},"core":{"created_at":"Tue Apr 23 10:21:15 +0000 2019","name":"Volodymyr Zelenskyy / Володимир Зеленський","screen_name":"ZelenskyyUa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTIwNjMzNzI2NDc4ODIzNDI1","is_blue_verified":true,"location":{"location":"Україна"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"President of Ukraine / Президент України","entities":{"description":{},"url":{"urls":[{"display_url":"president.gov.ua","expanded_url":"https://www.president.gov.ua","indices":[0,23],"url":"https://t.co/ctVL0atMBQ"}]}}},"profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":8827919,"following":1},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1120633726478823425","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8163,"tweets":16619},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/ctVL0atMBQ"}}}},"edit_control":{"edit_tweet_ids":["2092169050210123983"],"editable_until_msecs":"1787650546000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":true,"legacy":{"bookmark_count":347,"bookmarked":false,"conversation_id_str":"2092169050210123983","created_at":"Tue Aug 25 08:35:46 +0000 2026","display_text_range":[0,278],"entities":{"user_mentions":[{"id_str":"218434058","indices":[213,228],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"favorite_count":14866,"favorited":false,"full_text":"Japan is geographically distant from Ukraine, but we are very close in terms of our values, shared principles, and our common understanding of how important freedom and independence are. Thank you, Prime Minister @takaichi_sanae, for your congratulations on the 35th anniversary","id_str":"2092169050210123983","is_quote_status":false,"lang":"en","quote_count":134,"reply_count":272,"retweet_count":2200,"retweeted":false,"user_id_str":"1120633726478823425"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"218434058","indices":[213,228],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"id":"Tm90ZVR3ZWV0OjIwOTIxNjkwNTAxMDk0NjA0ODE=","richtext":{"richtext_tags":[]},"text":"Japan is geographically distant from Ukraine, but we are very close in terms of our values, shared principles, and our common understanding of how important freedom and independence are. Thank you, Prime Minister @takaichi_sanae, for your congratulations on the 35th anniversary of Ukraine’s independence.\n\nWe are constantly working to strengthen the defense of both our peoples and our regions. Russia’s cooperation with North Korea is truly dangerous for everyone in Asia as well. In light of all this, we highly value your messages about the importance of strengthening sanctions against Russia and increasing support for our country and our people. Thank you for speaking so warmly about the Ukrainian people and for always recognizing the courage of Ukrainians. Thank you, Japan!"}}},"rest_id":"2092169050210123983","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"636099","state":"EnabledWithCount"}}},"rest_id":"2092268465797439729","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"75684","state":"EnabledWithCount"}}}},"user_id_str":"412940784"},"rest_id":"2092270078020784555","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"4980","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2092270078020784555","sortIndex":"2092522576248045505"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliate