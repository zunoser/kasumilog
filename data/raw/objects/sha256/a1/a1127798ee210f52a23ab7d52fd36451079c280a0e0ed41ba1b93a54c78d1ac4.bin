2024","name":"警察庁（災害情報専用）","screen_name":"NPA_saigaiKOHO"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNzQ0NjUwNjE1NjQzNjM5ODA5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2丁目1番2号"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"警察庁公式アカウントです。 発信する情報は「国内災害情報」「災害時警察活動」等です。発信専用のため返信等は行っておりません。ご利用にあたっては「警察庁（災害情報専用）X（旧：Twitter）運用ポリシーhttps://t.co/PluqK5Z3rXをご覧ください。","entities":{"description":{"urls":[{"display_url":"npa.go.jp/twitter/NPAsai…","expanded_url":"https://www.npa.go.jp/twitter/NPAsaigaipolicy.html","indices":[101,124],"url":"https://t.co/PluqK5Z3rX"}]},"url":{"urls":[{"display_url":"npa.go.jp","expanded_url":"https://www.npa.go.jp/","indices":[0,23],"url":"https://t.co/MHizgQoxXX"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":29243,"following":57},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1744650615643639809","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":309,"tweets":563},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/MHizgQoxXX"}}}},"edit_control":{"edit_tweet_ids":["2089649755920142728"],"editable_until_msecs":"1787049900000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":12,"bookmarked":false,"conversation_id_str":"2089649755920142728","created_at":"Tue Aug 18 09:45:00 +0000