950},"sizes":{"large":{"h":2048,"resize":"fit","w":1536},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/soVPAycg6J"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/soVPAycg6J","expanded_url":"https://x.com/takaichi_sanae/status/2089645163236966842/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2089645143993536512","indices":[136,159],"media_key":"3_2089645143993536512","media_results":{"result":{"media_key":"3_2089645143993536512"}},"media_url_https":"https://pbs.twimg.com/media/HP_pL-Ja0AAIDUP.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":433,"y":0},{"h":1734,"w":1521,"x":540,"y":0},{"h":1734,"w":867,"x":867,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/soVPAycg6J"}]},"favorite_count":4977,"favorited":false,"full_text":"本日、第61次「沖縄県豆記者団」の小中学生35名の皆様が官邸を訪ねて下さいました。\n\nとても暑い中、沖縄からお越しいただきましたことに、感謝を申し上げました。\n\n皆様の郷土愛あふれる素敵な歌（てぃんさぐぬ花）と美しい琉球舞踊（かぎやで風）を拝見し、元気をいただきました。 https://t.co/soVPAycg6J","id_str":"2089645163236966842","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":33,"reply_count":203,"retweet_count":524,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwODk2NDUxNjMxNDg5MjY5NzY=","richtext":{"richtext_tags":[]},"text":"本日、第61次「沖縄県豆記者団」の小中学生35名の皆様が官邸を訪ねて下さいました。\n\nとても暑い中、沖縄からお越しいただきましたことに、感謝を申し上げました。\n\n皆様の郷土愛あふれる素敵な歌（てぃんさぐぬ花）と美しい琉球舞踊（かぎやで風）を拝見し、元気をいただきました。\n\n沖縄は、美しい自然に恵まれ、国際色あふれる独自の文化を育んできた、我が国が誇る地域です。\n\n豆記者の皆様には、今回の取材活動で様々なことを学び、知見を広げるとともに、改めて皆様が生まれ育った沖縄の文化を振り返ることで、沖縄の魅力についても、再発見して、発信をしていただきたいと思います。\n\nそして、これからの沖縄県と日本を担う皆様が、それぞれが志す分野で、将来ご活躍されることを心から期待しています。\n\nお土産に賜った「ちんすこう」、秘書官達と一緒に楽しみにいただきます！"}}},"rest_id":"2089645163236966842","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"141146","state":"EnabledWithCount"}}}}},"entryId":"tweet-2089645163236966842","sortIndex":"2089684679425785841"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"