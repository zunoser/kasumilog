}]},"favorite_count":2,"favorited":false,"full_text":"福島の復興は、地域毎に状況や課題も多様で、人的支援が必要な町があります。福島復興局では、双葉町役場で農業土木や健康福祉分野の知見を活かし、情報提供、助言その他協力を行う非常勤の国家公務員「市町村応援職員」を2名再募集します。締切：R8.11.5(木) 詳細は下記より\nhttps://t.co/SMdmJ7dVxI","id_str":"2108361968923152792","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":0,"retweeted":false,"user_id_str":"2931953732"},"rest_id":"2108361968923152792","unmention_data":{},"views":{"count":"714","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108361968923152792","sortIndex":"2108483978750066613"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1674231387166220288/iK7GwtIr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/180585090/1680484704"},"core":{"created_at":"Fri Aug 20 00:19:17 +0000 2010","name":"厚生労働省","screen_name":"MHLWitter"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODA1ODUwOTA=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"厚生労働省の公式アカウントです。\n健康・医療、福祉・介護、雇用・労働、年金など、皆さまの暮らしを支える情報をお届けします。\n\n※このXに寄せられたコメントへの返信はしておりません。\n\n【運用方針】\nhttps://t.co/dQtOdVs4pp","entities":