:"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2108475004954563025","created_at":"Fri Oct 09 08:29:49 +0000 2026","display_text_range":[0,57],"entities":{"media":[{"display_url":"pic.x.com/F9rLDm2zuO","expanded_url":"https://x.com/MofaJapan_jp/status/2108475004954563025/photo/1","ext_alt_text":"１　我が国は、最近のエチオピアとエリトリア間の緊張の高まりが、周辺地域の一層の不安定化につながりかねない状況にあることを注視しており、エチオピアとエリトリア両国が、双方の主権、独立及び領土の一体性を尊重し、最大限の自制を発揮して両国間の緊張を緩和することを強く求めます。\n\n２　我が国は、エチオピアとエリトリア両国が、歴史的な２０１８年の和平枠組の精神に則り、いかなる緊張や紛争も、対話を通じ平和的かつ外交的に解決することを強く求めます。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108474819755020288","indices":[58,81],"media_key":"3_2108474819755020288","media_results":{"result":{"media_key":"3_2108474819755020288"}},"media_url_https":"https://pbs.twimg.com/media/HULOrWlakAAiIvg.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":0},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":389,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/F9rLDm2zuO"}],"urls":[{"display_url":"mofa.go.jp/mofaj/press/da…","expanded_url":"https://www.mofa.go.jp/mofaj/press/danwa/pageit_000001_00058.html","indices":[34,57],"url":"https://t.co/lmdh7XKJOH"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/F9rLDm2zuO","expanded_url":"https://x.com/MofaJapan_jp/status/2108475004954563025/photo/1","ext_alt_text":"１　我が国は、最近のエチオピアとエリトリア間の緊張の高まりが、周辺地域の一層の不安定化につながりかねない状況にあることを注視しており、エチオピアとエリトリア両国が、双方の主権、独立及び領土の一体性を尊重し、最大限の自制を発揮して両国間の緊張を緩和