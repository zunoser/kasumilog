"y":0},{"h":1024,"w":1024,"x":0,"y":0},{"h":1024,"w":898,"x":0,"y":0},{"h":1024,"w":512,"x":89,"y":0},{"h":1024,"w":1536,"x":0,"y":0}],"height":1024,"width":1536},"sizes":{"large":{"h":1024,"resize":"fit","w":1536},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/ealw4UpHkH"}]},"favorite_count":283,"favorited":false,"full_text":"【🛰防衛×宇宙🚀シリーズ㉛】\n \n第31弾は、「即応宇宙輸送能力の提案募集！」\n \n防衛省・自衛隊が利用する人工衛星の一部が失われた場合に、その機能を迅速に回復することは、安全保障上の重要な課題です。 https://t.co/ealw4UpHkH","id_str":"2108456800215617714","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"quoted_status_id_str":"2105960999362658530","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2105960999362658530","url":"https://t.co/djwxnn5Co8"},"reply_count":3,"retweet_count":58,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[370,375],"text":"宇宙安保"},{"indices":[376,390],"text":"SDF_SpaceYear"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"mod.go.jp/j/budget/chota…","expanded_url":"https://www.mod.go.jp/j/budget/chotatsu/naikyoku/koubo/2026/1009a.pdf","indices":[271,294],"url":"https://t.co/lJ5lXlqBXG"},{"display_url":"youtu.be/W3LFuwKp_q8?si…","expanded_url":"https://youtu.be/W3LFuwKp_q8?si=-GY1qbI6j46zcuQq","indices":[313,336],"url":"https://t.co/kVZZptmHy1"},{"display_url":"mod.go.jp/j/press/kisha/…","expanded_url":"https://www.mod.go.jp/j/press/kisha/2026/1009a.html","indices":[344,367],"url":"https://t.co/Jo1qkOKYzL"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg0NTY3OTk5OTc0NTYzODQ=","text":"【🛰防衛×宇宙🚀シリーズ㉛】\n \n第31弾は、「即応宇宙輸送能力の提案募集！」\n \n防衛省・自衛隊が利用する人工衛星の一部が失われた場合に、その機能を迅速に回復することは、安全保障上の重要な課題です。\nこのためにどのような即応宇宙輸送システムが必要か、防衛省では本日（10/9）から提案を募集します！\n \n宇宙産業の技術力、創造力、そして挑戦する力を発揮していただき、防衛課題の解決と宇宙産業発展の好循環を目指します。\n宇宙産業に携わる皆さまの革新的なご提案をお待ちしております！\n \n👇ご提案はこちらから【締切：12月23日（水）12時】\nhttps://t.co/lJ5lXlqBXG\n\n👇詳しくはこちら\n（大臣会見動画）https://t.co/kVZZptmHy1\n（大臣会見録）https://t.co/Jo1qkOKYzL\n \n#宇宙安保\n#SDF_SpaceYear"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1264660,"following":43},"relationship_perspectives":