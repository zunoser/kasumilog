874363002880"}},"media_url_https":"https://pbs.twimg.com/media/HUJJ8NobIAAj79O.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":128},{"h":800,"w":800,"x":400,"y":0},{"h":800,"w":702,"x":498,"y":0},{"h":800,"w":400,"x":800,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/07G3C7HSyP"}]},"favorite_count":43,"favorited":false,"full_text":"【あなたの行動が物流を支える｜第1回】\n\nスーパーやドラッグストアなどに並ぶ日用品。私たちは、必要な商品がいつでも店頭にあることを、当たり前のように感じているかもしれません。しかし、商品は突然売場に現れるわけではありません。 https://t.co/07G3C7HSyP","id_str":"2108392019601375725","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":0,"retweet_count":18,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[850,860],"text":"あなたが支える物流"},{"indices":[861,872],"text":"トラック・物流Gメン"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDgzOTIwMTk1MzQxNTE2ODA=","text":"【あなたの行動が物流を支える｜第1回】\n\nスーパーやドラッグストアなどに並ぶ日用品。私たちは、必要な商品がいつでも店頭にあることを、当たり前のように感じているかもしれません。しかし、商品は突然売場に現れるわけではありません。\n\n商品は工場でつくられ、箱詰めされた後、倉庫や物流センターへ運ばれます。そこでは、行き先となる店舗や商品の種類ごとに保管・仕分けが行われ、必要な数量がトラックへ積み込まれます。そして店舗へ運ばれた商品は、搬入口やバックヤードを経て、ようやく私たちが目にする売場へ並びます。\n\nこの一連の流れには、工場で働く人、倉庫で商品を管理・仕分けする人、フォークリフトや台車を操作する人、トラックで商品を運ぶ人、店舗で商品を受け入れ、品出しをする人など、多くの人が関わっています。工場、倉庫、トラック、店舗のどこか一つでも流れが滞れば、必要な商品を必要な場所へ安定して届けることは難しくなります。\n\n物流は、私たちからは見えにくいところで、毎日の買い物と暮らしを支えています。いつも手に取っている商品が、どこでつくられ、どのような場所を経て、どれだけの人の手によって運ばれてきたのか。普段の買い物をきっかけに、商品の裏側にある物流へ少し目を向けてみませんか。\n\n例えば、店舗ごとに必要な商品の種類や数量は異なります。物流センターでは、限られた時間の中で多くの商品を正確に仕分け、積み間違いや破損を防ぎながら出荷する必要があります。トラックの運転者は、道路状況や店舗の受入れ時間を踏まえて商品を運び、店舗側も到着した商品を確認して売場へつなぎます。消費者が商品を選べる状態になるまで、各工程が連携しています。\n\nまた、物流を安定して維持するためには、運ぶ人や車両だけでなく、商品を一時的に保管する場所、荷役に使う設備、出荷や在庫を管理する仕組みも欠かせません。店舗の棚の向こう側には、こうした多くの仕事が積み重なっています。\n\n※本画像の内容は、生成AIにより作成・加工されています。\n\n#あなたが支える物流\n#トラック・物流Gメン"}}},"rest_id":"2108392019601375725","unmention_data":{},"views":{"count":"4472","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108392019601375725","sortIndex":"2108483978750066631"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":7},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1669644725908049922/31IO4zqt_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/3720424033/1647955077"},"core":{"created_at":"Tue Sep 29 00:54:57 +0000 2015","name":"出入国在留管理庁（Immigration Services Agency）","screen_name":"MOJ_IMMI"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozNzIwNDI0MDMz","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2104707734738514141"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"出入国在留管理庁(Immigration Services Agency)の公式Xアカウントです。皆様のお役に立つ情報を発信します。当アカウントへのリプライ等に対して個別の対応はいたしません。運用方針等はこちらです。→https://t.co/wZ7zE5al6a","entities":{"description":{"urls":[{"display_url":"moj.go.jp/isa/publicatio…","expanded_url":"https://www.moj.go.jp/isa/publications/publications","indices":[109,132],"url":"https://t.co/wZ7zE5al6a"}]},"url":{"urls":[{"display_url":"moj.go.jp/isa/index.html","