":195,"y":0},{"h":482,"w":842,"x":0,"y":0}],"height":482,"width":842},"sizes":{"large":{"h":482,"resize":"fit","w":842},"medium":{"h":482,"resize":"fit","w":842},"small":{"h":389,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/qA0L3NHEmQ"}]},"favorite_count":24,"favorited":false,"full_text":"「国民年金基金制度」のご案内発送に関するお知らせ \n\n#厚生労働省 と国民年金基金連合会 の連名で、国民年金にご加入の国民年金第1号被保険者及び任意加入被保険者の方に、「国民年金基金制度」についてのご案内が送付されております。\n\n#ねんきんネット https://t.co/qA0L3NHEmQ","id_str":"2097595871731065218","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":9,"retweeted":false,"user_id_str":"1828583837103968256"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[27,33],"text":"厚生労働省"},{"indices":[115,123],"text":"ねんきんネット"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"zenkoku-kikin.or.jp/about/","expanded_url":"https://zenkoku-kikin.or.jp/about/","indices":[285,308],"url":"https://t.co/akinZvg5Rb"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTc1OTU4NzEzNzg3Njc4NzI=","text":"「国民年金基金制度」のご案内発送に関するお知らせ \n\n#厚生労働省 と国民年金基金連合会 の連名で、国民年金にご加入の国民年金第1号被保険者及び任意加入被保険者の方に、「国民年金基金制度」についてのご案内が送付されております。\n\n#ねんきんネット の案内もございますので、ご自身の年金見込額の確認などにご利用ください。\n\n国民年金基金は、自営業者など国民年金の第1号被保険者の方々の多様化するニーズに応え、より豊かな老後を過ごすことができるよう、国民年金（老齢基礎年金）に上乗せした年金を受け取るための公的な年金制度です。  \n\n国民年金基金について詳しくはこちら↓↓\nhttps://t.co/akinZvg5Rb"}}},"rest_id":"2097595871731065218","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"11217","state":"EnabledWithCount"}}},"user_id_str":"180585090"},"rest_id":"2097612533964460036","source":"<a href=\"https://social.userlocal.jp/\" rel=\"nofollow\">Userlocal SocialInsight</a>","unmention_data":{},"views":{"count":"2027","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097612533964460036","sortIndex":"2097695749042077680"},{"content":{"__typen