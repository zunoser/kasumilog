ど。災害復旧工事の現場の状況や作業内容に応じた安全対策を確認し、労働災害を防止しましょう。ヘルメットと作業内容を確認するリストのイラストが描かれている。無理をせず、「安全第一」で作業を進めましょう。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097495830815244288","indices":[125,148],"media_key":"3_2097495830815244288","media_results":{"result":{"media_key":"3_2097495830815244288"}},"media_url_https":"https://pbs.twimg.com/media/HRvNWFmbAAA_Q5V.jpg","original_info":{"focus_rects":[{"h":546,"w":975,"x":0,"y":358},{"h":975,"w":975,"x":0,"y":123},{"h":1098,"w":963,"x":6,"y":0},{"h":1098,"w":549,"x":213,"y":0},{"h":1098,"w":975,"x":0,"y":0}],"height":1098,"width":975},"sizes":{"large":{"h":1098,"resize":"fit","w":975},"medium":{"h":1098,"resize":"fit","w":975},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/b0o4Is1AMX"}],"urls":[{"display_url":"mhlw.go.jp/stf/seisakunit…","expanded_url":"https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/0000121431_00494.html","indices":[90,113],"url":"https://t.co/73U7Dwac9a"}],"user_mentions":[{"id_str":"180585090","indices":[114,124],"name":"厚生労働省","screen_name":"MHLWitter"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/b0o4Is1AMX","expanded_url":"https://x.com/gov_online/status/2097497718834806978/photo/1","ext_alt_text":"上部に「災害復旧工事は「安全第一」で行いましょう。」と記載されており、その下には、次のように記載されている。暑い中での作業による熱中症の発症。がれき処理や解体作業時の建設機械による事故。アスベストを吸い込むことによる健康障害　など。災害復旧工事の現場の状況や作業内容に応じた安全対策を確認し、労働災害を防止しましょう。ヘルメットと作業内容を確認するリストのイラストが描かれている。無理をせず、「安全第一」で作業を進めましょう。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097495830815244288","indices":[125,148],"media_key":"3_2097495830815244288","media_results":{"result":{"media_key":"3_2097495830815244288"}},"media_url_https":"https://pbs.twimg.com/media/HRvNWFmbAAA_Q5V.jpg","original_info":{"focus_rects":[{"h":546,"w":975,"x