state":"EnabledWithCount"}}}}},"entryId":"tweet-2090372552652955982","sortIndex":"2090725421594181544"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2971480,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":516,"tweets":1712},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2090371261730066715"],"editable_until_msecs":"1787221920000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":139,"bookmarked":false,"conversation_id_str":"2090371261730066715","created_at":"Thu Aug 20 09:32:00 +0000 2026","display_text_range":[0,95],"entities":{"user_mentions":[{"id_str":"143779403","indices":[26,38],"name":"Andy Burnham","screen_name":"andyburnham"}]},"favorite_count":16326,"favorited":false,"full_text":"先ほど、16時から、先月就任された英国のバーナム首相@andyburnhamとの間で、初めてとなる電話会談を行いました。\n\n私からは、バーナム首相の就任について改めてお祝いを申し上げました。","id_str":"2090371261730066715","is_quote_status":false,"lang":"ja","quote_count":180,"reply_count":1188,"retweet_count":1497,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"143779403","indices":[26,38],"name":"Andy Burnham","screen_name":"andyburnham"}]},"id":"Tm90ZVR3ZWV0OjIwOTAzNzEyNjE2NzEzNjI1NjA=","richtext":{"richtext_tags":[]},"text":"先ほど、16時から、先月就任された英国のバーナム首相@andyburnhamとの間で、初めてとなる電話会談を行いました。\n\n私からは、バーナム首相の就任について改めてお祝いを申し上げました。\n\n私自身、「日英関係の重要性」を強く認識しており、バーナム首相と共に、日英関係を更なる高みに引き上げ、国際社会の平和と安定の実現のため緊密に連携していきたい旨お伝えしました。\n\nまた、バーナム首相とは\n・「欧州・大西洋とインド太平洋の安全保障は不可分である」との認識を共有し、\n・ＧＣＡＰを含む「安全保障分野」や、\n・「先端技術」や「経済安全保障分野」での協力を\n引き続き推進していくことで一致しました。\n\nさらに、バーナム首相からは、「日英関係を、一層緊密にしていきたい」旨のご発言がありました。\n\n今後も、バーナム首相と共に「強化されたグローバルな戦略的パートナー」である英国との間で、緊密に連携していきたいと考えています。"}}},"rest_id":"2090371261730066715","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"535400","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090371261730066715","sortIndex":"2090725421594181543"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2082019689023345122"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":381633,"following":477},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":fa