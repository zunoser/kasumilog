dices":[318,323],"text":"損害保険"},{"indices":[324,329],"text":"火災保険"},{"indices":[330,336],"text":"自動車保険"},{"indices":[337,342],"text":"傷害保険"},{"indices":[343,351],"text":"消費者トラブル"},{"indices":[352,359],"text":"災害便乗商法"},{"indices":[360,365],"text":"損保協会"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"sonpo.or.jp/news/notice/20…","expanded_url":"https://www.sonpo.or.jp/news/notice/2026/2608_002.html","indices":[238,261],"url":"https://t.co/6hI8Y0MloI"},{"display_url":"sonpo.or.jp/news/caution/s…","expanded_url":"https://www.sonpo.or.jp/news/caution/syuri.html","indices":[272,295],"url":"https://t.co/hQzXO9UHNM"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTA1ODM4MDgzNTc4NzE2MTY=","richtext":{"richtext_tags":[]},"text":"＜令和8年7月17日から18日にかけての大雨に伴うにより被害を受けられた皆様へ＞\n#災害救助法 が適用された地域でご契約者が被害を受けられた等の場合、各種損害保険について特別措置を実施することとしています。また、#自然災害 の後には、住宅修理などに関し、「保険が使える」と言って勧誘する業者とのトラブルが増加する傾向にあります。このような勧誘を受けた場合は、まずはご加入の「損害保険会社」または「損害保険代理店」にご相談ください。 詳細は以下からご覧ください。\n【特別措置等】https://t.co/6hI8Y0MloI\n【業者とのトラブル】https://t.co/hQzXO9UHNM\n\n#大雨 #自然災害 #栃木県 #相談窓口 #損害保険 #火災保険 #自動車保険 #傷害保険 #消費者トラブル #災害便乗商法 #損保協会"}}},"rest_id":"2090583808483725411","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2461","state":"EnabledWithCount"}}}},"user_id_str":"276848601"},"rest_id":"2090594564566602044","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"650","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2090594564566602044","sortIndex":"2090725421594181566"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"c