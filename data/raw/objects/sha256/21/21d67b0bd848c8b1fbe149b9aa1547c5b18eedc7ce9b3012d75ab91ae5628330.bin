2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":75.17,"rgb":{"blue":255,"green":255,"red":255}},{"percentage":14.68,"rgb":{"blue":160,"green":0,"red":0}},{"percentage":6.18,"rgb":{"blue":4,"green":4,"red":4}},{"percentage":2.24,"rgb":{"blue":196,"green":119,"red":120}},{"percentage":0.44,"rgb":{"blue":208,"green":154,"red":153}}]},"type":"IMAGE_COLOR"}},{"key":"title","value":{"string_value":"「外務省人材戦略」の策定について","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/4wYEBy8qwl","type":"STRING"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary","url":"https://t.co/4wYEBy8qwl","user_refs_results":[]},"rest_id":"https://t.co/4wYEBy8qwl"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2090628972732387328"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.