ollowers":150488,"following":179},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8500,"tweets":19389},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2090700280153391479"],"editable_until_msecs":"1787300364000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":true,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2090700280153391479","created_at":"Fri Aug 21 07:19:24 +0000 2026","display_text_range":[0,238],"entities":{"media":[{"display_url":"pic.x.com/b2S8nv0vbx","expanded_url":"https://x.com/MofaJapan_en/status/2090700280153391479/photo/1","ext_alt_text":"Appointment of Mr. NISHIOKA Tatsushi, Minister at the Embassy of Japan in the Republic of Korea, as the Secretary-General of the Trilateral Cooperation Secretariat\n (Statement by Press Secretary KITAMURA Toshihiro)\n \n1.    Effective September 1, Mr. NISHIOKA Tatsushi, Minister, Embassy of Japan in the Republic of Korea, will assume the post of the Secretary-General of the Trilateral Cooperation Secretariat (TCS), located in Seoul, the Republic of Korea.\n\n2.    The Government of Japan expects the new Secretary-General to contribute to the further development of trilateral cooperation as head of the TCS, an international organization comprising Japan, China, and the Republic of Korea.\n\n3.    The Government of Japan also highly appreciates the work of the incumbent Secretary-General LEE Hee-sup, who has served in this role for the past three years, and expresses its gratitude for his contributions to promoting trilateral cooperation among Japan, China, and the Republic of Korea.","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2090700166588452864","indices":[239,262],"media_key":"3_2090700166588452864","media_results":{"result":{"media_key":"3_2090700166588452864"}},"media_url_https":"https://pbs.twimg.com/media/HQOouXla0AAU5rq.png","original_info":{"focus_rects":[{"h":344,"w":614,"x":0,"y":39},{"h":614,"w":614,"x":0,"y":0},{"h":700,"w":614,"x":0,"y":0},{"h":768,"w":384,"x":0,"y":0},{"h":768,"w":614,"x":0,"y":0}],"height":768,"width":614},"sizes":{"large":{"h":768,"resize":"fit","w":614},"medium":{"h":768,"resize":"fit","w":614},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/b2S8nv0vbx"}],"urls":[{"display_url":"mofa.go.jp/press/statemen…","expanded_url":"https://www.mofa.go.jp/press/statement/pageite_000001_00010.html","indices":[215,238],"url":"https://t.co/5YLMBKhy0O"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/b2S8nv0vbx","expanded_url":"https://x.com/MofaJapan_en/status/2090700280153391479/photo/1","ext_alt_text":"Appointment of Mr. NISHIOKA Tatsushi, Minister at the Embassy of Japan in the Republic of Korea, as the Secretary-General of the Trilateral Cooperation Secretariat\n (Statement by Press Secretary KITAMURA Toshihiro)\n \n1.    Effective September 1, Mr. NISHIOKA Tatsushi, Minister, Embassy of Japan in the Republic of Korea, will assume the post of the Secretary-General of the Trilateral Cooperation Secretariat (TCS), located in Seoul, the Republic of Korea.\n\n2.    The Government of Japan expects the new Secretary-General to contribute to the further development of trilateral cooperation as head of the TCS, an international organization comprising Japan, China, and the Republic of Korea.\n\n3.    The Government of Japan also highly appreciates the work of the incumbent Secretary-General LEE Hee-sup, who has served in t