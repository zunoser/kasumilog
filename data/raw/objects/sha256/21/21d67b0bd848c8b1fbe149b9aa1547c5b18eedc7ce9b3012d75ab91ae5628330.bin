_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2090353867284443576","url":"https://t.co/m8soAUiOBQ"},"reply_count":9,"retweet_count":307,"retweeted":false,"user_id_str":"268732024"},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2090353867284443576"}},"rest_id":"2090355781812326586","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"237098","state":"EnabledWithCount"}}},"rest_id":"2090377361741226488","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"214674","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090377361741226488","sortIndex":"2090725421594181549"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2090725421594181716-tweet-2090376948073840720","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":false,"location":{"loc