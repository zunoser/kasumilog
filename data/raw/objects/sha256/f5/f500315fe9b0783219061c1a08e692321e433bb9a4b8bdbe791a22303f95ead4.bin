23,"w":23,"x":531,"y":169},{"h":25,"w":25,"x":268,"y":175},{"h":25,"w":25,"x":186,"y":177},{"h":23,"w":23,"x":593,"y":185},{"h":30,"w":30,"x":424,"y":229}]}},"id_str":"2107391864110465025","indices":[62,85],"media_key":"3_2107391864110465025","media_results":{"result":{"media_key":"3_2107391864110465025"}},"media_url_https":"https://pbs.twimg.com/media/HT71vCbaQAEeVxQ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":282,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EtGKkX36Sm"}]},"favorite_count":9818,"favorited":false,"full_text":"本日午後、日豪経済委員会及び豪日経済委員会の皆様が官邸にお越し下さり、日本とオーストラリアの経済関係について議論しました。 https://t.co/EtGKkX36Sm","id_str":"2107391998487388512","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":46,"reply_count":342,"retweet_count":993,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDczOTE5OTg0MjQ0ODU4ODg=","richtext":{"richtext_tags":[]},"text":"本日午後、日豪経済委員会及び豪日経済委員会の皆様が官邸にお越し下さり、日本とオーストラリアの経済関係について議論しました。\n\n日豪経済委員会の広瀬委員長と豪日経済委員会のグレイ委員長から、10月4日から6日にかけて千葉・幕張で開催された第63回日豪経済会議の共同声明を手交いただくとともに、会議の結果について御報告いただき、両委員会の今後の取組についても御説明いただきました。\n\n私からは、両委員会の日豪経済関係強化への貢献や今般退任されるグレイ委員長のこれまでの尽力に謝意をお伝えし、本年が日豪友好協力基本条約（通常「NARA条約」）の署名50周年であることに触れつつ、次の50年を見据え、日豪関係の更なる発展に向けて両委員会の協力に期待する旨を申し上げました。\n\n官民を挙げて、日本とオーストラリアの「特別な戦略的パートナーシップ」を新たな次元に引き上げていきます。"}}},"rest_id":"2107391998487388512","unmention_data":{},"views":{"count":"258098","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107391998487388512","sortIndex":"2107870879940607882"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":21},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/281874178/1611288198"},"core":{"created_at":"Thu Apr 14 04:13:40 +0000 2011","name":"特許庁","screen_name":"jpo_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODE4NzQxNzg=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関3-4-3"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"特許庁の公式アカウントです。特許庁ホームページの主な更新情報等に関する情報を提供します。運用方針は以下をご覧ください。https://t.co/7eNLi8gZcH　\n公的機関との間でのリプライやリツイートについて試行中です。","entities":{"description":{"urls":[{"display_url":"meti.go.jp/sns/sns_policy…","expanded_url":"https://www.meti.go.jp/sns/sns_policy.html","indices":[59,82],"url":"https://t.co/7eNLi8gZcH"}]},"url":{"urls":[{"display_url":"jpo.go.jp/index.html","expanded_url":"https://www.jpo.go.jp/index.html","indices":[0,23],"url":"https://t.co/cA9C0Xybbq"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":111118,"following":39},"relationship_perspectives":{"blocked_by":false,"blocki