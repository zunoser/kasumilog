ight":1654,"width":2339},"sizes":{"large":{"h":1448,"resize":"fit","w":2048},"medium":{"h":849,"resize":"fit","w":1200},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/1kaYf730fR"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/1kaYf730fR","expanded_url":"https://x.com/takaichi_sanae/status/2107396341098029455/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":184,"w":184,"x":274,"y":336},{"h":568,"w":568,"x":182,"y":478}]},"medium":{"faces":[{"h":107,"w":107,"x":160,"y":196},{"h":332,"w":332,"x":106,"y":280}]},"orig":{"faces":[{"h":368,"w":368,"x":548,"y":672},{"h":1136,"w":1136,"x":364,"y":956}]},"small":{"faces":[{"h":61,"w":61,"x":90,"y":111},{"h":188,"w":188,"x":60,"y":158}]}},"id_str":"2107395256740356096","indices":[109,132],"media_key":"3_2107395256740356096","media_results":{"result":{"media_key":"3_2107395256740356096"}},"media_url_https":"https://pbs.twimg.com/media/HT740g9aIAA-0lK.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2889,"w":2889,"x":499,"y":0},{"h":2889,"w":2534,"x":676,"y":0},{"h":2889,"w":1445,"x":1221,"y":0},{"h":2889,"w":4096,"x":0,"y":0}],"height":2889,"width":4096},"sizes":{"large":{"h":1445,"resize":"fit","w":2048},"medium":{"h":846,"resize":"fit","w":1200},"small":{"h":480,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/1kaYf730fR"}]},"favorite_count":10141,"favorited":false,"full_text":"近年、大雨が頻発化・激甚化しており、本年8月の千葉豪雨では、国道16号等のアンダーパスの冠水により2名がお亡くなりになりました。\nまた先月も、福島県いわき市の冠水した市道のアンダーパスで1名がお亡くなりになりました。 https://t.co/1kaYf730fR","id_str":"2107396341098029455","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":145,"reply_count":1110,"retweet_count":1267,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDczOTYzNDEwMTQxODM5MzY=","richtext":{"richtext_tags":[]},"text":"近年、大雨が頻発化・激甚化しており、本年8月の千葉豪雨では、国道16号等のアンダーパスの冠水により2名がお亡くなりになりました。\nまた先月も、福島県いわき市の冠水した市道のアンダーパスで1名がお亡くなりになりました。\n\n改めて、お亡くなりになられた方々に哀悼の誠を捧げますとともに、被災された方々に心からお見舞いを申し上げます。\n\n｢アンダーパスの冠水対策｣については、関係閣僚会議において、私から取組を進めるよう指示していましたが、本日、国土交通省が『アンダーパスにおける冠水事故防止に向けたガイドライン』を策定・公表しましたので、その概要をご報告します。\n\n本『ガイドライン』では、アンダーパスの｢冠水リスク｣に応じた｢通行規制｣や｢車両進入防止対策｣などの基本的な考え方を、初めて、体系的に整理しました。\n\n具体的には、｢冠水リスク｣の程度に応じて、\n・予防的な事前規制を含む「通行規制」、遮断機などによる「車両進入防止対策」、排水ポンプなどによる「排水機能の確保」などを組み合わせた「多重防御」の態勢をとること、\n・その前提として、停電や設備故障、通信障害等により、設備の一部が正常に機能しない場合でも、安全側に移行できるよう、「フェールセーフ」（致命的な状態になることを回避できるような配慮を行う）の考え方に基づき、設備及び運用の両面から各種対策を講じること、\nを基本的な考え方としています。\n\nまた、今回の取組を単なる『ガイドライン』の策定で終わらせるのではなく、「冠水事故防止対策」を計画的かつ着実に推進するため、国として、地方自治体とも連携しつつ、『アンダーパス冠水事故防止対策推進計画』を策定し、早期に対応可能なもの、リスクの高いものなど優先順位付けをするなどの全国的な対策の方針を定めることも併せて盛り込んでいます。\n\nアンダーパスでの類似事故の再発防止に向けて、政府一丸となって取組を進めてまいります。"}}},"rest_id":"2107396341098029455","unmention_data":{},"views":{"count":"319990","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107396341098029455","sortIndex":"2107870879940607884"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissio