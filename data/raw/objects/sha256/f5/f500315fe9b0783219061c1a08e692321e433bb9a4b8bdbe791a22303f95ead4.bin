},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/CKdGNPhpJw"}],"user_mentions":[{"id_str":"1875267238309351424","indices":[30,45],"name":"Senator Dave McCormick","screen_name":"SenMcCormickPA"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/CKdGNPhpJw","expanded_url":"https://x.com/ModJapan_jp/status/2107437678245646573/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":208,"w":208,"x":1360,"y":368}]},"medium":{"faces":[{"h":121,"w":121,"x":796,"y":215}]},"orig":{"faces":[{"h":208,"w":208,"x":1360,"y":368}]},"small":{"faces":[{"h":69,"w":69,"x":451,"y":122}]}},"id_str":"2107437669831847936","indices":[121,144],"media_key":"3_2107437669831847936","media_results":{"result":{"media_key":"3_2107437669831847936"}},"media_url_https":"https://pbs.twimg.com/media/HT8fZSCasAAZm92.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":682,"y":0},{"h":1366,"w":1198,"x":850,"y":0},{"h":1366,"w":683,"x":1143,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/CKdGNPhpJw"}]},"favorite_count":1016,"favorited":false,"full_text":"10月6日、小泉防衛大臣は、アメリカよりマコーミック上院議員@SenMcCormickPAの表敬訪問を受けました。小泉大臣はマコーミック上院議員の来訪を歓迎し、日米関係をさらに飛躍させ、世界で最も偉大な同盟をより強化していく旨を述べました。 https://t.co/CKdGNPhpJw","id_str":"2107437678245646573","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":15,"retweet_count":147,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[{"id_str":"1875267238309351424","indices":[30,45],"name":"Senator Dave McCormick","screen_name":"SenMcCormickPA"}]},"id":"Tm90ZVR3ZWV0OjIxMDc0Mzc2NzgxNzg1NDk3NjE=","text":"10月6日、小泉防衛大臣は、アメリカよりマコーミック上院議員@SenMcCormickPAの表敬訪問を受けました。小泉大臣はマコーミック上院議員の来訪を歓迎し、日米関係をさらに飛躍させ、世界で最も偉大な同盟をより強化していく旨を述べました。\nまた、沖縄県那覇市で発生した強盗殺人事件に関し、日本政府として、米側に対し強く抗議するとともに、捜査への全面的な協力、米軍関係者の綱紀粛正と、事件・事故の再発防止の徹底とご遺族に対する適切な対応を強く求めていることを伝えました。"}}},"rest_id":"2107437678245646573","unmention_data":{},"views":{"count":"50318","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107437678245646573","sortIndex":"2107870879940607904"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2107427156913688576/ycpAOyzA?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66594","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2107427156913688576/ycpAOyzA?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"Enjoy the videos and music you love, upload original content, and share it all with friends, family, and the world on YouTube.","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2107427156913688576/ycpAOyzA?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"im