h":1733,"w":1520,"x":865,"y":0},{"h":1733,"w":867,"x":1192,"y":0},{"h":1733,"w":2600,"x":0,"y":0}],"height":1733,"width":2600},"sizes":{"large":{"h":1365,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/tBssVvukzp"}]},"favorite_count":20998,"favorited":false,"full_text":"本日、第222回国会（臨時国会）が開会し、衆議院・参議院両院の本会議で、所信表明演説を行いました。\n\n「志ある者は、事竟に成る。」\n\n高市内閣は、「経世済民」の志を貫き、時代の変化から決して目を背けることなく、必要な政策については躊躇なく決断し、果敢に挑戦してまいります。 https://t.co/tBssVvukzp","id_str":"2107048477926859243","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":549,"reply_count":2792,"retweet_count":2975,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1005shoshinhyomei.html","indices":[451,474],"url":"https://t.co/GQ8cNzAmWd"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDcwNDg0Nzc3ODQxODI3ODQ=","richtext":{"richtext_tags":[]},"text":"本日、第222回国会（臨時国会）が開会し、衆議院・参議院両院の本会議で、所信表明演説を行いました。\n\n「志ある者は、事竟に成る。」\n\n高市内閣は、「経世済民」の志を貫き、時代の変化から決して目を背けることなく、必要な政策については躊躇なく決断し、果敢に挑戦してまいります。\n\nそして、決断したことを、決めただけで終わらせることはありません。\n\n挑戦を政策に、政策を成果に変え、その成果が全国津々浦々に行き渡るまで、責任を持って「実行」してまいります。\n\n「日本列島を、強く豊かに。」\n\n日本列島の隅々まで活発な経済活動が行き渡り、国民の皆様お一人おひとりが安心して安全に暮らせる、そして希望を持って前進できる国を築いてまいります。\n\nそして、より強く、より豊かで、誇り高い日本を、次の世代へ引き継ぐ。その使命のために、歩みを止めることはありません。\n\n「決断、挑戦、実行。」、「決断、挑戦、実行。」\n\n国民の皆様に実感いただける確かな成果を、積み重ねてまいります。\n\n（参考）所信表明演説（官邸HP）\nhttps://t.co/GQ8cNzAmWd"}}},"rest_id":"2107048477926859243","unmention_data":{},"views":{"count":"897129","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107048477926859243","sortIndex":"2107870879940607810"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHUCpZbdAJrEKAAIdPx9nFhsQ7QgAAwAAAAEAAA"},"entryId":"cursor-top-2107870879940607905","sortIndex":"2107870879940607905"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHUCpZbc__z8KAAIdPb1tU1uh6wgAAwAAAAIAAA"},"entryId":"cursor-bottom-2107870879940607809","sortIndex":"2107870879940607809"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}