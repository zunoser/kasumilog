settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府共生・共助担当の公式アカウントです。\n内閣府政策統括官（共生・共助担当）が管理・運営しております。\n運用方針（https://t.co/nSooMa6Gc5）を御確認のうえ御利用ください。","entities":{"description":{"urls":[{"display_url":"www8.cao.go.jp/souki/sns/x.ht…","expanded_url":"https://www8.cao.go.jp/souki/sns/x.html","indices":[58,81],"url":"https://t.co/nSooMa6Gc5"}]},"url":{"urls":[{"display_url":"www8.cao.go.jp/souki/index.ht…","expanded_url":"https://www8.cao.go.jp/souki/index.html","indices":[0,23],"url":"https://t.co/wBzrJ8ehrX"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1116,"following":12},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1853694958383050752","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":144,"tweets":340},"verification":{"verified":false},"website":{"url":"https://t.co/wBzrJ8ehrX"}}}},"edit_control":{"edit_tweet_ids":["2107379998663516510"],"editable_until_msecs":"1791277119000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"kyoseikyojo_cao"}}},"policy":"ByInvitation"},"conversation_id_str":"2079419560898470328","created_at":"Tue Oct 06 07:58:39 +0000 2026","display_text_range":[0,161],"entities":{"hashtags":[{"indices":[145,151],"text":"ともフェス"},{"indices":[152,156],"text":"内閣府"},{"indices":[157,161],"text":"丸の内"}],"media":[{"display_url":"pic.x.com/jAyfEFqeWE","expanded_url":"https://x.com/kyoseikyojo_cao/status/2107379998663516510/photo/1","ext_alt_text":"キャッチコピー「出会う、ふれあう、未来がかわる」を掲げた、障害の有無にかかわらず、こどもから大人まで、誰もが、一緒に楽しみ、交流できるインクルーシブイベント「ともともフェスタ2026（Tomotomo Festa 2026）」の告知ポスターです。開催日時は2026年10月9日(金)11:00〜19:00（行幸通りは17:00まで）及び10日(土)11:00〜17:00、入場無料です。会場は東京駅丸の内口 行幸通り及び丸ビル1階マルキューブを予定しており、音楽ステージ・体験型ワークショップ・展示などの楽しいコンテンツやみんなで遊べる遊具もあります。行幸通りは、東京都千代田区丸の内２丁目２番地、各線「東京駅」丸の内中央口より徒歩１分、東京メトロ千代田線「二重橋前駅」より徒歩3分です。丸ビルは東京都千代田区丸の内２丁目４番地１号、各線「東京駅」から地下で直結、徒歩４分、東京メトロ千代田線「二重橋前駅」より徒歩４分です。主催：内閣府・ともともフェスタ2026実行委員会、協力：東京法務局・全国人権擁護委員連合会・東京都人権擁護委員連合会・株式会社アイシン・味の素株式会社・錦城護謨株式会社・株式会社講談社・タカオ株式会社・株式会社乃村工藝社　未来創造研究所・株式会社毎日新聞社、後援：こども家庭庁・法務省・文部科学省・厚生労働省・国土交通省・東京都・鳥取県・千代田区。特設WEBサイト: https://www.tomotomo.go.jp/festa2026/。バリアフリー情報や出展・出演・イベント情報は特設ホームページを御覧ください。イベントへのお問い合わせは、ともともフェスタ2026運営事務局 info@tomotomo.go.jp ,03-5730-3157までお寄せください。受付時間は平日10時から17時（土日祝日、年末年始は除く）です。ポスターには、車いすユーザー・白杖ユーザーを含む多様な年齢・背景の人々のイラストが描かれています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2107376670776926208","indices":[162,185],"media_key":"3_2107376670776926208","media_results":{"result":{"media_key":"3_2107376670776926208"}},"media_url_https":"https://pbs.twimg.com/media/HT7n6q2aoAArFJh.jpg","original_info":{"focus_rects":[{"h":496,"w":885,"x":0,"y":0},{"h":885,"w":885,"x":0,"y":0},{"h":1009,"w":885,"x":0,"y":0},{"h":1250,"w":625,"x":260,"y":0},{"h":1250,"w":885,"x":0,"y":0}],"height":1250,"width":885},"sizes":{"large":{"h":1250,"resize":"fit","w":885},"medium":{"h":1200,"resize":"fit","w":850},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/jAyfEFqeWE"}],"urls":[{"display_url":"tomotomo.go.jp/festa2026/","expanded_url":"https://www.tomotomo.go.jp/festa2026/","indices":[99,122],"url":"https://t.co/2PqoY3CFFI"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/jAyfEFqeWE","expanded_url":"htt