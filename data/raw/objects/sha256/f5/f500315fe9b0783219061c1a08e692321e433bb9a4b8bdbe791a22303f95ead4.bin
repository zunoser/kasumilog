st_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39965,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":96,"tweets":409},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2107353327008895184"],"editable_until_msecs":"1791270760000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":5,"bookmarked":false,"conversation_id_str":"2107353327008895184","created_at":"Tue Oct 06 06:12:40 +0000 2026","display_text_range":[0,136],"entities":{},"favorite_count":590,"favorited":false,"full_text":"【10月6日　小泉防衛大臣会見】\n\n冒頭、米軍再編に係る嘉手納飛行場から築城基地への訓練移転について発表しました。\n \nその他、\n○北朝鮮による弾道ミサイルの発射\n○アメリカ軍人等による事件・事故\n○現地情報隊\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら","id_str":"2107353327008895184","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":12,"retweet_count":84,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/OMYDAtK1bHI?si…","expanded_url":"https://youtu.be/OMYDAtK1bHI?si=La2fmQEYffUESRqC","indices":[522,545],"url":"https://t.co/cIJOJJbdCf"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDczNTMzMjY4Nzg5MDg0MTY=","text":"【10月6日　小泉防衛大臣会見】\n\n冒頭、米軍再編に係る嘉手納飛行場から築城基地への訓練移転について発表しました。\n \nその他、\n○北朝鮮による弾道ミサイルの発射\n○アメリカ軍人等による事件・事故\n○現地情報隊\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「今日は冒頭１件あります。昨日、１０月１９日から２９日までの間、アメリカ空軍嘉手納飛行場から航空自衛隊築城基地への航空機訓練移転を実施することを公表しました。今回の訓練移転は、嘉手納飛行場で実施される訓練活動の一部を沖縄県外に移転して実施することで、その間の嘉手納飛行場における訓練活動の影響を軽減するものであり、沖縄の基地負担の軽減に資するものです。戦後８０年以上を経た今もなお、沖縄の皆様には大きな基地負担を担っていただいていることを重く受け止めています。防衛省としては、今後とも基地負担軽減策を一つ一つ着実に実施してまいります。同時に、訓練を受け入れていただく築城基地周辺の皆様の御理解と御協力が重要であり、訓練の実施に当たっては、安全確保に万全を期すとともに、地域に与える影響が最小限となるよう努めてまいります。今日は冒頭、以上１件です。」\n \n↓動画はこちら\nhttps://t.co/cIJOJJbdCf"}}},"rest_id":"2107353327008895184","unmention_data":{},"views":{"count":"35624","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2107353479513833744","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4825","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107353479513833744","sortIndex":"2107870879940607856"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs