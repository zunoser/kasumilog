d_str":"2107384822654206116","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":166,"reply_count":758,"retweet_count":2229,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDczODQ4MjI1Nzg3NjE3Mjg=","richtext":{"richtext_tags":[]},"text":"本日は、\n「北朝鮮に拉致された日本人を早期に救出するために行動する議員連盟」（拉致議連）、\n「北朝鮮による拉致被害者家族連絡会」（家族会）、\n「北朝鮮に拉致された日本人を救出するための全国協議会」（救う会）\nの3団体の皆様が官邸にお越し下さり、先月に米国を訪問された際のお話を伺いました。\n\n訪米中は、米国の政府高官、連邦議会議員、有識者など多数の方々と面会され、「拉致問題」の解決に対する切実な思いを直接お伝えいただき、理解と支持を明確に表明いただいたことなどについて、ご説明をいただきました。\n\n3団体の皆様のお取組に心から敬意を表するとともに、訪米結果について直接お話を伺う機会を頂きましたことに感謝を申し上げました。\n\n私自身も、同じ時期に、ニューヨークを訪問し、トランプ大統領と首脳会談を行い、「拉致問題」の即時解決について強い支持をいただきました。\n\nまた、「国連総会一般討論演説」では、\n・「拉致問題」が現在進行形の問題であり、人命に関わる問題であること、\n・この問題を一刻も早く解決すべきこと、\n・そして、日朝双方の未来のためにも、「日朝平壌宣言」に基づき、互いに実りある関係を作るべく、対話し、具体的に行動する用意があること\nを訴えました。\n\n各国首脳の来日、国際会議の場での二国間会談などの際にも、必ず「拉致問題」を取り上げ、ご理解をいただいています。\n\nちょうど昨日（10月5日）は、横田めぐみさんの62歳のお誕生日でした。\n\n拉致被害者のご帰国には、あまりに長い時間がかかっており、これ以上時間をかけるわけにはいきません。\n\n拉致被害者の方々に一日も早く祖国の土を踏んでいただけるよう、私の代で何としても突破口を開き、「拉致問題」を解決すべく、木原官房長官と力を合わせて、様々なルートでの働きかけを続けるとともに、国際社会とも緊密に連携して取組を続けてまいります。"}}},"rest_id":"2107384822654206116","unmention_data":{},"views":{"count":"375431","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107384822654206116","sortIndex":"2107870879940607878"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label