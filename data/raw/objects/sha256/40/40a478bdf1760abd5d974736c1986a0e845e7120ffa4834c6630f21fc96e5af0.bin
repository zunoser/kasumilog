}]},"medium":{"faces":[{"h":87,"w":87,"x":1024,"y":109}]},"orig":{"faces":[{"h":190,"w":190,"x":2219,"y":238}]},"small":{"faces":[{"h":49,"w":49,"x":580,"y":62}]}},"id_str":"2105247444468674560","indices":[133,156],"media_key":"3_2105247444468674560","media_results":{"result":{"media_key":"3_2105247444468674560"}},"media_url_https":"https://pbs.twimg.com/media/HTdXZYvasAARg8u.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1452,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/9sXDzywL8u"}]},"favorite_count":4177,"favorited":false,"full_text":"本日、｢第二次高市改造内閣｣初の経済財政諮問会議を開催しました。\n\n「令和９年度予算編成と今後の経済財政運営」及び｢物価や金利環境の変化を踏まえた今後のマクロ経済運営」について、意見交換を行いました。\n\nまず、「令和９年度予算編成と今後の経済財政運営」については、 https://t.co/9sXDzywL8u","id_str":"2105247477146460184","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":39,"reply_count":193,"retweet_count":499,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDUyNDc0NzcwMzc0MTY0NDk=","richtext":{"richtext_tags":[]},"text":"本日、｢第二次高市改造内閣｣初の経済財政諮問会議を開催しました。\n\n「令和９年度予算編成と今後の経済財政運営」及び｢物価や金利環境の変化を踏まえた今後のマクロ経済運営」について、意見交換を行いました。\n\nまず、「令和９年度予算編成と今後の経済財政運営」については、\n・令和９年度予算が「責任ある積極財政元年」にふさわしい予算となるよう、『「強く豊かな日本」投資枠』の在り方、「複数年度での予算管理の在り方」、「補正予算から脱却する方針」などを具体化すること、\n・『予算編成の基本方針』、『政府経済見通し』、『中長期試算』、｢多角的な分析・検証」、｢政策の点検・見直し｣を｢経済財政運営の一連のサイクル｣として、来年度以降も具体化・定着させていくこと、\n・令和９年度予算の在り方を議論するに当たっては、｢足下の税収実績｣､｢名目成長率｣､｢企業収益｣等の動向を十分に分析し、より的確な｢税収見積もり｣とすること､\nといった議論が行われました。\n\nまた、「物価や金利環境の変化を踏まえた今後のマクロ経済運営」については、\n・世界的に｢原油価格高騰｣によるインフレが加速する中、官民で長期資金への需要が高まり、長期金利も上昇傾向にあること、\n・我が国も、こうした世界経済の動きの中にあること、\n・金利上昇は、様々な要因によって変動しており、｢家計｣｢企業｣｢財政｣への影響を丁寧にみていく必要があること､\n・そのためにも、政府と日本銀行は経済・物価情勢について認識を共有し、緊密に連携していくこと、\n・また、｢住宅ローン減税｣を始め、既に実施している各施策が活用されるよう、積極的な周知を行うことや、\n・｢中所得｣・｢低所得｣世帯の負担増に対応する観点から、｢飲食料品に係る消費税率の引下げ｣や、その後の｢就業者負担軽減支援金｣の導入を着実に進めること、\nなどの様々なご提案をいただきました。\n\n高市内閣は、｢物価上昇｣と｢金利｣のある経済の下、｢国内投資｣や｢生産性向上｣を通じて供給力を強化し、｢強い経済」を実現します。\n\nそのためにも、年末までの経済財政諮問会議において、令和９年度予算編成を含め、『骨太方針2026』で示した｢責任ある積極財政｣の下での「強い経済」の実現と｢財政の持続可能性の確保｣を両立する｢経済財政運営の道筋｣をより一層明らかにします。\n\n具体的には、\n・『「強く豊かな日本」投資枠』や｢複数年度の予算管理｣、｢補正予算への依存から脱却する方針｣を具体化するとともに､\n・税収動向等をより的確に見極めつつ、歳入・歳出両面の見直しを進めることと合わせて、\n・「債務残高対ＧＤＰ比」を安定的に引き下げていく中でも可能となる「財政規模」を精査し、\n・当初予算と補正予算を通じた「通年の国債発行額」を昨年同様、適切にコントロールしながら、様々な「財政需要」に対応していくこととし、\nこうした内容を、『予算編成の基本方針』などを通じて具体化した上で､予算編成を行ってまいります。\n\nその上で、来年度以降も、「政策の点検・見直し」を含めた｢経済財政運営の一連のサイクル」を定着させてまいります。"}}},"rest_id":"2105247477146460184","unmention_data":{},"views":{"count":"134365","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105247477146460184","sortIndex":"2105292661614182396"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":7},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1669644725908049922/31IO4zqt_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/3720424033/1647955077"},"core":{"created_at":"Tue Sep 29 00:54:57 +0000 2015","name":"出入国在留管理庁（Immigration Services Agency）","screen_name":"MOJ_IMMI"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozNzIwNDI0M