640x360/C__-2G-4C1_Ca4Z0.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105259187353882624/vid/avc1/1280x720/PqOVpmHeK5ACFKFF.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/BFFMhOJ6yT","expanded_url":"https://x.com/kantei/status/2105259275237134670/video/1","ext_media_availability":{"status":"Available"},"id_str":"2105259187353882624","indices":[114,137],"media_key":"13_2105259187353882624","media_results":{"result":{"media_key":"13_2105259187353882624"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2105259187353882624/img/2N4oDtRDxVezVh26.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/BFFMhOJ6yT","video_info":{"aspect_ratio":[16,9],"duration_millis":255200,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2105259187353882624/pl/aeEhVzTctARYZC3P.m3u8?tag=29&v=294"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105259187353882624/vid/avc1/480x270/5JAEuQ5ETtCf7b7N.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105259187353882624/vid/avc1/640x360/C__-2G-4C1_Ca4Z0.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105259187353882624/vid/avc1/1280x720/PqOVpmHeK5ACFKFF.mp4?tag=29"}]}}]},"favorite_count":1203,"favorited":false,"full_text":"【お知らせ】\n本日（９月３０日）、高市総理は、第１３回経済財政諮問会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　皆さんお疲れ様でございました。\n　本日は「第二次高市改造内閣」発足後、初の経済財政諮問会議となりました。 https://t.co/BFFMhOJ6yT","id_str":"2105259275237134670","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"reply_count":45,"retweet_count":161,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDUyNTkyNzUxMzY0MDE0MDg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（９月３０日）、高市総理は、第１３回経済財政諮問会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　皆さんお疲れ様でございました。\n　本日は「第二次高市改造内閣」発足後、初の経済財政諮問会議となりました。\n　まず、「令和９年度予算編成と今後の経済財政運営」について意見交換を行いました。\n　民間議員の皆様からは、\n・令和９年度予算が「責任ある積極財政元年」にふさわしい予算となるよう、『「強く豊かな日本」投資枠』の在り方、「複数年度での予算管理の在り方」、「補正予算から脱却する方針」などを具体化すること、\n・また、『予算編成の基本方針』、『政府経済見通し』、『中長期試算』、「多角的な分析・検証」、「政策の点検・見直し」を「経済財政運営の一連のサイクル」として、来年度以降も具体化・定着させていくこと、\n・そして、令和９年度予算の在り方を議論するに当たっては、「足元の税収実績」、「名目成長率」、「企業収益」等の動向を十分に分析し、より的確な「税収見積もり」とすること、などのご提案をいただきました。\n　次に「物価や金利環境の変化を踏まえた今後のマクロ経済運営」について意見交換を行いました。\n　民間議員の皆様からは、\n・世界的に「原油価格高騰」によるインフレが加速する中、官民で長期資金への需要が高まり、長期金利も上昇傾向にあること、\n・我が国も、こうした世界経済の動きの中にあること、\n・金利上昇は様々な要因によって変動しており、「家計」「企業」「財政」への影響を丁寧にみていく必要があること、\n・そのためにも、政府と日銀が、経済・物価情勢について認識を共有し、緊密に連携していくこと、\n・また、「住宅ローン減税」をはじめ、既に実施している各施策がしっかり活用されるように、積極的な周知を行うこと、\n・そして「中所得」・「低所得」世帯の負担増に対応する観点から、「飲食料品にかかる消費税率の引下げ」や、その後の「就業者負担軽減支援金」の導入を着実に進めること、\nなど様々なご意見を賜りました。\n　高市内閣は、「物価上昇」と「金利」のある経済の下、「国内投資」や「生産性向上」を通じて供給力を強化し、「強い経済」を実現します。\n　そのためにも、年末までの経済財政諮問会議において、城内大臣が中心となって、令和９年度予算編成を含め、『骨太方針２０２６』で示した「責任ある積極財政」の下での「強い経済」の実現と「財政の持続可能性の確保」を両立する「経済財政運営の道筋」をより一層明らかにしていきます。\n　具体的には、\n・『「強く豊かな日本」投資枠』や「複数年度の予算管理」、「補正予算への依存から脱却する方針」を具体化するとともに、\n・税収動向をより的確に見極めつつ、歳入・歳出両面の見直しを進めることと合わせて、\n・「債務残高対ＧＤＰ比」を安定的に引き下げていく中でも可能となる「財政規模」を精査し、\n・当初予算と補正予算を通じた「通年の国債発行額」を昨年同様、適切にコントロールしながら、様々な「財政需要」に対応していくこととし、\n　こうした内容を『予算編成の基本方針』などを通じて具体化した上で予算編成を行ってまいります。\n　その上で、来年度以降も、「政策の点検・見直し」を含めた「経済財政運営の一連のサイクル」を定着させてまいります。\n　以上です。ありがとうございました。"}}},"rest_id":"2105259275237134670","unmention_data":{},"views":{"count":"33124","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105259275237134670","sortIndex":"2105292661614182400"},{"content":{"__typenam