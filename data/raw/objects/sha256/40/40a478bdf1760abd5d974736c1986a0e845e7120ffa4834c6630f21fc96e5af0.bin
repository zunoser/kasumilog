":false,"conversation_id_str":"2105207080034701795","created_at":"Wed Sep 30 08:04:15 +0000 2026","display_text_range":[0,110],"entities":{"hashtags":[{"indices":[67,71],"text":"金融庁"}],"urls":[{"display_url":"fsa.go.jp/singi/singi_ki…","expanded_url":"https://www.fsa.go.jp/singi/singi_kinyu/hokenseido_wg/gijishidai/20261001.html","indices":[87,110],"url":"https://t.co/UfHVJ4oPlv"}]},"favorite_count":22,"favorited":false,"full_text":"🚩10月１日(木)10:00~12:00開催予定の金融審議会「保険制度ワーキング・グループ」（第１回）議事次第について公表しました。\n＃金融庁\n▼詳細は以下をご覧ください。\nhttps://t.co/UfHVJ4oPlv","id_str":"2105207080034701795","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":0,"retweet_count":10,"retweeted":false,"user_id_str":"276848601"},"rest_id":"2105207080034701795","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"5901","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105207080034701795","sortIndex":"2105292661614182375"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":52},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1697575938316529664/Iob6ICh3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/331514169/1655191913"},"core":{"created_at":"Fri Jul 08 08:59:28 +0000 2011","name":"財務省","screen_name":"MOF_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMzE1MTQxNjk=","is_blue_verified":true,"loca