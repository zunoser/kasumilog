sult":{"media_key":"13_2105206322807586816"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2105206322807586816/img/7CSTZPJLsuenl78E.jpg","original_info":{"focus_rects":[],"height":1080,"width":1080},"sizes":{"large":{"h":1080,"resize":"fit","w":1080},"medium":{"h":1080,"resize":"fit","w":1080},"small":{"h":680,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/mkR4j5YkIf","video_info":{"aspect_ratio":[1,1],"duration_millis":30314,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2105206322807586816/pl/7JOn5au_tg-c9ZwO.m3u8?tag=29&v=a9d"},{"bitrate":432000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105206322807586816/vid/avc1/320x320/O6A7l5ZG40LHofZt.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105206322807586816/vid/avc1/540x540/e9wgmCev-NG1u9VM.mp4?tag=29"},{"bitrate":1280000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105206322807586816/vid/avc1/720x720/Rw59HjktNw9j6anA.mp4?tag=29"},{"bitrate":8768000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105206322807586816/vid/avc1/1080x1080/H9Joc1b4k-Mc8OSl.mp4?tag=29"}]}}]},"favorite_count":45,"favorited":false,"full_text":"【#地震保険】\n日本では、いつどこで地震が発生してもおかしくありません。\n地震で住宅や家財が被害を受けたとき、助けになるのが「地震保険」です。\n\n地震保険は、火災保険に付帯して契約する保険です。\n火災保険の加入者の7割が地震保険に加入しています。 https://t.co/mkR4j5YkIf","id_str":"2105206345150714272","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"reply_count":22,"retweet_count":18,"retweeted":false,"user_id_str":"331514169"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[1,6],"text":"地震保険"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"gov-online.go.jp/article/201701…","expanded_url":"https://www.gov-online.go.jp/article/201701/entry-9333.html","indices":[219,242],"url":"https://t.co/tObf06ORF3"},{"display_url":"jishin-hoken.jp","expanded_url":"https://www.jishin-hoken.jp/","indices":[263,286],"url":"https://t.co/I8kByYawL9"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDUyMDYzNDUwNzUxNzEzMjg=","richtext":{"richtext_tags":[]},"text":"【#地震保険】\n日本では、いつどこで地震が発生してもおかしくありません。\n地震で住宅や家財が被害を受けたとき、助けになるのが「地震保険」です。\n\n地震保険は、火災保険に付帯して契約する保険です。\n火災保険の加入者の7割が地震保険に加入しています。\nまた、火災保険の契約時に地震保険に加入していない場合でも、契約期間の途中から地震保険に加入できます。\n未加入の方は、地震保険への加入を検討してみてはいかがでしょうか？\n\n政府広報オンライン\nhttps://t.co/tObf06ORF3\n地震保険特設サイト（日本損害保険協会）\nhttps://t.co/I8kByYawL9"}}},"rest_id":"2105206345150714272","unmention_data":{},"views":{"count":"6688","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105206345150714272","sortIndex":"2105292661614182374"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1788223971"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6ku2s"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":297189,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4957,"tweets":12951},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6ku2s"}}}},"edit_control":{"edit_tweet_ids":["2105206022570689003"],"editable_until_msecs":"1790758803000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":13,"bookmarked":false,"conversation_id_str":"2105206022570689003","created_at":"Wed Sep 30 08:00:03 +0000 2026","display_text_range":[0,94],"entities":{"media":[{"display_url":"pic.x.com/j6VUKcAjEg","expanded_url":"https://x.com/gov_online/status/2105206022570689003/photo/1","ext_alt_text":"上部に「インフルエンザから身を守るポイント。」と記載されており、その横に、熱で寝込んでいる女性と咳をしている男性、39.0度と表示された体温計のイラストが描かれている。その下には、次のように記載されている。「・正しい手洗い。ウイルスは石けんに弱いため、帰宅時や調理の前後、食事前などこまめに手を洗いましょう。・ワクチン接種。インフルエンザワクチンを打つことで、発病の可能性を減らすことや、重症化を予防することが期待できます。※ワクチンを打っていてもインフルエンザにかかる場合があります。・十分な休養とバランスのとれた栄養摂取。体の抵抗力を高めるために、十分な休養とバランスのとれた栄養摂取を日頃から心がけましょう。・適度な湿度を保つ。加湿器などを使って、適切な湿度（50％から60％）を保つこともインフルエンザ予防に効果的です。・人混みや繁華街への外出を控える。インフルエンザが流行してきたら、特に高齢者や持病のある人、妊娠中の女性、体調の悪い人、睡眠不足の人は、人混みや繁華街への外出を控え、やむを得ず外出して人混みに入る可能性がある場合には、不織布製マスクを着用しましょう。・室内ではこまめに換気をする。常時換気設備や換気扇を活用しましょう。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2105124004713684992","indices":[95,118],"media_key":"3_2105124004713684992","media_results":{"result":{"media_key":"3_2105124004713684992"}},"media_url_https":"https://pbs.twimg.com/media/HTbnIP0bYAApRjm.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":1200,"w":1200,"x":0,"y":0},{"h":1368,"w":1200,"x":0,"y":0},{"h":1600,"w":800,"x":40,"y":0},{"h":1600,"w":1200,"x":0,"y":0}],"height":1600,"width":1200},"sizes":{"large":{"h":1600,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/j6VUKcAjEg"}],"urls":[{"display_url":"gov-online.go.jp/article/200909…","expanded_url":"https://www.gov-online.go.jp/article/200909/entry-8422.html","indices":[60,83],"url":"https://t.co/dBTFJ1mQzI"}],"user_mentions":[{"id_str":"180585090","indices":[84,94],"name":"厚生労働省","screen_name":"MHLWitter"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/j6VUKcAjEg","expanded_url":"https://x.com/gov_online/status/2105206022570689003/photo/1","ext_alt_text":"上部に「インフルエンザから身を守るポイント。」と記載されており、その横に、熱で寝込んでいる女性と咳をしている男性、39.0度と表示された体温計のイラストが描かれている。その下には、次のように記載されている。「・正しい手洗い。ウイルスは石けんに弱いため、帰宅時や調理の前後、食事前などこまめに手を洗いましょう。・ワクチン接種。インフルエンザワクチンを打つことで、発病の可能性を減らすことや、重症化を予防することが期待できます。※ワクチンを打っていてもインフルエンザにかかる場合があります。・十分な休養とバランスのとれた栄養摂取。体の抵抗力を高めるために、十分な休養とバランスのとれた栄養摂取を日頃から心がけましょう。・適度な湿度を保つ。加湿器などを使って、適切な湿度（50％から60％）を保つこともインフルエンザ予防に効果的です。・人混みや繁華街への外出を控える。インフルエンザが流行してきたら、特に高齢者や持病のある人、妊娠中の女性、体調の悪い人、睡眠不足の人は、人混みや繁華街への外出を控え、やむを得ず外出して人混みに入る可能性がある場合には、不織布製マスクを着用しましょう。・室内ではこまめに換気をする。常時換気設備や換気扇を活用しましょう。」",