g":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":70,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[10,16],"text":"九州新幹線"},{"indices":[35,44],"text":"令和8年熊本地震"},{"indices":[188,194],"text":"鹿児島本線"},{"indices":[243,248],"text":"JR九州"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"jrkyushu.co.jp/trains/info/","expanded_url":"https://www.jrkyushu.co.jp/trains/info/","indices":[250,273],"url":"https://t.co/jS3Da9pz8k"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA3ODM1ODU2OTU2MDg4MzI=","richtext":{"richtext_tags":[]},"text":"◤￣￣￣￣￣￣◥\n　#九州新幹線\n　全線運転再開\n◣＿＿＿＿＿＿◢\n\n#令和8年熊本地震 の影響により\n運休していた九州新幹線(熊本～新水俣間)は\n本日9月18日の始発から運転を再開しました\n\nこれにより、鹿児島から大阪方面を結ぶ\n九州の大動脈が復旧し、\nシルバーウィークを前に、\n観光をはじめとする地域経済の復興に\n大きな追い風となることが期待されます\n\nまた、本日から、\n#鹿児島本線 の復旧までの間、\n熊本～新八代間で九州新幹線による\n振替輸送が実施されています\n\n詳細はこちら（#JR九州）\nhttps://t.co/jS3Da9pz8k"}}},"rest_id":"2100783585762713745","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"6865","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100783585762713745","sortIndex":"2100826123444158441"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2098086781438836738/XCXRCiv-?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":147,"url":"https://pbs.twimg.com/card_img/2098086781438836738