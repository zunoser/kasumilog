er","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2995445,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":537,"tweets":1785},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2100763171770548569"],"editable_until_msecs":"1789699545000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":43,"bookmarked":false,"conversation_id_str":"2100763171770548569","created_at":"Fri Sep 18 01:45:45 +0000 2026","display_text_range":[0,104],"entities":{},"favorite_count":4981,"favorited":false,"full_text":"渡辺孝一衆議院議員の突然のご逝去の報に接し、深い悲しみとともに、心より哀悼の誠を捧げます。\n\n先生は、岩見沢市長を３期務められた豊富な行政経験と深い見識をもって、総務副大臣をはじめ政府の要職を歴任されました。","id_str":"2100763171770548569","is_quote_status":false,"lang":"ja","quote_count":15,"reply_count":155,"retweet_count":486,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA3NjMxNzE3MzI3NzQ5MTI=","richtext":{"richtext_tags":[]},"text":"渡辺孝一衆議院議員の突然のご逝去の報に接し、深い悲しみとともに、心より哀悼の誠を捧げます。\n\n先生は、岩見沢市長を３期務められた豊富な行政経験と深い見識をもって、総務副大臣をはじめ政府の要職を歴任されました。\n常に地域の声に寄り添いながら、北海道の発展はもとより、我が国の地域の未来づくりに力を尽くされていました。\n今なお志半ばで旅立たれたことは痛惜の念に堪えません。\n\nご遺族の皆様にお悔やみを申し上げますとともに、謹んでご冥福をお祈り申し上げます。"}}},"rest_id":"2100763171770548569","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"211913","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100763171770548569","sortIndex":"2100826123444158427"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2098838024608182272/libeEezg?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.fsa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2098838024608182272/l