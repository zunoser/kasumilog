ty":{"status":"Available"},"features":{"large":{"faces":[{"h":65,"w":65,"x":1695,"y":597}]},"medium":{"faces":[{"h":38,"w":38,"x":993,"y":350}]},"orig":{"faces":[{"h":83,"w":83,"x":2153,"y":759}]},"small":{"faces":[{"h":21,"w":21,"x":563,"y":198}]}},"id_str":"2103429034332020736","indices":[95,118],"media_key":"3_2103429034332020736","media_results":{"result":{"media_key":"3_2103429034332020736"}},"media_url_https":"https://pbs.twimg.com/media/HTDhj_GaYAA4A9N.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":238,"y":0},{"h":1734,"w":1521,"x":345,"y":0},{"h":1734,"w":867,"x":672,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/TLYpmwrgB8"}]},"favorite_count":11217,"favorited":false,"full_text":"本日、「日本スタートアップ大賞2026」の表彰式が開催されました。\n\n審査員の方々による厳正な審査により、「株式会社Mujin」が「日本スタートアップ大賞 内閣総理大臣賞」に選ばれました。 https://t.co/TLYpmwrgB8","id_str":"2103429077369782354","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":199,"reply_count":1133,"retweet_count":1161,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM0MjkwNzczMDY4OTYzODQ=","richtext":{"richtext_tags":[]},"text":"本日、「日本スタートアップ大賞2026」の表彰式が開催されました。\n\n審査員の方々による厳正な審査により、「株式会社Mujin」が「日本スタートアップ大賞 内閣総理大臣賞」に選ばれました。\n\n「Mujin」は、産業用ロボットに、見て、考える力を与え、物流・製造現場を自動化する「フィジカルAI」の開発・実装を進めており、「Mujin」のロボットを導入した配送センターでは、多様な日用品を出荷先ごとに異なる構成で積み込む作業を、ロボットが全自動で行うことで、大幅に作業が効率化したと伺っています。\n\n次世代のロールモデルとなるスタートアップであり、「Mujin」の皆様、ご受賞、誠におめでとうございました。\n\nそして、各賞に選出されたスタートアップの皆様にも、この度のご受賞を心よりお祝い申し上げます。\n\n高市内閣では、戦略的な国内投資を全国に広げていくため、『日本成長戦略』において、「スタートアップ」を「横断的課題」の1つに位置付けています。\n\nスタートアップの皆様が、「フィジカルAI」を含む「AI・半導体」、「防衛産業」、「航空・宇宙」、「フードテック」など、「戦略17分野」の国内投資を牽引する重要な担い手になっていただくこと、そして、本日受賞された皆様が、起業を志す方々の励みとなり、我が国でスタートアップの創出が進み、日本の未来を切り拓いていくことを、期待しています。"}}},"rest_id":"2103429077369782354","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"477760","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103429077369782354","sortIndex":"2103981001838428133"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"ur