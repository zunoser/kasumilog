count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39970,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":94,"tweets":391},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2103371324194533714"],"editable_until_msecs":"1790321377000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":9,"bookmarked":false,"conversation_id_str":"2103371324194533714","created_at":"Fri Sep 25 06:29:37 +0000 2026","display_text_range":[0,121],"entities":{},"favorite_count":495,"favorited":false,"full_text":"【9月25日　小泉防衛大臣会見】\n \n冒頭、台風２５号対応、防衛省版ＳＢＩＲ制度の開始について発表しました。\n \nその他、\n○防衛省版ＳＢＩＲ制度\n○北朝鮮による弾道ミサイルの発射\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら","id_str":"2103371324194533714","is_quote_status":false,"lang":"ja","quote_count":7,"reply_count":30,"retweet_count":86,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/Z4lZn_7Vcgk?si…","expanded_url":"https://youtu.be/Z4lZn_7Vcgk?si=1CoDTOUlu7nVxm_V","indices":[1514,1537],"url":"https://t.co/MVeCEzAhnY"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDMzNzEzMjM5ODA1MTczNzY=","text":"【9月25日　小泉防衛大臣会見】\n \n冒頭、台風２５号対応、防衛省版ＳＢＩＲ制度の開始について発表しました。\n \nその他、\n○防衛省版ＳＢＩＲ制度\n○北朝鮮による弾道ミサイルの発射\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「今日は冒頭２件あります。まず１点目は台風２５号関係です。\n台風２５号による大雨の影響で、神奈川県と千葉県では土砂崩れにより、行方不明者が発生しました。\nこのため、神奈川県知事及び千葉県知事から第１師団長に対し、人命救助の災害派遣要請がありました。\nこれを受け、神奈川県では武山駐屯地の第３１普通科連隊が、千葉県では習志野駐屯地の第１空挺団と下志津駐屯地の高射学校の隊員が、迅速に現場に入り、現地の消防・警察と連携し、土砂災害により行方不明となった方々の捜索活動などに当たっております。\n現在、神奈川県三浦市南下浦町で、第３１普通科連隊の隊員が約２５名態勢で、千葉県長柄町では、高射学校の隊員約４５名態勢で、行方不明者の発見に向けて、懸命に捜索を続けています。\n現場では、二次被害の防止にも十分注意しながら、一刻も早く行方不明になっている方を発見するため、地元の消防・警察をはじめとする関係機関と緊密に連携し、引き続き、隊員一人一人が使命感を持って全力で活動してまいります。\n２点目は、防衛省版のＳＢＩＲ制度の開始についてです。\n本日は、新たに開始する防衛省版ＳＢＩＲ制度について申し上げます。\n無人機やＡＩをはじめ、民生分野の技術は極めて速いスピードで進展しています。\nこうした先端技術を防衛省・自衛隊の活動に迅速かつ的確に取り込むことは、我が国の防衛力を強化する上で、ますます重要となっています。\nとりわけ、スタートアップは、柔軟な発想と優れた技術力によって、従来の延長線上にない解決策を生み出す存在でもあります。\n防衛省として、そのスタートアップの皆さんの力を積極的に活用し、防衛力の強化につなげたいと考えております。\nそして、この度、スタートアップの皆さんの優れた技術を迅速に取り込むファストパス調達の取組の一つとして、今年度中の開始をお約束しておりました、防衛省版ＳＢＩＲについて、来月２日から公募を開始することといたしました。\nこの防衛省版ＳＢＩＲでは、部隊が現場で直面する課題やニーズを研究開発課題として設定し、その解決につながる革新的な技術やアイデアをスタートアップの皆さんから広く募集します。\n今回公募する課題としては、一つ目がですね、国産部品を最大限使用した陸上発射の小型対処用ＵＡＶ。これは陸上自衛隊のニーズです。\n二つ目は、国産部品を最大限使用した水上艦発射の小型対処用ＵＡＶ。これは海上自衛隊のニーズです。\nそして三つ目が、補給倉庫の運用を最適化するシステム。\nそして四つ目が、航空機騒音を低減し、執務環境を改善する装置。三と四、これらは航空自衛隊のニーズです。\nこの陸・海・空の各自衛隊におけるニーズを踏まえた研究開発課題を予定しています。\nこうした課題の提示は、これまで我々に不足していた防衛省・自衛隊の技術ニーズをスタートアップの皆様に明確にお示しするという狙いもあります。\nこれらの課題の中には、直ちに具体的な応募に結び付かない課題もあるかもしれません。\nしかしながら、防衛省・自衛隊の現場のニーズを広く共有すること自体に大きな意義があると考えています。\n今後も、部隊の現場から寄せられるニーズ等を踏まえて、新たな研究開発課題を設定し、順次、公募してまいります。\n積極的に応募いただけることを心から期待をしています。以上です。」\n \n↓動画はこちら\nhttps://t.co/MVeCEzAhnY"}}},"rest_id":"2103371324194533714","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"47805","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2103371664629309790","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4989","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103371664629309790","sortIndex":"2103981001838428095"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_en