,"original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":2},{"h":540,"w":540,"x":234,"y":0},{"h":540,"w":474,"x":267,"y":0},{"h":540,"w":270,"x":369,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/kuW3QzmxS2"},{"display_url":"pic.x.com/kuW3QzmxS2","expanded_url":"https://x.com/ModJapan_jp/status/2103782161937735925/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103782155499495424","indices":[108,131],"media_key":"3_2103782155499495424","media_results":{"result":{"media_key":"3_2103782155499495424"}},"media_url_https":"https://pbs.twimg.com/media/HTIiuV9aYAA5WTC.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":2},{"h":540,"w":540,"x":186,"y":0},{"h":540,"w":474,"x":219,"y":0},{"h":540,"w":270,"x":321,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/kuW3QzmxS2"}]},"favorite_count":720,"favorited":false,"full_text":"【インドネシア国際緊急援助活動（消火活動）】\n本日、インドネシア共和国における国際緊急援助活動のために派遣されている陸上自衛隊ＣＨ－４７輸送ヘリコプターが、キジン港周辺で山林火災に対する空中消火活動を実施しました。 https://t.co/kuW3QzmxS2","id_str":"2103782161937735925","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":7,"retweet_count":109,"retweeted":false,"user_id_str":"268732024"},"rest_id":"2103782161937735925","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"31942","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103782161937735925","sortIndex":"2103981001838428156"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3000976,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":549,"tweets":1809},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2103747815742796025"],"editable_until_msecs":"1790411139000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":259,"bookmarked":false,"conversation_id_str":"2103747815742796025","created_at":"Sat Sep 26 07:25:39 +0000 2026","display_text_range":[0,99],"entities":{},"favorite_count":13632,"favorited":false,"full_text":"国際情勢が不安定化し、サプライチェーン分断の試みや、重要技術をめぐる国家間競争の激化が見られる中、経済安全保障、すなわち我が国の経済的な自律性と技術的優位性を確保することが喫緊の課題となっています。","id_str":"2103747815742796025","is_quote_status":false,"lang":"ja","quote_count":190,"reply_count":1091,"retweet_count":1559,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM3NDc4MTU2ODQxMDQxOTI=","richtext":{"richtext_tags":[]},"text":"国際情勢が不安定化し、サプライチェーン分断の試みや、重要技術をめぐる国家間競争の激化が見られる中、経済安全保障、すなわち我が国の経済的な自律性と技術的優位性を確保することが喫緊の課題となっています。\n\n本日は、こうした課題に対応するために先の国会に提出し、成立した『経済施策を一体的に講ずることによる安全保障の確保の推進に関する法律（経済安全保障推進法）及び株式会社国際協力銀行法の一部を改正する法律』をご紹介します。\n\n今回の改正のポイントは4点です。\n\n第1に、「重要物資」の安定供給確保に向けた取組を強化します。\n半導体や重要鉱物などの「物資」だけでなく、海底ケーブルの敷設や人工衛星の打上げといった、安定供給を支える重要な「サービス」も、支援対象に追加します。\n\n第2に、国民生活や経済活動を支える重要な基幹インフラの安定的な供給を確保するため、「医療分野」についても、その役務を提供するために導入される重要設備などを事前審査の対象に追加します。\n電子カルテや電子処方箋などの医療システムの安全性を高め、障害やサイバー攻撃による医療サービスへの影響を防ぎます。\n\n第3に、経済安全保障上重要な海外事業を支援するため、国際協力銀行（JBIC）の機能を拡充します。\n資源確保や重要インフラ整備など、日本にとって戦略的に重要な一方で採算性にリスクのある海外プロジェクトに対し、JBICを通じて民間のとるリスクを低減する形で資金を支援することで、こうしたプロジェクトを促進します。\n\n第4に、経済安全保障に関する調査研究を行う「総合的なシンクタンク」と、官民がリスクや対策を共有する「官民協議会」を創設します。\n調査分析体制や官民の連携を強化し、政府と企業が連携してリスクを早期に把握、迅速に対応できる体制を整備します。\n\n今回の法改正による新たな制度の下で、外交力・防衛力・経済力・技術力・情報力・人材力を含む総合的な国力を強化しつつ、我が国の平和と安全、繁栄を確保するため、経済安全保障の強化を進めてまいります。"}}},"rest_id":"2103747815742796025","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"565975","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103747815742796025","sortIndex":"2103981001838428155"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3000976,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":549,"tweets":1809},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2103741768282063150"],"editable_until_msecs":"1790409697000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":201,"bookmarked":false,"conversation_id_str":"2103741768282063150","created_at":"Sat Sep 26 07:01:37 +0000 2026","display_text_range":[0,131],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/h8hDafZHFx","expanded_url":"https://x.com/takaichi_sanae/status/2103741768282063150/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103741659888730112","indices":[132,155],"media_key":"3_2103741659888730112","media_results":{"result":{"media_key":"3_2103741659888730112"}},"media_url_https":"https://pbs.twimg.com/media/HTH95MDbwAAjhE4.jpg","original_info":{"focus_rects":[{"h":1389,"w":2481,"x":0,"y":2034},{"h":2481,"w":2481,"x":0,"y":1040},{"h":2828,"w":2481,"x":0,"y":693},{"h":3521,"w":1761,"x":720,"y":0},{"h":3521,"w":2481,"x":0,"y":0}],"height":3521,"width":2481},"sizes":{"large":{"h":2048,"resize":"fit","w":1443},"medium":{"h":1200,"resize":"fit","w":846},"small":{"h":680,"resize":"fit","w":479},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/h8hDafZHFx"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/h8hDafZHFx","expanded_url":"https://x.com/takaichi_sanae/status/2103741768282063150/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103741659888730112","indices":[132,155],"media_key":"3_2103741659888730112","media_results":{"result":{"media_key":"3_2103741659888730112"}},"media_url_https":"https://pbs.twimg.com/media/HTH95MDbwAAjhE4.jpg","original_info":{"focus_rects":[{"h":1389,"w":2481,"x":0,"y":2034},{"h":2481,"w":2481,"x":0,"y":1040},{"h":2828,"w":2481,"x":0,"y":693},{"h":3521,"w":1761,"x":720,"y":0},{"h":3521,"w":2481,"x":0,"y":0}],"height":3521,"width":2481},"sizes":{"large":{"h":2048,"resize":"fit","w":1443},"medium":{"h":1200,"resize":"fit","w":846},"small":{"h":680,"resize":"fit","w":479},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/h8hDafZHFx"}]},"favorite_count":10199,"favorited":false,"full_text":"先の国会で成立した農作物の種苗に関する法律、『気候変動等対応品種法』について御紹介します。\n\n近年、厳しい夏の暑さが続いており、その影響は農業の現場にも広がっています。\n\n「昔と同じように作っているのに、実がならない」\n「暑さで野菜が傷んでしまい、出荷できない」 https://t.co/h8hDafZHFx","id_str":"2103741768282063150","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":163,"reply_count":538,"retweet_count":1549,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM3NDE3NjgyMjc1MjQ2MDg=","richtext":{"richtext_tags":[]},"text":"先の国会で成立した農作物の種苗に関する法律、『気候変動等対応品種法』について御紹介します。\n\n近年、厳しい夏の暑さが続いており、その影響は農業の現場にも広がっています。\n\n「昔と同じように作っているのに、実がならない」\n「暑さで野菜が傷んでしまい、出荷できない」\n全国の農家の皆様から、こうした切実な声が届いています。\n\nこのため、これからの日本の農業には、暑さに負けない、病気に負けない、安定してたくさん収穫できる「強い品種」が必要です。\n\nしかし、｢優れた品種｣を生み出すには、長い年月と努力の積み重ねが必要です。\nそこで、今回の法律では、産官学が力を合わせ、高温や病気に強い「優良品種」の開発と普及を進めることとしています。\n\n優れた日本の「品種」がどんどんと生まれ、農家の皆様が、これからも安心して農業を続けられるように、そして、日本の美味しい｢農産物｣を皆様の食卓へ届けられるように、高市内閣は、日本の｢強い農業｣の実現に取り組んでまいります。"}}},"rest_id":"2103741768282063150","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"298484","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103741768282063150","sortIndex":"2103981001838428154"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3000976,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":549,"tweets":1809},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2103733476184969279"],"editable_until_msecs":"1790407720000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2591,"bookmarked":false,"conversation_id_str":"2103733476184969279","created_at":"Sat Sep 26 06:28:40 +0000 2026","display_text_range":[0,34],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/U20GZmiQgv","expanded_url":"https://x.com/takaichi_sanae/status/2103733476184969279/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103733253186396160","indices":[35,58],"media_key":"3_2103733253186396160","media_results":{"result":{"media_key":"3_2103733253186396160"}},"media_url_https":"https://pbs.twimg.com/media/HTH2P2paIAAINSe.jpg","original_info":{"focus_rects":[{"h":339,"w":605,"x":0,"y":288},{"h":605,"w":605,"x":0,"y":155},{"h":690,"w":605,"x":0,"y":112},{"h":873,"w":437,"x":0,"y":0},{"h":873,"w":605,"x":0,"y":0}],"height":873,"width":605},"sizes":{"large":{"h":873,"resize":"fit","w":605},"medium":{"h":873,"resize":"fit","w":605},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/U20GZmiQgv"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/U20GZmiQgv","expanded_url":"https://x.com/takaichi_sanae/status/2103733476184969279/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103733275135262720","indices":[35,58],"media_key":"3_2103733275135262720","media_results":{"result":{"media_key":"3_2103733275135262720"}},"media_url_https":"https://pbs.twimg.com/media/HTH2RIabQAACKHX.jpg","original_info":{"focus_rects":[{"h":339,"w":605,"x":0,"y":0},{"h":454,"w":454,"x":151,"y":0},{"h":454,"w":398,"x":179,"y":0},{"h":454,"w":227,"x":265,"y":0},{"h":454,"w":605,"x":0,"y":0}],"height":454,"width":605},"sizes":{"large":{"h":454,"resize":"fit","w":605},"medium":{"h":454,"resize":"fit","w":605},"small":{"h":454,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/U20GZmiQgv"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/U20GZmiQgv","expanded_url":"https://x.com/takaichi_sanae/status/2103733476184969279/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103733253186396160","indices":[35,58],"media_key":"3_2103733253186396160","media_results":{"result":{"media_key":"3_2103733253186396160"}},"media_url_https":"https://pbs.twimg.com/media/HTH2P2paIAAINSe.jpg","original_info":{"focus_rects":[{"h":339,"w":605,"x":0,"y":288},{"h":605,"w":605,"x":0,"y":155},{"h":690,"w":605,"x":0,"y":112},{"h":873,"w":437,"x":0,"y":0},{"h":873,"w":605,"x":0,"y":0}],"height":873,"width":605},"sizes":{"large":{"h":873,"resize":"fit","w":605},"medium":{"h":873,"resize":"fit","w":605},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/U20GZmiQgv"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/U20GZmiQgv","expanded_url":"https://x.com/takaichi_sanae/status/2103733476184969279/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103733275135262720","indices":[35,58],"media_key":"3_2103733275135262720","media_results":{"result":{"media_key":"3_2103733275135262720"}},"media_url_https":"https://pbs.twimg.com/media/HTH2RIabQAACKHX.jpg","original_info":{"focus_rects":[{"h":339,"w":605,"x":0,"y":0},{"h":454,"w":454,"x":151,"y":0},{"h":454,"w":398,"x":179,"y":0},{"h":454,"w":227,"x":265,"y":0},{"h":454,"w":605,"x":0,"y":0}],"height":454,"width":605},"sizes":{"large":{"h":454,"resize":"fit","w":605},"medium":{"h":454,"resize":"fit","w":605},"small":{"h":454,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/U20GZmiQgv"}]},"favorite_count":30399,"favorited":false,"full_text":"「競馬」が、実は「食料安全保障」に大きく貢献しているというお話です。 https://t.co/U20GZmiQgv","id_str":"2103733476184969279","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1832,"reply_count":931,"retweet_count":7842,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM3MzM0NzYwODg1ODIxNDQ=","richtext":{"richtext_tags":[]},"text":"「競馬」が、実は「食料安全保障」に大きく貢献しているというお話です。\n\n高市内閣では、全ての田畑をフル活用すべく、５年間の「農業構造転換集中対策期間」において、農地の大区画化、共同利用施設の再編・集約化、スマート農業技術の導入の加速化、輸出産地の育成など、農業の構造転換への集中投資を実施していくため、｢別枠予算｣として国費1.3兆円を確保することとしています。\n\nこれに必要な財源の一部を確保するため、先の国会において、『農業構造転換の推進に必要な施策の集中的な実施の財源に充てるための日本中央競馬会の国庫納付金の納付に関する臨時措置法』が成立しました。\n\nこれまでも、日本中央競馬会（JRA）の収益の一部は国庫に納付され、畜産業の振興等に活用されてきましたが、この法律により、従来の国庫納付に加え、令和８年度から11年度までの４年間、JRAの特別積立金から毎年度250億円、合計1,000億円が、構造転換への集中投資のために国庫に納付されます。\n関係者の皆様の御理解と御尽力に感謝申し上げます。\n\n高齢化や人口減少が進む中にあっても、若い方々の就農や法人の参入などを通じて、農業の「担い手」が継続的に確保されていかなければなりません。\nそのためにも、この財源を活用し、我が国の農業の構造転換を加速させます。そして、生産性を抜本的に向上させ、「稼げる農業」を創り出してまいります。\n\n｢競馬｣を通じて積み立てられた大切な財源を、日本の「食」の新たな需要を創り出し、農業の「供給力」を高めるための力に変えて、我が国の農業が未来へ力強く駆けていけるよう取り組んでまいります。"}}},"rest_id":"2103733476184969279","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2659678","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103733476184969279","sortIndex":"2103981001838428153"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"trans