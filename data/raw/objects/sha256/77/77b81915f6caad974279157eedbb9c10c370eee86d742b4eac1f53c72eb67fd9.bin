c_JMOD/status/2103419906641576397/video/1","ext_media_availability":{"status":"Available"},"id_str":"2103419591901024256","indices":[113,136],"media_key":"13_2103419591901024256","media_results":{"result":{"media_key":"13_2103419591901024256"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2103419591901024256/img/HgLkTvjB02ZQS8eM.jpg","original_info":{"focus_rects":[],"height":1920,"width":1080},"sizes":{"large":{"h":1920,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":675},"small":{"h":680,"resize":"fit","w":383},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/RhmUaDyv0I","video_info":{"aspect_ratio":[9,16],"duration_millis":59993,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2103419591901024256/pl/r4-yA2gZVB-TLKwZ.m3u8?tag=29&v=b13"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103419591901024256/vid/avc1/320x568/Z7gp5T7hGn2Zx0ov.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103419591901024256/vid/avc1/480x852/_79fFN_zz_kvs_7e.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103419591901024256/vid/avc1/720x1280/8bfpGyErWeFjYUfK.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103419591901024256/vid/avc1/1080x1920/I-hVby8OI2Y_y4DD.mp4?tag=29"}]}}]},"favorite_count":370,"favorited":false,"full_text":"【1分でわかる！なぜいま三文書の改定？】  🤔「三文書ってなに？」 🤔「どうして改定する必要があるの？」 そんな疑問に1分でお答えします。\n \n現在の三文書を策定してから３年以上。\n安全保障環境はさらに大きく変化しています。 https://t.co/RhmUaDyv0I","id_str":"2103419906641576397","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":6,"retweet_count":105,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[529,533],"text":"三文書"},{"indices":[534,540],"text":"防衛力変革"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/henkaku/pdf/20251112b.pdf","indices":[296,319],"url":"https://t.co/JYGA2V8SvL"},{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/henkaku/pdf/20251218b.pdf","indices":[375,398],"url":"https://t.co/cLdhVmhk6Y"},{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/henkaku/pdf/20260803c.pdf","indices":[453,476],"url":"https://t.co/jHy9eruHUa"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM0MTk5MDY0ODIxNTE0MjQ=","text":"【1分でわかる！なぜいま三文書の改定？】  🤔「三文書ってなに？」 🤔「どうして改定する必要があるの？」 そんな疑問に1分でお答えします。\n \n現在の三文書を策定してから３年以上。\n安全保障環境はさらに大きく変化しています。\nだからこそ、いま、新しい時代に対応した「防衛の在り方」を考える必要があるのです。\n \n防衛省・自衛隊は、本年中の三文書改定に向けて、国民の皆様の命と平和な暮らしを守り抜くため、何が必要か、具体的かつ現実的に議論を積み上げていきます。\n \n動画はほんの入り口です。\nご紹介しきれなかった詳細は、こちらをご覧ください。\n \n📌日本の周辺でどんなことが起こっているのか？\nhttps://t.co/JYGA2V8SvL\n※変革本部第2回資料　「我が国を取り巻く安全保障環境」へのリンク\n \n📌世界で見られる「新しい戦い方」とは？\nhttps://t.co/cLdhVmhk6Y\n※変革本部第3回資料　「ウクライナ侵略で見られる新しい戦い方と課題」へのリンク\n \n📌これからの方向性は？\nhttps://t.co/jHy9eruHUa\n※変革本部第9回資料　「現行の国家防衛戦略・防衛力整備計画の評価（課題と今後の方向性）」へのリンク\n \n#三文書\n#防衛力変革"}}},"rest_id":"2103419906641576397","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"22499","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2103422053483532682","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"5082","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103422053483532682","sortIndex":"2103981001838428132"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injecti