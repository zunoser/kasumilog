":0},{"h":716,"w":358,"x":298,"y":0},{"h":716,"w":955,"x":0,"y":0}],"height":716,"width":955},"sizes":{"large":{"h":716,"resize":"fit","w":955},"medium":{"h":716,"resize":"fit","w":955},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Igw76tzsEV"}]},"favorite_count":1818,"favorited":false,"full_text":"令和８年９月２５日（金）午前から午後にかけて、ロシアの情報収集機（ＩＬ－２０）×１機が、大陸方面から飛来し、日本海上空を鳥取県沖まで飛行後、反転し、大陸方面へ飛行したことを確認しました。\nこれに対し、航空自衛隊の北部航空方面隊等の戦闘機を緊急発進させ対応しました。 https://t.co/Igw76tzsEV","id_str":"2103451194274496557","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":15,"quoted_status_id_str":"2103439379154845827","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2103439379154845827","url":"https://t.co/WyB6SLWpXg"},"reply_count":42,"retweet_count":426,"retweeted":false,"user_id_str":"268732024"},"previous_counts":{"bookmark_count":1,"favorite_count":157,"quote_count":1,"reply_count":1,"retweet_count":24},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の