3455877386895360/vid/avc1/480x270/faEkP6FJruxDAfHI.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103455877386895360/vid/avc1/640x360/Bu_fO1dBia-XQhni.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103455877386895360/vid/avc1/1280x720/D3z5HeeWW78ugNAo.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/JTcIaZ6cYE","expanded_url":"https://x.com/kantei/status/2103458335953650104/video/1","ext_media_availability":{"status":"Available"},"id_str":"2103455877386895360","indices":[65,88],"media_key":"13_2103455877386895360","media_results":{"result":{"media_key":"13_2103455877386895360"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2103455877386895360/img/KhjPl9tCFpmP9hLL.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/JTcIaZ6cYE","video_info":{"aspect_ratio":[16,9],"duration_millis":268666,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2103455877386895360/pl/iJgxYp9-K-1kAbi3.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103455877386895360/vid/avc1/480x270/faEkP6FJruxDAfHI.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103455877386895360/vid/avc1/640x360/Bu_fO1dBia-XQhni.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103455877386895360/vid/avc1/1280x720/D3z5HeeWW78ugNAo.mp4?tag=29"}]}}]},"favorite_count":7099,"favorited":false,"full_text":"【お知らせ】\n本日（９月２５日）、高市総理は、日米首脳会談等についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（記者） https://t.co/JTcIaZ6cYE","id_str":"2103458335953650104","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":212,"reply_count":555,"retweet_count":1096,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM0NTgzMzU4MjM3MDQwNjY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（９月２５日）、高市総理は、日米首脳会談等についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（記者）\n　日米首脳会談でアメリカのトランプ米大統領から円安への懸念が示され、高市総理が一般論として、円の過小評価は問題だと答えた、と片山財務大臣が明かしました。日本政府として今後の財政・金融政策にどのように反映するのか、具体的な会談でのやりとりとあわせて教えてください。\n　また、２４日の米中首脳会談では台湾問題を巡って、習近平国家主席が慎重な処理を米国に求め、トランプ氏が中国を「第２次世界大戦での同盟国」と呼ぶ一幕もありました。日米首脳会談の成果も踏まえ、米中首脳会談の受け止めを聞かせてください。\n\n（高市総理）\n　はい、ありがとうございます。\n　今回の日米首脳会談におきましてですね、今おっしゃったような金融政策ですとか、それから財政政策に関するような議論はございませんでした。ただ先方から「円安によって米国の貿易が厳しい」というお話がありましたので、おっしゃったように私は一般論として「円の過小評価」というのは問題であるという旨を申し上げました。\n　ですから、今後の高市内閣の取組としては、変わりません。この「責任ある積極財政」の下で、「強い経済」とそれから「財政の持続可能性」これを両立をしていくということでございます。\n　それから米中会談についてのお尋ねですけれども、これは第三国間のやり取りでございますので、逐一について私からコメントすることはございません。\n　日米の関係で申し上げますと、戦争はありましたけれども、でもその後ですね、しっかりと和解を果たして、関係を深めて、今は非常に強い絆で結ばれた同盟国としてお互いに信頼し合える関係であると思っております。\n\n（記者）\n　ＩＣＣを巡る問題につきまして２問お伺いします。\n　先日行われた日米首脳会談で、総理はＩＣＣについて、トランプ大統領と「率直な意見をやりとりした」とされています。総理はこれまでも日本政府の立場を述べられてきましたが、会談では今まで以上に踏み込み、例えば赤根所長に対する制裁の撤回要求等はされたのでしょうか。\n 　また、トランプ大統領は各国にＩＣＣ脱退を呼びかける等、圧力を強めていますが、一連の問題が解決や改善に向けて進展しているというようなご認識はおありでしょうか。よろしくお願いします。\n\n（高市総理）\n　日米首脳会談におきましては、先方からはＩＣＣの話はございませんでした。しかしながら、私の方からあえてですね、日本は一貫してＩＣＣを支持している、支持していくという旨をお話しした上で、率直なやり取りを行いました。その詳細について申し上げることはいたしませんけれども、日本の考え方というものをしっかりお伝えいたしました。\n　この後どうなっていくかということでございますけれども、米国のＩＣＣに対する不信感というものは非常に大きく、またその姿勢っていうのは大変厳しいものであると認識をしています。大変難しい状況ではありますが、首脳会談の席でですね、今後、ルビオ国務長官と茂木外務大臣の間で、意思疎通をさせていこうということになりました。\n　その他にも関係国多数ございますので、関係国との意思疎通を日本としては続けていく、しっかりと取り組んでいくという考えでございます。"}}},"rest_id":"2103458335953650104","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"573265","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103458335953650104","sortIndex":"2103981001838428143"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1769285,"following":47},"relationship_perspectives":{"blocked_by":fal