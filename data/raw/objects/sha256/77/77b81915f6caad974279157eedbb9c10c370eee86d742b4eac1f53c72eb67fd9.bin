:"https://video.twimg.com/amplify_video/2103452789431218176/vid/avc1/1080x1920/1FZX96ZbJrtwgvWr.mp4?tag=29"}]}}]},"favorite_count":2288,"favorited":false,"full_text":"「日本スタートアップ大賞2026」表彰式を開催しました。今回、内閣総理大臣賞に輝いたのは「株式会社Mujin」です。高市内閣では、戦略的な国内投資を全国に広げていくため、『日本成長戦略』において、「スタートアップ」を横断的課題の１つに位置付けています。スタートアップの皆様に、「戦略１７分 https://t.co/4KGXnjOAlG","id_str":"2103453003470745903","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":14,"reply_count":107,"retweet_count":256,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM0NTMwMDM0Mjg4NDc2MTY=","richtext":{"richtext_tags":[]},"text":"「日本スタートアップ大賞2026」表彰式を開催しました。今回、内閣総理大臣賞に輝いたのは「株式会社Mujin」です。高市内閣では、戦略的な国内投資を全国に広げていくため、『日本成長戦略』において、「スタートアップ」を横断的課題の１つに位置付けています。スタートアップの皆様に、「戦略１７分野」の国内投資を牽引する重要な担い手になっていただくことを大いに期待しています。"}}},"rest_id":"2103453003470745903","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"64824","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103453003470745903","sortIndex":"2103981001838428142"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"cor