se},"display_url":"pic.x.com/3Mvj6BZXZA","expanded_url":"https://x.com/kantei/status/2103429489963540991/video/1","ext_media_availability":{"status":"Available"},"id_str":"2103427434339311616","indices":[131,154],"media_key":"13_2103427434339311616","media_results":{"result":{"media_key":"13_2103427434339311616"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2103427434339311616/img/E2gllozP585XPC0-.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/3Mvj6BZXZA","video_info":{"aspect_ratio":[16,9],"duration_millis":131733,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2103427434339311616/pl/DipN6qTBkUIcbqnv.m3u8?tag=29&v=a54"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103427434339311616/vid/avc1/480x270/HvUpO4XPiYPmn-zT.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103427434339311616/vid/avc1/640x360/T9B04Bj1ePbj71bf.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103427434339311616/vid/avc1/1280x720/btOR-iQ-idO_bTmH.mp4?tag=29"}]}}]},"favorite_count":4503,"favorited":false,"full_text":"【お知らせ】\n本日（９月２５日）、高市総理は、日本スタートアップ大賞2026表彰を行いました。\n\n※高市総理発言要旨（速報版）\n　こんにちは。\n　「日本スタートアップ大賞2026」表彰式の開催にあたりまして、御挨拶を申し上げます。今回、「日本スタートアップ大賞 https://t.co/3Mvj6BZXZA","id_str":"2103429489963540991","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":46,"reply_count":150,"retweet_count":523,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM0Mjk0ODk4OTY0MTExMzc=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（９月２５日）、高市総理は、日本スタートアップ大賞2026表彰を行いました。\n\n※高市総理発言要旨（速報版）\n　こんにちは。\n　「日本スタートアップ大賞2026」表彰式の開催にあたりまして、御挨拶を申し上げます。今回、「日本スタートアップ大賞　内閣総理大臣賞」に選ばれたのは、「株式会社Mujin」です。\n　「Mujin」は、産業用ロボットに、見て、考える力を与えて、物流・製造現場を自動化する「フィジカルＡＩ」の開発・実装を進めておられ、「Mujin」のロボットを導入した配送センターでは、多様な日用品を出荷先ごとに異なる構成で積み込む作業を、ロボットが全自動で行うことで、大幅に作業が効率化したと伺っております。\n　次世代のロールモデルとなるスタートアップであります、「Mujin」の皆様、誠に受賞おめでとうございます。\n　そして、各賞を受賞された皆様にも心からお祝いを申し上げます。おめでとうございます。\n　高市内閣では、戦略的な国内投資を全国に広げていくために、『日本成長戦略』において、「スタートアップ」を横断的課題の１つに位置付けております。\n　スタートアップの皆様が、「フィジカルＡＩ」を含む「ＡＩ・半導体」、また「防衛産業」、「航空・宇宙」、また「フードテック」など、様々な分野、「戦略１７分野」の国内投資を牽引する重要な担い手になっていただくことを大いに期待いたしております。\n　本日お集まりの皆様の益々の御活躍を祈念するとともに、皆様が、まさにこれから起業しようと、志しておられる方々の励みとなり、我が国でスタートアップの創出が進み、日本の未来を切り拓いていくということを期待しています。誠におめでとうございました。"}}},"rest_id":"2103429489963540991","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"104225","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103429489963540991","sortIndex":"2103981001838428134"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_g