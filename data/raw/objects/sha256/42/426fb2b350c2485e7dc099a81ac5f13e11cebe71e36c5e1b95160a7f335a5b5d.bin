"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/V6YcLr1mmj","video_info":{"aspect_ratio":[16,9],"duration_millis":95833,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2110718083107287040/pl/tWNLPrHWKqGMO0r0.m3u8?tag=29&v=d8c"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718083107287040/vid/avc1/480x270/ytGIaNEeVF3gXTS3.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718083107287040/vid/avc1/640x360/apsdttTCXdG6WN4U.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718083107287040/vid/avc1/1280x720/fNxpyWK8dlpBvE1l.mp4?tag=29"}]}}]},"favorite_count":517,"favorited":false,"full_text":"【お知らせ】\n本日（１０月１５日）、高市総理は、令和８年安全安心なまちづくり関係功労者表彰式を行いました。\n\n※高市総理挨拶要旨(速報版)\n　安全安心なまちづくり関係功労者表彰を受賞された皆様、本日は、誠におめでとうございます。 https://t.co/V6YcLr1mmj","id_str":"2110718371759288373","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":40,"retweet_count":68,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA3MTgzNzE2OTY0NjM4NzI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月１５日）、高市総理は、令和８年安全安心なまちづくり関係功労者表彰式を行いました。\n\n※高市総理挨拶要旨(速報版)\n　安全安心なまちづくり関係功労者表彰を受賞された皆様、本日は、誠におめでとうございます。 \n　皆様は、平素から、それぞれの地域・分野で防犯や再犯防止に関する取組にご尽力いただいており、長年にわたる多大なご貢献に対し、心より敬意を表し、感謝を申し上げます。 \n　良好な治安は、「日本列島を、強く豊かに」するための基盤となるものです。 \n　皆様の活動は、 \n・地域の防犯パトロール、 \n・サイバー空間の安全利用に関する広報啓発、 \n・犯罪をした人の社会復帰支援など、 \n　地域の暮らしと安全を守るために不可欠な活動です。 \n　政府としても、 皆様をはじめ、各地域で活動されている皆様と一層連携し、今を生きる国民の皆様も、未来を生きる国民の皆様も、安全で安心して暮らせる国を創るため、全力で取り組んでまいります。  \n　皆様のますますのご健勝とご活躍をお祈り申し上げます。"}}},"rest_id":"2110718371759288373","unmention_data":{},"views":{"count":"22346","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110718371759288373","sortIndex":"2110747967672549369"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3015527,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":fa