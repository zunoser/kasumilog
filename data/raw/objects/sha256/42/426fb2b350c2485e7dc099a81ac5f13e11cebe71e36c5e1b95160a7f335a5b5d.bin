0712908284096512"}},"media_url_https":"https://pbs.twimg.com/media/HUrCNQEa8AAVjKP.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":433,"y":0},{"h":1734,"w":1521,"x":540,"y":0},{"h":1734,"w":867,"x":867,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/lhlkPkioTD"}]},"favorite_count":4019,"favorited":false,"full_text":"本日、「令和8年 安全安心なまちづくり関係功労者 表彰式」を開催し、15の個人・団体の皆様を表彰させていただきました。\n\n安全安心なまちづくり関係功労者表彰を受賞された皆様は、平素から、それぞれの地域・分野で、防犯や再犯防止に関する取組にご尽力いただいている皆様です。 https://t.co/lhlkPkioTD","id_str":"2110712935660327380","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":46,"reply_count":370,"retweet_count":353,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA3MTI5MzU1OTMxODUyODA=","richtext":{"richtext_tags":[]},"text":"本日、「令和8年 安全安心なまちづくり関係功労者 表彰式」を開催し、15の個人・団体の皆様を表彰させていただきました。\n\n安全安心なまちづくり関係功労者表彰を受賞された皆様は、平素から、それぞれの地域・分野で、防犯や再犯防止に関する取組にご尽力いただいている皆様です。\n\n長年にわたる多大なご貢献に対し、心より敬意を表し、感謝を申し上げました。\n\n良好な治安は、「日本列島を、強く豊かに」するための基盤であり、地域の防犯パトロール、サイバー空間の安全利用に関する広報啓発、犯罪をした人の社会復帰支援などの活動は、地域の暮らしと安全を守るために不可欠なものです。\n\n政府としても、各地域で活動されている皆様と一層連携し、安全で安心して暮らせる国を創るため、全力で取り組んでいきます。\n\n表彰を受けられた皆様の益々のご活躍を、お祈り申し上げます。"}}},"rest_id":"2110712935660327380","unmention_data":{},"views":{"count":"127965","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110712935660327380","sortIndex":"2110747967672549368"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryTy