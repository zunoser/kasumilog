50,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/RZfNpnkaBi"},{"display_url":"pic.x.com/RZfNpnkaBi","expanded_url":"https://x.com/ModJapan_jp/status/2110664373236621583/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2110664367725592576","indices":[132,155],"media_key":"3_2110664367725592576","media_results":{"result":{"media_key":"3_2110664367725592576"}},"media_url_https":"https://pbs.twimg.com/media/HUqWD0ZbwAA136E.jpg","original_info":{"focus_rects":[{"h":385,"w":688,"x":241,"y":0},{"h":385,"w":385,"x":393,"y":0},{"h":385,"w":338,"x":416,"y":0},{"h":385,"w":193,"x":489,"y":0},{"h":385,"w":1170,"x":0,"y":0}],"height":385,"width":1170},"sizes":{"large":{"h":385,"resize":"fit","w":1170},"medium":{"h":385,"resize":"fit","w":1170},"small":{"h":224,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/RZfNpnkaBi"}]},"favorite_count":967,"favorited":false,"full_text":"令和８年１０月１４日、太平洋上において中国海軍クズネツォフ級空母「遼寧」から艦載機の発着艦を約１０回、確認しました。\nその後、１５日に空母「遼寧」、レンハイ級ミサイル駆逐艦２隻及びルーヤンⅢ級ミサイル駆逐艦の計４隻が、南シナ海へ向けて航行したことを確認しました。 https://t.co/RZfNpnkaBi","id_str":"2110664373236621583","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":16,"quoted_status_id_str":"2110662738573992119","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2110662738573992119","url":"https://t.co/JlRIEE3MF0"},"reply_count":19,"retweet_count":291,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA2NjQzNzMxODIwMjk4MjQ=","text":"令和８年１０月１４日、太平洋上において中国海軍クズネツォフ級空母「遼寧」から艦載機の発着艦を約１０回、確認しました。\nその後、１５日に空母「遼寧」、レンハイ級ミサイル駆逐艦２隻及びルーヤンⅢ級ミサイル駆逐艦の計４隻が、南シナ海へ向けて航行したことを確認しました。\n防衛省・自衛隊は、第１水上戦隊所属「ゆうぎり」（横須賀）により、警戒監視・情報収集を行いました。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360753,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6369,"tweets":12414},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2110662738573992119"],"editable_