":"https://t.co/t5QOGKi6yN"}]},"favorite_count":565,"favorited":false,"full_text":"令和８年１０月１５日（木）午後、中国軍の情報収集機（Ｙ-９）×１機が大陸方面から飛来し、東シナ海上の長崎県男女群島の南方沖から沖縄本島の北西沖にかけて往復飛行を行った後、大陸方面に向けて飛行したことを確認した。 https://t.co/t5QOGKi6yN","id_str":"2110677368532824417","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"quoted_status_id_str":"2110675865172684924","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2110675865172684924","url":"https://t.co/a1xdL3389f"},"reply_count":8,"retweet_count":147,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA2NzczNjg0ODY3MzU4NzI=","text":"令和８年１０月１５日（木）午後、中国軍の情報収集機（Ｙ-９）×１機が大陸方面から飛来し、東シナ海上の長崎県男女群島の南方沖から沖縄本島の北西沖にかけて往復飛行を行った後、大陸方面に向けて飛行したことを確認した。\nこれに対し、航空自衛隊の西部航空方面隊等の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360753,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6369,"tweets":12414},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2110675865172684924"],"editable_until_msecs":"1792062915000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":7,"bookmarked":false,"conversation_id_str":"2110675865172684924","created_at":"Thu Oct 15 10:15:15 +0000 2026","display_text_range":[0,105],"entities":{"media":[{"display_url":"pic.x.com/pbZbvGJfgR","expanded_url":"https://x.com/jointstaffpa/status/2110675865172684924/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2110675860609277952","indices":[106,129],"media_key":"3_2110675860609277952","media_results":{"result":{"media_key":"3_2110675860609277952"}},"media_url_https":"https://pbs.twimg.com/media/HUqggyuboAA3K_M.png","original_info":{"focus_rects":[{"h":459,"w":820,"x":0,"y":156},{"h":615,"w":615,"x":0,"y":0},{"h":615,"w":539,"x":38,"y":0},{"h":615,"w":308,"x":153,"y":0},{"h":615,"w":820,"x":0,