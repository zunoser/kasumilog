968","media_results":{"result":{"media_key":"13_2110662355436883968"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2110662355436883968/img/XWU87NniZ1VtwvRH.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/LsrDG0OF0K","video_info":{"aspect_ratio":[16,9],"duration_millis":219866,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2110662355436883968/pl/N1LzaTAvOq8-Udt0.m3u8?tag=29&v=f0c"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110662355436883968/vid/avc1/480x270/JPSzi0qqlH90cpt6.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110662355436883968/vid/avc1/640x360/6JJZVF2X-g9jHaNS.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110662355436883968/vid/avc1/1280x720/wHMvFEZQ8TTSqmEJ.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/LsrDG0OF0K","expanded_url":"https://x.com/kantei/status/2110662781959799107/video/1","ext_media_availability":{"status":"Available"},"id_str":"2110662355436883968","indices":[126,149],"media_key":"13_2110662355436883968","media_results":{"result":{"media_key":"13_2110662355436883968"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2110662355436883968/img/XWU87NniZ1VtwvRH.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/LsrDG0OF0K","video_info":{"aspect_ratio":[16,9],"duration_millis":219866,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2110662355436883968/pl/N1LzaTAvOq8-Udt0.m3u8?tag=29&v=f0c"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110662355436883968/vid/avc1/480x270/JPSzi0qqlH90cpt6.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110662355436883968/vid/avc1/640x360/6JJZVF2X-g9jHaNS.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110662355436883968/vid/avc1/1280x720/wHMvFEZQ8TTSqmEJ.mp4?tag=29"}]}}]},"favorite_count":706,"favorited":false,"full_text":"【お知らせ】\n本日（１０月１５日）、天皇皇后両陛下の御臨席の下、高市総理は、都内で開催された地球環境行動会議（ＧＥＡ）国際会議２０２６開会式に出席しました。 \n\n※高市総理挨拶要旨（速報版）\n　皆様、おはようございます。天皇皇后両陛下の御臨席を仰ぎ、 https://t.co/LsrDG0OF0K","id_str":"2110662781959799107","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":8,"retweet_count":89,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA2NjI3ODE4Njc2MDYwMTY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月１５日）、天皇皇后両陛下の御臨席の下、高市総理は、都内で開催された地球環境行動会議（ＧＥＡ）国際会議２０２６開会式に出席しました。 \n\n※高市総理挨拶要旨（速報版）\n　皆様、おはようございます。天皇皇后両陛下の御臨席を仰ぎ、 「ＧＥＡ国際会議２０２６」が開催されることを、心よりお慶び申し上げます。 \n　本年も、日本を含め世界各地で、極めて深刻な被害をもたらす災害が発生しており、自然災害が激甚化・頻発化しています。 \n　日本も多くの自然災害に見舞われています。国内外でかけがえのない命を落とされた多くの方々の御霊に哀悼の誠を捧げますとともに、被災された皆様にお見舞いを申し上げます。 \n　災害に対する強靱性の向上のため、 防災などの「危機管理投資」を強化します。 \n　あわせて、世界屈指の我が国の防災や復興の知見・ノウハウを、「国際防災協力」を通じて共有していきます。 \n　今を生きる人々の命と未来を生きる人々の命を守るため、全ての国が、 「気候変動対策」に真剣に取り組む必要があります。 \n　私は、「気候変動対策」と「経済成長」は両立できると信じております。 \n　日本はこれまで、 \n・グリーン鉄を始めとした生産・技術基盤の構築、 \n・世界最高効率のガス火力発電の利用、 \n・更には、省エネ型データセンターの普及など、 \n日本の技術力を生かし、２０５０年のネット・ゼロを目指して、ＧＸの取組を進めております。 \n　これらの取組を、「エネルギー需給構造強靱化総合パッケージ（パワーＧＸ）」として強力に進めます。 \n　そして、「脱炭素化」と「エネルギー安全保障」、「経済成長」の同時達成を目指しております。\n　「アジア・ゼロエミッション共同体（ＡＺＥＣ）」での取組を通じて、世界の気候変動対策に貢献していきます。 \n　「２０２７年国際園芸博覧会」は、日本の魅力を世界に届ける絶好の機会です。 \n　花や緑、食と農の魅力はもちろんのこと、脱炭素など地球環境の課題解決に資する優れた国内技術も、世界に発信してまいります。 \n　本日の会議には、世界を代表する企業、科学者、さらに、各国の政府関係者の皆様もいらしております。 \n　地球環境の保全と豊かな、そして持続可能な未来に向けて、活発で実りある議論が行われることを大いに期待いたしております。 \n　結びに、御臨席の皆様の御健康と、今後益々の御活躍をお祈り申し上げます。"}}},"rest_id":"2110662781959799107","unmention_data":{},"views":{"count":"40600","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110662781959799107","sortIndex":"2110747967672549346"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1674231387166220288/iK7GwtIr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/180585090/1680484704"},"core":{"created_at":"Fri Aug 20 00:19:17 +0000 2010","name":"厚生労働省","screen_name":"MHLWitter"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODA1ODUwOTA=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"厚生労働省の公式アカウントです。\n健康・医療、福祉・介護、雇用・労働、年金など、皆さまの暮らしを支える情報をお届けします。\n\n※このXに寄せられたコメントへの返信はしておりません。\n\n【運用方針】\nhttps://t.co/dQtOdVs4pp","entities":{"description":{"urls":[{"display_url":"mhlw.go.jp/content/1020