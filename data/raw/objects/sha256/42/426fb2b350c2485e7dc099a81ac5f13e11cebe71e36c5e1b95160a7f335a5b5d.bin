,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=jpg&name=120x120","width":120},"type":"IMAGE"}},{"key":"description","value":{"string_value":"　大量の個人情報を取り扱う事業者等の情報システムが不正アクセスにより侵入され、個人情報を含むデータが窃取される事案が相次いで確認されています。 　このような状況を踏まえ、内閣官房国家サイバー統括室から、事業者等に対し、迅速な脆弱性対応や、多要素認証等の認証機能の強化、漏えいした情報の悪用を防止する対策等について、委託先も含めた一層の対策の徹底を速やかに検討するよう、注意喚起が行われています。...","type":"STRING"}},{"key":"domain","value":{"string_value":"www.soumu.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=jpg&name=120x120","width":120},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=jpg&name=orig","width":120},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"1469058582","path":[]}}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=png&name=2048x2048_2_exp","width":120},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"soumu.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":61.44,"rgb":{"blue":255,"green":255,"red":255}},{"percentage":34.99,"rgb":{"blue":31,"green":140,"red":246}},{"percentage":2.69,"rgb":{"blue":159,"green":204,"red":251}},{"percentage":0.76,"rgb":{"blue":103,"green":176,"red":250}},{"percentage":0.12,"rgb":{"blue":92,"green":169,"red":24