":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/ol75FY7PCl","video_info":{"aspect_ratio":[16,9],"duration_millis":348900,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2110668596720676864/pl/CbHzHMuBxhye76ai.m3u8?tag=29&v=1ca"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110668596720676864/vid/avc1/480x270/W4YStowHMEv48LEE.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110668596720676864/vid/avc1/640x360/rdwDrF9yGDTbxQ3s.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110668596720676864/vid/avc1/1280x720/aRlRQwICUcLj93uT.mp4?tag=29"}]}}]},"favorite_count":2505,"favorited":false,"full_text":"【お知らせ】\n本日（１０月１５日）、高市総理は、閣僚人事等についてのぶらさがり会見を行いました。\n \n※要旨（速報版）\n（高市総理） https://t.co/ol75FY7PCl","id_str":"2110668760428552686","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":36,"reply_count":168,"retweet_count":314,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA2Njg3NjAzMDI3MDI1OTI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月１５日）、高市総理は、閣僚人事等についてのぶらさがり会見を行いました。\n \n※要旨（速報版）\n（高市総理）\n　お疲れ様でございます。簗大臣の後任となる農林水産大臣につきましては、武部新衆議院議員にお願いをすることといたしました。本日、この後、所定の手続きを行います。武部議員には、先ほど私から、農林水産業の振興及び農山漁村の発展の実現、そしてまた「食料安全保障」の強化、そしてフードテックですね、例えば植物工場ですとか陸上養殖ですとか、また衛星情報のＡＩ解析など、こういった新しい技術を活用した農林水産業の強化、こういったことにも取り組んでほしいということで指示をいたしました。国会の開会から間もない登板となりますけれども、武部新議員はこれまで農林水産副大臣としても活躍をし、そしてまた党政調会におきましても農林部会長、そして水産総合調査会長も務め、農林水産行政には精通している人物でございます。即戦力として国会対応も含め活躍をしていただけるという考えから私は選ばせていただきました。私のほうから、冒頭、以上でございます。\n\n（記者）\n　高市総理は昨日辞任した簗農相の後任として、武部新衆議院議員を起用することとしました。武部氏を選んだ理由と狙い、また改めて武部氏に求めたい役割について教えてください。\n（高市総理）\n　ただいま申し上げたような指示をしたのですけれども、やはり農林水産行政に精通しているということ、そして、例えばですね、鳥獣害対策も含めて事務局長、特別委員会で努めていただくなど、非常に幅広く農林水産行政の課題にも対応できる人でございます。ですから、やはり「食料安全保障」の確保、これはもう何より急がなくてはいけませんし、新しい技術ですね、これをもっと国内で普及をし、ひいては海外展開もしていける、日本の輸出産業になるような形、これもシステムそのものをですね、海外に展開していけるような形、これを作ってほしいということ。そして、大変優れた日本の農林水産品、また食品、これもできるだけこの販路を開拓して海外に展開していく。海外に輸出ができるということは、これはいざとなったら国内で消費できますから、食料自給率を高めるということにもなるわけでございます。こういったことに真剣に取り組んでいただける人と判断をいたしております。\n（記者）\n　ロシアによる日本人記者の拘束について伺います。先日、ロシア当局によって日本人の記者が拘束され、依然として日本側は領事面会も実現できていない状況だと思いますが、こうした中で、ロシア側は一方的に当該記者が日本政府と連携してスパイ活動を行っていたというような発信を行っています。日本政府はこれに対して反論も抗議もしないのはなぜでしょうか。また、この記者の解放に向けてどのように取り組んでいくか、決意をお聞かせください、\n（高市総理）\n　既に官房長官会見でもお答えをしていると思いますけれども、これは、外務省が今一生懸命動いて、ロシア当局に対して申し入れもし、そしてこの面会も含めてですね、求めているという状況でございます。とにかく今は邦人の保護という、とても大事なことでございますので、そこに注力をしたいと考えております。\n（記者）\n　スパイ容疑に関してはいかがでしょうか。日本政府はロシアでスパイ活動を行っているのでしょうか。\n（高市総理）\n　そのような事実はございません。その容疑と向こうがおっしゃることの捉え方、それぞれ国内法も違いますから、その容疑とおっしゃっていることの詳細もまだわかりませんけれども、しかしながら、日本は日本の立場をしっかりと伝えていくということでございます。\n（記者）\n　農水大臣の関連でお伺いします。前任の大臣が予算カット発言ですとか公選法違反の疑惑を受けての辞任となりました。国民の信頼回復という点で新しい大臣に期待することをお伺いしたいです。\n（高市総理）\n　新しい大臣に期待することということになりますと、これは信頼回復というよりは、むしろ農林水産行政が遅滞なく進み、そしてまた新たな展開が開けていく、日本の農林水産業はすごいぞ、食品産業もすごいぞ、こういう姿を見せていくために全力を尽くしていただくということだと思っております。"}}},"rest_id":"2110668760428552686","unmention_data":{},"views":{"count":"86078","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110668760428552686","sortIndex":"2110747967672549358"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2107316172916130039"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":591274,"following":204},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20309,"tweets":49048},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2110668538579157195"],"editable_until_msecs":"1792061168000","edits_remainin