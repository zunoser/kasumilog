":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjAzOTgyMzQ0NTE2MjgwMzI=","richtext":{"richtext_tags":[]},"text":"【鳥インフルエンザ】\n京都府において鳥インフルエンザの疑い事例が確認されたため、総理は以下の4点を指示（11月11日13時40分に指示）。\n１．鳥インフルエンザと考えられる家きんが確認された場合、農林水産省はじめ関係各省が緊密に連携し、徹底した防疫措置を迅速に進めること。\n２．現場の情報をしっかり収集すること。\n３．家きん業者に対し、厳重な警戒を要請するとともに、予防措置について適切な指導・支援を行うこと。\n４．国民に対して正確な情報を迅速に伝えること。"}}},"rest_id":"2120398234501910994","unmention_data":{},"views":{"count":"20779","state":"EnabledWithCount"}}},"user_id_str":"412940784"},"rest_id":"2120398313786913108","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1587","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120398313786913108","sortIndex":"2120400536141299712"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":1},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1369820966382039040/xn_dTvqx_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2931953732/1741141864"},"core":{"created_at":"Tue Dec 16 07:14:59 +0000 2014","name":"復興庁","screen_name":"Fukkocho_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTMxOTUzNzMy","is_blue_verified":false,"location":{"