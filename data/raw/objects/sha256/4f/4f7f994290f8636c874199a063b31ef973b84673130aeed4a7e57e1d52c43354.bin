"w":1200},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/leTUGfh7Io"}]},"favorite_count":3,"favorited":false,"full_text":"／\n地域社会DXに取り組む皆様に\n     #地域社会DXナビ ！\n＼\n栃木県那須町は行楽シーズンの交通渋滞を解消するため、総務省事業を活用して那須高原地域の渋滞対策計画を策定しました。県などの関係機関と具体的な施策を打ち出し、渋滞緩和を実現させたい考えです。\n詳しくは👉https://t.co/33czhn3xkz https://t.co/leTUGfh7Io","id_str":"2120396167532147144","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":0,"retweeted":false,"user_id_str":"1469058582"},"rest_id":"2120396167532147144","unmention_data":{},"views":{"count":"583","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120396167532147144","sortIndex":"2120400536141299710"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1793582764"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2119704741051785477"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6l1S0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":299051,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4992,"tweets":13016},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2120396102285561863"],"editable_until_msecs":"1794380400000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2120396102285561863","created_at":"Wed Nov 11 06:00:00 +0000 2026","display_text_range":[0,137],"entities":{"media":[{"display_url":"pic.x.com/3wuBm0jqBJ","expanded_url":"https://x.com/gov_online/status/2120396102285561863/photo/1","ext_alt_text":"上部に「2026年9月1日から生活道路の法定速度が時速30キロメートルに変わりました」と記載されており、その下に、住宅街の生活道路で、右手前の車から「時速30キロメートル」と書かれた吹き出しと、その横には歩く小学生と高齢者、自転車に乗る人のイラストが描かれている。その下には、次のように記載されている。「主に地域住民の日常生活で利用されるような、中央線や中央分離帯などがない生活道路です。なぜ生活道路の法定速度は引き下げられたの？自動車の速度が時速30キロメートルを超えると、衝突時に歩行者が死亡する危険性（致死率）が急激に高まること（警察庁調査）などを踏まえ、生活道路全体で交通事故を防ぐため、法定速度が引き下げられました。※道路標識・道路標示で最高速度が指定されている場合は、その速度に従いましょう。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":69,"w":69,"x":507,"y":570}]},"medium":{"faces":[{"h":61,"w":61,"x":450,"y":506}]},"orig":{"faces":[{"h":69,"w":69,"x":507,"y":570}]},"small":{"faces":[{"h":34,"w":34,"x":255,"y":286}]}},"id_str":"2120330915096530944","indices":[138,161],"media_key":"3_2120330915096530944","media_results":{"result":{"media_key":"3_2120330915096530944"}},"media_url_https":"https://pbs.twimg.com/media/HWztu7ibkAAzt5C.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":1200,"w":1200,"x":0,"y":0},{"h":1350,"w":1184,"x":0,"y":0},{"h":1350,"w":675,"x":0,"y":0},{"h":1350,"w":1200,"x":0,"y":0}],"height":1350,"width":1200},"sizes":{"large":{"h":1350,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/3wuBm0jqBJ"},{"display_url":"pic.x.com/3wuBm0jqBJ","expanded_url":"https://x.com/gov_online/status/2120396102285561863/photo/1","ext_alt_text":"「自動車の法定速度が時速30キロメートルとなる生活道路の例」と記載された下に、自動車の法定速度が時速30キロメートルとなる生活道路の3つの例の写真が並んでいる。その下には、次のように記載されている。「次のような道路は、今回の法定速度引下げの対象外です。中央線又は車両通行帯が設けられている一般道路。中央分離帯などが設けられ、自動車の通行が往復の方向別に分離されている一般道路。高速自動車国道の本線車道並びにこれに接する加速車線及び減速車線を除いたもの（例として、料金所や一般道路と高速道路をつなぐ、いわゆる「ランプ」）。自動車専用道路。写真提供：警察庁。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":81,"w":81,"x":59,"y":891}]},"medium":{"faces":[{"h":72,"w":72,"x":52,"y":792}]},"orig":{"faces":[{"h":81,"w":81,"x":59,"y":891}]},"small":{"faces":[{"h":40,"w":40,"x":29,"y":448}]}},"id_str":"2120330822863704064","indices":[138,161],"media_key":"3_2120330822863704064","media_results":{"result":{"media_key":"3_2120330822863704064"}},"media_url_https":"https://pbs.twimg.com/media/HWztpj8aUAAXw9h.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":1200,"w":1200,"x":0,"y":0},{"h":1350,"w":1184,"x":0,"y":0},{"h":1350,"w":675,"x":0,"y":0},{"h":1350,"w":1200,"x":0,"y":0}],"height":1350,"width":1200},"sizes":{"large":{"h":1350,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/3wuBm0jqBJ"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/3wuBm0jqBJ","expanded_url":"https://x.com/gov_online/status/2120396102285561863/photo/1","ext_alt_text":"上部に「2026年9月1日から生活道路の法定速度が時速30キロメートルに変わりました」と記載されており、その下に、住宅街の生活道路で、右手前の車から「時速30キロメートル」と書かれた吹き出しと、その横には歩く小学生と高齢者、自転車に乗る人のイラストが描かれている。その下には、次のように記載されている。「主に地域住民の日常生活で利用されるような、中央線や中央分離帯などがない生活道路です。なぜ生活道路の法定速度は引き下げられたの？自動車の速度が時速30キロメートルを超えると、衝突時に歩行者が死亡する危険性（致死率）が急激に高まること（警察庁調査）などを踏まえ、生活道路全体で交通事故を防ぐため、法定速度が引き下げられました。※道路標識・道路標示で最高速度が指定されている場合は、その速度に従いましょう。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":69,"w":69,"x":507,"y":570}]},"medium":{"faces":[{"h":61,"w":61,"x":450,"y":506}]},"orig":{"faces":[{"h":69,"w":69,"x":507,"y":570}]},"small":{"faces":[{"h":34,"w":34,"x":255,"y":286}]}},"id_str":"2120330915096530944","indices":[138,161],"media_key":"3_2120330915096530944","media_results":{"result":{"media_key":"3_2120330915096530944"}},"media_url_https":"https://pbs.twimg.com/media/HWztu7ibkAAzt5C.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":1200,"w":1200,"x":0,"y":0},{"h":1350,"w":1184,"x":0,"y":0},{"h":1350,"w":675,"x":0,"y":0},{"h":1350,"w":1200,"x":0,"y":0}],"height":1350,"width":1200},"sizes":{"large":{"h":1350,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/3wuBm0jqBJ"},{"display_url":"pic.x.com/3wuBm0jqBJ","expanded_url":"https://x.com/gov_online/status/2120396102285561863/photo/1","ext_alt_text":"「自動車の法定速度が時速30キロメートルとなる生活道路の例」と記載された下に、自動車の法定速度が時速30キロメートルとなる生活道路の3つの例の写真が並んでいる。その下には、次のように記載されている。「次のような道路は、今回の法定速度引下げの対象外です。中央線又は車両通行帯が設けられている一般道路。中央分離帯などが設けられ、自動車の通行が往復の方向別に分離されている一般道路。高速自動車国道の本線車道並びにこれに接する加速車線及び減速車線を除いたもの（例として、料金所や一般道路と高速道路をつなぐ、いわゆる「ランプ」）。自動車専用道路。写真提供：警察庁。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":81,"w":81,"x":59,"y":891}]},"medium":{"faces":[{"h":72,"w":72,"x":52,"y":792}]},"orig":{"faces":[{"h":81,"w":81,"x":59,"y":891}]},"small":{"faces":[{"h":40,"w":40,"x":29,"y":448}]}},"id_str":"2120330822863704064","indices":[138,161],"media_key":"3_2120330822863704064","media_results":{"result":{"media_key":"3_2120330822863704064"}},"media_url_https":"https://pbs.twimg.com/media/HWztpj8aUAAXw9h.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":1200,"w":1200,"x":0,"y":0},{"h":1350,"w":1184,"x":0,"y":0},{"h":1350,"w":675,"x":0,"y":0},{"h":1350,"w":1200,"x":0,"y":0}],"height":1350,"width":1200},"sizes":{"large":{"h":1350,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/3wuBm0jqBJ"}]},"favorite_count":6,"favorited":false,"full_text":"🚗生活道路の法定速度が変わりました\n\n2026年9月から、中央線や中央分離帯がない生活道路では、自動車の法定速度が30km/hになっています。\n\nただし、道路標識などで別に最高速度が指定されている場合は、その速度に従ってください。\nルールを確認し、安全運転を心がけましょう。 https://t.co/3wuBm0jqBJ","id_str":"2120396102285561863","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":4,"retweeted":false,"user_id_str":"461064204"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"gov-online.go.jp/article/202610…","expanded_url":"https://www.gov-online.go.jp/article/202610/entry-11684.html","indices":[138,161],"url":"https://t.co/h4axgVdMNX"}],"user_mentions":[{"id_str":"2891516809","indices":[162,171],"name":"警察庁","screen_name":"NPA_KOHO"}]},"id":"Tm90ZVR3ZWV0OjIxMjAzOTYxMDIxNzIzMDc0NTY=","text":"🚗生活道路の法定速度が変わりました\n\n2026年9月から、中央線や中央分離帯がない生活道路では、自動車の法定速度が30km/hになっています。\n\nただし、道路標識などで別に最高速度が指定されている場合は、その速度に従ってください。\nルールを確認し、安全運転を心がけましょう。\nhttps://t.co/h4axgVdMNX\n@NPA_KOHO"}}},"rest_id":"2120396102285561863","unmention_data":{},"views":{"count":"1024","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120396102285561863","sortIndex":"2120400536141299709"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzY2ODI3OTE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関 "},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2001095001481076943"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国税庁の公式アカウントです。税に関する情報を提供します。税務行政に対するご意見・ご要望は国税庁ホームページまで。https://t.co/lVWKzTUjtp","entities":{"description":{"urls":[{"display_url":"nta.go.jp/iken/mail.htm","expanded_url":"https://www.nta.go.jp/iken/mail.htm","indices":[56,79],"url":"https://t.co/lVWKzTUjtp"}]},"url":{"urls":[{"di