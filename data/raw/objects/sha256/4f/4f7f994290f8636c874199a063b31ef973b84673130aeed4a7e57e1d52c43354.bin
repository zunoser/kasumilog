OUAVG5Q3AY"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjAzMTY0NTcwOTE1MzA3NTI=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、フランス政府の主催で開催された、AIセキュリティに関する会合にオンライン参加しました。高市総理から、フロンティアAIの安全性確保という目標を各国と共有しつつ、その実現には様々なアプローチがあり得る中、国際的な場で議論を深めることが重要であり、日本はAIサミットを早期に開催し、進化したFOIPの下、この分野での国際協力の進展に貢献していく旨述べました。\n（写真提供：内閣広報室）\n\nhttps://t.co/OUAVG5Q3AY"}}},"rest_id":"2120316457204826182","unmention_data":{},"views":{"count":"7425","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120316457204826182","sortIndex":"2120400536141299661"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/281874178/1611288198"},"core":{"created_at":"Thu Apr 14 04:13:40 +0000 2011","name":"特許庁","screen_name":"jpo_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODE4NzQxNzg=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関3-4-3"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"特許庁の公式アカウントです。特許庁ホームページの主な更新情報等に関する情報を提供します。運用方針は以下をご覧ください。https://t.co/7eNLi8gZcH　\n公的機関との間でのリプライやリツイートについて試行中です。","entities":{"description":{"urls":[{"display_url":"meti.go.jp/sns/sns_policy…","expanded_url":"https://www.meti.go.