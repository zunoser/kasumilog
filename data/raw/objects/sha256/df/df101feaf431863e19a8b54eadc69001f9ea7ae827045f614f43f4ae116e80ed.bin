,"w":362,"x":638,"y":0},{"h":723,"w":1000,"x":0,"y":0}],"height":723,"width":1000},"sizes":{"large":{"h":723,"resize":"fit","w":1000},"medium":{"h":723,"resize":"fit","w":1000},"small":{"h":492,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/1ENDKTqw4T"}]},"favorite_count":104,"favorited":false,"full_text":"「たびレジ」及び在留届に関する広報動画の公開及び今年度１回目となる「官民合同テロ・誘拐対策実地訓練（国内）」を実施しました。\n\nhttps://t.co/cA8uEkK0on https://t.co/1ENDKTqw4T","id_str":"2097981094427795788","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":10,"retweet_count":19,"retweeted":false,"user_id_str":"303730149"},"rest_id":"2097981094427795788","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"17109","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097981094427795788","sortIndex":"2098270738594136007"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2995506,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":530,"tweets":1771},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2097978070045208900"],"editable_until_msecs":"1789035525000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":237,"bookmarked":false,"conversation_id_str":"2097978070045208900","created_at":"Thu Sep 10 09:18:45 +0000 2026","display_text_range":[0,122],"entities":{},"favorite_count":24055,"favorited":false,"full_text":"昨日、米国で最も権威のある生物医学研究賞として知られる「ラスカー賞」が発表され、\n・中外製薬の研究者である服部有宏さん、北沢剛久さん、井川智之さんの3名が「臨床医学賞」を、\n・筑波大学の柳沢正史教授が「基礎医学賞」を、\nそれぞれ受賞されました。","id_str":"2097978070045208900","is_quote_status":false,"lang":"ja","quote_count":162,"reply_count":1092,"retweet_count":2412,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTc5NzgwNjk5OTQ5MzQyNzI=","richtext":{"richtext_tags":[]},"text":"昨日、米国で最も権威のある生物医学研究賞として知られる「ラスカー賞」が発表され、\n・中外製薬の研究者である服部有宏さん、北沢剛久さん、井川智之さんの3名が「臨床医学賞」を、\n・筑波大学の柳沢正史教授が「基礎医学賞」を、\nそれぞれ受賞されました。\n受賞された皆様に対して、心よりお祝い申し上げます。\n\n中外製薬の研究者の3名は、血が止まりにくくなる先天性疾患である血友病Aの治療薬を開発されました。\n\nまた、筑波大学の柳沢教授は、睡眠・覚醒の機構を解明され、新たな治療薬の開発につながっています。\n\n我が国の研究者による優れた創薬研究の成果が高く評価されたことは、大変喜ばしいことであるとともに、我が国が長年にわたり積み重ねてきた基礎研究の水準の高さを世界に示すものであり、今後の医学・医療分野の発展の大きな弾みになるものです。\n\n高市内閣では、「創薬・先端医療」を成長戦略の17の戦略分野の1つに位置付け、我が国の強みである基礎研究を一層強化するとともに、その成果を着実に実用化へとつなげる「創薬エコシステム」の構築に取り組んでいます。\n我が国の創薬力の向上に向けて、官民一体となって取り組んでまいります。"}}},"rest_id":"2097978070045208900","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"535867","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097978070045208900","sortIndex":"2098270738594136006"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled"