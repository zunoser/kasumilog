rge":{"h":648,"resize":"fit","w":462},"medium":{"h":648,"resize":"fit","w":462},"small":{"h":648,"resize":"fit","w":462},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/oVlr7ezh4A"},{"display_url":"pic.x.com/oVlr7ezh4A","expanded_url":"https://x.com/ModJapan_jp/status/2097989381550395605/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097989373270818816","indices":[114,137],"media_key":"3_2097989373270818816","media_results":{"result":{"media_key":"3_2097989373270818816"}},"media_url_https":"https://pbs.twimg.com/media/HR2OOChaAAAM8K7.jpg","original_info":{"focus_rects":[{"h":433,"w":773,"x":54,"y":0},{"h":433,"w":433,"x":224,"y":0},{"h":433,"w":380,"x":250,"y":0},{"h":433,"w":217,"x":332,"y":0},{"h":433,"w":880,"x":0,"y":0}],"height":433,"width":880},"sizes":{"large":{"h":433,"resize":"fit","w":880},"medium":{"h":433,"resize":"fit","w":880},"small":{"h":335,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/oVlr7ezh4A"}]},"favorite_count":1065,"favorited":false,"full_text":"令和８年９月９日から１０日にかけて、ロシア海軍ヴィシニャ級情報収集艦が、沖大東島の東から北にかけての接続水域内を北西進した後、沖縄本島南東から久米島北西の接続水域を含む海域を航行し、東シナ海へ向けて航行したことを確認しました。 https://t.co/oVlr7ezh4A","id_str":"2097989381550395605","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"quoted_status_id_str":"2097984687339958433","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2097984687339958433","url":"https://t.co/PejX2YZxNJ"},"reply_count":21,"retweet_count":308,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTc5ODkzODE1MDQyOTA4MTY=","text":"令和８年９月９日から１０日にかけて、ロシア海軍ヴィシニャ級情報収集艦が、沖大東島の東から北にかけての接続水域内を北西進した後、沖縄本島南東から久米島北西の接続水域を含む海域を航行し、東シナ海へ向けて航行したことを確認しました。\n防衛省・自衛隊は、海上自衛隊の第３機雷戦隊所属「たかしま」（佐世保）及び第５航空群所属「Ｐ－３Ｃ」（那覇）により、警戒監視・情報収集を行いました。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360587,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6309,"tweets":12353},"verification":{"verified":false},"website":{"url":"https://