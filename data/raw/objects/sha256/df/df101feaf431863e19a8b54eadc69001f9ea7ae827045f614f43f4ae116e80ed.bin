shu.co.jp/","indices":[259,282],"url":"https://t.co/SOfn4Ugt5f"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTc5NzA0MDU0OTU2ODEwMjQ=","richtext":{"richtext_tags":[]},"text":"#令和8年熊本地震 の影響により、#JR九州 鹿児島本線（宇土駅～八代駅間）で運休が発生しています。9月18日からの #九州新幹線 の運行再開に伴い、熊本駅～新八代駅間において、#鹿児島本線 の復旧までの間、九州新幹線による振替輸送を実施いたします。これにより、乗車券、定期券、回数券等の有効なきっぷ（特急券は不要です。）で、新幹線、バス代行いずれもご乗車いただけます。あわせて、宇土駅～八代駅間の代行バス輸送について、運行ダイヤの見直しを行うこととしております。詳細はJR九州のHPをご確認ください。\n\n▼JR九州\nhttps://t.co/SOfn4Ugt5f"}}},"rest_id":"2097970405558640753","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"32294","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097970405558640753","sortIndex":"2098270738594136001"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2098270738594136128-tweet-2097970052842832190","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media