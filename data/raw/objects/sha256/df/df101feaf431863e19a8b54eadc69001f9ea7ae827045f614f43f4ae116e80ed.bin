verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2097952339051360458"],"editable_until_msecs":"1789029390000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":96,"bookmarked":false,"conversation_id_str":"2097952339051360458","created_at":"Thu Sep 10 07:36:30 +0000 2026","display_text_range":[0,139],"entities":{},"favorite_count":17379,"favorited":false,"full_text":"本日、第45回全国消防殉職者慰霊祭に出席し、追悼のことばを申し上げ、献花をさせていただきました。\n\nこのたび新たに祀られた4名の消防業務従事者の皆様は、消火活動や訓練の場において、「地域住民の命を自分たちが守る」という崇高な決意の下、その責務を全うし、尊くも犠牲となられました。","id_str":"2097952339051360458","is_quote_status":false,"lang":"ja","quote_count":99,"reply_count":495,"retweet_count":1744,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTc5NTIzMzg5OTY4NDY1OTI=","richtext":{"richtext_tags":[]},"text":"本日、第45回全国消防殉職者慰霊祭に出席し、追悼のことばを申し上げ、献花をさせていただきました。\n\nこのたび新たに祀られた4名の消防業務従事者の皆様は、消火活動や訓練の場において、「地域住民の命を自分たちが守る」という崇高な決意の下、その責務を全うし、尊くも犠牲となられました。\n\n身をもって示されたその強い使命感と勇気に対し、衷心より敬意と感謝の意を表しますとともに、改めて哀悼の誠を捧げます。\n\n愛するご家族を失われたご遺族の深いお悲しみを思うと、悲痛の念に　堪えません。\nご遺族の皆様に対し、心からお悔やみを申し上げます。\n\n総務大臣在任中、土砂災害の救助活動中に殉職された消防職員のご遺族を弔問させていただいたことを、改めて思い出しました。\n奥様とお子さん達を残して他界されたことに対する故人の無念を思い、毅然とふるまいつつ悲しみをこらえておられるご遺族のお姿に接し、胸がしめつけられました。\n\n先陣を切って災害の現場に駆けつけ、我が身の危険を顧みず、身を挺して活動する消防職員・消防団員の皆様に、改めて敬意と感謝を表します。\n\n近年、大規模な林野火災や密集した市街地での火災が各地で発生し、広域的・専門的な消防力が求められるなど、消防活動は困難の度を増しています。\n加えて、大雨や台風による被害が相次ぐとともに、首都直下地震や南海トラフ地震などの大規模地震の発生も懸念されています。\n\nそのような中、消防力に対する国民の信頼と期待は大きく、政府としても消防防災体制の充実強化に努めています。\n\nこれまでに祀られた5799柱の御霊の尊い犠牲に思いを致し、そのご遺志にこたえるためにも、災害に強い、安全で安心な国づくりに力を尽くしてまいります。"}}},"rest_id":"2097952339051360458","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"343486","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097952339051360458","sortIndex":"2098270738594135987"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"broadcast_url","value":{"string_value":"https://x.com/i/broadcasts/1dKrPrebVEQJX","type":"STRING"}},{"key":"broadcast_width","value":{"string_value":"720","type":"STRING"}},{"key":"broadcast_state","value":{"string_value":"ENDED","type":"STRING"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"719219671","path":[]}}},{"key":"broadcast_title","value":{"string_value":"原子力規制委員会 / NRA Japan was live","type":"STRING"}},{"key":"broadcast_orientation","value":{"string_value":"0","type":"STRING"}},{"key":"broadcast_id","value":{"string_value":"1dKrPrebVEQJX","type":"STRING"}},{"key":"broadcast_thumbnail_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2097956787752443904/N8cNOohF?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"broadcaster_twitter_id","value":{"string_value":"719219671","type":"STRING"}},{"key":"broadcast_height","value":{"string_value":"1280","type":"STRING"}},{"key":"broadcast_thumbnail_original","value":{"image_value":{"height":1280,"url":"https://pbs.twimg.com/card_img/2097956787752443904/N8cNOohF?format=jpg&name=orig","width":720},"type":"IMAGE"}},{"key":"broadcaster_username","value":{"string_value":"gensiryokukisei","type":"STRING"}},{"key":"broadcast_media_key","value":{"string_value":"28_2097952207446695936","type":"STRING"}},{"key":"broadcast_thumbnail_x_