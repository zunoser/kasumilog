94248/photo/1","ext_alt_text":"実際に旅客の手荷物として海外から持ち込まれた月餅です。中にはソーセージが入っています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":166,"w":166,"x":309,"y":274}]},"medium":{"faces":[{"h":166,"w":166,"x":309,"y":274}]},"orig":{"faces":[{"h":166,"w":166,"x":309,"y":274}]},"small":{"faces":[{"h":94,"w":94,"x":175,"y":155}]}},"id_str":"2103001472518811648","indices":[150,173],"media_key":"3_2103001472518811648","media_results":{"result":{"media_key":"3_2103001472518811648"}},"media_url_https":"https://pbs.twimg.com/media/HS9csnObcAAZr5k.jpg","original_info":{"focus_rects":[{"h":670,"w":1196,"x":0,"y":0},{"h":670,"w":670,"x":114,"y":0},{"h":670,"w":588,"x":155,"y":0},{"h":670,"w":335,"x":282,"y":0},{"h":670,"w":1200,"x":0,"y":0}],"height":670,"width":1200},"sizes":{"large":{"h":670,"resize":"fit","w":1200},"medium":{"h":670,"resize":"fit","w":1200},"small":{"h":380,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/iRt3xiRMp7"}]},"favorite_count":1782,"favorited":false,"full_text":"⚠ご注意ください⚠\n肉入り月餅などの肉製品の日本への持込は違法です🚫\n\n家畜伝染病の侵入を防ぐため、海外の肉製品や動物由来製品のほとんどは、持込禁止です。\n\n🆖手土産での持ち込み\n🆖ネット通販でのお取り寄せ\n🆖国際郵便で友人や家族に贈る\n\nhttps://t.co/hjFZkbjazn\n\n#中秋節 https://t.co/iRt3xiRMp7","id_str":"2103001480936694248","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":106,"reply_count":69,"retweet_count":1384,"retweeted":false,"user_id_str":"2335919749"},"rest_id":"2103001480936694248","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"199049","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2103296295652294714-tweet-2103001487471476909","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDispla