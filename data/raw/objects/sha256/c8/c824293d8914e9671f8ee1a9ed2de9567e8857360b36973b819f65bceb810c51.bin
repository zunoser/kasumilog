"resize":"fit","w":541},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/iut3uWA7EA"}],"urls":[{"display_url":"gov-online.go.jp/useful/article…","expanded_url":"https://www.gov-online.go.jp/useful/article/201711/1.html","indices":[121,144],"url":"https://t.co/Q7bxE2wI9y"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/iut3uWA7EA","expanded_url":"https://x.com/gov_online/status/2103009033749967210/photo/1","ext_alt_text":"政府広報、内閣府の新聞突出し広告。上部に「9月21日から30日までは、秋の全国交通安全運動」、中央には次の4つの情報が記載されている。「暗くなる前、早めのライト点灯。」というテキストと、ライトを点灯した車のイラストには丸印が書かれている。「反射材を使おう」というテキストと、反射材を身に着けた人のイラストには丸印が書かれている。「危険、ながらスマホ」というテキストと、自転車に乗りながらスマホを操作する人のイラストにはバツ印が書かれている。「飲酒運転絶対ダメ」というテキストと、お酒を飲んだ後に車に乗ろうとする人のイラストにはバツ印が書かれている。下部に「夕暮れ時は歩行者の死亡事故多発」と記載されている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":40,"w":40,"x":168,"y":594},{"h":50,"w":50,"x":532,"y":196}]},"medium":{"faces":[{"h":40,"w":40,"x":168,"y":594},{"h":50,"w":50,"x":532,"y":196}]},"orig":{"faces":[{"h":40,"w":40,"x":168,"y":594},{"h":50,"w":50,"x":532,"y":196}]},"small":{"faces":[{"h":34,"w":34,"x":146,"y":517},{"h":43,"w":43,"x":463,"y":170}]}},"id_str":"2103004237764624384","indices":[145,168],"media_key":"3_2103004237764624384","media_results":{"result":{"media_key":"3_2103004237764624384"}},"media_url_https":"https://pbs.twimg.com/media/HS9fNkkaAAAyczD.jpg","original_info":{"focus_rects":[{"h":348,"w":621,"x":0,"y":157},{"h":621,"w":621,"x":0,"y":21},{"h":708,"w":621,"x":0,"y":0},{"h":781,"w":391,"x":0,"y":0},{"h":781,"w":621,"x":0,"y":0}],"height":781,"width":621},"sizes":{"large":{"h":781,"resize":"fit","w":621},"medium":{"h":781,"resize":"fit","w":621},"small":{"h":680,"resize":"fit","w":541},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/iut3uWA7EA"}]},"favorite_count":77,"favorited":false,"full_text":"9月21日から30日までは、「秋の全国交通安全運動」です。\n\n夕暮れ時（17時台から19時台）は、死亡事故の発生件数が多くなります。\n反射材を身に着けるなど、事故を防ぐための心掛けが重要です。\n\n詳しくは政府広報オンラインをご確認ください