.co/vmrInR8VER\n\nYouTubeコンテンツが始まります！\n本日9/24（木）から公開！\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、","id_str":"2103012257311629500","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":3,"retweet_count":8,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[20,32],"text":"放課後ゲンバミッション"},{"indices":[339,343],"text":"ゲンミ"},{"indices":[345,355],"text":"国交省建設産業PR"},{"indices":[356,367],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"x.com/houkago_gennmi…","expanded_url":"https://x.com/houkago_gennmi?s=11","indices":[59,82],"url":"https://t.co/BZfnQjq4Y0"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[314,337],"url":"https://t.co/kPJLLRPIOH"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDMwMTIyNTcxNzc1MDE2OTY=","richtext":{"richtext_tags":[]},"text":"╋━━━━━━━\n\n　YouTube　『#放課後ゲンバミッション！』\n\n　　　　　　　　　　　　　　━━━━━━╋\n\nhttps://t.co/BZfnQjq4Y0\n\nYouTubeコンテンツが始まります！\n本日9/24（木）から公開！\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「ゲンミ！（現場ミッション）」に挑戦✨\n\n職人さんの貴重なお話と、匠の技の凄さを\n中高生の目線でお届けします！\n\n一緒に建設現場の世界を覗きに行きましょう👀\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPIOH\n\n#ゲンミ！\n#国交省建設産業PR\n#MLIT建設産業PR"}}},"rest_id":"2103012257311629500","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"10474","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103012257311629500","sortIndex":"2103296295652294604"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"Timel