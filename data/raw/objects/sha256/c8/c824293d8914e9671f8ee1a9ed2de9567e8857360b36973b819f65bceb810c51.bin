rol":{"edit_tweet_ids":["2103102281231323323"],"editable_until_msecs":"1790257232000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2098,"bookmarked":false,"conversation_id_str":"2103102281231323323","created_at":"Thu Sep 24 12:40:32 +0000 2026","display_text_range":[0,113],"entities":{},"favorite_count":46408,"favorited":false,"full_text":"中国は、死文化している国連憲章のいわゆる「旧敵国条項」が未だ有効であるかのように、同条項に関する彼らの立場について再び発信を行いました。このような発信は、国連で既に採択され、中国も採択を支持した関連の決議と相容れないものです。","id_str":"2103102281231323323","is_quote_status":false,"lang":"ja","quote_count":896,"reply_count":1223,"retweet_count":9917,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDMxMDIyODExODA5MDU0NzQ=","richtext":{"richtext_tags":[]},"text":"中国は、死文化している国連憲章のいわゆる「旧敵国条項」が未だ有効であるかのように、同条項に関する彼らの立場について再び発信を行いました。このような発信は、国連で既に採択され、中国も採択を支持した関連の決議と相容れないものです。\n中国は、国連憲章のいわゆる「旧敵国条項」について、時代遅れとなり、既に死文化したとの認識を規定した１９９５年（平成７年）の国連総会決議に賛成票を投じており、また、国連憲章から「敵国」への言及を削除するとの全加盟国首脳の決意を規定した２００５年（平成１７年）の国連総会決議のコンセンサスにも加わっています。国連安保理常任理事国たる中国として、自身が採択を支持したこれら決議を尊重するよう期待します。\n日本は、戦後一貫して平和国家として国際社会の平和と繁栄に貢献してきています。こうした点は国際社会でも広く認識されています。高市総理の一般討論演説においても述べたとおり、引き続き、我が国の立場や取組をしっかりと説明・発信していきます。"}}},"rest_id":"2103102281231323323","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2561721","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2103296295652294670-tweet-2103111376801824929","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"Timeline