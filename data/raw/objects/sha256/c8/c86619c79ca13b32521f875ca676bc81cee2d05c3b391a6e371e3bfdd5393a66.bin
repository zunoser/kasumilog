m\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1269","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095710272023576974","sortIndex":"2095732238862778360"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2095709028454461440/tg7Hvn3T?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.74074","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":147,"url":"https://pbs.twimg.com/card_img/2095709028454461440/tg7Hvn3T?format=jpg&name=280x150","width":280},"type":"IMAGE"}},{"key":"description","value":{"string_value":"カケル・プロジェクトメンバーと、厚生労働省 労働基準局（以下、基準局）の広報隊長である「たしかめたん（※）」が、基準局のあるオフィスに潜入し、総務課の遠藤補佐と労災保険業務課の貝渕係長にこだわりのポイントを伺いました！   また、基準局の電子化やオフィス改革の精力的な取り組みについても、語ってもらいました。   ※「最低賃金」「働き方改革」「職場の安全対策」「労災保険制度」など、基準行政が担...","type":"STRING"}},{"key":"domain","value":{"string_value":"mhlw-communication-gov.note.jp","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":314,"url":"https://pbs.twimg.com/card_img/2095709028454461440/tg7Hvn3T?format=jpg&name=600x600","width":600},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2095709028454461440/tg7Hvn3T?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":670,"url":"https://pbs.twimg.com/card_img/2095709028454461440/