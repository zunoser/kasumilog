"2092902399874904065","indices":[90,113],"media_key":"3_2092902399874904065","media_results":{"result":{"media_key":"3_2092902399874904065"}},"media_url_https":"https://pbs.twimg.com/media/HQt7pN4bMAELQEs.jpg","original_info":{"focus_rects":[{"h":605,"w":1080,"x":0,"y":22},{"h":1080,"w":1080,"x":0,"y":0},{"h":1231,"w":1080,"x":0,"y":0},{"h":1440,"w":720,"x":0,"y":0},{"h":1440,"w":1080,"x":0,"y":0}],"height":1440,"width":1080},"sizes":{"large":{"h":1440,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OBejkpVw9M"}]},"favorite_count":456,"favorited":false,"full_text":"【なぜいまシリーズ⑳】\n第20弾は、「同盟国との協力」について☝\n\n日本を守るためには、日本自身の防衛力を強化するとともに、同盟国や同志国との連携を深めていくことも大変重要です。 https://t.co/OBejkpVw9M","id_str":"2092902614816133126","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"quoted_status_id_str":"2085289945972031574","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2085289945972031574","url":"https://t.co/F64FzgOLTj"},"reply_count":17,"retweet_count":103,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[237,242],"text":"なぜいま"},{"indices":[393,399],"text":"防衛力変革"},{"indices":[400,404],"text":"三文書"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI5MDI2MTQ3NDkwOTc5ODQ=","text":"【なぜいまシリーズ⑳】\n第20弾は、「同盟国との協力」について☝\n\n日本を守るためには、日本自身の防衛力を強化するとともに、同盟国や同志国との連携を深めていくことも大変重要です。\n\n共同訓練や装備協力、運用面での連携強化などを通じて、日米同盟の抑止力・対処力を高めるとともに、同志国との協力へと輪を広げ、日本と地域の平和と安定を支える態勢の強化に取り組んでいます。\n\n国民の皆様の命と平和な暮らしを守り抜くための重要なポイントを\n「なぜいま防衛力の変革が必要なのか（略して「#なぜいま」）」\nというシリーズでお伝えしています。\n\n普段の生活には関係ないと思われるかもしれませんが、日本を取り巻く安全保障環境が厳しさを増す中で、防衛省・自衛隊の取組は国民の平和な暮らしに直結するものです。\n本年中の三文書改定に向けて検討が進められる今、\nこの機会に、知っていただきたいと思っています。\n\n#防衛力変革\n#三文書"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1262623,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":fa