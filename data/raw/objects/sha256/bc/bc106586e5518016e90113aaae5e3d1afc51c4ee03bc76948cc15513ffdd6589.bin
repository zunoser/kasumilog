37,342],"text":"傷害保険"},{"indices":[343,351],"text":"消費者トラブル"},{"indices":[352,359],"text":"災害便乗商法"},{"indices":[360,365],"text":"損保協会"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"sonpo.or.jp/news/notice/20…","expanded_url":"https://www.sonpo.or.jp/news/notice/2026/2608_003.html","indices":[233,256],"url":"https://t.co/7fkj60SfjX"},{"display_url":"sonpo.or.jp/news/caution/s…","expanded_url":"https://www.sonpo.or.jp/news/caution/syuri.html","indices":[267,290],"url":"https://t.co/hQzXO9UHNM"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI4OTYzNjE0NjExOTg4NDg=","richtext":{"richtext_tags":[]},"text":"＜令和8年8月27日からの大雨に伴う災害により被害を受けられた皆様へ＞\n#災害救助法 が適用された地域でご契約者が被害を受けられた等の場合、各種損害保険について特別措置を実施することとしています。また、#自然災害 の後には、住宅修理などに関し、「保険が使える」と言って勧誘する業者とのトラブルが増加する傾向にあります。このような勧誘を受けた場合は、まずはご加入の「損害保険会社」または「損害保険代理店」にご相談ください。 詳細は以下からご覧ください。\n【特別措置等】https://t.co/7fkj60SfjX\n【業者とのトラブル】https://t.co/hQzXO9UHNM\n\n#大雨 #自然災害 #富山県 #石川県 #相談窓口 #損害保険 #火災保険 #自動車保険 #傷害保険 #消費者トラブル #災害便乗商法 #損保協会"}}},"rest_id":"2092896361591230845","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3534","state":"EnabledWithCount"}}}},"user_id_str":"276848601"},"rest_id":"2092912863010791532","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"846","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2092912863010791532","sortIndex":"2093208165607800752"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/209119515