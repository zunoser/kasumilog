llowing":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7579,"tweets":21480},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2093187546255880389"],"editable_until_msecs":"1787893375000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":41,"bookmarked":false,"conversation_id_str":"2093187546255880389","created_at":"Fri Aug 28 04:02:55 +0000 2026","display_text_range":[0,137],"entities":{},"favorite_count":678,"favorited":false,"full_text":"本日（8月28日）、防衛省は、日本製鉄(株)から広島県呉市の「瀬戸内製鉄所呉地区跡地」を取得する契約を締結しました。\n今後、この土地を防衛力の強化や災害対応の拠点として活用していきます。\n具体的には、\n・自衛隊の活動拠点となる庁舎や隊舎\n・民間企業による防衛装備品の製造施設","id_str":"2093187546255880389","is_quote_status":false,"lang":"ja","quote_count":5,"reply_count":15,"retweet_count":218,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTMxODc1NDYyMDU1ODk1MDQ=","text":"本日（8月28日）、防衛省は、日本製鉄(株)から広島県呉市の「瀬戸内製鉄所呉地区跡地」を取得する契約を締結しました。\n今後、この土地を防衛力の強化や災害対応の拠点として活用していきます。\n具体的には、\n・自衛隊の活動拠点となる庁舎や隊舎\n・民間企業による防衛装備品の製造施設\n・物資集積場やヘリポートなどの防災拠点\nなどを備えた『多機能な複合防衛拠点』を整備し、防衛力の抜本的強化につなげていきます。\n\n今回の契約締結は、その整備に向けた大きな一歩です。\n今後、日本製鉄・広島県・呉市と連携しながら、防衛力の強化と災害対応力の向上に資する拠点整備を進めてまいります。"}}},"rest_id":"2093187546255880389","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"21077","state":"EnabledWithCount"}}}}},"entryId":"tw