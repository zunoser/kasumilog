/t.co/1HLgxGncHP"},{"display_url":"pic.x.com/1HLgxGncHP","expanded_url":"https://x.com/MHLWitter/status/2092940634823033311/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2092940630125379584","indices":[123,146],"media_key":"3_2092940630125379584","media_results":{"result":{"media_key":"3_2092940630125379584"}},"media_url_https":"https://pbs.twimg.com/media/HQueagqbAAAnaVp.png","original_info":{"focus_rects":[{"h":286,"w":511,"x":0,"y":356},{"h":511,"w":511,"x":0,"y":229},{"h":583,"w":511,"x":0,"y":157},{"h":740,"w":370,"x":70,"y":0},{"h":740,"w":511,"x":0,"y":0}],"height":740,"width":511},"sizes":{"large":{"h":740,"resize":"fit","w":511},"medium":{"h":740,"resize":"fit","w":511},"small":{"h":680,"resize":"fit","w":470},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/1HLgxGncHP"}]},"favorite_count":54,"favorited":false,"full_text":"【第13回災害対策本部会議を開催】\n本日 #令和8年熊本地震 の「被災者の生活となりわい支援パッケージ」を公表。これに基づき、避難者の健康管理支援、施設等の人材不足の対応、なりわい再建、医療・福祉施設の復旧支援の取組を引き続き進めてまいります。 https://t.co/1HLgxGncHP","id_str":"2092940634823033311","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":12,"retweet_count":17,"retweeted":false,"user_id_str":"180585090"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[21,30],"text":"令和8年熊本地震"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI5NDA2MzQ3NzI2OTcwODg=","text":"【第13回災害対策本部会議を開催】\n本日 #令和8年熊本地震 の「被災者の生活となりわい支援パッケージ」を公表。これに基づき、避難者の健康管理支援、施設等の人材不足の対応、なりわい再建、医療・福祉施設の復旧支援の取組を引き続き進めてまいります。\n※写真：日本災害リハビリテーション支援協会(JRAT)による活動支援の様子"}}},"rest_id":"2092940634823033311","source":"<a href=\"https://social.userlocal.jp/\" rel=\"nofollow\">Userlocal SocialInsight</a>","unmention_data":{},"views":{"count":"28580","state":"EnabledWithCount"}}}}},"entryId":"twee