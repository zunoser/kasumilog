{"data":{"list":{"tweets_timeline":{"timeline":{"instructions":[{"entries":[{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2994936,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":530,"tweets":1768},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2097258569699594736"],"editable_until_msecs":"1788863982000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":7,"bookmarked":false,"conversation_id_str":"2097258569699594736","created_at":"Tue Sep 08 09:39:42 +0000 2026","display_text_range":[0,82],"entities":{},"favorite_count":304,"favorited":false,"full_text":"本日（8日）18時20分、庄内川に「レベル5氾濫特別警報」が発表されました。\n\n愛知県名古屋市を流れる矢田川では、既に氾濫が発生又は切迫している状況となっています。","id_str":"2097258569699594736","is_quote_status":false,"lang":"ja","quote_count":7,"reply_count":10,"retweet_count":94,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTcyNTg1Njk2NDA4MzcxMjA=","richtext":{"richtext_tags":[]},"text":"本日（8日）18時20分、庄内川に「レベル5氾濫特別警報」が発表されました。\n\n愛知県名古屋市を流れる矢田川では、既に氾濫が発生又は切迫している状況となっています。\n\n警戒レベル5の「緊急安全確保」が発令されている地域では、命の危険が迫っています。地方自治体の指示に従い、直ちに身の安全を確保して下さい。\n\n特別警報が発表中の地域の皆様は、浸水しにくい高い場所などで、直ちに身の安全を確保してください。屋外の移動が危険な場合は、無理をせず、今いる場所よりも少しでも安全な空間に移動するなど、命を守る行動を最優先して下さい。\n\nまた、ラジオ・テレビ・インターネットなどで、自治体からの最新の避難情報に十分注意し、少しでも危険を感じれば、躊躇せず、早め早めに自らの命を守る行動をとっていただきますようお願いいたします。\n\n政府としては、官邸危機管理センターに設置している「官邸連絡室」において、被害状況の把握、被災者の救命・救助等の災害応急対策、国民の皆様に対する適時的確な情報提供などの対応に当たっています。"}}},"rest_id":"2097258569699594736","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"20138","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097258569699594736","sortIndex":"2097259114466902016"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tw