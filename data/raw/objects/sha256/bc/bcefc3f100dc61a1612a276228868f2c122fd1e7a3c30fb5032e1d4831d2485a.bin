08a/nishinoshima_20260908.html","indices":[120,143],"url":"https://t.co/2fNjiB40YD"}]},"favorite_count":94,"favorited":false,"full_text":"【報道発表】（R8.9.8）本日（8日）11時00分に、西之島に発表していた火口周辺警報（入山危険）を火口周辺警報（火口周辺危険）に引き下げ、警戒が必要な範囲を概ね1.5kmから概ね１kmに縮小しました。\n#いのちとくらしをまもる防災減災\nhttps://t.co/2fNjiB40YD","id_str":"2097145734663725287","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":39,"retweeted":false,"user_id_str":"2923658012"},"rest_id":"2097145734663725287","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"25648","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097145734663725287","sortIndex":"2097259114466901953"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2994936,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":530,"tweets":1768},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2097145218655223975"],"editable_until_msecs":"1788836957000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":148,"bookmarked":false,"conversation_id_str":"2097145218655223975","created_at":"Tue Sep 08 02:09:17 +0000 2026","display_text_range":[0,143],"entities":{},"favorite_count":9768,"favorited":false,"full_text":"本日、毎月勤労統計調査の令和8年7月分の速報が公表されました。\n\n「実質賃金」の対前年同月比は、消費者物価指数について\n①「総合」を用いた場合、8か月連続のプラスとなる、プラス2.6％、\n②「持家の帰属家賃を除く総合」を用いた場合、7か月連続のプラスとなる、プラス2.4％となりました。","id_str":"2097145218655223975","is_quote_status":false,"lang":"ja","quote_count":280,"reply_count":1258,"retweet_count":1212,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTcxNDUyMTg1ODM5OTg0NjQ=","richtext":{"richtext_tags":[]},"text":"本日、毎月勤労統計調査の令和8年7月分の速報が公表されました。\n\n「実質賃金」の対前年同月比は、消費者物価指数について\n①「総合」を用いた場合、8か月連続のプラスとなる、プラス2.6％、\n②「持家の帰属家賃を除く総合」を用いた場合、7か月連続のプラスとなる、プラス2.4％となりました。\n\nこの数字は、令和3年5月以来の、高い数値となっています。\n\nその要因については、所定内給与が着実に増加していることに加えて、ボーナスなどの特別給与が増加したこと、そして「物価高対策」に取り組んできていることなどが寄与していると考えられますが、今後とも、物価動向や雇用・所得環境などを総合的に注視してまいります。\n\nまた、今年度の地域別最低賃金額は、過去2番目に高い引上げ額（全国加重平均で1,177円、56円の引上げ）となっており、こうした10月以降に発効する最低賃金の引上げは、秋以降、着実に賃金の底上げにつながっていくものと考えられます。\n\n今後とも、物価上昇を上回る賃上げの実現に向け、中小企業・小規模事業者の賃上げ環境の整備をはじめとした各種支援策を講じてまいります。"}}},"rest_id":"2097145218655223975","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"564866","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097145218655223975","sortIndex":"2097259114466901952"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/963981452835614721/EBYtwxCX_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/240204834/1530778052"},"core":{"created_at":"Wed Jan 19 11:45:14 +0000 2011","name":"消費者庁","screen_name":"caa_shohishacho"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDAyMDQ4MzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1958402460600676735"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"