ation":{"verified":false},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2097204792225395161"],"editable_until_msecs":"1788851161000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2097204792225395161","created_at":"Tue Sep 08 06:06:01 +0000 2026","display_text_range":[0,133],"entities":{},"favorite_count":194,"favorited":false,"full_text":"【9月8日　小泉防衛大臣会見】\n\n冒頭、自衛隊の衛生機能の強化に関する防衛大臣・厚生労働大臣の協議について発表しました。\n\nその他、\n〇衛生機能の強化\n〇日印共同訓練「ヴィーア・ガーディアン26」\n〇退職自衛隊員及び御家族に対する支援\nに関する質疑応答がありました。","id_str":"2097204792225395161","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":3,"retweet_count":33,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/1fT8m46CPBA?si…","expanded_url":"https://youtu.be/1fT8m46CPBA?si=4oge_BZJiwxfSrXK","indices":[699,722],"url":"https://t.co/EoZWTJoczC"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTcyMDQ3OTIwMjgyNTAxMTI=","text":"【9月8日　小泉防衛大臣会見】\n\n冒頭、自衛隊の衛生機能の強化に関する防衛大臣・厚生労働大臣の協議について発表しました。\n\nその他、\n〇衛生機能の強化\n〇日印共同訓練「ヴィーア・ガーディアン26」\n〇退職自衛隊員及び御家族に対する支援\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「先ほど上野厚生労働大臣と会談し、自衛隊衛生の戦傷医療能力向上の観点から、防衛省と厚生労働省の間で、より強固な協力体制を構築したい旨のお願いを私からさせていただきました。具体的には、昨日の海上自衛隊江田島地区の視察の際に、特別警備隊の隊員から要望のあった、部隊の第一線救護能力の強化に係る検討への御協力、そして、有事に負傷した隊員の治療が自衛隊病院だけでは困難な場合に、部外医療機関と連携して、どのように対応していくかの検討に必要な情報の提供や助言、自衛隊医官等の戦傷医療対処能力の向上に必要な研修先の候補となる、部外医療機関の紹介、戦傷医療に必要な医薬品・医療資機材の確保に関する知見や関係機関とのネットワークの共有。また、これに限らず、自衛隊衛生の機能強化に向けて、今後も幅広い御協力をお願いしました。上野大臣からは、是非協力していきましょうと心強いお言葉をいただきました。今後は、事務次官級の防衛・厚労協議会を設置するとともに、今回のような防衛・厚労両大臣による協議も継続的に開催したいと考えています。これからも防衛大臣として、自衛隊を、世界で最も隊員の命を大切にする組織とするため、今後も必要な取組を、スピード感を持って進めていきたいと思います。今日は冒頭は以上です。」\n \n↓動画はこちら\nhttps://t.co/EoZWTJoczC"}}},"rest_id":"2097204792225395161","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"19667","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2097205524244930787","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"3944","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097205524244930787","sortIndex":"2097259114466901987"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092927185678127486"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"農林水産省の公式アカウントです。ご意見・ご質問は、総合窓口にお寄せください。\n総合窓口→https://t.co/XLQwxIPiHh\n運用方針→https://t.co/2SnzXCNurZ","entities":{"description":{"urls":[{"display_url":"contactus.maff.go.jp/voice/sogo.html","expanded_url":"https://www.contactu