":152468,"following":179},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8564,"tweets":19476},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2096919788329336923"],"editable_until_msecs":"1788783211000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":true,"legacy":{"bookmark_count":215,"bookmarked":false,"conversation_id_str":"2096919788329336923","created_at":"Mon Sep 07 11:13:31 +0000 2026","display_text_range":[0,280],"entities":{},"favorite_count":2959,"favorited":false,"full_text":"The Chinese Embassy in Japan again posted on X regarding issues including the so-called “enemy State” clauses in the Charter of the United Nations.\nAs posted before, regarding the so-called “enemy State” clauses in the Charter of the United Nations, a resolution recognizing it as","id_str":"2096919788329336923","is_quote_status":true,"lang":"en","quote_count":55,"quoted_status_id_str":"1992511156913901804","quoted_status_permalink":{"display":"x.com/MofaJapan_en/s…","expanded":"https://twitter.com/MofaJapan_en/status/1992511156913901804","url":"https://t.co/hotlmlhCbB"},"reply_count":129,"retweet_count":1004,"retweeted":false,"user_id_str":"303735625"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTY5MTk3ODgyMzcwMDQ4MDE=","richtext":{"richtext_tags":[]},"text":"The Chinese Embassy in Japan again posted on X regarding issues including the so-called “enemy State” clauses in the Charter of the United Nations.\nAs posted before, regarding the so-called “enemy State” clauses in the Charter of the United Nations, a resolution recognizing it as obsolete was adopted by an overwhelming majority at the 1995 UN General Assembly, with China itself casting a vote in favor. Furthermore, at the 2005 UN World Summit, a General Assembly resolution was adopted stipulating the resolution of all Member State leaders to delete references to “enemy States” from the UN Charter, with China also joining the consensus.\nPosting information implying that obsolete clauses remain in effect is incompatible with such resolutions already adopted at the United Nations which China itself supported.\nSince the end of World War II, Japan has consistently contributed to peace and prosperity in the international community as a peace-loving nation. This is widely recognized in the international community."}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"1992511156913901804"}},"rest_id":"2096919788329336923","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"344174","state":"EnabledWithCount"}}},"rest_id":"2096921834596016393","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"77990","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2096921832612110833","2096921834596016393"],"enableDeduplication":true}}},"entryId":"list-conversation-2097259114466902097","sortIndex":"2097259114466901935"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_