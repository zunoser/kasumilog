wJY9ims"},{"display_url":"mod.go.jp/j/approach/def…","expanded_url":"https://www.mod.go.jp/j/approach/defense/saigai/index.html","indices":[191,214],"url":"https://t.co/eAcvFFZHmX"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTcxMTU2OTI5OTQ4MjIxNDQ=","richtext":{"richtext_tags":[]},"text":"【はくおうⅡの宿泊支援（新規予約）】\n防衛省が借り上げている民間船舶「#はくおうⅡ」による食事付き宿泊支援を、9月11日（金）から実施する予定です。\n宿泊支援の予約受付は、明日（9月9日）午前9時から熊本県のホームページで開始します。\n\n詳細は以下のリンクをご確認ください。\n\n「熊本県ホームページ」 https://t.co/CcgwJY9ims\n「防衛省・自衛隊ホームページ」 https://t.co/eAcvFFZHmX"}}},"rest_id":"2097115693053624598","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"27087","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2097136672937070829","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"3375","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097136672937070829","sortIndex":"2097259114466901944"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1788223971"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2096457155079741779"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6ku2s"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":296547,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4939,"tweets":12910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6ku2s"}}}},"edit_control":{"edit_tweet_ids":["2097135329929257015"],"editable_until_msecs":"1788834600000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2097135329929257015","created_at":"Tue Sep 08 01:30:00 +0000 2026","display_text_range":[0,146],"entities":{"media":[{"display_url":"pic.x.com/wwQwDBqbDv","expanded_url":"https://x.com/gov_online/status/2097135329929257015/photo/1","ext_alt_text":"上部に「災害時の熱中症にご注意ください。」と記載されており、その下には、次のように記載されている。片付け等の作業時の注意点。作業開始前には必ず体調を確認する。できるだけ2人以上で作業を行い、お互いの体調を確認する。休憩·水分·塩分の補給は、一定時間毎にとる。休憩時は、日陰等の涼しい場所を確保する。暑い時間帯の作業は避ける。汗をかいた時は水分・塩分の補給をする。その横には、水分補給をする女性のイラストが描かれている。災害時には、慣れない環境や作業で熱中症のリスクが高くなります。熱中症には十分にご注意ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097134637026058240","indices":[147,170],"media_key":"3_2097134637026058240","media_results":{"result":{"media_key":"3_2097134637026058240"}},"media_url_https":"https://pbs.twimg.com/media/HRqE114bIAA4tLT.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":318},{"h":900,"w":900,"x":0,"y":120},{"h":1026,"w":900,"x":0,"y":57},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/wwQwDBqbDv"}],"user_mentions":[{"id_str":"286056244","indices":[135,146],"name":"環境省","screen_name":"Kankyo_Jpn"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/wwQwDBqbDv","expanded_url":"https://x.com/gov_online/status/2097135329929257015/photo/1","ext_alt_text":"上部に「災害時の熱中症にご注意ください。」と記載されており、その下には、次のように記載されている。片付け等の作業時の注意点。作業開始前には必ず体調を確認する。できるだけ2人以上で作業を行い、お互いの体調を確認する。休憩·水分·塩分の補給は、一定時間毎にとる。休憩時は、日陰等の涼しい場所を確保する。暑い時間帯の作業は避ける。汗をかいた時は水分・塩分の補給をする。その横には、水分補給をする女性のイラストが描かれている。災害時には、慣れない環境や作業で熱中症のリスクが高くなります。熱中症には十分にご注意ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097134637026058240","indices":[147,170],"media_key":"3_2097134637026058240","media_results":{"result":{"media_key":"3_2097134637026058240"}},"media_url_https":"https://pbs.twimg.com/media/HRqE114bIAA4tLT.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":318},{"h":900,"w":900,"x":0,"y":120},{"h":1026,"w":900,"x":0,"y":57},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/wwQwDBqbDv"}]},"favorite_count":37,"favorited":false,"full_text":"【災害時の熱中症予防】\n片付けなどの作業を行う際は、こまめな水分・塩分補給を心がけ、熱中症には十分ご注意ください。\nまた、休憩は涼しい場所でとりましょう。\n\n暑い時間帯の作業はできるだけ避け、体調が優れないときは、無理をせず、作業を行わないようにすることが大切です。\n\n@Kankyo_Jpn https://t.co/wwQwDBqbDv","id_str":"2097135329929257015","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":17,"retweeted":false,"user_id_str":"461064204"},"rest_id":"2097135329929257015","source":"<a href=\"https://twitter.com\" rel=\"nofollow\">TweetDeck Web App</a>","unmention_data":{},"views":{"count":"5721","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097135329929257015","sortIndex":"2097259114466901943"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2097149820121288704/7V2tk6eY?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"博士課程学生によるショートプレゼンテーション・ポスター発表や 社会で活躍する博士人材の講演やパネルディスカッションを通して、博士人材の強みや魅力をアカデミアのみならず企業や官公庁等に向けて発信します。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.jst.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/20