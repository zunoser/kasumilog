"h":130,"w":130,"x":389,"y":148},{"h":121,"w":121,"x":696,"y":174}]},"orig":{"faces":[{"h":90,"w":90,"x":560,"y":1052},{"h":222,"w":222,"x":664,"y":254},{"h":208,"w":208,"x":1188,"y":298}]},"small":{"faces":[{"h":29,"w":29,"x":185,"y":349},{"h":73,"w":73,"x":220,"y":84},{"h":69,"w":69,"x":394,"y":98}]}},"id_str":"2097250961635033088","indices":[71,94],"media_key":"3_2097250961635033088","media_results":{"result":{"media_key":"3_2097250961635033088"}},"media_url_https":"https://pbs.twimg.com/media/HRruo00aQAApJt1.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":85,"y":0},{"h":1366,"w":1198,"x":169,"y":0},{"h":1366,"w":683,"x":427,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/qraGE5SzlT"}]},"favorite_count":129,"favorited":false,"full_text":"9月8日、小泉防衛大臣は、自衛隊の戦傷医療能力向上の観点から、厚生労働省とのより強固な協力体制を構築するため上野厚生労働大臣と協議しました。 https://t.co/qraGE5SzlT","id_str":"2097250973475569922","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":25,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTcyNTA5NzM0MjEwNjgyODg=","text":"9月8日、小泉防衛大臣は、自衛隊の戦傷医療能力向上の観点から、厚生労働省とのより強固な協力体制を構築するため上野厚生労働大臣と協議しました。\n\n今回の協議では小泉大臣から、特別警備隊の隊員から要望のあった部隊の第一線救護能力の強化に係る検討への協力をはじめ、自衛隊の衛生機能強化に向けて幅広い協力をお願いしました。\n\n今後も、事務次官級の協議会を設置するとともに、両大臣による協議も継続して実施していくなど、両省の連携の強化を通じて、防衛省・自衛隊を「世界で最も隊員の命を大切にする組織」とするための取組をスピード感をもって進めてまいります。"}}},"rest_id":"2097250973475569922","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"co