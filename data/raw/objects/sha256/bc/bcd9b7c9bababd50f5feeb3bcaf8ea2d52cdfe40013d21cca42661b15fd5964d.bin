策の強化に熱心に取り組まれている皆様に心から敬意を表し、「特定地域づくり事業協同組合」の設立や運営にご支援をいただいていることへお礼を述べました。 https://t.co/hknlLTd7QW","id_str":"2117785586652336429","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":5,"retweeted":false,"user_id_str":"1469058582"},"rest_id":"2117785586652336429","unmention_data":{},"views":{"count":"2912","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117785586652336429","sortIndex":"2118001837268271022"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2116635098196193280/_qMZC2eU?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.fsa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2116635098196193280/_qMZC2eU?format=png&name=420x420_2","width":400},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2116635098196193280/_qMZC2eU?format=png&name=orig","width":401},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"276848601","path":[]}}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2116635098196193280/_qMZC2eU?format=png&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2116635098196193280/_qMZC2eU