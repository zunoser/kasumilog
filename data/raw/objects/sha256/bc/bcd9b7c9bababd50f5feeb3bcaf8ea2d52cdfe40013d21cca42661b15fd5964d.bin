izes":{"large":{"h":1920,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":675},"small":{"h":680,"resize":"fit","w":383},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/ULLOR1XoDU","video_info":{"aspect_ratio":[9,16],"duration_millis":17000,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2117892595380883456/pl/hCBOH1TuR0Wx6j4L.m3u8?tag=29"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2117892595380883456/vid/avc1/320x568/5ou1ojBv4t-A6Mfa.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2117892595380883456/vid/avc1/480x852/eGqLFlP0qqdrI6aF.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2117892595380883456/vid/avc1/720x1280/vchhdDNVk_ZtgSln.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2117892595380883456/vid/avc1/1080x1920/EPjqebO76kkiQGCv.mp4?tag=29"}]}}]},"favorite_count":34,"favorited":false,"full_text":"／\n初開催！文化フォーラム\n「京都迎賓館の魅力を探る」🔍\n＼\n\n京都御苑や京都の宮廷文化に関連の深い大学・機関とタッグを組み、普段のガイドツアーではお伝えしきれない「京都迎賓館の美×技×場」を深掘りします。\n\n入場無料。事前予約は必要ありません。 https://t.co/ULLOR1XoDU","id_str":"2117893333678989467","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":11,"retweeted":false,"user_id_str":"803146955757010944"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTc4OTMzMzM2MDc2ODIwNDg=","richtext":{"richtext_tags":[]},"text":"／\n初開催！文化フォーラム\n「京都迎賓館の魅力を探る」🔍\n＼\n\n京都御苑や京都の宮廷文化に関連の深い大学・機関とタッグを組み、普段のガイドツアーではお伝えしきれない「京都迎賓館の美×技×場」を深掘りします。\n\n入場無料。事前予約は必要ありません。\n建築や伝統的技能を学ぶ学生、宮廷文化にご関心のあるかたなど、皆様奮ってご参加ください！\n知ればきっと京都迎賓館を訪れたくなる、内容盛りだくさんの特別企画です✨\n\n🗓日時：12月20日(日曜日)　13:00から16:30まで（12:30開場）\n📍会場：同志社大学今出川キャンパス良心館102号室（京都市上京区今出川通烏丸東入）\n\n（主催）内閣府京都迎賓館、同志社大学宮廷文化研究センター\n（共催）環境省京都御苑管理事務所、京都産業大学日本文化研究所、一般財団法人 京都宮廷文化研究所\n（協力）公益財団法人 京都文化交流コンベンションビューロー\n\n詳しくは、京都迎賓館HPへ♪"}}},"rest_id":"2117893333678989467","unmention_data":{},"views":{"count":"2044","state":"EnabledWithCount"}}},"user_id_str":"2904127170"},"rest_id":"2117898699703775451","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"348","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117898699703775451","sortIndex":"2118001837268271085"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府の公式アカウントです。内閣府大臣官房政策評価広報課が運営しています。運営方針 https://t.co/LtXxYQ4rJW を御確認のうえ御利用ください。問い合わせは https://t.co/ANlK6wet0H","entities":{"description":{"urls":[{"display_url":"cao.go.jp/others/seihyou…","expanded_url":"https://www.cao.go.jp/others/seihyou/sns/x.html","indices":[42,65],"url":"https://t.co/LtXxYQ4rJW"},{"display_url":"cao.go.jp/goiken.html","expanded_url":"https://www.cao.go.jp/goiken.html","indices":[88,111],"url":"https://t.co/ANlK6wet0H"}]},"url":{"urls":[{"display_url":"cao.go.jp","expanded_url":"https://www.cao.go.jp/","indices":[0,23],"url":"https://t.co/8tRrZ0eypt"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":138545,"following":62},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2904127170","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1860,"tweets":10066},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/8tRrZ0eypt"}}}},"edit_control":{"edit_tweet_ids":["2117898646427742296"],"editable_until_msecs":"1793784960619","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2117898646427742296","created_at":"Wed Nov 04 08:36:00 +0000 2026","display_text_range":[0,68],"entities":{"media":[{"display_url":"pic.x.com/E6ZVPPLV7Q","expanded_url":"https://x.com/Kyoto_Geihinkan/status/2117448121932533824/photo/1","ext_alt_text":"第13回京都迎賓館文化サロン「能楽　京都のまちに深く根差した伝統芸能」。寛永行幸から今年で400年。行幸で披露された能楽の世界。能楽金剛流 二十六世宗家・人間国宝 金剛永謹氏及び若宗家・金剛龍謹氏による特別講演と、通常非公開の「水明の間」を加えた京都迎賓館ガイドツアーの2部構成。開催日　令和8年11月19日（木曜日）。午前の部　9:25集合、10:00開始、12:40終了。午後の部　13:25集合、14:00開始、16:40終了。会場　京都迎賓館 （集合場所：清和院休憩所）。講師　人間国宝 能楽金剛流 二十六世宗家・金剛永謹氏（1951年京都市生まれ。二十六世宗家を継承。2003年に京都御所西側へ金剛能楽堂を移転。2023年重要無形文化財「能楽」各個指定保持者（人間国宝）認定。2018年紫綬褒章受章。令和4年度恩賜賞・日本芸術院賞受賞。一般社団法人日本能楽会会長。）、能楽金剛流 若宗家・金剛龍謹氏（1988年金剛流二十六世宗家・金剛永謹の長男として京都市に生まれる。父と祖父の二世金剛巌に師事。京都を中心に国内外の数多くの公演に出演。京都市芸術新人賞、京都府文化賞奨励賞 受賞。重要無形文化財保持者総合認定保持者。）。参加費用　一般5,000円、大学生・専門学生3,500円、中高生1,500円※小学生以下はご参観いただけません。申込方法　京都迎賓館ホームページにおいて先着順で事前予約を受付します。協力　公益財団法人京都文化交流コンベンションビューロー。金剛流とは？「舞金剛」と呼ばれる華麗で躍動感溢れる金剛流独特の芸風に「京金剛」といわれる優美で雅やかさが加わった芸風を特徴とし、シテ方五流宗家の中で唯一、京都に拠地を置いています。お問合せ　京都迎賓館 TEL. 075-223-2301京都市上京区京都御苑23。地下鉄今出川駅から徒歩15分。市バス停府立医大病院前から徒歩7分。国公賓等の接遇その他迎賓館の運営上の都合により中止することがありますが、その際は京都迎賓館ホームページでお知らせします。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":50,"w":50,"x":696,"y":692},{"h":53,"w":53,"x":690,"y":852},{"h":43,"w":43,"x":702,"y":1019},{"h":82,"w":82,"x":515,"y":139},{"h":129,"w":129,"x":241,"y":66}]},"medium":{"faces":[{"h":50,"w":50,"x":696,"y":692},{"h":53,"w":53,"x":690,"y":852},{"h":43,"w":43,"x":702,"y":1019},{"h":82,"w":82,"x":515,"y":139},{"h":129,"w":129,"x":241,"y":66}]},"orig":{"faces":[{"h":50,"w":50,"x":696,"y":692},{"h":53,"w":53,"x":690,"y":852},{"h":43,"w":43,"x":702,"y":1019},{"h":82,"w":82,"x":515,"y":139},{"h":129,"w":129,"x":241,"y":66}]},"small":{"faces":[{"h":29,"w":29,"x":404,"y":402},{"h":30,"w":30,"x":401,"y":495},{"h":25,"w":25,"x":408,"y":592},{"h":47,"w":47,"x":299,"y":80},{"h":75,"w":75,"x":140,"y":38}]}},"id_str":"2117447815249141760","indices":[45,68],"media_key":"3_2117447815249141760","media_results":{"result":{"media_key":"3_2117447815249141760"}},"media_url_https":"https://pbs.twimg.com/media/HWKvkbpaIAAEZNu.jpg","original_info":{"focus_rects":[{"h":463,"w":827,"x":0,"y":441},{"h":827,"w":827,"x":0,"y":259},{"h":943,"w":827,"x":0,"y":201},{"h":1170,"w":585,"x":0,"y":0},{"h":1170,"w":827,"x":0,"y":0}],"height":1170,"width":827},"sizes":{"large":{"h":1170,"resize":"fit","w":827},"medium":{"h":1170,"resize":"fit","w":827},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"source_status_id_str":"2117448121932533824","source_user_id_str