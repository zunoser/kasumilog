 二十六世宗家・人間国宝 金剛永謹氏及び若宗家・金剛龍謹氏による特別講演と、通常非公開の「水明の間」を加えた京都迎賓館ガイドツアーの2部構成。開催日　令和8年11月19日（木曜日）。午前の部　9:25集合、10:00開始、12:40終了。午後の部　13:25集合、14:00開始、16:40終了。会場　京都迎賓館 （集合場所：清和院休憩所）。講師　人間国宝 能楽金剛流 二十六世宗家・金剛永謹氏（1951年京都市生まれ。二十六世宗家を継承。2003年に京都御所西側へ金剛能楽堂を移転。2023年重要無形文化財「能楽」各個指定保持者（人間国宝）認定。2018年紫綬褒章受章。令和4年度恩賜賞・日本芸術院賞受賞。一般社団法人日本能楽会会長。）、能楽金剛流 若宗家・金剛龍謹氏（1988年金剛流二十六世宗家・金剛永謹の長男として京都市に生まれる。父と祖父の二世金剛巌に師事。京都を中心に国内外の数多くの公演に出演。京都市芸術新人賞、京都府文化賞奨励賞 受賞。重要無形文化財保持者総合認定保持者。）。参加費用　一般5,000円、大学生・専門学生3,500円、中高生1,500円※小学生以下はご参観いただけません。申込方法　京都迎賓館ホームページにおいて先着順で事前予約を受付します。協力　公益財団法人京都文化交流コンベンションビューロー。金剛流とは？「舞金剛」と呼ばれる華麗で躍動感溢れる金剛流独特の芸風に「京金剛」といわれる優美で雅やかさが加わった芸風を特徴とし、シテ方五流宗家の中で唯一、京都に拠地を置いています。お問合せ　京都迎賓館 TEL. 075-223-2301京都市上京区京都御苑23。地下鉄今出川駅から徒歩15分。市バス停府立医大病院前から徒歩7分。国公賓等の接遇その他迎賓館の運営上の都合により中止することがありますが、その際は京都迎賓館ホームページでお知らせします。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":50,"w":50,"x":696,"y":692},{"h":53,"w":53,"x":690,"y":852},{"h":43,"w":43,"x":702,"y":1019},{"h":82,"w":82,"x":515,"y":139},{"h":129,"w":129,"x":241,"y":66}]},"medium":{"faces":[{"h":50,"w":50,"x":696,"y":692},{"h":53,"w":53,"x":690,"y":852},{"h":43,"w":43,"x":702,"y":1019},{"h":82,"w":82,"x":515,"y":139},{"h":129,"w":129,"x":241,"y":66}]},"orig":{"faces":[{"h":50,"w":50,"x":696,"y":692},{"h":53,"w":53,"x":690,"y":852},{"h":43,"w":43,"x":702,"y":1019},{"h":82,"w":82,"x":515,"y":139},{"h":129,"w":129,"x":241,"y":66}]},"small":{"faces":[{"h":29,"w":29,"x":404,"y":402},{"h":30,"w":30,"x":401,"y":495},{"h":25,"w":25,"x":408,"y":592},{"h":47,"w":47,"x":299,"y":80},{"h":75,"w":75,"x":140,"y":38}]}},"id_str":"2117447815249141760","indices":[24,47],"media_key":"3_2117447815249141760","media_results":{"result":{"media_key":"3_2117447815249141760"}},"media_url_https":"https://pbs.twimg.com/media/HWKvkbpaIAAEZNu.jpg","original_info":{"focus_rects":[{"h":463,"w":827,"x":0,"y":441},{"h":827,"w":827,"x":0,"y":259},{"h":943,"w":827,"x":0,"y":201},{"h":1170,"w":585,"x":0,"y":0},{"h":1170,"w":827,"x":0,"y":0}],"height":1170,"