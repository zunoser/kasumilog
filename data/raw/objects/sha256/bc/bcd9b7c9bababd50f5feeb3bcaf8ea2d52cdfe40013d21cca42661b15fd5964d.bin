18001837268271021"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"description":{},"url":{"urls":[{"display_url":"fdma.go.jp","expanded_url":"http://www.fdma.go.jp/","indices":[0,23],"url":"https://t.co/YCgAnjuA83"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":875985,"following":18},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"137272821","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1047,"tweets":7621},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/YCgAnjuA83"}}}},"edit_control":{"edit_tweet_ids":["2117784096760057997"],"editable_until_msecs":"1793757649850","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2117784096760057997","created_at":"Wed Nov 04 01:00:49 +0000 2026","display_text_range":[0,140],"entities":{"user_mentions":[{"id_str":"461064204","indices":[3,14],"name":"政府広報オンライン","screen_name":"gov_online"}]},"favorite_count":0,"favorited":false,"full_text":"RT @gov_online: 「なんとなく安心だから」と、いきなり大病院を選ぶなどしていませんか？🏥\n\n受診の仕方によっては、待ち時間が長くなったり、追加で費用がかかったりすることもあります。\n上手に医療機関にかかるポイントをご紹介します。\n\n11月は「みんなで医療を考える月…","id_str":"2117784096760057997","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":65,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1793582764"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6l1S0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":298678,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4983,"tweets":13000},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2117444152346685903"],"editable_until_msecs":"1793676600000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":18,"bookmarked":false,"conversation_id_str":"2117444152346685903","created_at":"Tue Nov 03 02:30:00 +0000 2026","display_text_range":[0,152],"entities":{"media":[{"display_url":"pic.x.com/TfyFNNACak","expanded_url":"https://x.com/gov_online/status/2117444152346685903/photo/1","ext_alt_text":"上部に、地元のかかりつけ病院に行こうとしている親子のイラストが描かれている。その下には、次のように記載されている。「医療機関の上手なかかり方のポイント。1。日常的な病気は身近な診療所へ。待ち時間も少なく、大病院受診時のような定額料金がかかりません。2。できるだけ診療時間内に受診する。休日や夜間に受診すると追加の費用がかかることがあります。また、日中と診療体制も異なることから、検査などが十分にできないことがあります。3。かかりつけ医をもつ。体調の変化で気になることを気軽に相談でき、必要に応じて大病院を紹介してもらえます。上手に医療機関にかかり、医療費や待ち時間の負担を減らしましょう。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2117146419689885696","indices":[153,176],"media_key":"3_2