":[285,297],"name":"経済産業省","screen_name":"meti_NIPPON"}]},"id":"Tm90ZVR3ZWV0OjIxMTc5NDYxMTMxMDYwOTIwMzI=","richtext":{"richtext_tags":[]},"text":"11月4日、小泉防衛大臣と赤澤経済産業大臣は、防衛省において、主要な防衛関連企業の経営層、日本経済団体連合会、日本商工会議所の皆様と「防衛産業基盤戦略」の策定に向けた意見交換会を開催しました。\n政府から、現在の安全保障環境を踏まえた、防衛産業が目指すべき方向性についてご説明した上で、企業の皆様から、防衛産業の現場の知見に基づくご意見を頂き、活発な議論を行いました。\n引き続き、我が国が目指すべき防衛産業基盤の姿と、その実現に向けた政策の方向性を示す、初の「防衛産業基盤戦略」策定に向け、企業の声をしっかりと伺いながら、経済産業省と緊密に連携して検討を進めてまいります。@meti_NIPPON"}}},"rest_id":"2117946113181536528","unmention_data":{},"views":{"count":"16764","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2117947662658068702","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"3895","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117947662658068702","sortIndex":"2118001837268271104"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/uPIPwtf157"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzY2ODI3OTE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関 "},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notificatio