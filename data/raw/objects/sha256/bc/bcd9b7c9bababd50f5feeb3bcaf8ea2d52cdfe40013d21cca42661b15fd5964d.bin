o/CgOW4nmz2d","id_str":"2117912328306106506","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":1,"retweet_count":21,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[191,203],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTc5MTIzMjgyNDczMTY0ODA=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、11/3にテレビ会議形式にて開催されたAPEC閣僚会議に出席。「ハイブリッドな通商政策」の重要性を指摘するとともに、ハイスタンダードなルール形成と「パワー・アジア」の取組の推進、世界のサプライチェーンを混乱させる重要鉱物の恣意的な輸出規制は控えるべきとの認識の共有が重要である旨を訴え、アジア太平洋地域の持続的な成長と地域統合に向けた取組を推進していく旨を表明しました。#meti_daijin"}}},"rest_id":"2117912328306106506","unmention_data":{},"views":{"count":"8076","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117912328306106506","sortIndex":"2118001837268271096"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/TC4C5rZQ6w"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1907032035689996327"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":395067,"following":93},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"266566401","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":5474,"tweets":23400},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/3tgZ0wGHvI"}}}},"edit_control":{"edit_tweet_ids":["2117911412064620544"],"editable_until_msecs":"1793788004000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2117911412064620544","created_at":"Wed Nov 04 09:26:44 +0000 2026","display_text_range":[0,53],"entities":{},"favorite_count":27,"favorited":false,"full_text":"／\n JC-STARとEUサイバーレジリエンス法（CRA）の\n 制度比較に向けた日EU協力が本格化！\n ＼","id_str":"2117911412064620544","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":0,"retweet_count":4,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/11/…","expanded_url":"https://www.meti.go.jp/press/2026/11/20261104002.html","indices":[178,201],"url":"https://t.co/TC4C5rZQ6w"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTc5MTE0MTE5NTU1NDgxNjA=","richtext":{"richtext_tags":[]},"text":"／\n JC-STARとEUサイバーレジリエンス法（CRA）の\n 制度比較に向けた日EU協力が本格化！\n ＼\n日本とEUのサイバーセキュリティ専門家が、両制度や具体的なセキュリティ要件の比較・分析を行います。今後、両制度の共通点や相違点が明確化され、我が国企業が国内外のサイバーセキュリティ制度に効率的に対応できる環境整備が期待されます。\n👇詳細はこちら！\nhttps://t.co/TC4C5rZQ6w"}}},"rest_id":"2117911412064620544","unmention_data":{},"views":{"count":"5279","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117911412064620544","sortIndex":"2118001837268271095"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":7},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1669644725908049922/31IO4zqt_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/3720424033/1647955077"},"core":{"created_at":"Tue Sep 29 00:54:57 +0000 2015","name":"出入国在留管理庁（Immigration Services Agency）","screen_name":"MOJ_IMMI"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozNzIwNDI0MDMz","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"paro