Fri Nov 13 10:31:56 +0000 2026","display_text_range":[0,129],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/3onTwcZGV4","expanded_url":"https://x.com/kantei/status/2121189313258074124/video/1","ext_media_availability":{"status":"Available"},"id_str":"2121188743604523008","indices":[130,153],"media_key":"13_2121188743604523008","media_results":{"result":{"media_key":"13_2121188743604523008"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2121188743604523008/img/3a1Nm3KQWB_9daRl.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/3onTwcZGV4","video_info":{"aspect_ratio":[16,9],"duration_millis":194066,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2121188743604523008/pl/28iC6mfQcQ1PLD5O.m3u8?tag=29&v=ef3"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2121188743604523008/vid/avc1/480x270/33ypdgty-HVlulEL.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2121188743604523008/vid/avc1/640x360/SII6oXcI802_Empb.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2121188743604523008/vid/avc1/1280x720/CjUN7jmu0F0tnAcW.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/3onTwcZGV4","expanded_url":"https://x.com/kantei/status/2121189313258074124/video/1","ext_media_availability":{"status":"Available"},"id_str":"2121188743604523008","indices":[130,153],"media_key":"13_2121188743604523008","media_results":{"result":{"media_key":"13_2121188743604523008"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2121188743604523008/img/3a1Nm3KQWB_9daRl.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/3onTwcZGV4","video_info":{"aspect_ratio":[16,9],"duration_millis":194066,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2121188743604523008/pl/28iC6mfQcQ1PLD5O.m3u8?tag=29&v=ef3"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2121188743604523008/vid/avc1/480x270/33ypdgty-HVlulEL.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2121188743604523008/vid/avc1/640x360/SII6oXcI802_Empb.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2121188743604523008/vid/avc1/1280x720/CjUN7jmu0F0tnAcW.mp4?tag=29"}]}}]},"favorite_count":1245,"favorited":false,"full_text":"【お知らせ】\n本日（１１月１３日）、高市総理は、令和８年熊本地震非常災害復旧復興本部（第２回）会議を行いました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございます。今朝は、ご多用の中、熊本県・木村知事のご出席を賜りましたこと、心から感謝を申し上げます。 https://t.co/3onTwcZGV4","id_str":"2121189313258074124","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":13,"reply_count":66,"retweet_count":198,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExODkzMTMxODI2MzM5ODQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月１３日）、高市総理は、令和８年熊本地震非常災害復旧復興本部（第２回）会議を行いました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございます。今朝は、ご多用の中、熊本県・木村知事のご出席を賜りましたこと、心から感謝を申し上げます。\n　知事が説明をされた『復旧・復興プラン』が掲げる「最速で目指す痛みの最小化」を実現し、被災地の「創造的復興」につなげていくためには、国と県、市町村が目標と課題を共有し、具体的な取組を着実に進めることが重要です。\n　各大臣は、防災庁を司令塔として、県をはじめとする関係自治体と緊密に連携し、『復旧・復興プラン』の実現に向けた支援を進めてください。\n　熊本県が設置する復興基金に対しては、平成２８年熊本地震と同様の考え方により、５２０億円を特別交付税により措置することといたします。これにより、県が策定した『復旧・復興プラン』に基づき、県や県内市町村が行う、多重被災者への手厚い支援や、井戸の復旧をはじめとした被災地域特有の課題への対応など、住民の皆様のニーズに沿ったきめ細かな事業を支援いたします。\n　発災から１００日余りが経過し、被災地は、被災後、初めての冬を迎えます。\n　細野防災大臣を中心に、避難所などに避難されている方々が、寒さや保健・衛生面などに不安を抱かれることのないよう、避難生活環境の改善に重点的に取り組むとともに、建設型応急住宅の年内整備に向けた取組を加速してください。\n　『復旧・復興プラン』で、公費解体について、令和９年１２月中の終了を目指す方針が示されております。\n　笹川環境大臣は、その円滑な実施に向けて、財政支援や人的・技術的支援を更に進めてください。\n　また、井林国土交通大臣を中心に、公共土木施設などの復旧、井戸の早期復旧に向け、施工体制の確保など、取組を進めてください。\n　度重なる災害で被災された事業者の皆様、厳しい状況に置かれています。\n　片山財務大臣、髙木経済産業副大臣は、年内を目途に組成する「令和８年熊本地震復興支援ファンド」などにより、被災事業者の事業再開に向けた取組を更に進めてください。\n　政府が『支援パッケージ』にまとめた施策を着実かつ迅速に推進するとともに、本日、木村知事にご説明いただいた『復旧・復興プラン』をしっかりと支援することで、被災された方々、被災自治体のために、政府一丸となって取組を進めてまいりましょう。\n　以上です。よろしくお願いします。"}}},"rest_id":"2121189313258074124","unmention_data":{},"views":{"count":"66358","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121189313258074124","sortIndex":"2121551066385350615"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2121551066385350698-tweet-2121187731263131853","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/UuyZnWCwsu"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12