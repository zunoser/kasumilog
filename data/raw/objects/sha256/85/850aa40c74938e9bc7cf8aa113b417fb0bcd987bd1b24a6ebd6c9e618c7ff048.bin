":"3_2113563742235758592"}},"media_url_https":"https://pbs.twimg.com/media/HVTjBoIbkAA8M9r.jpg","original_info":{"focus_rects":[{"h":573,"w":1024,"x":0,"y":98},{"h":718,"w":718,"x":306,"y":0},{"h":718,"w":630,"x":394,"y":0},{"h":718,"w":359,"x":665,"y":0},{"h":718,"w":1024,"x":0,"y":0}],"height":718,"width":1024},"sizes":{"large":{"h":718,"resize":"fit","w":1024},"medium":{"h":718,"resize":"fit","w":1024},"small":{"h":477,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/CRbjvnnIg1"}]},"favorite_count":496,"favorited":false,"full_text":"【🛰防衛×宇宙🚀シリーズ㉜】\n第32弾は「宇宙領域アドバイザリーボード」\n \n10月15日、防衛省は第4回宇宙領域アドバイザリーボードを開催📡\n宇宙データセンターの最新動向や、技術の進展による将来の戦闘様相、これを踏まえた防衛省の宇宙政策の方向性について、有識者の皆様と議論しました🛰 https://t.co/CRbjvnnIg1","id_str":"2113571148134858782","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"quoted_status_id_str":"2108456800215617714","quoted_status_permalink":{"display":"x.com/ModJapan_jp/st…","expanded":"https://twitter.com/ModJapan_jp/status/2108456800215617714","url":"https://t.co/3TdZv7e4Z5"},"reply_count":5,"retweet_count":65,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[192,197],"text":"宇宙安保"},{"indices":[199,213],"text":"SDF_SpaceYear"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/space_domain/index.html","indices":[167,190],"url":"https://t.co/jTu8hm2f0k"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM1NzExNDc5NzU0MTM3NjA=","text":"【🛰防衛×宇宙🚀シリーズ㉜】\n第32弾は「宇宙領域アドバイザリーボード」\n \n10月15日、防衛省は第4回宇宙領域アドバイザリーボードを開催📡\n宇宙データセンターの最新動向や、技術の進展による将来の戦闘様相、これを踏まえた防衛省の宇宙政策の方向性について、有識者の皆様と議論しました🛰\n \n👇「宇宙領域アドバイザリーボード」とは？ \nhttps://t.co/jTu8hm2f0k\n\n#宇宙安保 \n#SDF_SpaceYear"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2108456800215617714"}},"rest_id":"2113