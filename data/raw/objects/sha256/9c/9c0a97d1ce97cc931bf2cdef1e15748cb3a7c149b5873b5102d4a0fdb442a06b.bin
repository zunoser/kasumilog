ing":false,"muting":false},"rest_id":"1283221862755913728","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":479,"tweets":1114},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/ymurbTMASP"}}}},"edit_control":{"edit_tweet_ids":["2118627795597234424"],"editable_until_msecs":"1793958803000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2118627795597234424","created_at":"Fri Nov 06 08:53:23 +0000 2026","display_text_range":[0,136],"entities":{},"favorite_count":128,"favorited":false,"full_text":"演奏会は、演奏だけではつくれない。\n \n川口市立高校の高校生特派員が、朝霞駐屯地で中央音楽隊の企画係長・本田さんを取材。\n「音楽のチカラを120％に引き上げる」ために、企画・構成・演出・進行をどう組み立てているのか。\nさらに、楽器の輸送まで自分たちで担う音楽隊の仕事とは。","id_str":"2118627795597234424","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":1,"retweet_count":28,"retweeted":false,"user_id_str":"1283221862755913728"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[237,247],"text":"自衛CANNEWS"},{"indices":[248,254],"text":"自衛官募集"},{"indices":[255,262],"text":"高校生特派員"},{"indices":[263,270],"text":"川口市立高校"},{"indices":[271,276],"text":"吹奏楽部"},{"indices":[277,283],"text":"中央音楽隊"},{"indices":[284,290],"text":"朝霞駐屯地"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/gsdf/jieikanbo…","expanded_url":"https://www.mod.go.jp/gsdf/jieikanbosyu/jcannews/","indices":[211,234],"url":"https://t.co/hn4ZjeUkVu"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2Mjc3OTU0NTAzOTY2NzM=","text":"演奏会は、演奏だけではつくれない。\n \n川口市立高校の高校生特派員が、朝霞駐屯地で中央音楽隊の企画係長・本田さんを取材。\n「音楽のチカラを120％に引き上げる」ために、企画・構成・演出・進行をどう組み立てているのか。\nさらに、楽器の輸送まで自分たちで担う音楽隊の仕事とは。\n華やかなステージを支える、もう一つの「プロの仕事」を動画でご覧ください。\n \n次回「陸上自衛隊中央音楽隊が目指すところ」。\n🔗自衛CAN NEWS\nhttps://t.co/hn4ZjeUkVu\n \n#自衛CANNEWS #