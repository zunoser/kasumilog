34,"y":124},{"h":86,"w":86,"x":689,"y":201}]},"orig":{"faces":[{"h":144,"w":144,"x":3628,"y":1364},{"h":128,"w":128,"x":484,"y":1424},{"h":136,"w":136,"x":232,"y":1432},{"h":140,"w":140,"x":660,"y":1440},{"h":136,"w":136,"x":3492,"y":1448},{"h":132,"w":132,"x":3336,"y":1488},{"h":144,"w":144,"x":2680,"y":1652},{"h":144,"w":144,"x":2392,"y":1672},{"h":140,"w":140,"x":2972,"y":1668},{"h":144,"w":144,"x":1784,"y":1676},{"h":152,"w":152,"x":1176,"y":1680},{"h":140,"w":140,"x":1496,"y":1700},{"h":132,"w":132,"x":912,"y":1712},{"h":212,"w":212,"x":1824,"y":424},{"h":296,"w":296,"x":2352,"y":688}]},"small":{"faces":[{"h":23,"w":23,"x":602,"y":226},{"h":21,"w":21,"x":80,"y":236},{"h":22,"w":22,"x":38,"y":237},{"h":23,"w":23,"x":109,"y":239},{"h":22,"w":22,"x":579,"y":240},{"h":21,"w":21,"x":553,"y":247},{"h":23,"w":23,"x":444,"y":274},{"h":23,"w":23,"x":397,"y":277},{"h":23,"w":23,"x":493,"y":276},{"h":23,"w":23,"x":296,"y":278},{"h":25,"w":25,"x":195,"y":278},{"h":23,"w":23,"x":248,"y":282},{"h":21,"w":21,"x":151,"y":284},{"h":35,"w":35,"x":302,"y":70},{"h":49,"w":49,"x":390,"y":114}]}},"id_str":"2118644655785189376","indices":[138,161],"media_key":"3_2118644655785189376","media_results":{"result":{"media_key":"3_2118644655785189376"}},"media_url_https":"https://pbs.twimg.com/media/HWbwFuFbIAAzPbm.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2592,"w":2592,"x":236,"y":0},{"h":2592,"w":2274,"x":395,"y":0},{"h":2592,"w":1296,"x":884,"y":0},{"h":2592,"w":4096,"x":0,"y":0}],"height":2592,"width":4096},"sizes":{"large":{"h":1296,"resize":"fit","w":2048},"medium":{"h":759,"resize":"fit","w":1200},"small":{"h":430,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/cCFd8amwUg"}]},"favorite_count":37,"favorited":false,"full_text":"大空外務大臣政務官は、外務省とOECD東京センターの共催の第２回OECD・東南アジア経済安全保障政策対話に出席し、開会挨拶を行いました。大空政務官は、国際社会が直面する喫緊の課題である経済安全保障について、OECDと東南アジア諸国が連携して対処していく重要性を強調しました。 https://t.co/cCFd8amwUg","id_str":"2118644748840001764","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":9,"retweet_count":8,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04434.html","indices":[151,174],"url":"https://t.co/Q1H8sahk3P"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2NDQ3NDg3ODEyNDg1MTM=","richtext":{"richtext_tags":[]},"text":"大空外務大臣政務官は、外務省とOECD東京センターの共催の第２回OECD・東南アジア経済安全保障政策対話に出席し、開会挨拶を行いました。大空政務官は、国際社会が直面する喫緊の課題である経済安全保障について、OECDと東南アジア諸国が連携して対処していく重要性を強調しました。\n（写真提供：OECD）\n\nhttps://t.co/Q1H8sahk3P"}}},"rest_id":"2118644748840001764","unmention_data":{},"views":{"count":"4630","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118644748840001764","sortIndex":"2118964268673007573"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1595652744500908032/vw4r2sfI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/242156036/1412822664"},"core":{"created_at":"Mon Jan 24 02:43:14 +0000 2011","name":"文部科学省　MEXT","screen_name":"mextjapan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDIxNTYwMzY=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_pe