ia/HWb0GMhacAAr9Sv.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xeaLvo9ype"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/xeaLvo9ype","expanded_url":"https://x.com/takaichi_sanae/status/2118649128532250733/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2118649062002184193","indices":[103,126],"media_key":"3_2118649062002184193","media_results":{"result":{"media_key":"3_2118649062002184193"}},"media_url_https":"https://pbs.twimg.com/media/HWb0GMha0AEIOdz.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1857,"w":1857,"x":743,"y":0},{"h":1857,"w":1629,"x":971,"y":0},{"h":1857,"w":929,"x":1547,"y":0},{"h":1857,"w":2600,"x":0,"y":0}],"height":1857,"width":2600},"sizes":{"large":{"h":1463,"resize":"fit","w":2048},"medium":{"h":857,"resize":"fit","w":1200},"small":{"h":486,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xeaLvo9ype"}]},"favorite_count":11454,"favorited":false,"full_text":"今朝の閣議終了後に、沖縄県・古謝知事に官邸にお越しいただいて、「沖縄政策協議会」を開催しました。\n\n本日は、古謝知事から、沖縄振興策の更なる拡充と基地負担軽減のために必要な事項についてご要請を頂きました。 https://t.co/xeaLvo9ype","id_str":"2118649128532250733","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":61,"reply_count":238,"retweet_count":1475,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2NDkxMjg0NjA5NTU2NDg=","richtext":{"richtext_tags":[]},"text":"今朝の閣議終了後に、沖縄県・古謝知事に官邸にお越しいただいて、「沖縄政策協議会」を開催しました。\n\n本日は、古謝知事から、沖縄振興策の更なる拡充と基地負担軽減のために必要な事項についてご要請を頂きました。\n\n沖縄は、東アジアの中心に位置する「地理的特性」や、「日本一高い出生率」といった「優位性・潜在力」を有しており、こうした点を活かしながら、「強い沖縄経済」の実現に向けて、「沖縄振興策」を「国家戦略」として、総合的・戦略的に推進していくことが重要です。\n\n先日は、古謝知事から、「医療・バイオ産業分野における地域産業クラスター計画」について、大変熱のこもったご説明をいただきました。\n\n政府が一歩前に出て、「大胆な国内投資」を力強く引き出す、こうした『地域未来戦略』の枠組みなども活用し、「強い沖縄経済」の実現に向けた取組をしっかりと応援していきます。\n\nまた、沖縄県には、戦後80年以上を経た今もなお、多くの「米軍施設」、「区域」が集中しており、沖縄の皆様に、大きな基地負担を担っていただいている事実を重く受け止めています。\n\n重要なことは、１つ１つ着実に結果を出していくことであり、沖縄の「基地負担軽減」を目に見える形で実現できるよう、力を尽くします。\n\n各大臣には、古謝知事のご要望をしっかりと受け止めて、令和9年度予算で対応できるもの、中長期的に取り組む必要があるものなど、内容に応じて、丁寧に検討するよう、指示をしました。\n\n沖縄に関する政策を進めるに当たっては、国・県・市町村、そして、経済界がしっかりと連携することが重要です。\n\n古謝知事をはじめ、沖縄の皆様と緊密に連携して、「沖縄の発展」に向けて、取り組んでいきます。"}}},"rest_id":"2118649128532250733","unmention_data":{},"views":{"count":"252647","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118649128532250733","sortIndex":"2118964268673007574"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,