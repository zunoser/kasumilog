original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/Ulth8hmz2b","video_info":{"aspect_ratio":[16,9],"duration_millis":197133,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2118669937753587712/pl/GMqxJZfjQVPy7J1Y.m3u8?tag=29&v=eae"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2118669937753587712/vid/avc1/480x270/N6Wop6tSrPnP00n8.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2118669937753587712/vid/avc1/640x360/tu4UkduUSoSO_taD.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2118669937753587712/vid/avc1/1280x720/du1IVNJweQtcBJum.mp4?tag=29"}]}}]},"favorite_count":1590,"favorited":false,"full_text":"【お知らせ】\n本日（１１月６日）、高市総理は、サイバーセキュリティに関する関係閣僚会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございます。 https://t.co/Ulth8hmz2b","id_str":"2118671075013968185","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":28,"reply_count":112,"retweet_count":289,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2NzEwNzQ5MzQyNzIwMDA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月６日）、高市総理は、サイバーセキュリティに関する関係閣僚会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございます。\n　昨今の深刻なサイバー攻撃の状況を踏まえ、官房長官を中心に、本日出席している全ての閣僚が知恵を絞って、早期に実施すべき施策を取りまとめた『緊急対策パッケージ』を策定していただきました。\n　『パッケージ』は、ＡＩも活用した基本的な対策の徹底、情報収集・集約、捜査・分析体制の強化、サイバー攻撃への対処の戦略的な実施、被害者支援・被害拡大防止策の強化の４つの柱からなります。\n　各大臣は、『パッケージ』の早期かつ効果的な実行を通じて、「サイバーレジリエンスの向上」と「国民の皆様の不安の払しょく」につなげてください。\n　今朝の閣議におきまして、直ちに必要となる「約１００億円」の予備費を措置しましたが、財務大臣及び関係大臣におかれましては、『パッケージ』全体の実施に必要となる財政措置の確保について、更に検討・調整を進めてください。\n　また、関係大臣においては、制度面や体制面を含めた「中長期的な課題」についても更に検討を進め、官民一体となって、「我が国全体の対処能力の強化」に取り組んでください。\n　今から更に具体的な指示をいたします。\n　古川大臣は、日本を標的としたサイバー攻撃を把握するための情報収集能力を更に強化するため、『サイバー対処能力強化法』の改正について、検討を進めてください。\n　また、ＡＩ時代のサイバー攻撃のスピードに対応し、政府として機動的な対応がとれるよう、国家サイバー統括室への情報集約に要する時間を大幅に短縮するということが必要です。\n　基幹インフラ事業者からの報告について、できれば数時間、少なくとも同日中には、攻撃を受けた旨の情報が伝わるようにすることを目指してください。\n　現行の政府機関などに加えて、民間企業への不審な通信を国家サイバー統括室が、把握・分析することが可能な仕組みについても主要国の例を参考にしながら、検討してください。\n　ＩＴシステムや機器のサプライチェーンリスクも見過ごすことはできません。\n　政府システムの点検を進めるとともに、官民において、リスクを低減するために必要な制度について、国家安全保障局を中心に検討を進めてください。\n　今、この瞬間にも、不正アクセスや情報漏えいの事案が相次ぎ、国民生活や企業活動に大きな影響が生じています。\n　政府の総力を挙げて、我が国全体の対処能力を高めてまいりましょう。以上です。よろしくお願いします。"}}},"rest_id":"2118671075013968185","unmention_data":{},"views":{"count":"78218","state":"EnabledWithCount"}}},"rest_id":"2118680744457576594","unmention_data":{},"views":{"count":"7873","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2118964268673007637-tweet-2118680746462507153","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":607},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1432867630298419206/Uez_q2Zx_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1312820383532294144/1679630740"},"core":{"created_at":"Sun Oct 04 18:22:33 +0000 2020","name":"デジタル庁","screen_name":"digital_jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzEyODIwMzgzNTMyMjk0MTQ0","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notif