"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/jOsYWb3Rzm"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/jOsYWb3Rzm","expanded_url":"https://x.com/takaichi_sanae/status/2118917492097904785/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":77,"w":77,"x":289,"y":537},{"h":119,"w":119,"x":1383,"y":263}]},"medium":{"faces":[{"h":45,"w":45,"x":169,"y":315},{"h":70,"w":70,"x":810,"y":154}]},"orig":{"faces":[{"h":99,"w":99,"x":368,"y":683},{"h":152,"w":152,"x":1757,"y":335}]},"small":{"faces":[{"h":25,"w":25,"x":96,"y":178},{"h":39,"w":39,"x":459,"y":87}]}},"id_str":"2118917265282486272","indices":[136,159],"media_key":"3_2118917265282486272","media_results":{"result":{"media_key":"3_2118917265282486272"}},"media_url_https":"https://pbs.twimg.com/media/HWfoBrma0AA4ffQ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":152,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/jOsYWb3Rzm"}]},"favorite_count":5736,"favorited":false,"full_text":"今朝、北海道西方沖での大規模な地震により原子力発電所である「泊発電所」で事故が発生したことを想定した「原子力総合防災訓練」を行いました。\n\n発電所から5キロメートル圏内にある泊村、共和町の住民の皆様には、バス、ヘリ、船などにより、所定の避難所まで避難していただきました。 https://t.co/jOsYWb3Rzm","id_str":"2118917492097904785","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":32,"reply_count":259,"retweet_count":629,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg5MTc0OTIwMzkwOTQyNzI=","richtext":{"richtext_tags":[]},"text":"今朝、北海道西方沖での大規模な地震により原子力発電所である「泊発電所」で事故が発生したことを想定した「原子力総合防災訓練」を行いました。\n\n発電所から5キロメートル圏内にある泊村、共和町の住民の皆様には、バス、ヘリ、船などにより、所定の避難所まで避難していただきました。\n\n警察、消防、自衛隊の皆様を含め、計1万人以上に参加いただく大規模で実践的な訓練です。\n\n官邸での「原子力災害対策本部会議」には、全閣僚や原子力規制委員会委員長はもちろんのこと、鈴木北海道知事、髙橋泊村長、成田共和町長にもオンラインで参加していただきました。\n\n国民の皆様の命を守るために、常に備えを怠らず、高市内閣として一致団結して防災対策に力を尽くしてまいります。"}}},"rest_id":"2118917492097904785","unmention_data":{},"views":{"count":"162973","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118917492097904785","sortIndex":"2118964268673007615"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"ur