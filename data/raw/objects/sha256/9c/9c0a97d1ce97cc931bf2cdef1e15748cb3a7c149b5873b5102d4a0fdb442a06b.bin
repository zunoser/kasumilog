:"photo","url":"https://t.co/JwZ5wU2RC0"}]},"favorite_count":31,"favorited":false,"full_text":"石井苗子政務官は、11/4に令和8年度計量記念日式典に出席。計量関係功労者表彰を受賞された皆様に表彰状を授与するとともに、挨拶では、社会や産業の在り方が大きく変化する中でも、「正しくはかる」「公正にはかる」という計量制度の基本的な使命は変わらず、計量制度が、我が国の産業競争力と豊かな https://t.co/JwZ5wU2RC0","id_str":"2118667949313818673","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":3,"retweet_count":12,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2Njc5NDkyNTA4NTQ5MTI=","richtext":{"richtext_tags":[]},"text":"石井苗子政務官は、11/4に令和8年度計量記念日式典に出席。計量関係功労者表彰を受賞された皆様に表彰状を授与するとともに、挨拶では、社会や産業の在り方が大きく変化する中でも、「正しくはかる」「公正にはかる」という計量制度の基本的な使命は変わらず、計量制度が、我が国の産業競争力と豊かな国民生活を支える重要な社会基盤である旨を述べました。"}}},"rest_id":"2118667949313818673","unmention_data":{},"views":{"count":"7831","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118667949313818673","sortIndex":"2118964268673007591"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoy