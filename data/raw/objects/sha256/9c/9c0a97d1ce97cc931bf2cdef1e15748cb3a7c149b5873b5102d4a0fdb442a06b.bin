www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265852,"following":44},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7864,"tweets":21945},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2118695467404185781"],"editable_until_msecs":"1793974937000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":19,"bookmarked":false,"conversation_id_str":"2118695467404185781","created_at":"Fri Nov 06 13:22:17 +0000 2026","display_text_range":[0,140],"entities":{},"favorite_count":627,"favorited":false,"full_text":"10月に沖縄県那覇市で発生した強盗殺人事件を受け、日米間で事件の発生防止に向けた協議を重ね、本日、新たな取組について合意しました。\n\n具体的には、\n・日本政府も関与する形での沖縄に駐留する米軍関係者への教育の拡充\n・地元自治体等と連携した日米共同パトロールの強化\nに取り組みます。","id_str":"2118695467404185781","is_quote_status":false,"lang":"ja","quote_count":10,"reply_count":10,"retweet_count":132,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2OTU0NjczNTM4NTM5NTM=","richtext":{"richtext_tags":[]},"text":"10月に沖縄県那覇市で発生した強盗殺人事件を受け、日米間で事件の発生防止に向けた協議を重ね、本日、新たな取組について合意しました。\n\n具体的には、\n・日本政府も関与する形での沖縄に駐留する米軍関係者への教育の拡充\n・地元自治体等と連携した日米共同パトロールの強化\nに取り組みます。\n\nまた、米軍人の勤務時間外の行動に関するルール（リバティー制度）の精査は継続されると米側から説明を受けています。\n\n米軍関係者による事件は、地元の皆様に大きな不安を与えるものであり、あってはなりません。\n防衛省としても、引き続き外務省等としっかりと連携し、事件の発生防止に向けて取り組んでまいります。"}}},"rest_id":"2118695467404185781","unmention_data":{},"views":{"count":"39251","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118695467404185781","sortIndex":"2118964268673007598"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2118695175249863085"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","in