fo":{"focus_rects":[{"h":628,"w":1121,"x":0,"y":0},{"h":804,"w":804,"x":158,"y":0},{"h":804,"w":705,"x":208,"y":0},{"h":804,"w":402,"x":359,"y":0},{"h":804,"w":1121,"x":0,"y":0}],"height":804,"width":1121},"sizes":{"large":{"h":804,"resize":"fit","w":1121},"medium":{"h":804,"resize":"fit","w":1121},"small":{"h":488,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/H26N4vHspo"}]},"favorite_count":839,"favorited":false,"full_text":"令和８年１０月１９日（月）午前から午後にかけて、中国軍の偵察型無人機（ＢＺＫ－００５）×１機及び情報収集機（Ｙ－９）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、太平洋上で旋回後、反転し、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確 https://t.co/H26N4vHspo","id_str":"2112307638465974319","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":12,"quoted_status_id_str":"2112200180078645347","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2112200180078645347","url":"https://t.co/rkDVvpkuDq"},"reply_count":21,"retweet_count":238,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIzMDc2Mzg0MDI5NjE0MDg=","text":"令和８年１０月１９日（月）午前から午後にかけて、中国軍の偵察型無人機（ＢＺＫ－００５）×１機及び情報収集機（Ｙ－９）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、太平洋上で旋回後、反転し、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nまた、同日午前から午後にかけて、中国軍の偵察／攻撃型無人機（ＴＢ－００１）×１機が東シナ海から飛来し、与那国島と台湾の間を通過して太平洋に至り、奄美大島沖まで飛行した後、反転し、沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nこれに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core"