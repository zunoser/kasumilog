域の平和と安定に向けて緊密に連携していくことで一致しました🇯🇵🤝🇲🇾"}}},"rest_id":"2112185670110433319","unmention_data":{},"views":{"count":"52546","state":"EnabledWithCount"}}},"rest_id":"2112190381987344528","unmention_data":{},"views":{"count":"31056","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112190381987344528","sortIndex":"2112423985231691726"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3014024,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":589,"tweets":1878},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112175615839474056"],"editable_until_msecs":"1792420483000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":225,"bookmarked":false,"conversation_id_str":"2112175615839474056","created_at":"Mon Oct 19 13:34:43 +0000 2026","display_text_range":[0,132],"entities":{},"favorite_count":14423,"favorited":false,"full_text":"本日の参議院予算委員会で浜野喜史委員から、国の「財源」に関連して、「国債発行をためらうべきではないのではないか」という旨のご質問を頂きました。\nこのご質問に対する私の答弁について、一部報道で、趣旨が異なる形で伝わっているようですので、その趣旨を改めてご説明します。","id_str":"2112175615839474056","is_quote_status":false,"lang":"ja","quote_count":226,"reply_count":1140,"retweet_count":1882,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIxNzU2MTU3ODQ5NzYzODY=","richtext":{"richtext_tags":[]},"text":"本日の参議院予算委員会で浜野喜史委員から、国の「財源」に関連して、「国債発行をためらうべきではないのではないか」という旨のご質問を頂きました。\nこのご質問に対する私の答弁について、一部報道で、趣旨が異なる形で伝わっているようですので、その趣旨を改めてご説明します。\n\nご質問に対して、私からは\n・「予算編成改革」という大きな枠組の中で、\n・「税収動向」を見極めつつ、「歳出・歳入両面の見直し」を進めることとあわせて、\n・「債務残高対ＧＤＰ比」を安定的に引き下げていく中でも可能となる「財政規模」を精査して、\n・当初予算と補正予算を通じた「通年の国債発行額」を、昨年と同様、適切にコントロールする。\n旨をお答えした上で、\n「これは国債の発行を否定するものではありません。適切にコントロールをいたします」と加えました。\n\nこの答弁については、これまでも累次にわたって答弁している通り、\n・「飲食料品の消費税率引き下げ」などの「財源確保」について、「市場の信認」を得られるよう、「特例公債に頼らず」に確保してまいる方針に何ら変わりはありません。\n・あくまでも「予算編成全体」としては、国債発行を否定するものではない\nとの趣旨で申し上げたものです。"}}},"rest_id":"2112175615839474056","unmention_data":{},"views":{"count":"493960","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112175615839474056","sortIndex":"2112423985231691725"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1907032035689996327"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}]}}},"profile_description_language":"ja","profil