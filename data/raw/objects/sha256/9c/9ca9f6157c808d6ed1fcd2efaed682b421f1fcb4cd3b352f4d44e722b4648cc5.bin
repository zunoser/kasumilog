t":{"media_key":"3_2112314511151751168"}},"media_url_https":"https://pbs.twimg.com/media/HVBy2zsaYAASLjK.jpg","original_info":{"focus_rects":[{"h":676,"w":1207,"x":0,"y":0},{"h":869,"w":869,"x":0,"y":0},{"h":869,"w":762,"x":0,"y":0},{"h":869,"w":435,"x":54,"y":0},{"h":869,"w":1207,"x":0,"y":0}],"height":869,"width":1207},"sizes":{"large":{"h":869,"resize":"fit","w":1207},"medium":{"h":864,"resize":"fit","w":1200},"small":{"h":490,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yEcFUwP9y5"}]},"favorite_count":16904,"favorited":false,"full_text":"本日、種子島宇宙センターから、「H3ロケット」10号機が打ち上げられ、搭載された「火星衛星探査機（MMX）」は所定の軌道に投入されました。\n\n今回の「H3ロケット」の打上げは、6月、8月の打上げに続く、3回連続の成功となり、大変嬉しいニュースです。 https://t.co/yEcFUwP9y5","id_str":"2112314581049803177","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":133,"reply_count":532,"retweet_count":2401,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIzMTQ1ODA5ODY4OTYzODQ=","richtext":{"richtext_tags":[]},"text":"本日、種子島宇宙センターから、「H3ロケット」10号機が打ち上げられ、搭載された「火星衛星探査機（MMX）」は所定の軌道に投入されました。\n\n今回の「H3ロケット」の打上げは、6月、8月の打上げに続く、3回連続の成功となり、大変嬉しいニュースです。\n関係者の皆様のこれまでの御尽力に、心より感謝を申し上げます。\n\n「火星衛星探査機（MMX）」は、世界初となる火星圏から物質を持ち帰る「サンプルリターン」を目指しており、日本が主導する挑戦的な国際宇宙探査ミッションです。\n\n火星の衛星の物質を持ち帰ることで、火星の衛星の起源や太陽系の進化プロセスの解明とともに、将来の「有人火星探査」を見据えた、世界初の火星への往復技術の獲得につながることが期待されています。\n\n「火星衛星探査機（MMX）」は、今後、約1年かけて地球から火星に向けて飛行し、その後、約3年程度、観測などのミッションに取り組んだ後、また約1年かけて地球に戻ってくる予定です。\n\nこの歴史的な挑戦が成功し、火星圏からの「サンプルリターン」が成功することを願っています。\n\n高市内閣では、「宇宙分野」を『日本成長戦略』の「17の戦略分野」に位置付けており、宇宙戦略基金による技術開発や民間事業者への支援を強化し、ロケットの更なる高度化、打上げの高頻度化、信頼性向上に取り組んでまいります。"}}},"rest_id":"2112314581049803177","unmention_data":{},"views":{"count":"308287","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112314581049803177","sortIndex":"2112423985231691728"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation"