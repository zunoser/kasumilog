"media_results":{"result":{"media_key":"3_2112118308225126400"}},"media_url_https":"https://pbs.twimg.com/media/HU_AaS1bkAA2Fm_.jpg","original_info":{"focus_rects":[{"h":274,"w":489,"x":128,"y":0},{"h":274,"w":274,"x":235,"y":0},{"h":274,"w":240,"x":252,"y":0},{"h":274,"w":137,"x":304,"y":0},{"h":274,"w":744,"x":0,"y":0}],"height":274,"width":744},"sizes":{"large":{"h":274,"resize":"fit","w":744},"medium":{"h":274,"resize":"fit","w":744},"small":{"h":250,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/SCoB3C3dxc"}]},"favorite_count":725,"favorited":false,"full_text":"令和８年１０月１７日（土）午後３時頃、海上自衛隊は、口永良部島（鹿児島県）の西約１００ｋｍの海域において、同海域を東進する中国海軍ドンディアオ級情報収集艦（艦番号「７９８」）を確認した。 https://t.co/SCoB3C3dxc","id_str":"2112118313598038439","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"quoted_status_id_str":"2112115067080917251","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2112115067080917251","url":"https://t.co/9dTpLLt0l1"},"reply_count":48,"retweet_count":145,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIxMTgzMTM1NDc2ODU4ODg=","text":"令和８年１０月１７日（土）午後３時頃、海上自衛隊は、口永良部島（鹿児島県）の西約１００ｋｍの海域において、同海域を東進する中国海軍ドンディアオ級情報収集艦（艦番号「７９８」）を確認した。\nその後、１７日（土）から１８日（日）にかけて、当該艦艇が大隅海峡を東進し、太平洋に向けて航行したことを確認した。\n防衛省・自衛隊は、海上自衛隊の第１水上訓練支援隊所属「あまくさ」（佐世保）及び第４航空群所属「Ｐ－１」（厚木）により、警戒監視・情報収集を行った。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360834,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6383,"tweets":12429},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2112115067080917251"],"editable_until_msecs":"1792406047000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":8,"bookmarked":false,"conversation_id_str":"2112115067080917251","created_at":"Mon Oct 19 09:34:07 +0000 2026","display_text_range":[0,93],"entities":{"media":[{"display_url":"pic.x.com/JjirmW5ySp","expande