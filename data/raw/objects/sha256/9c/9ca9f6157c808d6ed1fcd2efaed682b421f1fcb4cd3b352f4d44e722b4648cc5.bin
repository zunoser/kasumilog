focus_rects":[{"h":504,"w":900,"x":0,"y":198},{"h":900,"w":900,"x":0,"y":0},{"h":1026,"w":900,"x":0,"y":0},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/CaR2K0nXBC"}]},"favorite_count":9,"favorited":false,"full_text":"10月18日(日)、井林大臣は、東京貨物ターミナル駅において、コンテナホームや総合物流施設「東京レールゲートEAST」等を視察し、鉄道貨物輸送の取組や課題等の説明をＪＲ貨物から受けました。 https://t.co/CaR2K0nXBC","id_str":"2112393377828515866","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":3,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIzOTMzNzc3ODIzNTgwMTY=","richtext":{"richtext_tags":[]},"text":"10月18日(日)、井林大臣は、東京貨物ターミナル駅において、コンテナホームや総合物流施設「東京レールゲートEAST」等を視察し、鉄道貨物輸送の取組や課題等の説明をＪＲ貨物から受けました。\nまた、羽田空港において、管制塔や今年９月に供用開始した第1旅客ターミナルビル北側サテライト施設等を視察し、運用状況等の説明を受けるとともに、JR東日本羽田空港アクセス線（仮称）等の工事状況を視察し、事業概要や整備効果等の説明を受けました。"}}},"rest_id":"2112393377828515866","unmention_data":{},"views":{"count":"2329","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112393377828515866","sortIndex":"2112423985231691760"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{