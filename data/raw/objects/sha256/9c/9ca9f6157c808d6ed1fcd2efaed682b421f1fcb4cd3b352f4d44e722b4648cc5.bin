ei/status/2112320111990468610/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2112320034500673536","indices":[144,167],"media_key":"3_2112320034500673536","media_results":{"result":{"media_key":"3_2112320034500673536"}},"media_url_https":"https://pbs.twimg.com/media/HVB34TxagAALYgA.jpg","original_info":{"focus_rects":[{"h":717,"w":1280,"x":0,"y":3},{"h":720,"w":720,"x":280,"y":0},{"h":720,"w":632,"x":324,"y":0},{"h":720,"w":360,"x":460,"y":0},{"h":720,"w":1280,"x":0,"y":0}],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/zYppRtY2M1"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/zYppRtY2M1","expanded_url":"https://x.com/kantei/status/2112320111990468610/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2112320034500673536","indices":[144,167],"media_key":"3_2112320034500673536","media_results":{"result":{"media_key":"3_2112320034500673536"}},"media_url_https":"https://pbs.twimg.com/media/HVB34TxagAALYgA.jpg","original_info":{"focus_rects":[{"h":717,"w":1280,"x":0,"y":3},{"h":720,"w":720,"x":280,"y":0},{"h":720,"w":632,"x":324,"y":0},{"h":720,"w":360,"x":460,"y":0},{"h":720,"w":1280,"x":0,"y":0}],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/zYppRtY2M1"}]},"favorite_count":4314,"favorited":false,"full_text":"本日、H3ロケット10号機の打上げに成功し、火星衛星探査機（MMX）が所定の軌道に投入されました。MMXは、世界初となる火星圏からのサンプルリターンを目指す、我が国主導の挑戦的な国際ミッションです。これが宇宙科学・探査の発展につながるよう、政府を挙げて宇宙開発利用を推進してまいります。 h