unt":977,"reply_count":1100,"retweet_count":4222,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIwOTIwNjcxNDA4OTA2MjQ=","richtext":{"richtext_tags":[]},"text":"本日10月19日から、バイクの「希望ナンバー制」の申込受付が始まりました。\n\nこれまでは四輪車が対象でしたが、「バイクでも好きな番号を選びたい」、そんなライダーの皆様の声にお応えするため、二輪車（125cc超）でも、ナンバープレートの４桁の数字を選ぶことができるようになりました。\n\n私も元ライダーの一人として、この制度のスタートを、とても嬉しく思いますし、希望されるライダーの皆様にも、「ご自分ならではの番号」をつけた愛車とともに、バイクライフを楽しんでいただければと思います。\n\n本制度をきっかけとして、バイクの魅力の更なる向上、そして、バイクに関わる市場の活性化が図られることを期待しています。"}}},"rest_id":"2112092067195470091","unmention_data":{},"views":{"count":"792571","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112092067195470091","sortIndex":"2112423985231691699"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2111550193179275264/HSEUpzBV?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.fsa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2111550193179275264/HSEUpzBV?format=png&name=420x420_2","width":400},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2111550193179275264/HSEUpzBV?format=png&name=orig","width":401},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"276848601","path":[]}}},{"ke