inal_info":{"focus_rects":[{"h":510,"w":910,"x":0,"y":0},{"h":711,"w":711,"x":100,"y":0},{"h":711,"w":624,"x":143,"y":0},{"h":711,"w":356,"x":277,"y":0},{"h":711,"w":910,"x":0,"y":0}],"height":711,"width":910},"sizes":{"large":{"h":711,"resize":"fit","w":910},"medium":{"h":711,"resize":"fit","w":910},"small":{"h":531,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EiaOsiJt96"},{"display_url":"pic.x.com/EiaOsiJt96","expanded_url":"https://x.com/jointstaffpa/status/2112200180078645347/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2112200173153894400","indices":[142,165],"media_key":"3_2112200173153894400","media_results":{"result":{"media_key":"3_2112200173153894400"}},"media_url_https":"https://pbs.twimg.com/media/HVAK3ddbQAAQdfn.jpg","original_info":{"focus_rects":[{"h":577,"w":1030,"x":0,"y":0},{"h":739,"w":739,"x":146,"y":0},{"h":739,"w":648,"x":191,"y":0},{"h":739,"w":370,"x":330,"y":0},{"h":739,"w":1030,"x":0,"y":0}],"height":739,"width":1030},"sizes":{"large":{"h":739,"resize":"fit","w":1030},"medium":{"h":739,"resize":"fit","w":1030},"small":{"h":488,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/EiaOsiJt96"}]},"favorite_count":964,"favorited":false,"full_text":"令和８年１０月１９日（月）午前から午後にかけて、中国軍の偵察型無人機（ＢＺＫ－００５）×１機及び情報収集機（Ｙ－９）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、太平洋上で旋回後、反転し、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確 https://t.co/EiaOsiJt96","id_str":"2112200180078645347","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":17,"reply_count":18,"retweet_count":337,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIyMDAxODAwMTk5NDU0NzI=","text":"令和８年１０月１９日（月）午前から午後にかけて、中国軍の偵察型無人機（ＢＺＫ－００５）×１機及び情報収集機（Ｙ－９）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、太平洋上で旋回後、反転し、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nまた、同日午前から午後にかけて、中国軍の偵察／攻撃型無人機（ＴＢ－００１）×１機が東シナ海から飛来し、与那国島と台湾の間を通過して太平洋に至り、奄美大島沖まで飛行した後、反転し、沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nこれに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"rest_id":"2112200180078645347","unmention_data":{},"views":{"count":"63517","state":"EnabledWithCount"}}},"rest_id":"2112307638465974319","unmention_data":{},"views":{"count":"37118","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112307638465974319","sortIndex":"2112423985231691727"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【I