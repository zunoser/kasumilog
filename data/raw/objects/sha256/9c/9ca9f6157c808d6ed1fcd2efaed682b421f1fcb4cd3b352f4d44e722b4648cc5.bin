9},{"h":35,"w":35,"x":573,"y":160},{"h":120,"w":120,"x":93,"y":83}]}},"id_str":"2112140031544709120","indices":[67,90],"media_key":"3_2112140031544709120","media_results":{"result":{"media_key":"3_2112140031544709120"}},"media_url_https":"https://pbs.twimg.com/media/HU_UKwga0AA6-ZU.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":282,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/f22UGp1Na9"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/f22UGp1Na9","expanded_url":"https://x.com/takaichi_sanae/status/2112140216425472202/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":167,"w":167,"x":1295,"y":1019},{"h":233,"w":233,"x":651,"y":753},{"h":323,"w":323,"x":861,"y":293}]},"medium":{"faces":[{"h":98,"w":98,"x":759,"y":597},{"h":137,"w":137,"x":381,"y":441},{"h":189,"w":189,"x":504,"y":172}]},"orig":{"faces":[{"h":213,"w":213,"x":1645,"y":1294},{"h":297,"w":297,"x":827,"y":957},{"h":411,"w":411,"x":1094,"y":373}]},"small":{"faces":[{"h":55,"w":55,"x":430,"y":338},{"h":77,"w":77,"x":216,"y":250},{"h":107,"w":107,"x":286,"y":97}]}},"id_str":"2112140031678959616","indices":[67,90],"media_key":"3_2112140031678959616","media_results":{"result":{"media_key":"3_2112140031678959616"}},"media_url_https":"https://pbs.twimg.com/media/HU_UKxAbUAAURE_.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/f22UGp1Na9"}]},"favorite_count":5987,"favorited":false,"full_text":"本日夕方、『日本経済団体連合会 創立80周年記念行事』にお招きいただきました。\n\n経団連の創立80周年を、心よりお慶び申し上げます。 https://t.co/f22UGp1Na9","id_str":"2112140216425472202","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":130,"reply_count":827,"retweet_count":625,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIxNDAyMTYzNTgzOTE4MDg=","richtext":{"richtext_tags":[]},"text":"本日夕方、『日本経済団体連合会 創立80周年記念行事』にお招きいただきました。\n\n経団連の創立80周年を、心よりお慶び申し上げます。\n\n日本経済は、「デフレ的経済構造」の下で「停滞」を経験してきましたが、経済界の皆様の賃上げのご努力や、これまでの経済政策が実を結びつつある中、流れが確実に変わり始めています。\n\n3年連続で5％台の賃上げが実現し、2025年度の国内の「民間企業設備投資」が過去最高水準に達しました。\n\nこの変化の兆しを一時的なものに終わらせるのか、それとも持続的な「成長の好循環」へ発展させるのか、日本は、その「分岐点」に立っています。\n\nだからこそ、今、高市内閣は、「責任ある積極財政」のもと、『日本成長戦略』と『地域未来戦略』を両輪に、「予算編成方針」も大胆に見直し、政府が一歩前に出て、「民間投資の呼び水」として、大規模かつ長期の、予見可能性の高い財政支出を計画的に行い、大胆な「国内投資」を力強く引き出していきます。\n\n年内に策定する『日本成長戦略実行計画』では、「足元の収益源」、「今後の稼ぎ頭」、「経済安全保障の強化」、の重点分野を中心に、今後5年間の「国内投資」の道筋を明らかにします。\n\nまた、労働市場、金融などの「横断的課題」に対する総合的な施策や、思い切った「規制・制度改革」を実現します。\n\n経団連筒井会長からは、「2040年度に250兆円」という野心的な国内投資目標を掲げていただきました。\n\n経済界の皆様には、政府の動きに呼応いただき、「大胆な投資」と「賃上げ」に取り組んでいただきますことを、期待申し上げています。"}}},"rest_id":"2112140216425472202","unmention_data":{},"views":{"count":"274375","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112140216425472202","sortIndex":"2112423985231691722"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1768892,"following":47},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8332,"tweets":23426},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2112136713640587534"],"editable_until_msecs":"1792411208000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":28,"bookmarked":false,"conversation_id_str":"2112136713640587534","created_at":"Mon Oct 19 11:00:08 +0000 2026","display_text_range":[0,124],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/WwvnM4tcJk","expanded_url":"https://x.com/kantei/status/2112136713640587534/video/1","ext_media_availability":{"status":"Available"},"id_str":"2112135482989846528","indices":[125,148],"media_key":"13_2112135482989846528","media_results":{"result":{"media_key":"13_2112135482989846528"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2112135482989846528/img/wWSTYHSxMhcYwoaG.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/WwvnM4tcJk","video_info":{"aspect_ratio":[16,9],"duration_millis":178433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2112135482989846528/pl/7uDChXPE8gkj-W2l.m3u8?tag=29&v=a2b"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112135482989846528/vid/avc1/480x270/6WUaEqzqIvcRCeJh.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112135482989846528/vid/avc1/640x360/RaUwSvzhg8DILR_9.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112135482989846528/vid/avc1/1280x720/4iLwlcK6CZQd62Po.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/WwvnM4tcJk","expanded_url":"https://x.com/kantei/status/2112136713640587534/video/1","ext_media_availability":{"status":"Available"},"id_str":"2112135482989846528","indices":[125,148],"media_key":"13_2112135482989846528","media_results":{"result":{"media_key":"13_2112135482989846528"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2112135482989846528/img/wWSTYHSxMhcYwoaG.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/WwvnM4tcJk","video_info":{"aspect_ratio":[16,9],"duration_millis":178433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2112135482989846528/pl/7uDChXPE8gkj-W2l.m3u8?tag=29&v=a2b"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112135482989846528/vid/avc1/480x270/6WUaEqzqIvcRCeJh.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112135482989846528/vid/avc1/640x360/RaUwSvzhg8DILR_9.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112135482989846528/vid/avc1/1280x720/4iLwlcK6CZQd62Po.mp4?tag=29"}]}}]},"favorite_count":1984,"favorited":false,"full_text":"【お知らせ】\n本日（１０月１９日）、高市総理は、日本経済団体連合会創立８０周年記念パーティーで挨拶を申し上げました。\n\n※高市総理挨拶要旨(速報版) \n　皆様、こんばんは。日本経済団体連合会ご創立から８０周年ということで、誠におめでとうございます。 https://t.co/WwvnM4tcJk","id_str":"2112136713640587534","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":29,"reply_count":161,"retweet_count":258,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIxMzY3MTM1NjUwNDQ3MzY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月１９日）、高市総理は、日本経済団体連合会創立８０周年記念パーティーで挨拶を申し上げました。\n\n※高市総理挨拶要旨(速報版) \n　皆様、こんばんは。日本経済団体連合会ご創立から８０周年ということで、誠におめでとうございます。\n\n　日本経済は、「デフレ的な経済構造」の中で「停滞」を経験してきましたけれども、本日お集りの皆様の賃上げのご努力ですとか、それからまた、これまでの経済政策も実を結びつつある中、流れが確実に変わり始めています。 \n\n　３年連続で５％台の賃上げが実現し、また、２０２５年度の国内の「民間企業設備投資」が過去最高水準に達しました。 \n\n　この変化の兆しを一時的なものに終わらせてしまうのか、それとも持続的な「成長の好循環」につなげていくのか、日本は今、その分岐点に立っています。 \n\n　だからこそ、今、高市内閣は、「責任ある積極財政」のもと、『日本成長戦略』と『地域未来戦略』を両輪に、「予算編成方針」も大胆に見直しました。政府が一歩前に出て、「民間投資の呼び水」として、大規模かつ長期の、また、予見可能性の高い財政支出を計画的に行い、大胆な「国内投資」を力強く引き出してまいります。\n\n　年内に策定する『日本成長戦略 実行計画』では、「足元の収益源」、そして「今後の稼ぎ頭」、「経済安全保障の強化」、の重点分野を中心に、今後５年間の「国内投資」の道筋を明らかにします。 \n\n　また、労働市場、金融などの「横断的課題」に対する総合的な施策や、思い切った「規制・制度改革」を実現します。 \n\n　筒井会長からは、「２０４０年度には２５０兆円」という野心的な国内投資目標を掲げていただきました。 \n\n　経済界の皆様には、ぜひ、筒井会長がおっしゃいましたとおり、また、政府の動きにも呼応していただき、「大胆な投資」と「賃上げ」に取り組んでいただきますことを、切に切にお願い申し上げ、期待を申し上げます。\n\n　皆様の益々の御活躍と日本経済団体連合会の御発展を祈念申し上げます。本日は御一緒させていただき、本当に嬉しく存じました。予算委員会が終わった閣僚達もたくさん来ておりますので、楽しんでくださいませ。\n　皆様、本当にありがとうございました。おめでとうございます。"}}},"rest_id":"2112136713640587534","unmention_data":{},"views":{"count":"55502","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112136713640587534","sortIndex":"2112423985231691721"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlc