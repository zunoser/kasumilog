y_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":466,"bookmarked":false,"conversation_id_str":"2111247942871036212","created_at":"Sat Oct 17 00:08:29 +0000 2026","display_text_range":[0,84],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/0FMa9pu6A1","expanded_url":"https://x.com/takaichi_sanae/status/2111247942871036212/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":70,"w":70,"x":112,"y":1010},{"h":70,"w":70,"x":112,"y":1158}]},"medium":{"faces":[{"h":41,"w":41,"x":65,"y":591},{"h":41,"w":41,"x":65,"y":678}]},"orig":{"faces":[{"h":140,"w":140,"x":224,"y":2020},{"h":140,"w":140,"x":224,"y":2316}]},"small":{"faces":[{"h":23,"w":23,"x":37,"y":335},{"h":23,"w":23,"x":37,"y":384}]}},"id_str":"2111247704617820160","indices":[85,108],"media_key":"3_2111247704617820160","media_results":{"result":{"media_key":"3_2111247704617820160"}},"media_url_https":"https://pbs.twimg.com/media/HUyomfqaoAALxGW.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":542},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":6,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0FMa9pu6A1"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/0FMa9pu6A1","expanded_url":"https://x.com/takaichi_sanae/status/2111247942871036212/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":70,"w":70,"x":112,"y":1010},{"h":70,"w":70,"x":112,"y":1158}]},"medium":{"faces":[{"h":41,"w":41,"x":65,"y":591},{"h":41,"w":41,"x":65,"y":678}]},"orig":{"faces":[{"h":140,"w":140,"x":224,"y":2020},{"h":140,"w":140,"x":224,"y":2316}]},"small":{"faces":[{"h":23,"w":23,"x":37,"y":335},{"h":23,"w":23,"x":37,"y":384}]}},"id_str":"2111247704617820160","indices":[85,108],"media_key":"3_2111247704617820160","media_results":{"result":{"media_key":"3_2111247704617820160"}},"media_url_https":"https://pbs.twimg.com/media/HUyomfqaoAALxGW.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":542},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":6,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0FMa9pu6A1"}]},"favorite_count":11367,"favorited":false,"full_text":"【日本列島を、強く豊かに。：北九州編】\n\n本日は、『地域未来戦略』に基づき福岡県北九州市が策定した、「フィジカルAI分野における地域産業クラスター計画」をご紹介します。 https://t.co/0FMa9pu6A1","id_str":"2111247942871036212","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":252,"reply_count":997,"retweet_count":1542,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[831,843],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTEyNDc5NDI3OTEzNjg3MDU=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：北九州編】\n\n本日は、『地域未来戦略』に基づき福岡県北九州市が策定した、「フィジカルAI分野における地域産業クラスター計画」をご紹介します。\n\n「フィジカルAI」は、製造、物流、インフラなど、日本に強みのある｢産業現場｣に蓄積された重要データが競争力の源泉となる、我が国の「勝ち筋」となる分野です。\n\n北九州市は、ものづくりのまちとして発展してきた歴史があり、ロボット関連分野に強みを持つ企業が約300社以上集積しています。\n\n北九州学術研究都市に高等教育・研究機関や企業が集まり、ロボティクスとAIの研究基盤・人材供給体制が整っています。\n\n九州の陸海空の交通結節性という立地条件とあいまって、これらが大きな強みとなっています。\n\n北九州市では、この強みを活かし、『地域未来戦略』の国の支援も活用して、実証環境の整備、人材育成、ロボット本体・システムの開発整備への官民投資を行い、フィジカルAIを供給する企業、フィジカルAIの社会実装を支える企業、フィジカルAIを活用する需要側の企業、の3者が有機的に連携する「フィジカルAI社会実装産業クラスター」を形成することを目指しています。\n\n勝ち筋は、製造・物流・港湾・介護・インフラ保守など、多様な実装フィールドを活かした社会実装で先行することです。\n現場での実装を通じて貴重な現場データを蓄積し、製品・サービスの高度化や新たなユースケースの創出につなげ、さらに、社会実装を起点に、産業の集積を一層加速させていくことを狙っています。\n\n私自身、武内和久市長から以下の意気込みを伺いました。\n\n「今般の計画認定を起爆剤として、日本の現場データ、日本の技能、日本の安全設計思想を世界に展開するフィジカルAI拠点都市として、投資と人材をさらに集積してまいります。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を、全力で応援していきます。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2111247942871036212","unmention_data":{},"views":{"count":"463209","state":"EnabledWithCount"}}}}},"entryId":"tweet-2111247942871036212","sortIndex":"2111990274212233186"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/h4f6RdBDGo"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1153541724804792320/1IxAaRLZ_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Tue Dec 09 09:21:37 +0000 2014","name":"気象庁","screen_name":"JMA_kishou"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTIzNjU4MDEy","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"気象庁 (JMA:Japan Meteorological Agency) 公式アカウントです。報道発表やイベント案内などをお届けします。\n警報などの防災気象情報は気象庁ホームページをご覧ください。\n※運用ポリシー：https://t.co/v07vjnVmr5","entities":{"description":{"urls":[{"display_url":"jma.go.jp/jma/menu/socia…","expanded_url":"https://www.jma.go.jp/