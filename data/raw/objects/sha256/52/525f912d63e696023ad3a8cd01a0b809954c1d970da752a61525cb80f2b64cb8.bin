:0,"y":0}],"height":595,"width":842},"sizes":{"large":{"h":595,"resize":"fit","w":842},"medium":{"h":595,"resize":"fit","w":842},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/sEWsuFcYBw"}]},"favorite_count":57,"favorited":false,"full_text":"【豆知識】\n10月18日は #冷凍食品の日 \n\n「10（とう）」＝冷凍（とう）の語呂と\n冷凍食品の保存基準温度-18℃にちなんで制定されました。\n\n高度な品質・衛生管理体制で冷凍食品が作られていることを示す認定マークが変わりました！\nぜひ売り場で探してみてください👀\n\nhttps://t.co/Swjr2jpvnw https://t.co/sEWsuFcYBw","id_str":"2111653501256495308","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":21,"retweeted":false,"user_id_str":"2335919749"},"rest_id":"2111653501256495308","unmention_data":{},"views":{"count":"9475","state":"EnabledWithCount"}}}}},"entryId":"tweet-2111653501256495308","sortIndex":"2111990274212233199"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3014239,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":586,"tweets":1874},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2111645469277552780"],"editable_until_msecs":"1792294087000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":57,"bookmarked":false,"conversation_id_str":"2111645469277552780","created_at":"Sun Oct 18 02:28:07 +0000 2026","display_text_range":[0,141],"entities":{},"favorite_count":7409,"favorited":false,"full_text":"本日、4年に1度のアジア最大の「パラスポーツ」の祭典である「第5回アジアパラ競技大会（2026／愛知・名古屋）」が開幕します。\n\n「アジアパラ競技大会」が日本で開催されるのは、初めてとなります。\n本大会の開催に向けて準備に御尽力いただいた全ての関係者の皆様に、深く感謝申し上げます。","id_str":"2111645469277552780","is_quote_status":false,"lang":"ja","quote_count":71,"reply_count":989,"retweet_count":716,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTE2NDU0NjkyMDYyNTM1Njg=","richtext":{"richtext_tags":[]},"text":"本日、4年に1度のアジア最大の「パラスポーツ」の祭典である「第5回アジアパラ競技大会（2026／愛知・名古屋）」が開幕します。\n\n「アジアパラ競技大会」が日本で開催されるのは、初めてとなります。\n本大会の開催に向けて準備に御尽力いただいた全ての関係者の皆様に、深く感謝申し上げます。\n\nアジアの国・地域から、訪日される多くの選手や関係者の皆様を、心から歓迎申し上げます。\n\n選手の皆様には、自らの限界に果敢に挑戦し、互いを尊重し支え合いながら、アジア最高の舞台で、持てる力を存分に発揮されることを期待しております。\nひたむきに挑戦する姿、最後まであきらめずに挑み続ける姿は、「パラスポーツ」の魅力や可能性を広く社会に伝える契機となることと思います。\n\nこれまで選手を支え続けてこられた御家族や多くの関係者の皆様にも、心から敬意を表します。\n\n本大会は、10月24日までの7日間にわたり、アジアの「トップパラアスリート」の方々が、18の競技で熱い戦いを繰り広げます。\n\n選手の皆様のご健闘を心から祈念いたしますとともに、本大会が多くの方々に勇気と感動を届ける素晴らしいものとなることを願っております。"}}},"rest_id":"2111645469277552780","unmention_data":{},"views":{"count":"298066","state":"EnabledWithCount"}}}}},"entryId":"tweet-2111645469277552780","sortIndex":"2111990274212233198"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2110117613741498368/pGqGo1Ht?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"こども家庭庁は、こどもがまんなかの社会を実現するためにこどもの視点に立って意見を聴き、こどもにとっていちばんの利益を考え、こどもと家庭の、福祉や健康の向上を支援し、こどもの権利を守るためのこども政策に強力なリーダーシップをもって取り組みます。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.cfa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2110117613741498368/pGqGo1Ht?format=png&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2110117613741498368/pGqGo1Ht?format=png&na