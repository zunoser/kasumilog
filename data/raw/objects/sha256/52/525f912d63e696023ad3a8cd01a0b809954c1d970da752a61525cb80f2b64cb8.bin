//pbs.twimg.com/amplify_video_thumb/2111365362537385984/img/Zwjrs7JzjOfhZu4b.jpg","original_info":{"focus_rects":[],"height":2160,"width":3840},"sizes":{"large":{"h":1152,"resize":"fit","w":2048},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/yrbpcCyutO","video_info":{"aspect_ratio":[16,9],"duration_millis":171533,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2111365362537385984/pl/os4JfHN8vcZyKQVG.m3u8?tag=29&v=f4a"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111365362537385984/vid/avc1/480x270/D_4-CPODpJxJuD9Z.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111365362537385984/vid/avc1/640x360/ISDrD6o3eEK3nIoA.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111365362537385984/vid/avc1/1280x720/LcvfZz5_0soOp-PK.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111365362537385984/vid/avc1/1920x1080/X57QjT8r0f4JNVot.mp4?tag=29"},{"bitrate":25128000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2111365362537385984/vid/avc1/3840x2160/MDOIELTIxYmBmix6.mp4?tag=29"}]}}]},"favorite_count":3255,"favorited":false,"full_text":"令和８年度自衛隊殉職隊員追悼式における小泉防衛大臣の追悼の辞です。\n\n【全文】\n自衛隊殉職隊員追悼式\n防衛大臣「追悼の辞」\n\n本日ここに、内閣総理大臣の御臨席のもと、自衛隊殉職隊員追悼式をとり行うにあたり、謹んで追悼の言葉を申し上げます。 https://t.co/yrbpcCyutO","id_str":"2111369538348478918","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":12,"quoted_status_id_str":"2111338765260304416","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2111338765260304416","url":"https://t.co/NWiBJFjiUp"},"reply_count":23,"retweet_count":606,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTEzNjk1MzgyNzI5MzE4NDA=","text":"令和８年度自衛隊殉職隊員追悼式における小泉防衛大臣の追悼の辞です。\n\n【全文】\n自衛隊殉職隊員追悼式\n防衛大臣「追悼の辞」\n\n本日ここに、内閣総理大臣の御臨席のもと、自衛隊殉職隊員追悼式をとり行うにあたり、謹んで追悼の言葉を申し上げます。\n\n防衛省・自衛隊は、我が国の平和と独立を守るという国家存立の根幹にかかわる崇高な任務を担う組織であり、防衛力の根源は、人であり、自衛隊員であります。\n\nその任務を遂行するにあたり、隊員諸官は、「事に臨んでは危険を顧みず、身をもって責務の完遂に務め、もって国民の負託にこたえる」と宣誓し、国民の期待と信頼に応えるべく日夜精励しております。\n\nそのような中にあって、本日顕彰させていただいた方々をはじめ、幾多の方々が、揺るぎない使命感と責任感のもと、身の危険を顧みず、国家・国民のために任務の完遂に務め、志半ばにして、その職に殉じられた事実を、我々は決して忘れることがあってはなりません。\n\nこのようなかけがえのない方々を失ったことは、御遺族はもとより、防衛省・自衛隊、ひいては国家にとって計り知れない損失であり、誠に痛惜の念に堪えません。私は、防衛大臣として、自衛隊員一人ひとりとその御家族を守り抜くことが自らの責務であるとの思いを、あらためて深く胸に刻んでおります。\n\n御霊の御功績を永く顕彰し、その御遺志を受け継ぎ、国民の命と　平和な暮らし、そして、我が国の領土・領海・領空を断固として守り抜くために全身全霊で取り組んでいくことを、ここにお誓い申し上げます。\n\n本日の追悼式にあたり、あらためて御霊の御功績をたたえ、謹んで哀悼の誠を捧げます。\n\n御遺族の皆様には、これからもできる限りのお力添えをしてまいります。\n皆様の御健勝を心から御祈念申し上げ、追悼の言葉といたします。\n\n令和八年十月十七日\n\n防衛大臣　小泉　進次郎"}}},"previous_counts":{"bookmark_count":4,"favorite_count":65,"quote_count":0,"reply_count":0,"retweet_count":13},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1264766,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7764,"tweets":21802},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2111338765260304416"],"editable_until_msecs":"1792220963000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":45,"bookmarked":false,"conversation_id_str":"2111338765260304416","created_at":"Sat Oct 17 06:09:23 +0000 2026","display_text_range":[0,143],"entities":{"media":[{"display_url":"pic.x.com/xAybT1qqny","expanded_url":"https://x.com/ModJapan_jp/status/2111338765260304416/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"face