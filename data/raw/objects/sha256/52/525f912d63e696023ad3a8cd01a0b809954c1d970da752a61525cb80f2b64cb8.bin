d_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3014239,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":586,"tweets":1874},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2111629762477384101"],"editable_until_msecs":"1792290342000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":727,"bookmarked":false,"conversation_id_str":"2111629762477384101","created_at":"Sun Oct 18 01:25:42 +0000 2026","display_text_range":[0,103],"entities":{},"favorite_count":16015,"favorited":false,"full_text":"子供の安全確保は、安全安心な社会の要ですが、子供の犯罪被害は、登下校時、特に下校時（15～18時）に集中しており、また、「地域の目」の減少や帰宅時間の多様化を背景として、「見守りの空白地帯」が生じています。","id_str":"2111629762477384101","is_quote_status":false,"lang":"ja","quote_count":1891,"reply_count":6116,"retweet_count":2408,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"cfa.go.jp/policies/child…","expanded_url":"https://www.cfa.go.jp/policies/child-safety/bouhan/","indices":[1142,1165],"url":"https://t.co/ZMIgmiwKwi"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTE2Mjk3NjIzMDExNjE0NzI=","richtext":{"richtext_tags":[]},"text":"子供の安全確保は、安全安心な社会の要ですが、子供の犯罪被害は、登下校時、特に下校時（15～18時）に集中しており、また、「地域の目」の減少や帰宅時間の多様化を背景として、「見守りの空白地帯」が生じています。\n\nこのため、『登下校防犯プラン』に基づいて、こども家庭庁、警察庁、総務省、文部科学省、国土交通省が連携して、登下校時における総合的な防犯対策の強化に取り組んでいます。\n\n第1に、警察、学校、放課後児童クラブ、ＰＴＡ、地域のボランティアや自治会などの関係者が集まる、登下校時における防犯対策に関する「地域の連携の場」を各地域に構築しています。\nこども家庭庁のウェブサイト内に「登下校防犯ポータルサイト」を設け、関係省庁の施策や各地域の取組の情報を集約・発信し、こうした地域の取組を支援しています。\n\n第2に、関係者が通学路の合同点検を実施し、通学路の「安全マップ」を作成するとともに、危険箇所については警察官や防犯ボランティアなどによる警戒・見守りを実施しています。\n防犯カメラや防犯灯の設置などの環境整備も進めています。\n\n第3に、「不審者情報」について、警察署と学校が直接共有する体制を確立し、迅速に対応できるようにしています。\n放課後児童クラブや放課後子供教室においても、警察と連携するための体制を構築するなど、安全点検を行っています。\n\n第4に、地域住民が、散歩や買い物、犬の散歩などを行う際に防犯の視点を持って見守りを行う「ながら見守り」を推進するとともに、学校安全ボランティア（スクールガード）や、危険に遭遇した子供を一時的に保護する「子供110番の家」など、多様な担い手による見守りの活性化を図っています。\n\n第5に、子供に対する防犯教育の実施や、集団登下校の活用など、子供の危険回避に関する対策も進めています。\n例えば、全国すべての小学校1年生にリーフレット（クイズでまなぼう！たいせつないのちとあんぜん）を配布するなどの取組を行っています。\n\nこうした防犯対策とあわせて、通学路の交通安全の確保も重要な課題です。\n\n令和3年に千葉県八街市で起きた事故を受けて、全国で通学路の合同点検を行い、7万6,404か所について安全対策が必要とされました。\nこのうち、令和8年3月までに、97.6％について、歩道や横断歩道の設置、ガードレール（防護柵）の整備などの対策を実施済みとなっています。\n残る箇所についても暫定的な安全対策を講じています。\n\nこうした取組により、子供の登下校時の安全対策を実施していますが、地域の皆様お一人お一人による「見守り」は大きな力になります。\nそれぞれの地域で子供の安全を守っていけるよう、必要な時には御協力を賜れますと有難く存じます。\n\nhttps://t.co/ZMIgmiwKwi\n（登下校防犯ポータルサイト）"}}},"rest_id":"2111629762477384101","unmention_data":{},"views":{"count":"2541044","state":"EnabledWithCount"}}}}},"entryId":"tweet-2111629762477384101","sortIndex":"2111990274212233197"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3014239,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":586,"tweets":1874},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2111604801419284966"],"editable_until_msecs":"1792284391000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":181,"bookmarked":false,"conversation_id_str":"2111604801419284966","created_at":"Sat Oct 17 23:46:31 +0000 2026","display_text_range":[0,108],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/vQaAGLAoo2","expanded_url":"https://x.com/takaichi_sanae/status/2111604801419284966/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":208,"w":208,"x":712,"y":1040},{"h":276,"w":276,"x":102,"y":196}]},"medium":{"faces":[{"h":121,"w":121,"x":417,"y":609},{"h":161,"w":161,"x":59,"y":114}]},"orig":{"faces":[{"h":416,"w":416,"x":1424,"y":2080},{"h":552,"w":552,"x":204,"y":392}]},"small":{"faces":[{"h":69,"w":69,"x":236,"y":345},{"h":91,"w":91,"x":33,"y":65}]}},"id_str":"2111604776022704128","indices":[109,132],"media_key":"3_2111604776022704128","media_results":{"result":{"media_key":"3_2111604776022704128"}},"media_url_https":"https://pbs.twimg.com/media/HU3tWyTaAAAORYI.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":523,"y":0},{"h":2836,"w":2488,"x":697,"y":0},{"h":2836,"w":1418,"x":1232,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/vQaAGLAoo2"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/vQaAGLAoo2","expanded_url":"https://x.com/takaichi_sanae/status/2111604801419284966/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":208,"w":208,"x":712,"y":1040},{"h":276,"w":276,"x":102,"y":196}]},"medium":{"faces":[{"h":121,"w":121,"x":417,"y":609},{"h":161,"w":161,"x":59,"y":114}]},"orig":{"faces":[{"h":416,"w":416,"x":1424,"y":2080},{"h":552,"w":552,"x":204,"y":392}]},"small":{"faces":[{"h":69,"w":69,"x":236,"y":345},{"h":91,"w":91,"x":33,"y":65}]}},"id_str":"2111604776022704128","indices":[109,132],"media_key":"3_2111604776022704128","media_results":{"result":{"media_key":"3_2111604776022704128"}},"media_url_https":"https://pbs.twimg.com/media/HU3tWyTaAAAORYI.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":523,"y":0},{"h":2836,"w":2488,"x":697,"y":0},{"h":2836,"w":1418,"x":1232,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/vQaAGLAoo2"}]},"favorite_count":9906,"favorited":false,"full_text":"【日本列島を、強く豊かに。：新潟編】\n\n本日は、『地域未来戦略』に基づき新潟県と新潟市が策定した、「アニメーション制作業分野における地域産業クラスター計画」をご紹介します。\n\n新潟県は、全国有数のアニメの集積地です。 https://t.co/vQaAGLAoo2","id_str":"2111604801419284966","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":180,"reply_count":822,"retweet_count":1254,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[913,925],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTE2MDQ4MDEzMzk2MjU0NzI=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：新潟編】\n\n本日は、『地域未来戦略』に基づき新潟県と新潟市が策定した、「アニメーション制作業分野における地域産業クラスター計画」をご紹介します。\n\n新潟県は、全国有数のアニメの集積地です。\n\n日本アニメ史を代表する監督やアニメーター、漫画家といった優れたクリエーターを、複数世代にわたり輩出してきた地域です。\n\n新潟市を中心に8社以上の制作スタジオが立地し、地方都市としては全国有数のアニメーション制作基盤を有しているほか、大学や専門学校などの人材育成基盤も整い、毎年開催される「新潟国際アニメーション映画祭」には、国内外への強い発信力があります。\n\n一方で、県内の制作会社の多くは、東京の元請会社からの受託が中心です。\n制作による収益も、ヒット作が生む知的財産（IP）からの収益も、人材も、首都圏に流出しやすい構造が課題となっています。\n\n新潟県と新潟市は、今回、『地域未来戦略』の国の支援策も活用し、企業誘致の促進、共同利用型制作拠点の整備、新規スタジオの整備等に対する官民投資や、人材育成に向けた取組などを行う予定です。\n\n新潟市を中核に、誘致した外部ハブ企業と県内制作会社の連携を強化し、制作進行や品質管理などのノウハウや技術を蓄積することで、県内で高付加価値な工程を担うことができる体制を構築することとしています。\n\nこれにより、これまで域外へ流出していた人材や付加価値が新潟県にとどまるとともに、県外からの投資も呼び込むことで、県内で学んだ人材が県内で活躍できる場を創出するとともに、映画祭を活かし国内外とのビジネスマッチングを進め、将来的には新潟発の人気作品や、それに伴う知的財産（IP）を生み出す、「産業クラスター」を形成することを目指しています。\n\n私自身、花角知事から以下の意気込みを伺いました。\n\n「国全体のアニメ人材の確保に貢献するとともに、首都圏から投資や人材を呼び込み、将来的に新潟発IPを国内外へ展開する地方モデルを創り上げてまいります。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を、全力で応援していきます。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2111604801419284966","unmention_data":{},"views":{"count":"296314","state":"EnabledWithCount"}}}}},"entryId":"tweet-2111604801419284966","sortIndex":"2111990274212233196"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_ur