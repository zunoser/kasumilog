tion_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":297537,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4971,"tweets":12977},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2111004223831966109"],"editable_until_msecs":"1792141202000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":20,"bookmarked":false,"conversation_id_str":"2111004223831966109","created_at":"Fri Oct 16 08:00:02 +0000 2026","display_text_range":[0,135],"entities":{"media":[{"display_url":"pic.x.com/e48aguVOd9","expanded_url":"https://x.com/gov_online/status/2111004223831966109/photo/1","ext_alt_text":"上部に「イデコが2026年12月1日から変わります。制度改正のポイントは？」と記載されており、その下には、「1。毎月の拠出限度額を引上げ」と記載され、2026年12月制度改正後のイデコ加入者区分ごとの拠出限度額を示した図がある。図には「自営業者等は月額7.5万円、企業年金のない会社員は月額6.2万円、企業型DC等加入の会社員は月額6.2万円、専業主婦（夫）は月額2.3万円、60歳以上70歳未満の一定要件を満たす人は月額6.2万円。」と記載されている。さらにその下には「2。加入可能年齢が「70歳未満」までに引上げ。イデコに加入できる年齢が、現行の65歳未満から70歳未満へ引き上げられます。」と記載されている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":60,"w":60,"x":50,"y":1445},{"h":154,"w":154,"x":156,"y":851}]},"medium":{"faces":[{"h":45,"w":45,"x":37,"y":1083},{"h":115,"w":115,"x":117,"y":638}]},"orig":{"faces":[{"h":60,"w":60,"x":50,"y":1445},{"h":154,"w":154,"x":156,"y":851}]},"small":{"faces":[{"h":25,"w":25,"x":21,"y":614},{"h":65,"w":65,"x":66,"y":361}]}},"id_str":"2110960319367622656","indices"