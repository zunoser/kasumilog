lse,"conversation_id_str":"2111054228198433206","created_at":"Fri Oct 16 11:18:44 +0000 2026","display_text_range":[0,67],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/5514Djuweq","expanded_url":"https://x.com/takaichi_sanae/status/2111054228198433206/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2111054092902825984","indices":[68,91],"media_key":"3_2111054092902825984","media_results":{"result":{"media_key":"3_2111054092902825984"}},"media_url_https":"https://pbs.twimg.com/media/HUv4gz0bgAAcVOs.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":542},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":84,"y":0},{"h":2836,"w":1418,"x":619,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/5514Djuweq"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/5514Djuweq","expanded_url":"https://x.com/takaichi_sanae/status/2111054228198433206/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2111054092902825984","indices":[68,91],"media_key":"3_2111054092902825984","media_results":{"result":{"media_key":"3_2111054092902825984"}},"media_url_https":"https://pbs.twimg.com/media/HUv4gz0bgAAcVOs.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":542},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":84,"y":0},{"h":2836,"w":1418,"x":619,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/5514Djuweq"}]},"favorite_count":20205,"favorited":false,"full_text":"灯油は、冬季の暖房に用いられるなど、国民生活、特に寒冷地の皆様の暮らしを支える不可欠なエネルギーであり、その安定供給は重要な課題です。 https://t.co/5514Djuweq","id_str":"2111054228198433206","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":373,"reply_count":1334,"retweet_count":3057,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTEwNTQyMjgxMzEzNTY2NzI=","richtext":{"richtext_tags":[]},"text":"灯油は、冬季の暖房に用いられるなど、国民生活、特に寒冷地の皆様の暮らしを支える不可欠なエネルギーであり、その安定供給は重要な課題です。\n\n足元では、一部の卸売事業者が、例年の需要を大幅に上回る注文を行う動きがある中で、一部の石油元売事業者が、安定的な供給を継続できるよう、取引先に対して、想定需要を上回る過度な注文を行わないよう要請する動きもみられます。\n\nまた、国際的な精製能力低下に伴い、原油に比して輸入灯油の価格は高止まりしており、国内の灯油価格も、輸入価格の影響を大きく受ける可能性があります。\n\n原油については、10月は前年平月比約10割の調達ができる見込みであり、引き続き、原油や灯油を含む石油製品は「日本全体として必要となる量」を確保できていますが、冬季を迎える前のこのタイミングで対策を強化します。\n\n具体的には、\n①石油元売事業者、輸入商社、卸売事業者に対し、前年同月比で同量の販売・注文を要請します。\n②供給の偏りや流通の目詰まりが発生する場合に石油元売事業者から直接販売を実施する「灯油直販スキーム」を新設します。\n③また、輸入灯油に対し、輸入価格と国内卸価格の差額を「輸入灯油調整単価」として補助する制度を導入します。\n\n石油元売事業者等と緊密にコミュニケーションをとり、灯油をはじめとした石油製品の供給に支障が生じないよう、万全を期すとともに、「供給の偏り」や「目詰まり」など、国民の皆様の命と暮らしを支える分野でのお困りごとを１件１件、着実に解消していきます。"}}},"rest_id":"2111054228198433206","unmention_data":{},"views":{"count":"809772","state":"EnabledWithCount"}}}}},"entryId":"tweet-2111054228198433206","sortIndex":"2111990274212233179"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2111990274212233254-tweet-2111052875472466082","item":{"clientEventInfo":{"component":"suggest_organ