ext":"赤澤大臣は、10/29にベスタス社のアンダーセンCEO、秋田県の鈴木知事等と面談。洋上風力の産業基盤構築について意見交換を行いました。また、赤澤大臣立ち会いのもと、べスタス社、秋田県及び長崎海洋産業クラスター形成推進協議会は、国内の風力発電業界を支える人材育成基盤の構築に向けた共同実現可 https://t.co/QxBMSvwj6I","id_str":"2116137799426723891","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":5,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[162,174],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTYxMzc3OTkzNjM4Mjk3NjE=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、10/29にベスタス社のアンダーセンCEO、秋田県の鈴木知事等と面談。洋上風力の産業基盤構築について意見交換を行いました。また、赤澤大臣立ち会いのもと、べスタス社、秋田県及び長崎海洋産業クラスター形成推進協議会は、国内の風力発電業界を支える人材育成基盤の構築に向けた共同実現可能性調査に関する覚書を締結しました。#meti_daijin"}}},"rest_id":"2116137799426723891","unmention_data":{},"views":{"count":"6769","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116137799426723891","sortIndex":"2117211366325485405"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/5kKZC5EB2T"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXN