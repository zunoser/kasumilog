om/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1793582764"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6l1S0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":298527,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4980,"tweets":12997},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2117081762912498042"],"editable_until_msecs":"1793590200000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":32,"bookmarked":false,"conversation_id_str":"2117081762912498042","created_at":"Mon Nov 02 02:30:00 +0000 2026","display_text_range":[0,117],"entities":{"media":[{"display_url":"pic.x.com/f23tEF44cj","expanded_url":"https://x.com/gov_online/status/2117081762912498042/photo/1","ext_alt_text":"上部に「災害への備えはできていますか？事前に備える家族との取り決め」と記載されており、その横には、災害について話し合う家族のイラストが描かれている。その下には、次のように記載されている。「・集合場所と非常持ち出し品の置き場所を決める。いろいろな災害、発生時間などを想定し、優先順位をつけて、集合場所を3か所決めましょう。また、非常持ち出し品は、いつでも持ち出せるようにしましょう。・身近な避難場所を知っておく。自宅だけでなく、会社で仕事中、商店街にいる時など、よくいる場所の近くの避難場所と安全なルートを確認しておきましょう。・こどもの引渡しルールを決める。こどもを預けている場合は、情報が伝えられないことや迎えができないことを想定して、事前にルールを決めておきましょう。安全確認ができない場合は引わたしをせず、保護者は一緒に園や学校にいるか、避難所に同行します。また、園や学校から避難する場合の避難所を決めておき、避難訓練等の際に一緒に避難行動をして確認しておきましょう。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":55,"w":55,"x":818,"y":137},{"h":72,"w":72,"x":548,"y":558},{"h":97,"w":97,"x":541,"y":123}]},"medium":{"faces":[{"h":48,"w":48,"x":727,"y":121},{"h":64,"w":64,"x":487,"y":496},{"h":86,"w":86,"x":481,"y":109}]},"orig":{"faces":[{"h":55,"w":55,"x":818,"y":137},{"h":72,"w":72,"x":548,"y":558},{"h":97,"w":97,"x":541,"y":123}]},"small":{"faces":[{"h":27,"w":27,"x":411,"y":68},{"h":36,"w":36,"x":275,"y":280},{"h":48,"w":48,"x":272,"y":61}]}},"id_str":"2115976079815200768","indices":[118,141],"media_key":"3_2115976079815200768","media_results":{"result":{"media_key":"3_2115976079815200768"}},"media_url_https":"https://pbs.twimg.com/media/HV11CJ6b0AAKGh4.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":440},{"h":1200,"w":1200,"x":0,"y":150},{"h":1350,"w":1184,"x":0,"y":0},{"h":1350,"w":675,"x":0,"y":0},{"h":1350,"w":1200,"x":0,"y":0}],"height":1350,"width":1200},"sizes":{"large":{"h":1350,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/f23tEF44cj"},{"display_url":"pic.x.com/f23tEF44cj","expanded_url":"https://x.com/gov_online/status/2117081762912498042/photo/1","ext_alt_text":"上部に「・要配慮者（高齢者、肢体不自由者、乳幼児、妊産婦、傷病者等）を想定した備えをする。」と記載されており、その下に、家の中で家族が災害に備えているイラストの他に次のように記載されている。「①家具転倒防止、ガラスの飛散防止などの災害発生時の安全を確保しましょう。②周囲に協力を求める、安否確認方法を決めておくなどの避難場所と避難方法の確認をしましょう。③入手困難になることを想定した非常持ち出し品や薬など、避難所生活や介助生活における最低限必要な物の確保をしましょう。・ハザードマップの確認をしておく。住んでいる地域のハザードマップ（防災マップ）で、身の回りでどんな災害が起こり得るのかを確認しておきましょう。・地震保険を検討する。地震、噴火、津波による建物や家財の損害による災害後の生活を守る経済的備えとして加入を検討しましょう。提供：＋ソナエ・プロジェクト。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":55,"w":55,"x":336,"y":598},{"h":282,"w":282,"x":855,"y":291}]},"medium":{"faces":[{"h":48,"w":48,"x":298,"y":531},{"h":250,"w":250,"x":760,"y":258}]},"orig":{"faces":[{"h":55,"w":55,"x":336,"y":598},{"h":282,"w":282,"x":855,"y":291}]},"small":{"faces":[{"h":27,"w":27,"x":169,"y":300},{"h":141,"w":141,"x":430,"y":146}]}},"id_str":"2115976201512812544","indices":[118,141],"media_key":"3_2115976201512812544","media_results":{"result":{"media_key":"3_2115976201512812544"}},"media_url_https":"https://pbs.twimg.com/media/HV11JPRaAAAyf4e.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":642},{"h":1200,"w":1200,"x":0,"y":150},{"h":1350,"w":1184,"x":0,"y":0},{"h":1350,"w":675,"x":101,"y":0},{"h":1350,"w":1200,"x":0,"y":0}],"height":1350,"width":1200},"sizes":{"large":{"h":1350,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/f23tEF44cj"}],"urls":[{"display_url":"gov-online.go.jp/tokusyu/bousai…","expanded_url":"https://www.gov-online.go.jp/tokusyu/bousai/preparation.html","indices":[83,106],"url":"https://t.co/IAqGhKdOjX"}],"user_mentions":[{"id_str":"2904127170","indices":[107,117],"name":"内閣府","screen_name":"cao_japan"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/f23tEF44cj","expanded_url":"https://x.com/gov_online/status/2117081762912498042/photo/1","ext_alt_text":"上部に「災害への備えはできていますか？事前に備える家族との取り決め」と記載されており、その横には、災害について話し合う家族のイラストが描かれている。その下には、次のように記載されている。「・集合場所と非常持ち出し品の置き場所を決める。いろいろな災害、発生時間などを想定し、優先順位をつけて、集合場所を3か所決めましょう。また、非常持ち出し品は、いつでも持ち出せるようにしましょう。・身近な避難場所を知っておく。自宅だけでなく、会社で仕事中、商店街にいる時など、よくいる場所の近くの避難場所と安全なルートを確認しておきましょう。・こどもの引渡しルールを決める。こどもを預けている場合は、情報が伝えられないことや迎えができないことを想定して、事前にルールを決めておきましょう。安全確認ができない場合は引わたしをせず、保護者は一緒に園や学校にいるか、避難所に同行します。また、園や学校から避難する場合の避難所を決めておき、避難訓練等の際に一緒に避難行動をして確認しておきましょう。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":55,"w":55,"x":818,"y":137},{"h":72,"w":72,"x":548,"y":558},{"h":97,"w":97,"x":541,"y":123}]},"medium":{"faces":[{"h":48,"w":48,"x":727,"y":121},{"h":64,"w":64,"x":487,"y":496},{"h":86,"w":86,"x":481,"y":109}]},"orig":{"faces":[{"h":55,"w":55,"x":818,"y":137},{"h":72,"w":72,"x":548,"y":558},{"h":97,"w":97,"x":541,"y":123}]},"small":{"faces":[{"h":27,"w":27,"x":411,"y":68},{"h":36,"w":36,"x":275,"y":280},{"h":48,"w":48,"x":272,"y":61}]}},"id_str":"2115976079815200768","indices":[118,141],"media_key":"3_2115976079815200768","media_results":{"result":{"media_key":"3_2115976079815200768"}},"media_url_https":"https://pbs.twimg.com/media/HV11CJ6b0AAKGh4.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":440},{"h":1200,"w":1200,"x":0,"y":150},{"h":1350,"w":1184,"x":0,"y":0},{"h":1350,"w":675,"x":0,"y":0},{"h":1350,"w":1200,"x":0,"y":0}],"height":1350,"width":1200},"sizes":{"large":{"h":1350,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/f23tEF44cj"},{"display_url":"pic.x.com/f23tEF44cj","expanded_url":"https://x.com/gov_online/status/2117081762912498042/photo/1","ext_alt_text":"上部に「・要配慮者（高齢者、肢体不自由者、乳幼児、妊産婦、傷病者等）を想定した備えをする。」と記載されており、その下に、家の中で家族が災害に備えているイラストの他に次のように記載されている。「①家具転倒防止、ガラスの飛散防止などの災害発生時の安全を確保しましょう。②周囲に協力を求める、安否確認方法を決めておくなどの避難場所と避難方法の確認をしましょう。③入手困難になることを想定した非常持ち出し品や薬など、避難所生活や介助生活における最低限必要な物の確保をしましょう。・ハザードマップの