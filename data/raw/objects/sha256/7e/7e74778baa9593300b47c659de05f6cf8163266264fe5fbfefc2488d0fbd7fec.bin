w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xhPSoKFOjj"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/xhPSoKFOjj","expanded_url":"https://x.com/takaichi_sanae/status/2116107994635338080/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2116107976759189506","indices":[142,165],"media_key":"3_2116107976759189506","media_results":{"result":{"media_key":"3_2116107976759189506"}},"media_url_https":"https://pbs.twimg.com/media/HV3s_kUaIAIb9e_.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1575,"w":1575,"x":1025,"y":0},{"h":1575,"w":1382,"x":1218,"y":0},{"h":1575,"w":788,"x":1619,"y":0},{"h":1575,"w":2600,"x":0,"y":0}],"height":1575,"width":2600},"sizes":{"large":{"h":1241,"resize":"fit","w":2048},"medium":{"h":727,"resize":"fit","w":1200},"small":{"h":412,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xhPSoKFOjj"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/xhPSoKFOjj","expanded_url":"https://x.com/takaichi_sanae/status/2116107994635338080/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":133,"w":133,"x":841,"y":273},{"h":173,"w":173,"x":519,"y":207}]},"medium":{"faces":[{"h":78,"w":78,"x":492,"y":160},{"h":101,"w":101,"x":304,"y":121}]},"orig":{"faces":[{"h":170,"w":170,"x":1068,"y":347},{"h":220,"w":220,"x":660,"y":264}]},"small":{"faces":[{"h":44,"w":44,"x":279,"y":90},{"h":57,"w":57,"x":172,"y":69}]}},"id_str":"2116107976809619456","indices":[142,165],"media_key":"3_2116107976809619456","media_results":{"result":{"media_key":"3_2116107976809619456"}},"media_url_https":"https://pbs.twimg.com/media/HV3s_kgboAAKDLQ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xhPSoKFOjj"}]},"favorite_count":7173,"favorited":false,"full_text":"本日、第8回「地域未来戦略関係副大臣等会議」に出席し、『地域未来戦略』に関する報告を受けました。\n\n会議では、14人の知事や市町村長の皆様から、各地域の特色を活かした大変意欲的な『地域産業クラスター計画』や『地場産業成長プラン』をご説明いただきました。\n誠にありがとうございました。 https://t.co/xhPSoKFOjj","id_str":"2116107994635338080","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":56,"reply_count":415,"retweet_count":787,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"cas.go.jp/jp/seisaku/chi…","expanded_url":"https://www.cas.go.jp/jp/seisaku/chiikimirai/kankei_fukudaijin/dai8/shiryo1_01.pdf","indices":[294,317],"url":"https://t.co/rv3j28t7VV"},{"display_url":"cas.go.jp/jp/seisaku/chi…","expanded_url":"https://www.cas.go.jp/jp/seisaku/chiikimirai/kankei_fukudaijin/dai8/shiryo1_02.pdf","indices":[318,341],"url":"https://t.co/UprRk8kcIK"},{"display_url":"cas.go.jp/jp/seisaku/chi…","expanded_url":"https://www.cas.go.jp/jp/seisaku/chiikimirai/kankei_fukudaijin/dai8/shiryo1_03.pdf","indices":[342,365],"url":"https://t.co/rqhYNXb21D"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTYxMDc5OTQ0NTA3ODgzNTI=","richtext":{"richtext_tags":[]},"text":"本日、第8回「地域未来戦略関係副大臣等会議」に出席し、『地域未来戦略』に関する報告を受けました。\n\n会議では、14人の知事や市町村長の皆様から、各地域の特色を活かした大変意欲的な『地域産業クラスター計画』や『地場産業成長プラン』をご説明いただきました。\n誠にありがとうございました。\n\n※今回ご説明いただいた、秋田県・福島県・群馬県・埼玉県・愛知県・兵庫県・和歌山県・沖縄県の『地域産業クラスター計画』、山梨県甲州市・岐阜県美濃加茂市・三重県四日市市・京都府・奈良県明日香村・高知県本山町の『地場産業成長プラン』や、これまでの会議で報告済みの自治体の2件目以降の計画の概要はこちらです。\nhttps://t.co/rv3j28t7VV\nhttps://t.co/UprRk8kcIK\nhttps://t.co/rqhYNXb21D\n\n医療・バイオ、次世代モビリティ、航空宇宙・ドローンをはじめとする「成長分野」から、農林業、伝統工芸品産業など、「地域に根差した産業」まで、全国各地で、それぞれの強みを活かした具体的な計画が着実に形になってきています。\n\n今回で、『地域産業クラスター計画』を中心に、合計100を超える計画が、策定・公表されます。\n\n今後は、「市町村による計画策定」についても、一層推進していきます。\n\n多くの自治体の皆様が『地場産業成長プラン』を策定できるよう、総務省、都道府県との連携強化に加えて、関係省庁や地方支分部局も巻き込んだ市町村への「伴走支援体制」を強化していきます。\n\nあわせて、「商工会・商工会議所による経営指導」を含め、市町村が策定する計画の下で関係企業を「伴走支援」する体制を強化するための支援の在り方についても、検討していきます。\n\n政府の側でも、『地域未来戦略』の推進体制を強化するため、関係各省庁の局長等からなる「地域未来戦略推進担当官」を9名発令し、本日の会議にも参加しました。\n\n「推進担当官」は、年末までに策定する『地域未来戦略実現フレーム』の「分野ごと」の責任者です。\nそれぞれの「担当分野」について、全力でその職にあたり、「自治体からの具体的なニーズ」に応えるとともに、『実現フレーム』の策定作業を加速してもらいます。\n\n今も、日本全国の自治体で、計画策定が進められていると承知しています。\n今後、更なるお話を伺えることを、楽しみにしています。"}}},"rest_id":"2116107994635338080","unmention_data":{},"views":{"count":"226796","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116107994635338080","sortIndex":"2117211366325485388"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHWHYhSxAJrgKAAIdYWLLhtqwtQgAAwAAAAEAAA"},"entryId":"cursor-top-2117211366325485480","sortIndex":"2117211366325485480"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHWHYhSw__0kKAAIdXe0CbpqBYAgAAwAAAAIAAA"},"entryId":"cursor-bottom-2117211366325485387","sortIndex":"2117211366325485387"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}