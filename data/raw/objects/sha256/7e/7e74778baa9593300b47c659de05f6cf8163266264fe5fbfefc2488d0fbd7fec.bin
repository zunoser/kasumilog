":{"faces":[]},"small":{"faces":[]}},"id_str":"2115735594559287296","indices":[130,153],"media_key":"3_2115735594559287296","media_results":{"result":{"media_key":"3_2115735594559287296"}},"media_url_https":"https://pbs.twimg.com/media/HVyaUEhbMAAGEFy.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":696},{"h":900,"w":900,"x":0,"y":300},{"h":1026,"w":900,"x":0,"y":174},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HZHNFv5yP5"}],"urls":[{"display_url":"gov-online.go.jp/article/201611…","expanded_url":"https://www.gov-online.go.jp/article/201611/entry-9331.html","indices":[96,119],"url":"https://t.co/Mmz7jfcZAU"}],"user_mentions":[{"id_str":"2891516809","indices":[120,129],"name":"警察庁","screen_name":"NPA_KOHO"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/HZHNFv5yP5","expanded_url":"https://x.com/gov_online/status/2116772227131851125/photo/1","ext_alt_text":"上部に「被害に遭われたかたや、そのご家族を支える支援があります」と記載されており、その横に、犯罪被害者等支援シンボルマーク「ギュっとちゃん」が描かれている。その下には、次のように記載されている。「警察における支援。相談窓口の設置、心のケア、安全確保、犯罪被害給付制度による給付金の支給など。裁判における支援。損害賠償命令制度や、被害者参加制度（犯罪被害者等が刑事裁判に参加する制度）。地方公共団体における支援。相談窓口の設置、住まいや生活に関する支援。ほかにも民間の団体における支援もあります。詳しくは警察庁「犯罪被害者等施策ホームページ」へ。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115735594559287296","indices":[130,153],"media_key":"3_2115735594559287296","media_results":{"result":{"media_key":"3_2115735594559287296"}},"media_url_https":"https://pbs.twimg.com/media/HVyaUEhbMAAGEFy.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":696},{"h":900,"w":900,"x":0,"y":300},{"h":1026,"w":900,"x":0,"y":174},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HZHNFv5yP5"}]},"favorite_count":237,"favorited":false,"full_text":"犯罪被害は、決して他人ごとではありません。\n\n被害に遭われたかたやそのご家族が再び平穏な生活を取り戻せるよう、様々な支援制度があります。\n\n11月1日から12月1日は「犯罪被害者月間」です。\nhttps://t.co/Mmz7jfcZAU\n@NPA_KOHO https://t.co/HZHNFv5yP5","id_str":"2116772227131851125","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":81,"reply_count":333,"retweet_count":100,"retweeted":false,"user_id_str":"461064204"},"rest_id":"2116772227131851125","unmention_data":{},"views":{"count":"26168","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116772227131851125","sortIndex":"2117211366325485444"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2114652360517533696/u011noBP?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"児童虐待防止推進特設サイト","type":"STRING"}},{"key":"domain","value":{"string_value":"kodomoshien.cfa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2114652360517533696/u011noBP?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":1130,"url":"https://pbs.twimg.com/card_img/2114652360517533696/u011noBP?format=jpg&name=orig","width":2000},"type"