6,"y":275},{"h":62,"w":62,"x":394,"y":297}]},"orig":{"faces":[{"h":98,"w":98,"x":998,"y":504},{"h":122,"w":122,"x":660,"y":368},{"h":110,"w":110,"x":974,"y":380},{"h":116,"w":116,"x":1308,"y":470},{"h":106,"w":106,"x":674,"y":508}]},"small":{"faces":[{"h":32,"w":32,"x":331,"y":167},{"h":40,"w":40,"x":219,"y":122},{"h":36,"w":36,"x":323,"y":126},{"h":38,"w":38,"x":434,"y":156},{"h":35,"w":35,"x":223,"y":168}]}},"id_str":"2116311811410825216","indices":[141,164],"media_key":"3_2116311811410825216","media_results":{"result":{"media_key":"3_2116311811410825216"}},"media_url_https":"https://pbs.twimg.com/media/HV6mYTkbEAAz2Ko.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1463,"w":1463,"x":444,"y":0},{"h":1463,"w":1283,"x":534,"y":0},{"h":1463,"w":732,"x":809,"y":0},{"h":1463,"w":2048,"x":0,"y":0}],"height":1463,"width":2048},"sizes":{"large":{"h":1463,"resize":"fit","w":2048},"medium":{"h":857,"resize":"fit","w":1200},"small":{"h":486,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/R2t59GguAC"}]},"favorite_count":265,"favorited":false,"full_text":"米国・アトランタを訪問中の茂木外務大臣は、本年4度目の日米韓外相会合を実施し、北極太平洋パートナーシップに関する日米韓協力覚書に署名しました。三者は、北朝鮮への対応や安全保障、経済安全保障分野における協力の進展を歓迎し、地域の平和と安定のため、引き続き三か国の具体的な協力を積み重 https://t.co/R2t59GguAC","id_str":"2116311863751483657","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":12,"retweet_count":53,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/fp/unp/p…","expanded_url":"https://www.mofa.go.jp/mofaj/fp/unp/pageit_000001_00016.html","indices":[156,179],"url":"https://t.co/kxvq7plUrP"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTYzMTE4NjM2NDI0ODg4MzI=","richtext":{"richtext_tags":[]},"text":"米国・アトランタを訪問中の茂木外務大臣は、本年4度目の日米韓外相会合を実施し、北極太平洋パートナーシップ