3.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/480x852/miIX24a4j8zPx4KP.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/720x1280/HFyyyfk8W13NnBN4.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/1080x1920/kF6g797IKwmv2yC6.mp4?tag=29"}]}}]},"favorite_count":2310,"favorited":false,"full_text":"【「#わたしの自衛隊記念日」募集！】\n\n防衛省・自衛隊では、毎年11月1日を「自衛隊記念日」としています。\n自衛隊記念日の前後では、隊員の士気高揚を図りつつ、自衛隊に対する国民の皆様からの御理解を深めていただくため、全国各地で行事やイベントなど様々な取組を行っています。 https://t.co/DXZzR7F8de","id_str":"2114552601970909634","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":26,"reply_count":46,"retweet_count":457,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[2,13],"text":"わたしの自衛隊記念日"},{"indices":[294,305],"text":"わたしの自衛隊記念日"},{"indices":[363,370],"text":"自衛隊記念日"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ1NTI2MDE5MjQ4MTY4OTY=","text":"【「#わたしの自衛隊記念日」募集！】\n\n防衛省・自衛隊では、毎年11月1日を「自衛隊記念日」としています。\n自衛隊記念日の前後では、隊員の士気高揚を図りつつ、自衛隊に対する国民の皆様からの御理解を深めていただくため、全国各地で行事やイベントなど様々な取組を行っています。\n \nしかし、「皆さんにとっての」自衛隊記念日はもっと他にもあるはず！\n \n災害派遣で見かけた自衛隊。\n航空祭で見たブルーインパルス。\n基地見学での思い出。\n家族や友人とのエピソード。\n \nこれまで自衛隊と関わったことがある方も、ない方も、\n「初めて自衛隊を知った日」\n「心に残っている出来事」\nなどがあれば、\n \n「#わたしの自衛隊記念日」というハッシュタグをつけてぜひ教えてください。\n \n一人ひとりの「あなたの自衛隊記念日」をお待ちしています！\n \n#自衛隊記念日"}}},"rest_id":"2114552601970909634","unmention_data":{},"views":{"count":"398959","state":"EnabledWithCount"}}},"rest_id":"2116726937171226652","unmention_data":{},"views":{"count":"365675","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116726937171226652","sortIndex":"2117211366325485442"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":9},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"公正取引委員会の公式アカウントです。 \n公正かつ自由な競争について理解を深めていただくため、措置命令等の報道発表、関係法令（独占禁止法、取適法、フリーランス法、スマホ法等）の解説、イベント・採用情報等をお届けします。 \n#独占禁止法 #取適法 #スマホ法 #フリーランス法","entities":{"description":{},"url":{"urls":[{"display_url":"jftc.go.jp/index.html","expanded_url":"http://www.jftc.go.jp/index.html","indices":[0,23],"url":"https://t.co/izoLg0k5lW"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":100432,"following":34},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2455900080","super_follow_eligible":false,"super_followed_by":false,"super_following":fals