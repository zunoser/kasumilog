4","url":"https://video.twimg.com/amplify_video/2116439325764460544/vid/avc1/1280x720/LtjqvkRkRWeyk-Ix.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/4Bn4ciJ4Ot","expanded_url":"https://x.com/kantei/status/2116441210865021367/video/1","ext_media_availability":{"status":"Available"},"id_str":"2116439325764460544","indices":[113,136],"media_key":"13_2116439325764460544","media_results":{"result":{"media_key":"13_2116439325764460544"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2116439325764460544/img/Q1FJbf7Um2dUXZCp.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/4Bn4ciJ4Ot","video_info":{"aspect_ratio":[16,9],"duration_millis":179033,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2116439325764460544/pl/fmjC3UjDs02a-CBH.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2116439325764460544/vid/avc1/480x270/8HmTPs8ELz6Dq4Y6.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2116439325764460544/vid/avc1/640x360/2_dFhQJoYVbr6yhA.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2116439325764460544/vid/avc1/1280x720/LtjqvkRkRWeyk-Ix.mp4?tag=29"}]}}]},"favorite_count":5993,"favorited":false,"full_text":"【お知らせ】\n本日（１０月３１日）、高市総理は、全国殉職警察職員・警察協力殉難者慰霊祭に参列しました。\n\n※高市総理追悼の辞(速報版)\n　「全国殉職警察職員・警察協力殉難者慰霊祭」に当たり、謹んで追悼のことばを申し上げます。 https://t.co/4Bn4ciJ4Ot","id_str":"2116441210865021367","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":19,"reply_count":128,"retweet_count":728,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTY0NDEyMTA3OTM3MzQxNDQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月３１日）、高市総理は、全国殉職警察職員・警察協力殉難者慰霊祭に参列しました。\n\n※高市総理追悼の辞(速報版)\n　「全国殉職警察職員・警察協力殉難者慰霊祭」に当たり、謹んで追悼のことばを申し上げます。\n　このたび新たに祀られた六名の皆様は、我が国の治安を守るために、職務に殉ぜられた警察職員と、自らの危難をも顧みず、人命救助のために力を尽くされた方々です。\n　皆様が身をもって示された、その「高潔な精神」と「確固たる勇気」に対し、衷心より敬意と感謝の意を表しますとともに、改めて哀悼の誠を捧げます。\n　愛するご家族を失われたご遺族の深いお悲しみを思うと、悲痛の念に堪えません。\n　ご遺族の皆様に対し、心からお悔やみを申し上げます。\n　私たちは、これまでに祀られた六千二百九十二柱の御霊の尊い犠牲に思いを致し、\n・職務に対する強い誇りと使命感、\n・他者に対する思いやりと献身、\n・そして勇気ある決断と行動を胸に刻み、\nそのご遺志にこたえ、我が国で暮らす皆様を、犯罪や災害の脅威から守り「安全で安心な日本」を次の世代に引き継ぐために、力を尽くします。\n　結びに、国の治安と人命を守るために犠牲となられた方々の御霊の安寧と、ご遺族の皆様のご平安とご健勝をお祈り申し上げます。\n\n令和８年１０月３１日\n内閣総理大臣　高市　早苗"}}},"rest_id":"2116441210865021367","unmention_data":{},"views":{"count":"115304","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116441210865021367","sortIndex":"2117211366325485423"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2112685948031115264/ejgTfe-A?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.pref.toyama.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2112685948031115264/ejgTfe-A?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url