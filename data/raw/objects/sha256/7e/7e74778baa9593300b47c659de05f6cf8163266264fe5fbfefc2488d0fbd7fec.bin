ls":[],"urls":[{"display_url":"mofa.go.jp/mofaj/fp/nsp/p…","expanded_url":"https://www.mofa.go.jp/mofaj/fp/nsp/pageit_000001_00005.html","indices":[263,286],"url":"https://t.co/8ywbfYOjTO"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTY1Mzg2NDAzMjMyMzU4NDE=","richtext":{"richtext_tags":[]},"text":"米国・アトランタを訪問中の茂木外務大臣は、ペニー・ウォン・オーストラリア外務大臣、スブラマニヤム・ジャイシャンカル・インド外務大臣及びマルコ・ルビオ米国国務長官と日米豪印外相会合を行いました。茂木大臣から、5月及び7月に続き、1年で3回目の外相会合が開催されたことを歓迎するとともに、本会合は、G20外相会合の機会に、特に経済分野を含む実践的な協力の成果を示す有意義な機会である旨述べました。四大臣は、自由で開かれたインド太平洋（FOIP）の実現のために日米豪印の具体的な協力を着実に推進していくことを改めて確認しました。\n\nhttps://t.co/8ywbfYOjTO"}}},"rest_id":"2116538640436535303","unmention_data":{},"views":{"count":"27027","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116538640436535303","sortIndex":"2117211366325485428"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},