個人情報や電話の内容に関する秘密は守られます。確信がなくても大丈夫です。連絡するかたが虐待かどうかを判断する必要はありません。虐待のサインを少しでも感じたら、ためらわず連絡してください。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":66,"w":66,"x":522,"y":288},{"h":79,"w":79,"x":591,"y":196}]},"medium":{"faces":[{"h":66,"w":66,"x":522,"y":288},{"h":79,"w":79,"x":591,"y":196}]},"orig":{"faces":[{"h":66,"w":66,"x":522,"y":288},{"h":79,"w":79,"x":591,"y":196}]},"small":{"faces":[{"h":37,"w":37,"x":295,"y":163},{"h":44,"w":44,"x":334,"y":111}]}},"id_str":"2115734849529249792","indices":[148,171],"media_key":"3_2115734849529249792","media_results":{"result":{"media_key":"3_2115734849529249792"}},"media_url_https":"https://pbs.twimg.com/media/HVyZotEbAAAiiMz.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":378},{"h":900,"w":900,"x":0,"y":180},{"h":1026,"w":900,"x":0,"y":117},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mMgvhlvdzc"}],"urls":[{"display_url":"gov-online.go.jp/article/202011…","expanded_url":"https://www.gov-online.go.jp/article/202011/entry-8616.html","indices":[111,134],"url":"https://t.co/NYwj7Phi0Y"}],"user_mentions":[{"id_str":"1584811678532657152","indices":[135,147],"name":"こども家庭庁","screen_name":"KodomoKatei"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/mMgvhlvdzc","expanded_url":"https://x.com/gov_online/status/2116719374274834514/photo/1","ext_alt_text":"上部に「児童虐待かも？」と思ったら。と記載されており、その下にこどもを気にかけるおとなたちのイラストが描かれている。その下には、次のように記載されている。「児童相談所虐待対応ダイヤル。イチハチキュウ（いちはやく）にお電話を。匿名でお電話できます。電話した人の個人情報や電話の内容に関する秘密は守られます。確信がなくても大丈夫です。連絡するかたが虐待かどうかを判断する必要はありません。虐待のサインを少しでも感じたら、ためらわず連絡してください。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":66,"w":66,"x":522,"y":288},{"h":79,"w":79,"x":591,"y":196}]},"mediu