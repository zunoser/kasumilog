l":"pic.x.com/6Mdngj0PaK","expanded_url":"https://x.com/takaichi_sanae/status/2116696376780460430/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":125,"w":125,"x":829,"y":1415},{"h":307,"w":307,"x":401,"y":1215}]},"medium":{"faces":[{"h":73,"w":73,"x":485,"y":829},{"h":180,"w":180,"x":235,"y":711}]},"orig":{"faces":[{"h":215,"w":215,"x":1421,"y":2425},{"h":527,"w":527,"x":688,"y":2082}]},"small":{"faces":[{"h":41,"w":41,"x":275,"y":470},{"h":102,"w":102,"x":133,"y":403}]}},"id_str":"2116696306534277120","indices":[108,131],"media_key":"3_2116696306534277120","media_results":{"result":{"media_key":"3_2116696306534277120"}},"media_url_https":"https://pbs.twimg.com/media/HWAEE3hbYAAq7Wu.jpg","original_info":{"focus_rects":[{"h":1389,"w":2480,"x":0,"y":2119},{"h":2480,"w":2480,"x":0,"y":1028},{"h":2827,"w":2480,"x":0,"y":681},{"h":3508,"w":1754,"x":0,"y":0},{"h":3508,"w":2480,"x":0,"y":0}],"height":3508,"width":2480},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6Mdngj0PaK"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/6Mdngj0PaK","expanded_url":"https://x.com/takaichi_sanae/status/2116696376780460430/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2116696324422909952","indices":[108,131],"media_key":"3_2116696324422909952","media_results":{"result":{"media_key":"3_2116696324422909952"}},"media_url_https":"https://pbs.twimg.com/media/HWAEF6KaQAAVBc9.jpg","original_info":{"focus_rects":[{"h":1389,"w":2480,"x":0,"y":0},{"h":2480,"w":2480,"x":0,"y":0},{"h":2827,"w":2480,"x":0,"y":0},{"h":3508,"w":1754,"x":0,"y":0},{"h":3508,"w":2480,"x":0,"y":0}],"height":3508,"width":2480},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6Mdngj0PaK"}]},"favorite_count":10897,"favorited":false,"full_text":"本日11月1日から12月1日までは「犯罪被害者月間」です。\n\n犯罪被害について国民の皆様に一層のご理解をいただけるよう、昨年から「犯罪被害者週間」を月間とし、十分な期間をかけて集中的な広報啓発を行うこととしました。 https://t.co/6Mdngj0PaK","id_str":"2116696376780460430","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1121,"reply_count":4988,"retweet_count":1877,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"npa.go.jp/hanzaihigai/ko…","expanded_url":"https://www.npa.go.jp/hanzaihigai/koukei/week.html#gsc.tab=0","indices":[872,895],"url":"https://t.co/mDpFFMgazR"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTY2OTYzNzY2MTY5MDY3NTI=","richtext":{"richtext_tags":[]},"text":"本日11月1日から12月1日までは「犯罪被害者月間」です。\n\n犯罪被害について国民の皆様に一層のご理解をいただけるよう、昨年から「犯罪被害者週間」を月間とし、十分な期間をかけて集中的な広報啓発を行うこととしました。\n\n明日2日には羽田空港第1ターミナルでオープニングイベントを、9日には「こころをつなぐ国民イベント2026～ギュっと集まれ支援の輪～」を開催します。\n\n犯罪は、ある日突然、大切な命や平穏な日常を奪います。\n被害に遭われたご本人はもとより、ご家族やご遺族にも、心身の不調、各種手続に伴う負担など、長く様々な苦しみをもたらします。\n\n本年3月の『第5次犯罪被害者等基本計画」の策定に当たっては、被害に遭われた方々や支援に携わる皆様から、「どのような支援を受けられるのか分からない」「相談先ごとに同じ説明を繰り返すのがつらい」など約400項目に及ぶご意見を頂戴しました。\n\n政府では、こうした切実なお声にしっかりと応えられるよう、\n〇警察、自治体、民間支援団体など、どこに相談しても、必要な支援につながる「多機関ワンストップサービス体制」\n〇何度も同じ説明をしなくて済む「被害者手帳」の作成・交付による手続的・心情的なご負担の軽減\n〇「犯罪被害者等支援弁護士制度」による早い段階からの弁護士による支援\n〇犯罪被害者等給付金の迅速な給付などによる生活の再建を支える経済的支援\nなどの取組を進めています。\n\nお一人お一人の事情に応じて、被害を受けた時から再び平穏な生活を取り戻すまで、途切れることなく必要な支援をお届けするため、政府一丸となって取り組んでいきます。\n\n安心して助けを求められる社会をつくるためには、国民の皆様のご理解とご協力が不可欠です。\n\n「わたしにも　できる支援が　ここにある」\n\nこの標語のとおり、特別なことでなくても、それぞれのお立場でできる支援があります。\n\n「犯罪被害者月間」をきっかけに、誰もが安心して必要な支援を受けられる社会を、共につくってまいりましょう。\n\n※警察庁の「犯罪被害者月間」に関するＨＰ：\nhttps://t.co/mDpFFMgazR"}}},"rest_id":"2116696376780460430","unmention_data":{},"views":{"count":"900109","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116696376780460430","sortIndex":"2117211366325485434"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116677574051160191"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"tra