ed":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075364,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":611,"tweets":1924},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2116750004786491833"],"editable_until_msecs":"1793511103000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":124,"bookmarked":false,"conversation_id_str":"2116750004786491833","created_at":"Sun Nov 01 04:31:43 +0000 2026","display_text_range":[0,91],"entities":{},"favorite_count":6845,"favorited":false,"full_text":"11月は「オレンジリボン・児童虐待防止推進キャンペーン」の期間です。\n\n全国の児童相談所が対応した児童虐待の相談件数（約22万件（令和6年度））は、依然として高水準で推移しています。","id_str":"2116750004786491833","is_quote_status":false,"lang":"ja","quote_count":246,"reply_count":2165,"retweet_count":899,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kodomoshien.cfa.go.jp/no-gyakutai/","expanded_url":"https://kodomoshien.cfa.go.jp/no-gyakutai/","indices":[785,808],"url":"https://t.co/kjpIPYr3Kh"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTY3NTAwMDQ2NzMyOTg0MzM=","richtext":{"richtext_tags":[]},"text":"11月は「オレンジリボン・児童虐待防止推進キャンペーン」の期間です。\n\n全国の児童相談所が対応した児童虐待の相談件数（約22万件（令和6年度））は、依然として高水準で推移しています。\n\n子育ての悩みや困難を抱える親子を支援するため、児童相談所の体制強化や市区町村での「こども家庭センター」の設置を進めてきましたが、児童虐待を防止するためには、国民の皆さまのご協力も不可欠です。\n\nまず、育児や親子関係に悩みや困難を抱える方々へのお願いです。\n\n悩みを抱え込まず、遠慮なく相談してください。\n身近な市区町村の「こども家庭センター」では、妊娠・出産や育児、子育てに関する様々な相談や、必要な子育て支援サービスを利用するためのサポートなどを受けられます。\n児童相談所にもご相談できます。児童相談所相談専用ダイヤル「0120-189-783（いちやはくおなやみを）」をご活用ください。\nまた、匿名での相談が可能な「親子のための相談LINE」も活用できます。\n\n例えば、体罰は子供の成長・発達に悪影響を与えます。叩かれたり怒鳴られたりすると、子供が必要なときに親に相談をしづらくなったり、自分も同じように振舞ってもよいと思ったりする可能性があります。\n安心感や信頼感、温かな関係が心地よいのは、子供も大人も同じです。\n\nこれらの相談窓口では、より良い子育てのためのアドバイスや困りごとに対する支援を親身になって行います。\n\n次に、子育て家庭の周囲の皆様へのお願いです。\n\n子供を守るためには、周囲の人達が虐待にいち早く気づき、救いの手を差し伸べることが必要です。\n子供や保護者の様子に「何か変だ」と思ったら、児童相談所虐待対応ダイヤル「１８９」（いちはやく）にお電話いただければと思います。\n\n社会全体で子供の命を守り、子育てを支えていくため、皆様のご協力をお願い申し上げます。\nhttps://t.co/kjpIPYr3Kh\n（こども家庭庁　児童虐待防止のページ）"}}},"rest_id":"2116750004786491833","unmention_data":{},"views":{"count":"593764","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116750004786491833","sortIndex":"2117211366325485443"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_a