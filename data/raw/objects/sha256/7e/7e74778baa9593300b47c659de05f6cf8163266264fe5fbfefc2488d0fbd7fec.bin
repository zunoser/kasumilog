省とシーメンスエナジー社は、浮体式洋上風力等に関する協力覚書に署名しました。本合意に基づき、シーメンスエナジー社は風力発電サプライチェーンのレジリエンス強化を支援するため、アジア初となる戦略的なオペレーション&amp;メンテナンス拠点を北海道に設置することを発表しました。","id_str":"2116137061019525440","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":0,"retweet_count":7,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/10/…","expanded_url":"https://www.meti.go.jp/press/2026/10/20261029001.html","indices":[145,168],"url":"https://t.co/5kKZC5EB2T"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTYxMzcwNjA5MTA0MTk5Njg=","richtext":{"richtext_tags":[]},"text":"経済産業省とシーメンスエナジー社は、浮体式洋上風力等に関する協力覚書に署名しました。本合意に基づき、シーメンスエナジー社は風力発電サプライチェーンのレジリエンス強化を支援するため、アジア初となる戦略的なオペレーション&メンテナンス拠点を北海道に設置することを発表しました。\n👇詳細はこちら\nhttps://t.co/5kKZC5EB2T"}}},"rest_id":"2116137061019525440","unmention_data":{},"views":{"count":"11869","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116137061019525440","sortIndex":"2117211366325485404"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/lLSYSoa4SY"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_