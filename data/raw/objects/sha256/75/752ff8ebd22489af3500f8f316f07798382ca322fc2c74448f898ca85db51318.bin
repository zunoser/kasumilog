_at":"Wed Aug 19 07:26:27 +0000 2026","display_text_range":[0,148],"entities":{"media":[{"display_url":"pic.x.com/JlF2b8BiG7","expanded_url":"https://x.com/MofaJapan_en/status/2089977278310883538/photo/1","ext_alt_text":"The Sanctions against International Criminal Court (ICC) (Statement by Press Secretary KITAMURA Toshihiro)\n1. Japan notes that Judge AKANE Tomoko, President of the International Criminal Court (ICC), has been additionally designated for sanction measures by the United States.\n2. Japan has consistently supported the ICC, which is a permanent international criminal court, in its efforts to prosecute and punish the most serious crimes of concern to the international community and to uphold the rule of law. From this standpoint, the announced measures are very unfortunate.\n3. Japan will remain committed to strengthening the rule of law in the international community, while maintaining communication with related countries.","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2089977185088208896","indices":[149,172],"media_key":"3_2089977185088208896","media_results":{"result":{"media_key":"3_2089977185088208896"}},"media_url_https":"https://pbs.twimg.com/media/HQEXLTnagAAJTo9.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":455},{"h":1039,"w":1039,"x":0,"y":227},{"h":1184,"w":1039,"x":0,"y":115},{"h":1299,"w":650,"x":0,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/JlF2b8BiG7"}],"urls":[{"display_url":"mofa.go.jp/press/statemen…","expanded_url":"https://www.mofa.go.jp/press/statement/pageite_000001_00009.html","indices":[125,148],"url":"https://t.co/AFZcUw5QWK"}]},"extended_entities":{"media":[{"display_