ts":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2969756,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":514,"tweets":1707},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2090024655193268672"],"editable_until_msecs":"1787139283000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":110,"bookmarked":false,"conversation_id_str":"2090024655193268672","created_at":"Wed Aug 19 10:34:43 +0000 2026","display_text_range":[0,115],"entities":{"user_mentions":[{"id_str":"68034431","indices":[44,54],"name":"Recep Tayyip Erdoğan","screen_name":"RTErdogan"}]},"favorite_count":12097,"favorited":false,"full_text":"本日、17時30分から、中東地域において重要な役割を果たしているトルコのエルドアン大統領@RTErdoganとの間で電話会談を行いました。\n\n私からは、まず、エルドアン大統領からの熊本地震に対するお見舞いに、お礼を申し上げました。","id_str":"2090024655193268672","is_quote_status":false,"lang":"ja","quote_count":161,"reply_count":1071,"retweet_count":1141,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"68034431","indices":[44,54],"name":"Recep Tayyip Erdoğan","screen_name":"RTErdogan"}]},"id":"Tm90ZVR3ZWV0OjIwOTAwMjQ2NTUwOTI2ODI3NTI=","richtext":{"richtext_tags":[]},"text":"本日、17時30分から、中東地域において重要な役割を果たしているトルコのエルドアン大統領@RTErdoganとの間で電話会談を行いました。\n\n私からは、まず、エルドアン大統領からの熊本地震に対するお見舞いに、お礼を申し上げました。\n\nその上で、日本・トルコ間の「戦略的パートナーシップ」の強化に向け、本年秋の「トルコ・日本科学技術大学」の開学を含め、教育、安全保障、経済等の協力を発展させていきたい旨述べました。\n\nイラン情勢に関しては、私から、仲介の役割を果たしてきたトルコの尽力を高く評価しており、日本としてもトルコを始めとする国際社会と緊密に連携し、できる限りの外交努力を粘り強く行っていく旨述べました。\n\nまた、ホルムズ海峡におけるいかなる追加的費用もない形での自由で安全な航行が確保されることが重要である旨強調しました。\n\nエルドアン大統領からは、ホルムズ海峡に関する見解は全く一致しているという話がありました。\n\nまた、経済・安全保障を含め両国の協力関係を幅広い分野で一層推進していきたいとの発言がありました。\n\n本日の意見交換も踏まえ、二国間関係のみならず、地域及び国際情勢についても、トルコと緊密に連携してまいります。"}}},"rest_id":"2090024655193268672","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"476095","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090024655193268672","sortIndex":"2090192533404516337"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{