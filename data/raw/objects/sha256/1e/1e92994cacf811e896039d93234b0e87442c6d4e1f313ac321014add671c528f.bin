,"favorite_count":160,"favorited":false,"full_text":"茂木外務大臣は、国連本部において、サキアシ・ンディトカ・フィジー外務・対外貿易大臣と会談を行いました。茂木大臣は、太平洋島嶼国地域で重要な役割を果たしているフィジーとの間で、2027年夏に横浜で開催予定の第11回太平洋・島サミットに向けた協力を確認しました。\n\nhttps://t.co/l3EW631OSq https://t.co/iq9DeLjPU4","id_str":"2102912701135823297","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":33,"retweeted":false,"user_id_str":"303730149"},"rest_id":"2102912701135823297","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"20853","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102912701135823297","sortIndex":"2103062380312264625"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2102212943379091880"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省