e,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6ku2s"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":296870,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4954,"tweets":12945},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6ku2s"}}}},"edit_control":{"edit_tweet_ids":["2100866163643183139"],"editable_until_msecs":"1789724100000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":16,"bookmarked":false,"conversation_id_str":"2100866163643183139","created_at":"Fri Sep 18 08:35:00 +0000 2026","display_text_range":[0,142],"entities":{"media":[{"display_url":"pic.x.com/tIQCcGB7Lh","expanded_url":"https://x.com/gov_online/status/2100866163643183139/photo/1","ext_alt_text":"上部に「クマに出会わないための3つの対策。」と記載されており、その下に、クマの生息域と人の生活圏の境界を示し、クマに出会わないための対策や、クマと人のすみ分けの重要性を表したイラストが描かれている。その下には、次のように記載されている。「1。クマを寄せ付けない。・収穫しない果実や生ゴミなど、クマを引き寄せるものは取り除く。・クマが身を隠しやすい草や木を刈る。・畑や果樹園に近づけないために電気柵の設置も有効。2。人の存在を知らせる。・音が出るものを持ち歩いたり、複数人で会話をしながら歩いたりする。3。クマの出没情報を調べる。・外出前に、移動経路や目的地周辺の出没情報を確認する。・出没情報がある場合は、不要不急の外出を控える。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100864824490233856","indices":[143,166],"media_key":"3_2100864824490233856","media_results":{"result":{"media_key":"3_2100864824490233856"}},"media_url_https":"https://pbs.twimg.com/media/HSfFbVDakAA2vak.jpg","original_info":{"focus_rects":[{"h":526,"w":940,"x":0,"y":708},{"h":940,"w":940,"x":0,"y":314},{"h":1072,"w":940,"x":0,"y":182},{"h":1254,"w":627,"x":0,"y":0},{"h":1254,"w":940,"x":0,"y":0}],"height":1254,"width":940},"sizes":{"large":{"h":1254,"resize":"fit","w":940},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/tIQCcGB7Lh"}],"urls":[{"display_url":"gov-online.go.jp/article/202609…","expanded_url":"https://www.gov-online.go.jp/article/202609/entry-11625.html","indices":[107,130],"url":"https://t.co/2rznRPuqKn"}],"user_mentions":[{"id_str":"286056244","indices":[131,142],"name":"環境省","screen_name":"Kankyo_Jpn"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/tIQCcGB7Lh","expanded_url":"https://x.com/gov_online/status/2100866163643183139/photo/1","ext_alt_text":"上部に「クマに出会わないための3つの対策。」と記載されており、その下に、クマの生息域と人の生活圏の境界を示し、クマに出会わないための対策や、クマと人のすみ分けの重要性を表したイラストが描かれている。その下には、次のように記載されている。「1。クマを寄せ付けない。・収穫しない果実や生ゴミなど、クマを引き寄せるものは取り除く。・クマが身を隠しやすい草や木を刈る。・畑や果樹園に近づけないために電気柵の設置も有効。2。人の存在を知らせる。・音が出るものを持ち歩いたり、複数人で会話をしながら歩いたりする。3。クマの出没情報を調べる。・外出前に、移動経路や目的地周辺の出没情報を確認する。・出没情報がある場合は、不要不急の外出を控える。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100864824490233856","indices":[143,166],"media_key":"3_2100864824490233856"