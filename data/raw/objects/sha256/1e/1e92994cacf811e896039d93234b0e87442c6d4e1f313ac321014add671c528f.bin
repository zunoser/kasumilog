url_https":"https://pbs.twimg.com/media/HS9UX8zaIAAHNEt.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":2},{"h":540,"w":540,"x":330,"y":0},{"h":540,"w":474,"x":363,"y":0},{"h":540,"w":270,"x":465,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/kbidEk15ig"}]},"favorite_count":1555,"favorited":false,"full_text":"9月23日、インドネシアにおける国際緊急援助活動のため派遣されている輸送艦「くにさき」に搭載された陸自CH-47輸送ヘリコプター１機が、カリマンタン島クタパン周辺において消火活動を開始しました。 https://t.co/kbidEk15ig","id_str":"2102992355456639424","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":9,"retweet_count":257,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDI5OTIzNTU0MTA1MTM5MjA=","text":"9月23日、インドネシアにおける国際緊急援助活動のため派遣されている輸送艦「くにさき」に搭載された陸自CH-47輸送ヘリコプター１機が、カリマンタン島クタパン周辺において消火活動を開始しました。\n\nこれは同月21日、輸送艦「くにさき」がクタパン沖に到着し、活動に必要な準備を完了するとともに、気象条件が整ったことを受けて実施したものです。\n \n防衛省・自衛隊は、引き続き現地の状況を踏まえながら、関係機関と連携して対応してまいります。"}}},"rest_id":"2102992355456639424","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"52587","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102992355456639424","sortIndex":"2103062380312264666"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","casht