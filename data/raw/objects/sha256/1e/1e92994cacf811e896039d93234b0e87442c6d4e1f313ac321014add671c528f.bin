RPaZ9\n\n#MLIT建設産業PR"}}},"rest_id":"2102956195111633382","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"6147","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102956195111633382","sortIndex":"2103062380312264649"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":53},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1103507033079242752/zm3-5c2b_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1178494159/1570511962"},"core":{"created_at":"Thu Feb 14 10:16:42 +0000 2013","name":"法務省","screen_name":"MOJ_HOUMU"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTc4NDk0MTU5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関1-1-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"法務省の公式アカウントです。法務省ホームページに掲載する情報を中心に，法務省からお知らせしたい情報を発信します。\n運用方針はこちらです。→https://t.co/xUDg7yFxpk","entities":{"description":{"urls":[{"display_url":"moj.go.jp/hisho/kouhou/h…","expanded_url":"https://www.moj.go.jp/hisho/kouhou/hisho06_00190.html","indices":[69,92],"url":"https://t.co/xUDg7yFxpk"}]},"url":{"urls":[{"display_url":"moj.go.jp","expanded_url":"https://www.moj.go.jp/","indices":[0,23],"url":"https://t.co/TXATknTGxK"}]}}},"profile_description_language":"ja","profil