"urls":[{"display_url":"maff.go.jp","expanded_url":"https://www.maff.go.jp/","indices":[0,23],"url":"https://t.co/cPtrdtbo0N"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":269304,"following":57},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2335919749","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8276,"tweets":17733},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/cPtrdtbo0N"}}}},"edit_control":{"edit_tweet_ids":["2103001487471476909"],"editable_until_msecs":"1790233201000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"data":{"associated_data":{},"destination_language":"ja","entities":{"hashtags":[],"symbols":[],"urls":[],"user_mentions":[]},"preview_translation":"【ご注意ください！】\n\n肉あん月餅などの肉類製品を日本に持ち込むことは違法行為です！\n家畜伝染病の侵入を防ぐため、日本は海外からのほとんどの肉類製品および動物由来製品の持ち込みを禁止しています。\n\n・このような物品を日本に持ち込まないでください","source_language":"zh","translation":"【ご注意ください！】\n\n肉あん月餅などの肉類製品を日本に持ち込むことは違法行為です！\n家畜伝染病の侵入を防ぐため、日本は海外からのほとんどの肉類製品および動物由来製品の持ち込みを禁止しています。\n\n・このような物品を日本に持ち込まないでください\n・ネットショッピングなどの方法でこのような物品を日本に輸入しないでください\n・国際郵便などの方法でこのような物品を日本に送付しないでください"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2103001480936694248","created_at":"Thu Sep 24 06:00:01 +0000 2026","display_text_range":[0,125],"entities":{},"favorite_count":47,"favorited":false,"full_text":"【请注意！】\n\n将肉馅月饼等肉类制品带入日本属于违法行为！\n为防止家畜传染病传入，日本禁止从海外携带绝大多数肉类制品及动物源性产品入境。\n\n・请勿将此类物品带入日本\n・请勿通过网购等方式将此类物品进口至日本\n・请勿通过国际邮寄等方式将此类物品寄往日本","id_str":"2103001487471476909","in_reply_to_screen_name":"MAFF_JAPAN","