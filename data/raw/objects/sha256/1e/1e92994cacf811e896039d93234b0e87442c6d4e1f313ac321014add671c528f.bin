的肉類製品及動物源性產品均禁止攜帶進入日本。\n\n・請勿攜帶進入日本\n・請勿透過網路購物等方式將其進口至日本\n・請勿透過國際郵件等方式寄送至日本","id_str":"2103001490407436350","in_reply_to_screen_name":"MAFF_JAPAN","in_reply_to_status_id_str":"2103001487471476909","in_reply_to_user_id_str":"2335919749","is_quote_status":false,"lang":"zh","quote_count":1,"reply_count":0,"retweet_count":25,"retweeted":false,"user_id_str":"2335919749"},"rest_id":"2103001490407436350","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3636","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2103001480936694248","2103001487471476909","2103001490407436350"],"enableDeduplication":true}}},"entryId":"list-conversation-2103062380312264738","sortIndex":"2103062380312264670"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2100823875403874738"]},"possibly_sensitive":false,"privacy