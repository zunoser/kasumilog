XLbwAAZdop.jpg","original_info":{"focus_rects":[{"h":494,"w":883,"x":0,"y":84},{"h":611,"w":611,"x":136,"y":0},{"h":611,"w":536,"x":173,"y":0},{"h":611,"w":306,"x":288,"y":0},{"h":611,"w":883,"x":0,"y":0}],"height":611,"width":883},"sizes":{"large":{"h":611,"resize":"fit","w":883},"medium":{"h":611,"resize":"fit","w":883},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0wmGot6aKo"}]},"favorite_count":466,"favorited":false,"full_text":"令和８年９月２３日、ロシア海軍スラバ級ミサイル巡洋艦及びマルシャル・ネデリン級ミサイル観測支援艦の計２隻が、宗谷海峡を東進したことを確認しました。\n防衛省・自衛隊は、海上自衛隊の第５哨戒防備隊所属「くまたか」（余市）により、警戒監視・情報収集を行いました。 https://t.co/0wmGot6aKo","id_str":"2103032362686890119","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"quoted_status_id_str":"2103031692948820211","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2103031692948820211","url":"https://t.co/CSdsZR9zzK"},"reply_count":5,"retweet_count":118,"retweeted":false,"user_id_str":"268732024"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360668,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6342,"tweets":12387},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2103031692948820211"],"editable_until_msecs":"1790240402000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2103031692948820211","created_at":"Thu Sep 24 08:00:02 +0000 2026","display_text_range":[0,128],"entities":{"media":[{"display_url":"pic.x.com/rHWlXTJCc3","expanded_url":"https://x.com/jointstaffpa/status/2103031692948820211/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103030481549934592","indices":[129,152],"media_key":"3_2103030481549934592","media_results":{"result":{"media_key":"3_2103030481549934592"}},"media_url_https":"https://pbs.twimg.com/media/HS93FKSaQAAcj_e.jpg","original_info":{"focus_rects":[{"h":595,"w":1062,"x":0,"y":178},{"h":773,"w":773,"x":