471}]}},"id_str":"2122949581625556992","indices":[157,180],"media_key":"3_2122949581625556992","media_results":{"result":{"media_key":"3_2122949581625556992"}},"media_url_https":"https://pbs.twimg.com/media/HXY7ZYjbAAAmHX2.png","original_info":{"focus_rects":[{"h":869,"w":1552,"x":0,"y":53},{"h":1552,"w":1552,"x":0,"y":0},{"h":1769,"w":1552,"x":0,"y":0},{"h":1774,"w":887,"x":576,"y":0},{"h":1774,"w":1552,"x":0,"y":0}],"height":1774,"width":1552},"sizes":{"large":{"h":1774,"resize":"fit","w":1552},"medium":{"h":1200,"resize":"fit","w":1050},"small":{"h":680,"resize":"fit","w":595},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/e8P6vajR7v"}]},"favorite_count":17,"favorited":false,"full_text":"【フリーランス法説明会in新潟】\nフリーランスやフリーランスと取引する事業者の方必見！\n90分でフリーランス法の概要と事例が網羅できる機会です。\n報酬額の据え置きが買いたたきに該当する事例も紹介。\n取引の問題や不安をフリーランス法で解決しませんか？\n詳細・申込み↓\nhttps://t.co/cX34OFQcpu https://t.co/e8P6vajR7v","id_str":"2122949647694233832","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"quoted_status_id_str":"2113124397393608905","quoted_status_permalink":{"display":"x.com/jftc/status/21…","expanded":"https://twitter.com/jftc/status/2113124397393608905","url":"https://t.co/YlQl538CcL"},"reply_count":0,"retweet_count":7,"retweeted":false,"user_id_str":"2455900080"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":9},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"公正取引委員会の公式アカウントです。 \n公正かつ自由な競争について理解を深めていただくため、措置命令等の報道発表、関係法令（独占禁止法、取適法、フリーランス法、スマホ法等）の解説、イベント・採用情報等をお届けします。 \n#独占禁止法 #取適法 #スマホ法 #フリーランス法","entities":{"description":{},"url":{"urls":[{"display_url":"jftc.go.jp/index.html","expanded_url":"http://www.jftc.go.jp/index.html","indices":[0,23],"url":"https://t.co/izoLg0k5lW"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":100553,"following":36},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2455900080","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4179,"tweets":6493},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/izoLg0k5lW"}}}},"edit_control":{"edit_tweet_ids":["2113124397393608905"],"editable_until_msecs":"1792646690000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2113124397393608905","created_at":"Thu Oct 22 04:24:50 +0000 2026","display_text_range":[0,161],"entities":{"media":[{"display_url":"pic.x.com/kLGf1GIQV4","expanded_url":"https://x.com/jftc/status/2113124397393608905/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":86,"w":86,"x":114,"y":190}]},"medium":{"faces":[{"h":86,"w":86,"x":114,"y":190}]},"orig":{"faces":[{"h":86,"w":86,"x":114,"y":190}]},"small":{"faces":[{"h":61,"w":61,"x"