count":878,"retweet_count":1859,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjMwNjgxNDY3NTYyMjI5NzY=","richtext":{"richtext_tags":[]},"text":"本日はフィリピン・マニラでの外交日程の締めくくりに、英雄墓地を訪問し、無名戦士の墓への献花をいたしました。\n\nASEAN関連首脳会議の開催に御尽力いただき、温かいおもてなしをいただいたフィリピンの皆様に、深く感謝申し上げます。\n\n続いて、明日のAPEC首脳会議に参加するため、午後に中国・深圳に到着しました。\n\n今夜は中国の習近平国家主席御夫妻が主催する歓迎晩餐会に御招待いただき、各エコノミーの首脳の皆様とお話しする機会に恵まれました。\n\n明日の会議では、貿易・投資、地域経済統合、経済・エネルギー強靱化、デジタル経済・AIといった地域の経済的諸課題について議論し、日本の立場を力強く発信してまいります。"}}},"rest_id":"2123068146815021320","unmention_data":{},"views":{"count":"683534","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123068146815021320","sortIndex":"2123402108202909580"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"pr