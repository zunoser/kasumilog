":"https://t.co/RoE6Ad2HGw"}]},"favorite_count":57,"favorited":false,"full_text":"＼「明日への声 Vol.112」を発行しました／\n\n本号では、視覚に障害のあるかたなどに向けて、次のテーマを音声で分かりやすくお伝えしています。\n\n1⃣上手に医療機関にかかる方法\n2⃣犯罪被害者を支えるには\n3⃣児童虐待からこどもたちを守るために\n4⃣著作権者が分からないときの解決策 https://t.co/RoE6Ad2HGw","id_str":"2122963026244411645","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":15,"retweet_count":19,"retweeted":false,"user_id_str":"461064204"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"gov-online.go.jp/media/cd/20261…","expanded_url":"https://www.gov-online.go.jp/media/cd/202611/","indices":[213,236],"url":"https://t.co/MoPfUuD8Ro"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI5NjMwMjYxMzU0NDE0MDg=","text":"＼「明日への声 Vol.112」を発行しました／\n\n本号では、視覚に障害のあるかたなどに向けて、次のテーマを音声で分かりやすくお伝えしています。\n\n1⃣上手に医療機関にかかる方法\n2⃣犯罪被害者を支えるには\n3⃣児童虐待からこどもたちを守るために\n4⃣著作権者が分からないときの解決策\n\n政府広報オンラインや政府広報オンラインポッドキャストで聞くことができるほか、全国の公立図書館や地方公共団体などにもCDを配布しています。\nhttps://t.co/MoPfUuD8Ro"}}},"rest_id":"2122963026244411645","unmention_data":{},"views":{"count":"15500","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122963026244411645","sortIndex":"2123402108202909545"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/153059826