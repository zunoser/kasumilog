912768"}},"media_url_https":"https://pbs.twimg.com/media/HXZHqcab0AAY8lj.jpg","original_info":{"focus_rects":[{"h":1389,"w":2481,"x":0,"y":95},{"h":2481,"w":2481,"x":0,"y":0},{"h":2828,"w":2481,"x":0,"y":0},{"h":3508,"w":1754,"x":727,"y":0},{"h":3508,"w":2481,"x":0,"y":0}],"height":3508,"width":2481},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/88gfIPDURV"},{"display_url":"pic.x.com/88gfIPDURV","expanded_url":"https://x.com/caa_shohishacho/status/2122963618883100915/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2122962915519279104","indices":[125,148],"media_key":"3_2122962915519279104","media_results":{"result":{"media_key":"3_2122962915519279104"}},"media_url_https":"https://pbs.twimg.com/media/HXZHhhLasAADSOu.jpg","original_info":{"focus_rects":[{"h":1389,"w":2481,"x":0,"y":972},{"h":2481,"w":2481,"x":0,"y":426},{"h":2828,"w":2481,"x":0,"y":252},{"h":3508,"w":1754,"x":727,"y":0},{"h":3508,"w":2481,"x":0,"y":0}],"height":3508,"width":2481},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/88gfIPDURV"},{"display_url":"pic.x.com/88gfIPDURV","expanded_url":"https://x.com/caa_shohishacho/status/2122963618883100915/photo/3","ext_alt_text":"転倒などにより、衣服や腕がベルト巻き込み部に近づくと、機械に巻き込まれ、直ちに救助が困難な状態となります。死亡事故も発生しており大変危険です。利用者・保護者の皆様へ機械に巻き込まれないために、立った姿勢で利用してください。マフラー、服から伸びているひもなどは巻き込まれやすく危険です。保護者の皆様も、子どもが巻き込まれないよう、服装や姿勢に注意してください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2122963128585797632","indices":[125,148],"media_key":"3_2122963128585797632","media_results":{"result":{"media_key":"3_2122963128585797632"}},"media_url_https":"https://pbs.twimg.com/media/HXZHt66bwAAxvZ4.jpg","original_info":{"focus_rects":[{"h":1389,"w":2481,"x":0,"y":0},{"h":2481,"w":2481,"x":0,"y":0},{"h":2828,"w":2481,"x":0,"y":0},{"h":3508,"w":1754,"x":87,"y":0},{"h":3508,"w":2481,"x":0,"y":0}],"height":3508,"width":2481},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/88gfIPDURV"}],"urls":[{"display_url":"caa.go.jp/policies/counc…","expanded_url":"https://www.caa.go.jp/policies/council/csic/activity_report/2026/#m23","indices":[89,112],"url":"https://t.co/Fq7FwjOXMA"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/88gfIPDURV","expanded_url":"https://x.com/caa_shohishacho/status/2122963618883100915/photo/1","ext_alt_text":"スキー場に設置された「スノーエスカレーター」などと呼ばれるベルトコンベア式の移動設備で、子どもの死亡事故が発生しています。この設備は、スキー場の初心者・子どもエリア、駐車場とゲレンデとの間などに設置され、ベルトの上に立って雪上を移動する際に利用されています。ベルトが降り口で機械内部に引き込まれる構造です。事故は、降り口で衣服や腕が巻き込まれる形で発生しました。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2122963068858912768","indices":[125,148],"media_key":"3_2122963068858912768","media_results":{"result":{"media_key":"3_2122963068858912768"}},"media_url_https":"https://pbs.twimg.com/media/HXZHqcab0AAY8lj.jpg","original_info":{"focus_rects":[{"h":1389,"w":2481,"x":0,"y":95},{"h":2481,"w":2481,"x":0,"y":0},{"h":2828,"w":2481,"x":0,"y":0},{"h":3508,"w":1754,"x":727,"y":0},{"h":3508,"w":2481,"x":0,"y":0}],"height":3508,"width":2481},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/88gfIPDURV"},{"display_url":"pic.x.com/88gfIPDURV","ex