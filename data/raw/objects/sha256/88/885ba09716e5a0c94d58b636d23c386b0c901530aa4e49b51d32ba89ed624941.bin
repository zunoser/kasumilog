"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/5owl2z4Bkb","video_info":{"aspect_ratio":[16,9],"duration_millis":772333,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122947320786604032/pl/R_1FinThvoL1pRKz.m3u8?tag=29"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122947320786604032/vid/avc1/480x270/xwKqua0XysBjtyZQ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122947320786604032/vid/avc1/640x360/nyQbUQaXgxWjA7Rn.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122947320786604032/vid/avc1/1280x720/IhiwfkJiWcGz5utU.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/5owl2z4Bkb","expanded_url":"https://x.com/kantei/status/2122949020448698552/video/1","ext_media_availability":{"status":"Available"},"id_str":"2122947320786604032","indices":[70,93],"media_key":"13_2122947320786604032","media_results":{"result":{"media_key":"13_2122947320786604032"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2122947320786604032/img/LSnPdgfQ6agWrqUY.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/5owl2z4Bkb","video_info":{"aspect_ratio":[16,9],"duration_millis":772333,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122947320786604032/pl/R_1FinThvoL1pRKz.m3u8?tag=29"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122947320786604032/vid/avc1/480x270/xwKqua0XysBjtyZQ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122947320786604032/vid/avc1/640x360/nyQbUQaXgxWjA7Rn.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122947320786604032/vid/avc1/1280x720/IhiwfkJiWcGz5utU.mp4?tag=29"}]}}]},"favorite_count":3574,"favorited":false,"full_text":"【お知らせ】\n１１月１７日（現地時間）、高市総理は、日米豪印首脳会合に出席しました。\n\n※冒頭発言要旨（速報版、仮訳）\n（トランプ大統領） https://t.co/5owl2z4Bkb","id_str":"2122949020448698552","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":26,"reply_count":96,"retweet_count":504,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI5NDkwMjAyNzI0NjM4NzI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n１１月１７日（現地時間）、高市総理は、日米豪印首脳会合に出席しました。\n\n※冒頭発言要旨（速報版、仮訳）\n（トランプ大統領）\n　友人であるモディ・インド首相、高市総理、アルバニージー・オーストラリア首相、そしてこの会議場やその周辺に集っているリーダーの方々とお会いできて大変光栄です。日米豪印首脳会合は非常に重要で、特別なものであり、関与できて光栄に思います。\n　２０１７年に私が最初に大統領に就任した際、私は、米国、オーストラリア、インド、日本による日米豪印を復活させ、ここマニラでのＡＳＥＡＮ関連首脳会議の際にそれを発表しました。あの年が全ての始まりでした。それ以来、日米豪印が復活し、私達の協力は更に強化されるとともに、我々の友好も深まっています。我々４か国は、世界全体で最も重要なパートナーシップを構成し、最も成功した国々の一つであり、ある意味では最も強力な国々でもあります。我々４か国は、自由で開かれ、安定し、繁栄したインド太平洋の四隅です。私達は地域の安全保障、経済安全保障、そして外交分野で素晴らしい関係を築き、緊密に連携し、頻繁に連絡を取り合っています。ここにおられる３人のリーダーとは、何か問題や困難なことがあった時にはよく話し合っています。私に話したいことがあるときにはいつでも電話してください、大統領執務室のドアは、いつでも皆さんに開かれています。よく御承知のとおり、私達は東南アジアの多くの友人やパートナーとも強い関係を築いています。素晴らしい方々ばかりで、私達は彼らのことをよく知っています。\n　協力の一環として、米海軍は最近、日本近海で第３０回目となる共同訓練「マラバール２０２６」を実施しました。そこでは、対潜戦及び対水上戦の訓練を実施しました。今日、対潜訓練は極めて重要です。対水上戦は長年実施してきましたが、対潜戦の重要性はますます高まっています。これだけは言わせてください、我が国の潜水艦は非の打ち所がありません。私達は世界で最も優れた潜水艦を造っています。現在、オーストラリア等とも、その分野で協力を進めています。我が国の潜水艦は極めて先進的なのです。本日、私達は「力による平和」を守り続ける中で、哨戒機を活用した日米豪印の訓練を実施することも発表します。\n　また、私達はＡＩ（ＳＩ）を前進させるためにも協力しています。これは産業革命以来の経済成長をもたらす最大の機会です。もちろん、取扱いには慎重を期す必要がありますが、科学や医療の画期的な進歩という点において、既に驚くべき成果が出ており、誰もが信じられないほどの発見がなされています。私達は凄まじいスピードで科学や医療の進歩を実現しています。これまで４０年かけていたことを、今ではわずか５分で解決してしまうのです。私達は非常に注意深くありたい一方で、これを最大限に活かしていきたいと考えています。御存知のとおり、米国はこの分野の能力で大きくリードしています。日米豪印間での連携により、新たに「日米豪印ＡＩ（ＳＩ）アクセラレータ」を立ち上げました。さらに、インド太平洋地域における信頼できるＡＩ（ＳＩ）エコシステムへのアクセスを拡大するため、８，５００万米ドル以上を投入しようとしています。素晴らしい成果を上げています。この部屋に集まった国々は、ＡＩ（ＳＩ）を始め、あらゆる分野で世界最先端を走っています。誰かの助けを借りるような段階にはありませんが、一定の方針は必要であり、私達は互いに導き合っているのです。私達は、この重要な技術の未来が、私達の価値観や共通の利益を共有する国々によって主導されるようにしたいと考えています。これが可能な限り良い結果をもたらすようにしたいのです。考えてみてください、誰もが「これは産業革命よりも大きなものになる」と話しています。インターネットを超えるもの、産業革命を超えるものなどと、誰が聞いたことがあったでしょうか。多くの人々が、今やそれらよりもはるかに大きいものになるかもしれないと言っているのです。\n　この部屋にいるリーダーたちの努力のおかげで、私達は各国の商業と経済安全保障の絆を強化し続けてきました。いくつかの新しい日米豪印のイニシアティブを発表できることを嬉しく思います。来年、私達は初の「日米豪印ビジネス・リーダーズ・フォーラム」を開催し、経済協力を全く新たな高みへと引き上げます。日米豪印は非常に重要なグループになりつつあります。メディアからの前例のない注目度を見ても、それが分かります。また、サプライチェーンを確保し、我々のいずれの国も特定の供給者による威圧に対して脆弱とならないよう、重要鉱物に関する重要かつ新たな合意をいくつか結びました。これにより、私達の国は更に強くなり、同時に高い安全性が保証されることになります。私達は鉱物やレアアースなどの分野で非常に緊密に協力しています。\n　そして、これからの１２か月間で、人々を大いに驚かせるようなことが多く起こるでしょう。先ほど別室でも話していましたが、私達が取り組んでいることは非常に前例のないことです。我々は大きく出遅れていましたが、今では誰もが信じられないほどのペースで動き、大きく先行しています。\n　本日、この会議に参加してくださったリーダーの皆様に感謝いたします。素晴らしい議論ができることを楽しみにしています。私達は夜通し、多くのことについて話し合うことになるでしょう。それを楽しみにしています。それでは、モディ首相にマイクをお渡しします。彼は私の友人です。彼は世界中の皆から高く尊敬されている、本当に偉大な指導者です。ここにいる3人の指導者全員が、高く尊敬されている人々です。それでは、モディ首相、お願いします。ありがとうございます。\n\n（モディ首相）\n　トランプ大統領、高市総理、アルバニージー首相、こんにちは。友人の皆さんにお会いできて非常に嬉しく思います。\n　マニラと日米豪印は、長年にわたる特別な絆を有しています。２００７年、４か国の政府高官が初めて会合を行ったのがここでした。その１０年後、２０１７年、まさにこの都市において、対話を再始動させました。そして今日、再びこの歴史的な都市で日米豪印会合を開催できることは、非常に重要な契機です。\n　昨年１月以降、我々の外相は５回会合を行いました。これは、我々の政治的意思と、パートナーシップに対する共通のコミットメントの証左です。インドにとっては、日米豪印は、建設的かつ信頼できるパートナーシップです。海洋安全保障から信頼できるサプライチェーン、新興技術、そして災害対処に至るまで、我々は、日米豪印がインド太平洋全域において信頼できる解決を提供することに尽力してきました。\n　私は、各国のリーダーたちに対して、そのリーダーシップと、日米豪印に対する継続的な支援及び個人的な貢献に対して心から感謝を申し上げます。私は、本日の会合が、我々の協力の次の段階における具体的な目標を定めることに寄与すると確信しています。ありがとうございます。\n\n（高市総理）\n　このメンバーで初めてとなる日米豪印首脳会合を開催できて、とても嬉しく思います。トランプ大統領の尽力に感謝を致します。\n　日米豪印は、常に、この地域の平和と安定に貢献してきました。そして、これからも地域のパートナーと共に、インド太平洋の未来を作っていきます。海洋安全保障、経済安全保障、エネルギー、重要・新興技術を始めとした幅広い分野で、域内各国の「自律性」と「強靱性」を強化して、「自由で開かれたインド太平洋、ＦＯＩＰ」を実現していきたいと考えております。我々は地域が裨益する協力で結果を出していきます。\n　戦略的重要性を持つこの協力枠組みに、私達の手で更にモメンタムを与えましょう。\n　プレスが退出した後、もう一度発言の機会を頂けたら、更に詳しい話がございます。ありがとうございます。\n\n（アルバニージー首相）\n　大統領、そして首相各位、本日は本当にありがとうございます。こうして対面で日米豪印首脳会合に参加できることを、素晴らしく思います。\n　私は、首相に就任したまさに翌日に、日米豪印首脳会合に出席しました。そのため、この枠組みには個人的にも特別な愛着を抱いています。しかし、日米豪印が世界にとって重要である理由は、これら４か国が示すものが、単に個々を足し合わせたものを遥かに上回るからです。私達が、平和、安全、安定、そして繁栄という、インド太平洋における共通のビジョンのために共に取り組むとき、世界はより安全で、より安心できる場所になるでしょう。そして、その実現において、日米豪印は極めて重要な役割を担っています。\n　その大きな一環として、本日私達は、経済的未来についても議論を行います。これには、重要鉱物やレアアースの開発、ＡＩ革命とそれがもたらす成長と生産性の潜在力、更にはそれをどのように展開していくかといったテーマも含まれます。また、この地域における海洋安全保障も極めて重要です。私達は皆、ＡＳＥＡＮのパートナーであり、だからこそ、ここマニラの地で、このように会合を持つことは適切なことです。\n　私は、我々の閣僚たちが成し遂げてきた素晴らしい成果を更に発展させることを楽しみにしています。特に、モディ首相が指摘したように、外相たちはこれまで５回の会合を重ねて、真に実質的な成果を生み出してきました。\n　そして、本日の成果として、２０２７年に「日米豪印ビジネス・リーダーズ会合」が開催されることになります。これは、民間部門が主導して成長を促進すること、また我々政府首脳としての意思決定から来る決意を確かにするための実践的なイニシアティブです。市場経済を採用する国々として、私達はそのような成長を望んでいます。これは非常に前向きな取組であり、本日の会合から発表される数ある前向きな成果の、ほんの一例に過ぎません。ありがとうございます。"}}},"rest_id":"2122949020448698552","unmention_data":{},"views":{"count":"139611","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122949020448698552","sortIndex":"2123402108202909535"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2123402108202909672-tweet-2122947924200227057","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favori