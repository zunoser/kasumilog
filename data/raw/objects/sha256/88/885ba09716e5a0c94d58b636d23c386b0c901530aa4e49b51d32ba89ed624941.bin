！】\n取適法・フリーランス法の内容や、独禁法違反を防ぐためのコンプラ体制構築のポイントを学びませんか？\n11/26(木)、新潟市で「一日公正取引委員会」を開催します。\n参加申込は11/20(金)まで✨ぜひお申し込みください！\n🔽詳細・申込はこちら\nhttps://t.co/cX34OFQcpu https://t.co/kLGf1GIQV4","id_str":"2113124397393608905","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":8,"retweeted":false,"user_id_str":"2455900080"},"rest_id":"2113124397393608905","unmention_data":{},"views":{"count":"9270","state":"EnabledWithCount"}}},"rest_id":"2122949647694233832","unmention_data":{},"views":{"count":"2613","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122949647694233832","sortIndex":"2123402108202909536"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"158926999488