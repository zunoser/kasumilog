ly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":12,"reply_count":18,"retweet_count":458,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI5NTM3MDUwNTQxNjI5NDQ=","text":"１１月１８日、小泉防衛大臣 は、来日中のインドのシン国防大臣と、横須賀の海上自衛隊船越地区を訪問し、海自の護衛艦「なとり」（もがみ型ＦＦＭ）を視察しました。\n\n最新鋭の多機能護衛艦の装備や運用状況を確認し、今後の海洋安全保障協力を具体化する上で意義深い機会となるとともに、両大臣の信頼関係を更に深める機会となりました。\n\nインド太平洋地域の平和と安定、繁栄に向け、連携を一層強化していきます。🇯🇵🇮🇳"}}},"rest_id":"2122953705108779065","unmention_data":{},"views":{"count":"145603","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2123402108202909625-tweet-2123076840298614888","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJ