の体調を確認する。休憩·水分·塩分の補給は、一定時間毎にとる。休憩時は、日陰等の涼しい場所を確保する。暑い時間帯の作業は避ける。汗をかいた時は水分・塩分の補給をする。その横には、水分補給をする女性のイラストが描かれている。災害時には、慣れない環境や作業で熱中症のリスクが高くなります。熱中症には十分にご注意ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097134637026058240","indices":[147,170],"media_key":"3_2097134637026058240","media_results":{"result":{"media_key":"3_2097134637026058240"}},"media_url_https":"https://pbs.twimg.com/media/HRqE114bIAA4tLT.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":318},{"h":900,"w":900,"x":0,"y":120},{"h":1026,"w":900,"x":0,"y":57},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/wwQwDBqbDv"}],"user_mentions":[{"id_str":"286056244","indices":[135,146],"name":"環境省","screen_name":"Kankyo_Jpn"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/wwQwDBqbDv","expanded_url":"https://x.com/gov_online/status/2097135329929257015/photo/1","ext_alt_text":"上部に「災害時の熱中症にご注意ください。」と記載されており、その下には、次のように記載されている。片付け等の作業時の注意点。作業開始前には必ず体調を確認する。できるだけ2人以上で作業を行い、お互いの体調を確認する。休憩·水分·塩分の補給は、一定時間毎にとる。休憩時は、日陰等の涼しい場所を確保する。暑い時間帯の作業は避ける。汗をかいた時は水分・塩分の補給をする。その横には、水分補給をする女性のイラストが描かれている。災害時には、慣れない環境や作業で熱中症のリスクが高くなります。熱中症には十分にご注意ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097134637026058240","indices":[147,170],"media_key":"3_2097134637026058240","media_results":{"result":{"media_key":"3_2097134637026058240"}},"media_url_https":"https://pbs.twimg.com/media/HRqE114bIAA4tLT.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":318},{"h":900,"w":900,"x":0,"y":120},{"h":1026,"w":900,"x":0,"y":57},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/wwQwDBqbDv"}]},"favorite_count":28,"favorited":false,"full_text":"【災害時の熱中症予防】\n片付けなどの作業を行う際は、こまめな水分・塩分補給を心がけ、熱中症には十分ご注意ください。\nまた、休憩は涼しい場所でとりましょう。\n\n暑い時間帯の作業はできるだけ避け、体調が優れないときは、無理をせず、作業を行わないようにすることが大切です。\n\n@Kankyo_Jpn https://t.co/wwQwDBqbDv","id_str":"2097135329929257015","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":11,"retweeted":false,"user_id_str":"461064204"},"rest_id":"2097135329929257015","source":"<a href=\"https://twitter.com\" rel=\"nofollow\">TweetDeck Web App</a>","unmention_data":{},"views":{"count":"4272","state":"EnabledWithCount"}}}}},"entryId":"tweet-2097135329929257015","sortIndex":"2097182500219518945"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒10