sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2994921,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":530,"tweets":1767},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2096851118865461536"],"editable_until_msecs":"1788766839000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":55,"bookmarked":false,"conversation_id_str":"2096851118865461536","created_at":"Mon Sep 07 06:40:39 +0000 2026","display_text_range":[0,133],"entities":{},"favorite_count":9418,"favorited":false,"full_text":"東京都新島村、大島町に加え、東京都利島村にも「レベル５土砂災害特別警報」が発表されました。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。","id_str":"2096851118865461536","is_quote_status":true,"lang":"ja","quote_count":101,"quoted_status_id_str":"2096817824627147231","quoted_status_permalink":{"display":"x.com/takaichi_sanae…","expanded":"https://twitter.com/takaichi_sanae/status/2096817824627147231","url":"https://t.co/Lao0HZikQI"},"reply_count":820,"retweet_count":1076,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTY4NTExMTg4MTUxNjIzNjg=","richtext":{"richtext_tags":[]},"text":"東京都新島村、大島町に加え、東京都利島村にも「レベル５土砂災害特別警報」が発表されました。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。\n命の危険が迫っているため、地方自治体の指示に従い、直ちに身の安全を確保して下さい。\n\n今後、他の市町村にも、レベル５特別警報が発表される可能性があります。\n土砂災害、低い土地の浸水、河川の増水や氾濫などに厳重に警戒して下さい。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2994921,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":530,"tweets":1767},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2096817824627147231"],"editable_until_msecs":"1788758901000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":48,"bookmarked":false,"conversation_id_str":"2096817824627147231","created_at":"Mon Sep 07 04:28:21 +0000 2026","display_text_range":[0,128],"entities":{},"favorite_count":8705,"favorited":false,"full_text":"東京都新島村に加え、東京都大島町に「レベル５土砂災害特別警報」が発表されました。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。","id_str":"2096817824627147231","is_quote_status":false,"lang":"ja","quote_count":79,"reply_count":326,"retweet_count":917,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTY4MTc4MjQ1NzI1MDYxMTI=","richtext":{"richtext_tags":[]},"text":"東京都新島村に加え、東京都大島町に「レベル５土砂災害特別警報」が発表されました。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。\n命の危険が迫っているため、地方自治体の指示に従い、直ちに身の安全を確保して下さい。\n\n避難所までの移動がかえって危険な場合は、無理をせず、崖や沢から離れた場所など、今いる場所より少しでも安全な場所に移動するなど、命を守る行動を最優先して下さい。\n\n今後、他の市町村にも、レベル５特別警報が発表される可能性があります。\nまた、現在、レベル５特別警報が発表されていない地域でも、前線と台風から変わった熱帯低気圧の影響で、西日本から北日本の太平洋側の広い範囲で大雨になるおそれがあります。\n土砂災害、低い土地の浸水、河川の増水や氾濫などに厳重に警戒して下さい。\n\n政府としては、「レベル５土砂災害特別警報」の発表を受け、「官邸危機管理センター」に設置した「官邸連絡室」において、地方自治体とも連携し、国民の皆様に対する適時的確な情報提供、被害が発生した場合の被害状況の把握、人命第一の方針の災害応急対策など、危機管理に万全の対応をしてまいります。"}}},"rest_id":"2096817824627147231","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"712441","state":"EnabledWithCount"}}},"rest_id":"2096851118865461536","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"399845","state":"EnabledWithCount"}}}}},"entryId":