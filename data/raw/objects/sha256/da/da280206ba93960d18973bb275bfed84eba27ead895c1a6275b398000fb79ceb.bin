0},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2119618479368327570"],"editable_until_msecs":"1794195000000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":6,"bookmarked":false,"conversation_id_str":"2119618479368327570","created_at":"Mon Nov 09 02:30:00 +0000 2026","display_text_range":[0,136],"entities":{"media":[{"display_url":"pic.x.com/Si3yysUKjI","expanded_url":"https://x.com/gov_online/status/2119618479368327570/photo/1","ext_alt_text":"上部に「「もしも」の救急搬送時に役立つマイナ救急」と記載されており、その下には、次のように記載されている。「マイナ救急の流れ。119番通報時。指令員が通報者に対してマイナ保険証の準備を依頼。傷病者が情報閲覧に同意する。救急隊員がマイナ保険証を読み取り、医療情報などを閲覧する。円滑な搬送先医療機関の選定や処置に活用。※各消防本部によって、マイナ救急の流れは若干異なる場合があります。マイナ保険証を搭載したスマートフォンでも、マイナ救急を利用できます。※スマートフォンの場合は、本人による生体認証又は暗証番号の入力が必要です。意識不明などで操作できない場合に備え、カードのマイナ保険証も携帯しましょう。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":43,"w":43,"x":696,"y":502}]},"medium":{"faces":[{"h":43,"w":43,"x":696,"y":502}]},"orig":{"faces":[{"h":43,"w":43,"x":696,"y":502}]},"small":{"faces":[{"h":24,"w":24,"x":394,"y":284}]}},"id_str":"2118248767543824384","indices":[137,160],"media_key":"3_2118248767543824384","media_results":{"result":{"media_key":"3_2118248767543824384"}},"media_url_https":"https://pbs.twimg.com/media/HWWIB_db0AA7Bjf.jpg","original_info":{"focus_rects":[{"h":598,"w":1067,"x":0,"y":449},{"h":1067,"w":1067,"x":0,"y":133},{"h":1200,"w":1053,"x":0,"y":0},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":1067,"x":0,"y":0}],"height":1200,"width":1067},"sizes":{"large":{"h":1200,"resize":"fit","w":1067},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Si3yysUKjI"},{"display_url":"pic.x.com/Si3yysUKjI","expanded_url":"https://x.com/gov_online/status/2119618479368327570/photo/1","ext_alt_text":"上部に「マイナ救急を利用するためにマイナ保険証の登録をお早めに」と記載されており、その下には、次のように記載されている。「マイナ救急を利用するには、マイナンバーカードを所有し、かつマイナ保険証として健康保険証の利用登録が完了している必要があります。利用登録がまだのかたは、もしものときに備えて利用登録しておきましょう。マイナ救急を利用するために必要な準備として、「マイナンバーカードの取得」と「マイナ保険証の登録」と「外出時にはマイナンバーカードを持ち歩くこと」の3点を示すイラストが描かれている。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":48,"w":48,"x":154,"y":590},{"h":71,"w":71,"x":302,"y":663},{"h":101,"w":101,"x":118,"y":864}]},"medium":{"faces":[{"h":48,"w":48,"x":154,"y":590},{"h":71,"w":71,"x":302,"y":663},{"h":101,"w":101,"x":118,"y":864}]},"orig":{"faces":[{"h":48,"w":48,"x":154,"y":590},{"h":71,"w":71,"x":302,"y":663},{"h":101,"w":101,"x":118,"y":864}]},"small":{"faces":[{"h":27,"w":27,"x":87,"y":334},{"h":40,"w":40,"x":171,"y":375},{"h":57,"w":57,"x":66,"y":489}]}},"id_str":"2118248767623499776","indices":[137,160],"media_key":"3_2118248767623499776","media_results":{"result":{"media_key":"3_2118248767623499776"}},"media_url_https":"https://pbs.twimg.com/media/HWWIB_wbkAA2b9g.jpg","original_info":{"focus_rects":[{"h":598,"w":1067,"x":0,"y":0},{"h":1067,"w":1067,"x":0,"y":0},{"h":1200,"w":1053,"x":0,"y":0},{"h":1200,"w":600,"x":89,"y":0},{"h":1200,"w":1067,"x":0,"y":0}],"height":1200,"width":1067},"sizes":{"large":{"h":1200,"resize":"fit","w":1067},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Si3yysUKjI"}],"urls":[{"display_url":"gov-online.go.jp/article/202508…","expanded_url":"https://www.gov-online.go.jp/article/202508/entry-8648.html","indices":[101,124],"url":"https://t.co/vUMEZztH7b"}],"user_mentions":[{"id_str":"137272821","indices":[125,136],"name":"総務省消防庁","screen_name":"FDMA_JAPAN"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/Si3yysUKjI","expanded_url":"https://x.com/gov_online/status/2119618479368327570/