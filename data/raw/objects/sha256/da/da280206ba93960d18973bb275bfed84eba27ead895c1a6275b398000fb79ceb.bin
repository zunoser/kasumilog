e":"en","translation":"ポーランドのクラクフで発生した銃乱射事件により、多くの人々が殺害または負傷した事実に深い悲しみと憤りを感じています。犠牲者の方々に心からの哀悼の意を表し、ご家族の方々に同情の念をお伝えしたいと思います。また、負傷された方々の早期回復をお祈りします。日本はポーランドの人々と連帯します。"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":10,"bookmarked":false,"conversation_id_str":"2119468266217423104","created_at":"Sun Nov 08 16:33:07 +0000 2026","display_text_range":[0,275],"entities":{"media":[{"display_url":"pic.x.com/cPFNdSCQPG","expanded_url":"https://x.com/MofaJapan_en/status/2119468266217423104/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2119468260865564672","indices":[276,299],"media_key":"3_2119468260865564672","media_results":{"result":{"media_key":"3_2119468260865564672"}},"media_url_https":"https://pbs.twimg.com/media/HWndJ2GbYAAPWpZ.jpg","original_info":{"focus_rects":[{"h":368,"w":657,"x":272,"y":0},{"h":368,"w":368,"x":416,"y":0},{"h":368,"w":323,"x":439,"y":0},{"h":368,"w":184,"x":508,"y":0},{"h":368,"w":1200,"x":0,"y":0}],"height":368,"width":1200},"sizes":{"large":{"h":368,"resize":"fit","w":1200},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/cPFNdSCQPG"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/cPFNdSCQPG","expanded_url":"https://x.com/MofaJapan_en/status/2119468266217423104/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2119468260865564672","indices":[276,299],"media_key":"3_2119468260865564672","media_results":{"result":{"media_key":"3_2119468260865564672"}},"media_url_https":"https://pbs.twimg.com/media/HWndJ2GbYAAPWpZ.jpg","original_info":{"focus_rects":[{"h":368,"w":657,"x":272,"y":0},{"h":368,"w":368,"x":416,"y":0},{"h":368,"w":323,"x":439,"y":0},{"h":368,"w":184,"x":508,"y":0