166336"}},"media_url_https":"https://pbs.twimg.com/media/HWqgnhhbgAAzwMY.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":433,"y":0},{"h":1734,"w":1521,"x":540,"y":0},{"h":1734,"w":867,"x":867,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Ytht1ze7P2"}]},"favorite_count":2617,"favorited":false,"full_text":"本日、全国から1,010ものチームが参加した第４回「全国高校生政策甲子園」（日本青年会議所主催）において、最優秀チームに選出された「北海道当別高等学校」、「広島国泰寺高等学校」の皆様が、官邸にお越しになり、受賞した政策についてプレゼンテーションをして下さいました。 https://t.co/Ytht1ze7P2","id_str":"2119683210120671360","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":23,"reply_count":141,"retweet_count":279,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTk2ODMyMTAwNTc3NTI1NzY=","richtext":{"richtext_tags":[]},"text":"本日、全国から1,010ものチームが参加した第４回「全国高校生政策甲子園」（日本青年会議所主催）において、最優秀チームに選出された「北海道当別高等学校」、「広島国泰寺高等学校」の皆様が、官邸にお越しになり、受賞した政策についてプレゼンテーションをして下さいました。\n\n「北海道当別高等学校」のプレゼンテーションは、若者の早期離職の防止に向け、「探究活動」による「自信獲得プログラム」を提案する、全く新しい視点からの提案であり、実体験に基づく説得力がありました。\n\n「広島国泰寺高等学校」のプレゼンテーションは、「クマ対策センター」の設置、犬を使った追い払いにより、「人とクマの住み分け」を目指すという非常に意欲的なものでした。\n\n２つのチームによるプレゼンテーションは、メンバー同士の息もあった秀逸なもので、とても楽しいひと時でした。\n\n高校生の皆様には、これからの日本を牽引する世代として、是非、これからも「社会課題」に目を向け、その解決に向けて、挑戦されることを願っています。"}}},"rest_id":"2119683210120671360","unmention_data":{},"views":{"count":"90248","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119683210120671360","sortIndex":"2119701132015042551"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionTy