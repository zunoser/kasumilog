gible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":45,"bookmarked":false,"conversation_id_str":"2119346770870468982","created_at":"Sun Nov 08 08:30:20 +0000 2026","display_text_range":[0,109],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/32grbVBCzF","expanded_url":"https://x.com/kantei/status/2119346770870468982/video/1","ext_media_availability":{"status":"Available"},"id_str":"2119342844800581633","indices":[110,133],"media_key":"13_2119342844800581633","media_results":{"result":{"media_key":"13_2119342844800581633"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2119342844800581633/img/2sQNBJc9fpoCVG9z.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/32grbVBCzF","video_info":{"aspect_ratio":[16,9],"duration_millis":311733,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2119342844800581633/pl/Mxf9hM4CxwpeW8t8.m3u8?tag=29&v=284"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119342844800581633/vid/avc1/480x270/J5mod3JyHhpj8tbt.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119342844800581633/vid/avc1/640x360/_J7OH4BRhEQbh_k6.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119342844800581633/vid/avc1/1280x720/xwUD_msLtioqIAzG.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/32grbVBCzF","expanded_url":"https://x.com/kantei/status/2119346770870468982/video/1","ext_media_availability":{"status":"Available"},"id_str":"2119342844800581633","indices":[110,133],"media_key":"13_2119342844800581633","media_results":{"result":{"media_key":"13_2119342844800581633"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2119342844800581633/img/2sQNBJc9fpoCVG9z.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/32grbVBCzF","video_info":{"aspect_ratio":[16,9],"duration_millis":311733,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2119342844800581633/pl/Mxf9hM4CxwpeW8t8.m3u8?tag=29&v=284"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119342844800581633/vid/avc1/480x270/J5mod3JyHhpj8tbt.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119342844800581633/vid/avc1/640x360/_J7OH4BRhEQbh_k6.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119342844800581633/vid/avc1/1280x720/xwUD_msLtioqIAzG.mp4?tag=29"}]}}]},"favorite_count":3198,"favorited":false,"full_text":"【お知らせ】\n本日（１１月８日）、高市総理は、全拉致被害者の即時一括帰国を求める国民大集会に出席しました。\n\n※高市総理発言要旨（速報版）\n　皆様、こんにちは。\n　去る１０月２１日で高市内閣発足から１年が経過しました。 https://t.co/32grbVBCzF","id_str":"2119346770870468982","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":44,"reply_count":161,"retweet_count":557,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTkzNDY3NzA3NzQwNTI4NjQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月８日）、高市総理は、全拉致被害者の即時一括帰国を求める国民大集会に出席しました。\n\n※高市総理発言要旨（速報版）\n　皆様、こんにちは。\n　去る１０月２１日で高市内閣発足から１年が経過しました。\n　拉致被害者の皆様が北朝鮮で祖国を思い続ける中、また、ご家族から、帰国を待ちわびる切実な思い、痛切なお声をお伺いしながらも、ご帰国を果たせていないことを、大変心苦しく感じております。\n　私の代で何としても突破口を開き、拉致問題を解決するとの決意は変わりなく、ご家族の皆様が肉親を抱きしめるその日まで、私の使命は終わりません。\n　『日朝平壌宣言』に基づき、互いに実りある関係を作っていきたい。\n　そのために私は、対話をし、具体的に行動する用意があります。\n　日本国の総理大臣として、金正恩委員長と会って、率直に話し合いたい、これが私の偽らざる思いでございます。\n　日朝双方の未来のためにも、そして、地域の平和と安定のためにも、互いに建設的な努力をする必要がございます。\n　拉致被害者の皆様も、そのご家族の皆様も歳を重ねていかれ、その中でこの問題は、すぐにでも解決されなくてはなりません。\n　こうした強い決意の下、具体的な成果に結びつけるべく、現在も働きかけを続けております。\n　問題解決に向けたチャンスを生み出すべく、国際社会への働きかけにも力を尽くしている最中です。\n　９月の『国連総会一般討論演説』では、拉致問題を一刻も早く解決しなければならないことを訴えました。\n　この訪米時の首脳会談では、拉致問題の即時解決について、先ほど、古屋会長からお話がありましたように、会談も含めてですが、トランプ大統領から改めて全面的な支持をいただきました。\n　この他にも、二国間首脳会談の機会というのは本当にたくさんあります。先週も、でございますし、またこの週明けもそうでございます。そういったあらゆる機会に、私から各国首脳に対し、例外なく、拉致問題の即時解決に向けた協力をお願いし、それぞれの首脳から支持をいただいています。\n　この国際社会の力強い後押しというものも、問題解決に向けた力になると、私は確信をしております。\n　これからも全力で働きかけを行ってまいります。\n　そして、拉致問題の解決に向けては、国民の皆様お一人お一人が声を上げ続け、「全ての世代が一刻も早い解決を求めているんだ」ということを北朝鮮側に、そして国際社会にも示していくということが極めて重要であります。これは解決に向けた大きな力になります。\n　皆様のこれまでのご理解とお力添えに心から感謝を申し上げますとともに、一層のご支援をどうかどうかお願い申し上げます。\n　この場には、地方議員の先生方、また、地方自治体の皆様もおいでくださっています。\n　政府と軌を一にして、ご地元で様々な活動を展開していただいていることにも、大変心強く思い、感謝を申し上げております。\n　どうか、これからもご協力をお願い申し上げます。\n　本日改めてお聞かせいただいた皆様の声をしっかりと心に刻んで、高市内閣でなんとしても拉致問題を解決すべく、邁進してまいります。\n　政府一丸となっての取組をお誓い申し上げますとともに、再会の日まで、ご家族の皆様、関係者の皆様のご健勝をお祈り申し上げます。\n　本日はご一緒させていただいて誠にありがとうございます。\n　共に頑張ってまいりましょう。"}}},"rest_id":"2119346770870468982","unmention_data":{},"views":{"count":"93485","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119346770870468982","sortIndex":"2119701132015042482"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2119535278205636608/9OkdZyjy?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":200,"url":"https://pbs.twimg.com/card_img/2119535278205636608/9OkdZyjy?format=jpg&name=400x400","width":400},"type":"IMAGE"}},{"key":"description","value":{"string_value":"介護の仕事は、食事や入浴などの介助だけでなく、利用者とその家族が心身ともに満たされ、生きる希望を持ち続けられることを目的とした仕事です。本ポータルサイトでは、そんな介護の仕事の魅力ややりがいを広く発信していきます。","type":"STRING"}},{"key":"domain","value":{"string_value":"kaigonoshigoto.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":300,"url":"https://pbs.twimg.com/card_img/2119535278205636608/9OkdZyjy?format=jpg&name=600x600","width":600},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2119535278205636608/9OkdZyjy?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2119535278205636608/9OkdZyjy?format=jpg&name=orig","width":1260},"type":"IMAGE"}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2119535278205636608/9OkdZyjy?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"summary_photo_image_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2119535278205636608/9OkdZyjy?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":72,"url":"https://pbs.twimg.com/card_img/2119535278205636608/9OkdZyjy?format=jpg&name=144x144","width":144},"type":"IMAGE"}},{"key":"creator","value":{"type":"USER","user_value":{"id_str":"1846851409243000832","path":[]}}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":630,"url":"https://pbs.twimg.