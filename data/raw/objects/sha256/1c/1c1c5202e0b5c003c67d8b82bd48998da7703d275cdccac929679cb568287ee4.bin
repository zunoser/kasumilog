eo.twimg.com/amplify_video/2112521749933989888/vid/avc1/720x1280/Gmivzy8O-abQixq7.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112521749933989888/vid/avc1/1080x1920/bh7DKLnpZdKx9ZSm.mp4?tag=29"}]}}]},"favorite_count":480,"favorited":false,"full_text":"「国と地方の協議の場（令和8年度第2回）」を開催しました。\n高市内閣では、「責任ある積極財政」の大方針を掲げて、「強い経済」の実現に向けた政策を加速させ、「日本列島を強く、豊かに」してまいります。 https://t.co/mTiKB53AYc","id_str":"2112522208832901516","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":47,"retweet_count":74,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI1MjIyMDg3NzQwODI1NjA=","richtext":{"richtext_tags":[]},"text":"「国と地方の協議の場（令和8年度第2回）」を開催しました。\n高市内閣では、「責任ある積極財政」の大方針を掲げて、「強い経済」の実現に向けた政策を加速させ、「日本列島を強く、豊かに」してまいります。\n日本列島の隅々まで、「産業クラスターの花」を咲かせて、地域経済の成長につなげてまいります。\n諸般の取組について、国と地方がしっかり連携を進めていきたいと考えております。"}}},"rest_id":"2112522208832901516","unmention_data":{},"views":{"count":"27650","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112522208832901516","sortIndex":"2112591446602153983"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/146456