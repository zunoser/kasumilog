ettings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国立障害者リハビリテーションセンターから様々な情報を発信していきます\nなお、「リプライ」「ダイレクトメッセージ」などを通じたご意見には対応していませんのであらかじめご了承ください。","entities":{"description":{},"url":{"urls":[{"display_url":"rehab.go.jp","expanded_url":"http://www.rehab.go.jp/","indices":[0,23],"url":"https://t.co/RCyNQlNXuK"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":4432,"following":6},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"343847693","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":407,"tweets":1769},"verification":{"verified":false},"website":{"url":"https://t.co/RCyNQlNXuK"}}}},"edit_control":{"edit_tweet_ids":["2112395885581656240"],"editable_until_msecs":"1792473000000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2112395885581656240","created_at":"Tue Oct 20 04:10:00 +0000 2026","display_text_range":[0,150],"entities":{"hashtags":[{"indices":[138,142],"text":"国リハ"},{"indices":[143,150],"text":"国際セミナー"}],"media":[{"display_url":"pic.x.com/7CaoyEHLX2","expanded_url":"https://x.com/NRCD_/status/2112395885581656240/photo/1","ext_alt_text":"国際セミナー2026開催案内\nテーマ「障害者の健康公平性への取り組み」\n開催日：2026年 11月 21日（土）13:30-17:15 \n参加申し込み締め切り：11月16日（月）\n\n基調講演\n1.リフェラルを超えて ― 人々のケアの道をつなぐ「Network of Care」とリハビリテーション\n窪田　祥吾\n(サービス提供・品質（SDQ）担当コーディネーター　保健システム・サービス部門　世界保健機関（WHO）西太平洋地域事務局)\n\n2.リハビリテーションの実践におけるチームアプローチの概念\n芳賀 信彦\n(国立障害者リハビリテーションセンター　総長)\n\n発表\n・韓国における嚥下障害ケアのための多職種連携チームモデル\nパク・ジヌ\n(東国大学イルサン病院 リハビリテーション医学科教授)  \n\n・高齢社会における摂食嚥下障害への多職種連携　― リハビリテーション・栄養・口腔管理によるアプローチ\n 井口　はるひ\n (東京大学医学部附属病院リハビリテーション科講師、摂食嚥下センター 副センター長)\n\n・フィリピンにおける視覚障害者のための強固なリハビリテーションチームの構築－強固なアドボカシー（権利擁護）のネットワークを構築する－\nアン・ジェリン・デラ・クルス・マルフォリ\n (マニラ・ドクターズ病院 ロービジョンリハビリテーション部長、メディカルシティ・サウスルソン病院　治療委員会代表委員）\n\n・国立障害者リハビリテーションセンターにおける視覚障害者支援人材の育成 ― 多職種連携の現状と取り組み ―\n丸山　華子\n（国立障害者リハビリテーションセンター学院　視覚障害学科　主任教官）\n\n参加方法\n会場参加： 11月16日（月）迄に本チラシ（右下）のQRコードからアクセスする申込みフォームで申し込みの上、当日会場へお越しください。会場は第一ホテル両国　5階会場「北斎」です。\n\n録画視聴： 当日に会場参加できない方も後日に録画視聴していただけます。録画視聴のみを希望する場合も、 11月16日（月）迄に本チラシ（右下）のQRコードから申し込みください。開催後日、録画掲載ができ次第ご案内を差し上げます。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":52,"w":52,"x":281,"y":124}]},"medium":{"faces":[{"h":52,"w":52,"x":281,"y":124}]},"orig":{"faces":[{"h":52,"w":52,"x":281,"y":124}]},"small":{"faces":[{"h":34,"w":34,"x":183,"y":81}]}},"id_str":"2112317081769377792","indices":[151,174],"media_key":"3_2112317081769377792","media_results":{"result":{"media_key":"3_2112317081769377792"}},"media_url_https":"https://pbs.twimg.com/media/HVB1Mb_agAAqWW8.jpg","original_info":{"focus_rects":[{"h":403,"w":720,"x":0,"y":0},{"h":720,"w":720,"x":0,"y":0},{"h":821,"w":720,"x":0,"y":0},{"h":1040,"w":520,"x":77,"y":0},{"h":1040,"w":720,"x":0,"y":0}],"height":1040,"width":720},"sizes":{"large":{"h":1040,"resize":"fit","w":720},"medium":{"h":1040,"resize":"fit","w":720},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/7CaoyEHLX2"}],"urls":[{"display_url":"rehab.go.jp/whoclbc/semina…","expanded_url":"https://www.rehab.go.jp/whoclbc/seminar/","indices":[113,136],"url":"https://t.co/YzQzytWqUb"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/7CaoyEHLX2","expanded_url":"https://x.com/NRCD_/status/2112395885581656240/photo/1","ext_alt_text":"国際セミナー2026開催案内\nテーマ「障害者の健康公平性への取り組み」\n開催日：2026年 11月 21日（土）13:30-17:15 \n参加申し込み締め切り：11月16日（月）\n\n基調講演\n1.リフェラルを超えて ― 人々のケアの道をつなぐ「Network of Care」とリハビリテーション\n窪田　祥吾\n(サービス提供・品質（SDQ）担当コーディネーター　保健システム・サービス部門　世界保健機関（WHO）西太平洋地域事務局)\n\n2.リハビリテーションの実践におけるチームアプローチの概念\n芳賀 信彦\n(国立障害者リハビリテーションセンター　総長)\n\n発表\n・韓国における嚥下障害ケアのための多職種連携チームモデル\nパク・ジヌ\n(東国大学イルサン病院 リハビリテーション医学科教授)  \n\n・高齢社会における摂食嚥下障害への多職種連携　― リハビリテーション・栄養・口腔管理によるアプローチ\n 井口　はるひ\n (東京大学医学部附属病院リハビリテーション科講師、摂食嚥下センター 副センター長)\n\n・フィリピンにおける視覚障害者のための強固なリハビリテーションチームの構築－強固なアドボカシー（権利擁護）のネットワークを構築する－\nアン・ジェリン・デラ・クルス・マルフォリ\n (マニラ・ドクターズ病院 ロービジョンリハビリテーション部長、メディカルシティ・サウスルソン病院　治療委員会代表委員）\n\n・国立障害者リハビリテーションセンターにおける視覚障害者支援人材の育成 ― 多職種連携の現状と取り組み ―\n丸山　華子\n（国立障害者リハビリテーションセンター学院　視覚障害学科　主任教官）\n\n参加方法\n会場参加： 11月16日（月）迄に本チラシ（右下）のQRコードからアクセスする申込みフォームで申し込みの上、当日会場へお越しください。会場は第一ホテル両国　5階会場「北斎」です。\n\n録画視聴： 当日に会場参加できない方も後日に録画視聴していただけます。録画視聴のみを希望する場合も、 11月16日（月）迄に本チラシ（右下）のQRコードから申し込みください。開催後日、録画掲載ができ次第ご案内を差し上げます。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":52,"w":52,"x":281,"y":124}]},"medium":{"faces":[{"h":52,"w":52,"x":281,"y":124}]},"orig":{"faces":[{"h":52,"w":52,"x":281,"y":124}]},"small":{"faces":[{"h":34,"w":34,"x":183,"y":81}]}},"id_str":"2112317081769377792","indices":[151,174],"media_key":"3_2112317081769377792","media_results":{"result":{"media_key":"3_2112317081769377792"}},"media_url_https":"https://pbs.twimg.com/media/HVB1Mb_agAAqWW8.jpg","original_info":{"focus_rects":[{"h":403,"w":720,"x":0,"y":0},{"h":720,"w":720,"x":0,"y":0},{"h":821,"w":720,"x":0,"y":0},{"h":1040,"w":520,"x":77,"y":0},{"h":1040,"w":720,"x":0,"y":0}],"height":1040,"width":720},"sizes":{"large":{"h":1040,"resize":"fit","w":720},"medium":{"h":1040,"resize":"fit","w":720},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/7CaoyEHLX2"}]},"favorite_count":44,"favorited":false,"full_text":"【11/21 国際セミナー2026】\n「障害者のための強力なリハビリテーションチームを創る」をテーマに国際セミナーを開催します。皆さまのご参加をお待ちしています。（事前申込制、日英同時通訳・日本語字幕あり）\n\n■詳細はこちら\nhttps://t.co/YzQzytWqUb\n\n#国リハ #国際セミナー https://t.co/7CaoyEHLX2","