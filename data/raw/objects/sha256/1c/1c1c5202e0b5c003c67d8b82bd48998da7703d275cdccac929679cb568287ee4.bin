":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2102412606308757511"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"like and subscribe","entities":{"description":{},"url":{"urls":[{"display_url":"youtube.com","expanded_url":"http://youtube.com/","indices":[0,23],"url":"https://t.co/GIOK0JwagA"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"regular"},"relationship_counts":{"followers":68773062,"following":1141},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"10228272","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":16205,"tweets":61578},"verification":{"verified":false,"verified_type":"Business"},"website":{"url":"https://t.co/GIOK0JwagA"}}}]},"rest_id":"https://t.co/9hByNfaagA"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39877,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":99,"tweets":441},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2112426569008640214"],"editable_until_msecs":"1792480315000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":5,"bookmarked":false,"conversation_id_str":"2112426569008640214","created_at":"Tue Oct 20 06:11:55 +0000 2026","display_text_range":[0,146],"entities":{},"favorite_count":233,"favorited":false,"full_text":"【10月20日　小泉防衛大臣会見】\n冒頭、令和8年度安全保障技術研究推進制度の採択結果公表、中国無人機の飛行、日マレーシア防衛相会談の実施について発表しました。\n \nその他、\n○三文書改定に向けた検討\n○安全保障技術研究推進制度\n○防衛省AI活用推進基本方針\n○米空母艦載機部隊配備特別交付金","id_str":"2112426569008640214","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":8,"retweet_count":42,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/SQnQKzywoJ8?si…","expanded_url":"https://youtu.be/SQnQKzywoJ8?si=SBQY3vHpjHyxzO9d","indices":[1840,1863],"url":"https://t.co/9hByNfaagA"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI0MjY1Njg3ODIxNTU3NzY=","text":"【10月20日　小泉防衛大臣会見】\n冒頭、令和8年度安全保障技術研究推進制度の採択結果公表、中国無人機の飛行、日マレーシア防衛相会談の実施について発表しました。\n \nその他、\n○三文書改定に向けた検討\n○安全保障技術研究推進制度\n○防衛省AI活用推進基本方針\n○米空母艦載機部隊配備特別交付金\n○日米共同統合演習「キーン・ソード27」\n○現地情報隊\n○在日アメリカ軍の活動\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「今日は冒頭３件ございます。まず１点目です。令和８年度の安全保障技術研究推進制度、いわゆる防衛省ファンディングの採択結果についてお知らせいたします。\n \n防衛省では、先進的な民生技術の積極的な活用を図るため、平成２７年度に先進的な民生技術に係る基礎研究について、外部の研究機関等に委託又は補助金を交付する、いわゆる防衛省ファンディングを創設しました。以降、大学・企業等に対する公募を毎年度実施してきたところですが、今回の公募から、従来の研究テーマに加えて、外傷医療やＰＴＳＤ対策等への寄与が期待される医療・医工学を研究テーマに追加しております。\n \n令和８年度の公募では、制度創設以降最多となった昨年度の３４０件を大きく上回る５６０件の応募をいただきました。特に、大学等からは、過去最多の応募件数となった前年度の２倍を超える２９１件の応募をいただきました。制度趣旨を理解し、数多くの応募をいただいたことに心より感謝申し上げます。\n \nいただいた御応募については、外部有識者により構成する委員会の厳正な審査を経て、４７件を採択いたしました。採択の内訳は、大学等が３０件、公的研究機関が１１件、企業等が６件です。\n \n本制度を活用いただいている皆様の研究の成果が、防衛分野での将来の研究開発に資することに加え、防衛分野以外での我が国の科学技術・イノベーションにも広く寄与することを期待いたします。なお、詳細については、防衛装備庁ホームページで公表いたします。\n \nそして２点目ですが、昨日、中国軍の偵察型無人機（ＢＺＫ－００５）１機及び情報収集機（Ｙ－９）１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至った後、再び沖縄本島と宮古島の間を通過したことを確認し、公表しました。中国軍の無人機による沖縄本島と宮古島との間の通過についての確認・公表は、昨年６月以来であり、今年度においては初となります。\n \nまた、同日、中国軍の偵察／攻撃型無人機（ＴＢ－００１）１機が東シナ海から飛来し、与那国島と台湾の間を通過して太平洋に至り、奄美大島沖まで飛行した後、沖縄本島と宮古島の間を通過したことを確認し、公表しました。つい先日、１０月１４日にも、推定中国無人機１機が与那国島と台湾との間を通過し、太平洋に至ったことを確認・公表しています。\n \n昨日の活動を含め、近年は我が国周辺において無人機の活動が活発化しています。例えば、２０２４年度の中国軍無人機の活動公表回数は２３回と、前年度の８回から約３倍となっているほか、２０２５年度は１６回公表しており、高い水準で推移しています。\n \n防衛省では、戦略三文書の改定に向けた検討を進めているところですが、今回の無人機の事象は、正に新たな戦い方への対応、無人機への対応の必要性を示すものであり、国民の皆様にも、こういった安全保障環境の変化を丁寧にお伝えをして、御理解いただけるようにしたいと考えています。\n \nそして最後３点目です。昨日、訪日中のマレーシアのカレド国防大臣と防衛相会談を実施しました。\n \n会談では、マラッカ海峡を含むシーレーンの要衝に位置するマレーシアが、地域の平和と安定のために果たしている役割に敬意を表するとともに、共に海洋国家である両国の海軍種間の協力が進展していることを踏まえ、海洋安全保障分野における協力を一層深化させるための包括的な計画を作成していく方向性で一致しました。また、防衛装備・技術協力についても、両国の共通利益となる協力の実現に向け、議論を加速していくことで一致しました。\n \n我が国の包括的・戦略的パートナーであるマレーシアは、インド太平洋地域の平和と安定にとって重要なパートナーです。カレド国防大臣とは、今後とも様々な機会を捉えて、緊密に意思疎通を図り、両国の防衛協力を更に推進していきたいと考えています。冒頭３件、以上です。」\n \n↓動画はこちら\nhttps://t.co/9hByNfaagA"}}},"rest_id":"2112426569008640214","unmention_data":{