0,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/8XdcmYXPUm","video_info":{"aspect_ratio":[16,9],"duration_millis":165300,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2112520822569218048/pl/jIpTG9SqZRZBfuaY.m3u8?tag=29&v=840"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112520822569218048/vid/avc1/480x270/yX8S9Bi8gOLJArb3.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112520822569218048/vid/avc1/640x360/fgPm_li67i7s-47c.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112520822569218048/vid/avc1/1280x720/ZPODalpvSsQwMG4S.mp4?tag=29"}]}}]},"favorite_count":639,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２０日）、高市総理は、国と地方の協議の場（令和８年度第２回）に出席しました。\n\n※高市総理挨拶要旨(速報版)\n　地方六団体の代表の先生方におかれましては、この協議の場に足をお運びいただき、誠にありがとうございます。 https://t.co/8XdcmYXPUm","id_str":"2112521195363139595","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":24,"retweet_count":91,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI1MjExOTUyNzUxNDExMjA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２０日）、高市総理は、国と地方の協議の場（令和８年度第２回）に出席しました。\n\n※高市総理挨拶要旨(速報版)\n　地方六団体の代表の先生方におかれましては、この協議の場に足をお運びいただき、誠にありがとうございます。 \n　高市内閣では、「責任ある積極財政」の大方針を掲げて、「強い経済」の実現に向けた政策を加速させ、「日本列島を強く、豊かに」してまいります。 \n　現在、「日本成長戦略」と「地域未来戦略」を両輪に、大規模かつ長期の、予見可能性の高い財政支出を計画的に行って、「大胆な国内投資」を力強く引き出そうということで取組を進めております。 \n　「地域未来戦略」に基づく各地域の特色を活かした「産業クラスター計画」は、現在、７４が策定・公表されております。そして、全国各地で数百もの新たな計画の構想が進んでいます。 \n　私も、自治体の皆様から計画のお話を直接伺ってまいりましたけれども、新たな「産業クラスター」を形成するという、非常に強い決意が感じられ、とても頼もしく思っております。 \n　日本列島の隅々まで、「産業クラスターの花」を咲かせて、地域経済の成長につなげてまいりましょう。 \n　税・社会保険料負担や物価高に苦しんでおられる「中所得・低所得の方々の負担軽減」は、高市内閣の最重要課題です。「消費税・支援金法案」を１０月９日に閣議決定して、国会に提出をしました。 \n　「自治体の事務負担」につきましては、最小化に取り組み、引き続き先生方と丁寧に協議していくとともに、「地方消費税の減収額」を全額国費で補填をいたします。地方の財政運営に支障が生じないように、適切に対応してまいります。 \n　先生方からいただいたご意見を踏まえてですね、「社会保障」及び「教育」に関して、国の政策の企画立案や実施についても協議を行う「国と地方の協議の場」も設けることといたしました。 \n　この他、「人口戦略」や「防災・減災対策」など、諸般の取組についても、先生方としっかり連携を進めていきたいと考えておりますので、どうかよろしくお願いを申し上げます。"}}},"rest_id":"2112521195363139595","unmention_data":{},"views":{"count":"27470","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112521195363139595","sortIndex":"2112591446602153982"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【F