lse,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI0NzQwNTE1NzkxMjU3NjE=","richtext":{"richtext_tags":[]},"text":"カナダ・アルバータ州のカナダ軍ウェインライト基地で発生した痛ましい火災により、カナダ軍兵士の方々が命を落とし、多数の負傷者が出たことに、深い悲しみを覚えます。\n犠牲となられた方々の御遺族・御友人の皆様に心よりお悔やみを申し上げるとともに、負傷されたすべての方々の一日も早い御快復をお祈りいたします。\nこの悲劇に際し、迅速に対応された救助関係者や救急隊員、そして地元当局の皆様に、心からの敬意を表します。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":28},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2061844725158617088/byt__CeE_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/14713787/1787064394"},"core":{"created_at":"Fri May 09 14:25:26 +0000 2008","name":"Prime Minister of Canada","screen_name":"CanadianPM"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNDcxMzc4Nw==","is_blue_verified":false,"location":{"location":"Ottawa, Ontario, Canada"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"Official account of Prime Minister Mark Carney – Terms: https://t.co/WDHAlJzpe4 – Français : @PMcanadien","entities":{"description":{"urls":[{"display_url":"ow.ly/WHHy50XuW9X","expanded_url":"https://ow.ly/WHHy50XuW9X","indices":[56,79],"url":"https://t.co/WDHAlJzpe4"}]},"url":{"urls":[{"display_url":"pm.gc.ca","expanded_url":"https://pm.gc.ca","indices":[0,23],"url":"https://t.co/r4iPQjoq8x"}]}}},"profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":794182,"following":294},"relation