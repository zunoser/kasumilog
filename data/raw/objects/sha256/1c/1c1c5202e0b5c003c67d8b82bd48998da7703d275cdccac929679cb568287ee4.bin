entions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIzOTMzNzc3ODIzNTgwMTY=","richtext":{"richtext_tags":[]},"text":"10月18日(日)、井林大臣は、東京貨物ターミナル駅において、コンテナホームや総合物流施設「東京レールゲートEAST」等を視察し、鉄道貨物輸送の取組や課題等の説明をＪＲ貨物から受けました。\nまた、羽田空港において、管制塔や今年９月に供用開始した第1旅客ターミナルビル北側サテライト施設等を視察し、運用状況等の説明を受けるとともに、JR東日本羽田空港アクセス線（仮称）等の工事状況を視察し、事業概要や整備効果等の説明を受けました。"}}},"rest_id":"2112393377828515866","unmention_data":{},"views":{"count":"6929","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112393377828515866","sortIndex":"2112591446602153918"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":