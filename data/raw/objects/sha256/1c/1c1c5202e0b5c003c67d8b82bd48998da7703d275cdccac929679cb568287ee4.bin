false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3014063,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":590,"tweets":1880},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112430492704501765"],"editable_until_msecs":"1792481251000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":88,"bookmarked":false,"conversation_id_str":"2112430492704501765","created_at":"Tue Oct 20 06:27:31 +0000 2026","display_text_range":[0,97],"entities":{},"favorite_count":9300,"favorited":false,"full_text":"本日午前10時から、フィリピンのマルコス大統領と電話会談を行いました。\n\n私から、11月のASEAN関連首脳会議に向け、ASEAN議長国であるフィリピンと緊密に協力していきたい旨申し上げました。","id_str":"2112430492704501765","is_quote_status":false,"lang":"ja","quote_count":79,"reply_count":545,"retweet_count":862,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI0MzA0OTI2NTgzNDgwMzI=","richtext":{"richtext_tags":[]},"text":"本日午前10時から、フィリピンのマルコス大統領と電話会談を行いました。\n\n私から、11月のASEAN関連首脳会議に向け、ASEAN議長国であるフィリピンと緊密に協力していきたい旨申し上げました。\n\nまた、中東情勢をめぐる不安定な状況が長引く中、経済・エネルギー強靱化に向け、AZECでの協力も含め、フィリピンとの連携を確認しました。\n\nマルコス大統領からは、日本の取組に対する謝意が表明され、11月の首脳会議に向け協力していきたい旨を伺いました。\n\n５月のマルコス大統領の国賓訪日以降、日・フィリピン関係は幅広い分野で着実に進展しています。\n\n日本は、地域の平和と安定のため、これからもフィリピンと緊密に連携してまいります。"}}},"rest_id":"2112430492704501765","unmention_data":{},"views":{"count":"354222","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112430492704501765","sortIndex":"2112591446602153938"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/SQnQKzywoJ8","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2112412535060410368/EsaYWpQK?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":158,"url":"https://pbs.twimg.com/card_img/2112412535060410368/EsaYWpQK?format=jpg&name=280x280","width":280},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66521","type":"STRING"}},{"key":"description","value":{"string_value":"【10月20日　小泉防衛大臣会見】１　発表事項〇　今日は冒頭３件ございます。まず１点目です。令和８年度の安全保障技術研究推進制度、...","type":"STRING"}},{"key":"player_width","value":{"string_value":"1280","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"10228272","path":[]}}},{"key":"player_image_original","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2112412