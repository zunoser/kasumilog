ofile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":591163,"following":204},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20288,"tweets":49016},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2108475004954563025"],"editable_until_msecs":"1791538189000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":18,"bookmarked":false,"conversation_id_str":"2108475004954563025","created_at":"Fri Oct 09 08:29:49 +0000 2026","display_text_range":[0,57],"entities":{"media":[{"display_url":"pic.x.com/F9rLDm2zuO","expanded_url":"https://x.com/MofaJapan_jp/status/2108475004954563025/photo/1","ext_alt_text":"１　我が国は、最近のエチオピアとエリトリア間の緊張の高まりが、周辺地域の一層の不安定化につながりかねない状況にあることを注視しており、エチオピアとエリトリア両国が、双方の主権、独立及び領土の一体性を尊重し、最大限の自制を発揮して両国間の緊張を緩和することを強く求めます。\n\n２　我が国は、エチオピアとエリトリア両国が、歴史的な２０１８年の和平枠組の精神に則り、いかなる緊張や紛争も、対話を通じ平和的かつ外交的に解決することを強く求めます。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108474819755020288","indices":[58,81],"media_key":"3_2108474819755020288","media_results":{"result":{"media_key":"3_2108474819755020288"}},"media_url_https":"https://pbs.twimg.com/media/HULOrWlakAAiIvg.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":0},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":389,"y":0},{"h":1299,"w":1039,"x