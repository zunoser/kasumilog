tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1MDc3MDc4NDYwNTM4ODg=","richtext":{"richtext_tags":[]},"text":"今日の閣議において、公務員の給与改定に関する取扱方針と、関係法案の改正案を決定しました。\n\n私自身は、総理に就任した昨年10月21日から、総理大臣給与を自主返納していましたが、高市内閣としては、昨年末から閣僚、副大臣、政務官等については、「議員歳費を超える分を受け取らない措置」を開始しており、これを継続します。\n\nちなみに、この措置により、年間約6.5億円の節約になります。"}}},"rest_id":"2108507707892212181","unmention_data":{},"views":{"count":"4207323","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108507707892212181","sortIndex":"2109100249048940502"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":147,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=280x150","width":280},"type":"IMAGE"}},{"key":"description","value":{"string_value":"近年、猛暑や豪雨、地震などの自然災害や、住宅や店舗を狙う犯罪への不安が高まる中、暮らしを守る「窓」に注目が集ま","type":"STRING"}},{"key":"domain","value":{"string_value":"journal.meti.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":315,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=600x600","width":600},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2105989046346690560/UTVfjhVR?format=png&name=386x202","width":386},"type":"IMAGE"}},{"key":"