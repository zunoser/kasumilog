333223030784"}},"media_url_https":"https://pbs.twimg.com/media/HUMh6I0bUAAMC0o.jpg","original_info":{"focus_rects":[{"h":368,"w":657,"x":0,"y":0},{"h":368,"w":368,"x":86,"y":0},{"h":368,"w":323,"x":109,"y":0},{"h":368,"w":184,"x":178,"y":0},{"h":368,"w":1200,"x":0,"y":0}],"height":368,"width":1200},"sizes":{"large":{"h":368,"resize":"fit","w":1200},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yeaSZJN4CG"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/yeaSZJN4CG","expanded_url":"https://x.com/MofaJapan_jp/status/2108566340432953757/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108566333223030784","indices":[35,58],"media_key":"3_2108566333223030784","media_results":{"result":{"media_key":"3_2108566333223030784"}},"media_url_https":"https://pbs.twimg.com/media/HUMh6I0bUAAMC0o.jpg","original_info":{"focus_rects":[{"h":368,"w":657,"x":0,"y":0},{"h":368,"w":368,"x":86,"y":0},{"h":368,"w":323,"x":109,"y":0},{"h":368,"w":184,"x":178,"y":0},{"h":368,"w":1200,"x":0,"y":0}],"height":368,"width":1200},"sizes":{"large":{"h":368,"resize":"fit","w":1200},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yeaSZJN4CG"}]},"favorite_count":1862,"favorited":false,"full_text":"今般、米国が国際刑事裁判所（ICC）それ自体への制裁を決定しました。 https://t.co/yeaSZJN4CG","id_str":"2108566340432953757","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":134,"reply_count":110,"retweet_count":662,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1NjYzNDAzNzQzMTUwMDg=","richtext":{"richtext_tags":[]},"text":"今般、米国が国際刑事裁判所（ICC）それ自体への制裁を決定しました。\n我が国は国際社会における法の支配の徹底を一貫して重視し、その役割を担う国際司法裁判所（ICJ）、ICC、国際海洋法裁判所（ITLOS）等の国際裁判所を支持しています。今回の措置は、こうした日本の一貫した立場と相容れるものではなく、深く懸念しています。\nその上で、 ICCがその本来の役割と機能を果たし、普遍的な裁判所として国際社会の信頼に足り得るためには、 ICCが抱える課題にICCや締約国が対処し、適正な運営がなされることが重要です。我が国としても、締約国として関連の議論に参加し、引き続き必要な支援を行っていきます。\nまた、我が国のこうした立場も踏まえ、米国のルビオ国務長官と意見交換し、今後も意思疎通を継続していくこととしています。難しい状況の中でも、引き続き、米国に対して働きかけを行うとともに、赤根ICC所長や関係国との意思疎通を継続しつつ、国際社会における法の支配の強化に取り組んでいく考えです。"}}},"rest_id":"2108566340432953757","unmention_data":{},"views":{"count":"154693","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2109100249048940564-tweet-2108566772932858110","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/QvB9Vk1gzk"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2107316172916130039"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":591163,"following":204},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20288,"tweets":49016},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2108566772932858110"],"editable_until_msecs":"1791560068000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":5,"bookmarked":false,"conversation_id_str":"2108566340432953757","created_at":"Fri Oct 09 14:34:28 +0000 2026","display_text_range":[0,23],"entities":{"urls":[{"display_url":"x.com/MofaJapan_en/s…","expanded_url":"https://x.com/MofaJapan_en/status/2108566651453251850","indices":[0,23],"url":"https://t.co/QvB9Vk1gzk"}]},"favorite_count":62,"favorited":false,"full_text":"https://t.co/QvB9Vk1gzk","id_str":"2108566772932858110","in_reply_to_screen_name":"MofaJapan_jp","in_reply_to_status_id_str":"2108566340432953757","in_reply_to_user_id_str":"303730149","is_quote_status":true,"lang":"zxx","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"quoted_status_id_str":"2108566651453251850","quoted_status_permalink":{"display":"x.com/MofaJapan_en/s…","expanded":"https://x.com/MofaJapan_en/status/2108566651453251850","url":"https://t.co/QvB9Vk1gzk"},"reply_count":6,"retweet_count":25,"retweeted":false,"user_id_str":"303730149"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":51},"affiliates_highlighted_label":{"label":{"badge":{"url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_bigger.jpg"},"description":"外務省","url":{"url":"https://twitter.com/MofaJapan_jp","urlType":"DeepLink"},"userLabelDisplayType":"Badge","userLabelType":"BusinessLabel"}},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102640077467649/QaRdW4oU_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303735625/1791191287"},"core":{"created_at":"Mon May 23 10:32:05 +0000 2011","name":"MOFA of Japan","screen_name":"MofaJapan_en"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzU2MjU=","is_blue_verified":true,"location":{"location":"Tokyo"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2103406416824541536"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"The Official English Account of the Ministry of Foreign Affairs of Japan.\nSocial Media List: https://t.co/PnH9N7WcqL","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/about/list_en.…","expanded_url":"https://www.mofa.go.jp/about/list_en.html","indices":[93,116],"url":"https://t.co/PnH9N7WcqL"}]},"url":{"urls":[{"display_url":"mofa.go.jp","expanded_url":"http://www.mofa.go.jp/","indices":[0,23],"url":"https://t.co/jDWRcTicQE"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":154031,"following":178},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8689,"tweets":19652},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2108566651453251850"],"editable_until_msecs":"1791560039000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"data":{"associated_data":{},"destination_language":"ja","entities":{"hashtags":[],"symbols":[],"urls":[],"user_mentions":[]},"preview_translation":"米国は、国際刑事裁判所（ICC）そのものに対して制裁を課すことを決定しました。","source_language":"en","translation":"米国は、国際刑事裁判所（ICC）そのものに対して制裁を課すことを決定しました。\n日本は、国際社会における法の支配の維持に一貫して重大な重要性を付与しており、国際司法裁判所（ICJ）、国際刑事裁判所（ICC）、国際海洋法裁判所（ITLOS）を含む、この点で役割を果たす国際裁判所及び裁判所を支持しています。これらの措置は日本の持続的な立場と相容れず、日本はこれらについて深い懸念を抱いています。\n同時に、国際刑事裁判所（ICC）が当初想定された役割と機能を果たし、普遍的な裁判所として国際社会の信頼を得るためには、ICCとその締約国が裁判所が直面する課題に対処し、裁判所が適切に運営されることが重要です。締約国として、日本は関連する議論に参加しつつ、その役割を着実に果たし続けます。\nさらに、日本の立場を踏まえ、米国務長官マルコ・ルビオと見解を交換し、今後も緊密な意思疎通を維持することに合意しました。こうした困難な状況下でも、米国に対して働きかけを続け、国際刑事裁判所（ICC）の赤根総裁や関係国との意思疎通を維持し、国際社会における法の支配の強化に向けた取組を進めてまいります。"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":192,"bookmarked":false,"conversation_id_str":"2108566651453251850","created_at":"Fri Oct 09 14:33:59 +0000 2026","display_text_range":[0,276],"entities":{"media":[{"display_url":"pic.x.com/W0hXlp7H79","expanded_url":"https://x.com/MofaJapan_en/status/2108566651453251850/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108566644129951744","indices":[277,300],"media_key":"3_2108566644129951744","media_results":{"result":{"media_key":"3_2108566644129951744"}},"media_url_https":"https://pbs.twimg.com/media/HUMiMPCacAASlE2.jpg","original_info":{"focus_rects":[{"h":368,"w":657,"x":272,"y":0},{"h":368,"w":368,"x":416,"y":0},{"h":368,"w":323,"x":439,"y":0},{"h":368,"w":184,"x":508,"y":0},{"h":368,"w":1200,"x":0,"y":0}],"height":368,"width":1200},"sizes":{"large":{"h":368,"resize":"fit","w":1200},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/W0hXlp7H79"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/W0hXlp7H79","expanded_url":"https://x.com/MofaJapan_en/status/2108566651453251850/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108566644129951744","indices":[277,300],"media_key":"3_2108566644129951744","media_results":{"result":{"media_key":"3_2108566644129951744"}},"media_url_https":"https://pbs.twimg.com/media/HUMiMPCacAASlE2.jpg","original_info":{"focus_rects":[{"h":368,"w":657,"x":272,"y":0},{"h":368,"w":368,"x":416,"y":0},{"h":368,"w":323,"x":439,"y":0},{"h":368,"w":184,"x":508,"y":0},{"h":368,"w":1200,"x":0,"y":0}],"height":368,"width":1200},"sizes":{"large":{"h":368,"resize":"fit","w":1200},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/W0hXlp7H79"}]},"favorite_count":1360,"favorited":false,"full_text":"The United States has decided to impose sanctions on the International Criminal Court (ICC) itself.\nJapan has consistently attached great importance to upholding the rule of law in the international community and supports international courts and tribunals that play a role in https://t.co/W0hXlp7H79","id_str":"2108566651453251850","is_quote_status":false,"lang":"en","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":67,"reply_count":101,"retweet_count":489,"retweeted":false,"user_id_str":"303735625"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1NjY2NTEzMTg5ODQ3MDQ=","richtext":{"richtext_tags":[]},"text":"The United States has decided to impose sanctions on the International Criminal Court (ICC) itself.\nJapan has consistently attached great importance to upholding the rule of law in the international community and supports international courts and tribunals that play a role in this regard, including the International Court of Justice (ICJ), the ICC, and the International Tribunal for the Law of the Sea (ITLOS). The measures are incompatible with Japan's consistent position, and Japan is deeply concerned about them.\nAt the same time, in order for the ICC to fulfill its role and functions as originally envisaged and to gain the trust of the international community as a universal court, it is important that the ICC and its States Parties address the challenges facing the Court, so that the Court is administered appropriately. As a State Party, Japan will continue to steadily fulfill its role, participating in relevant discussions.\nFurthermore, in light of Japan's position, we have exchanged views with U.S. Secretary of State Marco Rubio and agreed to maintain close communication going forward. Even in these difficult circumstances, we will continue to reach out to the United States, maintain communication with President Akane of the ICC as well as related countries, and work toward strengthening the rule of law in the international community."}}},"rest_id":"2108566651453251850","unmention_data":{},"views":{"count":"284742","state":"EnabledWithCount"}}},"rest_id":"2108566772932858110","unmention_data":{},"views":{"count":"13736","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2108566340432953757","2108566772932858110"],"enableDeduplication":true}}},"entryId":"list-conversation-2109100249048940564","sortIndex":"2109100249048940524"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3014230,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":579,"tweets":1859},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2108564441034018868"],"editable_until_msecs":"1791559512000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":520,"bookmarked":false,"conversation_id_str":"2108564441034018868","created_at":"Fri Oct 09 14:25:12 +0000 2026","display_text_range":[0,124],"entities":{},"favorite_count":17056,"favorited":false,"full_text":"今般、米国が、国際刑事裁判所（ICC）それ自体への制裁を決定しました。\n\n我が国は国際社会における法の支配を一貫して重視し、その役割を担うICCを支持しています。\n今回の措置は、こうした一貫した日本の立場と相容れるものではなく、深く懸念しています。","id_str":"2108564441034018868","is_quote_status":false,"lang":"ja","quote_count":614,"reply_count":1218,"retweet_count":2306,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1NjQ0NDA5MjUwMTE5Njk=","richtext":{"richtext_tags":[]},"text":"今般、米国が、国際刑事裁判所（ICC）それ自体への制裁を決定しました。\n\n我が国は国際社会における法の支配を一貫して重視し、その役割を担うICCを支持しています。\n今回の措置は、こうした一貫した日本の立場と相容れるものではなく、深く懸念しています。\n\nこうした我が国の立場は、私が国連総会における一般討論演説や国会での所信表明でも述べているとおりです。\n\n先般の日米首脳会談でも一致したように、ルビオ国務長官と茂木外務大臣で意思疎通を行うことにしており、今後も続けていきます。\n我が国の立場も踏まえ、米国に対して働きかけを続けるとともに、赤根所長や関係国との意思疎通も継続しつつ、ICCがその本来の役割と機能を果たせるよう必要な支援を行っていきます。\n\nThe United States has decided to impose sanctions on the International Criminal Court (ICC) itself.\n\nJapan has consistently attached great importance to upholding the rule of law in the international community and supports the International Criminal Court (ICC) that plays a role in this regard.\nThe measures are incompatible with Japan’s such consistent position, and Japan is deeply concerned about them.\n\nI have referred to such position in my General Debate address at the United Nations General Assembly and in my policy speech before the Diet.\n\nAs agreed at the recent Japan-U.S. Summit Meeting, Foreign Minister Motegi and U.S. Secretary of State Rubio are to conduct close communication and continue it going forward.\nBased on the position of Japan, we will continue to reach out to the United States and extend necessary support to the ICC so that the Court can fulfill its role and functions as originally envisaged, while maintaining communication with President Akane of the ICC as well as related countries."}}},"rest_id":"2108564441034018868","unmention_data":{},"views":{"count":"1529767","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108564441034018868","sortIndex":"2109100249048940523"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_m