08520994554163200/img/M_tmXPR3pJtds1-5.jpg","original_info":{"focus_rects":[],"height":1920,"width":1080},"sizes":{"large":{"h":1920,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":675},"small":{"h":680,"resize":"fit","w":383},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/CFDS3bCUTg","video_info":{"aspect_ratio":[9,16],"duration_millis":99033,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2108520994554163200/pl/gtkl9LbjZPxvE2A4.m3u8?tag=29&v=cfc"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108520994554163200/vid/avc1/320x568/JZlZKMt3nT9jpadk.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108520994554163200/vid/avc1/480x852/qJgMxHht9BoIDJV4.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108520994554163200/vid/avc1/720x1280/BaIoKO7e1b68MjZk.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108520994554163200/vid/avc1/1080x1920/z66JWADCZ-FET8hf.mp4?tag=29"}]}}]},"favorite_count":1830,"favorited":false,"full_text":"【高市総理・所信表明演説（人口減少社会への対応）】\n人口減少は、静かに進む国難です。少子化の流れを反転させるとともに、人口減少社会に適応した新たな国のかたちを築かなければなりません。 https://t.co/CFDS3bCUTg","id_str":"2108521342756872630","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":86,"reply_count":419,"retweet_count":309,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1005shoshinhyomei.html","indices":[231,254],"url":"https://t.co/VLOHmIUPX1"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1MjEzNDI2OTQwNDM2NDk=","richtext":{"richtext_tags":[]},"text":"【高市総理・所信表明演説（人口減少社会への対応）】\n人口減少は、静かに進む国難です。少子化の流れを反転させるとともに、人口減少社会に適応した新たな国のかたちを築かなければなりません。\n人手不足は、人口減少社会の最大の課題です。医療・介護、物流・公共交通などのエッセンシャルサービスを守り、国内投資拡大にも対応するため、AXの社会実装を大胆に進めます。\n\n10月5日に行われた高市総理の所信表明演説の動画及びテキストは、官邸HPに掲載しています。\n▼詳細はこちら\nhttps://t.co/VLOHmIUPX1"}}},"rest_id":"2108521342756872630","unmention_data":{},"views":{"count":"69543","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108521342756872630","sortIndex":"2109100249048940514"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":52},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1697575938316529664/Iob6ICh3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/331514169/1655191913"},"core":{"created_at":"Fri Jul 08 08:59:28 +0000 2011","name":"財務省","screen_name":"MOF_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMzE1MTQxNjk=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関3-1-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"財務省の公式アカウントです。財務省ホームページに掲載する情報を中心に発信していきます。\n【運用ポリシー】https://t.co/Mk40iFUuyb\n【財務省note】https://t.co/PEuOEDD4Nu","entities":{"description":{"urls":[{"display_url":"mof.go.jp/about_mof/soci…","expanded_url":"http://www.mof.go.jp/about_mof/social_media_account/index.html","indices":[52,75],"