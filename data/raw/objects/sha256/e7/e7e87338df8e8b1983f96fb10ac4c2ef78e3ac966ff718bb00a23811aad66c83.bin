立場を伝えた上で、両外相は緊密に意思疎通を継続していくことで一致しました。両外相は、厳しい安全保障環境の中で日米同盟を更に強固なものにし、幅広い日米協力を進めていくため、引き続き共に取り組んでいくことを確認しました。\n\nhttps://t.co/ofy5iMsVx0"}}},"rest_id":"2108911398734766223","unmention_data":{},"views":{"count":"36559","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108911398734766223","sortIndex":"2109100249048940542"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=png&name=2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":75.17,"rgb":{"blue":255,"green":255,"red":