x1280/E-iajinpYBbsJGx8.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108743663782367232/vid/avc1/1080x1920/m95nI1k--GZcDhWb.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/aZPnPCNige","expanded_url":"https://x.com/kantei/status/2108745848633147677/video/1","ext_media_availability":{"status":"Available"},"id_str":"2108743663782367232","indices":[95,118],"media_key":"13_2108743663782367232","media_results":{"result":{"media_key":"13_2108743663782367232"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2108743663782367232/img/zGPJB0pSdMJhmx94.jpg","original_info":{"focus_rects":[],"height":1920,"width":1080},"sizes":{"large":{"h":1920,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":675},"small":{"h":680,"resize":"fit","w":383},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/aZPnPCNige","video_info":{"aspect_ratio":[9,16],"duration_millis":108633,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2108743663782367232/pl/Ed4cuEgzjkqZW_4T.m3u8?tag=29&v=6ce"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108743663782367232/vid/avc1/320x568/w7Yri42xPjXnGU6L.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108743663782367232/vid/avc1/480x852/IBdGzuKdmkX-C0aS.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108743663782367232/vid/avc1/720x1280/E-iajinpYBbsJGx8.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108743663782367232/vid/avc1/1080x1920/m95nI1k--GZcDhWb.mp4?tag=29"}]}}]},"favorite_count":2044,"favorited":false,"full_text":"【高市総理・所信表明演説（防災、復旧・復興）】\n多くの自然災害に見舞われる日本にとって、災害に対する強靱性の向上は、国民の皆様の命と暮らし、そして、経済活動を守るために、不可欠な課題です。 https://t.co/aZPnPCNige","id_str":"2108745848633147677","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":21,"reply_count":180,"retweet_count":316,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1005shoshinhyomei.html","indices":[260,283],"url":"https://t.co/VLOHmIUPX1"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg3NDU4NDg1NjE4MDMyNjQ=","richtext":{"richtext_tags":[]},"text":"【高市総理・所信表明演説（防災、復旧・復興）】\n多くの自然災害に見舞われる日本にとって、災害に対する強靱性の向上は、国民の皆様の命と暮らし、そして、経済活動を守るために、不可欠な課題です。\n能登半島地震や熊本地震など、被災地の皆様が復興を実感できるその日まで、政府が責任をもって取り組んでまいります。\n「福島の復興なくして、東北の復興なし。東北の復興なくして、日本の再生なし。」この原点を決して忘れません。\n \n10月5日に行われた高市総理の所信表明演説の動画及びテキストは、官邸HPに掲載しています。\n▼詳細はこちら\nhttps://t.co/VLOHmIUPX1"}}},"rest_id":"2108745848633147677","unmention_data":{},"views":{"count":"48111","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108745848633147677","sortIndex":"2109100249048940529"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_p