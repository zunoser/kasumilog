:{"large":{"faces":[{"h":60,"w":60,"x":502,"y":677}]},"medium":{"faces":[{"h":60,"w":60,"x":502,"y":677}]},"orig":{"faces":[{"h":60,"w":60,"x":502,"y":677}]},"small":{"faces":[{"h":34,"w":34,"x":284,"y":383}]}},"id_str":"2108437399235969024","indices":[160,183],"media_key":"3_2108437399235969024","media_results":{"result":{"media_key":"3_2108437399235969024"}},"media_url_https":"https://pbs.twimg.com/media/HUKspMSbwAAsdk8.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":228},{"h":900,"w":900,"x":0,"y":0},{"h":900,"w":789,"x":0,"y":0},{"h":900,"w":450,"x":45,"y":0},{"h":900,"w":1200,"x":0,"y":0}],"height":900,"width":1200},"sizes":{"large":{"h":900,"resize":"fit","w":1200},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/X8mvMhAnLv"}]},"favorite_count":11,"favorited":false,"full_text":"／\n地域社会DXに取り組む皆様に\n     #地域社会DXナビ ！\n＼\n「AI×ICTによる地域社会DXの推進」をテーマに、地域課題の解決に取り組む優良事例を紹介する「中国地域DX推進セミナー」が広島市で開催され、オンライン参加を含む約170人が参加しました。\n詳しくは👉https://t.co/tG6S5nChKa https://t.co/X8mvMhAnLv","id_str":"2108437404336194030","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":4,"retweet_count":2,"retweeted":false,"user_id_str":"1469058582"},"rest_id":"2108437404336194030","unmention_data":{},"views":{"count":"5171","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2109100249048940612-tweet-2108481921563181171","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"alt":"地域社会DXナビ","height":144,"url":"https://pbs.twimg.com/card_img/2108370809760907264/VD3oPUzw?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"AI(人工知能)とICT(情報通信技術)を組み合わせ、地域課題の解決に取り組む優良事例を紹介する「中国地域DX推進セミナー」（主催＝総務省中国総合通信局、一般社団法人電子情報通信学会中国支部、共催＝中国地方非常通信協議会、中国情報通信懇談会、中国地域ICT産学官連携フォーラム）が2026年７月31日、広島市南区の「TKPガーデンシティPREMIUM広島駅前」で開催されました。「AI×ICTに...","type":"STRING"}},{"key":"domain","value":{"string_value":"dx-navi.soumu.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"alt":"地域社会DXナビ","height":420,"url":"https://pbs.twimg.com/card_img/2108370809760907264/VD3oPUzw?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"alt":"地域社会DXナビ","height":630,"url":"https://pbs.twimg.com/card_img/2108370809760907264/VD3oPUzw?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"alt":"地域社会DXナビ","height":100,"url":"https://pbs.twimg.com/card_img/2108370809760907264/VD3oPUzw?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"alt":"地域社会DXナビ","height":630,"url":"https://pbs.twimg.com/card_img/2108370809760907264/VD3oPUzw?format=png&name=2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_alt_text","value":{"string_value":"地域社会DXナビ","type":"STRING"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"dx-navi.soumu.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":95.8,"rgb":{"blue":245,"green":251,"red":255}},{"percentage":1.89,"rgb":{"blue":178,"green":223,"red":255}},{"percentage":1.49,"rgb":{"blue":125,"green":126,"red":127}},{"percentage":0.52,"rgb":{"blue":25,"green":114,"red":246}},{"percentage":0.23,"rgb":{"blue":99,"green":159,"red":249}}]},"type":"IMAGE_COLOR"}},{"key":"title","value":{"string_value":"イベントレポートvol.30 「中国地域DX推進セミナー」 | 地域社会DXナビ","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_u