555,"favorited":false,"full_text":"10月9日、小田原防衛副大臣は、ペルー海軍創設205周年記念レセプションに出席し、ペルーのフランシスコ・テンヤ駐日大使、オスカル・レガラド武官と懇談し日ペルーの協力・連携を確認したほか、各国の武官らと懇談しました。🇯🇵🤝🇵🇪 https://t.co/DDWChrKE5K","id_str":"2108511317862818054","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":1,"retweet_count":50,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1MTEzMTc4MTI0Nzc5NTI=","text":"10月9日、小田原防衛副大臣は、ペルー海軍創設205周年記念レセプションに出席し、ペルーのフランシスコ・テンヤ駐日大使、オスカル・レガラド武官と懇談し日ペルーの協力・連携を確認したほか、各国の武官らと懇談しました。🇯🇵🤝🇵🇪\n\nペルーは、基本的価値を共有する戦略的パートナーであり、2024年に日ペルー防衛協力・交流に関する覚書に署名しています。今後も二国間の防衛協力・交流をさらに推進していきます。"}}},"rest_id":"2108511317862818054","unmention_data":{},"views":{"count":"31769","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108511317862818054","sortIndex":"2109100249048940507"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2109100249048940582-tweet-2108510037027213672","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue