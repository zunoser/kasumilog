,"reply_count":18,"retweet_count":350,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1NDMwMTEwMjYyOTI3MzY=","text":"令和８年１０月９日（金）午後、中国軍の偵察／攻撃型無人機（ＴＢ－００１）×１機が大陸方面から飛来し、東シナ海上の沖縄本島沖で変針し、北東進した後、長崎県男女群島沖で変針し、大陸方面に向けて飛行したことを確認した。\nこれらに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"rest_id":"2108543011072462927","unmention_data":{},"views":{"count":"57322","state":"EnabledWithCount"}}},"rest_id":"2108544101050384565","unmention_data":{},"views":{"count":"41295","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108544101050384565","sortIndex":"2109100249048940520"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumb