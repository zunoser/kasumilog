,130],"media_key":"3_2108544091932037120","media_results":{"result":{"media_key":"3_2108544091932037120"}},"media_url_https":"https://pbs.twimg.com/media/HUMNrhjbkAAryCy.jpg","original_info":{"focus_rects":[{"h":472,"w":842,"x":0,"y":0},{"h":596,"w":596,"x":123,"y":0},{"h":596,"w":523,"x":160,"y":0},{"h":596,"w":298,"x":272,"y":0},{"h":596,"w":842,"x":0,"y":0}],"height":596,"width":842},"sizes":{"large":{"h":596,"resize":"fit","w":842},"medium":{"h":596,"resize":"fit","w":842},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/NMgOdJg7Hl"}]},"favorite_count":1319,"favorited":false,"full_text":"令和８年１０月９日（金）午後、中国軍の偵察／攻撃型無人機（ＴＢ－００１）×１機が大陸方面から飛来し、東シナ海上の沖縄本島沖で変針し、北東進した後、長崎県男女群島沖で変針し、大陸方面に向けて飛行したことを確認した。 https://t.co/NMgOdJg7Hl","id_str":"2108544101050384565","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"quoted_status_id_str":"2108543011072462927","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2108543011072462927","url":"https://t.co/bxAM4h1IdN"},"reply_count":14,"retweet_count":321,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1NDQxMDA5OTE3Mjk2NjQ=","text":"令和８年１０月９日（金）午後、中国軍の偵察／攻撃型無人機（ＴＢ－００１）×１機が大陸方面から飛来し、東シナ海上の沖縄本島沖で変針し、北東進した後、長崎県男女群島沖で変針し、大陸方面に向けて飛行したことを確認した。\nこれらに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"We