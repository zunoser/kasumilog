を実施します👀 https://t.co/BTpKorg4as","id_str":"2108546986530206202","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"reply_count":91,"retweet_count":266,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1NDY5ODY0ODgyNTg1NjA=","text":"フランス哨戒機が７度目となる「瀬取り」に対する警戒監視活動を実施予定🇯🇵🤝🇫🇷\n10月中旬から11月上旬の間、🇫🇷海軍哨戒機「ファルコン50M」が、北朝鮮籍船舶の「瀬取り」を含む違法な海上活動に対する警戒監視活動を実施します👀\n \n防衛省・自衛隊は国際社会とともに、国連安保理決議の実効性確保に取り組みます💪"}}},"rest_id":"2108546986530206202","unmention_data":{},"views":{"count":"43209","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108546986530206202","sortIndex":"2109100249048940522"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitiv