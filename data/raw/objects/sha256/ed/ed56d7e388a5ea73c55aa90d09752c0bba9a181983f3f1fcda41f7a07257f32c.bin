/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/640x360/hTOSuRhkGgqPq1Wy.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/1280x720/yNv2nb4-pMXKlWgK.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/1920x1080/8sn2z4hMhPby4t23.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/11DUbBKWxh","expanded_url":"https://x.com/ModJapan_jp/status/2101940382833463665/video/1","ext_media_availability":{"status":"Available"},"id_str":"2101940017555992576","indices":[125,148],"media_key":"13_2101940017555992576","media_results":{"result":{"media_key":"13_2101940017555992576"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2101940017555992576/img/32GKx8JnYtUTczBk.jpg","original_info":{"focus_rects":[],"height":1080,"width":1920},"sizes":{"large":{"h":1080,"resize":"fit","w":1920},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/11DUbBKWxh","video_info":{"aspect_ratio":[16,9],"duration_millis":50833,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2101940017555992576/pl/7rTjHce7lnGX7bXp.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/480x270/CJfbLSI0BD7w4M16.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/640x360/hTOSuRhkGgqPq1Wy.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/1280x720/yNv2nb4-pMXKlWgK.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/1920x1080/8sn2z4hMhPby4t23.mp4?tag=29"}]}}]},"favorite_count":340,"favorited":false,"full_text":"９月２０日に、輸送艦「くにさき」がキジン港を出港した際の様子です。\n\n山林火災の状況や安全に部隊運用を行う上で必要な気象条件などを考慮し、インドネシア側との調整の上で、輸送艦「くにさき」は、CH-47輸送ヘリを１機搭載し、クタパン沖へ移動しました。 https://t.co/11DUbBKWxh","id_str":"2101940382833463665","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2101532257395806708","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":0,"retweet_count":51,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE5NDAzODI3ODMyMDk0NzI=","text":"９月２０日に、輸送艦「くにさき」がキジン港を出港した際の様子です。\n\n山林火災の状況や安全に部隊運用を行う上で必要な気象条件などを考慮し、インドネシア側との調整の上で、輸送艦「くにさき」は、CH-47輸送ヘリを１機搭載し、クタパン沖へ移動しました。\n\nキジン港とクタパン沖の２ヶ所からCH-47輸送ヘリにより消火活動を実施します。"}}},"rest_id":"2101940382833463665","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"22246","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2101532257395806708","2101940382833463665"],"enableDeduplication":true}}},"entryId":"list-conversation-2102260920225890325","sortIndex":"2102260920225890283"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/7hqmpH6hGr"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18