"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2996854,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":539,"tweets":1796},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2101157747329003832"],"editable_until_msecs":"1789793619000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":282,"bookmarked":false,"conversation_id_str":"2101157747329003832","created_at":"Sat Sep 19 03:53:39 +0000 2026","display_text_range":[0,102],"entities":{},"favorite_count":15682,"favorited":false,"full_text":"先の国会で成立した『携帯電話不正利用防止法』の改正についてご紹介いたします。\n\n特殊詐欺の被害額は、過去最悪を更新し続けており、令和7年における被害額が約3,257億円に達するなど、極めて深刻な状況です。","id_str":"2101157747329003832","is_quote_status":false,"lang":"ja","quote_count":218,"reply_count":692,"retweet_count":2642,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/XL86eC1TDZ4?si…","expanded_url":"https://youtu.be/XL86eC1TDZ4?si=IlKMMdAMlPcqWLam","indices":[725,748],"url":"https://t.co/i1WmGBtRPR"},{"display_url":"youtu.be/koH3Xzts_o4?si…","expanded_url":"https://youtu.be/koH3Xzts_o4?si=LfrntH1nIrYV5GaS","indices":[755,778],"url":"https://t.co/9qWoMe7rV5"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDExNTc3NDcxNjk2MjQwNjQ=","richtext":{"richtext_tags":[]},"text":"先の国会で成立した『携帯電話不正利用防止法』の改正についてご紹介いたします。\n\n特殊詐欺の被害額は、過去最悪を更新し続けており、令和7年における被害額が約3,257億円に達するなど、極めて深刻な状況です。\n\nこうした犯罪では、携帯電話をはじめとする通信サービスが巧妙に悪用されており、一層踏み込んだ対策を講じる必要がありました。\n\n今回の改正は、私が昨年まで会長を務めていた自民党の「治安・テロ・サイバー犯罪対策調査会」による『組織的な詐欺から国民の財産を守るための対策に関する緊急提言』を踏まえて実現した対策です。\n\n近年の詐欺では、メッセージアプリなどの「データ通信」の悪用が指摘されており、特に被害が深刻なSNS型投資・ロマンス詐欺では、被害者の方への連絡の9割以上でデータ通信を用いるサービスが不正に利用されました。\n\nこのため、「音声SIM（電話番号や契約情報を書き込んだ小さなチップ）」に加え、「データ通信専用SIM」も本人確認の義務を課し、匿名による携帯通信サービスの不正利用の防止を図ります。\n\nまた、多数の携帯電話回線の契約は、詐欺などに悪用されるおそれがあることから、個人による契約回線数の上限について統一的な基準を示し、通信事業者がその上限を超える回線数の契約申込みを拒否できることを法律で明確化し、通信事業者による対策を一層促進していきます。\n\n加えて、通信サービスを悪用した特殊詐欺の被害を防ぐための対策のポイントを分かりやすくお伝えする取組も進めています。\n\n政府と通信事業者が連携し、こうした対策を確実に進め、国民の皆様が安心して通信サービスを利用できる環境を確保してまいります。\n\n【YouTube動画】\n（特殊詐欺）https://t.co/i1WmGBtRPR\n（制度改正）https://t.co/9qWoMe7rV5"}}},"rest_id":"2101157747329003832","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"862515","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101157747329003832","sortIndex":"2102260920225890233"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2996854,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":539,"tweets":1796},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2101142705309208791"],"editable_until_msecs":"1789790032000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":180,"bookmarked":false,"conversation_id_str":"2101142705309208791","created_at":"Sat Sep 19 02:53:52 +0000 2026","display_text_range":[0,143],"entities":{},"favorite_count":14065,"favorited":false,"full_text":"いよいよ本日、4年に1度のアジア最大のスポーツの祭典である「第20回アジア競技大会（2026/愛知・名古屋）」が開幕します。\n\n1994年の広島大会以来、32年ぶりの日本での開催となる本大会は、「愛知・名古屋」を中心に開催され、アジアの「トップアスリート」が一堂に会する大会となります。","id_str":"2101142705309208791","is_quote_status":false,"lang":"ja","quote_count":298,"reply_count":846,"retweet_count":1328,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDExNDI3MDUyNDYyNDQ4NjQ=","richtext":{"richtext_tags":[]},"text":"いよいよ本日、4年に1度のアジア最大のスポーツの祭典である「第20回アジア競技大会（2026/愛知・名古屋）」が開幕します。\n\n1994年の広島大会以来、32年ぶりの日本での開催となる本大会は、「愛知・名古屋」を中心に開催され、アジアの「トップアスリート」が一堂に会する大会となります。\n本大会の開催に向けた準備に御尽力いただいた、全ての関係者の皆様に、深く感謝申し上げます。\n\nアジアの国・地域から、訪日される多くの選手や関係者の皆様を、心から歓迎申し上げます。\n\n選手の皆様は、ひたむきに努力を積み重ね、本大会への出場をかなえられたことと思います。\nこの檜舞台で、自らを信じ、持てる力を存分に発揮されることを期待しております。\nこれまで選手を支え続けてこられた御家族や多くの関係者の皆様にも、心から敬意を表します。\n\n本大会は、10月4日までの約2週間にわたり、アジアの「トップアスリート」が、43の競技で、熱い戦いを繰り広げます。\n皆様も、各国・地域の選手にエールを送っていただくとともに、日本選手の活躍に熱い声援を送っていただければと思います。\n\n選手の皆様のご健闘を心から祈念いたしますとともに、本大会が皆様に感動と勇気を届ける素晴らしいものとなることを願っております。"}}},"rest_id":"2101142705309208791","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"814057","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101142705309208791","sortIndex":"2102260920225890232"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23]