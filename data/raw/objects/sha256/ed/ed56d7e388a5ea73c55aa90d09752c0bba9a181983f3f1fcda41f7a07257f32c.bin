unt":2,"retweet_count":37,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE5MDIxODQwNjU2ODc1NTI=","richtext":{"richtext_tags":[]},"text":"令和8年台風第25号による大雨について、大臣指示を行いました。\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、被害が発生した場合は、人命第一の方針の下、災害応急対策に全力で取り組むこと。\n２．地方自治体とのホットライン等を通じて情報を収集し、要請に応じて迅速に地方自治体への支援等を実施すること。"}}},"rest_id":"2101902184103477314","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"11641","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2101902184103477314","sortIndex":"2102260920225890271"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/pvgRM8Jyxf"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2100823875403874738"]},"possibly_sens