,"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[0,6],"text":"陸上自衛隊"},{"indices":[40,44],"text":"ＷＰＳ"},{"indices":[45,67],"text":"WomenPeaceandSecurity"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA5MDI2NTY0NzQ3OTE5MzY=","text":"#陸上自衛隊 は、９月１５日から１７日の間、防衛省が主催する第３回日ＡＳＥＡＮ #ＷＰＳ(#WomenPeaceandSecurity)協力プロジェクトに参加しました。\n防衛省・自衛隊を含む各国取組紹介においては、陸自のジェンダー･アドバイザー等が災害現場に進出して被災者目線の支援に繋がる取組を紹介したほか、ＡＳＥＡＮやインド太平洋地域の国々からの発表や意見交換を通じて、様々な知見や経験を学ぶことができました。\nその後に実施した災害対応に係る机上検討においては、関係部隊等からの参加を得て直近の災害派遣の教訓を取り込みながら、被災者に寄り添った支援のあり方について議論を交わし、他の参加者とともにＷＰＳに係る理解を深めることができました。"}}},"rest_id":"2100902656516747338","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"37022","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2100991663317627215","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"5059","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100991663317627215","sortIndex":"2102260920225890226"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"fo