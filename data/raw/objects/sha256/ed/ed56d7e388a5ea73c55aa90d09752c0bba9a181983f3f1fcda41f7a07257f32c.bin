grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":512,"bookmarked":false,"conversation_id_str":"2101477369714507948","created_at":"Sun Sep 20 01:03:43 +0000 2026","display_text_range":[0,129],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/o7qQDalVfA","expanded_url":"https://x.com/takaichi_sanae/status/2101477369714507948/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":69,"w":69,"x":570,"y":812}]},"medium":{"faces":[{"h":40,"w":40,"x":334,"y":475}]},"orig":{"faces":[{"h":74,"w":74,"x":603,"y":859}]},"small":{"faces":[{"h":23,"w":23,"x":189,"y":269}]}},"id_str":"2101477313103929344","indices":[130,153],"media_key":"3_2101477313103929344","media_results":{"result":{"media_key":"3_2101477313103929344"}},"media_url_https":"https://pbs.twimg.com/media/HSnye28aIAAgw9b.jpg","original_info":{"focus_rects":[{"h":840,"w":1500,"x":0,"y":1327},{"h":1500,"w":1500,"x":0,"y":667},{"h":1710,"w":1500,"x":0,"y":457},{"h":2167,"w":1084,"x":416,"y":0},{"h":2167,"w":1500,"x":0,"y":0}],"height":2167,"width":1500},"sizes":{"large":{"h":2048,"resize":"fit","w":1418},"medium":{"h":1200,"resize":"fit","w":831},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/o7qQDalVfA"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/o7qQDalVfA","expanded_url":"https://x.com/takaichi_sanae/status/2101477369714507948/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":69,"w":69,"x":570,"y":812}]},"medium":{"faces":[{"h":40,"w":40,"x":334,"y":475}]},"orig":{"faces":[{"h":74,"w":74,"x":603,"y":859}]},"small":{"faces":[{"h":23,"w":23,"x":189,"y":269}]}},"id_str":"2101477313103929344","indices":[130,153],"media_key":"3_2101477313103929344","media_results":{"result":{"media_key":"3_2101477313103929344"}},"media_url_https":"https://pbs.twimg.com/media/HSnye28aIAAgw9b.jpg","original_info":{"focus_rects":[{"h":840,"w":1500,"x":0,"y":1327},{"h":1500,"w":1500,"x":0,"y":667},{"h":1710,"w":1500,"x":0,"y":457},{"h":2167,"w":1084,"x":416,"y":0},{"h":2167,"w":1500,"x":0,"y":0}],"height":2167,"width":1500},"sizes":{"large":{"h":2048,"resize":"fit","w":1418},"medium":{"h":1200,"resize":"fit","w":831},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/o7qQDalVfA"}]},"favorite_count":19985,"favorited":false,"full_text":"今や、クリックひとつで商品が届く便利な時代。\nしかし、その便利な暮らしを支える物流業界の人手不足が大きな課題になっています。\n高市内閣では、「安定した物流体制の確保」を目指しています。\n\n今回は、先の国会で成立した『改正物流効率化法』について、ご紹介します。 https://t.co/o7qQDalVfA","id_str":"2101477369714507948","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":677,"reply_count":2072,"retweet_count":2750,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE0NzczNjk2NDc0MDMwMDg=","richtext":{"richtext_tags":[]},"text":"今や、クリックひとつで商品が届く便利な時代。\nしかし、その便利な暮らしを支える物流業界の人手不足が大きな課題になっています。\n高市内閣では、「安定した物流体制の確保」を目指しています。\n\n今回は、先の国会で成立した『改正物流効率化法』について、ご紹介します。\n\n物流は、我が国の暮らしや経済を支える重要な社会インフラですが、近年、トラックドライバーの「高齢化」や「人手不足」が進む中で、物流を維持するための「輸送力の確保」が喫緊の課題となっています。\n\nこうした状況を踏まえ、ドライバーの負担軽減を図りつつ物流を維持するため、1つの長距離輸送を複数のドライバーで分担する「中継輸送」を推進してまいります。\n\n例えば、途中の中継拠点でドライバーの交代や荷物の積替え等をすることで、一人ひとりの運転距離を短くすることができます。\nまた、ドライバーの負担軽減だけでなく、帰り荷の確保など、運行効率の向上も期待できます。\n\n『改正物流効率化法』では、国土交通大臣が、中継輸送の実施に関する基本方針を策定するとともに、国や地方公共団体、トラック事業者、荷主、倉庫業者などによる連携・共働を促進するため、必要な助言や協力等を行うこととしました。\n\nまた、中継輸送を実施しようとする事業者が共同で計画を作成し、国の認定を受ける制度を創設し、認定された計画に基づく取組には、課税の特例や鉄道・運輸機構による出資・貸付けなどの支援を行います。\n\n物流は、私たちの暮らしと経済を支える重要な社会インフラです。\nこれらの支援措置を講じることで、ドライバーの負担を減らしながら物流を維持するための「輸送力の確保」を図ってまいります。"}}},"rest_id":"2101477369714507948","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"845251","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101477369714507948","sortIndex":"2102260920225890242"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府の公式アカウントです。内閣府大臣官房政策評価広報課が運営しています。運営方針 https://t.co/LtXxYQ4rJW を御確認のうえ御利用ください。問い合わせは https://t.co/ANlK6wet0H","entities":{"description":{"urls":[{"display_url":"cao.go.jp/others/seihyou…","expanded_url":"https://www.cao.go.jp/others/seihyou/sns/x.html","indices":[42,65],"url":"https://t.co/LtXxYQ4rJW"},{"display_url":"cao.go.jp/goiken.html","expanded_url":"https://www.cao.go.jp/goiken.html","indices":[88,111],"url":"https://t.co/ANlK6wet0H"}]},"url":{"urls":[{"display_url":