ed":false,"full_text":"【消防庁とりまとめ第2報】令和8年台風第25号による被害及び消防機関等の対応状況について、9月20日（日）17時00分現在の被害状況等を取りまとめました。  詳細はこちら→https://t.co/K0m0MWxcdt","id_str":"2101585668795510806","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":14,"retweeted":false,"user_id_str":"137272821"},"rest_id":"2101585668795510806","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"27349","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101585668795510806","sortIndex":"2102260920225890251"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2996854,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":539,"tweets":1796},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2101572252827259362"],"editable_until_msecs":"1789892445000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":273,"bookmarked":false,"conversation_id_str":"2101572252827259362","created_at":"Sun Sep 20 07:20:45 +0000 2026","display_text_range":[0,45],"entities":{},"favorite_count":23152,"favorited":false,"full_text":"一昨日（金曜日）夜までに、自民党役員会、内閣の大臣、副大臣、大臣政務官の人事を終えました。","id_str":"2101572252827259362","is_quote_status":false,"lang":"ja","quote_count":346,"reply_count":2050,"retweet_count":2477,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE1NzIyNTI3NTYwMTcxNTI=","richtext":{"richtext_tags":[]},"text":"一昨日（金曜日）夜までに、自民党役員会、内閣の大臣、副大臣、大臣政務官の人事を終えました。\n\n自民党の全ての衆議院議員を対象に実施した役職希望アンケートを熟読しながら、皆様が熱意を持って取り組みたい課題の内容を吟味し、全員の第一希望を叶えることは不可能ですが、概ね本人の意向に沿った人事になったかと思います。\n\n参議院議員については、自民党では全ての役職は参議院会長が決める事となっていますので、アンケートは実施されませんでしたが、内閣にも専門分野に応じた方々を推薦して頂いたものだと思いました。\n\n日本維新の会でも、吉村代表や藤田共同代表が熟慮して下さった政務三役人事に、感謝申し上げています。\n\n昨日からは、国会の委員長、党の総務会、幹事長指名の局長等、政調会の多数の政策構築機関の長など、多くの人事が動き始めました。\n総務会長にも、幹事長にも、政調会長にも、この連休を使ってご苦労頂いている最中だと思います。\n\n私自身は、「総裁指名総務」の人選を終えた後、一昨日夜から、「総裁直轄本部（重要政策の取り纏めを行う党則第79条機関）」の人事に着手しています。\n\n特に総裁直轄本部は、「北朝鮮による拉致問題対策本部」「憲法改正実現本部」「東日本大震災復興加速化本部」「食料安全保障強化本部」「日本成長戦略本部」など、重要課題に取り組みますので、本部長の人選は、アンケートに記載して頂いた課題意識も参考にしながら、真剣に慎重に進めています。\n\n明日には、国連総会出席の為、ニューヨークに向かいますので、今日は、国連総会一般討論演説の再ペン入れやバイ会談の準備に時間を使います。\n\n帰国日の深夜頃には、膨大な人事作業を仕上げて、来たる臨時国会には自民党として万全の体制で臨めるようにしたいと考えています。"}}},"rest_id":"2101572252827259362","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1303900","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101572252827259362","sortIndex":"2102260920225890250"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#