_tweet_ids":["2101637043323568493"],"editable_until_msecs":"1789907892000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2101637043323568493","created_at":"Sun Sep 20 11:38:12 +0000 2026","display_text_range":[0,64],"entities":{},"favorite_count":449,"favorited":false,"full_text":"【９月２０日　小泉防衛大臣臨時会見】\n\n北朝鮮による弾道ミサイル発射に伴い臨時会見を行いました。\n\n↓発表事項の全文はこちら\n○","id_str":"2101637043323568493","is_quote_status":false,"lang":"ja","quote_count":3,"reply_count":6,"retweet_count":71,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/G2GQG196Og8?si…","expanded_url":"https://youtu.be/G2GQG196Og8?si=mmBCcZCpoF-3IFnx","indices":[878,901],"url":"https://t.co/rNuiYvJrRW"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE2MzcwNDMxNjQxNjgxOTI=","text":"【９月２０日　小泉防衛大臣臨時会見】\n\n北朝鮮による弾道ミサイル発射に伴い臨時会見を行いました。\n\n↓発表事項の全文はこちら\n○　北朝鮮は本日１５時頃、北朝鮮東岸付近から少なくとも１発の弾道ミサイルを北東方向に向けて発射しました。詳細については、現在、日米韓で緊密に連携して分析中ですが、発射された弾道ミサイルは最高高度約６０ｋｍ程度で約４４０ｋｍ程度飛翔し、落下したのは、日本海の我が国の排他的経済水域外であると推定しています。総理には、本件について直ちに報告を行い、情報収集・分析に全力を挙げ、国民に対して迅速・的確な情報提供を行うこと。航空機、船舶等の安全確認を徹底すること。不測の事態に備え、万全の態勢をとることの３点について指示がありました。また、防衛省においては、防衛大臣が総理指示を受け、アメリカ、韓国等と緊密に連携しつつ、情報収集・分析に全力を挙げること。不測の事態の発生に備え、引き続き、警戒監視に万全を期すことの２点について指示を出しました。現在までのところ、航空機や船舶からの被害報告等の情報は確認されておりません。これまでの弾道ミサイル等の度重なる発射も含め、一連の北朝鮮の行動は、我が国、地域及び国際社会の平和と安全を脅かすものです。また、このような弾道ミサイル発射は関連する安保理決議に違反し、国民の安全に関わる重大な問題です。今回の発射については、我が国として北朝鮮に対し、北京の大使館ルートを通じて厳重に抗議し、強く非難しました。防衛省としては、国民の生命・財産を守り抜くため、引き続き、アメリカや韓国等とも緊密に連携し、情報の収集・分析及び警戒監視に全力を挙げてまいります。\n○　そして、今日はもう一点、台風の関係の対応について報告させていただきます。現在、台風第２５号が接近しておりますが、朝霞駐屯地の東部方面総監部と東部方面情報隊が情報収集態勢を強化し、事態の推移に応じて必要な対応を迅速に行えるよう、万全の態勢を維持しております。引き続き、緊張感をもって対応してまいります。今日は２点以上です。　\n\n↓動画はこちら\nhttps://t.co/rNuiYvJrRW"}}},"rest_id":"2101637043323568493","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"40417","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2101644090563776661","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"5331","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101644090563776661","sortIndex":"2102260920225890259"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzY2ODI3OTE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関 "},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2001095001481076943"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国税庁の公式アカウントです。税に関する情報を提供します。税務行政に対するご意見・ご要望は国税庁ホームページまで。https://t.co/lVWKzTUjtp","entities":{"description":{"urls":[{"display_url":"nta.go.jp/iken/mail.htm","expanded_url":"https://www.nta.go.jp/iken/