lcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39974,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":93,"tweets":385},"verification":{"verified":false},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2101650725088665882"],"editable_until_msecs":"1789911154000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":5,"bookmarked":false,"conversation_id_str":"2101650725088665882","created_at":"Sun Sep 20 12:32:34 +0000 2026","display_text_range":[0,64],"entities":{},"favorite_count":381,"favorited":false,"full_text":"【９月２０日　小泉防衛大臣臨時会見②】\n\n北朝鮮による弾道ミサイル発射に伴い臨時会見を行いました。\n \n↓発表事項の全文はこちら","id_str":"2101650725088665882","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":7,"retweet_count":61,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/OLLZ-OInlXs?si…","expanded_url":"https://youtu.be/OLLZ-OInlXs?si=_HqajUPZB8_LoMvj","indices":[831,854],"url":"https://t.co/CQ9lXZT7KJ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE2NTA3MjQ5MTI1Mjk0MDg=","text":"【９月２０日　小泉防衛大臣臨時会見②】\n\n北朝鮮による弾道ミサイル発射に伴い臨時会見を行いました。\n \n↓発表事項の全文はこちら\n　北朝鮮は、本日１７時５４分頃、北朝鮮東岸付近から少なくとも１発の弾道ミサイルを北東方向に向けて発射しました。詳細については、現在、日米韓で緊密に連携して分析中ですが、発射された弾道ミサイルは最高高度約７０ｋｍ程度で約５９０ｋｍ程度飛翔し、落下したのは、日本海の我が国の排他的経済水域外であると推定しています。なお、北朝鮮による弾道ミサイル等発射は、２０２６年に入ってから、今回の発射を含め９回、少なくとも１５発。昨年は４回、少なくとも５発ということですから、回数だけで昨年の２倍を超え、発数は少なくとも３倍と、そういうことになります。総理には、本件について直ちに報告を行い、情報収集・分析に全力を挙げ、国民に対して迅速・的確な情報提供を行うこと。航空機、船舶等の安全確認を徹底すること。不測の事態に備え、万全の態勢をとることの３点について指示がありました。また防衛省においては、防衛大臣が総理指示を受け、アメリカ、韓国等と緊密に連携しつつ、情報収集・分析に全力を挙げること。不測の事態の発生に備え、引き続き、警戒監視に万全を期すことの２点について指示を出しました。現在までのところ、航空機や船舶からの被害報告等の情報は確認されていません。これまでの弾道ミサイル等の度重なる発射も含め、一連の北朝鮮の行動は、我が国、地域及び国際社会の平和と安全を脅かすものです。また、このような弾道ミサイル発射は、関連する安保理決議に違反し、国民の安全に関わる重大な問題です。今回の発射については、我が国として北朝鮮に対し、北京の大使館ルートを通じて厳重に抗議し、強く非難しました。防衛省としては、国民の生命・財産を守り抜くため、引き続き、アメリカや韓国等とも緊密に連携し、情報の収集・分析及び警戒監視に全力を挙げてまいります。\n\n↓動画はこちら\nhttps://t.co/CQ9lXZT7KJ"}}},"rest_id":"2101650725088665882","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"40993","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2101650915346559210","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"5469","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101650915346559210","sortIndex":"2102260920225890260"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Twe