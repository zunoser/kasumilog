62,"y":0},{"h":804,"w":402,"x":313,"y":0},{"h":804,"w":1029,"x":0,"y":0}],"height":804,"width":1029},"sizes":{"large":{"h":804,"resize":"fit","w":1029},"medium":{"h":804,"resize":"fit","w":1029},"small":{"h":531,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/H26N4vHspo"},{"display_url":"pic.x.com/H26N4vHspo","expanded_url":"https://x.com/ModJapan_jp/status/2112307638465974319/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2112307624956018688","indices":[142,165],"media_key":"3_2112307624956018688","media_results":{"result":{"media_key":"3_2112307624956018688"}},"media_url_https":"https://pbs.twimg.com/media/HVBsl-naQAA75Wd.jpg","original_info":{"focus_rects":[{"h":628,"w":1121,"x":0,"y":0},{"h":804,"w":804,"x":158,"y":0},{"h":804,"w":705,"x":208,"y":0},{"h":804,"w":402,"x":359,"y":0},{"h":804,"w":1121,"x":0,"y":0}],"height":804,"width":1121},"sizes":{"large":{"h":804,"resize":"fit","w":1121},"medium":{"h":804,"resize":"fit","w":1121},"small":{"h":488,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/H26N4vHspo"}]},"favorite_count":468,"favorited":false,"full_text":"令和８年１０月１９日（月）午前から午後にかけて、中国軍の偵察型無人機（ＢＺＫ－００５）×１機及び情報収集機（Ｙ－９）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、太平洋上で旋回後、反転し、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確 https://t.co/H26N4vHspo","id_str":"2112307638465974319","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"quoted_status_id_str":"2112200180078645347","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2112200180078645347","url":"https://t.co/rkDVvpkuDq"},"reply_count":10,"retweet_count":130,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIzMDc2Mzg0MDI5NjE0MDg=","text":"令和８年１０月１９日（月）午前から午後にかけて、中国軍の偵察型無人機（ＢＺＫ－００５）×１機及び情報収集機（Ｙ－９）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、太平洋上で旋回後、反転し、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nまた、同日午前から午後にかけて、中国軍の偵察／攻撃型無人機（ＴＢ－００１）×１機が東シナ海から飛来し、与那国島と台湾の間を通過して太平洋に至り、奄美大島沖まで飛行した後、反転し、沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nこれに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360817,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":f