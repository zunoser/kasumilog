882021060608"}},"media_url_https":"https://pbs.twimg.com/media/HU-oYFjaAAAAUYw.jpg","original_info":{"focus_rects":[{"h":1623,"w":2898,"x":0,"y":2473},{"h":2898,"w":2898,"x":0,"y":1198},{"h":3304,"w":2898,"x":0,"y":792},{"h":4096,"w":2048,"x":512,"y":0},{"h":4096,"w":2898,"x":0,"y":0}],"height":4096,"width":2898},"sizes":{"large":{"h":2048,"resize":"fit","w":1449},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/PZaUWk5jTX"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/PZaUWk5jTX","expanded_url":"https://x.com/takaichi_sanae/status/2112092067195470091/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2112091882021060608","indices":[141,164],"media_key":"3_2112091882021060608","media_results":{"result":{"media_key":"3_2112091882021060608"}},"media_url_https":"https://pbs.twimg.com/media/HU-oYFjaAAAAUYw.jpg","original_info":{"focus_rects":[{"h":1623,"w":2898,"x":0,"y":2473},{"h":2898,"w":2898,"x":0,"y":1198},{"h":3304,"w":2898,"x":0,"y":792},{"h":4096,"w":2048,"x":512,"y":0},{"h":4096,"w":2898,"x":0,"y":0}],"height":4096,"width":2898},"sizes":{"large":{"h":2048,"resize":"fit","w":1449},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/PZaUWk5jTX"}]},"favorite_count":16157,"favorited":false,"full_text":"本日10月19日から、バイクの「希望ナンバー制」の申込受付が始まりました。\n\nこれまでは四輪車が対象でしたが、「バイクでも好きな番号を選びたい」、そんなライダーの皆様の声にお応えするため、二輪車（125cc超）でも、ナンバープレートの４桁の数字を選ぶことができるようになりました。 https://t.co/PZaUWk5jTX","id_str":"2112092067195470091","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":860,"reply_count":1011,"retweet_count":3775,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIwOTIwNjcxNDA4OTA2MjQ=","richtext":{"richtext_tags":[]},"text":"本日10月19日から、バイクの「希望ナンバー制」の申込受付が始まりました。\n\nこれまでは四輪車が対象でしたが、「バイクでも好きな番号を選びたい」、そんなライダーの皆様の声にお応えするため、二輪車（125cc超）でも、ナンバープレートの４桁の数字を選ぶことができるようになりました。\n\n私も元ライダーの一人として、この制度のスタートを、とても嬉しく思いますし、希望されるライダーの皆様にも、「ご自分ならではの番号」をつけた愛車とともに、バイクライフを楽しんでいただければと思います。\n\n本制度をきっかけとして、バイクの魅力の更なる向上、そして、バイクに関わる市場の活性化が図られることを期待しています。"}}},"rest_id":"2112092067195470091","unmention_data":{},"views":{"count":"664568","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112092067195470091","sortIndex":"2112338165820817378"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2111550193179275264/nWpoykBz?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.fsa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2111550193179275264/nWpoykBz?format=png&name=420x420_2","width":400},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2111550193179275264/nWpoykBz?format=png&name=orig","width":401},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"276848601","path":[]}}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"htt