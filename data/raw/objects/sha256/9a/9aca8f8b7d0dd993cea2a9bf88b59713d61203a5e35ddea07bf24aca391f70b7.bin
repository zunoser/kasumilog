h":514,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Dg4taifzjl"}]},"favorite_count":510,"favorited":false,"full_text":"令和８年１０月１６日（金）午後１１時頃、海上自衛隊は、口永良部島（鹿児島県）の西約１４０ｋｍの海域において、同海域を南東進する中国海軍ルーヤンⅢ級ミサイル駆逐艦（艦番号「１２１」）及びフユ級高速戦闘支援艦（艦番号「９０１」）の２隻を確認した。 https://t.co/Dg4taifzjl","id_str":"2112117519414591785","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"quoted_status_id_str":"2112115053659058601","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2112115053659058601","url":"https://t.co/voGSPCgv6X"},"reply_count":4,"retweet_count":119,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIxMTc1MTkzNTE3MDU2MDA=","text":"令和８年１０月１６日（金）午後１１時頃、海上自衛隊は、口永良部島（鹿児島県）の西約１４０ｋｍの海域において、同海域を南東進する中国海軍ルーヤンⅢ級ミサイル駆逐艦（艦番号「１２１」）及びフユ級高速戦闘支援艦（艦番号「９０１」）の２隻を確認した。\nその後、１７日（土）に、これらの艦艇が大隅海峡を東進し、太平洋に向けて航行したことを確認した。\n防衛省・自衛隊は、海上自衛隊の第３哨戒防備隊所属「みくま」（佐世保）及び第１航空群所属「Ｐ－１」（鹿屋）により、警戒監視・情報収集を行った。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_comment