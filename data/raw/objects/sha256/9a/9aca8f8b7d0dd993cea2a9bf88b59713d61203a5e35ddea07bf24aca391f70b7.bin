t","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/WwvnM4tcJk","video_info":{"aspect_ratio":[16,9],"duration_millis":178433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2112135482989846528/pl/7uDChXPE8gkj-W2l.m3u8?tag=29&v=a2b"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112135482989846528/vid/avc1/480x270/6WUaEqzqIvcRCeJh.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112135482989846528/vid/avc1/640x360/RaUwSvzhg8DILR_9.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112135482989846528/vid/avc1/1280x720/4iLwlcK6CZQd62Po.mp4?tag=29"}]}}]},"favorite_count":1638,"favorited":false,"full_text":"【お知らせ】\n本日（１０月１９日）、高市総理は、日本経済団体連合会創立８０周年記念パーティーで挨拶を申し上げました。\n\n※高市総理挨拶要旨(速報版) \n　皆様、こんばんは。日本経済団体連合会ご創立から８０周年ということで、誠におめでとうございます。 https://t.co/WwvnM4tcJk","id_str":"2112136713640587534","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":25,"reply_count":146,"retweet_count":211,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIxMzY3MTM1NjUwNDQ3MzY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月１９日）、高市総理は、日本経済団体連合会創立８０周年記念パーティーで挨拶を申し上げました。\n\n※高市総理挨拶要旨(速報版) \n　皆様、こんばんは。日本経済団体連合会ご創立から８０周年ということで、誠におめでとうございます。\n\n　日本経済は、「デフレ的な経済構造」の中で「停滞」を経験してきましたけれども、本日お集りの皆様の賃上げのご努力ですとか、それからまた、これまでの経済政策も実を結びつつある中、流れが確実に変わり始めています。 \n\n　３年連続で５％台の賃上げが実現し、また、２０２５年度の国内の「民間企業設備投資」が過去最高水準に達しました。 \n\n　この変化の兆しを一時的なものに終わらせてしまうのか、それとも持続的な「成長の好循環」につなげていくのか、日本は今、その分岐点に立っています。 \n\n　だからこそ、今、高市内閣は、「責任ある積極財政」のもと、『日本成長戦略』と『地域未来戦略』を両輪に、「予算編成方針」も大胆に見直しました。政府が一歩前に出て、「民間投資の呼び水」として、大規模かつ長期の、また、予見可能性の高い財政支出を計画的に行い、大胆な「国内投資」を力強く引き出してまいります。\n\n　年内に策定する『日本成長戦略 実行計画』では、「足元の収益源」、そして「今後の稼ぎ頭」、「経済安全保障の強化」、の重点分野を中心に、今後５年間の「国内投資」の道筋を明らかにします。 \n\n　また、労働市場、金融などの「横断的課題」に対する総合的な施策や、思い切った「規制・制度改革」を実現します。 \n\n　筒井会長からは、「２０４０年度には２５０兆円」という野心的な国内投資目標を掲げていただきました。 \n\n　経済界の皆様には、ぜひ、筒井会長がおっしゃいましたとおり、また、政府の動きにも呼応していただき、「大胆な投資」と「賃上げ」に取り組んでいただきますことを、切に切にお願い申し上げ、期待を申し上げます。\n\n　皆様の益々の御活躍と日本経済団体連合会の御発展を祈念申し上げます。本日は御一緒させていただき、本当に嬉しく存じました。予算委員会が終わった閣僚達もたくさん来ておりますので、楽しんでくださいませ。\n　皆様、本当にありがとうございました。おめでとうございます。"}}},"rest_id":"2112136713640587534","unmention_data":{},"views":{"count":"48763","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112136713640587534","sortIndex":"2112338165820817399"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 