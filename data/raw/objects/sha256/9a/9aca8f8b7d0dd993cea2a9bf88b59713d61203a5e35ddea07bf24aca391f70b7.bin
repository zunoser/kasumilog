34,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":282,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/f22UGp1Na9"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/f22UGp1Na9","expanded_url":"https://x.com/takaichi_sanae/status/2112140216425472202/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":167,"w":167,"x":1295,"y":1019},{"h":233,"w":233,"x":651,"y":753},{"h":323,"w":323,"x":861,"y":293}]},"medium":{"faces":[{"h":98,"w":98,"x":759,"y":597},{"h":137,"w":137,"x":381,"y":441},{"h":189,"w":189,"x":504,"y":172}]},"orig":{"faces":[{"h":213,"w":213,"x":1645,"y":1294},{"h":297,"w":297,"x":827,"y":957},{"h":411,"w":411,"x":1094,"y":373}]},"small":{"faces":[{"h":55,"w":55,"x":430,"y":338},{"h":77,"w":77,"x":216,"y":250},{"h":107,"w":107,"x":286,"y":97}]}},"id_str":"2112140031678959616","indices":[67,90],"media_key":"3_2112140031678959616","media_results":{"result":{"media_key":"3_2112140031678959616"}},"media_url_https":"https://pbs.twimg.com/media/HU_UKxAbUAAURE_.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/f22UGp1Na9"}]},"favorite_count":5288,"favorited":false,"full_text":"本日夕方、『日本経済団体連合会 創立80周年記念行事』にお招きいただきました。\n\n経団連の創立80周年を、心よりお慶び申し上げます。 https://t.co/f22UGp1Na9","id_str":"2112140216425472202","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":109,"reply_count":724,"retweet_count":558,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTIxNDAyMTYzNTgzOTE4MDg=","richtext":{"richtext_tags":[]},"text":"本日夕方、『日本経済団体連合会 創立80周年記念行事』にお招きいただきました。\n\n経団連の創立80周年を、心よりお慶び申し上げます。\n\n日本経済は、「デフレ的経済構造」の下で「停滞」を経験してきましたが、経済界の皆様の賃上げのご努力や、これまでの経済政策が実を結びつつある中、流れが確実に変わり始めています。\n\n3年連続で5％台の賃上げが実現し、2025年度の国内の「民間企業設備投資」が過去最高水準に達しました。\n\nこの変化の兆しを一時的なものに終わらせるのか、それとも持続的な「成長の好循環」へ発展させるのか、日本は、その「分岐点」に立っています。\n\nだからこそ、今、高市内閣は、「責任ある積極財政」のもと、『日本成長戦略』と『地域未来戦略』を両輪に、「予算編成方針」も大胆に見直し、政府が一歩前に出て、「民間投資の呼び水」として、大規模かつ長期の、予見可能性の高い財政支出を計画的に行い、大胆な「国内投資」を力強く引き出していきます。\n\n年内に策定する『日本成長戦略実行計画』では、「足元の収益源」、「今後の稼ぎ頭」、「経済安全保障の強化」、の重点分野を中心に、今後5年間の「国内投資」の道筋を明らかにします。\n\nまた、労働市場、金融などの「横断的課題」に対する総合的な施策や、思い切った「規制・制度改革」を実現します。\n\n経団連筒井会長からは、「2040年度に250兆円」という野心的な国内投資目標を掲げていただきました。\n\n経済界の皆様には、政府の動きに呼応いただき、「大胆な投資」と「賃上げ」に取り組んでいただきますことを、期待申し上げています。"}}},"rest_id":"2112140216425472202","unmention_data":{},"views":{"count":"242383","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112140216425472202","sortIndex":"2112338165820817400"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 201