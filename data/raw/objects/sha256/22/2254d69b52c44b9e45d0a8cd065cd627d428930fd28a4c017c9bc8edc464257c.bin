_count":279,"retweet_count":2542,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTYxNDk2NTMyMDUxNTk5MzY=","richtext":{"richtext_tags":[]},"text":"９月４日、ロシア・ハバロフスク市内において、菊花紋章が型取られた標石をソ連兵が破壊する様子を表現した対日戦勝記念碑の銅像の除幕式が開催されました。\nこのような像は我が国との関係上建設的なものではなく、特に、菊花紋章は日本を象徴する紋章として広く認識されており、その破壊を表現する記念碑を設置することは、日本の国民感情の観点から受け入れられず、極めて遺憾です。外交ルートを通じて、ロシア側に対し、設置の中止及び撤去を強く要請しました。\nロシア側が、現時点まで日本側の要請に応じていないことは極めて遺憾であり、引き続き撤去をロシア側に強く働きかけていきます。"}}},"rest_id":"2096149653263917310","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"975168","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2096268425650241536-tweet-2096179293307220374","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/aO86wlZBub"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_s