key":"3_2095815003047862272","media_results":{"result":{"media_key":"3_2095815003047862272"}},"media_url_https":"https://pbs.twimg.com/media/HRXUpCOaIAABphW.jpg","original_info":{"focus_rects":[{"h":811,"w":1448,"x":0,"y":0},{"h":1448,"w":1448,"x":0,"y":0},{"h":1651,"w":1448,"x":0,"y":0},{"h":2048,"w":1024,"x":424,"y":0},{"h":2048,"w":1448,"x":0,"y":0}],"height":2048,"width":1448},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6M0nz4GtGf"}]},"favorite_count":522,"favorited":false,"full_text":"【🛰防衛×宇宙🚀シリーズ㉘】\n第28弾は、「宇宙（そら）の将来体制」\n \n8月31日、防衛省は令和9年度概算要求を決定しました📜\n宇宙の内容も盛りだくさん🍚\n自衛隊の作戦や国民生活に必要不可欠な宇宙領域の防衛体制をさらに強化し、防衛力の変革を実現していきます🛰 https://t.co/6M0nz4GtGf","id_str":"2095815013265260950","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"reply_count":13,"retweet_count":98,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[405,410],"text":"宇宙安保"},{"indices":[411,425],"text":"SDF_SpaceYear"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"mod.go.jp/j/budget/yosan…","expanded_url":"https://www.mod.go.jp/j/budget/yosan_gaiyo/fy2027/yosan_20260831.pdf","indices":[379,402],"url":"https://t.co/wflRNwEHHG"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTU4MTUwMTMxMzEwNTEwMDg=","text":"【🛰防衛×宇宙🚀シリーズ㉘】\n第28弾は、「宇宙（そら）の将来体制」\n \n8月31日、防衛省は令和9年度概算要求を決定しました📜\n宇宙の内容も盛りだくさん🍚\n自衛隊の作戦や国民生活に必要不可欠な宇宙領域の防衛体制をさらに強化し、防衛力の変革を実現していきます🛰\n \nいろいろな事業がありますが、いくつか簡単にご紹介(^^)\n☝宇宙領域での脅威を早期に把握する宇宙領域把握（SDA）衛星の整備\n☝通信能力・抗たん性を向上させた次期防衛通信衛星（「きらめき」後継）の整備\n☝極超音速滑空兵器を宇宙から探知・追尾する技術の実証\n☝衛星上でAIにより情報を統合処理し、スタンド・オフ・ミサイルなどと双方向通信する技術の実証\n☝衛星防護に必要となる機動的な衛星運用の技術の実証\n \nこれら事業により「新しい戦い方」への対応に取り組んでいきます✨\n \n↓詳しくはこちら\nhttps://t.co/wflRNwEHHG\n \n#宇宙安保\n#SDF_SpaceYear"}}},"rest_id":"2095815013265260950","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"39861","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095815013265260950","sortIndex":"2096268425650241505"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2096268425650241568-tweet-2095522656795967870","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2095650141558768004"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":