/policy/agenda/meeting/henkaku/index.html","indices":[271,294],"url":"https://t.co/8QaHMGAGdJ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTU3ODcyNDcwMDYzMzA4ODE=","text":"／\n📢イラン情勢でみられた戦い方や課題に関する資料を公表\n＼\n \n8月31日に開催した「防衛力変革推進本部」での議論に関する資料を公表します！\n \nテーマは以下のとおり👇\n\n「イラン情勢でみられた戦い方や課題」について、整理しました。得られた教訓を我が国の防衛力整備にどのように活用していくべきか、引き続き情報収集・分析を行いながら、三文書改定に向けた検討に活かしてまいります。\n \n今後も三文書改定に向けて、スピード感をもって検討を進めていきます。\n https://t.co/3XoQ4dbwce\n\n📌防衛力変革推進本部についてはこちら\nhttps://t.co/8QaHMGAGdJ"}}},"previous_counts":{"bookmark_count":2,"favorite_count":8,"quote_count":0,"reply_count":0,"retweet_count":1},"rest_id":"2095787247060832437","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"40638","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095787247060832437","sortIndex":"2096268425650241474"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"Non