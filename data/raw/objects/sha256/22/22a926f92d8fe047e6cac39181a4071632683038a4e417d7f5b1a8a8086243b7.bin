117218870092267937/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":285,"w":285,"x":1165,"y":155},{"h":259,"w":259,"x":463,"y":259}]},"medium":{"faces":[{"h":167,"w":167,"x":683,"y":91},{"h":152,"w":152,"x":271,"y":152}]},"orig":{"faces":[{"h":460,"w":460,"x":1877,"y":251},{"h":418,"w":418,"x":746,"y":418}]},"small":{"faces":[{"h":94,"w":94,"x":387,"y":51},{"h":86,"w":86,"x":153,"y":86}]}},"id_str":"2117217859210493952","indices":[141,164],"media_key":"3_2117217859210493952","media_results":{"result":{"media_key":"3_2117217859210493952"}},"media_url_https":"https://pbs.twimg.com/media/HWHebOpawAA95GL.jpg","original_info":{"focus_rects":[{"h":1846,"w":3297,"x":0,"y":0},{"h":2472,"w":2472,"x":0,"y":0},{"h":2472,"w":2168,"x":0,"y":0},{"h":2472,"w":1236,"x":288,"y":0},{"h":2472,"w":3297,"x":0,"y":0}],"height":2472,"width":3297},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6RY4e25aLf"},{"display_url":"pic.x.com/6RY4e25aLf","expanded_url":"https://x.com/meti_NIPPON/status/2117218870092267937/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2117217887127773184","indices":[141,164],"media_key":"3_2117217887127773184","media_results":{"result":{"media_key":"3_2117217887127773184"}},"media_url_https":"https://pbs.twimg.com/media/HWHec2paoAAPQZC.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":184},{"h":3072,"w":3072,"x":1024,"y":0},{"h":3072,"w":2695,"x":1401,"y":0},{"h":3072,"w":1536,"x":2201,"y":0},{"h":3072,"w":4096,"x":0,"y":0}],"height":3072,"width":4096},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6RY4e25aLf"}]},"favorite_count":355,"favorited":false,"full_text":"赤澤大臣は、防災士アンバサダーを務めるミス日本グランプリの野口氏と面談。災害対策としての事前防災の重要性に加え、災害時に、たいしたことではない、自分は大丈夫と思い込んでしまう「正常性バイアス」を乗り越える重要性について、発信力のある防災士アンバサダーとして、社会全体に広く発信して https://t.co/6RY4e25aLf","id_str":"2117218870092267937","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"reply_count":9,"retweet_count":77,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[204,216],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcyMTg4NzAwNDE5MzE3NzY=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、防災士アンバサダーを務めるミス日本グランプリの野口氏と面談。災害対策としての事前防災の重要性に加え、災害時に、たいしたことではない、自分は大丈夫と思い込んでしまう「正常性バイアス」を乗り越える重要性について、発信力のある防災士アンバサダーとして、社会全体に広く発信していただきたいとの期待を述べました。経済産業省としても、本日発足した防災庁と緊密に連携し、災害対応力の抜本的強化を進めていきます。#meti_daijin"}}},"rest_id":"2117218870092267937","unmention_data":{},"views":{"count":"30112","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117218870092267937","sortIndex":"2117864651994693557"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/W4DjDlR60u"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1907032035689996327"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":395087,"following":93},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"266566401","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":5471,"tweets":23394},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/3tgZ0wGHvI"}}}},"edit_control":{"edit_tweet_ids":["2117216851470295225"],"editable_until_msecs":"1793622408000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":5,"bookmarked":false,"conversation_id_str":"2117216851470295225","created_a