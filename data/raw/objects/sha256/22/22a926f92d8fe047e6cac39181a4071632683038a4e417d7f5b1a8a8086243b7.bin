ium":{"faces":[{"h":53,"w":53,"x":912,"y":303},{"h":99,"w":99,"x":271,"y":190},{"h":107,"w":107,"x":610,"y":91},{"h":111,"w":111,"x":820,"y":152},{"h":118,"w":118,"x":1050,"y":116}]},"orig":{"faces":[{"h":116,"w":116,"x":1977,"y":657},{"h":215,"w":215,"x":589,"y":413},{"h":233,"w":233,"x":1322,"y":198},{"h":241,"w":241,"x":1777,"y":330},{"h":256,"w":256,"x":2275,"y":253}]},"small":{"faces":[{"h":30,"w":30,"x":517,"y":171},{"h":56,"w":56,"x":154,"y":108},{"h":60,"w":60,"x":345,"y":51},{"h":63,"w":63,"x":464,"y":86},{"h":66,"w":66,"x":595,"y":66}]}},"id_str":"2117204599069437952","indices":[121,144],"media_key":"3_2117204599069437952","media_results":{"result":{"media_key":"3_2117204599069437952"}},"media_url_https":"https://pbs.twimg.com/media/HWHSXYxbcAAY6YW.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":628,"y":0},{"h":1734,"w":1521,"x":735,"y":0},{"h":1734,"w":867,"x":1062,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YPMRaeXRSn"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/YPMRaeXRSn","expanded_url":"https://x.com/takaichi_sanae/status/2117204810881814551/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":83,"w":83,"x":1089,"y":775}]},"medium":{"faces":[{"h":48,"w":48,"x":638,"y":454}]},"orig":{"faces":[{"h":106,"w":106,"x":1383,"y":985}]},"small":{"faces":[{"h":27,"w":27,"x":361,"y":257}]}},"id_str":"2117204621731196928","indices":[121,144],"media_key":"3_2117204621731196928","media_results":{"result":{"media_key":"3_2117204621731196928"}},"media_url_https":"https://pbs.twimg.com/media/HWHSYtMacAACFmC.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1452,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YPMRaeXRSn"}]},"favorite_count":30487,"favorited":false,"full_text":"本日、防災庁が発足しました。\n私も発足式に出席し、職員に訓示をさせていただきました。\n\n国民の皆様の命と暮らしを守り抜くことは、国家の最も大切な責務の一つです。\n\n我が国は、これまで数多くの災害に見舞われ、その度に尊い命が失われてきました。 https://t.co/YPMRaeXRSn","id_str":"2117204810881814551","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":721,"reply_count":2823,"retweet_count":3727,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcyMDQ4MTA4MDYyMDY0NjQ=","richtext":{"richtext_tags":[]},"text":"本日、防災庁が発足しました。\n私も発足式に出席し、職員に訓示をさせていただきました。\n\n国民の皆様の命と暮らしを守り抜くことは、国家の最も大切な責務の一つです。\n\n我が国は、これまで数多くの災害に見舞われ、その度に尊い命が失われてきました。\n「南海トラフ地震」などの国難級の災害が切迫する中、自然災害自体を防ぐことはできませんが、事前の備えで、被害を減らすことはできます。\n\n防災・減災で災害に強い国をつくることは、「日本列島を、強く豊かに。」することそのものです。\n\n防災庁は、事前防災など平時の備えから、発災時の初動対応、避難所の設置・物資供給、復旧・復興を一気通貫で行う災害対応の司令塔として、切れ目のない防災行政を担います。\n\n・強い司令塔として、地域ごとのリスクや府省庁の縦割り、対策の漏れを見逃さずに、災害対策を不断に改善する取組\n・災害対応の要として、平時から関係機関と緊密に連携しながら、災害対応力を向上する取組\n・避難環境の抜本的な改善に加え、ワンストップ窓口として、復旧・復興まで被災地に伴走する取組\n・産学官民の要として、企業、大学、NPO・ボランティアなどとの連携の一層の加速\n・防災産業を成長の力に変え、日本の知見・製品・サービス・インフラを世界に広げる取組\nなどを進めていきます。\n\n災害は、今日この瞬間にも起こり得ます。\n\n国民の皆様の命と暮らしを、守り抜く。\nそのために、一切の妥協はしない。\nこの覚悟の下、世界一の防災大国を目指し、政府一丸となって力を尽くしていきます。"}}},"rest_id":"2117204810881814551","unmention_data":{},"views":{"count":"1762219","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117204810881814551","sortIndex":"2117864651994693549"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","deta