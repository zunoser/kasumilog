":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2117247598658727936","indices":[141,164],"media_key":"3_2117247598658727936","media_results":{"result":{"media_key":"3_2117247598658727936"}},"media_url_https":"https://pbs.twimg.com/media/HWH5eSuaMAAorFR.jpg","original_info":{"focus_rects":[{"h":525,"w":937,"x":0,"y":182},{"h":728,"w":728,"x":33,"y":0},{"h":728,"w":639,"x":78,"y":0},{"h":728,"w":364,"x":215,"y":0},{"h":728,"w":937,"x":0,"y":0}],"height":728,"width":937},"sizes":{"large":{"h":728,"resize":"fit","w":937},"medium":{"h":728,"resize":"fit","w":937},"small":{"h":528,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/8ktqYmlOAJ"}]},"favorite_count":3945,"favorited":false,"full_text":"令和８年１１月２日（月）午前から午後にかけて、中国軍の偵察型無人機（ＷＺ－７）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、宮古島の南方沖から沖縄本島の南方沖にかけて飛行を行った後、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認し https://t.co/8ktqYmlOAJ","id_str":"2117247605726195979","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":37,"quoted_status_id_str":"2117242823535960246","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2117242823535960246","url":"https://t.co/SwyB89fx1q"},"reply_count":106,"retweet_count":960,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcyNDc2MDU2NzE2OTg0MzQ=","text":"令和８年１１月２日（月）午前から午後にかけて、中国軍の偵察型無人機（ＷＺ－７）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、宮古島の南方沖から沖縄本島の南方沖にかけて飛行を行った後、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nまた、同日午後、中国軍の偵察型無人機（ＷＺ－７）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、宮古島の南方沖から沖縄本島の南方沖にかけて飛行を行った後、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nこれらに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3294},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":361939,"following":32},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6420,"tweets":12467},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2117242823535960246"],"editable_until_msecs":"1793628600000","edits_remaining":"5","is_edit_eligible":true},"grok_ana