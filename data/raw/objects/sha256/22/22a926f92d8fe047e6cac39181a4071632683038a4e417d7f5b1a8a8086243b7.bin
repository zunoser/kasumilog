ymbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU3NzQzNjQ5MzEyNDQwMzI=","text":"10月29日、小泉防衛大臣は、第13回拡大ASEAN国防相会議（ADMMプラス）に出席し、参加各国の国防大臣などと、地域や国際社会における安全保障上の課題や防衛協力・交流などについて議論しました。小泉大臣からは、国際法に基づく自由で開かれた秩序を守り、対話を通じて問題を解決することや、全ての国が自らの意思で将来を選択できる地域を築くことの重要性を強調し、各国からも賛同が得られました。"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2115740767985737941"}},"rest_id":"2115774364985765889","unmention_data":{},"views":{"count":"142384","state":"EnabledWithCount"}}},"rest_id":"2117483288915071132","unmention_data":{},"views":{"count":"48191","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117483288915071132","sortIndex":"2117864651994693572"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saig