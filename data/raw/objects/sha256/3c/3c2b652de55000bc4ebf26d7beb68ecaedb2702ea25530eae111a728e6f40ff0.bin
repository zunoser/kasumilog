自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075016,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":607,"tweets":1918},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2116313815017304517"],"editable_until_msecs":"1793407107000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":70,"bookmarked":false,"conversation_id_str":"2116313815017304517","created_at":"Fri Oct 30 23:38:27 +0000 2026","display_text_range":[0,74],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/cOMxSbbudz","expanded_url":"https://x.com/takaichi_sanae/status/2116313815017304517/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2116313749774884864","indices":[75,98],"media_key":"3_2116313749774884864","media_results":{"result":{"media_key":"3_2116313749774884864"}},"media_url_https":"https://pbs.twimg.com/media/HV6oJIibYAAQqxy.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":181},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":6,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/cOMxSbbudz"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/cOMxSbbudz","expanded_url":"https://x.com/takaichi_sanae/status/2116313815017304517/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2116313749774884864","indices":[75,98],"media_key":"3_2116313749774884864","media_results":{"result":{"media_key":"3_2116313749774884864"}},"media_url_https":"https://pbs.twimg.com/media/HV6oJIibYAAQqxy.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":181},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":6,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/cOMxSbbudz"}]},"favorite_count":3374,"favorited":false,"full_text":"【日本列島を、強く豊かに。：島根編】\n\n本日は、『地域未来戦略』に基づき島根県が策定した、「特殊鋼を核とした地域産業クラスター計画」をご紹介します。 https://t.co/cOMxSbbudz","id_str":"2116313815017304517","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":47,"reply_count":378,"retweet_count":418,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[750,762],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTYzMTM4MTQ5NDU5NzYzMjA=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：島根編】\n\n本日は、『地域未来戦略』に基づき島根県が策定した、「特殊鋼を核とした地域産業クラスター計画」をご紹介します。\n\n島根県は、約1,400年前より伝わる製鉄方法である「たたら製鉄」が盛んに行われ、最盛期には日本の鉄生産量の約8割を生産する一大産地として栄えてきた歴史があります。\n\n現在も、たたら製鉄の流れを汲む特殊鋼メーカーが存在し、近隣には機械加工・材料試験等を行う関連企業が集積しており、幅広い分野で国内外からの受注を獲得しています。\n\n島根県は、今回、『地域未来戦略』の国の支援も活用し、今後も需要の増加が見込まれる航空機・エネルギー分野、高効率モーターに対応する特殊鋼の生産、加工等への官民投資を行い、こうした成長分野における国内随一の生産、加工、評価の拠点化を図る「産業クラスター」の形成を目指しています。\n\n成長分野の特殊鋼の需要増加に対応するために、投資や技術開発により地域内のサプライチェーンの強靱化を図るとともに、先端材料研究に強みを持つ大学・高専等と連携し、高度専門人材の育成を行い、県内就職につなげる好循環を創出することとしています。\n\n私自身、石原副知事から以下の意気込みを伺いました。\n\n「地域内には材料製造、機械加工、材料試験等の工程を担うサプライチェーンが形成されており、今回の計画は航空機向け素材の大幅な増産計画を地域に広く波及させることを主な目標としております。また、島根大学や県内企業等と連携した技術開発や人材育成を進めており、県としましても、引き続き、計画の実現に向けた支援を行ってまいります。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を全力で応援してまいります。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2116313815017304517","unmention_data":{},"views":{"count":"122355","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116313815017304517","sortIndex":"2116343372133171199"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_t