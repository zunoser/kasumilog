":"crop","w":150}},"type":"photo","url":"https://t.co/XBOixoKK7l"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/XBOixoKK7l","expanded_url":"https://x.com/takaichi_sanae/status/2106542987614527931/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2106542908849762304","indices":[123,146],"media_key":"3_2106542908849762304","media_results":{"result":{"media_key":"3_2106542908849762304"}},"media_url_https":"https://pbs.twimg.com/media/HTvxnVobsAAuYSt.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":0,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/XBOixoKK7l"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/XBOixoKK7l","expanded_url":"https://x.com/takaichi_sanae/status/2106542987614527931/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2106542908858048512","indices":[123,146],"media_key":"3_2106542908858048512","media_results":{"result":{"media_key":"3_2106542908858048512"}},"media_url_https":"https://pbs.twimg.com/media/HTvxnVqaIAADatF.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":1260,"y":0},{"h":2836,"w":2488,"x":1608,"y":0},{"h":2836,"w":1418,"x":2254,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/XBOixoKK7l"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/XBOixoKK7l","expanded_url":"https://x.com/takaichi_sanae/status/2106542987614527931/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":100,"w":100,"x":244,"y":952}]},"medium":{"faces":[{"h":58,"w":58,"x":142,"y":557}]},"orig":{"faces":[{"h":200,"w":200,"x":488,"y":1904}]},"small":{"faces":[{"h":33,"w":33,"x":81,"y":316}]}},"id_str":"2106542908841308160","indices":[123,146],"media_key":"3_2106542908841308160","media_results":{"result":{"media_key":"3_2106542908841308160"}},"media_url_https":"https://pbs.twimg.com/media/HTvxnVmasAAN8HZ.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":181},{"h":2836,"w":2836,"x":1260,"y":0},{"h":2836,"w":2488,"x":1608,"y":0},{"h":2836,"w":1418,"x":2254,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/XBOixoKK7l"}]},"favorite_count":21796,"favorited":false,"full_text":"中東情勢が不安定化する中、政府の目詰まり解消への取組の最新状況をお伝えします。\n\n原油については、調達先の多角化が進展しています。\n10月は、スエズ運河経由のタンカーが到着する目途が立っており、前年平月比で約10割の調達が実現できる見通しです。 https://t.co/XBOixoKK7l","id_str":"2106542987614527931","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":365,"reply_count":882,"retweet_count":3761,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDY1NDI5ODc1MzQ4MjM0MjQ=","richtext":{"richtext_tags":[]},"text":"中東情勢が不安定化する中、政府の目詰まり解消への取組の最新状況をお伝えします。\n\n原油については、調達先の多角化が進展しています。\n10月は、スエズ運河経由のタンカーが到着する目途が立っており、前年平月比で約10割の調達が実現できる見通しです。\nこのため、10月も国家備蓄放出の決定を行わないこととします。（資料1）\n今後も代替調達を進め、備蓄の放出を抑えながら、「日本全体として必要となる量」を確保していきます。\n\nナフサについても、国内での精製、代替調達、川中の製品調達が安定的に継続しており、川中在庫は平時の水準（2か月分）に回復しました。\nナフサ由来の化学製品の供給も安定的に推移しています。\n\n燃料油や化学製品の目詰まりの相談は劇的に減少しており、供給要請を頂いた案件は、最近要請頂いた案件を除き、対応を完了しました。\n追加のご相談や要請を頂きましたら、速やかに対応してまいります。（資料2）\n\n塗料・シンナーについては、6月に工務店をはじめとする最終需要家の皆様へのシンナー直接販売スキームを立ち上げましたが、この2か月間、追加の申し込みはありません。\n\n一人親方などからの「建設・住宅資材」の供給要請、自動車整備工場などからの「エンジンオイル」の供給要請についても、対応を完了しました。（資料3、資料4）\n\n国民の皆様の命に直結する医療分野においては、目詰まりが確認できた「115品目」の全てについて、目詰まりを解消しました。\n「医療用手袋」、「分包紙」、「薬剤容器」については、追加の相談を頂いた場合には、速やかにお届けできるようにしています。（資料5）\n\n包装資材や農業資材の不足にお悩みの「パン・菓子等販売店」や「園芸農家」についても、プッシュ型調査を進めた結果、把握した全ての目詰まりへの対応が完了しました。（資料6）\n\n引き続き、中東情勢の変化を注視しつつ、目詰まりなど国民の皆様の命や暮らしを支える分野でのお困りごとを、一件一件、着実に解消していきます。\n\n高市内閣は、「代替調達の促進」と「目詰まり」の解消を進め、国民の皆様の命と暮らし、そして経済活動に支障が生じないよう全力で取り組みます。"}}},"rest_id":"2106542987614527931","unmention_data":{},"views":{"count":"1463905","state":"EnabledWithCount"}}},"rest_id":"2116109026958491698","unmention_data":{},"views":{"count":"611449","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116109026958491698","sortIndex":"2116343372133171170"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075016,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":607,"tweets":1918},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2116107994635338080"],"editable_until_msecs":"1793358035000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":56,"bookmarked":false,"conversation_id_str":"2116107994635338080","created_at":"Fri Oct 30 10:00:35 +0000 2026","display_text_range":[0,141],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/xhPSoKFOjj","expanded_url":"https://x.com/takaichi_sanae/status/2116107994635338080/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2116107976759189506","indices":[142,165],"media_key":"3_2116107976759189506","media_results":{"result":{"media_key":"3_2116107976759189506"}},"media_url_https":"https://pbs.twimg.com/media/HV3s_kUaIAIb9e_.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1575,"w":1575,"x":1025,"y":0},{"h":1575,"w":1382,"x":1218,"y":0},{"h":1575,"w":788,"x":1619,"y":0},{"h":1575,"w":2600,"x":0,"y":0}],"height":1575,"width":2600},"sizes":{"large":{"h":1241,"resize":"fit","w":2048},"medium":{"h":727,"resize":"fit","w":1200},"small":{"h":412,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xhPSoKFOjj"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/xhPSoKFOjj","expanded_url":"https://x.com/takaichi_sanae/status/2116107994635338080/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":133,"w":133,"x":841,"y":273},{"h":173,"w":173,"x":519,"y":207}]},"medium":{"faces":[{"h":78,"w":78,"x":492,"y":160},{"h":101,"w":101,"x":304,"y":121}]},"orig":{"faces":[{"h":170,"w":170,"x":1068,"y":347},{"h":220,"w":220,"x":660,"y":264}]},"small":{"faces":[{"h":44,"w":44,"x":279,"y":90},{"h":57,"w":57,"x":172,"y":69}]}},"id_str":"2116107976809619456","indices":[142,165],"media_key":"3_2116107976809619456","media_results":{"result":{"media_key":"3_2116107976809619456"}},"media_url_https":"https://pbs.twimg.com/media/HV3s_kgboAAKDLQ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xhPSoKFOjj"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/xhPSoKFOjj","expanded_url":"https://x.com/takaichi_sanae/status/2116107994635338080/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2116107976759189506","indices":[142,165],"media_key":"3_2116107976759189506","media_results":{"result":{"media_key":"3_2116107976759189506"}},"media_url_https":"https://pbs.twimg.com/media/HV3s_kUaIAIb9e_.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1575,"w":1575,"x":1025,"y":0},{"h":1575,"w":1382,"x":1218,"y":0},{"h":1575,"w":788,"x":1619,"y":0},{"h":1575,"w":2600,"x":0,"y":0}],"height":1575,"width":2600},"sizes":{"large":{"h":1241,"resize":"fit","w":2048},"medium":{"h":727,"resize":"fit","w":1200},"small":{"h":412,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xhPSoKFOjj"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/xhPSoKFOjj","expanded_url":"https://x.com/takaichi_sanae/status/2116107994635338080/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":133,"w":133,"x":841,"y":273},{"h":173,"w":173,"x":519,"y":207}]},"medium":{"faces":[{"h":78,"w":78,"x":492,"y":160},{"h":101,"w":101,"x":304,"y":121}]},"orig":{"faces":[{"h":170,"w":170,"x":1068,"y":347},{"h":220,"w":220,"x":660,"y":264}]},"small":{"faces":[{"h":44,"w":44,"x":279,"y":90},{"h":57,"w":57,"x":172,"y":69}]}},"id_str":"2116107976809619456","indices":[142,165],"media_key":"3_2116107976809619456","media_results":{"result":{"media_key":"3_2116107976809619456"}},"media_url_https":"https://pbs.twimg.com/media/HV3s_kgboAAKDLQ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xhPSoKFOjj"}]},"favorite_count":5143,"favorited":false,"full_text":"本日、第8回「地域未来戦略関係副大臣等会議」に出席し、『地域未来戦略』に関する報告を受けました。\n\n会議では、14人の知事や市町村長の皆様から、各地域の特色を活かした大変意欲的な『地域産業クラスター計画』や『地場産業成長プラン』をご説明いただきました。\n誠にありがとうございました。 https://t.co/xhPSoKFOjj","id_str":"2116107994635338080","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":43,"reply_count":300,"retweet_count":567,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"cas.go.jp/jp/seisaku/chi…","expanded_url":"https://www.cas.go.jp/jp/seisaku/chiikimirai/kankei_fukudaijin/dai8/shiryo1_01.pdf","indices":[294,317],"url":"https://t.co/rv3j28t7VV"},{"display_url":"cas.go.jp/jp/seisaku/chi…","expanded_url":"https://www.cas.go.jp/jp/seisaku/chiikimirai/kankei_fukudaijin/dai8/shiryo1_02.pdf","indices":[318,341],"url":"https://t.co/UprRk8kcIK"},{"display_url":"cas.go.jp/jp/seisaku/chi…","expanded_url":"https://www.cas.go.jp/jp/seisaku/chiikimirai/kankei_fukudaijin/dai8/shiryo1_03.pdf","indices":[342,365],"url":"https://t.co/rqhYNXb21D"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTYxMDc5OTQ0NTA3ODgzNTI=","richtext":{"richtext_tags":[]},"text":"本日、第8回「地域未来戦略関係副大臣等会議」に出席し、『地域未来戦略』に関する報告を受けました。\n\n会議では、14人の知事や市町村長の皆様から、各地域の特色を活かした大変意欲的な『地域産業クラスター計画』や『地場産業成長プラン』をご説明いただきました。\n誠にありがとうございました。\n\n※今回ご説明いただいた、秋田県・福島県・群馬県・埼玉県・愛知県・兵庫県・和歌山県・沖縄県の『地域産業クラスター計画』、山梨県甲州市・岐阜県美濃加茂市・三重県四日市市・京都府・奈良県明日香村・高知県本山町の『地場産業成長プラン』や、これまでの会議で報告済みの自治体の2件目以降の計画の概要はこちらです。\nhttps://t.co/rv3j28t7VV\nhttps://t.co/UprRk8kcIK\nhttps://t.co/rqhYNXb21D\n\n医療・バイオ、次世代モビリティ、航空宇宙・ドローンをはじめとする「成長分野」から、農林業、伝統工芸品産業など、「地域に根差した産業」まで、全国各地で、それぞれの強みを活かした具体的な計画が着実に形になってきています。\n\n今回で、『地域産業クラスター計画』を中心に、合計100を超える計画が、策定・公表されます。\n\n今後は、「市町村による計画策定」についても、一層推進していきます。\n\n多くの自治体の皆様が『地場産業成長プラン』を策定できるよう、総務省、都道府県との連携強化に加えて、関係省庁や地方支分部局も巻き込んだ市町村への「伴走支援体制」を強化していきます。\n\nあわせて、「商工会・商工会議所による経営指導」を含め、市町村が策定する計画の下で関係企業を「伴走支援」する体制を強化するための支援の在り方についても、検討していきます。\n\n政府の側でも、『地域未来戦略』の推進体制を強化するため、関係各省庁の局長等からなる「地域未来戦略推進担当官」を9名発令し、本日の会議にも参加しました。\n\n「推進担当官」は、年末までに策定する『地域未来戦略実現フレーム』の「分野ごと」の責任者です。\nそれぞれの「担当分野」について、全力でその職にあたり、「自治体からの具体的なニーズ」に応えるとともに、『実現フレーム』の策定作業を加速してもらいます。\n\n今も、日本全国の自治体で、計画策定が進められていると承知しています。\n今後、更なるお話を伺えることを、楽しみにしています。"}}},"rest_id":"2116107994635338080","unmention_data":{},"views":{"count":"158805","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116107994635338080","sortIndex":"2116343372133171169"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2114091754773434368/fMOv1MMC?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.fsa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2114091754773434368/fMOv1MMC?format=png&name=420x420_2","width":400},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2114091754773434368/fMOv1MMC?format=png&name=orig","width":401},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"276848601","path":[]}}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2114091754773434368/fMOv1MMC?format=png&name=100x100_2","width":100},"type":"IMAGE