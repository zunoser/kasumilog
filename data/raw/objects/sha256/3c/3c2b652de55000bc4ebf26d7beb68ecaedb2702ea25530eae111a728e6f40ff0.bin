48348","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":0,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/10/…","expanded_url":"https://www.meti.go.jp/press/2026/10/20261030001.html","indices":[258,281],"url":"https://t.co/lLSYSoa4SY"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTYxMzY0MDEzMTg0MDAwMDE=","richtext":{"richtext_tags":[]},"text":"／\n欧州最大級の水素イベントに\n日本が本年のカントリーパートナーとして参加\n＼\nベルギー王国・ブリュッセルで開催された「European Hydrogen Week 2026」に、日本が、本年のカントリーパートナーとして参加しました。B2Bフォーラムやジャパンパビリオンでの展示等を通じ、日本の水素技術・政策を発信するとともに、欧州をはじめとする各国・地域との政策対話や官民交流を深め、国際的な水素・アンモニアのサプライチェーン構築に向けた日本企業と海外企業・関係機関との連携を後押ししました。\n👇詳細はこちらから\nhttps://t.co/lLSYSoa4SY"}}},"rest_id":"2116136401452548348","unmention_data":{},"views":{"count":"4883","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116136401452548348","sortIndex":"2116343372133171184"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京