Pi.jpg","original_info":{"focus_rects":[{"h":642,"w":1147,"x":0,"y":759},{"h":1147,"w":1147,"x":0,"y":453},{"h":1308,"w":1147,"x":0,"y":292},{"h":1600,"w":800,"x":0,"y":0},{"h":1600,"w":1147,"x":0,"y":0}],"height":1600,"width":1147},"sizes":{"large":{"h":1600,"resize":"fit","w":1147},"medium":{"h":1200,"resize":"fit","w":860},"small":{"h":680,"resize":"fit","w":487},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/cjTFiQix0m"}]},"favorite_count":1053,"favorited":false,"full_text":"赤松健政務官のマンガ連載開始📚\n「アンドロイドでマイナカード！」編\n\n元漫画家の赤松政務官による描きおろし『デジ庁にっき』を公開しました✨\n画像をタップしてご覧ください↓ https://t.co/cjTFiQix0m","id_str":"2116077648870867319","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":40,"reply_count":14,"retweet_count":427,"retweeted":false,"user_id_str":"1312820383532294144"},"rest_id":"2116077648870867319","unmention_data":{},"views":{"count":"44846","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116077648870867319","sortIndex":"2116343372133171143"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1595652744500908032/vw4r2sfI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/242156036/1412822664"},"core":{"created_at":"Mon Jan 24 02:43:14 +0000 2011","name":"文部科学省　MEXT","screen_name":"mextjapan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDIxNTYwMzY=","is_blue_verified"