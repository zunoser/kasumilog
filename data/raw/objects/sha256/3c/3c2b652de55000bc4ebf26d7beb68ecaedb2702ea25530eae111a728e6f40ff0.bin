xt_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2116108610443116545","indices":[115,138],"media_key":"3_2116108610443116545","media_results":{"result":{"media_key":"3_2116108610443116545"}},"media_url_https":"https://pbs.twimg.com/media/HV3tkc-bgAEgDGP.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":0,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KhjeGpPP4j"}]},"favorite_count":10908,"favorited":false,"full_text":"10月上旬に引き続き、中東情勢を受けた政府の目詰まり解消への取組の最新状況をお伝えします。\n\n原油については、ホルムズ海峡を経由しない調達先の多角化が進展しています。\n11月も、前年平月比で約10割の調達が実現できる見通しです。 https://t.co/KhjeGpPP4j","id_str":"2116109026958491698","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":117,"quoted_status_id_str":"2106542987614527931","quoted_status_permalink":{"display":"x.com/takaichi_sanae…","expanded":"https://x.com/takaichi_sanae/status/2106542987614527931?a=mdT6MWni6gQqBKnLp34&s=20","url":"https://t.co/mu2kEBx1Qk"},"reply_count":667,"retweet_count":1716,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"x.com/takaichi_sanae…","expanded_url":"https://x.com/takaichi_sanae/status/2106542987614527931?a=mdT6MWni6gQqBKnLp34&s=20","indices":[840,863],"url":"https://t.co/mu2kEBx1Qk"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTYxMDkwMjY3OTA2NDk4NTY=","richtext":{"richtext_tags":[]},"text":"10月上旬に引き続き、中東情勢を受けた政府の目詰まり解消への取組の最新状況をお伝えします。\n\n原油については、ホルムズ海峡を経由しない調達先の多角化が進展しています。\n11月も、前年平月比で約10割の調達が実現できる見通しです。\nこのため、11月も国家備蓄放出の決定を行わないこととします。（資料1）\n今後も代替調達を進め、備蓄の放出を抑えながら、「日本全体として必要となる量」を確保していきます。\n\n灯油については、需要が増加する冬季に向けて、灯油の卸売事業者や医療・農業分野など最終需要家の皆様への「直接販売スキーム」を10月16日に開始しました。\n現在、8件の相談に対応中ですが、直接販売が必要な案件は寄せられていません。（資料2）\nなお、「輸入灯油」については、輸入価格と国内卸価格の差額を補助する制度を、灯油の需要期である11月から導入し、灯油の供給に支障が生じないよう、万全を期していきます。\n\nまた、「燃料油」や「化学製品」、「医療用手袋」や「分包紙」を含む医療分野、「建設・住宅資材」、「エンジンオイル」、「農業資材」、食品用の「包装資材」についても、10月に新たにお寄せ頂いたお困りごとについてのご相談を除き、目詰まりの対応を完了しました。（資料3～資料7）\n\n引き続き、中東情勢の変化を注視しつつ、目詰まりなど国民の皆様の命や暮らしを支える分野でのお困りごとを、一件一件、着実に解消していきます。\n\n高市内閣は、「代替調達の促進」と「目詰まり」の解消を進め、国民の皆様の命と暮らし、そして経済活動に支障が生じないよう全力で取り組みます。\n\n資料 1　我が国の原油調達の動向\n資料 2　灯油の流通円滑化対策の強化施策（灯油直販スキーム等）\n資料 3　相談件数の推移\n資料 4　医療分野の影響・対応\n資料 5　建設・住宅資材の供給要請件数\n資料 6　自動車整備、バス、トラック、タクシー事業の供給要請件数\n資料 7　農林水産業・食品産業に関する「目詰まり対策」\n\nhttps://t.co/mu2kEBx1Qk"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_