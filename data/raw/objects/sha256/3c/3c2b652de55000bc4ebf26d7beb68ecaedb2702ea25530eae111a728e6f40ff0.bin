116242471411995012","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":13,"reply_count":4,"retweet_count":78,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/erp/rss/…","expanded_url":"https://www.mofa.go.jp/mofaj/erp/rss/pageit_000001_03286.html","indices":[260,283],"url":"https://t.co/uoHYQwPco0"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTYyNDI0NzEyODYwOTk5Njg=","richtext":{"richtext_tags":[]},"text":"米国・アトランタを訪問中の茂木外務大臣は、ラヴロフ・セルゲイ・ヴィクトロヴィチ・ロシア外務大臣と会談を行いました。\n茂木大臣から、現下の日露間の諸問題等に関し、日本政府の立場に基づいて、申入れや主張を行いました。サハリン州における邦人拘束の件については、茂木大臣から、即時解放を強く求めました。\n国際情勢については、茂木大臣から、ウクライナにおける公正かつ永続的な平和の実現のため、ロシアが前向きな対応をとることを改めて強く求めました。\n両大臣は、日露関係が厳しい状況にある中でも、意思疎通をしていくこととしました。\n\nhttps://t.co/uoHYQwPco0"}}},"rest_id":"2116242471411995012","unmention_data":{},"views":{"count":"17512","state":"EnabledWithCount"}}}}},"entryId":"tweet-2116242471411995012","sortIndex":"2116343372133171192"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2116343372133171209-tweet-2116147484431122773","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072169437722296320/8bWktzdb_normal.jpg"},"