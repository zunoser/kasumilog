e},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":383633,"following":478},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"571429134","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7976,"tweets":88401},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/yYaoVyKjKO"}}}},"edit_control":{"edit_tweet_ids":["2100419488785035470"],"editable_until_msecs":"1789617604000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2100419488785035470","created_at":"Thu Sep 17 03:00:04 +0000 2026","display_text_range":[0,135],"entities":{"hashtags":[{"indices":[16,23],"text":"匠のモノサシ"}]},"favorite_count":21,"favorited":false,"full_text":"╋━━━━━━━\n\n　TV番組『#匠のモノサシ』📏\n\n　　　　　　　━━━━━━━╋\n\n◤\n　 今日の数字は…1万5000本！\n　　　　　　　　　　　　　　◢\n💡ヒント\n木造建築を造るときに、作業効率を劇的にアップさせた工具！\n\n見えない場所に多くの○〇が隠れている！？","id_str":"2100419488785035470","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":2,"retweet_count":6,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[16,23],"text":"匠のモノサシ"},{"indices":[399,410],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"ntv.co.jp/takuminomonosa…","expanded_url":"https://www.ntv.co.jp/takuminomonosashi/","indices":[277,300],"url":"https://t.co/GJJMYZnfXU"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[374,397],"url":"https://t.co/kPJLLRPaZ9"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA0MTk0ODg2ODg1OTQ5NDQ=","text":"╋━━━━━━━\n\n　TV番組『#匠のモノサシ』📏\n\n　　　　　　　━━━━━━━╋\n\n◤\n　 今日の数字は…1万5000本！\n　　　　　　　　　　　　　　◢\n💡ヒント\n木造建築を造るときに、作業効率を劇的にアップさせた工具！\n\n見えない場所に多くの○〇が隠れている！？\n\n建物によって常に新しいことができる\n『大工』の魅力と凄腕の職人技に迫ります！\n\n─────────────────\n\n📺放送局　日本テレビ(関東ローカル)\n🗓️日時　　9月17日(木) 　22時54分～\n\n─────────────────\n\n「匠のモノサシ」公式WEBサイト👇\nhttps://t.co/GJJMYZnfXU\n\n国土交通省は「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、本番組に提供しています。\n詳しくはこちら：https://t.co/kPJLLRPaZ9\n\n#MLIT建設産業PR"}}},"rest_id":"2100419488785035470","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"4387","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100419488785035470","sortIndex":"2100490110813339615"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":99},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/530187236663250944/sN73nkH6_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Thu Nov 06 01:42:29 +0000 2014","name":"警察庁","screen_name":"NPA_KOHO"},"dm_permissions":{"can_dm":true},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODkxNTE2ODA5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2-1-2"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2093262311511494959"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"警察庁公式アカウントです。\n\n発信する情報は「報道発表資料」「新着情報」を基本としています。当アカウントは発信専用のため警察庁からの返信等は行っておりません。ご利用にあたっては「警察庁X（旧：Twitter）運用ポリシー」https://t.co/i1GUZVK3RZをご覧ください。","entities":{"description":{"urls":[{"display_url":"npa.go.jp/twitter/policy…","expanded_url":"https://www.npa.go.jp/twitter/policy.html","indices":[111,134],"url":"https://t.co/i1GUZVK3RZ"}]},"url":{"urls":[{"display_url":"npa.go.jp","expanded_url":"http://www.npa.go.jp/","indices":[0,23],"url":"https://t.co/nXofBu7sEB"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":320560,"following":3},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2891516809","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1868,"tweets":5922},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/nXofBu7sEB"}}}},"edit_control":{"edit_tweet_ids":["2100419481877045261"],"editable_until_msecs":"1789617603000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":14,"bookmarked":false,"conversation_id_str":"2100419481877045261","created_at":"Thu Sep 17 03:00:03 +0000 2026","display_text_range":[0,145],"entities":{"media":[{"display_url":"pic.x.com/Y37L8GZZtm","expanded_url"