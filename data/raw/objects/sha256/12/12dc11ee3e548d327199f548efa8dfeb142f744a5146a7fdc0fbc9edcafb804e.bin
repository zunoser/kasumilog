"}]},"favorite_count":123,"favorited":false,"full_text":"11月19日、小泉防衛大臣とインドのシン国防大臣は、本年8月と10月に引き続き、短期間で3回目となる日印防衛相会談を実施しました。 https://t.co/n47lkE6gX7","id_str":"2123390707998380170","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":1,"retweet_count":11,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjMzOTA3MDc5NDM4NDU4ODg=","text":"11月19日、小泉防衛大臣とインドのシン国防大臣は、本年8月と10月に引き続き、短期間で3回目となる日印防衛相会談を実施しました。\n\n両大臣は、具体的な協力を着実に実施し、日印防衛協力を更なる高みへと引き上げることで、インド太平洋地域の平和、安定及び繁栄に貢献していくとの決意を共有しました。"}}},"rest_id":"2123390707998380170","unmention_data":{},"views":{"count":"15598","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123390707998380170","sortIndex":"2123402108202909692"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":52},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1697575938316529664/Iob6ICh3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/331514169/1655191913"},"core":{"created_at":"Fri Jul 08 08:59:28 +0000 2011","name":"財務省","screen_name":"MOF_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMzE1MTQxNjk=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関3-1-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled