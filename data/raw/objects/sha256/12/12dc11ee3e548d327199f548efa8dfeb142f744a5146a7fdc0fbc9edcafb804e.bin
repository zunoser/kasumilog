":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2110914955910475776","indices":[20,43],"media_key":"3_2110914955910475776","media_results":{"result":{"media_key":"3_2110914955910475776"}},"media_url_https":"https://pbs.twimg.com/media/HUt59-IacAAOYnr.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":54},{"h":800,"w":800,"x":0,"y":0},{"h":800,"w":702,"x":0,"y":0},{"h":800,"w":400,"x":0,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/csM41vfAen"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/csM41vfAen","expanded_url":"https://x.com/MLIT_JAPAN/status/2123249914582847585/photo/1","ext_alt_text":"※本画像の内容は、生成AIにより作成・加工されています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2110914955910475776","indices":[20,43],"media_key":"3_2110914955910475776","media_results":{"result":{"media_key":"3_2110914955910475776"}},"media_url_https":"https://pbs.twimg.com/media/HUt59-IacAAOYnr.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":54},{"h":800,"w":800,"x":0,"y":0},{"h":800,"w":702,"x":0,"y":0},{"h":800,"w":400,"x":0,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/csM41vfAen"}]},"favorite_count":26,"favorited":false,"full_text":"【あなたの行動が物流を支える｜第7回】 https://t.co/csM41vfAen","id_str":"2123249914582847585","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":9,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[907,917],"text":"あなたが支える物流"},{"indices":[918,929],"text":"トラック・物流Gメン"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjMyNDk5MTQxOTI3NzcyMTc=","text":"【あなたの行動が物流を支える｜第7回】\n\n使い終えた椅子や家具などの粗大ごみは、回収場所に出したら終わりではありません。形や大きさを保ったまま回収できる車両に積み込まれ、処理施設まで運ばれます。粗大ごみの回収には、一般的な燃えるごみを圧縮して集める車両とは異なり、家具などを安全に積載できる平ボディトラックや荷台付きトラックなどが使われる場合があります。\n\n処理施設へ運ばれた粗大ごみは、状態や材質に応じて分解・選別されます。例えば椅子であれば、木材、金属、布や樹脂などに分けられ、再び利用できる素材は、新しい製品をつくるための材料として活用されます。\n\nリサイクルというと、分別や再生加工に注目しがちですが、その前後には必ず「運ぶ」工程があります。家庭や回収場所から処理施設まで運ぶこと、選別した素材を次の工程へ移すこと。資源を循環させるためには、さまざまな場所をつなぐ物流の力が欠かせません。\n\n一方で、粗大ごみの出し方や回収方法は地域によって異なります。決められた申込み方法、回収日時、指定場所などを確認し、ルールに沿って出すことが、安全で円滑な回収につながります。通行の妨げになる場所へ置いたり、指定されていない日時に出したりしないことも大切です。\n\n使い終えたモノを適切に手放し、再び資源として活用する。その循環を、回収と運搬を担う物流が支えています。リサイクルの裏側にある物流にも目を向けてみませんか。\n\n粗大ごみは大きさや形がさまざまで、積込みや荷下ろしにも配慮が必要です。家具を荷台へ安全に載せ、走行中に動かないよう固定し、処理施設まで運ぶことも回収物流の重要な仕事です。一般的な袋ごみとは異なり、圧縮せず形を保ったまま運ぶ場合があるため、回収対象に合った車両と作業が必要になります。\n\n粗大ごみに出す前に、修理して使えないか、必要とする人へ譲れないかを検討することも一つの方法です。手放す場合には地域のルールに従い、適切な回収につなげる。モノを長く使うことと、使い終えた後に資源として循環させることの両方が、持続可能な社会を支えます。\n※本画像の内容は、生成AIにより作成・加工されています。\n\n#あなたが支える物流\n#トラック・物流Gメン"}}},"rest_id":"2123249914582847585","unmention_data":{},"views":{"count":"4703","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123249914582847585","sortIndex":"2123402108202909617"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":