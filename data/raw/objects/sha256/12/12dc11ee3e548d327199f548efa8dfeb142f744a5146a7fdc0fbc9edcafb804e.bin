NCx","id_str":"2123361307315614111","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":3,"retweet_count":27,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04491.html","indices":[311,334],"url":"https://t.co/8fs6bYm07f"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjMzNjEzMDcxOTgxMDM1NTI=","richtext":{"richtext_tags":[]},"text":"茂木外務大臣は、小泉防衛大臣と共に、スブラマニヤム・ジャイシャンカル・インド外務大臣（H.E. Dr. Subrahmanyam Jaishankar, External Affairs Minister of India）及びラージナート・シン・インド国防大臣（H.E. Mr.  Rajnath Singh, Defence Minister of India）との間で、第4回日印外務・防衛閣僚会合（「2＋2」）を実施し、共同声明を発出しました。4大臣は、自由で開かれたインド太平洋（FOIP）の実現に向けた協力、安全保障・防衛協力、地域・国際情勢等について議論し、引き続き緊密に連携していくことで一致しました。\n\nhttps://t.co/8fs6bYm07f"}}},"rest_id":"2123361307315614111","unmention_data":{},"views":{"count":"8438","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123361307315614111","sortIndex":"2123402108202909677"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":609},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1432867630298419206/Uez_q2Zx_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1312820383532294144/1679630740"},"core":{"created_at":"Sun Oct 04 18:22:33 +0000 2020","name":"デジタル庁","screen_name":"digital_jpn"},"d