e,"quote_count":39,"reply_count":28,"retweet_count":490,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjMzNTg5NjczNjM3NzY1MTI=","richtext":{"richtext_tags":[]},"text":"令和８年１１月１９日（木）午前から午後にかけて、ロシアの爆撃機（Ｔｕ－９５）×２機が、太平洋から飛来し、与那国島と台湾との間を通過した後、対馬海峡を通過し大陸方面へ飛行したことを確認した。\n　また、同日午前から午後にかけて、ロシアの哨戒機（Ｔｕ－１４２）×２機が、日本海から飛来し、対馬海峡を通過した後、東シナ海上で上記のロシア爆撃機と合流し、再び対馬海峡を通過し大陸方面へ飛行したことを確認した。\n　これに対し、航空自衛隊の南西航空方面隊等の戦闘機を緊急発進させ対応した。"}}},"rest_id":"2123358967422505441","unmention_data":{},"views":{"count":"117938","state":"EnabledWithCount"}}},"rest_id":"2123361637231190423","unmention_data":{},"views":{"count":"70685","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123361637231190423","sortIndex":"2123402108202909678"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label