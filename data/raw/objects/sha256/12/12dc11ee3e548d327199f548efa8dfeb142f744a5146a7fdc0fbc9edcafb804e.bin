0,"x":0,"y":0}],"height":2160,"width":1920},"sizes":{"large":{"h":2048,"resize":"fit","w":1820},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HC9Cu5NZqp"}]},"favorite_count":11,"favorited":false,"full_text":"|◤   　    🎥 YouTube配信中\n 　　　#放課後ゲンバミッション！   　◢|\n\n🚁 災害から街を守るために、ドローンが活躍！？\n河川敷の安全を支える最新技術に中高生リポーターが潜入！\n▶️https://t.co/Rh2naGZK3F https://t.co/HC9Cu5NZqp","id_str":"2123310304406786352","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":2,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[27,39],"text":"放課後ゲンバミッション"},{"indices":[414,424],"text":"国交省建設産業PR"},{"indices":[425,436],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/MiQe4dNbEco","expanded_url":"https://youtu.be/MiQe4dNbEco","indices":[102,125],"url":"https://t.co/OM6a26Y4Mg"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[373,396],"url":"https://t.co/kPJLLRPaZ9"}],"user_mentions":[{"id_str":"2100746664126648320","indices":[398,413],"name":"放課後ゲンバミッション","screen_name":"houkago_gennmi"}]},"id":"Tm90ZVR3ZWV0OjIxMjMzMTAzMDQyNzY3MDExODQ=","text":"|◤   　    🎥 YouTube配信中\n 　　　#放課後ゲンバミッション！   　◢|\n\n🚁 災害から街を守るために、ドローンが活躍！？\n河川敷の安全を支える最新技術に中高生リポーターが潜入！\n▶️https://t.co/OM6a26Y4Mg\n\n今回は、ドローンを使って河川敷を測量するゲンバへ！普段なかなか触れることのないドローンの操縦に挑戦！\n\nドローンによる測量は、地形の起伏や高低差をデータ化し、河川敷の維持管理を支え、台風や大雨などの災害から街を守ることにつながっているよ✨\n\n最新技術で、街を災害から守る建設業の仕事。\nその意外な魅力をぜひ動画でチェックしてみてください👀\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPaZ9\n\n@houkago_gennmi\n#国交省建設産業PR\n#MLIT建設産業PR"}}},"rest_id":"2123310304406786352","unmention_data":{},"views":{"count":"3630","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123310304406786352","sortIndex":"2123402108202909648"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","prof