,"url":"https://t.co/L0ZPRe7yc2"}]},"favorite_count":34,"favorited":false,"full_text":"中国の深圳を訪問中の高市総理大臣は、APEC首脳会議に参加し、ルールに基づく国際経済秩序を強化すべく自由で公正な貿易・投資の推進、信頼性のある自由なデータ流通、安全・安心で信頼できるAI環境整備を訴えました。アジアの経済・エネルギー強靱化の観点から「AZEC2.0」及び中東湾岸産油国との連携 https://t.co/L0ZPRe7yc2","id_str":"2123392801194881333","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":10,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/ecm/apec…","expanded_url":"https://www.mofa.go.jp/mofaj/ecm/apec/pageit_000001_03339.html","indices":[183,206],"url":"https://t.co/Vquq2tGINf"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjMzOTI4MDEwNjQ4MzcxMjE=","richtext":{"richtext_tags":[]},"text":"中国の深圳を訪問中の高市総理大臣は、APEC首脳会議に参加し、ルールに基づく国際経済秩序を強化すべく自由で公正な貿易・投資の推進、信頼性のある自由なデータ流通、安全・安心で信頼できるAI環境整備を訴えました。アジアの経済・エネルギー強靱化の観点から「AZEC2.0」及び中東湾岸産油国との連携を強化する「パワー・ガルフ」も提唱しました。\n（写真提供：内閣広報室）\n\nhttps://t.co/Vquq2tGINf"}}},"rest_id":"2123392801194881333","unmention_data":{},"views":{"count":"3195","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123392801194881333","sortIndex":"2123402108202909694"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2123362515606446080/yS_XGG5y?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_