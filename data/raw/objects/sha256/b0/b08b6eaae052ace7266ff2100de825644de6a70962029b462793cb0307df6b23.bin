e_count":99,"favorited":false,"full_text":"本日、天皇皇后両陛下ご臨席のもと、厚生労働省などが主催する「よさこい高知文化祭2026」（第26回全国障害者芸術・文化祭）の開会式が高知市で行われ、上野大臣も出席いたしました。\n\n障害のある方々による芸術文化活動の魅力を全国に発信し、その振興に取り組みます。\n\nhttps://t.co/4WgUCr4V4v https://t.co/sdk4BZMMOe","id_str":"2114273194551206024","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":17,"retweet_count":23,"retweeted":false,"user_id_str":"180585090"},"rest_id":"2114273194551206024","unmention_data":{},"views":{"count":"24901","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114273194551206024","sortIndex":"2114601617549426633"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/EFc4qgZYl6"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"description":{},"url":{"urls":[{"displ