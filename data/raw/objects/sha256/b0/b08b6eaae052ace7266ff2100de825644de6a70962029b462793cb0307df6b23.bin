"faces":[{"h":67,"w":67,"x":63,"y":633}]},"orig":{"faces":[{"h":232,"w":232,"x":216,"y":2164}]},"small":{"faces":[{"h":38,"w":38,"x":35,"y":359}]}},"id_str":"2113793061365112833","indices":[80,103],"media_key":"3_2113793061365112833","media_results":{"result":{"media_key":"3_2113793061365112833"}},"media_url_https":"https://pbs.twimg.com/media/HVWzlwdaYAE-29e.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":3072,"w":3072,"x":0,"y":0},{"h":3072,"w":2695,"x":0,"y":0},{"h":3072,"w":1536,"x":0,"y":0},{"h":3072,"w":4096,"x":0,"y":0}],"height":3072,"width":4096},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GgIFf8CpTK"}]},"favorite_count":13098,"favorited":false,"full_text":"【日本列島を、強く豊かに。：三重編】\n\n本日は、『地域未来戦略』に基づき三重県が策定した、「半導体関連産業分野における地域産業クラスター計画」をご紹介します。 https://t.co/GgIFf8CpTK","id_str":"2113793180256899337","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":258,"reply_count":1371,"retweet_count":1619,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[858,870],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM3OTMxODAxNzI5NDMzNjA=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：三重編】\n\n本日は、『地域未来戦略』に基づき三重県が策定した、「半導体関連産業分野における地域産業クラスター計画」をご紹介します。\n\n半導体は、DX（デジタルトランスフォーメーション）やGX（グリーントランスフォーメーション）の実現や経済安全保障の強化に繋がる、『日本成長戦略』の要となる戦略分野であり、他の分野の「成長投資」や「危機管理投資」を支える基盤です。\n\n三重県は、中部圏や近畿圏といった大都市への近さや、安定した工業用水の供給といった立地条件の良さなどを背景に、世界最大級のフラッシュメモリ工場をはじめ、ロジック半導体やパワー半導体、さらには、半導体の原材料、部素材、製造装置、保守メンテナンスなどに強みを持つ企業約100社が集積する、全国有数の半導体製造拠点です。\n\nまた、四日市コンビナートの化学企業を中心に、先端半導体向けの部素材の研究開発施設を持つ工場が多数立地しています。\n\n三重県は、こうした強みを活かし、『地域未来戦略』の国の支援も活用し、半導体関連設備、教育設備などへの官民投資を行うとともに、大規模産業用地の確保、企業の操業環境向上に必要なインフラ整備に取り組み、半導体関連産業の更なる発展を図る「産業クラスター」を形成することを目指しています。\n\n核となる企業による設備投資を促すとともに、県内の産学官が連携した人材育成環境の構築、人材確保や販路拡大など企業が操業しやすい体制を構築することで、県内での再投資や県外からの新規立地を促進し、更なる半導体関連産業の集積を図っていく野心的な内容になっています。\n\n私自身、一見知事から以下の意気込みを伺いました。\n\n「三重県には 100 社を超える半導体企業があります。三重県全県を挙げて、日本の成長に協力をさせていただくように、地域産業クラスターを計画していきたいと思っています。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を全力で応援してまいります。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2113793180256899337","unmention_data":{},"views":{"count":"581467","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113793180256899337","sortIndex":"2114601617549426618"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=png&name=2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":75.17,"rgb":{"blue":255,"green":255,"red":255}},{"percentage":14.68,"rgb":{"blue":160,"green":0,"red":0}},{"percentage":6.18,"rgb":{"blue":4,"green":4,"red":4}},{"percentage":2.24,"rgb":{"blue":196,"green":119,"red":120}},{"percentage":0.44,"rgb":{"blue":208,"green":154,"red":153}}]},"type":"IMAGE_COLOR"}},{"key":"title","value":{"string_value":"第13回「富士山会合」に際する高市内閣総理大臣のビデオメッセージの発出","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/jVvjMA1XLA","type":"STRING"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary","url":"https://t.co/jVvjMA1XLA","user_refs_results":[]},"rest_id":"https://t.co/jVvjMA1XLA"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2112845618712609268"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mof