ium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/apDR7FDsfq"}]},"favorite_count":1508,"favorited":false,"full_text":"10月24日、小泉防衛大臣と小田原防衛副大臣は、海上自衛隊遠洋練習航海部隊の帰国行事に出席しました。小泉大臣は、約5か月間にわたる練習航海を終えて帰国した隊員に対し訓示を行いました。 https://t.co/apDR7FDsfq","id_str":"2113863076017848611","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":10,"quoted_status_id_str":"2056545448517939581","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2056545448517939581","url":"https://t.co/kFqvaTYtSB"},"reply_count":20,"retweet_count":222,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM4NjMwNzU5NTA2NTM0NDA=","text":"10月24日、小泉防衛大臣と小田原防衛副大臣は、海上自衛隊遠洋練習航海部隊の帰国行事に出席しました。小泉大臣は、約5か月間にわたる練習航海を終えて帰国した隊員に対し訓示を行いました。\n\n今年3月に幹部候補生学校を卒業した若手幹部（実習幹部）たちは、北米を中心とした5か国・11寄港地を巡る遠洋練習航海を通じて、幹部自衛官として必要な知識・技能を修得するとともに、国際感覚を学び、無事帰国しました🌎⚓"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2056545448517939581"}},"rest_id":"2113863076017848611","unmention_data":{},"views":{"count":"136552","state":"EnabledWithCount"}}},"rest_id":"2113972983199076859","unmention_data":{},"views":{"count":"199728","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113972983199076859","sortIndex":"2114601617549426627"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"res