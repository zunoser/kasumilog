ble":true,"quote_count":3,"reply_count":16,"retweet_count":174,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwNTY1NDU0NDg0Njc1MzM4MjU=","text":"5月16日、海上自衛隊横須賀地区で遠洋練習航海部隊の出国行事が執り行われました。\n\n行事には宮﨑防衛副大臣と吉田防衛大臣政務官が出席し、宮﨑防衛副大臣は練習航海に出発する隊員に対し訓示を行いました。\n\n今年3月に幹部候補生学校を卒業した実習幹部たちは、式典終了後、約5か月間に渡る練習航海に出発しました。今年度は北米を中心とした5か国、11寄港地を巡り、航海を通じて、幹部自衛官として必要な資質を育みます🌎⚓"}}},"rest_id":"2056545448517939581","unmention_data":{},"views":{"count":"89150","state":"EnabledWithCount"}}},"rest_id":"2113863076017848611","unmention_data":{},"views":{"count":"136552","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113863076017848611","sortIndex":"2114601617549426624"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3069596,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":596,"tweets":1900},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2113828956927623383"],"editable_until_msecs":"1792814671000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":69,"bookmarked":false,"conversation_id_str":"2113828956927623383","created_at":"Sat Oct 24 03:04:31 +0000 2026","display_text_range":[0,104],"entities":{},"favorite_count":8997,"favorited":false,"full_text":"本日、「第5回アジアパラ競技大会（2026/愛知・名古屋）」が閉幕します。\n\n今大会は、初めての日本での開催となり、「TEAM JAPAN」の皆様は、各競技において、素晴らしいパフォーマンスを発揮されました。","id_str":"2113828956927623383","is_quote_status":false,"lang":"ja","quote_count":80,"reply_count":1047,"retweet_count":820,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM4Mjg5NTY4NjA0OTM4MjQ=","richtext":{"richtext_tags":[]},"text":"本日、「第5回アジアパラ競技大会（2026/愛知・名古屋）」が閉幕します。\n\n今大会は、初めての日本での開催となり、「TEAM JAPAN」の皆様は、各競技において、素晴らしいパフォーマンスを発揮されました。\n\n選手の皆様が、この大舞台でも失敗を恐れず、自らを信じ、持てる力を最大限発揮される姿、仲間と助け合いながら、最後まで諦めずに勝利を目指す姿、ライバルと競い合い、お互いの健闘をたたえ合う姿は、「パラスポーツ」の素晴らしさを改めて私たちに感じさせてくれました。\n\n日本中に多くの勇気と感動を届けて下さった選手の皆様に、心から感謝申し上げます。\nこれまで選手の挑戦を支え続けてこられた御家族、指導者、関係者の皆様にも、深く敬意を表します。\n\n本大会は、「パラスポーツ」の魅力と素晴らしさを広く国内外に発信するとともに、多くの方々が「パラスポーツ」に触れ、より身近に感じる貴重な機会となりました。\n\n2年後の「ロサンゼルス パラリンピック」、4年後にカタール・ドーハで開催される次回「アジアパラ競技大会」といった、次なる大舞台で、「TEAM JAPAN」の皆様がより一層御活躍されることを願っております。"}}},"rest_id":"2113828956927623383","unmention_data":{},"views":{"count":"406950","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113828956927623383","sortIndex":"2114601617549426623"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/PXl4ONO6df"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"descr