alse,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04349.html","indices":[243,266],"url":"https://t.co/rKrXlpQpfZ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM4MTA2MzM1OTA0NTYzMjA=","richtext":{"richtext_tags":[]},"text":"堀井外務副大臣は、ミクロネシア独立40周年記念レセプションに出席し、挨拶を行いました。同レセプションには、訪日中のシミナ・ミクロネシア大統領夫妻も参加しました。堀井副大臣は、ミクロネシア独立40周年に対し祝意を表すとともに、自身の本年8月のミクロネシア訪問にも触れつつ、地域の結束と一体性に対する揺るぎないコミットメントを示した上で、第11回太平洋・島サミットや、2028年の外交関係樹立40周年という節目の機会も活かしながら、日ミクロネシア関係の更なる向上に努めていく旨述べました。\nhttps://t.co/rKrXlpQpfZ"}}},"rest_id":"2113810633707901428","unmention_data":{},"views":{"count":"10685","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113810633707901428","sortIndex":"2114601617549426621"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2114601617549426756-tweet-2113592069088489880","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=420