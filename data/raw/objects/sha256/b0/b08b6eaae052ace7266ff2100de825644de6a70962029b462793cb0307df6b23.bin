fa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":591062,"following":204},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20373,"tweets":49127},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2113604470932418910"],"editable_until_msecs":"1792761149000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2113604470932418910","created_at":"Fri Oct 23 12:12:29 +0000 2026","display_text_range":[0,142],"entities":{},"favorite_count":61,"favorited":false,"full_text":"堀井外務副大臣主催による夕食会が開催され、実務訪問賓客として訪日中のシミナ・ミクロネシア大統領などが出席しました。堀井副大臣は、ミクロネシアの重要性に触れつつ、自由で開かれたインド太平洋（FOIP）の実現のため、ミクロネシアの自律性や強靱性の強化を今後も後押ししていく旨述べました。こ","id_str":"2113604470932418910","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":15,"retweet_count":9,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04340.html","indices":[262,285],"url":"https://t.co/TMf7NkJOc3"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM2MDQ0NzA3OTM5OTAxNDQ=","richtext":{"richtext_tags":[]},"text":"堀井外務副大臣主催による夕食会が開催され、実務訪問賓客として訪日中のシミナ・ミクロネシア大統領などが出席しました。堀井副大臣は、ミクロネシアの重要性に触れつつ、自由で開かれたインド太平洋（FOIP）の実現のため、ミクロネシアの自律性や強靱性の強化を今後も後押ししていく旨述べました。これに対し、シミナ大統領から、これまでの協力に対する謝意が述べられました。\n両者は、二国間関係や地域情勢に関して意見交換を行い、2027年夏の第11回太平洋・島サミットの成功に向けた連携を含め、引き続き緊密に協力していくことで一致しました。\nhttps://t.co/TMf7NkJOc3"}}},"rest_id":"2113604470932418910","unmention_data":{},"views":{"count":"10594","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113604470932418910","sortIndex":"2114601617549426614"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_imag