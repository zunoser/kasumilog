sult":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3069596,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":596,"tweets":1900},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2114163238271361316"],"editable_until_msecs":"1792894369000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2316,"bookmarked":false,"conversation_id_str":"2114163238271361316","created_at":"Sun Oct 25 01:12:49 +0000 2026","display_text_range":[0,142],"entities":{},"favorite_count":34344,"favorited":false,"full_text":"ご高齢の方などで意欲のある方に働いていただくことは、社会・経済の活力の観点からも、ご本人の健康ややりがいなどの観点からも、重要です。\n\n現在、企業には、希望する方について65歳まで雇用を確保する義務とともに、70歳までの就業機会を確保する努力義務があります。（『高年齢者雇用安定法』）","id_str":"2114163238271361316","is_quote_status":false,"lang":"ja","quote_count":2836,"reply_count":7583,"retweet_count":4286,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQxNjMyMzgyMDAwODI0MzI=","richtext":{"richtext_tags":[]},"text":"ご高齢の方などで意欲のある方に働いていただくことは、社会・経済の活力の観点からも、ご本人の健康ややりがいなどの観点からも、重要です。\n\n現在、企業には、希望する方について65歳まで雇用を確保する義務とともに、70歳までの就業機会を確保する努力義務があります。（『高年齢者雇用安定法』）\n\n企業の取組を支援するため、「65歳超雇用推進助成金」（15～240万円を助成）や、社会保険労務士等の「70歳雇用推進プランナー・高齢者雇用アドバイザー」（全国で474名）による支援を行っており、70歳までの就業確保措置を実施している企業は約35％となっています。\n\n再就職を希望する高齢者のうち手厚い支援を必要とする方には、ハローワークの「生涯現役支援窓口」（全国300か所）で、担当者制の下、多様なニーズに応じたきめ細かな支援を行っています。利用者のうち93％の方が就職されています。\n臨時的・短期的または軽易な就労を希望する方には「シルバー人材センター」（全国1,309団体）が多様な就業機会を提供しています。\n\n2025年の就業率は、60～64歳は約75％、65～69歳は約55％、70～74歳は約36％、75歳以上は約13％となっており、今後も上昇していくことが期待されます。\n\n若い方も含め、正規雇用で働きたいにもかかわらず非正規雇用で働いている方への支援も重要です。\n\n「わかものハローワーク」やハローワーク内の「わかもの支援コーナー」（全国220か所）で、特にフリーター（概ね35歳未満）の方に担当者制によるきめ細かな個別支援を実施しています。\n\nハローワークの「中高年層（ミドルシニア）専門窓口」（全国92か所）では、概ね35歳以上59歳以下の方を対象に、就職から職場定着まで一貫して支援しています。\n\n非正規雇用労働者の方が、働きながら学び、キャリアアップを目指すことができる、オンラインを活用した「職業訓練」も実施しています（都道府県及び独立行政法人高齢・障害・求職者雇用支援機構『働きながら学びやすい職業訓練』：原則2～6か月：最大1年）。\n\n非正規雇用労働者の正社員化に取り組んでいる企業には、「キャリアアップ助成金」（15～80万円）による支援も行っています。\n\nこうした取組により、「働きたい方が働ける社会づくり」を進めていきます。"}}},"rest_id":"2114163238271361316","unmention_data":{},"views":{"count":"4841770","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114163238271361316","sortIndex":"2114601617549426630"},{"content":{"__typename":"TimelineTimelineItem","clien