h":41,"w":41,"x":345,"y":142},{"h":45,"w":45,"x":547,"y":124}]}},"id_str":"2113863067729833984","indices":[92,115],"media_key":"3_2113863067729833984","media_results":{"result":{"media_key":"3_2113863067729833984"}},"media_url_https":"https://pbs.twimg.com/media/HVXzQqfasAAnris.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":682,"y":0},{"h":1366,"w":1198,"x":850,"y":0},{"h":1366,"w":683,"x":1348,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/apDR7FDsfq"}]},"favorite_count":1508,"favorited":false,"full_text":"10月24日、小泉防衛大臣と小田原防衛副大臣は、海上自衛隊遠洋練習航海部隊の帰国行事に出席しました。小泉大臣は、約5か月間にわたる練習航海を終えて帰国した隊員に対し訓示を行いました。 https://t.co/apDR7FDsfq","id_str":"2113863076017848611","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":10,"quoted_status_id_str":"2056545448517939581","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2056545448517939581","url":"https://t.co/kFqvaTYtSB"},"reply_count":20,"retweet_count":222,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM4NjMwNzU5NTA2NTM0NDA=","text":"10月24日、小泉防衛大臣と小田原防衛副大臣は、海上自衛隊遠洋練習航海部隊の帰国行事に出席しました。小泉大臣は、約5か月間にわたる練習航海を終えて帰国した隊員に対し訓示を行いました。\n\n今年3月に幹部候補生学校を卒業した若手幹部（実習幹部）たちは、北米を中心とした5か国・11寄港地を巡る遠洋練習航海を通じて、幹部自衛官として必要な知識・技能を修得するとともに、国際感覚を学び、無事帰国しました🌎⚓"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_i