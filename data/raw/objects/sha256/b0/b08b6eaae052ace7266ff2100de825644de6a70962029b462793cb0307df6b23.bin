"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":675},"small":{"h":680,"resize":"fit","w":383},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/DXZzR7F8de","video_info":{"aspect_ratio":[9,16],"duration_millis":9200,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2113512243963035648/pl/3aflh_nqjRamTwdS.m3u8?tag=29"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/320x568/BYXDUMxIGMXS_LF3.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/480x852/miIX24a4j8zPx4KP.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/720x1280/HFyyyfk8W13NnBN4.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/1080x1920/kF6g797IKwmv2yC6.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/DXZzR7F8de","expanded_url":"https://x.com/ModJapan_jp/status/2114552601970909634/video/1","ext_media_availability":{"status":"Available"},"id_str":"2113512243963035648","indices":[136,159],"media_key":"13_2113512243963035648","media_results":{"result":{"media_key":"13_2113512243963035648"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2113512243963035648/img/rwPvUksFVkLGz4yy.jpg","original_info":{"focus_rects":[],"height":1920,"width":1080},"sizes":{"large":{"h":1920,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":675},"small":{"h":680,"resize":"fit","w":383},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/DXZzR7F8de","video_info":{"aspect_ratio":[9,16],"duration_millis":9200,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2113512243963035648/pl/3aflh_nqjRamTwdS.m3u8?tag=29"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/320x568/BYXDUMxIGMXS_LF3.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/480x852/miIX24a4j8zPx4KP.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/720x1280/HFyyyfk8W13NnBN4.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/1080x1920/kF6g797IKwmv2yC6.mp4?tag=29"}]}}]},"favorite_count":593,"favorited":false,"full_text":"【「#わたしの自衛隊記念日」募集！】\n\n防衛省・自衛隊では、毎年11月1日を「自衛隊記念日」としています。\n自衛隊記念日の前後では、隊員の士気高揚を図りつつ、自衛隊に対する国民の皆様からの御理解を深めていただくため、全国各地で行事やイベントなど様々な取組を行っています。 https://t.co/DXZzR7F8de","id_str":"2114552601970909634","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":4,"retweet_count":117,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[2,13],"text":"わたしの自衛隊記念日"},{"indices":[294,305],"text":"わたしの自衛隊記念日"},{"indices":[363,370],"text":"自衛隊記念日"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ1NTI2MDE5MjQ4MTY4OTY=","text":"【「#わたしの自衛隊記念日」募集！】\n\n防衛省・自衛隊では、毎年11月1日を「自衛隊記念日」としています。\n自衛隊記念日の前後では、隊員の士気高揚を図りつつ、自衛隊に対する国民の皆様からの御理解を深めていただくため、全国各地で行事やイベントなど様々な取組を行っています。\n \nしかし、「皆さんにとっての」自衛隊記念日はもっと他にもあるはず！\n \n災害派遣で見かけた自衛隊。\n航空祭で見たブルーインパルス。\n基地見学での思い出。\n家族や友人とのエピソード。\n \nこれまで自衛隊と関わったことがある方も、ない方も、\n「初めて自衛隊を知った日」\n「心に残っている出来事」\nなどがあれば、\n \n「#わたしの自衛隊記念日」というハッシュタグをつけてぜひ教えてください。\n \n一人ひとりの「あなたの自衛隊記念日」をお待ちしています！\n \n#自衛隊記念日"}}},"rest_id":"2114552601970909634","unmention_data":{},"views":{"count":"36641","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114552601970909