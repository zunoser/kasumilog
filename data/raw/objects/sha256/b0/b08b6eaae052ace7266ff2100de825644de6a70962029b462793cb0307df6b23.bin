t_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3069596,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":596,"tweets":1900},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2114595521507831953"],"editable_until_msecs":"1792997434000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":43,"bookmarked":false,"conversation_id_str":"2114595521507831953","created_at":"Mon Oct 26 05:50:34 +0000 2026","display_text_range":[0,141],"entities":{},"favorite_count":2108,"favorited":false,"full_text":"福田康夫元内閣総理大臣のご逝去の報に接し、謹んで哀悼の誠を捧げます。\n\n福田康夫元総理は、第91代内閣総理大臣として国政を担われるとともに、内閣官房長官を長くお務めになるなど、その豊かな経験と卓越した見識をもって、我が国の政治の安定と発展、国民生活の安定に大きな足跡を残されました。","id_str":"2114595521507831953","is_quote_status":false,"lang":"ja","quote_count":18,"reply_count":98,"retweet_count":306,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ1OTU1MjE0NjE2NTc2MDA=","richtext":{"richtext_tags":[]},"text":"福田康夫元内閣総理大臣のご逝去の報に接し、謹んで哀悼の誠を捧げます。\n\n福田康夫元総理は、第91代内閣総理大臣として国政を担われるとともに、内閣官房長官を長くお務めになるなど、その豊かな経験と卓越した見識をもって、我が国の政治の安定と発展、国民生活の安定に大きな足跡を残されました。\n\nここに生前のご功績を偲び、国家と国民のために捧げられた長年のご尽力に心から感謝申し上げます。\n\n個人的には、元旦に皇居に上がった後、福田康夫先生と令夫人が、夫と私に鉄板焼きをご馳走して下さり、緊張しながらも楽しい時間を過ごした事を思い出しています。\n\n御令室をはじめ御遺族の皆様の深いお悲しみに思いを致し、お悔やみを申し上げます。\n\n福田康夫元内閣総理大臣のご冥福を、心よりお祈り申し上げます。"}}},"rest_id":"2114595521507831953","unmention_data":{},"views":{"count":"67668","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114595521507831953","sortIndex":"2114601617549426680"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"