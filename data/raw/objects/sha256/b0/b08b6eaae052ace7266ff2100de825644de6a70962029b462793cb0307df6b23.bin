ue},"display_url":"pic.x.com/btPuEKIRva","expanded_url":"https://x.com/takaichi_sanae/status/2113597601794924773/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":229,"w":229,"x":497,"y":213},{"h":207,"w":207,"x":1221,"y":355}]},"medium":{"faces":[{"h":134,"w":134,"x":291,"y":125},{"h":121,"w":121,"x":715,"y":208}]},"orig":{"faces":[{"h":291,"w":291,"x":632,"y":271},{"h":264,"w":264,"x":1551,"y":451}]},"small":{"faces":[{"h":76,"w":76,"x":165,"y":70},{"h":69,"w":69,"x":405,"y":117}]}},"id_str":"2113597574645252096","indices":[92,115],"media_key":"3_2113597574645252096","media_results":{"result":{"media_key":"3_2113597574645252096"}},"media_url_https":"https://pbs.twimg.com/media/HVUBy7rbgAAinn4.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":758,"y":0},{"h":1734,"w":1521,"x":865,"y":0},{"h":1734,"w":867,"x":1192,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/btPuEKIRva"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/btPuEKIRva","expanded_url":"https://x.com/takaichi_sanae/status/2113597601794924773/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":75,"w":75,"x":541,"y":443}]},"medium":{"faces":[{"h":44,"w":44,"x":317,"y":259}]},"orig":{"faces":[{"h":96,"w":96,"x":688,"y":563}]},"small":{"faces":[{"h":25,"w":25,"x":179,"y":147}]}},"id_str":"2113597574796181504","indices":[92,115],"media_key":"3_2113597574796181504","media_results":{"result":{"media_key":"3_2113597574796181504"}},"media_url_https":"https://pbs.twimg.com/media/HVUBy8PagAAcw7E.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1452,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/btPuEKIRva"}]},"favorite_count":14029,"favorited":false,"full_text":"先ほど、訪日中のシミナ・ミクロネシア連邦大統領と首脳会談を行いました。\n\n本年はミクロネシア連邦の独立40周年であり、私から祝意を表明するとともに、シミナ大統領の訪日を歓迎しました。 https://t.co/btPuEKIRva","id_str":"2113597601794924773","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":95,"reply_count":981,"retweet_count":1330,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM1OTc2MDE3MjM2NTgyNDA=","richtext":{"richtext_tags":[]},"text":"先ほど、訪日中のシミナ・ミクロネシア連邦大統領と首脳会談を行いました。\n\n本年はミクロネシア連邦の独立40周年であり、私から祝意を表明するとともに、シミナ大統領の訪日を歓迎しました。\n\n両国が「共に、強く豊かになる」協力を積み重ねつつ、進化した「自由で開かれたインド太平洋（FOIP）」の実現に向け、共に協力していきたい旨お伝えし、ミクロネシア連邦の「自律性」と「強靱性」を高めるための協力を継続していく旨を申し上げました。\n\nシミナ大統領からは、これまでの幅広い分野への支援や協力に関する日本への感謝や、二国間関係の一層の強化への強い意向が表明されました。\n\n進化した「自由で開かれたインド太平洋（FOIP）」の考え方や取組を歓迎するとの御言葉も伺いました。\n\n地域情勢や国際場裡の連携についても議論し、太平洋島しょ国地域の結束と一体性の維持・強化の重要性を確認しました。\n\n太平洋・島サミット（PALM）創設30周年の節目に当たる来年夏に横浜で開催予定の「PALM11」の成功に向けて、ミクロネシア連邦と緊密に連携してまいります。"}}},"rest_id":"2113597601794924773","unmention_data":{},"views":{"count":"394880","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113597601794924773","sortIndex":"2114601617549426613"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Twe