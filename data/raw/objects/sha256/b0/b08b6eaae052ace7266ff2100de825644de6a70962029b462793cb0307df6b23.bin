outu.be/W3LFuwKp_q8?si…","expanded_url":"https://youtu.be/W3LFuwKp_q8?si=-GY1qbI6j46zcuQq","indices":[313,336],"url":"https://t.co/kVZZptmHy1"},{"display_url":"mod.go.jp/j/press/kisha/…","expanded_url":"https://www.mod.go.jp/j/press/kisha/2026/1009a.html","indices":[344,367],"url":"https://t.co/Jo1qkOKYzL"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg0NTY3OTk5OTc0NTYzODQ=","text":"【🛰防衛×宇宙🚀シリーズ㉛】\n \n第31弾は、「即応宇宙輸送能力の提案募集！」\n \n防衛省・自衛隊が利用する人工衛星の一部が失われた場合に、その機能を迅速に回復することは、安全保障上の重要な課題です。\nこのためにどのような即応宇宙輸送システムが必要か、防衛省では本日（10/9）から提案を募集します！\n \n宇宙産業の技術力、創造力、そして挑戦する力を発揮していただき、防衛課題の解決と宇宙産業発展の好循環を目指します。\n宇宙産業に携わる皆さまの革新的なご提案をお待ちしております！\n \n👇ご提案はこちらから【締切：12月23日（水）12時】\nhttps://t.co/lJ5lXlqBXG\n\n👇詳しくはこちら\n（大臣会見動画）https://t.co/kVZZptmHy1\n（大臣会見録）https://t.co/Jo1qkOKYzL\n \n#宇宙安保\n#SDF_SpaceYear"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2105960999362658530"}},"rest_id":"2108456800215617714","unmention_data":{},"views":{"count":"198625","state":"EnabledWithCount"}}},"rest_id":"2113571148134858782","unmention_data":{},"views":{"count":"34854","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113571148134858782","sortIndex":"2114601617549426604"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":