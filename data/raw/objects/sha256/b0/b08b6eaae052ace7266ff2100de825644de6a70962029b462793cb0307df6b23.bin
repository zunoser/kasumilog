671071252480","indices":[78,101],"media_key":"3_2114131671071252480","media_results":{"result":{"media_key":"3_2114131671071252480"}},"media_url_https":"https://pbs.twimg.com/media/HVbnjb6a4AA4Wke.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":3072,"w":3072,"x":0,"y":0},{"h":3072,"w":2695,"x":0,"y":0},{"h":3072,"w":1536,"x":0,"y":0},{"h":3072,"w":4096,"x":0,"y":0}],"height":3072,"width":4096},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HkQcf7bq9l"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/HkQcf7bq9l","expanded_url":"https://x.com/takaichi_sanae/status/2114131769574433142/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":162,"w":162,"x":1380,"y":854}]},"medium":{"faces":[{"h":94,"w":94,"x":808,"y":500}]},"orig":{"faces":[{"h":324,"w":324,"x":2760,"y":1708}]},"small":{"faces":[{"h":53,"w":53,"x":458,"y":283}]}},"id_str":"2114131671071252480","indices":[78,101],"media_key":"3_2114131671071252480","media_results":{"result":{"media_key":"3_2114131671071252480"}},"media_url_https":"https://pbs.twimg.com/media/HVbnjb6a4AA4Wke.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":3072,"w":3072,"x":0,"y":0},{"h":3072,"w":2695,"x":0,"y":0},{"h":3072,"w":1536,"x":0,"y":0},{"h":3072,"w":4096,"x":0,"y":0}],"height":3072,"width":4096},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HkQcf7bq9l"}]},"favorite_count":11797,"favorited":false,"full_text":"【日本列島を、強く豊かに。：山梨編】\n\n本日は、『地域未来戦略』に基づき山梨県が策定した、「水素社会実現を牽引する地域産業クラスター計画」をご紹介します。 https://t.co/HkQcf7bq9l","id_str":"2114131769574433142","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":185,"reply_count":1024,"retweet_count":1430,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[762,774],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQxMzE3Njk0Nzc5NTU1ODQ=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：山梨編】\n\n本日は、『地域未来戦略』に基づき山梨県が策定した、「水素社会実現を牽引する地域産業クラスター計画」をご紹介します。\n\n鉄鋼をはじめ幅広い産業分野での活用が期待される「水素」は、我が国のエネルギー安全保障や2050年カーボンニュートラル実現の観点から、重要な役割を果たすことが期待されており、サプライチェーンの構築、需要創出、価格低減を実現していくことが重要です。\n\n山梨県には、水素関連分野の研究施設が集積するとともに、水素の製造、実証、社会実装の取組が県内各地で行われています。\nさらに、水素製造機器の量産工場の建設も予定されており、研究開発や実証で得られた成果を産業化へとつなげる取組が進んでいます。\n\n山梨県は、こうした強みを更に発展させ、『地域未来戦略』の国の支援策も活用しながら、研究施設の機能強化、実装人材の育成、量産工場を核としたサプライチェーンの高度化に取り組み、水素サプライチェーンの構築と水素関連産業の地場産業化を一体的に推進する「産業クラスター」形成を目指しています。\n\nさらに、水素に関わる知見や人材、企業、投資が集積することで、水素社会の実現を牽引する国際的な拠点としていくこととしています。\n\n私自身、長崎知事から以下の意気込みを伺いました。\n\n「今回の計画の狙いは、グリーン水素そのものではなく、グリーン水素エコシステム全体の形成を支える装置・部材・ノウハウのサプライチェーンを、グローバル市場に向けて構築することであります。この観点から、関連産業の地場産業化を進めながら、インドを手始めにインフラ輸出をめざしてまいります。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を全力で応援してまいります。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2114131769574433142","unmention_data":{},"views":{"count":"405055","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114131769574433142","sortIndex":"2114601617549426628"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":