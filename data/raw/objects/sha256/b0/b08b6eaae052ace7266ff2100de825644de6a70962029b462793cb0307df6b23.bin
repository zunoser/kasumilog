:680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/op5rzi6rfb"}]},"favorite_count":13,"favorited":false,"full_text":"10月22日(木)、「経済と暮らしを支える港づくり全国大会」が開催され、井林大臣、朝日副大臣、青島政務官、髙橋政務官が出席しました。井林大臣は、冒頭の挨拶で、「港湾ロジスティクス」の強化や、「みなと」を核とした魅力ある地域づくり等の港湾施策をしっかりと進める旨を述べました。 https://t.co/op5rzi6rfb","id_str":"2114569013053505675","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":1,"retweet_count":1,"retweeted":false,"user_id_str":"571429134"},"rest_id":"2114569013053505675","unmention_data":{},"views":{"count":"2467","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114569013053505675","sortIndex":"2114601617549426665"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2112792719211036672/AymYhN9K?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"那須塩原市では、豊かな自然と食の恵みを未来へ繋ぐため、「食品ロス削減全国大会」を開催いたします。まだ食べられるのに捨てられてしまう「食品ロス」は、持続可能な社会の実現に向けて私たちが解決すべき重要な課題です。本大会では、全国の先進的な取り組みやアイデアを共有し、一人ひとりが実践できる削減の輪をここ那須塩原から広げていきます。皆様のご来場を心よりお待ちしております。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.city.nasushiobara.tochigi.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2112792719211036672/AymYhN9K?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":788,"url":"https://pbs.twimg.com/card_img/2112792719211036672/AymYhN9K?format=jpg&n