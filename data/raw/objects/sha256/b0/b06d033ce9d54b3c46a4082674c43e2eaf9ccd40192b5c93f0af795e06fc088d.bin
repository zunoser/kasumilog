rol":{"edit_tweet_ids":["2119660017280500163"],"editable_until_msecs":"1794204904000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"kyoseikyojo_cao"}}},"policy":"ByInvitation"},"conversation_id_str":"2119660017280500163","created_at":"Mon Nov 09 05:15:04 +0000 2026","display_text_range":[0,178],"entities":{"hashtags":[{"indices":[155,159],"text":"PFS"},{"indices":[160,164],"text":"SIB"},{"indices":[165,170],"text":"官民連携"},{"indices":[171,178],"text":"社会課題解決"}],"media":[{"display_url":"pic.x.com/hJbwUkHARU","expanded_url":"https://x.com/kyoseikyojo_cao/status/2119660017280500163/photo/1","ext_alt_text":"「PFS/SIB首長セミナー」のチラシです。地域の社会課題を効果的・効率的に解決していくための官民連携手法であるPFS/SIBの活用が、全国の地方公共団体に広がっています。本セミナーでは、多様な分野でPFS/SIBに取り組んでいる自治体のトップの皆様から、御知見・ノウハウを共有いただきます。PFS/SIBに御関心のある皆様の参加をお待ちしております。日時は、令和8年11月24日（火）の10時から12時、オンライン形式（Zoomウェビナー）での開催です。参加用URLは事前にメールでお送りします。対象者は地方公共団体職員、民間事業者、金融機関等です。URL（https://www8.cao.go.jp/pfs/seminar20261124.html）又は2次元コードからお申込みください。申込締切りは11月19日（木）17時です。セミナーでは、基調講演、事例紹介、トークセッション等を行います。開会に当たり、なかつか　ひろし内閣府特命担当大臣がビデオメッセージにて挨拶をいたします。基調講演では、「PFS/SIBのこれまでと今後の展開」について公益財団法人社会変革推進財団専務理事あおやぎ　みつあき氏が登壇します。事例紹介及びトークセッションでは、医療・健康分野の「飛び地自治体連携型大規模ヘルスケアプロジェクト」について、京都府八幡市かわた　しょうこ市長が、婚活支援分野の「多様な婚活支援による少子化対策」について、山形県寒河江市さいとう　まさあき市長が、介護予防・就労支援分野の「介護予防「しずおか ちゃちゃちゃ」及び就労支援の展開」について、静岡県静岡市なんば　たかし市長が、介護予防・就労支援・地域資源活用分野の「介護予防、就労支援の実践と地域資源活用に向けた構想」について、大阪府枚方市ふしみ　たかし市長が登壇します。PFS官民連携プラットフォームの会員を募集しています。セミナーや支援制度の情報をメールマガジンでお届けします。登録はURL（https://www8.cao.go.jp/pfs/pfs_platform.html）又は2次元コードからお願いします。問合せ先は、PoliPoli株式会社PFS官民連携プラットフォーム事務局、電話番号070-5146-3263、メールアドレス pfs-platform@polipoli.io です。担当は、たがわ、つねまつ　です。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":78,"w":78,"x":462,"y":872},{"h":86,"w":86,"x":1218,"y":870},{"h":76,"w":76,"x":1172,"y":1210},{"h":72,"w":72,"x":570,"y":1214},{"h":70,"w":70,"x":590,"y":1482},{"h":72,"w":72,"x":1180,"y":1490}]},"medium":{"faces":[{"h":45,"w":45,"x":270,"y":510},{"h":50,"w":50,"x":713,"y":509},{"h":44,"w":44,"x":686,"y":708},{"h":42,"w":42,"x":333,"y":710},{"h":40,"w":40,"x":345,"y":867},{"h":42,"w":42,"x":691,"y":872}]},"orig":{"faces":[{"h":156,"w":156,"x":924,"y":1744},{"h":172,"w":172,"x":2436,"y":1740},{"h":152,"w":152,"x":2344,"y":2420},{"h":144,"w":144,"x":1140,"y":2428},{"h":140,"w":140,"x":1180,"y":2964},{"h":144,"w":144,"x":2360,"y":2980}]},"small":{"faces":[{"h":25,"w":25,"x":153,"y":289},{"h":28,"w":28,"x":404,"y":288},{"h":25,"w":25,"x":389,"y":401},{"h":23,"w":23,"x":189,"y":403},{"h":23,"w":23,"x":195,"y":492},{"h":23,"w":23,"x":391,"y":494}]}},"id_str":"2119656876422184960","indices":[179,202],"media_key":"3_2119656876422184960","media_results":{"result":{"media_key":"3_2119656876422184960"}},"media_url_https":"https://pbs.twimg.com/media/HWqIstzbwAAjFma.jpg","original_info":{"focus_rects":[{"h":1622,"w":2896,"x":0,"y":520},{"h":2896,"w":2896,"x":0,"y":0},{"h":3301,"w":2896,"x":0,"y":0},{"h":4096,"w":2048,"x":0,"y":0},{"h":4096,"w":2896,"x":0,"y":0}],"height":4096,"width":2896},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/hJbwUkHARU"}],"urls":[{"display_url":"www8.cao.go.jp/pfs/seminar202…","expanded_url":"https://www8.cao.go.jp/pfs/seminar20261124.html","indices":[110,133],"url":"https://t.co/JjmCiSUoFZ"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/hJbwUkHARU","expanded_url":"https://x.com/kyoseikyojo_cao/status/2119660017280500163/photo/1","ext_alt_text":"「PFS/SIB首長セミナー」のチラシです。地域の社会課題を効果的・効率的に解決していくための官民連携手法であるPFS/SIBの活用が、全国の地方公共団体に広がっています。本セミナーでは、多様な分野でPFS/SIBに取り組んでいる自治体のトップの皆様から、御知見・ノウハウを共有いただきます。PFS/SIBに御関心のある皆様の参加をお待ちしております。日時は、令和8年11月24日（火）の10時から12時、オンライン形式（Zoomウェビナー）での開催です。参加用URLは事前にメールでお送りします。対象者は地方公共団体職員、民間事業者、金融機関等です。URL（https://www8.cao.go.jp/pfs/seminar20261124.html）又は2次元コードからお申込みください。申込締切りは11月19日（木）17時です。セミナーでは、基調講演、事例紹介、トークセッション等を行います。開会に当たり、なかつか　ひろし内閣府特命担当大臣がビデオメッセージにて挨拶をいたします。基調講演では、「PFS/SIBのこれまでと今後の展開」について公益財団法人社会変革推進財団専務理事あおやぎ　みつあき氏が登壇します。事例紹介及びトークセッションでは、医療・健康分野の「飛び地自治体連携型大規模ヘルスケアプロジェクト」について、京都府八幡市かわた　しょうこ市長が、婚活支援分野の「多様な婚活支援による少子化対策」について、山形県寒河江市さいとう　まさあき市長が、介護予防・就労支援分野の「介護予防「しずおか ちゃちゃちゃ」及び就労支援の展開」について、静岡県静岡市なんば　たかし市長が、介護予防・就労支援・地域資源活用分野の「介護予防、就労支援の実践と地域資源活用に向けた構想」について、大阪府枚方市ふしみ　たかし市長が登壇します。PFS官民連携プラットフォームの会員を募集しています。セミナーや支援制度の情報をメールマガジンでお届けします。登録はURL（https://www8.cao.go.jp/pfs/pfs_platform.html）又は2次元コードからお願いします。問合せ先は、PoliPoli株式会社PFS官民連携プラットフォーム事務局、電話番号070-5146-3263、メールアドレス pfs-platform@polipoli.io です。担当は、たがわ、つねまつ　です。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":78,"w":78,"x":462,"y":872},{"h":86,"w":86,"x":1218,"y":870},{"h":76,"w":76,"x":1172,"y":1210},{"h":72,"w":72,"x":570,"y":1214},{"h":70,"w":70,"x":590,"y":1482},{"h":72,"w":72,"x":1180,"y":1490}]},"medium":{"faces":[{"h":45,"w":45,"x":270,"y":510},{"h":50,"w":50,"x":713,"y":509},{"h":44,"w":44,"x":686,"y":708},{"h":42,"w":42,"x":333,"y":710},{"h":40,"w":40,"x":345,"y":867},{"h":42,"w":42,"x":691,"y":872}]},"orig":{"faces":[{"h":156,"w":156,"x":924,"y":1744},{"h":172,"w":172,"x":2436,"y":1740},{"h":152,"w":152,"x":2344,"y":2420},{"h":144,"w":144,"x":1140,"y":2428},{"h":140,"w":140,"x":1180,"y":2964},{"h":144,"w":144,"x":2360,"y":2980}]},"small":{"faces":[{"h":25,"w":25,"x":153,"y":289},{"h":28,"w":28,"x":404,"y":288},{"h":25,"w":25,"x":389,"y":401},{"h":23,"w":23,"x":189,"y":403},{"h":23,"w":23,"x":195,"y":492},{"h":23,"w":23,"x":391,"y":494}]}},"id_str":"2119656876422184960","indices":[179,202],"media_key":"3_2119656876422184960","media_results":{"result":{"media_key":"3_2119656876422184960"}},"media_url_https":"https://pbs.twimg.com/media/HWqIstzbwAAjFma.jpg","origin