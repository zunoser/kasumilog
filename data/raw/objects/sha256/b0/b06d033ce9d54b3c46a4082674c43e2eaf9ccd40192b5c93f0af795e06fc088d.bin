:{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2119682236631126016","indices":[151,174],"media_key":"3_2119682236631126016","media_results":{"result":{"media_key":"3_2119682236631126016"}},"media_url_https":"https://pbs.twimg.com/media/HWqfw38akAAaMkl.png","original_info":{"focus_rects":[{"h":926,"w":1653,"x":0,"y":648},{"h":1653,"w":1653,"x":0,"y":285},{"h":1884,"w":1653,"x":0,"y":169},{"h":2339,"w":1170,"x":483,"y":0},{"h":2339,"w":1653,"x":0,"y":0}],"height":2339,"width":1653},"sizes":{"large":{"h":2048,"resize":"fit","w":1447},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/5qQaXsTTmZ"}]},"favorite_count":29,"favorited":false,"full_text":"【物流取引に関する調査の開始】\n取引実態の把握のために、11月9日から荷主向け、来年2月目途に物流事業者向けのウェブアンケート調査を行います。協力依頼状が届いた事業者の皆様におかれましては、御協力をお願いいたします。\nhttps://t.co/Ep8rRtYD8e\n#物流特殊指定 #優越的地位の濫用 https://t.co/5qQaXsTTmZ","id_str":"2119682327035170967","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":2,"retweet_count":16,"retweeted":false,"user_id_str":"2455900080"},"rest_id":"2119682327035170967","unmention_data":{},"views":{"count":"2797","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119682327035170967","sortIndex":"2119975452247326640"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/875540374780911616/70