:{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/QBbKqlJ2mw"}]},"favorite_count":106,"favorited":false,"full_text":"赤澤大臣は、フン（H.E. Mr. Le Manh Hung）商工大臣とともに第8回「日ベトナム産業・貿易・エネルギー協力委員会」を、共同議長として開催。重要鉱物を含むサプライチェーン強靱化、AZECやパワー・アジア（POWERR https://t.co/QBbKqlJ2mw","id_str":"2119783223769338147","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":3,"retweet_count":21,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[298,310],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTk3ODMyMjM2NzcwNzU0NTY=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、フン（H.E. Mr. Le Manh Hung）商工大臣とともに第8回「日ベトナム産業・貿易・エネルギー協力委員会」を、共同議長として開催。重要鉱物を含むサプライチェーン強靱化、AZECやパワー・アジア（POWERR Asia）を通じた協力等について議論し、両国の取組を更に強化していくことを確認しました。\nまた、「日本・ベトナム経済・科学技術官民連携フォーラム」に出席。挨拶では、日ベトナム経済関係が更に発展することへの期待を表明しました。さらに、ラム（H. E. Mr. To Lam）共産党書記長兼国家主席と会談し、両国企業による協力や投資の拡大に向けて意見交換を行いました。#meti_daijin"}}},"rest_id":"2119783223769338147","unmention_data":{},"views":{"count":"8444","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119783223769338147","sortIndex":"2119975452247326687"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"