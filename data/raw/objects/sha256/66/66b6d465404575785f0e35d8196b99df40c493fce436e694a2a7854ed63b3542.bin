user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1005shoshinhyomei.html","indices":[189,212],"url":"https://t.co/VLOHmIUPX1"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDc4NDUxNDQyODQ0MjYyNDA=","richtext":{"richtext_tags":[]},"text":"【高市総理・所信表明演説（責任ある積極財政）】\n「日本成長戦略」と「地域未来戦略」を両輪に、予算編成方針も大胆に見直し、政府が一歩前に出て、国内投資の呼び水として、大規模かつ長期の、予見可能性の高い財政支出を計画的に行い、大胆な国内投資を力強く引き出していきます。\n \n10月5日に行われた高市総理の所信表明演説の動画及びテキストは、官邸HPに掲載しています。\n▼詳細はこちら\nhttps://t.co/VLOHmIUPX1"}}},"rest_id":"2107845144347324850","unmention_data":{},"views":{"count":"47546","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107845144347324850","sortIndex":"2108013556136935410"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3012177,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":575,"tweets":1852},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2107833872889336062"],"editable_until_msecs":"1791385331613","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"data":{"associated_data":{},"destination_language":"ja","entities":{"hashtags":[],"symbols":[],"urls":[],"user_mentions":[{"id":"218434058","id_str":"218434058","indices":[191,206],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"preview_translation":"高市首相、誠にありがとうございました。\n\n今年7月の首相のインド訪問は、私にとっても忘れられないものとなりました。この訪問により、日印のパートナーシップはさらに強固なものとなりました。","source_language":"hi","translation":"高市首相、誠にありがとうございました。\n\n今年7月の首相のインド訪問は、私にとっても忘れられないものとなりました。この訪問により、日印のパートナーシップはさらに強固なものとなりました。\n\n両国は、長年にわたる友好関係を基盤として、世界の平和、安定、繁栄のために引き続き協力してまいります。\n\n国交樹立75周年を迎えるにあたり、両国関係が新たな高みに達することを確信しております。\n\n@takaichi_sanae"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2107833872889336062","created_at":"Wed Oct 07 14:02:11 +0000 2026","display_text_range":[0,14