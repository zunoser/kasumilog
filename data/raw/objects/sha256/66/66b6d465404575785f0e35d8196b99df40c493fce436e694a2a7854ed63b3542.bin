rcvLNW8U8d"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/rcvLNW8U8d","expanded_url":"https://x.com/takaichi_sanae/status/2107796360179142703/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":81,"w":81,"x":745,"y":653},{"h":291,"w":291,"x":719,"y":257}]},"medium":{"faces":[{"h":48,"w":48,"x":437,"y":383},{"h":170,"w":170,"x":421,"y":150}]},"orig":{"faces":[{"h":104,"w":104,"x":947,"y":830},{"h":370,"w":370,"x":914,"y":327}]},"small":{"faces":[{"h":27,"w":27,"x":247,"y":217},{"h":96,"w":96,"x":239,"y":85}]}},"id_str":"2107794651524820992","indices":[59,82],"media_key":"3_2107794651524820992","media_results":{"result":{"media_key":"3_2107794651524820992"}},"media_url_https":"https://pbs.twimg.com/media/HUBkEWea8AA7ybC.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":238,"y":0},{"h":1734,"w":1521,"x":345,"y":0},{"h":1734,"w":867,"x":672,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/rcvLNW8U8d"}]},"favorite_count":6167,"favorited":false,"full_text":"本日夕方、『All Japan Specialties Gala 2026』にお招きを賜り、挨拶をしてまいりました。 https://t.co/rcvLNW8U8d","id_str":"2107796360179142703","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":75,"reply_count":525,"retweet_count":581,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDc3OTYzNjAxMTIwODcwNDA=","richtext":{"richtext_tags":[]},"text":"本日夕方、『All Japan Specialties Gala 2026』にお招きを賜り、挨拶をしてまいりました。\n\n全国47都道府県からお集りいただいた108もの事業者の皆様が、自慢の「日本の食」を展示されており、各国の駐日大使の皆様をはじめ、100か国以上の代表の皆様が、それぞれのブースをご覧になり、意欲あふれる日本の中小企業・小規模事業者が持つ優れた技術や品質を、体感いただく機会となりました。\n\n森義久会長をはじめ、この熱気あふれるイベントの開催に尽力された全国商工会連合会の皆様に、敬意を表します。\n\n高市内閣では、農林水産物・食品の輸出額を、「2030年に5兆円」とする目標を掲げており、海外需要の獲得に向けた「販路の拡大」と、農林水産物・食品の供給力の向上に向けた「輸出産地・プレーヤーの育成支援」を、両輪で推進しています。\n\nとりわけ、我が国が一丸となって世界の市場を開拓していこうと考えている「日本産ノングルテン米粉」についても、魅力を発信してまいります。\n\nまた、『地域未来戦略』のもと、農林水産をはじめとする地域の特色ある強みを活かした「産業クラスター」の形成を応援していきます。\n日本列島の隅々まで産業クラスターの花を咲かせてまいりましょう。\n\n今回のイベントが、農林水産物・食品の輸出拡大の足掛かりとなることを期待しております。"}}},"rest_id":"2107796360179142703","unmention_data":{},"views":{"count":"221918","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107796360179142703","sortIndex":"2108013556136935403"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","e