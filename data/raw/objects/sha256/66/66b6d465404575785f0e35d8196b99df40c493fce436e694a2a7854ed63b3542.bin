06,"x":297,"y":143}]}},"id_str":"2107817810844155904","indices":[86,109],"media_key":"3_2107817810844155904","media_results":{"result":{"media_key":"3_2107817810844155904"}},"media_url_https":"https://pbs.twimg.com/media/HUB5IZqbgAAft4m.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/o7fS9c0CYK"}]},"favorite_count":23444,"favorited":false,"full_text":"本日、東京理科大学名誉教授の硤合憲三先生が「ノーベル化学賞」を受賞されることが決まりました。\n硤合先生、そして、一緒に研究をしてこられた皆様に、心よりお祝い申し上げます。 https://t.co/o7fS9c0CYK","id_str":"2107817905274679656","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":360,"reply_count":972,"retweet_count":2172,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDc4MTc5MDUyMjQzNjQwMzI=","richtext":{"richtext_tags":[]},"text":"本日、東京理科大学名誉教授の硤合憲三先生が「ノーベル化学賞」を受賞されることが決まりました。\n硤合先生、そして、一緒に研究をしてこられた皆様に、心よりお祝い申し上げます。\n\n硤合先生は、ごくわずかな分子の違いが、自ら仲間を増やしながら大きな違いへと育っていく現象である、「Soai反応」（そあい はんのう）として知られている、「不斉自己触媒反応」（ふせい じこ しょくばい はんのう）を、発見されました。\n\nホモキラリティーの成立起源に関する研究であり、この成果は、「生命の起源」という人類共通の謎の解明にもつながる画期的なものと伺っており、日本人として、とても誇りに思います。\n\n硤合先生の今後の御活躍とともに、我が国の学術研究の一層の発展のため、引き続き、御尽力下さることを期待申し上げております。"}}},"rest_id":"2107817905274679656","unmention_data":{},"views":{"count":"615229","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107817905274679656","sortIndex":"2108013556136935406"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2107316172916130039"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":591030,"following":204},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20263,"tweets":48982},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_control_initial":{"edit_tweet_ids":["2107804887878934952","2107807462573359163"],"editable_until_msecs":"1791378421000","edits_remaining":"4","is_edit_eligible":true},"initial_tweet_id":"2107804887878934952"},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":240,"bookmarked":false,"conversation_id_str":"2107807462573359163","created_at":"Wed Oct 07 12:17:14 +0000 2026","display_text_range":[0,18],"entities":{},"favorite_count":6266,"favorited":false,"full_text":"高市総理の呼称に関する日本政府の見解","id_str":"2107807462573359163","is_quote_status":false,"lang":"ja","quote_count":391,"reply_count":466,"retweet_count":990,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDc4MDc0NjI1MTQ2OTIwOTY=","richtext":{"richtext_tags":[]},"text":"高市総理の呼称に関する日本政府の見解\n\n　10月7日の外務報道官会見において、9月30日の中国外交部報道官の発言について以下のやり取りがありました。政府としては、立場の違いがあっても、一国の指導者に対してしかるべき敬意を払うことは国際儀礼上当然だと考えており、こうした立場は中国側にもしかるべく申し入れているところです。\n\n【質問】\n　中国外務省の郭嘉昆（かく・かこん）副報道局長が、9月30日の記者会見で高市政権を批判した際に、日本首相の肩書きを付けずに呼び捨てにしたという報道がありました。呼び捨ては異例で意図的だったという指摘もありますけれども、日本政府の受け止めをお願いいたします。\n\n【北村外務報道官】\n　御指摘の中国外交部報道官の発言、これは承知をしておりますけれども、その逐一について、日本としてコメントすることは差し控えます。\n　いずれにしましても、立場の違いがあっても、一国の指導者に対してしかるべき敬意を払うことは、国際儀礼上、当然のことだと考えております。こうした立場は、中国に対してもしかるべく申入れを行っているところです。"}}},"previous_counts":{"bookmark_count":1,"favorite_count":45,"quote_count":1,"reply_count":0,"retweet_count":12},"rest_id":"2107807462573359163","unmention_data":{},"views":{"count":"930877","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107807462573359163","sortIndex":"2108013556136935405"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_sh