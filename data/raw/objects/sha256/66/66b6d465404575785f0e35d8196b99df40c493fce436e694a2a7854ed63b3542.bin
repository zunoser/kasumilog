able"},"features":{"large":{"faces":[{"h":196,"w":196,"x":1574,"y":265}]},"medium":{"faces":[{"h":115,"w":115,"x":931,"y":156}]},"orig":{"faces":[{"h":196,"w":196,"x":1574,"y":265}]},"small":{"faces":[{"h":65,"w":65,"x":527,"y":88}]}},"id_str":"2107786606317084672","indices":[102,125],"media_key":"3_2107786606317084672","media_results":{"result":{"media_key":"3_2107786606317084672"}},"media_url_https":"https://pbs.twimg.com/media/HUBcwDvbIAAkIZy.jpg","original_info":{"focus_rects":[{"h":1136,"w":2028,"x":0,"y":0},{"h":1353,"w":1353,"x":0,"y":0},{"h":1353,"w":1187,"x":0,"y":0},{"h":1353,"w":677,"x":0,"y":0},{"h":1353,"w":2028,"x":0,"y":0}],"height":1353,"width":2028},"sizes":{"large":{"h":1353,"resize":"fit","w":2028},"medium":{"h":801,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KQJFWOJHwg"}]},"favorite_count":463,"favorited":false,"full_text":"10月5日、小田原防衛副大臣は、アメリカよりベネット上院議員@SenatorBennet一行の表敬訪問を受けました。小田原副大臣は一行の来訪を歓迎し、日頃からの日米同盟への理解と支持に感謝を伝えました。 https://t.co/KQJFWOJHwg","id_str":"2107786614869303604","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":50,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"224285242","indices":[30,44],"name":"Michael Bennet","screen_name":"SenatorBennet"}]},"id":"Tm90ZVR3ZWV0OjIxMDc3ODY2MTQ4MTA1NDIwODA=","text":"10月5日、小田原防衛副大臣は、アメリカよりベネット上院議員@SenatorBennet一行の表敬訪問を受けました。小田原副大臣は一行の来訪を歓迎し、日頃からの日米同盟への理解と支持に感謝を伝えました。\nまた、沖縄県那覇市で発生した強盗殺人事件に関し、日本政府として、米側に対し強く抗議するとともに、捜査への全面的な協力、米軍関係者の綱紀粛正と、事件・事故の再発防止の徹底とご遺族に対する適切な対応を強く求めていることを伝えました。"}}},"rest_id":"2107786614869303604","unmention_data":{},"views":{"count":"31260","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107786614869303604","sortIndex":"2108013