ERxD6.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1582,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mYHHcfhE9g"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/mYHHcfhE9g","expanded_url":"https://x.com/takaichi_sanae/status/2107794070513000650/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":75,"w":75,"x":1615,"y":559},{"h":69,"w":69,"x":451,"y":569}]},"medium":{"faces":[{"h":44,"w":44,"x":946,"y":327},{"h":40,"w":40,"x":264,"y":333}]},"orig":{"faces":[{"h":96,"w":96,"x":2051,"y":710},{"h":88,"w":88,"x":573,"y":723}]},"small":{"faces":[{"h":25,"w":25,"x":536,"y":185},{"h":23,"w":23,"x":149,"y":189}]}},"id_str":"2107794053089857537","indices":[93,116],"media_key":"3_2107794053089857537","media_results":{"result":{"media_key":"3_2107794053089857537"}},"media_url_https":"https://pbs.twimg.com/media/HUBjhhIaEAERxD6.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1582,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mYHHcfhE9g"}]},"favorite_count":13276,"favorited":false,"full_text":"本日、古謝沖縄県知事と面会をいたしました。\n\n古謝知事からは、沖縄政策協議会の早期開催、米海兵隊員による強盗殺人事件の発生を受けた実効性のある再発防止対策に関する要請をいただきました。 https://t.co/mYHHcfhE9g","id_str":"2107794070513000650","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":93,"reply_count":394,"retweet_count":1626,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDc3OTQwNzA0Mzc1MjM0NTg=","richtext":{"richtext_tags":[]},"text":"本日、古謝沖縄県知事と面会をいたしました。\n\n古謝知事からは、沖縄政策協議会の早期開催、米海兵隊員による強盗殺人事件の発生を受けた実効性のある再発防止対策に関する要請をいただきました。\n\n私からは、沖縄政策協議会の開催については、本日の御要望をしっかりと受け止めて対応していく旨を申し上げました。\n\nまた、沖縄県那覇市で発生した強盗殺人事件については、政府として米側に強く抗議するとともに、捜査への全面的な協力、米軍関係者の綱紀粛正、再発防止の徹底、そして被害者のご遺族に対する適切な対応を強く求めたこと、その結果、米側から新たな措置について発表があったことを申し上げました。\n\n米側は、新たな措置として、在沖縄のすべての米軍人の４８時間の運用の停止などを行っているところですが、事件の発生を防止すべく、いかに実効性のある措置をとっていくかについて、更に日米間で協議を進めていくこともご説明しました。\n\n沖縄に関連する政策を進めるに当たって、国と県が緊密に連携していくことは非常に重要です。\n今後も古謝知事からのご意見もお伺いしながら、沖縄の基地負担軽減や振興に取り組んでまいります。"}}},"rest_id":"2107794070513000650","unmention_data":{},"views":{"count":"288628","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107794070513000650","sortIndex":"2108013556136935402"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2107777153861558272/RoauW4py?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2107777153861558272/RoauW4py?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"官房長官の定例記者会見の様子などをご覧になれます。","type":"STRING"}},{"key":"domain","value":{"string_valu