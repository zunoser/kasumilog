42731686617425"],"editable_until_msecs":"1791363601000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2107742731686617425","created_at":"Wed Oct 07 08:00:01 +0000 2026","display_text_range":[0,90],"entities":{"media":[{"display_url":"pic.x.com/bAim3h211S","expanded_url":"https://x.com/gov_online/status/2107742731686617425/photo/1","ext_alt_text":"上部に「にゅうがん検診、受けていますか？」と記載されており、その下に、医師と会話する女性のイラストが描かれている。その下には、次のように記載されている。「にゅうがんとは？乳腺の組織にできる悪性腫瘍で「乳腺にある細胞が、正常な働きを失い、コントロールできないほど増えてしまう」ことで発症します。女性の罹患数は第1位。死亡数が第4位のがん。5年以上経過後の再発も珍しくありません。検診内容は？対象者：40歳以上（女性）。受診間隔：2年に1回。主な検査項目：問診、乳房エックス線検査（マンモグラフィ）。※実際の受診申込や検査費用などについては、お住まいの市区町村や加入している健康保険にお問い合わせください。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":87,"w":87,"x":710,"y":407}]},"medium":{"faces":[{"h":65,"w":65,"x":532,"y":305}]},"orig":{"faces":[{"h":87,"w":87,"x":710,"y":407}]},"small":{"faces":[{"h":36,"w":36,"x":301,"y":172}]}},"id_str":"2107640699642597377","indices":[91,114],"media_key":"3_2107640699642597377","media_results":{"result":{"media_key":"3_2107640699642597377"}},"media_url_https":"https://pbs.twimg.com/media/HT_YDLBaUAEJ-sU.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":1200,"w":1200,"x":0,"y":0},{"h":1368,"w":1200,"x":0,"y":0},{"h":1600,"w":800,"x":40,"y":0},{"h":1600,"w":1200,"x":0,"y":0}],"height":1600,"width":1200},"sizes":{"large":{"h":1600,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/bAim3h211S"}],"user_mentions":[{"id_str":"180585090","indices":[80,90],"name":"厚生労働省","screen_name":"MHLWitter"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/bAim3h211S"