"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/b3oNuKkXSb"},{"display_url":"pic.x.com/b3oNuKkXSb","expanded_url":"https://x.com/ModJapan_jp/status/2107657900802056330/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":115,"w":115,"x":405,"y":475},{"h":182,"w":182,"x":378,"y":295}]},"medium":{"faces":[{"h":74,"w":74,"x":263,"y":308},{"h":118,"w":118,"x":245,"y":191}]},"orig":{"faces":[{"h":115,"w":115,"x":405,"y":475},{"h":182,"w":182,"x":378,"y":295}]},"small":{"faces":[{"h":42,"w":42,"x":149,"y":174},{"h":67,"w":67,"x":139,"y":108}]}},"id_str":"2107657891729838080","indices":[88,111],"media_key":"3_2107657891729838080","media_results":{"result":{"media_key":"3_2107657891729838080"}},"media_url_https":"https://pbs.twimg.com/media/HT_nr4ibEAAzo81.jpg","original_info":{"focus_rects":[{"h":1032,"w":1843,"x":3,"y":0},{"h":1032,"w":1032,"x":814,"y":0},{"h":1032,"w":905,"x":885,"y":0},{"h":1032,"w":516,"x":1079,"y":0},{"h":1032,"w":1846,"x":0,"y":0}],"height":1032,"width":1846},"sizes":{"large":{"h":1032,"resize":"fit","w":1846},"medium":{"h":671,"resize":"fit","w":1200},"small":{"h":380,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/b3oNuKkXSb"}]},"favorite_count":2955,"favorited":false,"full_text":"本日（10月７日）、小泉防衛大臣は防衛省において沖縄県の古謝知事から、「沖縄政策協議会の開催」、「沖縄県那覇市における米海兵隊による強盗殺人事件」についての要請を受けました。 https://t.co/b3oNuKkXSb","id_str":"2107657900802056330","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":31,"reply_count":47,"retweet_count":467,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDc2NTc5MDA3MzkyMzU4NDA=","text":"本日（10月７日）、小泉防衛大臣は防衛省において沖縄県の古謝知事から、「沖縄政策協議会の開催」、「沖縄県那覇市における米海兵隊による強盗殺人事件」についての要請を受けました。 \n \n小泉大臣からは、まず「沖縄政策協議会の開催」について、沖縄の皆様の声をしっかり受け止めつつ、古謝知事の御意見を具体的に伺いながら、内閣府など関係省庁とも連携して対応していく考えをお伝えしました。 \n \nまた、那覇市で発生した強盗殺人事件について、極めて深刻に受け止めており、米側に対して強く抗議した旨をお伝えするとともに、このような悲劇が二度と繰り返されることがないよう、防衛省として、引き続き在日米軍に対する綱紀粛正、再発防止の徹底、ご遺族に対する適切な対応を強く求めていく考えを説明しました。 \n\n防衛省・自衛隊としては、事件・事故の再発防止を徹底するべく、いかに実効性のある措置を取っていくかについて、関係省庁及び米側と緊密に連携してまいります。"}}},"rest_id":"2107657900802056330","unmention_data":{},"views":{"count":"54399","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107657900802056330","sortIndex":"2108013556136935340"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2106458541330726912/G2VFHXJq?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.fsa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2106458541330726912/G2VFHXJq?format=png&name=420x420_2","width":400},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2106458541330726912/G2VFHXJq?format=png&name=orig","width":401},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"276848601","path":[]}}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2106458541330726912/G2VFHXJq?format=png&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":