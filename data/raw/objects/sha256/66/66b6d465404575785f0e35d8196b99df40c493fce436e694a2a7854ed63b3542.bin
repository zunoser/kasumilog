ps://video.twimg.com/amplify_video/2107798464100970497/vid/avc1/640x360/vQTxhJN7rmSw28eI.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2107798464100970497/vid/avc1/1280x720/HNUR6KyRSQnPK0M0.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2107798464100970497/vid/avc1/1920x1080/I3JkDTCJhgvYb811.mp4?tag=29"}]}}]},"favorite_count":2286,"favorited":false,"full_text":"10月6日、インドネシアでの活動を終え、現地を出発した国際緊急援助隊。 自衛隊にとって初となる海外での消火活動。\nインドネシアに滞在した27日間にわたる活動の記録を一本の動画にまとめました。 https://t.co/eYHW60tayR","id_str":"2107799008080998814","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":15,"quoted_status_id_str":"2107384583843098681","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2107384583843098681","url":"https://t.co/LMsjmfe2u1"},"reply_count":20,"retweet_count":391,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDc3OTkwMDgwMjIzMTA5MTM=","text":"10月6日、インドネシアでの活動を終え、現地を出発した国際緊急援助隊。 自衛隊にとって初となる海外での消火活動。\nインドネシアに滞在した27日間にわたる活動の記録を一本の動画にまとめました。 \n\n防衛省・自衛隊は、引き続き国際社会の一員として、人道的観点から必要な支援に積極的に取り組みます。そして、今回の活動を通じて培った「信頼」を礎に、インドネシアとの防衛協力をより一層深めてまいります。🇯🇵🤝🇮🇩"}}},"previous_counts":{"bookmark_count":0,"favorite_count":5,"quote_count":0,"reply_count":0,"retweet_count":1},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2