is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":44,"bookmarked":false,"conversation_id_str":"2107787207478292662","created_at":"Wed Oct 07 10:56:45 +0000 2026","display_text_range":[0,141],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/ME2CLVmDZm","expanded_url":"https://x.com/kantei/status/2107787207478292662/video/1","ext_media_availability":{"status":"Available"},"id_str":"2107787028633174018","indices":[142,165],"media_key":"13_2107787028633174018","media_results":{"result":{"media_key":"13_2107787028633174018"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2107787028633174018/img/YIFd_k-Z_Wn3Q5bl.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/ME2CLVmDZm","video_info":{"aspect_ratio":[16,9],"duration_millis":151066,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2107787028633174018/pl/t-tJFhNThvLv0DgW.m3u8?tag=29&v=3ac"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2107787028633174018/vid/avc1/480x270/7Eciad91QmkGWM_i.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2107787028633174018/vid/avc1/640x360/FguL-it_JZTd5OkD.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2107787028633174018/vid/avc1/1280x720/l7P4ITg2UgS_BosX.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/ME2CLVmDZm","expanded_url":"https://x.com/kantei/status/2107787207478292662/video/1","ext_media_availability":{"status":"Available"},"id_str":"2107787028633174018","indices":[142,165],"media_key":"13_2107787028633174018","media_results":{"result":{"media_key":"13_2107787028633174018"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2107787028633174018/img/YIFd_k-Z_Wn3Q5bl.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/ME2CLVmDZm","video_info":{"aspect_ratio":[16,9],"duration_millis":151066,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2107787028633174018/pl/t-tJFhNThvLv0DgW.m3u8?tag=29&v=3ac"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2107787028633174018/vid/avc1/480x270/7Eciad91QmkGWM_i.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2107787028633174018/vid/avc1/640x360/FguL-it_JZTd5OkD.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2107787028633174018/vid/avc1/1280x720/l7P4ITg2UgS_BosX.mp4?tag=29"}]}}]},"favorite_count":2525,"favorited":false,"full_text":"【お知らせ】\n本日（１０月７日）、高市総理は、All Japan Specialties Gala 2026に出席しました。\n\n※高市総理挨要旨（速報版）\n　皆様、こんばんは。\n　内閣総理大臣の高市早苗と大臣ズでございます。\n　『All Japan Specialties Gala https://t.co/ME2CLVmDZm","id_str":"2107787207478292662","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":37,"reply_count":89,"retweet_count":316,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDc3ODcyMDc0MDcwMzAyNzI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月７日）、高市総理は、All Japan Specialties Gala 2026に出席しました。\n\n※高市総理挨要旨（速報版）\n　皆様、こんばんは。\n　内閣総理大臣の高市早苗と大臣ズでございます。\n　『All Japan Specialties Gala 2026』が盛大に開催されましたことをまずはお慶びを申し上げます。\n　本日、全国４７都道府県からお集まりいただいた１０８もの事業者の皆様が、自慢の「日本の食」を展示されていると伺っております。\n　森義久会長様はじめ、この熱気あふれるイベントの開催に尽力をされた全国商工会連合会の皆様に、敬意を表します。\n　各国の駐日大使の皆様をはじめ、１００カ国以上の代表の皆様には、それぞれのブースを御覧いただいて、意欲あふれる日本の中小企業・小規模事業者が持つ優れた技術や品質を、体感いただければと思っております。\n　高市内閣では農林水産物・食品の輸出額を、「２０３０年に５兆円」とする目標を掲げております。海外需要の獲得に向けた「販路の拡大」、農林水産物・食品の供給力の向上に向けた「輸出産地・プレーヤーの育成支援」を、両輪で推進しております。\n　とりわけ、我が国が一丸となって世界の市場を開拓していこうと考えております、「日本産ノングルテン米粉」についても、その魅力を発信してまいります。\n　また、皆様ご承知かと思いますが、『地域未来戦略』を策定しました。このもと、農林水産をはじめとする地域の特色ある強みを生かした「産業クラスター」の形成を応援していきます。まさに日本全国に産業クラスターの花を咲かせよう、そう呼びかけております。\n　本日お集まりの皆様の益々の御活躍と全国商工会連合会の更なる御発展を祈念申し上げます。\n　本日はお招きをいただきありがとうございました。"}}},"rest_id":"2107787207478292662","unmention_data":{},"views":{"count":"76013","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107787207478292662","sortIndex":"2108013556136935399"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_