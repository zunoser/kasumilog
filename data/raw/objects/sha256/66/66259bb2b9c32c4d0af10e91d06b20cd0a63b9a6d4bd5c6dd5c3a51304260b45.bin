"x":271,"y":311},{"h":124,"w":124,"x":487,"y":993}]},"orig":{"faces":[{"h":157,"w":157,"x":1221,"y":114},{"h":162,"w":162,"x":1602,"y":73},{"h":165,"w":165,"x":931,"y":162},{"h":172,"w":172,"x":446,"y":172},{"h":203,"w":203,"x":908,"y":502},{"h":241,"w":241,"x":589,"y":675},{"h":269,"w":269,"x":1056,"y":2153}]},"small":{"faces":[{"h":41,"w":41,"x":319,"y":29},{"h":42,"w":42,"x":418,"y":19},{"h":43,"w":43,"x":243,"y":42},{"h":44,"w":44,"x":116,"y":44},{"h":53,"w":53,"x":237,"y":131},{"h":63,"w":63,"x":154,"y":176},{"h":70,"w":70,"x":276,"y":563}]}},"id_str":"2089645126490669056","indices":[136,159],"media_key":"3_2089645126490669056","media_results":{"result":{"media_key":"3_2089645126490669056"}},"media_url_https":"https://pbs.twimg.com/media/HP_pK88aQAAm4lm.jpg","original_info":{"focus_rects":[{"h":1092,"w":1950,"x":0,"y":0},{"h":1950,"w":1950,"x":0,"y":0},{"h":2223,"w":1950,"x":0,"y":0},{"h":2600,"w":1300,"x":0,"y":0},{"h":2600,"w":1950,"x":0,"y":0}],"height":2600,"width":1950},"sizes":{"large":{"h":2048,"resize":"fit","w":1536},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/soVPAycg6J"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/soVPAycg6J","expanded_url":"https://x.com/takaichi_sanae/status/2089645163236966842/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2089645143993536512","indices":[136,159],"media_key":"3_2089645143993536512","media_results":{"result":{"media_key":"3_2089645143993536512"}},"media_url_https":"https://pbs.twimg.com/media/HP_pL-Ja0AAIDUP.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":433,"y":0},{"h":1734,"w":1521,"x":540,"y":0},{"h":1734,"w":867,"x":867,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/soVPAycg6J"}]},"favorite_count":13854,"favorited":false,"full_text":"本日、第61次「沖縄県豆記者団」の小中学生35名の皆様が官邸を訪ねて下さいました。\n\nとても暑い中、沖縄からお越しいただきましたことに、感謝を申し上げました。\n\n皆様の郷土愛あふれる素敵な歌（てぃんさぐぬ花）と美しい琉球舞踊（かぎやで風）を拝見し、元気をいただきました。 https://t.co/soVPAycg6J","id_str":"2089645163236966842","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":110,"reply_count":411,"retweet_count":1618,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwODk2NDUxNjMxNDg5MjY5NzY=","richtext":{"richtext_tags":[]},"text":"本日、第61次「沖縄県豆記者団」の小中学生35名の皆様が官邸を訪ねて下さいました。\n\nとても暑い中、沖縄からお越しいただきましたことに、感謝を申し上げました。\n\n皆様の郷土愛あふれる素敵な歌（てぃんさぐぬ花）と美しい琉球舞踊（かぎやで風）を拝見し、元気をいただきました。\n\n沖縄は、美しい自然に恵まれ、国際色あふれる独自の文化を育んできた、我が国が誇る地域です。\n\n豆記者の皆様には、今回の取材活動で様々なことを学び、知見を広げるとともに、改めて皆様が生まれ育った沖縄の文化を振り返ることで、沖縄の魅力についても、再発見して、発信をしていただきたいと思います。\n\nそして、これからの沖縄県と日本を担う皆様が、それぞれが志す分野で、将来ご活躍されることを心から期待しています。\n\nお土産に賜った「ちんすこう」、秘書官達と一緒に楽しみにいただきます！"}}},"rest_id":"2089645163236966842","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"480427","state":"EnabledWithCount"}}}}},"entryId":"tweet-2089645163236966842","sortIndex":"2089972068564074405"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHQEShfFAJxEKAAIdARE0nVfAnggAAwAAAAEAAA"},"entryId":"cursor-top-2089972068564074497","sortIndex":"2089972068564074497"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHQEShfE__6IKAAIc_-k0XVpBuggAAwAAAAIAAA"},"entryId":"cursor-bottom-2089972068564074404","sortIndex":"2089972068564074404"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}