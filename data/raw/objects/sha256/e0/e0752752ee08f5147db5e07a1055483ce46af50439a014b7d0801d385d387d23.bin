/t.co/RBUT8sbVIj"}]},"favorite_count":75,"favorited":false,"full_text":"＜美味しいお弁当に大臣もこの笑顔🍱✨＞\n\n農林水産省では #三陸・常磐ウィークス として、三陸・常磐ものを食べて応援しています。本日は武部大臣が「漁師とコラボして作った国産銀鮭弁当」をいただきました！\nこれからも、東日本大震災からの復興と三陸・常磐地域の水産物の消費拡大を応援します。 https://t.co/RBUT8sbVIj","id_str":"2120450293108531389","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":3,"retweet_count":11,"retweeted":false,"user_id_str":"2335919749"},"rest_id":"2120450293108531389","unmention_data":{},"views":{"count":"7318","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120450293108531389","sortIndex":"2120712909536362453"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2117994554217639936/Qolnh9I7?format=png&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":147,"url":"https://pbs.twimg.com/card_img/2117994554217639936/Qolnh9I7?format=png&name=280x150","width":280},"type":"IMAGE"}},{"key":"description","value":{"string_value":"総理の指示、談話、メッセージなどをご覧になれます。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.kantei.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":315,"url":"https://pbs.twimg.com/card_img/2117994554217639936/Qolnh9I7?format=png&name=600x600","width":600},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2117994554217639936/Qolnh9I7?format=png&name=386x202","width":386},"type":"IMAGE"}},{"key"