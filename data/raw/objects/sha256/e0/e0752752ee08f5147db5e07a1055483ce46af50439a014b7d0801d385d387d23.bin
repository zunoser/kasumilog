16,9],"duration_millis":134200,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2120475700658601984/pl/MtlziD_PPDTlMhK2.m3u8?tag=29&v=f20"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120475700658601984/vid/avc1/480x270/nSRFyPAldpq_DiY-.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120475700658601984/vid/avc1/640x360/7lI_EBcCJFffX1I8.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120475700658601984/vid/avc1/1280x720/GYNUbMWyWPLiX92w.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/NCBAe9rceZ","expanded_url":"https://x.com/kantei/status/2120476129861800013/video/1","ext_media_availability":{"status":"Available"},"id_str":"2120475700658601984","indices":[130,153],"media_key":"13_2120475700658601984","media_results":{"result":{"media_key":"13_2120475700658601984"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2120475700658601984/img/-hbzUVJZv_5iwaPk.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/NCBAe9rceZ","video_info":{"aspect_ratio":[16,9],"duration_millis":134200,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2120475700658601984/pl/MtlziD_PPDTlMhK2.m3u8?tag=29&v=f20"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120475700658601984/vid/avc1/480x270/nSRFyPAldpq_DiY-.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120475700658601984/vid/avc1/640x360/7lI_EBcCJFffX1I8.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120475700658601984/vid/avc1/1280x720/GYNUbMWyWPLiX92w.mp4?tag=29"}]}}]},"favorite_count":923,"favorited":false,"full_text":"【お知らせ】\n本日（１１月１１日）、木原官房長官は、国と東京都の協議会を開催しました。\n\n※木原官房長官発言要旨（速報版）\n　まずは、小池都知事をはじめ、東京都の皆様におかれましては、本日の協議会、官邸まで足をお運びいただきまして、誠にありがとうございます。 https://t.co/NCBAe9rceZ","id_str":"2120476129861800013","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"reply_count":77,"retweet_count":121,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA0NzYxMjk3Njk0MzEwNDA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月１１日）、木原官房長官は、国と東京都の協議会を開催しました。\n\n※木原官房長官発言要旨（速報版）\n　まずは、小池都知事をはじめ、東京都の皆様におかれましては、本日の協議会、官邸まで足をお運びいただきまして、誠にありがとうございます。 \n　国と東京都が連携することによる、我が国の更なる発展のために様々な課題を協議するこの協議会も、4月、そして7月に続き、今回3回目の開催となります。 \n　高市内閣では、我が国の「強い経済」の実現に向け、大胆な「民間国内投資」を力強く引き出すために、「日本成長戦略」と「地域未来戦略」、これらを車の両輪としてですね、予算編成方針を大胆に見直すこととしております。 \n　これまでにない大胆かつ柔軟な発想で、思い切った政策を打ち出していくことにより、足元の経済状況に的確に対応しつつ、民間投資を引き出し、供給力と稼ぐ力を高め、経済成長を実現していくということを目指してまいります。 \n　このあと事務方から説明をさせますが、「日本成長戦略」に関しては、年末までに策定する「実行計画」について、複数年度にわたる予算事業を盛り込む画期的な取組として、内容の具体化を今進めているところであります。 \n　それから、地域未来戦略についてですが、航空宇宙、洋上風力、医療・バイオをはじめとする成長分野から、農林業、観光など地域に根差した産業まで、全国各地で、それぞれの強みをいかした具体的な計画が着実に形になってきております。すでに全国で100を超える計画が今策定されているところです。 \n　本日の協議会を通じまして、東京都が掲げる政策課題と政府が推進する政策との整合性を図るため、更に議論を深めていきたいと存じます。 \n　改めて、よろしくお願い申し上げます。"}}},"rest_id":"2120476129861800013","unmention_data":{},"views":{"count":"44903","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120476129861800013","sortIndex":"2120712909536362465"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"Timel