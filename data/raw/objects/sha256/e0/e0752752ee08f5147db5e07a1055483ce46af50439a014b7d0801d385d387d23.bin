:[]},"text":"藤井外務大臣政務官は、駐日アルジェリア大使館主催の第72回アルジェリア・ナショナルデー・レセプションに出席し、日本政府を代表して挨拶を行いました。\n藤井政務官は、昨今の中東・北アフリカ情勢を踏まえ、マグレブ地域の重要性は高まっていると述べるとともに、合同経済委員会等の枠組みにおける積極的な対話を通じて、エネルギー分野を始めとする様々な協力が進展することへの期待を表明しました。\n\nhttps://t.co/aEJtgvBPLH"}}},"previous_counts":{"bookmark_count":1,"favorite_count":20,"quote_count":0,"reply_count":0,"retweet_count":2},"rest_id":"2120426861553656169","unmention_data":{},"views":{"count":"5096","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120426861553656169","sortIndex":"2120712909536362436"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.ja