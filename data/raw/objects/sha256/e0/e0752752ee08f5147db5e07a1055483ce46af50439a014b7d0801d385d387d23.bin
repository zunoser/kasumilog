false,"conversation_id_str":"2120461558950379571","created_at":"Wed Nov 11 10:20:06 +0000 2026","display_text_range":[0,62],"entities":{"hashtags":[{"indices":[7,14],"text":"ロボット大賞"}]},"favorite_count":33,"favorited":false,"full_text":"／\n第12回 #ロボット大賞 が決定しました🤖\n＼\nロボットの先進的な活用や研究開発など、特に優れた取組を表彰する制度です。","id_str":"2120461558950379571","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":6,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[7,14],"text":"ロボット大賞"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/11/…","expanded_url":"https://www.meti.go.jp/press/2026/11/20261111001.html","indices":[202,225],"url":"https://t.co/x9Zav04GNW"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA0NjE1NTg4Mjg2MzgyMDg=","richtext":{"richtext_tags":[]},"text":"／\n第12回 #ロボット大賞 が決定しました🤖\n＼\nロボットの先進的な活用や研究開発など、特に優れた取組を表彰する制度です。\n全73件の応募の中から、経済産業大臣賞はラピュタロボティクス株式会社の自在型自動倉庫「ラピュタASRS」、中小企業庁長官賞は蠕動運動型管内検査・清掃ロボット「Sooha」に決定しました。\n11/18～20、東京ビッグサイトで受賞ロボット等の合同展示を行います。\n👇詳細はこちら\nhttps://t.co/x9Zav04GNW"}}},"rest_id":"2120461558950379571","unmention_data":{},"views":{"count":"7232","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120461558950379571","sortIndex":"2120712909536362459"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/p