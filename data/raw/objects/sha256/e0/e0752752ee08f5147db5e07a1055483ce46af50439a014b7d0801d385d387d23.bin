gov-online.go.jp/tokusyu/ict-literacy/index.html","indices":[298,321],"url":"https://t.co/TK8nY9SAyy"},{"display_url":"fujitv.co.jp/nippon_imada_l…","expanded_url":"https://www.fujitv.co.jp/nippon_imada_labo/","indices":[402,425],"url":"https://t.co/ysZVWbHtn5"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA2NzU0NDI1NTg3MDE1Njg=","text":"／\nまさかのタッグ、解禁🍏\nMrs. GREEN APPLE × 偽・誤（ニセゴ）情報対策\n新TVCM、本日から全国で放映📺\n＼\nまさか!と思う情報ほど、\nさっと広めたくなるもの。\nかくにんしてから、シェアしよう。\n━━━━━━━━━━━━\n📺新TVCM『偽・誤情報「ミセスと訓練」篇』（15秒版）\n本日11月12日(木)から全国で放映開始\n\n偽・誤（ニセゴ）情報の可能性は「ま・さ・か」で疑え!\n必要なのは、たった3つの行動。\n●ま:待つ…一旦落ち着こう\n●さ:探す…他の情報も探そう\n●か:確認する…AIで作られた嘘?誰が発信?\n━━━━━━━━━━━━\n▼特設サイト・CM動画はこちらから\nhttps://t.co/TK8nY9SAyy\n\n▼政府広報提供テレビ番組「ニッポン 今だ！ラボ」内でも新TVCM（30秒版）を放送予定!\nフジテレビ:11/18、12/9、12/16、12/23(※予定）\nhttps://t.co/ysZVWbHtn5\n\n#まさかで疑え #ミセスと訓練 #MrsGREENAPPLE"}}},"rest_id":"2120675442676187477","unmention_data":{},"views":{"count":"47551","state":"EnabledWithCount"}}},"rest_id":"2120683083703939114","unmention_data":{},"views":{"count":"5715","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120683083703939114","sortIndex":"2120712909536362483"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/JX6Zp2nhlz"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permi