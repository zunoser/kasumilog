t","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/UFzWgiF5u3"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/UFzWgiF5u3","expanded_url":"https://x.com/takaichi_sanae/status/2120455071116984667/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":421,"w":421,"x":863,"y":173}]},"medium":{"faces":[{"h":246,"w":246,"x":505,"y":101}]},"orig":{"faces":[{"h":535,"w":535,"x":1096,"y":220}]},"small":{"faces":[{"h":139,"w":139,"x":286,"y":57}]}},"id_str":"2120454273461108736","indices":[127,150],"media_key":"3_2120454273461108736","media_results":{"result":{"media_key":"3_2120454273461108736"}},"media_url_https":"https://pbs.twimg.com/media/HW1d7VQbwAA6FT0.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1800,"w":1800,"x":462,"y":0},{"h":1800,"w":1579,"x":573,"y":0},{"h":1800,"w":900,"x":912,"y":0},{"h":1800,"w":2600,"x":0,"y":0}],"height":1800,"width":2600},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/UFzWgiF5u3"}]},"favorite_count":9051,"favorited":false,"full_text":"本日、経済財政諮問会議を開催し、「高市内閣1年間の振り返りを踏まえた今後の経済財政運営」や「成長志向型で持続可能な社会基盤の強化」について議論を行いました。\n\nまず、「高市内閣1年間の振り返りを踏まえた今後の経済財政運営」について、民間議員の皆様から、 https://t.co/UFzWgiF5u3","id_str":"2120455071116984667","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":148,"reply_count":1462,"retweet_count":1003,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA0NTUwNzEwMjA1MTEyMzI=","richtext":{"richtext_tags":[]},"text":"本日、経済財政諮問会議を開催し、「高市内閣1年間の振り返りを踏まえた今後の経済財政運営」や「成長志向型で持続可能な社会基盤の強化」について議論を行いました。\n\nまず、「高市内閣1年間の振り返りを踏まえた今後の経済財政運営」について、民間議員の皆様から、\n・足元では、「賃金と物価の好循環」や「財政状況の改善」がみられるなど、「成長型経済への移行」に向けた｢確かな変化｣が現われているという評価とともに、\n・それを「強い経済」の実現と「財政の持続可能性」の確保の両立につなげることの必要性について、ご指摘をいただきました。\n\n何よりも重要なことは、「実質所得」と「生産性」が持続的に高まり、国民の皆様が「暮らしの豊かさ」を実感できる「成長型経済」を実現していくことです。\n\nこのため、「当初予算」を中心とした予見可能性の高い､計画的な財政運営を進めることによって、官民の投資を促し、｢成長力の強化｣につなげてまいります。\n\nまた、政府としては､引き続き､現行の共同声明に基づき、日本銀行とともにそれぞれの役割を果たしながら、物価の安定と持続的な経済成長の実現に向けて連携してまいります。\n\n物価高に対する切れ目ない支援を講じる中で､賃上げ環境の整備に強力に取り組むとともに、金融資本市場の動向に細心の注意を払い、安定的なマクロ経済環境の確保に万全を期してまいります。\n\nまた、自治体の官公需における価格転嫁を進めるため、地方財政措置によるインセンティブの強化も含め、更なる検討を進めるためにより有効な方策を実行していきます。\n\n次に、「成長志向型で持続可能な社会基盤の強化」について、民間議員の皆様から、\n・「強い経済」の礎となる「教育・研究力の強化」や、\n・「強い地方経済の実現」に向けた｢インフラ・公共サービス等の基盤強化｣に関して、\n令和９年度予算に反映すべき事項を含め、様々なご提案をいただきました。\n\n令和９年度予算に関わる本日の議論なども踏まえて、「予算編成の基本方針」のとりまとめを進めてまいります。\n\n大学学部の成長分野への転換や量的規模の適正化を図るため､\n・予算等による｢実効的なインセンティブ措置｣だけでなく、\n・｢統廃合に向けた大学の早期判断を促す制度的対応｣を含め､\n本日議論のあった取り組みを具体化していきます。\n\nさらに、\n・｢社会的割引率の見直し｣を含む｢公共事業評価の見直し｣について､できるだけ速やかに結論を出し、令和９年度から実行に移してまいります。\n・｢公共インフラの集約・再編・予防保全｣について、自治体任せにすることなく、国が一歩前に出て自治体の取組を後押しする仕組みを始め､本日議論のあった取り組みを具体化していきます。"}}},"rest_id":"2120455071116984667","unmention_data":{},"views":{"count":"314174","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120455071116984667","sortIndex":"2120712909536362454"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 