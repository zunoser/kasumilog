lity":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":28,"bookmarked":false,"conversation_id_str":"2120462883159187683","created_at":"Wed Nov 11 10:25:22 +0000 2026","display_text_range":[0,88],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/zMBRWTDR94","expanded_url":"https://x.com/kantei/status/2120462883159187683/video/1","ext_media_availability":{"status":"Available"},"id_str":"2120462312071106560","indices":[89,112],"media_key":"13_2120462312071106560","media_results":{"result":{"media_key":"13_2120462312071106560"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2120462312071106560/img/EbwG5gLqHfrP7pvN.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/zMBRWTDR94","video_info":{"aspect_ratio":[16,9],"duration_millis":218400,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2120462312071106560/pl/2TdCuOinwUgZXhma.m3u8?tag=29&v=6b8"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120462312071106560/vid/avc1/480x270/dCihTbTIuni394Xv.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120462312071106560/vid/avc1/640x360/L21oT3Qx2KDkFwfa.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120462312071106560/vid/avc1/1280x720/GPLFOPg1dR0d2-Xz.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/zMBRWTDR94","expanded_url":"https://x.com/kantei/status/2120462883159187683/video/1","ext_media_availability":{"status":"Available"},"id_str":"2120462312071106560","indices":[89,112],"media_key":"13_2120462312071106560","media_results":{"result":{"media_key":"13_2120462312071106560"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2120462312071106560/img/EbwG5gLqHfrP7pvN.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/zMBRWTDR94","video_info":{"aspect_ratio":[16,9],"duration_millis":218400,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2120462312071106560/pl/2TdCuOinwUgZXhma.m3u8?tag=29&v=6b8"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120462312071106560/vid/avc1/480x270/dCihTbTIuni394Xv.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120462312071106560/vid/avc1/640x360/L21oT3Qx2KDkFwfa.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120462312071106560/vid/avc1/1280x720/GPLFOPg1dR0d2-Xz.mp4?tag=29"}]}}]},"favorite_count":2831,"favorited":false,"full_text":"【お知らせ】\n本日（１１月１１日）、高市総理は、第１６回経済財政諮問会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございました。いつもありがとうございます。 https://t.co/zMBRWTDR94","id_str":"2120462883159187683","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":26,"reply_count":141,"retweet_count":371,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA0NjI4ODMwNjY4ODgxOTI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月１１日）、高市総理は、第１６回経済財政諮問会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様でございました。いつもありがとうございます。\n　今日一つ目の議題では、「高市内閣の1年間の振り返りを踏まえた今後の経済財政運営」について、議論を行いました。\n　民間議員の皆様からは、足元では、「賃金と物価の好循環」や「財政状況の改善」がみられるなど、「成長型経済への移行」に向けた確かな変化が現われているというご評価とともに、それを「強い経済」の実現と「財政の持続可能性」の確保の両立につなげることの必要性について、ご指摘をいただきました。\n　何よりも重要なことは、「実質所得」と「生産性」が持続的に高まり、国民の皆様が「暮らしの豊かさ」を実感できる「成長型経済」を目指す、実現していくことでございます。\n　このため、「当初予算」を中心とした予見可能性の高い､計画的な財政運営を進めることによって、官民の投資を促し、｢成長力の強化｣につなげてまいります。\n　また、政府としては､引き続き､現行の共同声明に基づき、日本銀行とともにそれぞれの役割を果たしながら、物価の安定と持続的な経済成長の実現に向けて連携をしてまいります。\n　城内大臣は､物価高に対する切れ目ない支援を講じる中で､賃上げ環境の整備に強力に取り組むとともに、金融資本市場の動向に細心の注意を払い、安定的なマクロ経済環境の確保に万全を期して下さい。\n　藤井大臣は、自治体の官公需における価格転嫁を進めるため、地方財政措置によるインセンティブの強化も含め、更なる転嫁を進めるためのより有効な方策を実行して下さい。\n　二つ目の議題では、「成長志向型で持続可能な社会基盤の強化」について、議論を行いました。\n　民間議員の皆様からは、「強い経済」の礎となる「教育・研究力の強化」や、「強い地方経済の実現」に向けた｢インフラ・公共サービス等の基盤強化｣に関して、令和９年度予算に反映すべき事項を含め、様々なご提案をいただきました。\n　城内大臣は、令和９年度予算に関わる本日の議論なども踏まえて、「予算編成の基本方針」のとりまとめを進めて下さい。\n　関大臣は、大学学部の成長分野への転換や量的規模の適正化を図るため､予算等による｢実効的なインセンティブ措置｣だけではなくて、｢統廃合に向けた大学の早期判断を促す制度的対応｣を含めて､本日議論のあった取組を具体化して下さい。\n　井林大臣は、特に、｢社会的割引率の見直し｣を含む｢公共事業評価の見直し｣について､できるだけ速やかに結論を出し、令和９年度から実行に移して下さい。\n　また、｢公共インフラの集約・再編・予防保全｣について、自治体任せにすることなく、国が一歩前に出て自治体の取組を後押しする仕組みを始め､本日議論のあった取組を具体化して下さい。\n　以上です。ありがとうございました。"}}},"rest_id":"2120462883159187683","unmention_data":{},"views":{"count":"58582","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120462883159187683","sortIndex":"2120712909536362460"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/x9Zav04GNW"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"co