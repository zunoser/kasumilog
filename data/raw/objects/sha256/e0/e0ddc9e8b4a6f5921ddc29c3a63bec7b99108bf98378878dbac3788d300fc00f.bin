sitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":7,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA2NTUzNTM5ODE2NTI5OTI=","richtext":{"richtext_tags":[]},"text":"10月14日(水)、朝日副大臣、青島政務官、髙橋政務官は、都内で開催された「第33回『鉄道の日』祝賀会」に出席しました。\n　朝日副大臣は、「我が国の鉄道は、広く人々に愛される信頼性の高い公共交通手段として、重要な役割を果たして来ている。本日お集まりの皆様をはじめ、我が国の鉄道の発展にご尽力された多くの関係者の皆様に、改めて敬意を表するとともに、感謝申し上げる。」と祝辞を述べました。"}}},"rest_id":"2110655354036158611","unmention_data":{},"views":{"count":"5888","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110655354036158611","sortIndex":"2110903885311770565"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":15},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/960685038957244417/qRIY3RTr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/719219671/1597226136"},"core":{"created_at":"Fri Jul 27 02:08:13 +0000 2012","name":"原子力規制委員会 / NRA Japan","screen_name":"gensiryokukisei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo3MTkyMTk2NzE=","is_blue_verified":false,"location":{"location":"日本"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2107017952050679971"]},"possibly_sensitive":false,"privacy":{"p