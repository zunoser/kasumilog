h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/3h2bdMFlQ9"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/3h2bdMFlQ9","expanded_url":"https://x.com/takaichi_sanae/status/2110641279013118407/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":81,"w":81,"x":1651,"y":53}]},"medium":{"faces":[{"h":48,"w":48,"x":967,"y":31}]},"orig":{"faces":[{"h":104,"w":104,"x":2097,"y":68}]},"small":{"faces":[{"h":27,"w":27,"x":548,"y":17}]}},"id_str":"2110640888003407872","indices":[136,159],"media_key":"3_2110640888003407872","media_results":{"result":{"media_key":"3_2110640888003407872"}},"media_url_https":"https://pbs.twimg.com/media/HUqAtHnbsAAC-ra.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":247},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/3h2bdMFlQ9"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/3h2bdMFlQ9","expanded_url":"https://x.com/takaichi_sanae/status/2110641279013118407/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":135,"w":135,"x":1035,"y":291}]},"medium":{"faces":[{"h":79,"w":79,"x":606,"y":170}]},"orig":{"faces":[{"h":172,"w":172,"x":1315,"y":370}]},"small":{"faces":[{"h":44,"w":44,"x":343,"y":96}]}},"id_str":"2110640902675017729","indices":[136,159],"media_key":"3_2110640902675017729","media_results":{"result":{"media_key":"3_2110640902675017729"}},"media_url_https":"https://pbs.twimg.com/media/HUqAt-RasAEUekC.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":278},{"h":1734,"w":1734,"x":238,"y":0},{"h":1734,"w":1521,"x":345,"y":0},{"h":1734,"w":867,"x":672,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/3h2bdMFlQ9"}]},"favorite_count":11229,"favorited":false,"full_text":"今朝、天皇皇后両陛下の御臨席を仰ぎ、地球環境に関する国際会議である『GEA国際会議2026』に参加いたしました。\n\n本年も、日本を含め世界各地で、極めて深刻な被害をもたらす災害が発生しており、自然災害が激甚化・頻発化しています。日本も、多くの自然災害に見舞われています。 https://t.co/3h2bdMFlQ9","id_str":"2110641279013118407","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":103,"reply_count":723,"retweet_count":1036,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA2NDEyNzg5NDYwMzc3NjA=","richtext":{"richtext_tags":[]},"text":"今朝、天皇皇后両陛下の御臨席を仰ぎ、地球環境に関する国際会議である『GEA国際会議2026』に参加いたしました。\n\n本年も、日本を含め世界各地で、極めて深刻な被害をもたらす災害が発生しており、自然災害が激甚化・頻発化しています。日本も、多くの自然災害に見舞われています。\n\n国内外で災害の犠牲となられた多くの方々の御霊に哀悼の誠を捧げますとともに、御遺族の皆様にお悔やみを申し上げます。被災された多くの皆様にお見舞い申し上げます。\n\n災害に対する強靱性の向上のため、防災などの「危機管理投資」を強化します。\n\nあわせて、世界屈指の我が国の防災や復興の知見・ノウハウを、「国際防災協力」を通じて共有していきます。\n\n今を生きる人々の命と未来を生きる人々の命を守るため、全ての国が、「気候変動対策」に真剣に取り組む必要があります。\n\n私は、「気候変動対策」と「経済成長」は両立できると信じています。\n\n日本はこれまで、\n・グリーン鉄を始めとした生産・技術基盤の構築、\n・世界最高効率のガス火力発電の利用、\n・更には、省エネ型データセンターの普及など、\n日本の技術力を生かし、2050年のネット・ゼロを目指して、GXの取組を進めています。\n\nこれらの取組を、「エネルギー需給構造強靱化総合パッケージ（パワーGX）」として強力に進めます。\n\nそして、「脱炭素化」と「エネルギー安全保障」、「経済成長」の同時達成を目指しています。\n\n「アジア・ゼロエミッション共同体（AZEC）」での取組を通じて、世界の気候変動対策に貢献していきます。\n\n日本は、GXの取組を通じて、地球環境の保全と豊かで持続可能な未来に向けて、具体的な行動を主導していきます。"}}},"rest_id":"2110641279013118407","unmention_data":{},"views":{"count":"264199","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110641279013118407","sortIndex":"2110903885311770555"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2107316172916130039"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstit