{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2110612076901421556","created_at":"Thu Oct 15 06:01:47 +0000 2026","display_text_range":[0,119],"entities":{"hashtags":[{"indices":[20,32],"text":"放課後ゲンバミッション"},{"indices":[100,104],"text":"ゲンミ"}]},"favorite_count":18,"favorited":false,"full_text":"╋━━━━━━━\n\n　YouTube　『#放課後ゲンバミッション！』\n\n　　　　　　　　　　　　　　━━━━━━╋\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「 #ゲンミ！（現場ミッション）」に挑戦✨","id_str":"2110612076901421556","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":6,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[20,32],"text":"放課後ゲンバミッション"},{"indices":[100,104],"text":"ゲンミ"},{"indices":[366,370],"text":"ゲンミ"},{"indices":[372,382],"text":"国交省建設産業PR"},{"indices":[383,394],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/GqLl1r5qtoU","expanded_url":"https://youtu.be/GqLl1r5qtoU","indices":[240,263],"url":"https://t.co/C7bbhIUCVb"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[341,364],"url":"https://t.co/kPJLLRPIOH"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA2MTIwNzY3NzU1NjMyNjQ=","richtext":{"richtext_tags":[]},"text":"╋━━━━━━━\n\n　YouTube　『#放課後ゲンバミッション！』\n\n　　　　　　　　　　　　　　━━━━━━╋\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「 #ゲンミ！（現場ミッション）」に挑戦✨\n\n今回は『法面（のりめん）工事』について能登半島地震の復旧・復興工事に携わる職人さんに間近で教えてもらいます！\n削孔機（さっこうき）という機械を使って穴を開け、その中に鉄筋を入れる作業にチャレンジ！\n\n果たしてミッション完了なるか！？\n\n📺https://t.co/C7bbhIUCVb?\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPIOH\n\n#ゲンミ！\n#国交省建設産業PR\n#MLIT建設産業PR"}}},"rest_id":"2110612076901421556","unmention_data":{},"views":{"count":"9885","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110612076901421556","sortIndex":"2110903885311770542"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2110903885311770707-tweet-2110608977402990741","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092927185678127486"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"農林水産省の公式アカウントです。ご意見・ご質問は、総合窓口にお寄せください。\n総合窓口→https://t.co/XLQwxIPiHh\n運用方針→https://t.co/2SnzXCNurZ","entities":{"description":{"urls":[{"display_url":"contactus.maff.go.jp/voice/sogo.html","expanded_url":"https://www.contactus.maff.go.jp/voice/sogo.html","indices":[44,67],"url":"https://t.co/XLQwxIPiHh"},{"display_url":"maff.go.jp/j/pr/social_me…","expanded_url":"https