/640x360/apsdttTCXdG6WN4U.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718083107287040/vid/avc1/1280x720/fNxpyWK8dlpBvE1l.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/V6YcLr1mmj","expanded_url":"https://x.com/kantei/status/2110718371759288373/video/1","ext_media_availability":{"status":"Available"},"id_str":"2110718083107287040","indices":[115,138],"media_key":"13_2110718083107287040","media_results":{"result":{"media_key":"13_2110718083107287040"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2110718083107287040/img/JCEjYDn7bxRmsWAo.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/V6YcLr1mmj","video_info":{"aspect_ratio":[16,9],"duration_millis":95833,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2110718083107287040/pl/tWNLPrHWKqGMO0r0.m3u8?tag=29&v=d8c"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718083107287040/vid/avc1/480x270/ytGIaNEeVF3gXTS3.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718083107287040/vid/avc1/640x360/apsdttTCXdG6WN4U.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718083107287040/vid/avc1/1280x720/fNxpyWK8dlpBvE1l.mp4?tag=29"}]}}]},"favorite_count":1405,"favorited":false,"full_text":"【お知らせ】\n本日（１０月１５日）、高市総理は、令和８年安全安心なまちづくり関係功労者表彰式を行いました。\n\n※高市総理挨拶要旨(速報版)\n　安全安心なまちづくり関係功労者表彰を受賞された皆様、本日は、誠におめでとうございます。 https://t.co/V6YcLr1mmj","id_str":"2110718371759288373","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":12,"reply_count":75,"retweet_count":163,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA3MTgzNzE2OTY0NjM4NzI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月１５日）、高市総理は、令和８年安全安心なまちづくり関係功労者表彰式を行いました。\n\n※高市総理挨拶要旨(速報版)\n　安全安心なまちづくり関係功労者表彰を受賞された皆様、本日は、誠におめでとうございます。 \n　皆様は、平素から、それぞれの地域・分野で防犯や再犯防止に関する取組にご尽力いただいており、長年にわたる多大なご貢献に対し、心より敬意を表し、感謝を申し上げます。 \n　良好な治安は、「日本列島を、強く豊かに」するための基盤となるものです。 \n　皆様の活動は、 \n・地域の防犯パトロール、 \n・サイバー空間の安全利用に関する広報啓発、 \n・犯罪をした人の社会復帰支援など、 \n　地域の暮らしと安全を守るために不可欠な活動です。 \n　政府としても、 皆様をはじめ、各地域で活動されている皆様と一層連携し、今を生きる国民の皆様も、未来を生きる国民の皆様も、安全で安心して暮らせる国を創るため、全力で取り組んでまいります。  \n　皆様のますますのご健勝とご活躍をお祈り申し上げます。"}}},"rest_id":"2110718371759288373","unmention_data":{},"views":{"count":"39408","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110718371759288373","sortIndex":"2110903885311770591"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"m