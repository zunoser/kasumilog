p/","indices":[0,23],"url":"https://t.co/nXofBu7sEB"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":323460,"following":3},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2891516809","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1899,"tweets":5983},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/nXofBu7sEB"}}}},"edit_control":{"edit_tweet_ids":["2110586680231297204"],"editable_until_msecs":"1792041652028","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2110586680231297204","created_at":"Thu Oct 15 04:20:52 +0000 2026","display_text_range":[0,140],"entities":{"user_mentions":[{"id_str":"1469058582","indices":[3,13],"name":"総務省","screen_name":"MIC_JAPAN"}]},"favorite_count":0,"favorited":false,"full_text":"RT @MIC_JAPAN: 不正アクセスにより、個人情報を含む情報が漏洩する事案が相次いでいます。\n事業者の皆様におかれましては、迅速な脆弱性対応や、多要素認証等の認証機能強化、委託先を含めた適切なセキュリティ対策の実施など、サイバーセキュリティ対策の一層の強化をお願いします…","id_str":"2110586680231297204","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":3739,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=jpg&name=120x120","width":120},"type":"IMAGE"}},{"key":"description","value":{"string_value":"　大量の個人情報を取り扱う事業者等の情報システムが不正アクセスにより侵入され、個人情報を含むデータが窃取される事案が相次いで確認されています。 　このような状況を踏まえ、内閣官房国家サイバー統括室から、事業者等に対し、迅速な脆弱性対応や、多要素認証等の認証機能の強化、漏えいした情報の悪用を防止する対策等について、委託先も含めた一層の対策の徹底を速やかに検討するよう、注意喚起が行われています。...","type":"STRING"}},{"key":"domain","value":{"string_value":"www.soumu.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=jpg&name=120x120","width":120},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=jpg&name=orig","width":120},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"1469058582","path":[]}}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2106374580218851328/wv1fN2nx?format=png&name=2048x2048_2_exp","width":120},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"soumu.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":61.44,"rgb":{"blue":255,"green":255,"red":255}},{"percentage":34.99,"rgb":{"blue":31,"green":140,"red":246}},{"percentage":2.69,"rgb":{"blue":159,"green":204,"red":251}},{"percentage":0.76,"rgb":{"blue":103,"green":176,"red":250}},{"percentage":0.12,"rgb":{"blue":92,"green":169,"red":249}}]},"type":"IMAGE_COLOR"}},{"key":"title","value":{"string_value":"総務省｜不正アクセスによる情報漏えい等の事案を踏まえた対応について（注意喚起）","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/w6OOZwaT4t","type":"STRING"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary","url":"https://t.co/w6OOZwaT4t","user_refs_results":[{"result":{"__typename":"