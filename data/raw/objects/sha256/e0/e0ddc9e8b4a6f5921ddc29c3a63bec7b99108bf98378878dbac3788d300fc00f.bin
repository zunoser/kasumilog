83},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/pXzGvzUOuQ","video_info":{"aspect_ratio":[9,16],"duration_millis":33033,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2110718910865813505/pl/eSl6Eavv6mgW25xk.m3u8?tag=29&v=ce6"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718910865813505/vid/avc1/320x568/ZwAgKIsfhnEi5Wvd.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718910865813505/vid/avc1/480x852/dweIrdcafCacTVPh.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718910865813505/vid/avc1/720x1280/CxE4pQ3oFQMfHWnK.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2110718910865813505/vid/avc1/1080x1920/26fwLoEYWIKbUt_m.mp4?tag=29"}]}}]},"favorite_count":1324,"favorited":false,"full_text":"令和８年安全安心なまちづくり関係功労者表彰式を行いました。受賞された皆様は、それぞれの地域・分野で防犯や再犯防止に関する取組にご尽力いただいており、長年にわたる多大なご貢献に対し、心より敬意を表し、感謝を申し上げます。良好な治安は、「日本列島を、強く豊かに」するための基盤となるも https://t.co/pXzGvzUOuQ","id_str":"2110719236696047710","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":12,"reply_count":151,"retweet_count":176,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA3MTkyMzY2NDE1NDIxNDQ=","richtext":{"richtext_tags":[]},"text":"令和８年安全安心なまちづくり関係功労者表彰式を行いました。受賞された皆様は、それぞれの地域・分野で防犯や再犯防止に関する取組にご尽力いただいており、長年にわたる多大なご貢献に対し、心より敬意を表し、感謝を申し上げます。良好な治安は、「日本列島を、強く豊かに」するための基盤となるものです。\n政府としても、皆様をはじめ、各地域で活動されている皆様と一層連携し、今を生きる国民の皆様も、未来を生きる国民の皆様も、安全で安心して暮らせる国を創るため、全力で取り組んでまいります。"}}},"rest_id":"2110719236696047710","unmention_data":{},"views":{"count":"40072","state":"EnabledWithCount"