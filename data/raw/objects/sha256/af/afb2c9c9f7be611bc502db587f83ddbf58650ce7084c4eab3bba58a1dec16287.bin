ティセミナーを実施しました。\nサイバー脅威に関する情報共有や各国との協力強化の重要性を再認識しました。\n今後も信頼醸成や能力構築などを通じて実践的な協力を推進していきます。\n\nACICE https://t.co/U1k7qQ9GNH","id_str":"2121150071228002815","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":3,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[16,22],"text":"ACICE"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"acice-asean.org","expanded_url":"https://www.acice-asean.org/","indices":[268,291],"url":"https://t.co/1E2AJiwFH2"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExNTAwNzEwOTM3NzYzODQ=","text":"11月12日、防衛省・自衛隊は #ACICE の専門家を招き、サイバーセキュリティセミナーを実施しました。\nサイバー脅威に関する情報共有や各国との協力強化の重要性を再認識しました。\n今後も信頼醸成や能力構築などを通じて実践的な協力を推進していきます。\n\nACICE （ADMMサイバーセキュリティ情報センター）とは、サイバー攻撃や偽・誤情報の脅威を背景に、ASEAN 防衛当局間の協力強化のために設立された機関です。\n2021年の第15回 ASEAN 国防相会議（ADMM）で設置が承認され、シンガポール国防省の主導で設立されました。\nhttps://t.co/1E2AJiwFH2"}}},"rest_id":"2121150071228002815","unmention_data":{},"views":{"count":"2068","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121150071228002815","sortIndex":"2121150344636399615"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2121135978303611239"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府の公式アカウントです。内閣府大臣官房政策評価広報課が運営しています。運営方針 https://t.co/LtXxYQ4rJW を御確認のうえ御利用ください。問い合わせは https://t.co/ANlK6wet0H","entities":{"description":{"urls":[{"display_url":"cao.go.jp/others/seihyou…","expanded_url":"https://www.cao.go.jp/others/seihyou/sns/x.html","indices":[42,65],"url":"https://t.co/LtXxYQ4rJW"},{"display_url":"cao.go.jp/goiken.html","expanded_url":"https://www.cao.go.jp/goiken.html","indices":[88,111],"url":"https://t.co/ANlK6wet0H"}]},"url":{"urls":[{"display_url":"cao.go.jp","expanded_url":"https://www.cao.go.jp/","indices":[0,23],"url":"https://t.co/8tRrZ0eypt"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":138572,"following":62},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2904127170","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1869,"tweets":10053},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/8tRrZ0eypt"}}}},"edit_control":{"edit_tweet_ids":["2121150038688870833"],"editable_until_msecs":"1794560152942","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":