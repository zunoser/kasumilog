apan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1267873,"following":45},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7898,"tweets":21987},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2121083718412685400"],"editable_until_msecs":"1794544340956","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2121083718412685400","created_at":"Fri Nov 13 03:32:20 +0000 2026","display_text_range":[0,140],"entities":{"user_mentions":[{"id_str":"2070308568658767872","indices":[3,17],"name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"}]},"favorite_count":0,"favorited":false,"full_text":"RT @PressSec_JMOD: 【11月13日　小泉防衛大臣会見】\n○防衛省職員の給与等に関する法律の改正案\n○三文書改定に向けた検討\n○米空母艦載機部隊配備特別交付金\n○沖縄全島エイサーまつり\nなどに関する質疑応答がありました。\n\n↓動画はこちら\nhttps://t.c…","id_str":"2121083718412685400","is_quote_status":fals