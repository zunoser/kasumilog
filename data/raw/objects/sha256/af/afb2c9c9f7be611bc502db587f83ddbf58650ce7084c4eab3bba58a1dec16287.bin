":"海上保安庁公式アカウントです。海上保安庁ホームページの新着情報を中心に、国民の皆さまにお知らせしたい情報を発信していきます。\n\n運用ポリシーはこちら\nhttps://t.co/UBPfTADUzc","entities":{"description":{"urls":[{"display_url":"kaiho.mlit.go.jp/soshiki/sns-ac…","expanded_url":"https://www.kaiho.mlit.go.jp/soshiki/sns-account.html","indices":[75,98],"url":"https://t.co/UBPfTADUzc"}]},"url":{"urls":[{"display_url":"kaiho.mlit.go.jp","expanded_url":"https://www.kaiho.mlit.go.jp/","indices":[0,23],"url":"https://t.co/1maG8nldqO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":279080,"following":32},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2916368839","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8321,"tweets":10408},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/1maG8nldqO"}}}},"edit_control":{"edit_tweet_ids":["2121145769327816884"],"editable_until_msecs":"1794559135000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2121145769327816884","created_at":"Fri Nov 13 07:38:55 +0000 2026","display_text_range":[0,142],"entities":{},"favorite_count":20,"favorited":false,"full_text":"【Microsoft365大規模障害に伴うメールシステムの不具合】\n本日発生したMicrosoft社の障害に伴い、海上保安庁ではメールの送受信ができておりません。本日、メールでご連絡いただいている場合、お手数ですが担当部署へお電話ください。\nなお、公式ウェブサイトに影響はありません。","id_str":"2121145769327816884","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":18,"retweeted":false,"user_id_str":"2916368839"},"rest_id":"2121145769327816884","unmention_data":{},"views":{"count":"1861","st