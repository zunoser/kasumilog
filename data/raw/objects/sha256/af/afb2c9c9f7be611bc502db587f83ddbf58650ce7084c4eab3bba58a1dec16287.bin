deo/2120897608189382656/pl/OyD8n2rGdYE9gNit.m3u8?tag=29&v=d2a"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120897608189382656/vid/avc1/320x568/1HRMv0ZmQGL9JkwX.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120897608189382656/vid/avc1/480x852/6uPR649GQ0_7tfWk.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120897608189382656/vid/avc1/720x1280/9Ui-szCQUNzwhCio.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120897608189382656/vid/avc1/1080x1920/TjjOmXfD3stfIc9t.mp4?tag=29"},{"bitrate":25128000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120897608189382656/vid/avc1/2160x3840/J9sF--pwwumgvkd4.mp4?tag=29"}]}}]},"favorite_count":23625,"favorited":false,"full_text":"【Pickup】日本を守る、防衛産業の皆さんへ\n \n心ない言葉が投げかけられ、肩身の狭い思いをされた時代もあったと思います。\n\n今でもそういうこともあるかもしれません。\n\nそれでも\n\n「日本の防衛を支えるのは自分達だ」 https://t.co/UekPJxgieR","id_str":"2120897760752968138","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":622,"quoted_status_id_str":"2120824115208831292","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2120824115208831292","url":"https://t.co/5nlwlMD13W"},"reply_count":572,"retweet_count":4837,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA4OTc3NjA2OTg0NTQwMTY=","text":"【Pickup】日本を守る、防衛産業の皆さんへ\n \n心ない言葉が投げかけられ、肩身の狭い思いをされた時代もあったと思います。\n\n今でもそういうこともあるかもしれません。\n\nそれでも\n\n「日本の防衛を支えるのは自分達だ」\n\nという強い使命感を持って、自衛隊が必要とする装備品を造り、直し、部品を供給し、技術を守り、人を育ててくださいました。\n\n自分の国は自分で守る。\n\nその覚悟で、防衛産業基盤を強化します。\n\n国が先頭に立ちます。\n\n防衛産業の皆さん、日本の防衛産業の新しい時代を、共につくっていきましょう。\