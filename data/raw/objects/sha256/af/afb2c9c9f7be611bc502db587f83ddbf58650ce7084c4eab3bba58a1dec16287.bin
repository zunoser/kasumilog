},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1793582764"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2119704741051785477"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6l1S0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":299279,"following":90},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4996,"tweets":13020},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2121068028527829348"],"editable_until_msecs":"1794540600000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2121068028527829348","created_at":"Fri Nov 13 02:30:00 +0000 2026","display_text_range":[0,170],"entities":{"media":[{"display_url":"pic.x.com/OKBmQFyKLG","expanded_url":"https://x.com/gov_online/status/2121068028527829348/photo/1","ext_alt_text":"１１月１５日（日曜日）放送テーマは、「どこからが危険運転？改正された法律と運転のルール」。番組パーソナリティの杉浦太陽さん、松井玲奈さんが法務省のパネルを持って並んで立っている。杉浦太陽さんが持つパネルには、「危険運転致死しょうざいが改正」、「飲酒運転こきちゅうアルコール濃度0.5ミリグラム以上」、「法定刑20年以下の拘禁刑」、「飲んだら乗るな！」と書かれている。松井玲奈さんが持つパネルには、「危険運転致死しょうざいが改正」、「最高速度60km/h以下の道路で50km/h超過」、「最高速度60km/h超の道路で60km/h超過」、「法定刑20年以下の拘禁刑」、「最高速度を守って安全運転を！」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":173,"w":173,"x":1109,"y":955},{"h":275,"w":275,"x":465,"y":431},{"h":263,"w":263,"x":1237,"y":287},{"h":201,"w":201,"x":505,"y":657}]},"medium":{"faces":[{"h":101,"w":101,"x":650,"y":560},{"h":161,"w":161,"x":272,"y":252},{"h":154,"w":154,"x":725,"y":168},{"h":118,"w":118,"x":296,"y":385}]},"orig":{"faces":[{"h":254,"w":254,"x":1625,"y":1400},{"h":404,"w":404,"x":682,"y":632},{"h":386,"w":386,"x":1813,"y":421},{"h":295,"w":295,"x":741,"y":963}]},"small":{"faces":[{"h":57,"w":57,"x":368,"y":317},{"h":91,"w":91,"x":154,"y":143},{"h":87,"w":87,"x":410,"y":95},{"h":66,"w":66,"x":167,"y":218}]}},"id_str":"2120431738212216833","indices":[171,194],"media_key":"3_2120431738212216833","media_results":{"result":{"media_key":"3_2120431738212216833"}},"media_url_https":"https://pbs.twimg.com/media/HW1Jbm6acAEq5cN.jpg","original_info":{"focus_rects":[{"h":1680,"w":3000,"x":0,"y":885},{