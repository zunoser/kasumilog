wed_by":false,"super_following":false,"tweet_counts":{"media_tweets":636,"tweets":1961},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2121142487242915987"],"editable_until_msecs":"1794558352000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":14,"bookmarked":false,"conversation_id_str":"2121142487242915987","created_at":"Fri Nov 13 07:25:52 +0000 2026","display_text_range":[0,125],"entities":{},"favorite_count":1070,"favorited":false,"full_text":"山崎正昭先生のご逝去の報に接し、謹んで哀悼の誠を捧げます。\n\n山崎先生は、参議院議員として長きにわたり国政の要職を歴任されました。\nとりわけ、第30代参議院議長として、公正かつ円満な議会運営に尽力され、我が国憲政の発展に多大なるご功績を残されました。","id_str":"2121142487242915987","is_quote_status":false,"lang":"ja","quote_count":5,"reply_count":37,"retweet_count":102,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExNDI0ODcxOTI2MjUxNTI=","richtext":{"richtext_tags":[]},"text":"山崎正昭先生のご逝去の報に接し、謹んで哀悼の誠を捧げます。\n\n山崎先生は、参議院議員として長きにわたり国政の要職を歴任されました。\nとりわけ、第30代参議院議長として、公正かつ円満な議会運営に尽力され、我が国憲政の発展に多大なるご功績を残されました。\nまた、郷土福井の発展にも心血を注がれ、そのお人柄は多くの方々から深く敬愛されました。\n\nここに生前のご功績を偲び、深い敬意と感謝の意を表します。\n\n山崎正昭先生のご冥福を、心よりお祈り申し上げます。"}}},"rest_id":"2121142487242915987","unmention_data":{},"views":{"count":"55617","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121142487242915987","sortIndex":"2121150344636399609"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","t