pename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075605,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":636,"tweets":1961},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2121078624459891068"],"editable_until_msecs":"1794543126000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":44,"bookmarked":false,"conversation_id_str":"2121078624459891068","created_at":"Fri Nov 13 03:12:06 +0000 2026","display_text_range":[0,107],"entities":{},"favorite_count":4986,"favorited":false,"full_text":"今朝の閣議終了後に、「令和8年熊本地震災害復旧復興本部会議（第２回）」を開催しました。\n\n本日（13日）は、熊本県の木村知事にもご出席いただき、熊本県が作成した『復旧・復興プラン』についてもご説明をいただきました。","id_str":"2121078624459891068","is_quote_status":false,"lang":"ja","quote_count":54,"reply_count":393,"retweet_count":538,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjEwNzg2MjQzODAxMzMzNzY=","richtext":{"richtext_tags":[]},"text":"今朝の閣議終了後に、「令和8年熊本地震災害復旧復興本部会議（第２回）」を開催しました。\n\n本日（13日）は、熊本県の木村知事にもご出席いただき、熊本県が作成した『復旧・復興プラン』についてもご説明をいただきました。\n\n「最速で目指す痛みの最小化」を実現し、「被災地の新たな創造的復興」を進めていく。\n\nそのためには、国と県、市町村が目標と課題を共有し、具体的な取組を着実に進めることが重要です。\n\n各大臣には、防災庁を司令塔として、県をはじめとする関係自治体と緊密に連携し、『復旧・復興プラン』の実現に向けた支援を進めるよう、指示をしました。\n\n＜復興基金について＞\n\n熊本県が設置する復興基金に対しては、平成28年熊本地震と同様の考え方により、520億円を「特別交付税」により措置することとしました。\n\nこれにより、県が策定した『復旧・復興プラン』に基づき、県や県内市町村が行う、多重被災者への手厚い支援や、井戸の復旧をはじめとした被災地域特有の課題への対応など、住民の皆様のニーズに沿ったきめ細かな事業を支援します。\n\n＜生活再建の推進について＞\n\n発災から100日余りが経過し、被災地は、被災後、初めての冬を迎えます。\n\n細野防災大臣を中心に、避難所などに避難されている方々が、寒さや保健・衛生面などに不安を抱くことのないよう、避難生活環境の改善に重点的に取り組むとともに、建設型応急住宅の年内整備に向けた取組を加速するよう、指示をしました。\n\n『復旧・復興プラン』では、公費解体について、令和9年12月中の終了を目指す方針が示されています。\n笹川環境大臣には、その円滑な実施に向けて、財政支援や人的・技術的支援を更に進めるよう、指示をしました。\n\nまた、井林国土交通大臣を中心に、公共土木施設などの復旧、井戸の早期復旧に向け、施工体制の確保など、取組を進めるよう、指示をしました。\n\n＜なりわい再建の推進について＞\n\n度重なる災害で被災された事業者の皆様は、厳しい状況に置かれています。\n片山財務大臣、髙木経済産業副大臣には、年内を目途に組成する「令和8年熊本地震復興支援ファンド」などにより、被災事業者の事業再開に向けた取組を更に進めるよう、指示をしました。\n\n政府が『支援パッケージ』にまとめた施策を着実かつ迅速に推進するとともに、本日、木村知事にご説明いただいた『復旧・復興プラン』をしっかりと支援することで、被災された方々、被災自治体のため、一丸となって全力で取り組んでいきます。"}}},"rest_id":"2121078624459891068","unmention_data":{},"views":{"count":"195546","state":"EnabledWithCount"}}}}},"entryId":"tweet-2121078624459891068","sortIndex":"2121150344636399570"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2120307037871776113"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display