23],"url":"https://t.co/NPEOH6ku2s"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":296642,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4947,"tweets":12932},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6ku2s"}}}},"edit_control":{"edit_tweet_ids":["2100049532608495812"],"editable_until_msecs":"1789529400000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2100049532608495812","created_at":"Wed Sep 16 02:30:00 +0000 2026","display_text_range":[0,142],"entities":{"hashtags":[{"indices":[2,11],"text":"令和８年熊本地震"}],"media":[{"display_url":"pic.x.com/o9sFY1FKuP","expanded_url":"https://x.com/gov_online/status/2100049532608495812/photo/1","ext_alt_text":"上部に「令和8年熊本地震で被害を受けられたかたへ。国税の申告・納付等の期限が延長されています。」と記載されており、その横に、申告書やお金のイラストが描かれている。その下には、次のように記載されている。熊本県八代市、宇土市、うき市及び八代郡氷川町においては、納税者のかたが申請することなく、国税に関する申告・納付等の期限の延長ができます。そのほかの地域に納税地のあるかたであっても、災害により申告・納付等をその期限までにできないとき（交通途絶等）は、所轄税務署長に申請し、その承認を受けることにより、その理由のやんだ日から2か月以内の範囲でその期限の延長を受けられます。詳しくは国税庁の情報をご確認ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100033246998503424","indices":[143,166],"media_key":"3_2100033246998503424","media_results":{"result":{"media_key":"3_2100033246998503424"}},"media_url_https":"https://pbs.twimg.com/media/HSTRHJfbIAA0J1Z.jpg","original_info":{"focus_rects":[{"h":598,"w":1067,"x":0,"y":150},{"h":1067,"w":1067,"x":0,"y":0},{"h":1200,"w":1053,"x":0,"y":0},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":1067,"x":0,"y":0}],"height":1200,"width":1067},"sizes":{"large":{"h":1200,"resize":"fit","w":1067},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/o9sFY1FKuP"}],"urls":[{"display_url":"nta.go.jp//taxes/shirabe…","expanded_url":"https://www.nta.go.jp//taxes/shiraberu/saigai/r8/kumamoto/index.htm","indices":[108,131],"url":"https://t.co/3jp7HQRbIe"}],"user_mentions":[{"id_str":"236682791","indices":[132,142],"name":"国税庁","screen_name":"NTA_Japan"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/o9sFY1FKuP","expanded_url":"https://x.com/gov_online/status/2100049532608495812/photo/1","ext_alt_text":"上部に「令和8年熊本地震で被害を受けられたかたへ。国税の申告・納付等の期限が延長されています。」と記載されており、その横に、申告書やお金のイラストが描かれている。その下には、次のように記載されている。熊本県八代市、宇土市、うき市及び八代郡氷川町においては、納税者のかたが申請することなく、国税に関する申告・納付等の期限の延長ができます。そのほかの地域に納税地のあるかたであっても、災害により申告・納付等をその期限までにできないとき（交通途絶等）は、所轄税務署長に申請し、その承認を受けることにより、その理由のやんだ日から2か月以内の範囲でその期限の延長を受けられます。詳しくは国税庁の情報をご確認ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100033246998503424","indices":[143,166],"media_key":"3_2100033246998503424","media_results":{"result":{"media_key":"3_2100033246998503424"}},"media_url_https":"https://pbs.twimg.com/media/HSTRHJfbIAA0J1Z.jpg","original_info":{"focus_rects":[{"h":598,"w":1067,"x":0,"y":150},{"h":1067,"w":1067,"x":0,"y":0},{"h":1200,"w":1053,"x":0,"y":0},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":1067,"x":0,"y":0}],"height":1200,"width":1067},"sizes":{"large":{"h":1200,"resize":"fit","w":1067},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/o9sFY1FKuP"}]},"favorite_count":33,"favorited":false,"full_text":"【 #令和８年熊本地震 】\n熊本県八代市、宇土市、宇城市及び八代郡氷川町の方々においては、令和８年熊本地震に伴い、国税の申告、申請、納付等の期限が延長されています📅\n\n詳しくは国税庁のホームページをご確認ください。\nhttps://t.co/3jp7HQRbIe\n@NTA_Japan https://t.co/o9sFY1FKuP","id_str":"2100049532608495812","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":21,"retweeted":false,"user_id_str":"461064204"},"rest_id":"2100049532608495812","source":"<a href=\"https://twitter.com\" rel=\"nofollow\">TweetDeck Web App</a>","unmention_data":{},"views":{"count":"4425","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100049532608495812","sortIndex":"2100103057936220133"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":