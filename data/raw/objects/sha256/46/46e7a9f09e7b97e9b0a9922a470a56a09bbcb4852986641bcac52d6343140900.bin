twimg.com/amplify_video/2099807357115224064/vid/avc1/640x360/muX2P2FUrHBV5E8k.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2099807357115224064/vid/avc1/1280x720/TRpltG0jxxwPZf8f.mp4?tag=29"}]}}]},"favorite_count":2905,"favorited":false,"full_text":"9月15日、防衛省が借り上げている民間船舶「はくおうⅡ」は、任務を終え、熊本県の八代港を出港しました。\n岸壁には、多くの市民の皆様がお見送りに駆けつけてくださり、温かい感謝の言葉をいただきました。 https://t.co/dZ8XyUBX5S","id_str":"2099807772938485896","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":28,"quoted_status_id_str":"2099136262296969508","quoted_status_permalink":{"display":"x.com/ModJapan_saiga…","expanded":"https://twitter.com/ModJapan_saigai/status/2099136262296969508","url":"https://t.co/2JtaOawOk5"},"reply_count":33,"retweet_count":663,"retweeted":false,"user_id_str":"1182556649120075776"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk4MDc3NzI4Nzk4NDMzMjg=","richtext":{"richtext_tags":[]},"text":"9月15日、防衛省が借り上げている民間船舶「はくおうⅡ」は、任務を終え、熊本県の八代港を出港しました。\n岸壁には、多くの市民の皆様がお見送りに駆けつけてくださり、温かい感謝の言葉をいただきました。\n\n避難生活を余儀なくされる中、多くの皆様に入浴・宿泊・食事支援などをご利用いただきました。\n「はくおうⅡ」の活動が、厳しい避難生活の中で、少しでも皆様の安らぎにつながっていたのであれば幸いです。\n\nご協力いただいた医療関係団体や関係機関の皆様に改めて感謝申し上げます。\n防衛省・自衛隊は、今回いただいた多くの激励を胸に、今後も国民の皆様の安心と安全のため全力を尽くしてまいります。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2455},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182592351472013314/X9jVEv2u_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1182556649120075776/1570786963"},"core":{"created_at":"Fri Oct 11 07:21:20 +0000 2019","name":"防衛省・自衛隊（災害対策）","screen_name":"ModJapan_saigai"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_