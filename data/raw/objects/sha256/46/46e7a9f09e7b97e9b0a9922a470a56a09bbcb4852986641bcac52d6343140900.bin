,"w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/t9oipt2BRj"},{"display_url":"pic.x.com/t9oipt2BRj","expanded_url":"https://x.com/ModJapan_jp/status/2099798133173834068/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":76,"w":76,"x":934,"y":612},{"h":72,"w":72,"x":1244,"y":614},{"h":84,"w":84,"x":128,"y":632},{"h":74,"w":74,"x":658,"y":652},{"h":74,"w":74,"x":1698,"y":652},{"h":78,"w":78,"x":1808,"y":684},{"h":96,"w":96,"x":1934,"y":670}]},"medium":{"faces":[{"h":44,"w":44,"x":547,"y":358},{"h":42,"w":42,"x":728,"y":359},{"h":49,"w":49,"x":75,"y":370},{"h":43,"w":43,"x":385,"y":382},{"h":43,"w":43,"x":994,"y":382},{"h":45,"w":45,"x":1059,"y":400},{"h":56,"w":56,"x":1133,"y":392}]},"orig":{"faces":[{"h":76,"w":76,"x":934,"y":612},{"h":72,"w":72,"x":1244,"y":614},{"h":84,"w":84,"x":128,"y":632},{"h":74,"w":74,"x":658,"y":652},{"h":74,"w":74,"x":1698,"y":652},{"h":78,"w":78,"x":1808,"y":684},{"h":96,"w":96,"x":1934,"y":670}]},"small":{"faces":[{"h":25,"w":25,"x":310,"y":203},{"h":23,"w":23,"x":413,"y":203},{"h":27,"w":27,"x":42,"y":209},{"h":24,"w":24,"x":218,"y":216},{"h":24,"w":24,"x":563,"y":216},{"h":25,"w":25,"x":600,"y":227},{"h":31,"w":31,"x":642,"y":222}]}},"id_str":"2099798122201587712","indices":[130,153],"media_key":"3_2099798122201587712","media_results":{"result":{"media_key":"3_2099798122201587712"}},"media_url_https":"https://pbs.twimg.com/media/HSP7RFXboAAZnJ0.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1536,"w":1536,"x":0,"y":0},{"h":1536,"w":1347,"x":0,"y":0},{"h":1536,"w":768,"x":281,"y":0},{"h":1536,"w":2048,"x":0,"y":0}],"height":1536,"width":2048},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/t9oipt2BRj"}]},"favorite_count":324,"favorited":false,"full_text":"8月26日、ギリシャを訪れた宮