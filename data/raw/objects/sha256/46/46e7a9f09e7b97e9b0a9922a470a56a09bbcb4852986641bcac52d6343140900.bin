_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk4MjYzNzM4NzUzNTU2NDg=","richtext":{"richtext_tags":[]},"text":"本日、防災功労者内閣総理大臣表彰を行いました。\n表彰を受けられた皆様のご貢献、ご労苦に対し、心より敬意を表しますとともに、深く感謝申し上げます。\n災害への対応に万全を期すためには、全ての関係者の皆様の知恵と力を結集して、取り組む必要があり、「産官学民」の連携が不可欠です。\n表彰を受けられた皆様が、それぞれの分野において、益々ご活躍されることをお祈り致しますとともに、災害に強い国づくりに、一層ご尽力いただけますよう、お願い申し上げました。"}}},"rest_id":"2099826373929861371","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"53966","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099826373929861371","sortIndex":"2100103057936220117"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"d