info":{"focus_rects":[{"h":460,"w":822,"x":0,"y":611},{"h":822,"w":822,"x":0,"y":249},{"h":937,"w":822,"x":0,"y":134},{"h":1071,"w":536,"x":0,"y":0},{"h":1071,"w":822,"x":0,"y":0}],"height":1071,"width":822},"sizes":{"large":{"h":1071,"resize":"fit","w":822},"medium":{"h":1071,"resize":"fit","w":822},"small":{"h":680,"resize":"fit","w":522},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/vEWIfH0I8y"},{"display_url":"pic.x.com/vEWIfH0I8y","expanded_url":"https://x.com/ModJapan_jp/status/2125184647646921204/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2125184641833517056","indices":[141,164],"media_key":"3_2125184641833517056","media_results":{"result":{"media_key":"3_2125184641833517056"}},"media_url_https":"https://pbs.twimg.com/media/HX4sLAqaQAAImcO.jpg","original_info":{"focus_rects":[{"h":414,"w":740,"x":0,"y":134},{"h":740,"w":740,"x":0,"y":0},{"h":844,"w":740,"x":0,"y":0},{"h":1051,"w":526,"x":107,"y":0},{"h":1051,"w":740,"x":0,"y":0}],"height":1051,"width":740},"sizes":{"large":{"h":1051,"resize":"fit","w":740},"medium":{"h":1051,"resize":"fit","w":740},"small":{"h":680,"resize":"fit","w":479},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/vEWIfH0I8y"}]},"favorite_count":1940,"favorited":false,"full_text":"令和８年１１月２４日（火）午前４時頃、海上自衛隊は、都井岬（宮崎県）の南東約７０ｋｍの海域において、同海域を北西進する中国海軍レンハイ級ミサイル駆逐艦（艦番号「１０２」）、ルーヤンⅢ級ミサイル駆逐艦（艦番号「１１７」）、ジャンカイⅡ級フリゲート（艦番号「５４６」）及びフチ級補給艦 https://t.co/vEWIfH0I8y","id_str":"2125184647646921204","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":17,"quoted_status_id_str":"2125182659311845543","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2125182659311845543","url":"https://t.co/XBz1qglQeT"},"reply_count":30,"retweet_count":442,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUxODQ2NDc1OTIzNjYwODE=","text":"令和８年１１月２４日（火）午前４時頃、海上自衛隊は、都井岬（宮崎県）の南東約７０ｋｍの海域において、同海域を北西進する中国海軍レンハイ級ミサイル駆逐艦（艦番号「１０２」）、ルーヤンⅢ級ミサイル駆逐艦（艦番号「１１７」）、ジャンカイⅡ級フリゲート（艦番号「５４６」）及びフチ級補給艦（艦番号「９０３」）の計４隻を確認した。\nその後、これらの艦艇が大隅海峡を西進し、東シナ海に向けて航行したことを確認した。\nなお、これらの艦艇は、１０月２７日（火）に沖縄本島と宮古島（沖縄県）との間の海域を南東進したものと同一である。\n防衛省・自衛隊は、海上自衛隊の第３哨戒防備隊所属「みくま」（佐世保）、第１航空群所属「Ｐ－１」（鹿屋）及び第４航空群所属「Ｐ－１」（厚木）により、警戒監視・情報収集を行った。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3294},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationsh