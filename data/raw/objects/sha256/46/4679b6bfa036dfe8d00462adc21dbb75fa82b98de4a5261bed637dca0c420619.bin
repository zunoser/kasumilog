4AANtcZ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":0,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/N85kAnwKac"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/N85kAnwKac","expanded_url":"https://x.com/takaichi_sanae/status/2125174363175678061/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2125173440084852736","indices":[98,121],"media_key":"3_2125173440084852736","media_results":{"result":{"media_key":"3_2125173440084852736"}},"media_url_https":"https://pbs.twimg.com/media/HX4h--5aQAAsSis.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":628,"y":0},{"h":1734,"w":1521,"x":735,"y":0},{"h":1734,"w":867,"x":1062,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/N85kAnwKac"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/N85kAnwKac","expanded_url":"https://x.com/takaichi_sanae/status/2125174363175678061/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":103,"w":103,"x":13,"y":493}]},"medium":{"faces":[{"h":60,"w":60,"x":7,"y":289}]},"orig":{"faces":[{"h":132,"w":132,"x":17,"y":627}]},"small":{"faces":[{"h":34,"w":34,"x":4,"y":163}]}},"id_str":"2125173468199313408","indices":[98,121],"media_key":"3_2125173468199313408","media_results":{"result":{"media_key":"3_2125173468199313408"}},"media_url_https":"https://pbs.twimg.com/media/HX4iAnoa4AANtcZ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":0,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/N85kAnwKac"}]},"favorite_count":10261,"favorited":false,"full_text":"本日、経済財政諮問会議を開催し、「社会保障制度改革」や『予算編成の基本方針』について議論を行いました。\n\nまず、｢社会保障制度改革｣については、民間議員の皆様から、様々なご提案をいただきました。 https://t.co/N85kAnwKac","id_str":"2125174363175678061","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":147,"reply_count":1802,"retweet_count":1128,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUxNzQzNjMwOTE4Njk2OTY=","richtext":{"richtext_tags":[]},"text":"本日、経済財政諮問会議を開催し、「社会保障制度改革」や『予算編成の基本方針』について議論を行いました。\n\nまず、｢社会保障制度改革｣については、民間議員の皆様から、様々なご提案をいただきました。\n高市内閣は、｢経済成長」と｢社会保障の持続可能性」がともに、｢安心･安全で豊かな暮らし｣の実現を支える構造を作るため､｢現役世代の保険料率の上昇を止め、引き下げていく」との方針に沿って、｢社会保障制度が果たす機能を損なわないよう｣配慮しつつ、改革を進めていきます。\n\n令和９年度予算編成過程に向けて、\n・経済・物価動向等の適切な反映、他職種と遜色のない処遇改善、介護予防の強化、新技術の最大活用などの観点も踏まえ、｢令和９年度介護報酬・障害福祉報酬改定｣の検討を進めます。\n・年齢だけに着目するのではなく、所得・資産などの負担能力も勘案し、｢全世代が公正・公平に支え合う仕組み｣を構築する観点から、サービスの適正な利用への影響に留意しつつ、高齢者医療の窓口負担の見直し、介護保険２割負担の範囲の見直し及び金融所得の勘案などの検討を進めます。\n\nまた、『骨太方針2027』に向け､\n・年齢･性別に関らず､意欲と能力に応じ労働参加が可能となるよう､｢攻めの予防医療｣や｢健康寿命の延伸｣に向けた具体策、｢働き方に中立的な制度の構築｣などに向けた検討を進めます。\n・与党での議論も踏まえ、前述の内閣の方針に沿って、今年度中に、改革項目の具体化と工程の明確化を進めます。\n\n次に、『令和９年度予算編成の基本方針』については、「責任ある積極財政」元年に相応しい、原案をまとめて頂きました。\n\n第１に、歳出・歳入両面から予算の全体像を示すことです｡\n\n・初めて、税収・税外収入を含む歳入の考え方を本格的に整理し、\n・必要な財政需要の積上げ、税収見積もりの精緻化を徹底した上で､\n・新規国債発行額は、歳出・歳入両面の取組を反映した結果として､債務残高対ＧＤＰ比を安定的に引き下げていく中でも可能となる財政規模を精査し、適切にコントロールするという考え方を明らかにしました。\n\n第２に、必要な財政需要に確実に対応することです。\n\n・物価・賃金上昇の動向を歳出予算に反映するとともに、\n・「日本成長戦略実行計画」や「地域未来戦略実現フレーム」の具体化と連動するなど、必要な財政需要に確実に対応する。\n・その際、｢基金｣や｢国庫債務負担行為｣等を活用し、複数年度で対応することにより､｢予見可能性｣を高めつつ､\n・外部の専門的知見も活用し、｢目標の進捗管理｣･｢効果検証｣・｢施策の見直し｣を徹底することとしました。\n\n第３に、補正予算への依存から脱却することです。\n\n・これまで補正予算で措置してきた施策のうち、継続的に必要なものは当初予算で措置することを基本とし、\n・当初予算中心の予見可能性の高い計画的な財政運営を通じて、補正予算は、災害対応など、真に必要な場合に限定します。\n\nその上で、\n・この原案をベースに与党との調整を行った上で、次回の会議に、その成案を提出します。\n・また、こうした方針に沿って、｢令和９年度予算｣と共に、｢令和８年度第２次補正予算｣の編成に当たってまいります。"}}},"rest_id":"2125174363175678061","unmention_data":{},"views":{"count":"346303","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125174363175678061","sortIndex":"2125719019766939561"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2123372392798142557"]},"possibly_sensitive":false