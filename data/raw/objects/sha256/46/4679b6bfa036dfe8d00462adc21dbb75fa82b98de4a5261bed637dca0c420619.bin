693933056","indices":[141,164],"media_key":"3_2125178294693933056","media_results":{"result":{"media_key":"3_2125178294693933056"}},"media_url_https":"https://pbs.twimg.com/media/HX4mZjuaMAAWd-C.jpg","original_info":{"focus_rects":[{"h":414,"w":740,"x":0,"y":134},{"h":740,"w":740,"x":0,"y":0},{"h":844,"w":740,"x":0,"y":0},{"h":1051,"w":526,"x":107,"y":0},{"h":1051,"w":740,"x":0,"y":0}],"height":1051,"width":740},"sizes":{"large":{"h":1051,"resize":"fit","w":740},"medium":{"h":1051,"resize":"fit","w":740},"small":{"h":680,"resize":"fit","w":479},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/zA4bQ9MPO0"}]},"favorite_count":1526,"favorited":false,"full_text":"令和８年１１月２４日（火）午前４時頃、海上自衛隊は、都井岬（宮崎県）の南東約７０ｋｍの海域において、同海域を北西進する中国海軍レンハイ級ミサイル駆逐艦（艦番号「１０２」）、ルーヤンⅢ級ミサイル駆逐艦（艦番号「１１７」）、ジャンカイⅡ級フリゲート（艦番号「５４６」）及びフチ級補給艦 https://t.co/zA4bQ9MPO0","id_str":"2125182659311845543","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":14,"reply_count":28,"retweet_count":414,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUxODI2NTkyNjk5Njc4NzI=","text":"令和８年１１月２４日（火）午前４時頃、海上自衛隊は、都井岬（宮崎県）の南東約７０ｋｍの海域において、同海域を北西進する中国海軍レンハイ級ミサイル駆逐艦（艦番号「１０２」）、ルーヤンⅢ級ミサイル駆逐艦（艦番号「１１７」）、ジャンカイⅡ級フリゲート（艦番号「５４６」）及びフチ級補給艦（艦番号「９０３」）の計４隻を確認した。\nその後、これらの艦艇が大隅海峡を西進し、東シナ海に向けて航行したことを確認した。\nなお、これらの艦艇は、１０月２７日（火）に沖縄本島と宮古島（沖縄県）との間の海域を南東進したものと同一である。\n防衛省・自衛隊は、海上自衛隊の第３哨戒防備隊所属「みくま」（佐世保）、第１航空群所属「Ｐ－１」（鹿屋）及び第４航空群所属「Ｐ－１」（厚木）により、警戒監視・情報収集を行った。"}}},"rest_id":"2125182659311845543","unmention_data":{},"views":{"count":"106312","state":"EnabledWithCount"}}},"rest_id":"2125184647646921204","unmention_data":{},"views":{"count":"147502","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125184647646921204","sortIndex":"2125719019766939569"},{"content":{"__typename":"TimelineTimelineItem"