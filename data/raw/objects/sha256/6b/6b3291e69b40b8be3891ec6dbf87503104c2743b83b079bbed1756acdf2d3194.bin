d":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2119704741051785477"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6l1S0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":299569,"following":90},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":5002,"tweets":13029},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2123582098292298165"],"editable_until_msecs":"1795140001000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2123582098292298165","created_at":"Fri Nov 20 01:00:01 +0000 2026","display_text_range":[0,165],"entities":{"media":[{"display_url":"pic.x.com/J5xUIlsI1F","expanded_url":"https://x.com/gov_online/status/2123582098292298165/photo/1","ext_alt_text":"１１月２２日（日曜日）放送テーマは、「得意を生かして、みんな笑顔に！農福連携」。番組パーソナリティの杉浦太陽さん、松井玲奈さんが農福連携の法被を着て、並んで立っている。杉浦太陽さんと松井玲奈さんは、農林水産省のポスターと小さなのぼりを持っている。ポスターと杉浦太陽さんが持っているのぼりには、「１１月２９日はノウフクの日！」と書かれている。また、松井玲奈さんが持っているのぼりには、「みんなで耕そう！農福連携」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":126,"w":126,"x":692,"y":69},{"h":120,"w":120,"x":344,"y":147}]},"medium":{"faces":[{"h":126,"w":126,"x":692,"y":69},{"h":120,"w":120,"x":344,"y":147}]},"orig":{"faces":[{"h":126,"w":126,"x":692,"y":69},{"h":120,"w":120,"x":344,"y":147}]},"small":{"faces":[{"h":71,"w":71,"x":392,"y":39},{"h":68,"w":68,"x":194,"y":83}]}},"id_str":"2122965432592379905","indices":[166,189],"media_key":"3_2122965432592379905","media_results":{"result":{"media_key":"3_2122965432592379905"}},"media_url_https":"https://pbs.twimg.com/media/HXZJ0CAaMAEBLCt.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":1200,"w":1200,"x":0,"y":0},{"h":1200,"w":1053,"x":147,"y":0},{"h":1200,"w":600,"x":450,"y":0},{"h":1200,"w":1200,"x":0,"y":0}],"height":1200,"width":1200},"sizes":{"large":{"h":1200,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1200},"small":{"h":680,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/J5xUIlsI1F"},{"display_url":"pic.x.com/J5xUIlsI1F","expanded_url":"https://x.com/gov_online/status/2123582098292298165/photo/2","ext_alt_text":"番組収録時の一コマ。番組パーソナリティの杉浦太陽さんが農福連携の法被を着て、後ろ向きで立っている。法被の背中には「ノウフク　「農林水産業」と「福祉」がつながって日本を元気に！」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":80,"w":80,"x":533,"y":507},{"h":100,"w":100,"x":535,"y":466}]},"medium":{"faces":[{"h":80,"w":80,"x":533,"y":507},{"h":100,"w":100,"x":535,"y":466}]},"orig":{"faces":[{"h":80,"w":80,"x":533,"y":507},{"h":100,"w":100,"x":535,"y":466}]},"small":{"faces":[{"h":53,"w":53,"x":353,"y":336},{"h":66,"w":66,"x":355,"y":309}]}},"id_str":"2122965545322717184","indices":[166,189],"media_key":"3_2122965545322717184","media_results":{"resul