U4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2123250504847458639"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39759,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":107,"tweets":516},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2123606092521615436"],"editable_until_msecs":"1795145721000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2123606092521615436","created_at":"Fri Nov 20 02:35:21 +0000 2026","display_text_range":[0,129],"entities":{},"favorite_count":72,"favorited":false,"full_text":"【11月20日　小泉防衛大臣会見】\n冒頭、日印「2+2」、日印防衛相会談の実施、日チリ防衛相会談の実施について発表しました。\n \nその他、\n○三文書改定に向けた検討\n○米軍機の石垣空港への予防着陸\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら","id_str":"2123606092521615436","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":2,"retweet_count":15,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/v5RiarNue_0?si…","expanded_url":"https://youtu.be/v5RiarNue_0?si=ZOuMvNHbMmQO9na_","indices":[1283,1306],"url":"https://t.co/EixLTqnLYi"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM2MDYwOTIzNTgwNjIwODA=","text":"【11月20日　小泉防衛大臣会見】\n冒頭、日印「2+2」、日印防衛相会談の実施、日チリ防衛相会談の実施について発表しました。\n \nその他、\n○三文書改定に向けた検討\n○米軍機の石垣空港への予防着陸\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「今日は冒頭は２件あります。まず、インドのシン国防大臣、ジャイシャンカル外務大臣を日本にお迎えし、昨日、第４回日印「２＋２」と、シン大臣との間では３回目となる日印防衛相会談を実施しました。\n \n会談に先立って、シン大臣には私の地元の横須賀で「もがみ」型護衛艦「なとり」を視察していただき、私も同行しました。\n \nシン大臣御自身に我が国の最先端の護衛艦と精強な海上自衛隊員を御覧いただけたことは、今後の日印の海洋安全保障協力を進める上でも、大変意義深い機会となりました。\n \n一連の機会を通じ、シン大臣との信頼関係を一層深め、日印防衛協力を更なる高みに引き上げるための大変重要な成果を得ることができました。\n \nその成果の中でも、自衛隊が初めてインドの射場において地対艦誘導弾を含む射撃訓練等を実施することについて一致したことは、特筆すべき成果だと思います。\n \nこれは本年８月に私の訪印時に提案したもので、単に自衛隊の訓練の選択肢を広げるだけでなく、日印防衛協力を実際の部隊運用を伴う、より実践的な協力へと進める画期的な取組です。\n \n８月に提案をして３か月で合意に至り、そして、来年実現に向けて議論を加速すると、こうなったことは、防衛省の担当部局、そして、自衛隊の関係の隊員も含めてですね、本当に精力的に頑張ってくれた結果だと思っています。\n \nこのほか、各軍種間の共同訓練、また、特殊作戦部隊間の交流も進展させていくこと、防衛装備・技術協力ではユニコーンの移転に向けた手続きが着実に進展していることを確認をしました。\n \nさらに、日印２国間の協力にとどまらず、オーストラリアをはじめとする同志国との連携も一層進めていくことで一致しました。\n \n今後もシン大臣との信頼関係の下、具体的な協力を着実に積み重ね、日印両国でインド太平洋の平和と安定に一層大きな役割を果たしていきたいと思います。\n \n２点目ですが、本日１１月２０日、チリの国防大臣として初めて訪日するフェルナンド・バロス国防大臣と防衛省において初めての日・チリ防衛相会談を実施する予定です。\n \n日本とチリは地理的には遠く離れているものの、太平洋を挟んだ隣人として、民主主義や法の支配といった基本的価値を共有する重要なパートナーです。\n \n来年の日・チリ外交関係樹立１３０周年という節目の年を控える中、今回バロス大臣を日本にお迎えし、初の防衛相会談を実施できることを大変うれしく思います。\n \n今回の会談では、両国を取り巻く安全保障環境について認識を共有するとともに、海軍種間の協力をはじめ、日・チリ防衛協力・交流の更なる発展に向け、率直で具体的な議論を行い、バロス大臣との信頼関係を築いていきたいと思います。以上です。」\n \n↓動画はこちら\nhttps://t.co/EixLTqnLYi"}}},"rest_id":"2123606092521615436","unmention_data":{},"views":{"count":"7892","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2123606189175181668","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"2426","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123606189175181668","sortIndex":"2123615924039712756"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":251,"url":"https://pbs.twimg.com/card_img/2123604703930171392/ZIBXZHHP?format=jpg&name=600x314","width":480},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66347","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2123604703930171392/ZIBXZHHP?format=jpg&name=280x150","width":200},"type":"IMAGE"}},{"key":"description","value":{"string_value":"令和８年１１月２０日に行われた藤井総務大臣の閣議後会見動画です。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":300,"url":"https://pbs.twimg.com/card_img/2123604703930171392/ZIBXZHHP?format=jpg&name=400x400","width":400},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2123604703930171392/ZIBXZHHP?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":360,"url":"https://pbs.twimg.com/card_img/2123604703930171392/ZIBXZHHP?format=jpg&name=orig","width":480},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"10228272","path":[]}}},{"key":"photo_image