:false},"display_url":"pic.x.com/iLzXbpEtJ2","expanded_url":"https://x.com/kantei/status/2123450977839988787/video/1","ext_media_availability":{"status":"Available"},"id_str":"2123450006078468096","indices":[114,137],"media_key":"13_2123450006078468096","media_results":{"result":{"media_key":"13_2123450006078468096"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123450006078468096/img/fLw8-sOT3UI_kbfV.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/iLzXbpEtJ2","video_info":{"aspect_ratio":[16,9],"duration_millis":1946733,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2123450006078468096/pl/bg8HBDpnlMkqxEDz.m3u8?tag=29&v=f7c"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123450006078468096/vid/avc1/480x270/D3olAtb-JqZQJYNL.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123450006078468096/vid/avc1/640x360/p4NeT-oGhJIdIBcl.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123450006078468096/vid/avc1/1280x720/YjqR6Zn8lZc9qICh.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/iLzXbpEtJ2","expanded_url":"https://x.com/kantei/status/2123450977839988787/video/1","ext_media_availability":{"status":"Available"},"id_str":"2123450006078468096","indices":[114,137],"media_key":"13_2123450006078468096","media_results":{"result":{"media_key":"13_2123450006078468096"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123450006078468096/img/fLw8-sOT3UI_kbfV.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/iLzXbpEtJ2","video_info":{"aspect_ratio":[16,9],"duration_millis":1946733,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2123450006078468096/pl/bg8HBDpnlMkqxEDz.m3u8?tag=29&v=f7c"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123450006078468096/vid/avc1/480x270/D3olAtb-JqZQJYNL.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123450006078468096/vid/avc1/640x360/p4NeT-oGhJIdIBcl.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123450006078468096/vid/avc1/1280x720/YjqR6Zn8lZc9qICh.mp4?tag=29"}]}}]},"favorite_count":1735,"favorited":false,"full_text":"【お知らせ】（1/2）\n１１月１９日、高市総理は、中国（深セン）において、ＡＳＥＡＮ関連首脳会議出席及びＡＰＥＣ首脳会議出席等についての内外記者会見を行いました。\n\n※冒頭発言全文 (速報版)\n（高市総理）\n　皆様こんにちは。 https://t.co/iLzXbpEtJ2","id_str":"2123450977839988787","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":13,"reply_count":80,"retweet_count":255,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM0NTA5Nzc2NjM4Mjc5Nzc=","richtext":{"richtext_tags":[]},"text":"【お知らせ】（1/2）\n１１月１９日、高市総理は、中国（深セン）において、ＡＳＥＡＮ関連首脳会議出席及びＡＰＥＣ首脳会議出席等についての内外記者会見を行いました。\n\n※冒頭発言全文 (速報版)\n（高市総理）\n　皆様こんにちは。\n　本日、中国深セン市におけるＡＰＥＣ首脳会議、及びこれに先立つフィリピン・マニラでのＡＳＥＡＮ関連首脳会議に伴う、一連の外交日程を終えます。\n　今般、各首脳会議への出席、各国首脳との会談や意見交換を重ね、我が国と地域の未来にとって極めて重要な外交ウィークとなりました。\n　特に、国際秩序が大きく揺らぐ中、基本的価値を共有する民主主義国家である日米豪印、クアッドの首脳が一堂に会し、\n・戦略的認識をすり合わせ、\n・「自由で開かれたインド太平洋（ＦＯＩＰ）」の実現に向けた揺るぎない結束を世界に示すとともに、\n・インド太平洋の各国が裨益する様々な具体的協力で一致することができたことは大きな成果でした。\n　このような同志国間の強固な信頼と揺るぎない結束を梃子にしながら、地域の平和と繁栄の鍵を握る、ＡＳＥＡＮ、ＡＰＥＣという多国間外交の舞台において、法の支配に基づく自由で開かれた国際秩序を維持・強化するべく、力強い日本外交を展開し、確かな手応えを得ることができました。\n　以下、具体的成果について御説明をいたします。\n\n　冒頭でも申し上げましたが、今回の外交ウィークの大きな成果となったのは、基本的価値を共有する民主主義国家である、日本、米国、オーストラリア、インドの４か国によるクアッド首脳会合をマニラにおいて開催したことでございます。\n　法の支配に基づく自由で開かれた国際秩序に対する挑戦が一段と厳しさを増す中、アメリカのトランプ大統領、オーストラリアのアルバニージー首相、インドのモディ首相との間で、ＦＯＩＰ実現に向けて具体的な協力を推進するためのクアッドの戦略的重要性について、認識を共有することができました。\n　４か国首脳は、\n・力又は威圧による一方的な現状変更の試みに対する強い反対を表明するとともに、\n・恣意的な輸出規制を含む経済的威圧に対する深刻な懸念を表明しました。\n　そして、今回の会合では、その共通の認識の下、\n・域内各国の自律性と強靱性を強化し、\n・ＦＯＩＰ実現のための具体的な方針を、首脳レベルで改めて示すことができました。\n　４か国首脳は、\n・海洋安全保障、\n・重要鉱物のサプライチェーンを含む経済・エネルギー強靱化、\n・強靱なサイバーセキュリティ環境支援、\n・信頼できるＡＩエコシステムの創出、\nといった、具体的な協力を一層加速していきます。\n　基本的価値を共有する民主主義国家として、具体的協力を積み上げ、常にこの地域の平和と安定に貢献してきたクアッドは、これからも地域のパートナーと共に、インド太平洋の未来を創ってまいります。\n\n　マニラでのＡＳＥＡＮ関連首脳会議（※）は、ＦＯＩＰ実現の要であるＡＳＥＡＮとの間で、\n・一層の連携強化の必要性を改めて実感し、\n・長年の協力を背景としたＡＳＥＡＮ各国からの日本への信頼や期待の大きさを、感じる機会となりました。\n　この地域へのＡＳＥＡＮの関与の指針である、『インド太平洋に関するＡＳＥＡＮアウトルック』（ＡＯＩＰ）と『進化したＦＯＩＰ』との相乗効果の追求について確認できたことは、そうした信頼や期待に応える第一歩です。\n　参加した数ある会合のうち、特に、日ＡＳＥＡＮ首脳会議において採択した首脳共同声明を踏まえ、エネルギー、ＧＸ、サプライチェーン、ＡＩ・デジタルといった新興経済分野を中心に、経済強靱性の強化に関する協力を推進し、未来への投資を加速させるモメンタムを創出してまいります。\n　来年はＡＳＥＡＮ創設６０周年、そして、日本の対東南アジア外交三原則である「福田ドクトリン」発表５０周年の節目の年でございます。\n　日本は、ＡＳＥＡＮと共に歩み続けるという決意は不変です。\n\n　また、フィリピンのマルコス大統領と共同議長を務めた第４回ＡＺＥＣ首脳会合では、『進化したＦＯＩＰ』の更なる具体化を打ち出しました。\n　ＡＺＥＣに、エネルギー強靱化と経済強靱化及びＧＸ投資の一層の加速化の視点を加えまして、ＡＺＥＣ２．０への進化を確認し、共同声明を発出することができました。\n　この中では、本年４月に発表した「パワー・アジア」のアップグレードも盛り込みました。\n　アジア版のＩＥＡ（アイイーエー）とも呼ぶべきタスクフォースを立ち上げます。\n　ＡＳＥＡＮ諸国における石油備蓄制度の構築支援も通じて、地域におけるエネルギー安全保障の強化に貢献してまいります。\n　また、日本は、湾岸諸国の経済・エネルギー強靱化に向けた包括的な協力計画として、パワー・ガルフを提唱しています。\n　今後、\n・アジアへのエネルギー輸出の促進、\n・経済インフラの復旧・強化、\n・先端技術分野での連携\nを主な柱として、湾岸産油国とアジア消費国の連携強化を一層推進していくこととしており、これは湾岸諸国からも高い評価をいただいております。\n　今回、ＡＺＥＣのパートナー国に加え、インド、韓国、東ティモールの参加も得て、共に地域連携を促進する旨を確認しました。\n\n　先ほど閉幕したＡＰＥＣ首脳会議では、地域の成長と繁栄に向け、\n・ルールに基づく自由で公正な国際経済秩序の強化、\n・エネルギーを始めとするサプライチェーン強靱化の必要性、\n・ＷＴＯ改革への積極的な関与、\nについて強調いたしました。\n　今回採択された深圳（シンセン）首脳宣言には、\n・質の高いインフラ、\n・越境データの信頼強化といった、\n我が国が重視する要素も、多く盛り込まれました。\n　日本の考えが、参加エコノミーに広く共有され、支持された証と受け止めております。\n\n　そして、今回の訪問の機会に、各国首脳との会談や意見交換も、精力的に行いました。\n\n　フィリピンのマルコス大統領とは、本年５月の大統領国賓訪問時に格上げされた包括的・戦略的パートナーシップの下、安全保障、エネルギーを始めとする協力を通じた更なる関係強化について協議しました。\n\n　タイのアヌティン首相とは、来年の日タイ修好１４０周年を捉えまして、様々な分野で二国間関係を更に発展させることを確認し、「パワー・アジア」の下でのエネルギー安全保障、宇宙・ＡＩ、安全保障、といった分野での協力を議論いたしました。\n\n　韓国の李在明（イ・ジェミョン）大統領とは、次回シャトル外交を来年１月に実施し、幅広い分野で具体的な成果を目指していくべく調整していくことで一致しました。\n　また、日米同盟・韓米同盟の強化、日韓米協力の推進を再確認しつつ、拉致問題の即時解決に向けた理解と協力を求め、支持をいただきました。\n\n　そして、米国のトランプ大統領とも短時間ですが意見交換をし、インド太平洋情勢を含む諸課題について、緊密に連携していくことを確認いたしました。\n\n　また、ロシアのプーチン大統領とも二国間関係について意見交換を行いました。\n\n　このほか、\n・ウォン・シンガポール首相、\n・サルムサイ・ラオス首相、\n・プラボウォ・インドネシア大統領、\n・フン・ベトナム首相、\n・グスマン・東ティモール首相、\n・アルバニージー・オーストラリア首相、\n・モディ・インド首相、\n・アンワル・マレーシア首相、\n・ラクソン・ニュージーランド首相、\n・グテーレス国連事務総長、\n・ゲオルギエヴァＩＭＦ専務理事\nなどともですね、二国間関係ですとか現下の国際情勢、経済情勢について活発な意見交換を行い、連携を確認することができました。\n\n　ちょうど１年前、私が内閣総理大臣に就任して最初に出席した外交の舞台が、ＡＳＥＡＮ関連首脳会議とＡＰＥＣ首脳会議でございました。\n　この１年間、『進化したＦＯＩＰ』を推進し、\n・日米同盟を外交・安全保障の基軸として更なる高みへと引き上げるとともに、\n・様々な外交機会を捉えて、各国との連携と具体的協力を推進し、\n・就任直後から掲げてきた方針を着実に実践してまいりました。\n　この一年にわたる歩み、そして今回の外交ウィークを通じて、地域の首脳達との間に築かれた確固たる信頼と成果は土台になります。\n　日本は、インド太平洋地域が、自律性と強靱性を備え、「共に、強く豊かに」なるために、主導的な役割を果たし続けていく決意です。\n　私からの冒頭発言は以上です。ありがとうございました。\n※「ＡＳＥＡＮ関連首脳会合」と発言しましたが、正しくは「ＡＳＥＡＮ関連首脳会議」です。"}}},"rest_id":"2123450977839988787","unmention_data":{},"views":{"count":"82807","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2123615924039712800-tweet-2123467313685086335","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1774856,"following":48},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8410,"tweets":23592},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2123467313685086335"],"editable_until_msecs":"1795112634000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":11,"bookmarked":false,"conversation_id_str":"2123450977839988787","created_at":"Thu Nov 19 17:23:54 +0000 2026","display_text_range":[0,73],"entities":{},"favorite_count":204,"favorited":false,"full_text":"(2/2) 高市総理による内外記者会見（質疑応答部分）\n\n※要旨（速報版、仮訳)\n（記者）\n　外交について何点か確認させていただきたいと思います。","id_str":"2123467313685086335","in_reply_to_screen_name":"kantei","in_reply_to_status_id_str":"2123450977839988787","in_reply_to_user_id_str":"412940784","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":14,"retweet_count":40,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM0NjczMTM0MDQxMDg4MDA=","richtext":{"richtext_tags":[]},"text":"(2/2) 高市総理による内外記者会見（質疑応答部分）\n\n※要旨（速報版、仮訳)\n（記者）\n　外交について何点か確認させていただきたいと思います。\n　極めて重要な外交ウィークだという指摘、冒頭ありましたけれども、ＡＳＥＡＮの関連会合ではですね、進化した「自由で開かれたインド太平洋」に加えて、エネルギー分野の協力についても打ち出しました。アメリカのインド太平洋地域への関与が薄れているとの指摘もある中、日本がこの地域で果たす役割をどのように捉えているか、伺いたいと思います。\n　そして、これも冒頭でありましたけれども、2年ぶりのクアッドの首脳会合は、ここ深センでの米中露首脳会談のですね、間もなく開かれると思うんですけれども、この直前にマニラで開催されました。総理がクアッドの枠組みをどう進展させるおつもりなのか。また初の米中露首脳会談が行われることへの受け止めと、今回の3首脳の会談がですね、世界や北東アジア情勢に与える影響への認識についてお伺いします。\n　そして、深センでは、中国の習近平国家主席と昨夜、それから今日の午前も握手を交わして、総理から声をかけられたと思います。どのようなことを習主席にお声がけなさったのかということと、総理の国会答弁をきっかけに中国が反発して両国関係が冷え込んだ状態が続いていますけれども、１９７２年の日中共同声明をはじめ、４つのこの文書に対する総理の認識、中国との関係をどう進めていくのか伺いたいと思います。\n　そして最後にですね、ロシアのプーチン大統領と日露首脳として７年ぶりに対面で意見を交わしました。昨夜ですけれども。北海道新聞記者の拘束やＪＴの現地法人の問題など懸案について、３０分という比較的長いかなという時間にわたって意見を交わされたと思います。総理からどのように伝え、先方の反応はどうだったのか。またウクライナの状況、対露制裁について話題になったのか、確認をさせていただきたいと思います。以上です。\n\n（高市総理）\n　ありがとうございます。\n　マニラでの一連の会議を通じまして、「進化したＦＯＩＰ」の下、インド太平洋地域において、各国が自律性と強靱性を身につけ、地域全体が「共に、強く豊かに」なることを目指して、日本としてＡＳＥＡＮ各国や同志国と共に取り組んでいくとの決意を示しました。\n　その具体的な取組の１つとして、地域の経済強靱化に焦点を当てた日ＡＳＥＡＮ首脳共同声明を発出しましたし、ＡＺＥＣ首脳会合への出席を通じて「パワー・アジア」を強化する決意を示して、経済・エネルギー強靱化の視点を強化した、ＡＺＥＣ２．０への進化を打ち出しました。\n　また、本日のＡＰＥＣ首脳会議においても、ルールに基づく国際経済秩序の強化、域内サプライチェーン強化のための経済・エネルギー強靱化を改めて訴えました。\n　こうした取組を着実に積み重ねて、米国を始めとする同盟国や同志国と緊密に連携しながら、この地域の平和と安定、繁栄に積極的な役割を果たしていきたいと考えております。\n　それから私がかねてから重視してきたクアッドにつきましては、今回、私とアメリカのトランプ大統領にとってですね、共に初の首脳会合となりました。\n　先ほど申し上げました通り、やはりこの基本的価値を共有する、昨日も複数から発言がありましたが、民主主義国家である4か国の首脳で、インド太平洋地域における戦略的認識を擦り合わせ、ＦＯＩＰの実現に向けた揺るぎない結束や方針を示すことができたというのは、大きな成果であったと思います。\n　今回の会合で示したＦＯＩＰ実現に向けた具体的な方針を基に、海洋・越境安全保障、また、経済的繁栄・経済安全保障、重要・新興技術、人道支援・緊急対応の4つの分野を中心に、米国、豪州、インドと連携しながら、地域が裨益する協力でしっかり結果を出してまいります。\n　また、米中露の首脳会談に関してですけれども、国際情勢への影響を注視しつつ、米国を始めとする同盟国、同志国とも、今回行った一連の会談、会合に続いて、緊密に意思疎通しながら適切に対応してまいります。\n　それから昨晩の晩餐会及び本日の首脳セッションの際、私は習近平国家主席の出迎えをいただいて、握手をし、挨拶を交わしました。その際、私からは、昨日はご招待に感謝する旨を述べさせていただきました。また、今日は、昨夜の晩餐会の開催と、それから首脳セッションの開催に関して、お礼とお祝いを申し上げました。そして今日、会議終了後には、全てのコーディネートに対するお礼を申し上げました。\n　日中関係においてですね、御指摘の4つの文書ですけれども、日中間の基本文書という位置づけに何ら変わりはございません。\n　中国は重要な隣国でございます。\n　日中間には懸案と課題があるからこそ対話を行い、意思疎通をしていくことが重要だと考えております。\n　長年の積み重ねがございますので、これを踏まえながら戦略的互恵関係を包括的に推進していくとともに、共通の課題については意思疎通を図って、お互いの国益を守るための対話を進めて、建設的かつ安定的な関係を構築していく、こういう思いでおります。\n　また、プーチン大統領とは、今回、初めて対面で３０分間以上お話をしました。その中で、現下の邦人拘束事案ですとか、日本企業への対応について、日本側の立場に基づいてですね、時間を取ってしっかりとやりとりをさせていただきました。\n　そして大統領と私の間の直接の連絡も含めてですね、様々なレベルで意思疎通を行っていくということで一致をいたしました。\n\n（記者）\n　総理は、中国の習近平国家主席及びロシアのプーチン大統領と話をする機会を得ましたが、両国の未解決の問題についてどのような計画で取り込むつもりでしょうか。中国による重要鉱物の輸出規制を解除やロシアによるジャーナリストの拘束及び日本企業の資産差し押さえなどの課題の解決にどのように取り組む計画かご説明いただきたいです。関連して、現在、米中露３カ国首脳会談がまさに行われているところだが、日本の利益が損なわれないようにするために、どのように取り組んでこられたでしょうか。\n\n（高市総理）\n　Ｔｈａｎｋ　ｙｏｕ．\n　まず中国による一連の輸出規制措置についてですけれども、これまでも様々なレベルで中国側に我が国の立場を伝達してまいりました。\n　それからマニラでのクアッド首脳会合では、重要鉱物のサプライチェーンを含む経済・エネルギー強靱化に向けて、連携して取り組むということで一致をしました。\n　さらに今般のＡＰＥＣ首脳会合においても、私からサプライチェーンの安定化に必要な行動を取ることが重要であるということを指摘いたしました。こうした取組におきまして、米国を始めとするＧ７各国や同志国とも緊密に連携しながら、必要な対応をタイミングよく進めていきたいと考えております。\n　プーチン大統領とは、先ほども申し上げましたが、今回３０分間以上の会談を行いました。もちろん邦人記者の拘束事案ですとか、日本企業への対応について、じっくりと話をして、必要な対話をいたしました。\n　今後、大統領と私が直接の意思疎通ができる環境を作れたということが一番の進歩だったと思っております。\n　また、米中露首脳会談につきましては、国際情勢への影響を注視しつつ、米国を始めとする同盟国・同志国とも緊密に意思疎通してきておりますので、適切に対応をしてまいります。日本の利益が損なわれるということはないと考えております。\n　ありがとう。\n\n（記者）\n　内政についてお伺いいたします。\n　まず１つ目は、消費税減税関連法案についてです。現在参議院で審議が進んでいますが、公明党が具体的な支援対象や給付の全体像について懸念を示し、国民民主党などの対応も成立の行方を左右する鍵となっています。参議院での成立に向けて、政府として野党の協力をどのように取り付けるお考えでしょうか。あわせて、仮に参議院で否決になった場合でも、衆議院での再可決といった選択肢を排除せず、会期内の成立を目指すお考えでしょうか。\n　２つ目です。防衛費の規模とその財源についてお伺いいたします。年末に予定している安保関連３文書の改定をめぐり、今後５年間の防衛費について、政府は当初の見積もりから圧縮し、５０兆円台前半を軸に調整していると報じられています。今回の改定は、日本が置かれた極東地域の厳しい安全保障環境に対応するものです。この規模で、総理が目指す防衛力の強化は実現できるとお考えでしょうか。その上で、令和４年の前回改定時、岸田政権は防衛費増額の財源について、赤字国債の発行を避け、歳出改革や税外収入に加え、不足分を増税で賄う方針を決定しました。今回も歳出改革などで足りない場合、総理はこの岸田政権の増税方針を踏襲するお考えでしょうか。それとも、総理が掲げる「責任ある積極財政」に基づき、国債の発行も選択肢として、短期的な国民負担を回避するお考えでしょうか。\n　最後に、関文部科学大臣の議員会館内での政治資金パーティーの問題を巡り、官僚を講師に呼んでいたことは、行政の私物化との批判が出ています。この点について、どのようにお考えでしょうか。帰国後、関大臣から事情を聞くお考えはありますでしょうか。\n　以上、よろしくお願いします。\n\n（高市総理）\n　ありがとうございます。\n　まず、「消費税・支援金法案」の具体的な支給要件などにつきましては、法案審議におけるご議論、また純負担率の国際比較、恒久財源の確保状況、それから最新のデータに基づく所得に応じた対象者数の推計などを踏まえて定める必要がございます。\n　こうした中、これまでの国会審議におきまして、諸外国の類似制度を念頭に、あくまでも１つの参考としてお示ししてきたのが、支給対象者の現役勤労者に占める割合が３割、所得上限額が年収３５０万円、これではですね、中所得の方を対象とする制度としては低すぎるのではないか、また飲食料品の消費税率を元に戻す際に備えて、より多くの中所得の現役勤労者の方々も対象にすべきではないか、とのご意見がございました。\n　このためですね、政府としては、より多くの中所得の現役勤労者の方々に支援金の恩恵をお届けできますように、現役勤労者の５割以上が対象となる所得上限額の設定を検討いたしております。\n　いずれにしましても、今後の法案審議について、現時点で予断をもって申し上げるということはできないのですが、今後ともデータの制約はありますけれども、法案審議に資するように丁寧に説明するということとともに、なるべく多くの政党にご賛同いただいて、少しでも早く本格的な施行準備に入れるよう、誠実に審議に臨んでいくということで、法案の早期成立に全力を尽くしてまいります。\n　それから次に、防衛力の抜本的強化についてですが、安全保障環境の変化が様々な分野で加速度的に生じています。これまで以上のスピード感で進めていかなければなりません。\n　そのため、『国家安全保障戦略』をはじめとする「三文書」の今年中の見直しに向けて、国家安全保障会議で集中的に議論を行うとともに、有識者の皆様にもご議論をお願いして、現在具体的な検討を進めております。\n　防衛力の抜本的強化に向けた今後の予算措置につきましては、我が国自身の主体的判断に基づいて行うものでございます。私は金額ありきではなくて、こうした具体的かつ現実的な検討の下で、必要な能力や事業を積み上げていくということが大事だと思っています。\n　その上で、そのための裏付けとなる予算を確保する上で、必要な財源の在り方については、財政の持続可能性にも十分配慮をしながら、今後議論を進めてまいります。現段階でその規模感について決まったことはございませんし、財源に関しても同じでございます。\n　それから、関大臣の話がございました。２０２４年に開催した政治資金パーティーについて様々なご指摘がなされているということでございます。\n　一般論としてですけれども、民間企業の方が参加する会合において、行政機関の担当者に対して、その所掌分野に関する一般的な行政説明を依頼するということについては、法的に問題はないと考えておりますけれども、まずは関大臣ご本人においてしっかりと説明されるべきものと考えております。\n　以上です。ありがとうございます。\n\n（記者）\n　日本は、地域的な緊張が高まる中で、防衛力を拡大しています。日本の軍事力増強が、より攻撃的な姿勢を示すものでも、軍拡競争に拍車をかけるものでもなく、抑止力を強化することを目的としている、ということを、いかにして域内の各国に納得させるのでしょうか。\n　これに関連して、日本が台湾有事の際、どのような状況下で軍事的な関与を検討し得るのか、そして、その立場に変化はあるでしょうか、明確にしていただければと思います。\n\n（高市総理）\n　Ｔｈａｎｋ　ｙｏｕ．\n　まず我が国の防衛力強化は、あくまでも日本国民の皆様の命と平和な暮らしを守り抜くために必要なものでございます。\n　そして、我が国は、戦後一貫して、平和国家として、国際社会の平和と繁栄に貢献してきております。この方針は、今後も一切変わることはございません。\n　９月の国連総会の一般討論演説でも、また、今回のマニラにおけるＡＳＥＡＮ関連首脳会議でも、こうした方針を踏まえまして、我が国の平和国家としての歩みを強調いたしました。\n　特に、ＡＳＥＡＮ各国からは、こうした歩みを着実に続けてきた我が国への揺るぎない信頼を改めて強く感じました。\n　引き続き、諸外国に対して、我が国の安全保障政策の具体的な考え方を明確にして、透明性を確保しながら取組を進めてまいります。そして地域のパートナーと共に、平和で豊かな未来を築いていきます。\n　また、後段の、後のご質問の内容に関してですけれども、仮定の質問にお答えすることは差し控えさせていただきます。\n　台湾に対する日本政府の基本的立場というのは、１９７２年の日中共同声明の通りでございます。この立場に一切の変更はございません。\n　以上です。ありがとう。"}}},"rest_id":"2123467313685086335","unmention_data":{},"views":{"count":"25800","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2123450977839988787","2123467313685086335"],"enableDeduplication":true}}},"entryId":"list-conversation-2123615924039712800","sortIndex":"2123615924039712736"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2122443545927888896/Kq0kpm3G?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2122443545927888896/Kq0kpm3G?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2122443545927888896/Kq0kpm3G?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2122443545927888896/Kq0kpm3G?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2122443545927888896/Kq0kpm3G?format=png&name=2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":75.17,"rgb":{"blue":255,"green":255,"red":255}},{"percentage":14.68,"rgb":{"blue":160,"green":0,"red":0}},{"percentage":6.18,"rgb":{"blue":4,"green":4,"red":4}},{"percentage":2.24,"rgb":{"blue":196,"green":119,"red":120}},{"percentage":0.44,"rgb":{"blue":208,"green":154,"red":153}}]},"type":"IMAGE_COLOR"}},{"key":"title","value":{"string_value":"日米首脳電話会談","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/WjQbWGVz1p","type":"STRING"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary","url":"https://t.co/WjQbWGVz1p","user_refs_results":[]},"rest_id":"https://t.co/WjQbWGVz1p"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2123372392798142557"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":591068,"following":206},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20546,"tweets":49363},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2123463722429816858"],"editable_until_msecs":"1795111778000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":35,"bookmarked":false,"conversation_id_str":"2123463722429816858","created_at":"Thu Nov 19 17:09:38 +0000 2026","display_text_range":[0,110],"entities":{},"favorite_count":1343,"favorited":false,"full_text":"高市総理大臣は、ドナルド・J・トランプ米国大統領（The Honorable Donald J. Trump, President of the United States of America）と電話会談を行いました。","id_str":"2123463722429816858","is_quote_status":false,"lang":"ja","quote_count":22,"reply_count":46,"retweet_count":200,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/na/na1/u…","expanded_url":"https://www.mofa.go.jp/mofaj/na/na1/us/pageit_000001_03340.html","indices":[393,416],"url":"https://t.co/WjQbWGVz1p"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM0NjM3MjIyODcxNTMxNTI=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、ドナルド・J・トランプ米国大統領（The Honorable Donald J. Trump, President of the United States of America）と電話会談を行いました。\nトランプ大統領から、今般の米中首脳会談や米中露首脳会談について詳細に説明がありました。その上で、両首脳は、インド太平洋情勢やウクライナ情勢を含む国際社会の諸課題について意見交換を行い、日米の連携を確認しました。\n両首脳は、先日、フィリピン・マニラで行われた日米豪印首脳会合の成果を踏まえ、今後とも自由で開かれたインド太平洋（FOIP）を力強く推進していくことで一致しました。\nトランプ大統領から、インド太平洋地域及び日米同盟へのコミットメントが改めて示され、両首脳は、今や最も信頼し合える同盟国である日米の関係を、更なる高みに引き上げていくことで一致しました。\n\nhttps://t.co/WjQbWGVz1p"}}},"rest_id":"2123463722429816858","unmention_data":{},"views":{"count":"56421","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123463722429816858","sortIndex":"2123615924039712735"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1774856,"following":48},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8410,"tweets":23592},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2123439203006685533"],"editable_until_msecs":"1795105932000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":347,"bookmarked":false,"conversation_id_str":"2123439203006685533","created_at":"Thu Nov 19 15:32:12 +0000 2026","display_text_range":[0,63],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/9O5Y7GPAnG","expanded_url":"https://x.com/kantei/status/2123439203006685533/video/1","ext_media_availability":{"status":"Available"},"id_str":"2123438894352093184","indices":[64,87],"media_key":"13_2123438894352093184","media_results":{"result":{"media_key":"13_2123438894352093184"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123438894352093184/img/Jm1jyu-lVCO_t3_K.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/9O5Y7GPAnG","video_info":{"aspect_ratio":[16,9],"duration_millis":193533,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2123438894352093184/pl/J2rBSOlT2J-uhAgi.m3u8?tag=29&v=9fc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123438894352093184/vid/avc1/480x270/BekDKeZY3FtRFYvA.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123438894352093184/vid/avc1/640x360/LJpsUNEncOAhvE8K.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123438894352093184/vid/avc1/1280x720/6CDOtqjlUkD1Q-3A.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/9O5Y7GPAnG","expanded_url":"https://x.com/kantei/status/2123439203006685533/video/1","ext_media_availability":{"status":"Available"},"id_str":"2123438894352093184","indices":[64,87],"media_key":"13_2123438894352093184","media_results":{"result":{"media_key":"13_2123438894352093184"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2123438894352093184/img/Jm1jyu-lVCO_t3_K.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/9O5Y7GPAnG","video_info":{"aspect_ratio":[16,9],"duration_millis":193533,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2123438894352093184/pl/J2rBSOlT2J-uhAgi.m3u8?tag=29&v=9fc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123438894352093184/vid/avc1/480x270/BekDKeZY3FtRFYvA.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123438894352093184/vid/avc1/640x360/LJpsUNEncOAhvE8K.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123438894352093184/vid/avc1/1280x720/6CDOtqjlUkD1Q-3A.mp4?tag=29"}]}}]},"favorite_count":7322,"favorited":false,"full_text":"【お知らせ】\n１１月１９日、高市総理は、日米首脳電話会談等についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（記者） https://t.co/9O5Y7GPAnG","id_str":"2123439203006685533","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":171,"reply_count":482,"retweet_count":910,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM0MzkyMDI5MzEyNzM3Mjg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n１１月１９日、高市総理は、日米首脳電話会談等についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（記者）\n　総理は先ほど、アメリカのトランプ大統領と電話会談を行いました。また、これに先立って、中国で米中露首脳会談が行われ、平和宣言が発表されました。平和宣言では、国際刑事裁判所、ＩＣＣや、類似する機関は管轄権を濫用してはならない、との内容が盛り込まれました。まず、この平和宣言の内容についての受け止めを伺います。また、米中露首脳会談を踏まえた、先ほどの高市総理とトランプ大統領との電話会談で、どのようなやり取りがあったのか教えてください。また今後、米国とともに中国、ロシアにどのように対応していくのかについて、総理の考えを教えてください。\n\n（高市総理）\n　まず先に、日米の首脳会談についてお話をいたします。\n　先ほど、午後１０時半から約２０分間、エアフォース・ワンで帰国中のトランプ大統領と電話会談を行いました。\n　トランプ大統領からは、今般の米中首脳会談や、米中露首脳会談について詳細に説明がありました。インド太平洋情勢やウクライナ情勢を含む国際社会の諸課題について率直に意見交換を行いました。\n　これまで米国との間では、日米同盟の強化やインド太平洋情勢を含む諸課題について緊密に意思疎通を行ってきております。\n　私自身も今週マニラにおいてトランプ大統領に対して、クアッド首脳会合の場においても、また別途、二人の間で懇談した機会においても、我が国の考え方を改めてお伝えしてきております。\n　今や最も信頼し合える同盟国である日米の関係を更なる高みに引き上げてまいります。\n　また、今般、民主主義国家であるクアッドの首脳が、揺るぎない結束を示したように、同盟国・同志国とも緊密に連携して、自由で開かれた国際秩序の維持・強化に向けて取り組んでいきたいと考えています。\n　なお、ＩＣＣにつきましては、我が国としては一貫して支持をしてきております。これは日米で考え方が異なっていることではありますけれども、茂木大臣とルビオ国務長官との間で、意思疎通は継続をいたしております。\n　引き続き、関係国と協力しながら、法の支配を強化していく、というのが日本の立場であります。その日本の立場については、私からトランプ大統領にもお伝えしておりますので、トランプ大統領もそれはお分かりだと思います。\n　以上です。\n　どうもお疲れさまでした。夜遅くにすみません。"}}},"rest_id":"2123439203006685533","unmention_data":{},"views":{"count":"886208","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123439203006685533","sortIndex":"2123615924039712734"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"