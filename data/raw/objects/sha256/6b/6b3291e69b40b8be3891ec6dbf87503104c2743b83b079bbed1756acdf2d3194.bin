314155008/vid/avc1/3840x2160/sDaUMwc-y82gSTYi.mp4?tag=29"}]}}]},"favorite_count":868,"favorited":false,"full_text":"日印防衛相会談における小泉防衛大臣の冒頭発言です。\n\n戦後の和解と深い信頼、そしてインド国会による原爆犠牲者への毎年の追悼など、両国が築いてきた強固な絆を振り返りました。 https://t.co/jmyG4RDkTZ","id_str":"2123395635760250880","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"quoted_status_id_str":"2123390707998380170","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2123390707998380170","url":"https://t.co/V38OPjCz9n"},"reply_count":8,"retweet_count":140,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjMzOTU2MzU3MDU2OTIxNjA=","text":"日印防衛相会談における小泉防衛大臣の冒頭発言です。\n\n戦後の和解と深い信頼、そしてインド国会による原爆犠牲者への毎年の追悼など、両国が築いてきた強固な絆を振り返りました。\n\n来年迎える国交樹立75周年の節目を見据え、激変する国際情勢の中で、日印の防衛協力を地域と国際社会の平和・繁栄を支える確かな力へと高めていきます。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語に