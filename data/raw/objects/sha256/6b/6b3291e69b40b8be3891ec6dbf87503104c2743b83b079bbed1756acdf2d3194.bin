ne Keita, Executive Director of United Nations Population Fund （UNFPA））歓迎レセプションに出席し、挨拶を行いました。生稲政務官は、ベアトリス・ル・フラペール・デュ・エレン駐日フランス大使（H.E. Ms. Béatrice Le Fraper du Hellen, Ambassador of France to Japan）への感謝を述べるとともに、ケイタ事務局長の来日と世界人口白書の最新版が日本から世界に向けて発表されたことを歓迎しました。\n\nhttps://t.co/E8kmc5yymA"}}},"rest_id":"2123308135507255380","unmention_data":{},"views":{"count":"8827","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123308135507255380","sortIndex":"2123615924039712681"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2123615924039712856-tweet-2123302872519709149","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"農林水産省の公式アカウントです。ご意見・ご質問は、総合窓口に