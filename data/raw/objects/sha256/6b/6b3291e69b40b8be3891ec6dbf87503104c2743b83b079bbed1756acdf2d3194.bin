info":{"focus_rects":[{"h":547,"w":976,"x":0,"y":193},{"h":740,"w":740,"x":118,"y":0},{"h":740,"w":649,"x":164,"y":0},{"h":740,"w":370,"x":303,"y":0},{"h":740,"w":976,"x":0,"y":0}],"height":740,"width":976},"sizes":{"large":{"h":740,"resize":"fit","w":976},"medium":{"h":740,"resize":"fit","w":976},"small":{"h":516,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/hLlCNLgPt2"}]},"favorite_count":2315,"favorited":false,"full_text":"令和８年１１月１９日（木）午前から午後にかけて、ロシアの爆撃機（Ｔｕ－９５）×２機が、太平洋から飛来し、与那国島と台湾との間を通過した後、対馬海峡を通過し大陸方面へ飛行したことを確認した。 https://t.co/hLlCNLgPt2","id_str":"2123361637231190423","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":67,"quoted_status_id_str":"2123358967422505441","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2123358967422505441","url":"https://t.co/Azx73ct4zX"},"reply_count":48,"retweet_count":767,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjMzNjE2MzcxNzI0Njk3NjA=","text":"令和８年１１月１９日（木）午前から午後にかけて、ロシアの爆撃機（Ｔｕ－９５）×２機が、太平洋から飛来し、与那国島と台湾との間を通過した後、対馬海峡を通過し大陸方面へ飛行したことを確認した。\nまた、同日午前から午後にかけて、ロシアの哨戒機（Ｔｕ－１４２）×２機が、日本海から飛来し、対馬海峡を通過した後、東シナ海上で上記のロシア爆撃機と合流し、再び対馬海峡を通過し大陸方面へ飛行したことを確認した。\nこれに対し、航空自衛隊の南西航空方面隊等の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3294},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":362865,"following":32},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6462,"tweets":12515},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2123358967422505441"],"editable_until_msecs":"1795086802000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":138,"bookmarked":false,"conversation_id_str":"2123358967422505441","created_at":"Thu Nov 19 10:13:22 +0000 2026","display_text_range":[0,94],"entities":{"media":[{"display_url":"pic.x.com/Z4zSBedEkR","expanded_url":"https://x.com/jointstaffpa/status/2123358967422505441/photo/1","ext_media_availability":{"status":"Available"},"feature