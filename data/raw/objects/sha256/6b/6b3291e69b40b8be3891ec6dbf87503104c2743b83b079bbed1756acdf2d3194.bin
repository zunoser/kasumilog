.com/takaichi_sanae/status/2123428583909753253/photo/4","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":39,"w":39,"x":554,"y":156},{"h":53,"w":53,"x":374,"y":173},{"h":57,"w":57,"x":264,"y":152},{"h":70,"w":70,"x":154,"y":169}]},"medium":{"faces":[{"h":39,"w":39,"x":554,"y":156},{"h":53,"w":53,"x":374,"y":173},{"h":57,"w":57,"x":264,"y":152},{"h":70,"w":70,"x":154,"y":169}]},"orig":{"faces":[{"h":39,"w":39,"x":554,"y":156},{"h":53,"w":53,"x":374,"y":173},{"h":57,"w":57,"x":264,"y":152},{"h":70,"w":70,"x":154,"y":169}]},"small":{"faces":[{"h":39,"w":39,"x":554,"y":156},{"h":53,"w":53,"x":374,"y":173},{"h":57,"w":57,"x":264,"y":152},{"h":70,"w":70,"x":154,"y":169}]}},"id_str":"2123428495447777281","indices":[133,156],"media_key":"3_2123428495447777281","media_results":{"result":{"media_key":"3_2123428495447777281"}},"media_url_https":"https://pbs.twimg.com/media/HXfu91kbYAEe1Vi.jpg","original_info":{"focus_rects":[{"h":358,"w":640,"x":0,"y":29},{"h":480,"w":480,"x":160,"y":0},{"h":480,"w":421,"x":190,"y":0},{"h":480,"w":240,"x":280,"y":0},{"h":480,"w":640,"x":0,"y":0}],"height":480,"width":640},"sizes":{"large":{"h":480,"resize":"fit","w":640},"medium":{"h":480,"resize":"fit","w":640},"small":{"h":480,"resize":"fit","w":640},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MNQZVT7XFy"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/MNQZVT7XFy","expanded_url":"https://x.com/takaichi_sanae/status/2123428583909753253/photo/5","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":42,"w":42,"x":269,"y":215},{"h":42,"w":42,"x":180,"y":220},{"h":48,"w":48,"x":370,"y":193},{"h":46,"w":46,"x":85,"y":178},{"h":52,"w":52,"x":487,"y":191}]},"medium":{"faces":[{"h":42,"w":42,"x":269,"y":215},{"h":42,"w":42,"x":180,"y":220},{"h":48,"w":48,"x":370,"y":193},{"h":46,"w":46,"x":85,"y":178},{"h":52,"w":52,"x":487,"y":191}]},"orig":{"faces":[{"h":42,"w":42,"x":269,"y":215},{"h":42,"w":42,"x":180,"y":220},{"h":48,"w":48,"x":370,"y":193},{"h":46,"w":46,"x":85,"y":178},{"h":52,"w":52,"x":487,"y":191}]},"small":{"faces":[{"h":42,"w":42,"x":269,"y":215},{"h":42,"w":42,"x":180,"y":220},{"h":48,"w":48,"x":370,"y":193},{"h":46,"w":46,"x":85,"y":178},{"h":52,"w":52,"x":487,"y":191}]}},"id_str":"2123428495426834433","indices":[133,156],"media_key":"3_2123428495426834433","media_results":{"result":{"media_key":"3_2123428495426834433"}},"media_url_https":"https://pbs.twimg.com/media/HXfu91fb0AE-XRf.jpg","original_info":{"focus_rects":[{"h":358,"w":640,"x":0,"y":61},{"h":480,"w":480,"x":0,"y":0},{"h":480,"w":421,"x":0,"y":0},{"h":480,"w":240,"x":56,"y":0},{"h":480,"w":640,"x":0,"y":0}],"height":480,"width":640},"sizes":{"large":{"h":480,"resize":"fit","w":640},"medium":{"h":480,"resize":"fit","w":640},"small":{"h":480,"resize":"fit","w":640},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MNQZVT7XFy"}]},"favorite_count":28020,"favorited":false,"full_text":"フィリピン・マニラ及び中国・深圳（シンセン）での一連の日程を終えて、帰国しました。\n\n本日午前は、APEC首脳会議に出席しました。\n\n世界経済の不確実性が高まる中、地域の成長と繁栄に向け、以下の点を強調しました。\n・「ルールに基づく自由で公正な国際経済秩序」の強化 https://t.co/MNQZVT7XFy","id_str":"2123428583909753253","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":232,"reply_count":2035,"retweet_count":2323,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM0Mjg1ODM4MjU5NjA5NjA=","richtext":{"richtext_tags":[]},"text":"フィリピン・マニラ及び中国・深圳（シンセン）での一連の日程を終えて、帰国しました。\n\n本日午前は、APEC首脳会議に出席しました。\n\n世界経済の不確実性が高まる中、地域の成長と繁栄に向け、以下の点を強調しました。\n・「ルールに基づく自由で公正な国際経済秩序」の強化\n・エネルギーを始めとするサプライチェーン強靱化の必要性\n・WTO改革への積極的な関与\n\n今回採択された「深圳首脳宣言」には、質の高いインフラや、越境データの信頼強化といった、我が国が重視する要素も多く盛り込まれました。\n\n日本の考えが、参加エコノミーに広く共有され、支持された証と受け止めています。\n\n今回の外遊を通じて深めることのできた各国との協力を基に、国際社会の課題への対処に一層注力してまいります。\n\nそして、帰国直後の先ほど、午後10時半から、エアフォース・ワンで帰国中のトランプ大統領と電話会談を行いました。\n\nトランプ大統領からは、今般の米中首脳会談や米中露首脳会談について詳細に説明があり、インド太平洋情勢やウクライナ情勢を含む国際社会の諸課題について率直に意見交換を行いました。\n\nこれまで米国との間では、日米同盟の強化やインド太平洋情勢を含む諸課題について緊密に意思疎通を行ってきています。\n私自身も、今週マニラにおいてトランプ大統領に対して、クアッド首脳会合の場においても、別途、二人の間で懇談した機会においても、我が国の考え方を改めてお伝えしました。\n\n今や最も信頼し合える同盟国である日米の関係を、更なる高みに引き上げてまいります。\n\nまた、今般、民主主義国家であるクアッドの首脳が揺るぎない結束を示したように、同盟国・同志国とも緊密に連携し、自由で開かれた国際秩序の維持・強化に向けて取り組んでいきます。"}}},"rest_id":"2123428583909753253","unmention_data":{},"views":{"count":"1917109","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123428583909753253","sortIndex":"2123615924039712733"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram