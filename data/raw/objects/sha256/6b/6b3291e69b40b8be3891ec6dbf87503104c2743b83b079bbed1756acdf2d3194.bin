":484,"w":865,"x":0,"y":0},{"h":655,"w":655,"x":83,"y":0},{"h":655,"w":575,"x":123,"y":0},{"h":655,"w":328,"x":246,"y":0},{"h":655,"w":865,"x":0,"y":0}],"height":655,"width":865},"sizes":{"large":{"h":655,"resize":"fit","w":865},"medium":{"h":655,"resize":"fit","w":865},"small":{"h":515,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Z4zSBedEkR"},{"display_url":"pic.x.com/Z4zSBedEkR","expanded_url":"https://x.com/jointstaffpa/status/2123358967422505441/photo/5","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2123358820399517696","indices":[95,118],"media_key":"3_2123358820399517696","media_results":{"result":{"media_key":"3_2123358820399517696"}},"media_url_https":"https://pbs.twimg.com/media/HXevmNybEAAxyAi.png","original_info":{"focus_rects":[{"h":491,"w":876,"x":0,"y":173},{"h":664,"w":664,"x":106,"y":0},{"h":664,"w":582,"x":147,"y":0},{"h":664,"w":332,"x":272,"y":0},{"h":664,"w":876,"x":0,"y":0}],"height":664,"width":876},"sizes":{"large":{"h":664,"resize":"fit","w":876},"medium":{"h":664,"resize":"fit","w":876},"small":{"h":515,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Z4zSBedEkR"}]},"favorite_count":2485,"favorited":false,"full_text":"令和８年１１月１９日（木）午前から午後にかけて、ロシアの爆撃機（Ｔｕ－９５）×２機が、太平洋から飛来し、与那国島と台湾との間を通過した後、対馬海峡を通過し大陸方面へ飛行したことを確認した。 https://t.co/Z4zSBedEkR","id_str":"2123358967422505441","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":72,"reply_count":47,"retweet_count":832,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjMzNTg5NjczNjM3NzY1MTI=","richtext":{"richtext_tags":[]},"text":"令和８年１１月１９日（木）午前から午後にかけて、ロシアの爆撃機（Ｔｕ－９５）×２機が、太平洋から飛来し、与那国島と台湾との間を通過した後、対馬海峡を通過し大陸方面へ飛行したことを確認した。\n　また、同日午前から午後にかけて、ロシアの哨戒機（Ｔｕ－１４２）×２機が、日本海から飛来し、対馬海峡を通過した後、東シナ海上で上記のロシア爆撃機と合流し、再び対馬海峡を通過し大陸方面へ飛行したことを確認した。\n　これに対し、航空自衛隊の南西航空方面隊等の戦闘機を緊急発進させ対応した。"}}},"rest_id":"2123358967422505441","unmention_data":{},"views":{"count":"219203","state":"EnabledWithCount"}}},"rest_id":"2123361637231190423","unmention_data":{},"views":{"count":"140658","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123361637231190423","sortIndex":"2123615924039712713"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2123372392798142557"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.