ニタリングの結果をまとめて掲載しています。","type":"STRING"}},{"key":"domain","value":{"string_value":"policies.env.go.jp","type":"STRING"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"policies.env.go.jp","type":"STRING"}},{"key":"title","value":{"string_value":"ALPS処理水に係る海域モニタリング情報 | 環境省","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/fpAOpMJxGY","type":"STRING"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary_large_image","url":"https://t.co/fpAOpMJxGY","user_refs_results":[]},"rest_id":"https://t.co/fpAOpMJxGY"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":1},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/3692310981/5e84849fe6a5c60bc3a3818c6f4cbec4_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/286056244/1791195170"},"core":{"created_at":"Fri Apr 22 08:05:55 +0000 2011","name":"環境省","screen_name":"Kankyo_Jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODYwNTYyNDQ=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2122858110306103647"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"環境省の公式アカウントです。皆さまにお知らせしたい情報を発信していきます。なお、Xによせられたコメントへの返信はしておりません。運用方針はこちらhttps://t.co/5x04ocrpyS\n英語版Xはこちら @MOEJ_Climate","entities":{"description":{"urls":[{"display_url":"env.go.jp/info/sns/twitt…","expanded_url":"https://www.env.go.jp/info/sns/twitter.html","indices":[72,95],"url":"https://t.co/5x04ocrpyS"}]},"url":{"urls":[{"display_url":"env.go.jp/index.html","expanded_url":"https://www.env.go.jp/index.html","indices":[0