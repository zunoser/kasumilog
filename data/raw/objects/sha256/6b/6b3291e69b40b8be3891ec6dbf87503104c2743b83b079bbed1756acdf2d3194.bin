3}]},"small":{"faces":[{"h":82,"w":82,"x":263,"y":422}]}},"id_str":"2123289075792879617","indices":[126,149],"media_key":"3_2123289075792879617","media_results":{"result":{"media_key":"3_2123289075792879617"}},"media_url_https":"https://pbs.twimg.com/media/HXdwKi4aIAEvL6-.jpg","original_info":{"focus_rects":[{"h":1075,"w":1920,"x":0,"y":1085},{"h":1920,"w":1920,"x":0,"y":240},{"h":2160,"w":1895,"x":25,"y":0},{"h":2160,"w":1080,"x":594,"y":0},{"h":2160,"w":1920,"x":0,"y":0}],"height":2160,"width":1920},"sizes":{"large":{"h":2048,"resize":"fit","w":1820},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HC9Cu5NZqp"},{"display_url":"pic.x.com/HC9Cu5NZqp","expanded_url":"https://x.com/MLIT_JAPAN/status/2123310304406786352/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":245,"w":245,"x":249,"y":743},{"h":251,"w":251,"x":405,"y":745}]},"medium":{"faces":[{"h":143,"w":143,"x":146,"y":435},{"h":147,"w":147,"x":237,"y":436}]},"orig":{"faces":[{"h":259,"w":259,"x":263,"y":784},{"h":265,"w":265,"x":428,"y":786}]},"small":{"faces":[{"h":81,"w":81,"x":82,"y":246},{"h":83,"w":83,"x":134,"y":247}]}},"id_str":"2123289075813847040","indices":[126,149],"media_key":"3_2123289075813847040","media_results":{"result":{"media_key":"3_2123289075813847040"}},"media_url_https":"https://pbs.twimg.com/media/HXdwKi9aEAANPlZ.jpg","original_info":{"focus_rects":[{"h":1075,"w":1920,"x":0,"y":489},{"h":1920,"w":1920,"x":0,"y":66},{"h":2160,"w":1895,"x":0,"y":0},{"h":2160,"w":1080,"x":0,"y":0},{"h":2160,"w":1920,"x":0,"y":0}],"height":2160,"width":1920},"sizes":{"large":{"h":2048,"resize":"fit","w":1820},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HC9Cu5NZqp"}]},"favorite_count":24,"favorited":false,"full_text":"|◤   　    🎥 YouTube配信中\n 　　　#放課後ゲンバミッション！   　◢|\n\n🚁 災害から街を守るために、ドローンが活躍！？\n河川敷の安全を支える最新技術に中高生リポーターが潜入！\n▶️https://t.co/Rh2naGZK3F https://t.co/HC9Cu5NZqp","id_str":"2123310304406786352","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":2,"retweet_count":6,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[27,39],"text":"放課後ゲンバミッション"},{"indices":[414,424],"text":"国交省建設産業PR"},{"indices":[425,436],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/MiQe4dNbEco","expanded_url":"https://youtu.be/MiQe4dNbEco","indices":[102,125],"url":"https://t.co/OM6a26Y4Mg"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[373,396],"url":"https://t.co/kPJLLRPaZ9"}],"user_mentions":[{"id_str":"2100746664126648320","indices":[398,413],"name":"放課後ゲンバミッション","screen_name":"houkago_gennmi"}]},"id":"Tm90ZVR3ZWV0OjIxMjMzMTAzMDQyNzY3MDExODQ=","text":"|◤   　    🎥 YouTube配信中\n 　　　#放課後ゲンバミッション！   　◢|\n\n🚁 災害から街を守るために、ドローンが活躍！？\n河川敷の安全を支える最新技術に中高生リポーターが潜入！\n▶️https://t.co/OM6a26Y4Mg\n\n今回は、ドローンを使って河川敷を測量するゲンバへ！普段なかなか触れることのないドローンの操縦に挑戦！\n\nドローンによる測量は、地形の起伏や高低差をデータ化し、河川敷の維持管理を支え、台風や大雨などの災害から街を守ることにつながっているよ✨\n\n最新技術で、街を災害から守る建設業の仕事。\nその意外な魅力をぜひ動画でチェックしてみてください👀\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPaZ9\n\n@houkago_gennmi\n#国交省建設産業PR\n#MLIT建設産業PR"}}},"rest_id":"2123310304406786352","unmention_data":{},"views":{"count":"5093","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123310304406786352","sortIndex":"2123615924039712683"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemCont