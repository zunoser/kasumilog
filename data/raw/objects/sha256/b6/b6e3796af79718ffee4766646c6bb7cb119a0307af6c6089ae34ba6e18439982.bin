alse},"rest_id":"938375954149261312","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1451,"tweets":12329},"verification":{"verified":false},"website":{"url":"https://t.co/ej0arfzV5O"}}}},"edit_control":{"edit_tweet_ids":["2121166198221979996"],"editable_until_msecs":"1794564005000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"IP_BASE"}}},"policy":"ByInvitation"},"conversation_id_str":"2121166198221979996","created_at":"Fri Nov 13 09:00:05 +0000 2026","display_text_range":[0,141],"entities":{"hashtags":[{"indices":[1,8],"text":"IPBASE"},{"indices":[31,39],"text":"スタートアップ"},{"indices":[48,51],"text":"知財"},{"indices":[98,103],"text":"大迫瑞季"}]},"favorite_count":0,"favorited":false,"full_text":"◤#IPBASE YouTubeチャンネルで動画公開中！◢\n\n#スタートアップ に知ってほしい、#知財 に関するコンテンツを配信する「IP BASEチャンネル」。\n新企画として、チャンネルMCの #大迫瑞季 がお酒を片手にゆるりとお話を伺う『大迫瑞季の乾杯トーク』がはじまりました！","id_str":"2121166198221979996","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":1,"retweet_count":0,"retweeted":false,"user_id_str":"938375954149261312"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[1,8],"text":"IPBASE"},{"indices":[31,39],"text":"スタートアップ"},{"indices":[48,51],"text":"知財"},{"indices":[98,103],"text":"大迫瑞季"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/wpDn6djVBiI","expanded_url":"https://youtu.be/wpDn6djVBiI","indices":[636,659],"url":"https://t.co/Iyo2N7QtDd"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExNjYxOTgwNjY4Mzk1NTI=","text":"◤#IPBASE YouTubeチャンネルで動画公開中！◢\n\n#スタートアップ に知ってほしい、#知財 に関するコンテンツを配信する「IP BASEチャンネル」。\n新企画として、チャンネルMCの #大迫瑞季 がお酒を片手にゆるりとお話を伺う『大迫瑞季の乾杯トーク』がはじまりました！\nインタビューしたのは、このお二人です。\n\nBPキャピタル株式会社\n👨‍💻執行役員／マネージングパートナー 浜田智さん\n👨‍💻チーフキャピタリスト 濱村晃司さん\n\n「地域から日本を元気にする」をスローガンに掲げるBPキャピタル株式会社が第1号ファンドとして立ち上げたのが『奥能登SDGsファンド』。\n石川県在住の濱村さんは当初、このファンドには金融機関側として携わっていたそう。\nその後、震災をきっかけに復興ファンドがスタートしたタイミングでBPキャピタルへ合流したのだとか。\n今回はそんなエピソードをお聞きしながら、独自の特許技術をもつ出資先が生産する新しい和酒『能登浄酎』をふるまっていただきました！\n\nさらに、出資を通じて事業化を後押しした陸上養殖のお魚、甘味料不使用のグラノーラも味わいながら、知財活用の重要性や地方創生の取り組みについてお話いただきました☺\n\n地域のスタートアップと投資家、どちらの視点でもご参考いただける動画になっています。\nぜひご視聴ください！👇\n\n▼【大迫瑞季の乾杯トーク #1】ただ者じゃない人を募集！？地域から日本を元気にするBPキャピタルの思いとは？\nhttps://t.co/Iyo2N7QtDd"}}},"rest_id":"2121166198221979996","unmention_data":{},"views":{"count":"7142","state":"EnabledWithCount"}}}},"rest_id":"2125061851113550118","unmention_data":{},"views":{"count":"6457","state":"EnabledWithCount"}}},"user_id_str":"266566401"},"rest_id":"2125164066096423022","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"765","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125164066096423022","sortIndex":"2125416080338845656"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2125160788977721344/q6aXJ8zo?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2125160788977721344/q6aXJ8zo?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"官房長官の定例記者会見の様子などをご覧になれます。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.kantei.go.jp","type":"STRING"}},{"key":"thumbn