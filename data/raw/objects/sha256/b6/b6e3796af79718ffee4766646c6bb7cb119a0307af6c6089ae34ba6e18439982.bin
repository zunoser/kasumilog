3","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":60,"w":60,"x":120,"y":75},{"h":62,"w":62,"x":382,"y":79}]},"medium":{"faces":[{"h":60,"w":60,"x":120,"y":75},{"h":62,"w":62,"x":382,"y":79}]},"orig":{"faces":[{"h":60,"w":60,"x":120,"y":75},{"h":62,"w":62,"x":382,"y":79}]},"small":{"faces":[{"h":60,"w":60,"x":120,"y":75},{"h":62,"w":62,"x":382,"y":79}]}},"id_str":"2125154443897491456","indices":[79,102],"media_key":"3_2125154443897491456","media_results":{"result":{"media_key":"3_2125154443897491456"}},"media_url_https":"https://pbs.twimg.com/media/HX4QtQlaUAAfsrf.jpg","original_info":{"focus_rects":[{"h":329,"w":587,"x":0,"y":0},{"h":391,"w":391,"x":0,"y":0},{"h":391,"w":343,"x":0,"y":0},{"h":391,"w":196,"x":34,"y":0},{"h":391,"w":587,"x":0,"y":0}],"height":391,"width":587},"sizes":{"large":{"h":391,"resize":"fit","w":587},"medium":{"h":391,"resize":"fit","w":587},"small":{"h":391,"resize":"fit","w":587},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/BliERW8CGK"},{"display_url":"pic.x.com/BliERW8CGK","expanded_url":"https://x.com/MofaJapan_jp/status/2125154557957411151/photo/4","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":49,"w":49,"x":175,"y":60},{"h":52,"w":52,"x":156,"y":58},{"h":53,"w":53,"x":330,"y":98}]},"medium":{"faces":[{"h":49,"w":49,"x":175,"y":60},{"h":52,"w":52,"x":156,"y":58},{"h":53,"w":53,"x":330,"y":98}]},"orig":{"faces":[{"h":49,"w":49,"x":175,"y":60},{"h":52,"w":52,"x":156,"y":58},{"h":53,"w":53,"x":330,"y":98}]},"small":{"faces":[{"h":49,"w":49,"x":175,"y":60},{"h":52,"w":52,"x":156,"y":58},{"h":53,"w":53,"x":330,"y":98}]}},"id_str":"2125154460431429633","indices":[79,102],"media_key":"3_2125154460431429633","media_results":{"result":{"media_key":"3_2125154460431429633"}},"media_url_https":"https://pbs.twimg.com/media/HX4QuOLaMAEL5tn.jpg","original_info":{"focus_rects":[{"h":321,"w":573,"x":0,"y":0},{"h":382,"w":382,"x":167,"y":0},{"h":382,"w":335,"x":191,"y":0},{"h":382,"w":191,"x":263,"y":0},{"h":382,"w":573,"x":0,"y":0}],"height":382,"width":573},"sizes":{"large":{"h":382,"resize":"fit","w":573},"medium":{"h":382,"resize":"fit","w":573},"small":{"h":382,"resize":"fit","w":573},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/BliERW8CGK"}]},"favorite_count":663,"favorited":false,"full_text":"高市総理大臣は、ASEAN関連首脳会議とAPEC首脳会議に出席した後、日米電話首脳会談やペルー、チリとの首脳会談に臨み、この外交ウィークを締めくくりました。 https://t.co/BliERW8CGK","id_str":"2125154557957411151","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":17,"retweet_count":106,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUxNTQ1NTc4OTQ1Njk5ODQ=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、ASEAN関連首脳会議とAPEC首脳会議に出席した後、日米電話首脳会談やペルー、チリとの首脳会談に臨み、この外交ウィークを締めくくりました。\n約1年前、高市総理大臣は外交ウィークからその外交を始動させました。それ以来、外国訪問や各国首脳の訪日などの機会に、東南アジア諸国や、欧州、中南米、太平洋島嶼国など各国との連携と具体的協力を推進してきました。\n東南アジア諸国との関係では、5月のベトナム訪問の際に、進化した自由で開かれたインド太平洋（FOIP）を発表してベトナムから支持を得たことを皮切りに、地域の平和と安定に向けた日本の取組について、東南アジア諸国を含む各国から理解や支持を得ています。\nこの1年間、シンガポール、インドネシア、フィリピン、マレーシア、ラオス、ベトナムの首脳が日本を訪問されました。高市総理大臣もマレーシア、ベトナム、フィリピンを訪問し、タイ首相とも会談を行いました。喫緊の課題について、パワー・アジアを提唱するなど、ASEAN諸国から最も信頼される国として着実な歩みを進めています。\n来年、ASEAN創設60周年と福田ドクトリン50周年を迎えます。この外交ウィークにおいて、主要国の中でもとりわけ丁寧なASEAN外交を展開したことを基礎として、誠実に、「共に、強く豊かになる」外交を、ASEAN諸国と共に進めていきたいと思います。"}}},"rest_id":"2125154557957411151","unmention_data":{},"views":{"count":"12207","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125154557957411151","sortIndex":"2125416080338845646"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":52},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1697575938316529664/Iob6ICh3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/331514169/1655191913"},"core":{"created_at":"Fri Jul 08 08:59:28 +0000 2011","name":"財務省","screen_name":"MOF_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMzE1MTQxNjk=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関3-1-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"財務省の公式アカウントです。財務省ホームページに掲載する情報を中心に発信していきます。\n【運用ポリシー】https://t.co/Mk40iFUuyb\n【財務省note】https://t.co/PEuOEDD4Nu","entities":{"description":{"urls":[{"display_url":"mof.go.jp/about_mof/soci…","expanded_url":"http://www.mof.go.jp/about_mof/social_media_account/index.html","indices":[52,75],"url":"https://t.co/Mk40iFUuyb"},{"display_url":"mof-gov.note.jp","expanded_url":"https://mof-gov.note.jp/","indices":[85,108],"url":"https://t.co/PEuOEDD4Nu"}]},"url":{"urls":[{"display_url":"mof.go.jp","expanded_url":"https://www.mof.go.jp/","indices":[0,23],"url":"https://t.co/6OsjuYnq8O"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":367602,"following":64},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"331514169","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1822,"tweets":6327},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/6OsjuYnq8O"}}}},"edit_control":{"edit_tweet_ids":["2125154455146602938"],"editable_until_msecs":"1795514880000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2125154455146602938","created_at":"Tue Nov 24 09:08:00 +0000 2026","display_text_range":[0,96],"entities":{"hashtags":[{"indices":[1,6],"text":"地震保険"}]},"favorite_count":30,"favorited":false,"full_text":"【#地震保険】\n日本損害保険協会主催で、地震保険制度創設60周年記念イベントが開催されました。\n財務省からは、中山総括審議官が出席して地震保険の更なる普及促進を進める旨、決意表明を行いました。","id_str":"2125154455146602938","is_quote_status":true,"lang":"ja","quote_count":0,"quoted_status_id_str":"2123650868235096131","quoted_status_permalink":{"display":"x.com/sonpokyokai/st…","expanded":"https://twitter.com/sonpokyokai/status/2123650868235096131","url":"https://t.co/1VmiwV7gSi"},"reply_count":19,"retweet_count":10,"retweeted":false,"user_id_str":"331514169"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[1,6],"text":"地震保険"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUxNTQ0NTUxMDg5Mjc0ODg=","richtext":{"richtext_tags":[]},"text":"【#地震保険】\n日本損害保険協会主催で、地震保険制度創設60周年記念イベントが開催されました。\n財務省からは、中山総括審議官が出席して地震保険の更なる普及促進を進める旨、決意表明を行いました。\n今後も、国民の皆様に地震への備えを進めていただくため、官民で連携し、これまで以上に取組を広げてまいります。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":1},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1749713224499650560/EMEeiOsv_normal.jpg"},"banner":{"image_url":"https://pbs.twi