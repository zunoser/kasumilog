om/media/HX3uVnPaEAAfuqj.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":54},{"h":905,"w":905,"x":118,"y":0},{"h":905,"w":794,"x":173,"y":0},{"h":905,"w":453,"x":344,"y":0},{"h":905,"w":1200,"x":0,"y":0}],"height":905,"width":1200},"sizes":{"large":{"h":905,"resize":"fit","w":1200},"medium":{"h":905,"resize":"fit","w":1200},"small":{"h":513,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/eNe3OL9rQ6"}]},"favorite_count":38,"favorited":false,"full_text":"【令和8年11月23日】井林大臣、髙橋政務官が北海道内の事業を視察 https://t.co/eNe3OL9rQ6","id_str":"2125116660235542930","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":3,"retweet_count":12,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUxMTY2NjAxODUyMzU0NTY=","richtext":{"richtext_tags":[]},"text":"【令和8年11月23日】井林大臣、髙橋政務官が北海道内の事業を視察\n\n11月23日(月)、井林大臣は、北海道内の港湾や道路整備、北海道新幹線建設工事の現場を視察しました。視察では、苫小牧西港、道央圏連絡道路の長沼南幌道路、倶知安余市道路の新稲穂トンネルといった地域の安全・安心や物流・産業活動を支えるインフラ整備が着実に進められていることを確認しました。また、髙橋政務官とともに、北海道新幹線札樽トンネル（札幌工区）を訪れ、事業の概要や工事の状況について、説明を受けました。"}}},"rest_id":"2125116660235542930","unmention_data":{},"views":{"count":"8246","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125116660235542930","sortIndex":"2125416080338845611"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label