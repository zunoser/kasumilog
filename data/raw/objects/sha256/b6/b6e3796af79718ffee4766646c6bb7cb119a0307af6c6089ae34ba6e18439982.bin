"x":762,"y":205}]},"small":{"faces":[{"h":43,"w":43,"x":423,"y":306},{"h":68,"w":68,"x":539,"y":145}]}},"id_str":"2125051032304812033","indices":[121,144],"media_key":"3_2125051032304812033","media_results":{"result":{"media_key":"3_2125051032304812033"}},"media_url_https":"https://pbs.twimg.com/media/HX2yp6YbAAExUwC.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":2},{"h":540,"w":540,"x":330,"y":0},{"h":540,"w":474,"x":363,"y":0},{"h":540,"w":270,"x":465,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/qJradBGZ2t"}]},"favorite_count":14,"favorited":false,"full_text":"／\n今夜、フジテレビほかで放送📺！\n「ニッポン 今だ！ラボ」\n※地域により放送日時が異なります。\n＼\n\n今回のテーマは【何が本当？偽・誤情報の今！】🔎\n\n今田耕司さん・森香澄さんがナビゲート！\nナレーションは男性ブランコの浦井のりひろさん。 https://t.co/qJradBGZ2t","id_str":"2125386486455681514","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":3,"retweet_count":5,"retweeted":false,"user_id_str":"461064204"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"fujitv.co.jp/nippon_imada_l…","expanded_url":"https://www.fujitv.co.jp/nippon_imada_labo/","indices":[194,217],"url":"https://t.co/ysZVWbHtn5"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUzODY0ODYzODg0OTQzMzY=","text":"／\n今夜、フジテレビほかで放送📺！\n「ニッポン 今だ！ラボ」\n※地域により放送日時が異なります。\n＼\n\n今回のテーマは【何が本当？偽・誤情報の今！】🔎\n\n今田耕司さん・森香澄さんがナビゲート！\nナレーションは男性ブランコの浦井のりひろさん。\n難しく思われがちな国の政策を「自分ゴト」として解説。\n「知るのは、今だ！」\n\n▼番組公式サイト\n（各地域での放送スケジュールや番組情報はこちら）\nhttps://t.co/ysZVWbHtn5\n\n放送後には、番組公式サイトで放送内容動画を公開するほか、\nTVerでも過去放送を配信中です！\n※再生できない場合はブラウザからご覧ください。"}}},"rest_id":"2125386486455681514","unmention_data":{},"views":{"count":"2709","state":"EnabledWithCount"}}}}},"entryId":"tweet