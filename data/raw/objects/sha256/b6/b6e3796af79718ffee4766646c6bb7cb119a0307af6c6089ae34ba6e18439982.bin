e":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/ygnFZCCkLB"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/ygnFZCCkLB","expanded_url":"https://x.com/takaichi_sanae/status/2125121687754838496/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":243,"w":243,"x":1141,"y":263},{"h":237,"w":237,"x":621,"y":277}]},"medium":{"faces":[{"h":142,"w":142,"x":668,"y":154},{"h":139,"w":139,"x":364,"y":162}]},"orig":{"faces":[{"h":309,"w":309,"x":1449,"y":335},{"h":302,"w":302,"x":789,"y":352}]},"small":{"faces":[{"h":80,"w":80,"x":378,"y":87},{"h":78,"w":78,"x":206,"y":92}]}},"id_str":"2125121153647902721","indices":[86,109],"media_key":"3_2125121153647902721","media_results":{"result":{"media_key":"3_2125121153647902721"}},"media_url_https":"https://pbs.twimg.com/media/HX3ybgvaAAEKx5d.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":758,"y":0},{"h":1734,"w":1521,"x":865,"y":0},{"h":1734,"w":867,"x":1192,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/ygnFZCCkLB"}]},"favorite_count":34708,"favorited":false,"full_text":"先ほど、ICCの赤根所長が官邸にお越し下さいました。\n\n我が国は、ICCを一貫して支持しており、これからも支持していきます。\nこうした立場を、私から改めてお伝えしました。 https://t.co/ygnFZCCkLB","id_str":"2125121687754838496","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1633,"reply_count":2472,"retweet_count":4225,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUxMjE2ODc2OTE4NTc5MjA=","richtext":{"richtext_tags":[]},"text":"先ほど、ICCの赤根所長が官邸にお越し下さいました。\n\n我が国は、ICCを一貫して支持しており、これからも支持していきます。\nこうした立場を、私から改めてお伝えしました。\n\nまた、赤根所長からは、従来より、ICCを巡る現下の状況を受け、2027年分のICC分担金を早期に支払ってほしい旨の要請を重ねて頂いておりました。\n\nこの点につき、私の指示の下、政府全体で真剣に検討した結果として、最大の財政拠出国としてICCを支えていくべく、「2027年分のICC分担金の全額を年内に支払うこと」を政府として決定した旨を、お伝えしました。\n\nICCが、「法の支配」の徹底のため、その本来の役割と機能を果たせるよう、日本政府として力強く支援していきます。"}}},"rest_id":"2125121687754838496","unmention_data":{},"views":{"count":"3526261","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125121687754838496","sortIndex":"2125416080338845615"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2125121062765805568/CqM3jENX?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2125121062765805568/CqM3jENX?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"令和8年11月24日、小野田大臣が記者会見を行いました。［冒頭発言］感染症危機管理対応訓練について［質疑応答］経済安全保障重要技術育成プログラム 等","type":"STRING"}},{"key":"domain","value":{"string_value":"www.gov-online.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2125121062765805568/CqM3jENX?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2125121062765805568/CqM3jENX