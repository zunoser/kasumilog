4},{"h":80,"w":80,"x":967,"y":93}]},"orig":{"faces":[{"h":116,"w":116,"x":274,"y":176},{"h":114,"w":114,"x":812,"y":190},{"h":114,"w":114,"x":592,"y":194},{"h":128,"w":128,"x":1354,"y":276},{"h":134,"w":134,"x":1076,"y":144},{"h":138,"w":138,"x":1652,"y":160}]},"small":{"faces":[{"h":38,"w":38,"x":90,"y":58},{"h":37,"w":37,"x":269,"y":63},{"h":37,"w":37,"x":196,"y":64},{"h":42,"w":42,"x":449,"y":91},{"h":44,"w":44,"x":357,"y":47},{"h":45,"w":45,"x":548,"y":53}]}},"id_str":"2125174129028644865","indices":[129,152],"media_key":"3_2125174129028644865","media_results":{"result":{"media_key":"3_2125174129028644865"}},"media_url_https":"https://pbs.twimg.com/media/HX4inFaaQAELBy2.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1463,"w":1463,"x":0,"y":0},{"h":1463,"w":1283,"x":0,"y":0},{"h":1463,"w":732,"x":0,"y":0},{"h":1463,"w":2048,"x":0,"y":0}],"height":1463,"width":2048},"sizes":{"large":{"h":1463,"resize":"fit","w":2048},"medium":{"h":857,"resize":"fit","w":1200},"small":{"h":486,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/r3JVwPRhCn"}]},"favorite_count":66,"favorited":false,"full_text":"堀井外務副大臣は、チリ上院議員一行による表敬を受けました。日本とチリは様々な分野で協力関係にあり、ホセ・アントニオ・カスト・リスト大統領訪日により、経済面をはじめとする両国関係の更なる緊密化を確認しました。\n\nhttps://t.co/rgtgoMMNoM https://t.co/r3JVwPRhCn","id_str":"2125174157491278170","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":5,"retweet_count":14,"retweeted":false,"user_id_str":"303730149"},"rest_id":"2125174157491278170","unmention_data":{},"views":{"count":"6341","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125174157491278170","sortIndex":"2125416080338845664"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__ty