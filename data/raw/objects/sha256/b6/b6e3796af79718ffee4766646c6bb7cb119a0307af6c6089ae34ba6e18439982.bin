895,"w":448,"x":537,"y":0},{"h":895,"w":1523,"x":0,"y":0}],"height":895,"width":1523},"sizes":{"large":{"h":895,"resize":"fit","w":1523},"medium":{"h":705,"resize":"fit","w":1200},"small":{"h":400,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/tzZXFvQgLg"}]},"favorite_count":3,"favorited":false,"full_text":"【地震保険創設60周年記念イベントを開催しました】\n11月11日（水）、本年で地震保険制度が創設60周年を迎えたことを記念し、関係省庁から来賓を迎え、地震保険の更なる普及促進への気運を高めるためのイベントを開催しました。詳細は以下リンク先からご覧ください。\nhttps://t.co/h1Z2axwW28 https://t.co/tzZXFvQgLg","id_str":"2123650868235096131","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":1,"retweeted":false,"user_id_str":"1747895030294171648"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[214,219],"text":"地震保険"},{"indices":[220,225],"text":"損害保険"},{"indices":[226,234],"text":"損害保険代理店"},{"indices":[235,240],"text":"なまベェ"},{"indices":[241,244],"text":"地震"},{"indices":[245,250],"text":"損保協会"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"sonpo.or.jp/news/notice/20…","expanded_url":"https://www.sonpo.or.jp/news/notice/2026/ipo3g90000000ncd-att/261120_01.pdf","indices":[129,152],"url":"https://t.co/6YrkQw8QFJ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM2NTA4NjgxMTM1MDIyMDg=","richtext":{"richtext_tags":[]},"text":"【地震保険創設60周年記念イベントを開催しました】\n11月11日（水）、本年で地震保険制度が創設60周年を迎えたことを記念し、関係省庁から来賓を迎え、地震保険の更なる普及促進への気運を高めるためのイベントを開催しました。詳細は以下リンク先からご覧ください。\nhttps://t.co/6YrkQw8QFJ\n\n当協会では、今後も引き続き、地震リスクや地震保険の必要性を広く呼びかけ、地震保険の理解促進と加入促進を図っていきます。\n#地震保険 #損害保険 #損害保険代理店 #なまベェ #地震 #損保協会"}}},"rest_id":"2123650868235096131","unmention_data":{},"views":{"count":"5376","state":"EnabledWithCount"}}},"rest_id":"2125154455146602938","unmention_data":{},"views":{"count":"6484","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125154455146602938","sortIndex":"2125416080338845645"},{"content":{"__typename":"Ti