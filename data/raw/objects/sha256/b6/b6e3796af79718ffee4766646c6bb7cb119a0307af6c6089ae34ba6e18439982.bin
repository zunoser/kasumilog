IxMjUwOTM2ODczMzYyODgyNTY=","richtext":{"richtext_tags":[]},"text":"＜令和8年11月20日からの大雪により被害を受けられた皆様へ＞\n#災害救助法 が適用された地域でご契約者が被害を受けられた等の場合、各種損害保険について特別措置を実施することとしています。また、#自然災害 の後には、住宅修理などに関し、「保険が使える」と言って勧誘する業者とのトラブルが増加する傾向にあります。このような勧誘を受けた場合は、まずはご加入の「損害保険会社」または「損害保険代理店」にご相談ください。 詳細は以下からご覧ください。\n【特別措置等】https://t.co/Hy2YRcao83\n【業者とのトラブル】https://t.co/hQzXO9UHNM\n\n#大雪 #自然災害 #福島県 #相談窓口 #損害保険 #火災保険 #自動車保険 #傷害保険 #消費者トラブル #災害便乗商法 #損保協会"}}},"rest_id":"2125093687466279029","unmention_data":{},"views":{"count":"2436","state":"EnabledWithCount"}}}},"user_id_str":"276848601"},"rest_id":"2125110677257986474","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"833","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2125110677257986474","sortIndex":"2125416080338845606"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/281874178/1611288198"},"core":{"created_at":"Thu Apr 14 04:13:40 +0000 2011","name":"特許庁","screen_name":"jpo_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODE4NzQxNzg=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関3-4-3"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensi