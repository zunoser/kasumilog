"reply_count":4,"retweet_count":19,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/erp/erp_…","expanded_url":"https://www.mofa.go.jp/mofaj/erp/erp_2/sk/pageit_000001_03168.html","indices":[203,226],"url":"https://t.co/5TZrWHWne8"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ2OTg0NTc0MjQ2Nzg5MTI=","richtext":{"richtext_tags":[]},"text":"茂木外務大臣はスロバキア訪問に際し、スロバキアの経済紙（Hospodárske noviny）に「日本とV4が共に紡ぐ未来」と題する寄稿を行いました。100年以上にわたって育まれてきた日本とV4諸国との深いつながりを振り返りながら、V4が再び活性化する中で、信頼できるパートナーである日本とV4諸国が、経済、経済安全保障、科学技術といった未来を切り拓く分野で力を合わせていくことの重要性を発信しました。\n\nhttps://t.co/5TZrWHWne8"}}},"rest_id":"2094698457533718705","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3974","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094698457533718705","sortIndex":"2094728807104643053"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":52},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1697575938316529664/Iob6ICh3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/331514169/1655191913"},"core":{"created_at":"Fri Jul 08 08:59:28 +0000 2011","name":"財務省","screen_name":"MOF_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMzE1MTQxNjk=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関3-1-1"},"media