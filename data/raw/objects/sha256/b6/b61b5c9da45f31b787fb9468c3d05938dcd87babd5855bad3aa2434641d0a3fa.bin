999468503040","media_results":{"result":{"media_key":"3_2094599999468503040"}},"media_url_https":"https://pbs.twimg.com/media/HRGDmhLagAAqdCB.jpg","original_info":{"focus_rects":[{"h":1848,"w":3300,"x":0,"y":0},{"h":2200,"w":2200,"x":302,"y":0},{"h":2200,"w":1930,"x":437,"y":0},{"h":2200,"w":1100,"x":852,"y":0},{"h":2200,"w":3300,"x":0,"y":0}],"height":2200,"width":3300},"sizes":{"large":{"h":1365,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/vjCj64xqab"}]},"favorite_count":22,"favorited":false,"full_text":"【神田眞人ADB総裁からのメッセージ】\n私は、地域の歴史におけるこの重要な局面において、アジア開発銀行（ADB）総裁を引き続き務めることについて、加盟国・地域の皆さまから信任をいただいたことを大変光栄に思います。 https://t.co/vjCj64xqab","id_str":"2094600058499182732","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":13,"retweeted":false,"user_id_str":"1897876536419848192"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"adb.org/ja/news/masato…","expanded_url":"https://www.adb.org/ja/news/masato-kanda-reelected-adb-president-5-year-term","indices":[443,466],"url":"https://t.co/hWoTpv2RHI"}],"user_mentions":[{"id_str":"1368840151699320833","indices":[467,480],"name":"Masato Kanda","screen_name":"ADBPresident"}]},"id":"Tm90ZVR3ZWV0OjIwOTQ2MDAwNTgzNzMzMTI1MTI=","richtext":{"richtext_tags":[]},"text":"【神田眞人ADB総裁からのメッセージ】\n私は、地域の歴史におけるこの重要な局面において、アジア開発銀行（ADB）総裁を引き続き務めることについて、加盟国・地域の皆さまから信任をいただいたことを大変光栄に思います。\n\nアジア・太平洋地域は、前回の危機から経済が十分に回復しないうちに新たなショックに見舞われており、国際秩序もここ数世代で最も厳しい緊張状態にあります。こうした中、ADBは地域の安定の錨（いかり）でなければなりません。しかし、安定とは現状維持を意味するものではありません。私たちは、今日の人々を守るとともに、次世代のためにより明るい未来を築くため、加盟国・地域が必要とするスピードと規模で資金や支援を動員しなければなりません。\n\n私にとって、これこそが今後果たすべき使命です。すなわち、各国が今日直面する課題を乗り越えられるよう支援するとともに、次の世代が明日必要とする強靱性と機会を築くことです。私は、その取組を皆さまと共に前進させていけることに、深く感謝しています。\n\nhttps://t.co/hWoTpv2RHI\n@ADBPresident"}}},"rest_id":"2094600058499182732","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3994","state":"EnabledWithCount"}}},"user_id_str":"331514169"},"rest_id":"2094619364767252906","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1225","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094619364767252906","sortIndex":"2094728807104642988"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2094434707140485120/X5nieIm6?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mof.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":200,"url":"https://pbs.twimg.com/card_img/2094434707140485120/X5nieIm6?format=png&name=280x280_2","width":200},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":203,"url":"https://pbs.twimg.com/card_img/2094434707140485120/X5nieIm6?format=png&name=orig","width":200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2094434707140485120/X5nieIm6?format=png&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":203,"url":"https://pbs.twimg.com/card_img/2094434707140485120/X5nieIm6?format=png&name=2048x2048_2_exp","width":200},"type":"IMAGE"}},{"key":"vanity_url",