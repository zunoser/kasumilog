al_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2991517,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":527,"tweets":1748},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2094662562373939406"],"editable_until_msecs":"1788245046000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":40,"bookmarked":false,"conversation_id_str":"2094662562373939406","created_at":"Tue Sep 01 05:44:06 +0000 2026","display_text_range":[0,143],"entities":{},"favorite_count":5418,"favorited":false,"full_text":"この度、アジア・太平洋地域の開発問題に取り組む「アジア開発銀行（ADB)」の神田眞人総裁が、加盟国の支持を得て、全会一致で再任されたことを歓迎します。\n\n私も、片山財務大臣とともに、加盟国に対して、神田総裁への支持を呼び掛けてまいりましたが、今回の加盟国の支持に対し感謝の意を表します。","id_str":"2094662562373939406","is_quote_status":false,"lang":"ja","quote_count":31,"reply_count":353,"retweet_count":598,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ2NjI1NjIzMzE5OTIwNjQ=","richtext":{"richtext_tags":[]},"text":"この度、アジア・太平洋地域の開発問題に取り組む「アジア開発銀行（ADB)」の神田眞人総裁が、加盟国の支持を得て、全会一致で再任されたことを歓迎します。\n\n私も、片山財務大臣とともに、加盟国に対して、神田総裁への支持を呼び掛けてまいりましたが、今回の加盟国の支持に対し感謝の意を表します。\n\n神田総裁は、昨年2月の就任以来、重要鉱物に関する戦略策定や中東情勢への対応など、地域及び国際社会が直面する課題の解決に取り組まれてきました。\n今回の再選は、こうした実績が評価されたものと考えています。\n\n神田総裁のリーダーシップの下で、ADBが加盟国とともに、ますます複雑化する開発課題への対応や地域の持続可能な成長のために一層貢献されることを期待しています。"}}},"rest_id":"2094662562373939406","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"175200","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094662562373939406","sortIndex":"2094728807104643021"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/qiEoqwLQyLs","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2094521022359973888/lkKC7uOz?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":158,"url":"https://pbs.twimg.com/card_img/2094521022359973888/lkKC7uOz?format=jpg&name=280x280","width":280},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66781","type":"STRING"}},{"key":"description","value":{"string_value":"2026年09月01日開催、原子力規制庁定例ブリーフィングを公開いたします。■開催概要開催概要、議題、配布資料等は以下のリンクか...","type":"STRING"}},{"key":"player_width","value":{"string_value":"640","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"10228272","path":[]}}},{"key":"player_image_original","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2094521022359973888/lkKC7uOz?format=jpg&name=orig","width":1280},"type":"IMAGE"}},{"key":"app_num_ratings","value":{"string_value":"48,777,559","type":"STRING"}},{"key":"app_price_amount","value":{"string_value":"0.0","type":"STRING"