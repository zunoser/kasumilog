":[{"h":1214,"w":2167,"x":0,"y":0},{"h":1500,"w":1500,"x":667,"y":0},{"h":1500,"w":1316,"x":851,"y":0},{"h":1500,"w":750,"x":1417,"y":0},{"h":1500,"w":2167,"x":0,"y":0}],"height":1500,"width":2167},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/VTsBAIqOtA"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/VTsBAIqOtA","expanded_url":"https://x.com/takaichi_sanae/status/2094658620181086509/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2094649009415901184","indices":[129,152],"media_key":"3_2094649009415901184","media_results":{"result":{"media_key":"3_2094649009415901184"}},"media_url_https":"https://pbs.twimg.com/media/HRGwLRdb0AAgcYA.jpg","original_info":{"focus_rects":[{"h":1214,"w":2167,"x":0,"y":286},{"h":1500,"w":1500,"x":667,"y":0},{"h":1500,"w":1316,"x":851,"y":0},{"h":1500,"w":750,"x":1408,"y":0},{"h":1500,"w":2167,"x":0,"y":0}],"height":1500,"width":2167},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/VTsBAIqOtA"}]},"favorite_count":8058,"favorited":false,"full_text":"中東情勢を踏まえた「緊急的 激変緩和 措置」について、ガソリン価格を、引き続き、全国平均170円/ℓ程度に抑制していくこととし、本日、「中東情勢等対応予備費」を活用して、この対応などに必要な金額（6,160億円）を｢基金｣等に支出する旨を閣議決定しました。 https://t.co/VTsBAIqOtA","id_str":"2094658620181086509","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":186,"reply_count":561,"retweet_count":1104,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ2NTg2MjAxMDE0MzEyOTY=","richtext":{"richtext_tags":[]},"text":"中東情勢を踏まえた「緊急的 激変緩和 措置」について、ガソリン価格を、引き続き、全国平均170円/ℓ程度に抑制していくこととし、本日、「中東情勢等対応予備費」を活用して、この対応などに必要な金額（6,160億円）を｢基金｣等に支出する旨を閣議決定しました。\n\n国民の皆様が直面されている「物価高」への対応は、昨年　10月の高市内閣発足以来の最優先課題です。\n\nそうした中、今年2月末から中東情勢が不安定化し、原油価格が高騰したことから、3月19日から「緊急的 激変緩和 措置」による、ガソリン価格を全国平均で170円／ℓ程度に抑えるための補助を行ってきました。\n\n措置開始前の3月16日には、約190円/ℓでしたが、今も、この措置がなければ、最新の8月24日時点の調査では、約196円/ℓです。\n\n高市内閣の措置により、ガソリン価格は、最新の8月24日時点で169.9円/ℓと、日米欧の中で日本が一番安価な状況となっています。\n\nまた、軽油、重油、灯油にも同様の補助を行っており、こうした取組により、公共交通や農林水産業などを力強く支援してきました。\n\n他方で、中東情勢は依然として不透明であり、原油価格の見通しも困難であるため、「国民の皆様の命と暮らし」を守り、「経済活動」に支障を生じさせないよう、ガソリン価格を、引き続き、全国平均170円/ℓ程度に抑制していくこととし、今回の決定に至りました。\n\n今後とも、中東情勢が物価動向や経済に与える影響を注視し、タイミングを逸することなく、必要に応じ、「中東情勢等対応予備費」（2.5兆円）も活用して、国民の皆様の暮らしや経済活動に支障が出ないよう、対応してまいります。"}}},"rest_id":"2094658620181086509","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"270251","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094658620181086509","sortIndex":"2094728807104643018"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":1},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1369820966382039040/xn_dTvqx_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2931953732/1741141864"},"core":{"created_at":"Tue Dec 16 07:14:59 +0000 2014","name":"復興庁","screen_name":"Fukkocho_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":