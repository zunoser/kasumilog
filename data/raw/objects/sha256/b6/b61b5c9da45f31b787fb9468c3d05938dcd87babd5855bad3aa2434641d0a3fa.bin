result":{"media_key":"3_2094719116976467968"}},"media_url_https":"https://pbs.twimg.com/media/HRHv8EeaMAApP3J.png","original_info":{"focus_rects":[{"h":469,"w":838,"x":0,"y":105},{"h":574,"w":574,"x":0,"y":0},{"h":574,"w":504,"x":0,"y":0},{"h":574,"w":287,"x":45,"y":0},{"h":574,"w":838,"x":0,"y":0}],"height":574,"width":838},"sizes":{"large":{"h":574,"resize":"fit","w":838},"medium":{"h":574,"resize":"fit","w":838},"small":{"h":466,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/3DP0zkPWcL"}]},"favorite_count":11,"favorited":false,"full_text":"【脱炭素製品リスト掲載の募集開始】 https://t.co/3DP0zkPWcL","id_str":"2094719254562230521","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":1,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/ic/ch/pa…","expanded_url":"https://www.mofa.go.jp/mofaj/ic/ch/page23_003429.html","indices":[166,189],"url":"https://t.co/mA5O85iEfz"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ3MTkyNTQ0NDQ3NjkyODE=","richtext":{"richtext_tags":[]},"text":"【脱炭素製品リスト掲載の募集開始】\n脱炭素技術の海外展開を検討中ですか？「脱炭素技術海外展開イニシアティブ」は、NGO連携無償資金協力を活用して、日本企業の高度な脱炭素技術を途上国に提供するためのスキームです。本スキームを通じて、脱炭素製品を関連製品リストに掲載するための募集（令和8年度）を開始しました。奮ってご応募ください！\n\nhttps://t.co/mA5O85iEfz"}}},"rest_id":"2094719254562230521","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2463","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094719254562230521","sortIndex":"2094728807104643070"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename