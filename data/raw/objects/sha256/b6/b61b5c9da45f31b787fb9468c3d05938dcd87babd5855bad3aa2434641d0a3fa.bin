ies":{},"favorite_count":120,"favorited":false,"full_text":"9月1日、外務省は、総合外交政策局安全保障政策課にサイバー安全保障政策室を設置しました。サイバー安全保障政策室の設置を通じて、引き続き、自由、公正かつ安全なサイバー空間を実現するために、関係省庁及び幅広い民間関係者とも連携しながら、法の支配の推進、攻撃を抑止するための取組、同志国へ","id_str":"2094651877824794874","is_quote_status":false,"lang":"ja","quote_count":5,"reply_count":4,"retweet_count":54,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04112.html","indices":[195,218],"url":"https://t.co/13iFCNA6gA"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ2NTE4Nzc3MjQyMDkxNTI=","richtext":{"richtext_tags":[]},"text":"9月1日、外務省は、総合外交政策局安全保障政策課にサイバー安全保障政策室を設置しました。サイバー安全保障政策室の設置を通じて、引き続き、自由、公正かつ安全なサイバー空間を実現するために、関係省庁及び幅広い民間関係者とも連携しながら、法の支配の推進、攻撃を抑止するための取組、同志国への能力構築支援、関係国・機関とのサイバー協議など、サイバー分野における外交を積極的に進めていく考えです。\n\nhttps://t.co/13iFCNA6gA"}}},"rest_id":"2094651877824794874","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"9501","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094651877824794874","sortIndex":"2094728807104643010"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/fecUjBHHI0"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.co