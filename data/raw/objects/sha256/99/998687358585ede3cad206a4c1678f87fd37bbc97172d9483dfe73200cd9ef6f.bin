"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/c9tU8aET8g","video_info":{"aspect_ratio":[16,9],"duration_millis":89133,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122301571556118528/pl/1-zy3alzVJgNbK0p.m3u8?tag=29&v=515"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122301571556118528/vid/avc1/480x270/XgEH2Ur96FtsgNGI.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122301571556118528/vid/avc1/640x360/ykLUyYzWbiE0Unk_.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122301571556118528/vid/avc1/1280x720/gPjZEMgRx5FuYNhr.mp4?tag=29"}]}}]},"favorite_count":1956,"favorited":false,"full_text":"【お知らせ】\n本日１１月１６日（現地時間）、高市総理は、フィリピンのマルコス大統領と会談を行いました。\n\n※両首脳による冒頭発言要旨（速報版、仮訳）\n（マルコス大統領）\n　高市総理、フィリピンへようこそ。第４９回ＡＳＥＡＮ首脳会議への御参加を歓迎します。 https://t.co/c9tU8aET8g","id_str":"2122301892860706841","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":45,"reply_count":100,"retweet_count":308,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIzMDE4OTI3OTc4NTc3OTI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日１１月１６日（現地時間）、高市総理は、フィリピンのマルコス大統領と会談を行いました。\n\n※両首脳による冒頭発言要旨（速報版、仮訳）\n（マルコス大統領）\n　高市総理、フィリピンへようこそ。第４９回ＡＳＥＡＮ首脳会議への御参加を歓迎します。\n　我々の前回の会談の夕食会でのカラオケ・セッションを大変楽しい思い出として記憶しています。\n　また、我々の二国間関係を進めるために我々が成し遂げた非常に重要な全ての取組についてもです。\n\n（高市総理）\n　５月の国賓訪日、それから先月の電話会談に続いて、こうやってマニラでお会いできてとても嬉しいです。\n　ＡＳＥＡＮ議長国としてのマルコス大統領の大変な御尽力に敬意を表し、感謝をしております。\n　私達の「包括的・戦略的パートナーシップ」に基づいて、この後の会談で、二国間関係を一層力強いものにして参りましょう。"}}},"rest_id":"2122301892860706841","unmention_data":{},"views":{"count":"319071","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122301892860706841","sortIndex":"2122538597490884567"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1907032035689996327"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"p