06,"y":317}]},"orig":{"faces":[{"h":405,"w":405,"x":2889,"y":1125},{"h":389,"w":389,"x":1700,"y":1066}]},"small":{"faces":[{"h":68,"w":68,"x":487,"y":189},{"h":65,"w":65,"x":286,"y":179}]}},"id_str":"2122284216687968256","indices":[74,97],"media_key":"3_2122284216687968256","media_results":{"result":{"media_key":"3_2122284216687968256"}},"media_url_https":"https://pbs.twimg.com/media/HXPeQDAawAALYzk.jpg","original_info":{"focus_rects":[{"h":2257,"w":4031,"x":0,"y":181},{"h":3023,"w":3023,"x":403,"y":0},{"h":3023,"w":2652,"x":588,"y":0},{"h":3023,"w":1512,"x":1158,"y":0},{"h":3023,"w":4031,"x":0,"y":0}],"height":3023,"width":4031},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Tgw1dT2EO4"}]},"favorite_count":68,"favorited":false,"full_text":"三陸・常磐の水産物「#三陸・常磐もの」の魅力発信・消費拡大に向けて、「#三陸・常磐ウィークス」を11/1（日）～12/6（日）にかけて実施中です！ https://t.co/Tgw1dT2EO4","id_str":"2122284319133868392","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":2,"retweet_count":16,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[10,18],"text":"三陸・常磐もの"},{"indices":[35,46],"text":"三陸・常磐ウィークス"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/10/…","expanded_url":"https://www.meti.go.jp/press/2026/10/20261030004.html","indices":[181,204],"url":"https://t.co/Z4izwLVejz"},{"display_url":"sjm-network.jp","expanded_url":"https://sjm-network.jp/","indices":[232,255],"url":"https://t.co/j7n32Jbsao"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIyODQzMTkwNjY3ODc4NDA=","richtext":{"richtext_tags":[]},"text":"三陸・常磐の水産物「#三陸・常磐もの」の魅力発信・消費拡大に向けて、「#三陸・常磐ウィークス」を11/1（日）～12/6（日）にかけて実施中です！ 石井苗子政務官も本日の昼食で、岩手県産の天然真鯛を使った「鯛めし弁当」と、福島県産のあおさを使ったノングルテン米粉クッキーを美味しくいただきました。