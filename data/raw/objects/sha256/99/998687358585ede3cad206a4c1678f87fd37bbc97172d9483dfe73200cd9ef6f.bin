":"https://video.twimg.com/amplify_video/2122271057654747136/vid/avc1/1280x720/JCiGCaP39K7usyE6.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122271057654747136/vid/avc1/1920x1080/bQM07xYAsY-yZiY3.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/xsDxjE0P4x","expanded_url":"https://x.com/ModJapan_jp/status/2122271105356538325/video/1","ext_media_availability":{"status":"Available"},"id_str":"2122271057654747136","indices":[140,163],"media_key":"13_2122271057654747136","media_results":{"result":{"media_key":"13_2122271057654747136"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2122271057654747136/img/DE-VTRjEWFvkIgc4.jpg","original_info":{"focus_rects":[],"height":1080,"width":1920},"sizes":{"large":{"h":1080,"resize":"fit","w":1920},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/xsDxjE0P4x","video_info":{"aspect_ratio":[16,9],"duration_millis":37248,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122271057654747136/pl/9s9cZ-cU6sq_bxPN.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122271057654747136/vid/avc1/480x270/fcPqyPXQ-gzup0KK.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122271057654747136/vid/avc1/640x360/_ZlmrE6kbhiSLd8I.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122271057654747136/vid/avc1/1280x720/JCiGCaP39K7usyE6.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122271057654747136/vid/avc1/1920x1080/bQM07xYAsY-yZiY3.mp4?tag=29"}]}}]},"favorite_count":2243,"favorited":false,"full_text":"「隊舎で、ちゃんと休めているのかな。」\nそんなご家族の安心にもつながるよう、自衛隊では隊舎の個室化を進めています。\n例えば既存隊舎では、スピード感をもって個室化を進めるため、パーテーションなどを活用し、共同生活の中でも一人ひとりのプライバシーを確保できるように取り組んでいます。 https://t.co/xsDxjE0P4x","id_str":"2122271105356538325","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":47,"reply_count":61,"retweet_count":345,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[233,239],"text":"家族の週間"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIyNzExMDUyOTc4OTk1MjA=","text":"「隊舎で、ちゃんと休めているのかな。」\nそんなご家族の安心にもつながるよう、自衛隊では隊舎の個室化を進めています。\n例えば既存隊舎では、スピード感をもって個室化を進めるため、パーテーションなどを活用し、共同生活の中でも一人ひとりのプライバシーを確保できるように取り組んでいます。\nこれにより来年3月までに、個室化はおおむね9割となる見込みです。\nご家族の皆様。大切な隊員がちゃんと休める環境を、私たちはしっかり整えていきます。どうか、安心して見守っていてください。\n#家族の週間"}}},"rest_id":"2122271105356538325","unmention_data":{},"views":{"count":"130573","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122271105356538325","sortIndex":"2122538597490884554"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_v