:{"faces":[{"h":81,"w":81,"x":66,"y":136}]}},"id_str":"2122338645889970176","indices":[114,137],"media_key":"3_2122338645889970176","media_results":{"result":{"media_key":"3_2122338645889970176"}},"media_url_https":"https://pbs.twimg.com/media/HXQPwPla8AAk5Xl.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":3072,"w":3072,"x":0,"y":0},{"h":3072,"w":2695,"x":0,"y":0},{"h":3072,"w":1536,"x":153,"y":0},{"h":3072,"w":4096,"x":0,"y":0}],"height":3072,"width":4096},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OIkP4BXc2p"}]},"favorite_count":75,"favorited":false,"full_text":"赤澤大臣は、アジア開発銀行の神田総裁と会談。\n原子力協力に関する協力覚書に加え、ERIA（東アジア・アセアン経済研究センター）の渡辺総長ご同席の下、三者間のトランジション・ファイナンスに関する協力覚書の署名式も執り行いました。 https://t.co/OIkP4BXc2p","id_str":"2122338813397889253","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":3,"retweet_count":12,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[222,234],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIzMzg4MTMzNDMzMzQ0MDA=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、アジア開発銀行の神田総裁と会談。\n原子力協力に関する協力覚書に加え、ERIA（東アジア・アセアン経済研究センター）の渡辺総長ご同席の下、三者間のトランジション・ファイナンスに関する協力覚書の署名式も執り行いました。\nアジア各国がエネルギー安全保障を確保しつつ現実的なエネルギー移行を進めていく上で、アジア開発銀行の役割は非常に重要です。今後、同行との協力を深めていくべく、「パワー・アジア」における連携も含め様々な議論を行いました。#meti_daijin"}}},"rest_id":"2122338813397889253","unmention_data":{},"views":{"count":"8470","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122338813397889253","sortIndex":"2122538597490884578"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"Organi