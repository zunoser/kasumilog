QAE5ZgT.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1448,"w":1448,"x":146,"y":0},{"h":1448,"w":1270,"x":235,"y":0},{"h":1448,"w":724,"x":508,"y":0},{"h":1448,"w":2048,"x":0,"y":0}],"height":1448,"width":2048},"sizes":{"large":{"h":1448,"resize":"fit","w":2048},"medium":{"h":848,"resize":"fit","w":1200},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xprcsNBlei"}]},"favorite_count":3003,"favorited":false,"full_text":"令和８年１１月１７日（火）、①午前４時７分頃から同１０分頃にかけて、推定ロシア機１機が、②午前４時９分頃から同１２分頃にかけて、①とは別の推定ロシア機１機が、福岡県沖ノ島北西の領海上空を侵犯したことを確認した。 https://t.co/xprcsNBlei","id_str":"2122494592851517941","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":180,"reply_count":53,"retweet_count":1360,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI0OTQ1OTI4MDU0NzAyMDg=","text":"令和８年１１月１７日（火）、①午前４時７分頃から同１０分頃にかけて、推定ロシア機１機が、②午前４時９分頃から同１２分頃にかけて、①とは別の推定ロシア機１機が、福岡県沖ノ島北西の領海上空を侵犯したことを確認した。\nこれに対し、自衛隊は、航空自衛隊西部航空方面隊の戦闘機を緊急発進させて通告及び警告を行う等の対応を実施した。\nなお、当該推定ロシア機は、対馬海峡を通過後、与那国島と台湾との間を通過し、太平洋に至ったことを確認した。"}}},"rest_id":"2122494592851517941","unmention_data":{},"views":{"count":"200995","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122494592851517941","sortIndex":"2122538597490884585"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":