,"id_str":"2105861214442262528","indices":[130,153],"media_key":"13_2105861214442262528","media_results":{"result":{"media_key":"13_2105861214442262528"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2105861214442262528/img/1xooNnZUejfR9KpS.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/9BbaThQhIA","video_info":{"aspect_ratio":[16,9],"duration_millis":148033,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2105861214442262528/pl/xpX_Bk_B3mkrZPIJ.m3u8?tag=29&v=4c8"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105861214442262528/vid/avc1/480x270/pfexn2FbzoUYBEuJ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105861214442262528/vid/avc1/640x360/TagfHBkYekRlm-4B.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105861214442262528/vid/avc1/1280x720/wIUHspJQ_NfrYICG.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/9BbaThQhIA","expanded_url":"https://x.com/kantei/status/2105861329412338088/video/1","ext_media_availability":{"status":"Available"},"id_str":"2105861214442262528","indices":[130,153],"media_key":"13_2105861214442262528","media_results":{"result":{"media_key":"13_2105861214442262528"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2105861214442262528/img/1xooNnZUejfR9KpS.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/9BbaThQhIA","video_info":{"aspect_ratio":[16,9],"duration_millis":148033,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2105861214442262528/pl/xpX_Bk_B3mkrZPIJ.m3u8?tag=29&v=4c8"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105861214442262528/vid/avc1/480x270/pfexn2FbzoUYBEuJ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105861214442262528/vid/avc1/640x360/TagfHBkYekRlm-4B.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2105861214442262528/vid/avc1/1280x720/wIUHspJQ_NfrYICG.mp4?tag=29"}]}}]},"favorite_count":1577,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２日）、高市総理は、復興推進会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　「東日本大震災」及び「福島第一原子力発電所の事故」から１５年６か月が経過しました。\n　福島の本格的な復興・再生、東北の復興は、政府の最重要課題です。 https://t.co/9BbaThQhIA","id_str":"2105861329412338088","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":12,"reply_count":51,"retweet_count":216,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU4NjEzMjkzMzY5MDE2MzI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２日）、高市総理は、復興推進会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　「東日本大震災」及び「福島第一原子力発電所の事故」から１５年６か月が経過しました。\n　福島の本格的な復興・再生、東北の復興は、政府の最重要課題です。\n　被災地の方々の絶え間ない御努力により、復興は着実に進展しておりますが、一方で地域によって状況は様々です。\n　福島の「原子力災害被災地域」については、引き続き国が前面に立って、本格的な復興・再生に取り組んでいきます。\n　それぞれの地域の実情を踏まえながら、「避難者の帰還」や「生活環境の整備」、「産業なりわいの再生」などの取組を一層進めていきます。\n　除去土壌等の県外最終処分の実現に向けては、理解醸成を通じた「復興再生土」の利用を促進するため、全閣僚が全面的に協力するようお願いします。\n　また、福島県外最終処分に向けた２０３０年以降の道筋を具体化していきます。\n　「地震・津波被災地域」については、「ハード整備」などは概ね完了した一方で、「心のケア」などは、中長期的な対応が必要な課題です。丁寧に取り組んでまいりましょう。\n　今年度は「第３期復興・創生期間」の初年度として、非常に重要な時期です。\n　昨年６月に閣議決定された『復興の基本方針』に基づき、復興に向けた様々な課題について、まずは「第３期復興・創生期間」で、これまで以上に被災地の復興に全力で、またスピーディーに取り組んでまいります。\n　「福島の復興なくして、東北の復興なし。東北の復興なくして、日本の再生なし。」\n　全閣僚がこの強い決意の下、「現場主義」に徹底したきめ細かな対応により、被災地の復興のための取組を責任貫徹の思いで進めてください。\n　以上です。"}}},"rest_id":"2105861329412338088","unmention_data":{},"views":{"count":"52868","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105861329412338088","sortIndex":"2105940425968713663"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1674231387166220288/iK7GwtIr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/180585090/1680484704"},"core":{"created_at":"Fri Aug 20 00:19:17 +0000 2010","name":"厚生労働省","screen_name":"MHLWitter"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODA1ODUwOTA=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"厚生労働省の公式アカウントです。\n健康・医療、福祉・介護、雇用・労働、年金など、皆さまの暮らしを支える情報をお届けします。\n\n※このXに寄せられたコメントへの返信はしておりません。\n\n【運用方針】\nhttps://t.co/dQtOdVs4pp","entities":{"description":{"urls":[{"display_url":"mhlw.go.jp/content/102000…","expanded_url":"https://www.mhlw.go.jp/content/10200000/001350977.pdf","indices":[99,122],"url":"https://t.co/dQtOdVs4pp"}]},"url":{"urls":[{"display_url":"mhlw.go.jp","expanded_url":"ht