549431808","media_results":{"result":{"media_key":"3_2105885815549431808"}},"media_url_https":"https://pbs.twimg.com/media/HTmb_eVbkAAePT-.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1942,"w":1942,"x":524,"y":0},{"h":1942,"w":1704,"x":643,"y":0},{"h":1942,"w":971,"x":1010,"y":0},{"h":1942,"w":2600,"x":0,"y":0}],"height":1942,"width":2600},"sizes":{"large":{"h":1530,"resize":"fit","w":2048},"medium":{"h":896,"resize":"fit","w":1200},"small":{"h":508,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KhEhjQ16At"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/KhEhjQ16At","expanded_url":"https://x.com/takaichi_sanae/status/2105885846302044229/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":121,"w":121,"x":1109,"y":285},{"h":95,"w":95,"x":929,"y":481},{"h":133,"w":133,"x":699,"y":169}]},"medium":{"faces":[{"h":71,"w":71,"x":650,"y":167},{"h":55,"w":55,"x":544,"y":282},{"h":78,"w":78,"x":409,"y":99}]},"orig":{"faces":[{"h":154,"w":154,"x":1409,"y":363},{"h":121,"w":121,"x":1180,"y":611},{"h":170,"w":170,"x":888,"y":215}]},"small":{"faces":[{"h":40,"w":40,"x":368,"y":94},{"h":31,"w":31,"x":308,"y":159},{"h":44,"w":44,"x":232,"y":56}]}},"id_str":"2105885815549431808","indices":[145,168],"media_key":"3_2105885815549431808","media_results":{"result":{"media_key":"3_2105885815549431808"}},"media_url_https":"https://pbs.twimg.com/media/HTmb_eVbkAAePT-.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1942,"w":1942,"x":524,"y":0},{"h":1942,"w":1704,"x":643,"y":0},{"h":1942,"w":971,"x":1010,"y":0},{"h":1942,"w":2600,"x":0,"y":0}],"height":1942,"width":2600},"sizes":{"large":{"h":1530,"resize":"fit","w":2048},"medium":{"h":896,"resize":"fit","w":1200},"small":{"h":508,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KhEhjQ16At"}]},"favorite_count":5960,"favorited":false,"full_text":"本日午前、訪日中のムハンマド・カタール首相が官邸にお越し下さり、会談を行いました。\n\n私からは、まず、ムハンマド首相が愛知県名古屋市を中心に開催中の第20回アジア競技大会閉会式の機会に訪日されたことを歓迎し、2030年の次回ドーハ大会の成功に向けて共に協力していきたい旨を申し上げました。 https://t.co/KhEhjQ16At","id_str":"2105885846302044229","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":31,"reply_count":244,"retweet_count":568,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU4ODU4NDYyNDMzMDc1MjA=","richtext":{"richtext_tags":[]},"text":"本日午前、訪日中のムハンマド・カタール首相が官邸にお越し下さり、会談を行いました。\n\n私からは、まず、ムハンマド首相が愛知県名古屋市を中心に開催中の第20回アジア競技大会閉会式の機会に訪日されたことを歓迎し、2030年の次回ドーハ大会の成功に向けて共に協力していきたい旨を申し上げました。\n\n続けて、私から、イランをめぐる軍事的緊張が継続し、法の支配に基づく海洋秩序が大きく揺らいでいることに対する強い懸念を表明するとともに、カタールが仲介国として重要な役割を果たしていることに対する深い敬意をお伝えし、事態の早期沈静化に向けて、カタールと緊密に連携していきたい旨を申し上げました。\n\nまた、日本は現在、カタールを含む湾岸諸国の経済・エネルギー強靱化に向け、包括的な協力計画をまとめていることも紹介しました。\n\nムハンマド首相からは、第20回アジア競技大会の成功に対する祝意とともに、次回ドーハ大会に向けた協力に対する期待が表明されました。\n\nまた、カタールとして、日本との経済パートナーシップを重視しており、伝統的なエネルギー分野での協力に加え、投資やAIを含む様々な分野で協力を強化していきたいとの御発言がありました。\n\nイランをめぐる情勢に関しては、ムハンマド首相から、米・イラン間の協議の現状について説明があり、事態の早期沈静化及び航行の自由の回復に向け、日本と緊密に連携していきたい旨を伺いました。\n\nさらに、湾岸諸国の経済・エネルギー強靱化に向けた日本の貢献に対する謝意と、湾岸地域の安定と発展に対し、日本がこれからも積極的な役割を果たすことへの期待を表明いただきました。\n\nこれからも両国の「戦略的パートナーシップ」の強化に向けて、カタールと緊密に連携してまいります。"}}},"rest_id":"2105885846302044229","unmention_data":{},"views":{"count":"161099","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105885846302044229","sortIndex":"2105940425968713676"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result