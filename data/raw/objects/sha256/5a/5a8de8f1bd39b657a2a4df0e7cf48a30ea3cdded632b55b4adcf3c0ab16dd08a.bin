,"x":33,"y":453}]},"medium":{"faces":[{"h":59,"w":59,"x":19,"y":265}]},"orig":{"faces":[{"h":129,"w":129,"x":43,"y":576}]},"small":{"faces":[{"h":33,"w":33,"x":11,"y":150}]}},"id_str":"2105615300981129216","indices":[99,122],"media_key":"3_2105615300981129216","media_results":{"result":{"media_key":"3_2105615300981129216"}},"media_url_https":"https://pbs.twimg.com/media/HTil9dCbgAAY_na.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/laJfMNan8w"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/laJfMNan8w","expanded_url":"https://x.com/takaichi_sanae/status/2105615343150670256/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2105615312666480640","indices":[99,122],"media_key":"3_2105615312666480640","media_results":{"result":{"media_key":"3_2105615312666480640"}},"media_url_https":"https://pbs.twimg.com/media/HTil-Ikb0AADE9f.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1865,"w":1865,"x":689,"y":0},{"h":1865,"w":1636,"x":803,"y":0},{"h":1865,"w":933,"x":1155,"y":0},{"h":1865,"w":2600,"x":0,"y":0}],"height":1865,"width":2600},"sizes":{"large":{"h":1469,"resize":"fit","w":2048},"medium":{"h":861,"resize":"fit","w":1200},"small":{"h":488,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/laJfMNan8w"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/laJfMNan8w","expanded_url":"https://x.com/takaichi_sanae/status/2105615343150670256/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":101,"w":101,"x":33,"y":453}]},"medium":{"faces":[{"h":59,"w":59,"x":19,"y":265}]},"orig":{"faces":[{"h":129,"w":129,"x":43,"y":576}]},"small":{"faces":[{"h":33,"w":33,"x":11,"y":150}]}},"id_str":"2105615300981129216","indices":[99,122],"media_key":"3_2105615300981129216","media_results":{"result":{"media_key":"3_2105615300981129216"}},"media_url_https":"https://pbs.twimg.com/media/HTil9dCbgAAY_na.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/laJfMNan8w"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/laJfMNan8w","expanded_url":"https://x.com/takaichi_sanae/status/2105615343150670256/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2105615312666480640","indices":[99,122],"media_key":"3_2105615312666480640","media_results":{"result":{"media_key":"3_2105615312666480640"}},"media_url_https":"https://pbs.twimg.com/media/HTil-Ikb0AADE9f.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1865,"w":1865,"x":689,"y":0},{"h":1865,"w":1636,"x":803,"y":0},{"h":1865,"w":933,"x":1155,"y":0},{"h":1865,"w":2600,"x":0,"y":0}],"height":1865,"width":2600},"sizes":{"large":{"h":1469,"resize":"fit","w":2048},"medium":{"h":861,"resize":"fit","w":1200},"small":{"h":488,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/laJfMNan8w"}]},"favorite_count":11763,"favorited":false,"full_text":"本日の夕方、「日本成長戦略会議」を開催しました。\n\n日本経済は、これまでの経済政策や企業の賃上げの努力が実を結びつつあり、高い水準の賃上げ、民間設備投資の堅調な増加など、変化の兆しが見えています。 https://t.co/laJfMNan8w","id_str":"2105615343150670256","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":232,"reply_count":1245,"retweet_count":1345,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU2MTUzNDMwNjY2ODEzNDQ=","richtext":{"richtext_tags":[]},"text":"本日の夕方、「日本成長戦略会議」を開催しました。\n\n日本経済は、これまでの経済政策や企業の賃上げの努力が実を結びつつあり、高い水準の賃上げ、民間設備投資の堅調な増加など、変化の兆しが見えています。\n\nこの変化の兆しを一時的なものとせず、「企業が投資する」、「賃金が上がる」、「消費が伸びる」という、持続的な「成長の好循環」に発展させることができるのか、「分岐点」に立っています。\n\n世界各国が、国を挙げて、長期的かつ大規模に、産業政策を競い合っている中、今こそ、「責任ある積極財政」により、国内投資を引き出し、「潜在成長率」を引き上げていくことが必要です。\n\n年末までに策定する『日本成長戦略実行計画』においては、今後5年間の「国内投資」の道筋とともに、複数年度で、達成すべき目標、必要な予算額、期待する効果や、支援対象企業の投資・販売・技術開発などに基づく「勝ち筋」を切り拓いていく方策についても明らかにしていきます。\n\n「足元の収益源」「今後の稼ぎ頭」「経済安全保障の強化」など類型ごとに、持続的な「成長の好循環」実現のため、「集中投資期間」に特に注力すべき「重要項目」を明確化していきます。\n\n複数年度で十分な財源を確保することで、複数年度にわたる大規模かつ計画的な公的支援にコミットし、投資の予見可能性を高めるため、別枠管理される特別会計を設置します。\n\n成長投資・危機管理投資を加速するため、必要な人手や資金、電力、AI、経営資源などの「戦略分野への円滑な供給」を促進する必要があります。\nまず、建設分野の人手不足解消に向け、「政府横断の検討の場」を創設し、年末までに具体的な政策パッケージをとりまとめていきます。\nまた、資金や電力の確保についても、検討を加速していきます。\n\n高性能AIの社会実装は、我が国の成長戦略実現に不可欠です。\n年末までに、\n①信頼できるAIで社会全体を駆動するAXの具体像、\n②AXに対応した規制・制度改革を進めるための原則、\n③社会実装を加速するためのアクションプラン、\nをまとめていきます。\n\n経営資源を成長領域にシフトする事業ポートフォリオ転換促進のための施策の検討も進めていきます。\n\nまた、『実行計画』策定にあたっては、戦略17分野、8つの横断的課題、それぞれの重点課題に取り組むための責任体制を明確化していきます。\n\n高市内閣は、「国内投資」を引き出し、日本の「潜在成長率」を引上げ、物価高に負けない賃上げを実現します。\nしかし、実質賃金の継続的上昇が定着するまでには一定の時間がかかります。\n『消費税・支援金法案』を含め、物価高対策を、これからも切れ目なく着実に実施していきます。\n\n「GDP拡大の下での好循環」を実現し、国民の皆様の不安を、未来への希望に変えるため、政府の総力をあげて取り組んでまいります。"}}},"rest_id":"2105615343150670256","unmention_data":{},"views":{"count":"374291","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105615343150670256","sortIndex":"210594042