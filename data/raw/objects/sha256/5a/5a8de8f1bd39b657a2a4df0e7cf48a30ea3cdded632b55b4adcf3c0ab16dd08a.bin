、ビデオ・メッセージを発出しました。茂木大臣は、FPCJが1976年の設立以来、外国報道機関による取材活動を支え、幅広く日本の姿を世界へ伝える上で重要な役割を果 https://t.co/zXBFRRohRQ","id_str":"2105621349343678517","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":15,"retweet_count":42,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04238.html","indices":[190,213],"url":"https://t.co/9jE7fUqbbj"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU2MjEzNDkyMzQ1OTc4ODg=","richtext":{"richtext_tags":[]},"text":"茂木外務大臣は、公益財団法人フォーリン・プレスセンター（FPCJ）創立50周年記念事業である2026年国際ジャーナリスト会議の冒頭において、ビデオ・メッセージを発出しました。茂木大臣は、FPCJが1976年の設立以来、外国報道機関による取材活動を支え、幅広く日本の姿を世界へ伝える上で重要な役割を果たしてきた旨述べ、長年にわたる関係者の尽力に対し深く敬意を表する旨述べました。\n\nhttps://t.co/9jE7fUqbbj"}}},"rest_id":"2105621349343678517","unmention_data":{},"views":{"count":"16416","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105621349343678517","sortIndex":"2105940425968713638"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":fa