bv3PW"}]},"url":{"urls":[{"display_url":"yoshimoto.co.jp","expanded_url":"http://www.yoshimoto.co.jp/","indices":[0,23],"url":"https://t.co/XHE847KUpO"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":65739,"following":112},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"277344026","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6279,"tweets":53714},"verification":{"verified":false},"website":{"url":"https://t.co/XHE847KUpO"}}}},"edit_control":{"edit_tweet_ids":["2105583504126062810"],"editable_until_msecs":"1790848801000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2105583504126062810","created_at":"Thu Oct 01 09:00:01 +0000 2026","display_text_range":[0,127],"entities":{},"favorite_count":13,"favorited":false,"full_text":"＼10月の放送テーマ解禁／\n\n今田耕司・森香澄さんがナビゲートする『ニッポン 今だ！ラボ』！\n\n10月は世界に誇る日本のモノづくりを支える「高機能素材」から、日本の未来を救う「創薬」の最前線まで、注目のトピックが目白押しです！\n\n【10月のラインナップ】","id_str":"2105583504126062810","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":4,"retweeted":false,"user_id_str":"277344026"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[614,623],"text":"ニッポン今だラボ"},{"indices":[624,629],"text":"今田耕司"},{"indices":[630,634],"text":"森香澄"},{"indices":[635,648],"text":"しゅんしゅんクリニックP"},{"indices":[649,654],"text":"吉本興業"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"fujitv.co.jp/nippon_imada_l…","expanded_url":"https://www.fujitv.co.jp/nippon_imada_labo","indices":[589,612],"url":"https://t.co/wEbj3hBj8q"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU1ODM1MDQwMjUzNTAxNDQ=","text":"＼10月の放送テーマ解禁／\n\n今田耕司・森香澄さんがナビゲートする『ニッポン 今だ！ラボ』！\n\n10月は世界に誇る日本のモノづくりを支える「高機能素材」から、日本の未来を救う「創薬」の最前線まで、注目のトピックが目白押しです！\n\n【10月のラインナップ】 \n・10月7日：世界をリードする“高機能素材”\n・10月14日：ニッポンの創薬 \n・10月21日：創薬エコシステム \n・10月28日：創薬の最前線 湘南アイパーク\n\n「世界をリードする“高機能素材”」編では、日本の高機能素材に注目！\n産業技術総合研究所（産総研）における、AI活用により素材開発の時間を22分の1に縮小した成果の紹介や、\n開発スピードを10倍に加速させる政府の取り組みを解説します。\n\n「ニッポンの創薬」シリーズでは、ゼロから全く新しい薬を創り出す「創薬」の日本の挑戦と最前線に迫ります！\n年売上約11.6兆円を誇る日本の第3位の基幹産業としてのポテンシャルや、新薬開発の8割をスタートアップが担う中、官民ワンチームで支援する「創薬エコシステム」の取り組みを紹介。\nさらに第31回では現役医師芸人・しゅんしゅんクリニックPが、約230の企業・団体が集結する「湘南アイパーク」を現地取材し、組織の垣根を超えた革新的な新薬開発の現場をリポートします！\n\n知るのは、今だ！\n\n📺フジテレビほかにて放送 公式HP：https://t.co/wEbj3hBj8q\n\n#ニッポン今だラボ #今田耕司 #森香澄 #しゅんしゅんクリニックP #吉本興業"}}},"rest_id":"2105583504126062810","unmention_data":{},"views":{"count":"4993","state":"EnabledWithCount"}}},"user_id_str":"461064204"},"rest_id":"2105875143054725610","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"770","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105875143054725610","sortIndex":"2105940425968713666"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":8},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_p