mg.com/media/HVoAPcfaEAAg9YI.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":682,"y":0},{"h":1366,"w":1198,"x":850,"y":0},{"h":1366,"w":683,"x":1348,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/FKLqCFJZwu"}]},"favorite_count":157,"favorited":false,"full_text":"10月27日、こやり防衛副大臣は、韓国軍の退役軍人で構成される星友会のパク・インヨン会長一行の表敬を受けました。こやり防衛副大臣は星友会と安全保障懇話会との長年にわたる交流を歓迎するとともに、日本と韓国の防衛協力の更なる進展に向け、引き続き交流が深まることへの期待を述べました。 https://t.co/FKLqCFJZwu","id_str":"2115003265834430898","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":1,"retweet_count":16,"retweeted":false,"user_id_str":"268732024"},"rest_id":"2115003265834430898","unmention_data":{},"views":{"count":"12515","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115003265834430898","sortIndex":"2115029469331718118"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/281874178/1611288198"},"core":{"created_at":"Thu Apr 14 04:13:40 +0000 2011","name":"特許庁","screen_name":"jpo_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_