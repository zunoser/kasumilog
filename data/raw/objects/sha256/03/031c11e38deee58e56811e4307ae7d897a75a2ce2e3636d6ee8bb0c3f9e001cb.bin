49403130071/video/1","ext_media_availability":{"status":"Available"},"id_str":"2114979642558054400","indices":[140,163],"media_key":"13_2114979642558054400","media_results":{"result":{"media_key":"13_2114979642558054400"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2114979642558054400/img/rFhInIHnhI0WqjDm.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/Hx9vXWHGrT","video_info":{"aspect_ratio":[16,9],"duration_millis":197433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2114979642558054400/pl/OjnI7nxm5x98xPMK.m3u8?tag=29&v=c57"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114979642558054400/vid/avc1/480x270/Y8TAkjnnuDDlZbnv.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114979642558054400/vid/avc1/640x360/dI4Jk9MfVI-I1jNJ.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114979642558054400/vid/avc1/1280x720/v7YUfYNH2Z6_CRVT.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/Hx9vXWHGrT","expanded_url":"https://x.com/kantei/status/2114981049403130071/video/1","ext_media_availability":{"status":"Available"},"id_str":"2114979642558054400","indices":[140,163],"media_key":"13_2114979642558054400","media_results":{"result":{"media_key":"13_2114979642558054400"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2114979642558054400/img/rFhInIHnhI0WqjDm.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/Hx9vXWHGrT","video_info":{"aspect_ratio":[16,9],"duration_millis":197433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2114979642558054400/pl/OjnI7nxm5x98xPMK.m3u8?tag=29&v=c57"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114979642558054400/vid/avc1/480x270/Y8TAkjnnuDDlZbnv.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114979642558054400/vid/avc1/640x360/dI4Jk9MfVI-I1jNJ.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114979642558054400/vid/avc1/1280x720/v7YUfYNH2Z6_CRVT.mp4?tag=29"}]}}]},"favorite_count":732,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２７日）、高市総理は、商工会青年部・女性部全国組織化６０周年記念大会に出席しました。\n\n※高市総理挨拶要旨(速報版)\n　皆様、おはようございます。内閣総理大臣の高市早苗です。\n　「商工会青年部・女性部」の全国組織化６０周年、心よりお慶びを申し上げます。 https://t.co/Hx9vXWHGrT","id_str":"2114981049403130071","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":45,"retweet_count":104,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ5ODEwNDkzMTUwODYzMzY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２７日）、高市総理は、商工会青年部・女性部全国組織化６０周年記念大会に出席しました。\n\n※高市総理挨拶要旨(速報版)\n　皆様、おはようございます。内閣総理大臣の高市早苗です。\n　「商工会青年部・女性部」の全国組織化６０周年、心よりお慶びを申し上げます。\n　商工会の「青年部」と「女性部」は、地域の若手経営者や女性経営者の皆様の「扶け合い・学び合いの場」であり、地域経済の発展に大きく貢献してこられました。\n　また、度重なる自然災害に際しては、災害からの復旧・復興にも重要な役割を果たしてこられました。\n　皆様の長年のご尽力に、心より敬意を表します。\n　今、世界各国は国を挙げて長期的かつ大規模な産業政策を競い合っている中で、日本だけが足踏みをしていては、企業も雇用も投資も海外に流れてしまって、国内は再び停滞の時代に逆戻りしかねません。\n　高市内閣は、「責任ある積極財政」により、国内投資を引き出し、潜在成長率を引き上げ、\n・「良質な雇用と所得」を増やし、\n・「消費マインド」を改善し、\n・「事業収益」が上がり、\nそして、\n・「税収」は自然増に向かっていく、\n「GDP拡大の下での好循環」を実現いたします。\n　また、高市内閣は、『地域未来戦略』に基づきまして、地域の特色ある強みを活かした「産業クラスターの形成」を応援し、日本列島の隅々まで、「産業クラスターの花」を咲かせてまいります。\n　皆様には共に頑張っていただけることを嬉しく思います。\n　特に、地域資源を活用する「地場産業成長プラン」というのもあります。これは皆様のアイディアを市町村長さんに伝えていただいたら、自治体が、基礎自治体が中心になってまたクラスターを作っていこう、こういう取組です。\n　地域で「新たな価値」を生み出していくのは、地域の事業者の皆様です。\n　「青年部」「女性部」の皆様が「挑戦」を続け、地域経済の発展を力強く推進する御取組を私たちも応援してまいります。\n　本日お集まりの皆様の益々の御活躍と、そして「青年部」「女性部」の更なる御発展をお祈り申し上げます。\n　今日は、誠におめでとうございます。"}}},"rest_id":"2114981049403130071","unmention_data":{},"views":{"count":"28376","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114981049403130071","sortIndex":"2115029469331718103"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2114627435178434611"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"descr