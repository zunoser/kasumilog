-LT4SgLtVb.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115004745228374016/vid/avc1/1280x720/ZJdSK9-Yro2PhPgW.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/VDPUuXDFZ9","expanded_url":"https://x.com/kantei/status/2115005039945331054/video/1","ext_media_availability":{"status":"Available"},"id_str":"2115004745228374016","indices":[129,152],"media_key":"13_2115004745228374016","media_results":{"result":{"media_key":"13_2115004745228374016"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2115004745228374016/img/DWeiXECOTPHuTfYG.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/VDPUuXDFZ9","video_info":{"aspect_ratio":[16,9],"duration_millis":417166,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2115004745228374016/pl/w6bOTox_gRVZ4P69.m3u8?tag=29&v=df3"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115004745228374016/vid/avc1/480x270/aSMyv4zCQgUNYUjs.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115004745228374016/vid/avc1/640x360/hHGpgQ-LT4SgLtVb.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115004745228374016/vid/avc1/1280x720/ZJdSK9-Yro2PhPgW.mp4?tag=29"}]}}]},"favorite_count":456,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２７日）、高市総理とバングラデシュのタレク・ラーマン首相は、日・バングラデシュ共同記者発表を行いました\n\n※両首脳の発言(速報版、仮訳)\n（高市総理）\n　本日、バングラデシュのタレク・ラーマン首相をお迎えし、首脳会談を行いました。 https://t.co/VDPUuXDFZ9","id_str":"2115005039945331054","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":16,"reply_count":106,"retweet_count":69,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTUwMDUwMzk4MDI3NDQ4MzI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２７日）、高市総理とバングラデシュのタレク・ラーマン首相は、日・バングラデシュ共同記者発表を行いました\n\n※両首脳の発言(速報版、仮訳)\n（高市総理）\n　本日、バングラデシュのタレク・ラーマン首相をお迎えし、首脳会談を行いました。\n　国際情勢が益々不安定化する中、日本とバングラデシュが共に自律性と強靱性を強化することで、地域の平和と安定に貢献し、繁栄を分かち合うことが重要です。\n　日本は、民主的な総選挙を経て発足したラーマン政権による国づくりを、力強く後押ししてまいります。\n　本日は、こうした観点から、民主主義や法の支配といった価値を共有する、バングラデシュと日本の協力について、ラーマン首相と議論をいたしました。\n　バングラデシュと日本は、進化したＦＯＩＰの実現に向けた重要なパートナーです。\n　ラーマン首相は、ベンガル湾地域の発展をリードしておられます、日本は、ベンガル湾地域のサプライチェーン・連結性の強化や、貿易・投資の促進に取り組んでいます。\n　今回、両国協力の基軸であります『ベンガル湾産業成長地帯』構想、いわゆる『ＢＩＧ－Ｂ』を進化させ、ラーマン首相との新たな戦略的協力イニシアチブ、『繁栄を分かち合うＢＩＧ－Ｂ』として、推進していくことを確認しました。\n　新たな４つの柱、\n・連結性の強化、\n・災害・地政学リスクへの備え、\n・官民による経済成長機会の創出とルール整備、\n・平和と安定のための協力、\nに基づき、両国が協力して、共に繁栄していくことを目指します。\n　また、今後５年間で、日本企業による約１兆円の民間投資が見込まれます。\n　東南アジアと南アジアを結ぶバングラデシュの大きな潜在性は、日本の経済にとっても極めて重要です。\n　両国で連携し、ＥＰＡの早期発効をはじめとする投資環境整備や、近い将来のビジネスミッション派遣を通じ、経済関係を更に促進してまいります。\n　また、安全保障面でも、海上保安能力強化のため、ＯＤＡによる巡視船供与を新たに決定いたしました。\n　ＯＳＡ（政府安全保障能力強化支援）や防衛協力を継続し、地域の平和と安定にも取り組んでまいります。\n　日本・バングラデシュの未来志向の『戦略的パートナーシップ』の下、共に、強く、豊かに。\n　「共に繁栄する未来のための日本・バングラデシュ関係の新時代」を、ラーマン首相と導いてまいります。私からは以上です。ありがとうございます。\n\n（ラーマン首相）　※日本語仮訳\n　お集まりのメディアの皆様、こんにちは（日本語で）。\n　高市早苗日本国内閣総理大臣のお招きにより、日本への公式訪問として、バングラデシュの代表団を率いて参りました。バングラデシュ国民を代表して、温かな歓迎とおもてなしに対し、高市総理及び日本国民に心から御礼申し上げます。\n　日本は、バングラデシュ国民の心に特別な場所を占めています。我々の友情は、相互尊敬、信頼、また、平和、繁栄、安定という共通のビジョンに根ざしています。平和国家である日本は、１９７１年のバングラデシュの独立に続き、いち早く国家承認してくれた国の一つです。５０年以上にわたり、日本は、バングラデシュの社会経済的進展及びインフラ開発に多大な貢献を果たし、バングラデシュにとって最も大切な開発パートナーであり続けています。我々は、この長きにわたる友好関係に深く感謝しています。 \n　本日の高市総理との首脳会談では、二国間関係、地域及び国際情勢の幅広い分野において、有意義な意見交換ができました。長年にわたる友好関係を再確認するとともに、エネルギー、ＩＣＴ、鉄道、インフラ、深海港及び外国直接投資における協力の強化を通じ、両国のパートナーシップを更に深めていくという共通の決意を表明しました。 \n　今般の訪日で、両国関係を深化させる具体的な取組を行い、主要な分野における複数の覚書（ＭＯＵ）を交換しました。共同声明では、首脳会談を通じた成果と共通の優先事項が示される予定です。 \n　バングラデシュと日本のパートナーシップは、何十年にも及ぶ友情、信頼、相互尊重を基礎として築かれていきました。\n　本日、我々は、両国の関係を新たな高みに引き上げる機会を得ました。\n　日本の投資家、企業、金融機関の皆様におかれては、バングラデシュが提供するビジネスチャンスを追求し、バングラデシュの次の成長段階に是非参加していただきたい。我々は、日本のパートナーと協力し、生産的な投資、技術移転、熟練人材の雇用、互恵的な事業展開を通じて、その潜在力を引き出していきます。我々が力を合わせれば、両国のために、更に強靭で繁栄に満ちた未来を築くことができるでしょう。我々の目標は明確です。両国間のこの友好関係を経済チャンスと繁栄を分かち合う強力な原動力に変えていくことです。\n　今日の国民に恩恵をもたらすパートナーシップを築き、次世代へと受け継がれる永続的な遺産を、共に創り上げましょう。ありがとう（日本語で）。"}}},"rest_id":"2115005039945331054","unmention_data":{},"views":{"count":"23575","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115005039945331054","sortIndex":"2115029469331718119"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2114552601970909634"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸