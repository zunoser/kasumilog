itive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":2,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTUwMTM3NDkyMjg4NjM0ODg=","richtext":{"richtext_tags":[]},"text":"若山政務官は、「商工会青年部・女性部全国組織化60周年記念大会」に出席。挨拶では、60年にわたり地域経済の活性化やまちづくりに取り組んできた青年部・女性部の皆様の歩みに敬意を表するとともに、人手不足等の課題を乗り越える上で、地域の事業者を巻き込み、変えていく青年部・女性部の力に期待を寄せました。"}}},"rest_id":"2115013749279248635","unmention_data":{},"views":{"count":"2203","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115013749279248635","sortIndex":"2115029469331718137"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2115001960202207232/aCieroeS?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2115001960202207232/aCieroeS?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"官房長官の定例記者会見の様子などをご覧になれます。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.kantei.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2115001960202207232/aCieroeS?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2115001960202207232/aCieroeS?format=jpg&name=38