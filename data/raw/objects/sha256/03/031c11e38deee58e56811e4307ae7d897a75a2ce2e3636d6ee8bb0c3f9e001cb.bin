text_range":[0,117],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/Htr7slsRdw","expanded_url":"https://x.com/kantei/status/2115002262296932850/video/1","ext_media_availability":{"status":"Available"},"id_str":"2115002157896470528","indices":[118,141],"media_key":"13_2115002157896470528","media_results":{"result":{"media_key":"13_2115002157896470528"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2115002157896470528/img/QRkGJMI0fmCaeT4l.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/Htr7slsRdw","video_info":{"aspect_ratio":[16,9],"duration_millis":176800,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2115002157896470528/pl/AufeX5uMKIcaVGA5.m3u8?tag=29&v=512"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115002157896470528/vid/avc1/480x270/PkaZZV2mSpnOT-Th.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115002157896470528/vid/avc1/640x360/KrjXngzk84w9e32Z.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115002157896470528/vid/avc1/1280x720/ALOf8rIaESFK42YB.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/Htr7slsRdw","expanded_url":"https://x.com/kantei/status/2115002262296932850/video/1","ext_media_availability":{"status":"Available"},"id_str":"2115002157896470528","indices":[118,141],"media_key":"13_2115002157896470528","media_results":{"result":{"media_key":"13_2115002157896470528"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2115002157896470528/img/QRkGJMI0fmCaeT4l.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/Htr7slsRdw","video_info":{"aspect_ratio":[16,9],"duration_millis":176800,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2115002157896470528/pl/AufeX5uMKIcaVGA5.m3u8?tag=29&v=512"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115002157896470528/vid/avc1/480x270/PkaZZV2mSpnOT-Th.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115002157896470528/vid/avc1/640x360/KrjXngzk84w9e32Z.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115002157896470528/vid/avc1/1280x720/ALOf8rIaESFK42YB.mp4?tag=29"}]}}]},"favorite_count":291,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２７日）、高市総理は、訪日中のラーマン・バングラデシュ首相と、日・バングラデシュ首脳会談を行いました。\n\n※両首脳による冒頭発言(速報版、仮訳) \n（高市総理）\n　ラーマン首相始め皆様の訪日を歓迎いたします。 https://t.co/Htr7slsRdw","id_str":"2115002262296932850","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"reply_count":33,"retweet_count":47,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTUwMDIyNjIyMTcyNDA1NzY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２７日）、高市総理は、訪日中のラーマン・バングラデシュ首相と、日・バングラデシュ首脳会談を行いました。\n\n※両首脳による冒頭発言(速報版、仮訳) \n（高市総理）\n　ラーマン首相始め皆様の訪日を歓迎いたします。\n　民主主義の価値を共有する友人として、本年の首相就任を改めてお祝い申し上げます。\n　１９７１年のバングラデシュの独立以来、日本は一貫して、国づくりを支援してまいりました。\n　両国は、『自由で開かれたインド太平洋（ＦＯＩＰ）』の実現に向けた重要なパートナーです。\n　国際情勢が不安定化する中、日本は、『進化したＦＯＩＰ』の下、バングラデシュの自律性と強靱性を力強く支えてまいります。\n　ラーマン首相と共に、両国の『戦略的パートナーシップ』を更に発展させ、地域の平和と繁栄に貢献できることを楽しみにしています。冒頭ご挨拶までです。ありがとうございます。\n\n（ラーマン首相）※日本語仮訳\n　首相閣下、こんにちは（日本語で）。貴首相からの温かい歓迎と私の首相就任に対する温かいお言葉に感謝申し上げます。私からも、貴首相の就任にもお祝い申し上げます。\n　まず、福田康夫元首相の御逝去の報に接し、心からのお悔やみを申し上げます。福田元首相の日本に対して献身的に尽くされた功績及び国際社会への貢献は、深い敬意をもって記憶されることでしょう。\n　バングラデシュ国民の心において、日本は特別な存在です。平和国家である日本は、１９７１年のバングラデシュの独立をいち早く承認した国の一つでした。それ以来、日本はバングラデシュにとって最も重要な二国間開発パートナーの一つであり続けています。\n　私達は、日本の長年にわたる友情と支援に心から感謝しています。私達の友情は、相互尊重、信頼、また、平和、繁栄、安定という共通のビジョンに根ざしています。\n　私の父の故ジアウル・ラーマン元大統領は、１９７８年及び１９８０年に日本を訪れ、母の故カレダ・ジア元首相は、日本との関係を築き強化するために力を注ぎました。亡き両親の足跡と志に続き、バングラデシュと日本の関係を新たな高みへと引き上げるというこのコミットメントを果たすことを謙虚に受け止め、光栄に感じています。"}}},"rest_id":"2115002262296932850","unmention_data":{},"views":{"count":"21230","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115002262296932850","sortIndex":"2115029469331718116"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2115001342666371072/pWYEuJ4G?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.6649","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2115001342666371072/pWYEuJ4G?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"英語版（English）https://youtu.be/r__4UaUSAEE＝＝＝＝＝＝＝茂木敏充外務大臣会見記録（要旨）《...","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":32