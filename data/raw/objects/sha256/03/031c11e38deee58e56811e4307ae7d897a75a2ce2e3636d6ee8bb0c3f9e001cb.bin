,"w":146,"x":698,"y":186}]},"orig":{"faces":[{"h":260,"w":260,"x":634,"y":418},{"h":250,"w":250,"x":1192,"y":318}]},"small":{"faces":[{"h":86,"w":86,"x":210,"y":138},{"h":83,"w":83,"x":395,"y":105}]}},"id_str":"2115003240345698304","indices":[140,163],"media_key":"3_2115003240345698304","media_results":{"result":{"media_key":"3_2115003240345698304"}},"media_url_https":"https://pbs.twimg.com/media/HVoAPcebAAAEKta.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":85,"y":0},{"h":1366,"w":1198,"x":169,"y":0},{"h":1366,"w":683,"x":427,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/FKLqCFJZwu"},{"display_url":"pic.x.com/FKLqCFJZwu","expanded_url":"https://x.com/ModJapan_jp/status/2115003265834430898/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":78,"w":78,"x":912,"y":704},{"h":158,"w":158,"x":1534,"y":290}]},"medium":{"faces":[{"h":45,"w":45,"x":534,"y":412},{"h":92,"w":92,"x":898,"y":169}]},"orig":{"faces":[{"h":78,"w":78,"x":912,"y":704},{"h":158,"w":158,"x":1534,"y":290}]},"small":{"faces":[{"h":25,"w":25,"x":302,"y":233},{"h":52,"w":52,"x":509,"y":96}]}},"id_str":"2115003240349831168","indices":[140,163],"media_key":"3_2115003240349831168","media_results":{"result":{"media_key":"3_2115003240349831168"}},"media_url_https":"https://pbs.twimg.com/media/HVoAPcfaEAAg9YI.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":682,"y":0},{"h":1366,"w":1198,"x":850,"y":0},{"h":1366,"w":683,"x":1348,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":