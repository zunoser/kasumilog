":306,"y":256},{"h":105,"w":105,"x":210,"y":138}]},"orig":{"faces":[{"h":111,"w":111,"x":665,"y":556},{"h":228,"w":228,"x":457,"y":299}]},"small":{"faces":[{"h":29,"w":29,"x":173,"y":145},{"h":59,"w":59,"x":119,"y":78}]}},"id_str":"2114963986097840128","indices":[111,134],"media_key":"3_2114963986097840128","media_results":{"result":{"media_key":"3_2114963986097840128"}},"media_url_https":"https://pbs.twimg.com/media/HVncijAbIAAx2pw.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":282,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Aokr5yiylC"}]},"favorite_count":6441,"favorited":false,"full_text":"本日、訪日中のタレク・ラーマン・バングラデシュ首相@trahmanbnpと首脳会談を行いました。\n\n「民主主義」や「法の支配」といった価値を共有する友人として、ラーマン首相の就任を直接お祝いでき、とても嬉しく存じました。 https://t.co/Aokr5yiylC","id_str":"2114964170848506090","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":294,"reply_count":1906,"retweet_count":835,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"91877252","indices":[25,36],"name":"Tarique Rahman","screen_name":"trahmanbnp"}]},"id":"Tm90ZVR3ZWV0OjIxMTQ5NjQxNzA3NDc4NjMwNDE=","richtext":{"richtext_tags":[]},"text":"本日、訪日中のタレク・ラーマン・バングラデシュ首相@trahmanbnpと首脳会談を行いました。\n\n「民主主義」や「法の支配」といった価値を共有する友人として、ラーマン首相の就任を直接お祝いでき、とても嬉しく存じました。\n\n日本は、「民主的な総選挙」を経て発足したラーマン政権による国づくりを、力強く後押ししてまいります。\n\n本日は、こうした観点から、バングラデシュと日本の協力について議論しました。\n\nバングラデシュは、「自由で開かれたインド太平洋（FOIP）」の実現に向けた重要なパートナーです。\n\n今回、両国の協力の基軸である「ベンガル湾産業成長地帯」構想、いわゆる「BIG-B」を進化させ、ラーマン首相との新たな戦略的協力イニシアティブ「繁栄を分かち合う BIG-B」として、推進していくことを確認しました。\n\nラーマン首相からは、日本が「平和国家」として歩み、バングラデシュの独立をいち早く承認したこと、日本はバングラデシュの人々にとって特別な存在であることを伺い、また、日本政府及び国民による幅広い分野への支援や協力に関する感謝を表明いただきました。\n\n東南アジアと南アジアを結ぶバングラデシュは、人口1.7億人の若い巨大市場の大きな潜在性も含め、日本の経済にとっても極めて重要です。\n\n両国の「戦略的パートナーシップ」の下、本日発表した『首脳共同声明』も踏まえ、官民による両国間の取組により、「共に、強く、豊かに。」\nインド太平洋地域の平和と繁栄に向けて、ラーマン首相と緊密に連携してまいります。"}}},"rest_id":"2114964170848506090","unmention_data":{},"views":{"count":"424273","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114964170848506090","sortIndex":"2115029469331718098"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":606},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1432867630298419206/Uez_q2Zx_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1312820383532294144/1679630740"},"core":{"created_at":"Sun Oct 04 18:22:33 +0000 2020","name":"デジタル庁","screen_name":"digital_jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzEyODIwMzgzNTMyMjk0MTQ0","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2112343286933533048"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"デジタル庁公式アカウントです。政策やサービスの新着情報を発信します。デジタル庁ウェブサイト: https://t.co/w7z4JlAihT |英語版X:@digital_jpn_en|ソーシャルメディア運用ポリシー: https://t.co/ukune2Dn5V","entities":{"description":{"urls":[{"display_url":"digital.go.jp","expand