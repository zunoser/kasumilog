:"mofa.go.jp/mofaj/press/ka…","expanded_url":"https://www.mofa.go.jp/mofaj/press/kaiken/kaikenw_000001_00256.html","indices":[247,270],"url":"https://t.co/aIYLNF6f9t"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA4ODc1NDcwMTA1ODA0ODA=","richtext":{"richtext_tags":[]},"text":"茂木外務大臣は、記者会見で以下について質疑応答を行いました。\n◆冒頭発言\n・外務大臣再任に際しての所感\n・第８１回国連総会出席\n◆質疑応答\n・国連総会における日本の立場\n・国連総会関連会合\n・日露関係（今後の対露外交）\n・日米地位協定\n・米国による国際刑事裁判所（ＩＣＣ）赤根所長への制裁\n・官民合同テロ・誘拐対策実地訓練（ＳＮＳ上での意見）\n・今後の外交政策\n・日印関係\n会見動画はこちらをご覧ください。\nhttps://t.co/WJBetgwJjO\n\n会見記録はこちらをご確認ください。\nhttps://t.co/aIYLNF6f9t"}}},"previous_counts":{"bookmark_count":2,"favorite_count":11,"quote_count":0,"reply_count":0,"retweet_count":0},"rest_id":"2100887547077665121","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3584","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100887547077665121","sortIndex":"2100906633163964397"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2100906633163964436-tweet-2100124570045067495","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":8},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","scre