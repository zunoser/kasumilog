ification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/3tgZ0wGHvI"}}}},"edit_control":{"edit_tweet_ids":["2100899099407224969"],"editable_until_msecs":"1789731952000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2100899099407224969","created_at":"Fri Sep 18 10:45:52 +0000 2026","display_text_range":[0,148],"entities":{},"favorite_count":2,"favorited":false,"full_text":"／\n11/20（金）\n100億企業創出経営者ネットワーク～成長の壁を突破するイノベーションと稼ぐための知財経営～を開催！\n＼\nイノベーションと知財をテーマに、100億企業の実現に向けた新たな視点や事例、経営のヒントをお届けします。ご関心のある方の参加をお待ちしています。\nオンライン参加も受付中！","id_str":"2100899099407224969","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":1,"retweeted":false,"user_id_str":"266566401"},"rest_id":"2100899099407224969","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2004","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2100906633163964424-tweet-2100899100967485627","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2100899104176181248/U6BvPBOA?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"100億企業創出経営者ネットワーク ～成長の壁を突破するイノベーションと稼ぐための知財経営～ 本気で100億企業を目指す経営者の皆様へ ──経営者ネットワークは、地域や業種は異なっていても、100億実現という同じ志を持ち、同じ課題に直面する経営者が集います。何かを成し遂げた経営者からの活きた経験、少し失敗してしまった経営者の教訓など、お互いの経験を共有しあうことで成長に向けたヒントと仲間を得...","type":"STRING"}},{"