list-conversation-2100906633163964436","sortIndex":"2100906633163964396"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/qOa41OLOzo"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2995558,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":537,"tweets":1787},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2100886310995243389"],"editable_until_msecs":"1789728903000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":28,"bookmarked":false,"conversation_id_str":"2100886310995243389","created_at":"Fri Sep 18 09:55:03 +0000 2026","display_text_range":[0,114],"entities":{},"favorite_count":3049,"favorited":false,"full_text":"大型の「台風第25号」は、明日（19日）にかけて小笠原諸島に接近し、20日（日）から21日（月）にかけて関東地方に接近するおそれがあります。\n\n官邸では、本日（18日）12時に官邸危機管理センターに「情報連絡室」を設置しました。","id_str":"2100886310995243389","is_quote_status":false,"lang":"ja","quote_count":17,"reply_count":190,"retweet_count":424,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"disaportal.gsi.go.jp/maps/?ll=35.35…","expanded_url":"https://disaportal.gsi.go.jp/maps/?ll=35.353216,138.735352&z=5&base=pale&vs=c1j0l0u0t0h0z0","indices":[519,542],"url":"https://t.co/qOa41OLOzo"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDA4ODYzMTA4Njk0Mzg0NjQ=","richtext":{"richtext_tags":[]},"text":"大型の「台風第25号」は、明日（19日）にかけて小笠原諸島に接近し、20日（日）から21日（月）にかけて関東地方に接近するおそれがあります。\n\n官邸では、本日（18日）12時に官邸危機管理センターに「情報連絡室」を設置しました。\n細野防災担当大臣の出席の下、「関係省庁災害警戒会議」を開催し、政府一体となって対応を行っています。\n\n明日から大型連休で、旅行などの計画を立てている方も多くいらっしゃると思います。\n・大雨や風が強い時間帯の外出を避ける、\n・山や海でのレジャーを控える、\n・増水した河川には絶対に近づかない、\n・必要に応じて予定を変更・中止する\nなど、くれぐれもお気を付けいただくようお願い申し上げます。\n\nまた、外出にあたっては足元の安全に十分注意し、運転の際は、冠水している道路やアンダーパスに進入しないようにご注意下さい。\n\nラジオ・テレビ・インターネットなどで、防災気象情報や自治体からの最新の避難情報に十分注意し、少しでも危険を感じれば、躊躇せず、早め早めに自らの命を守る行動をとっていただくよう、お願い申し上げます。\n\nお住まいの地域や滞在先でスマートフォンを用いてハザードマップをご覧になるには、こちらのサイト（https://t.co/qOa41OLOzo）が便利です。\n災害種別で「洪水・内水」を選択し、右下の位置情報の印を押すと、現在いる場所の危険性が確認できます。"}}},"rest_id":"2100886310995243389","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"108353","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100886310995243389","sortIndex":"2100906633163964395"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2100781871558770726"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mo