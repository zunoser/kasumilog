nversation_id_str":"2100720554844295417","created_at":"Thu Sep 17 22:56:24 +0000 2026","display_text_range":[0,158],"entities":{"hashtags":[{"indices":[10,17],"text":"交通安全運動"},{"indices":[149,158],"text":"全国交通安全運動"}],"media":[{"display_url":"pic.x.com/SEsQ6F09nE","expanded_url":"https://x.com/cao_koutsu/status/2100720554844295417/photo/1","ext_alt_text":"「秋の夕暮れ　ライトと反射材で守る命」をタイトルとした、令和８年９月21日（月）から９月30日（水）まで実施する「秋の全国交通安全運動」のポスター。９月30日（水）は「交通事故死ゼロを目指す日」と記載がある。歩行者に対しては、歩行者の安全確保と反射材用品の着用促進、自動車に対しては、夕暮れ時の早めのライト点灯と飲酒運転や「ながらスマホ」の根絶、自転車に対しては、自転車・特定小型原動機付自転車の交通ルールの理解・遵守の徹底を掲げている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":43,"w":43,"x":86,"y":178}]},"medium":{"faces":[{"h":43,"w":43,"x":86,"y":178}]},"orig":{"faces":[{"h":43,"w":43,"x":86,"y":178}]},"small":{"faces":[{"h":34,"w":34,"x":68,"y":142}]}},"id_str":"2100720550436130816","indices":[159,182],"media_key":"3_2100720550436130816","media_results":{"result":{"media_key":"3_2100720550436130816"}},"media_url_https":"https://pbs.twimg.com/media/HSdCNeUb0AABWqL.jpg","original_info":{"focus_rects":[{"h":476,"w":850,"x":0,"y":125},{"h":601,"w":601,"x":146,"y":0},{"h":601,"w":527,"x":183,"y":0},{"h":601,"w":301,"x":296,"y":0},{"h":601,"w":850,"x":0,"y":0}],"height":601,"width":850},"sizes":{"large":{"h":601,"resize":"fit","w":850},"medium":{"h":601,"resize":"fit","w":850},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/SEsQ6F09nE"}],"urls":[{"display_url":"youtube.com/watch?v=yWmzNp…","expanded_url":"https://www.youtube.com/watch?v=yWmzNpHis_g","indices":[124,147],"url":"https://t.co/pWi4qbKwf6"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/SEsQ6F09nE","expanded_url":"https://x.com/cao_koutsu/status/2100720554844295417/photo/1","ext_alt_text":"「秋の夕暮れ　ライトと反射材で守る命」をタイトルとした、令和８年９月21日（月）から９月30日（水）まで実施する「秋の全国交通安全運動」のポスター。９月30日（水）は「交通事故死ゼロを目指す日」と記載がある。歩行者に対しては、歩行者の安全確保と反射材用品の着用促進、自動車に対しては、夕暮れ時の早めのライト点灯と飲酒運転や「ながらスマホ」の根絶、自転車に対しては、自転車・特定小型原動機付自転車の交通ルールの理解・遵守の徹底を掲げている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":43,"w":43,"x":86,"y":178}]},"medium":{"faces":[{"h":43,"w":43,"x":86,"y":178}]},"orig":{"faces":[{"h":43,"w":43,"x":86,"y":178}]},"small":{"faces":[{"h":34,"w":34,"x":68,"y":142}]}},"id_str":"2100720550436130816","indices":[159,182],"media_key":"3_2100720550436130816","media_results":{"result":{"media_key":"3_2100720550436130816"}},"media_url_https":"https://pbs.twimg.com/media/HSdCNeUb0AABWqL.jpg","original_info":{"focus_rects":[{"h":476,"w":850,"x":0,"y":125},{"h":601,"w":601,"x":146,"y":0},{"h":601,"w":527,"x":183,"y":0},{"h":601,"w":301,"x":296,"y":0},{"h":601,"w":850,"x":0,"y":0}],"height":601,"width":850},"sizes":{"large":{"h":601,"resize":"fit","w":850},"medium":{"h":601,"resize":"fit","w":850},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/SEsQ6F09nE"}]},"favorite_count":53,"favorited":false,"full_text":"まもなく「秋の全国 #交通安全運動 」が始まります。\n実施期間：９月21日（月）～９月30日（水）\n\nドライバーの皆さん、日の入りが早まるこれからの季節の夕方･夜間は、歩行者の姿が見えにくくなります。\n早めにライトを点灯し、速度を抑えましょう。\n\nhttps://t.co/pWi4qbKwf6\n\n#全国交通安全運動 https://t.co/SEsQ6F09nE","id_str":"2100720554844295417","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":0,"retweet_count":15,"retweeted":false,"user_id_str":"1303199410956902400"},"rest_id":"2100720554844295417","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"9907","state":"EnabledWithCount"}}},"user_id_str":"412940784"},"rest_id":"2100894538160349587","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3677","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100894538160349587","sortIndex":"2100906633163964403"},{"content":{"__typename":"TimelineTimelineItem","c