ite_count":216,"favorited":false,"full_text":"⚠投資詐欺の被害が多発⚠\n\nダイレクトメッセージや「なりすまし広告」に注意しましょう。\n会ったことのない人からＳＮＳで投資の話を持ちかけられたり、金銭を要求されたらサギです。\n\nhttps://t.co/aWnu7Zdnk6 https://t.co/g8nTZld7v9","id_str":"2110143556010619123","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":10,"retweet_count":124,"retweeted":false,"user_id_str":"2891516809"},"rest_id":"2110143556010619123","unmention_data":{},"views":{"count":"10592","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110143556010619123","sortIndex":"2110338161455398833"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1790816113"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6l1S0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":297544,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4969,"tweets":12972},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2110143550088482963"],"editable_until_msecs":"1791936001000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2110143550088482963","created_at":"Tue Oct 13 23:00:01 +0000 2026","display_text_range":[0,111],"entities":{"media":[{"display_url":"pic.x.com/MhQflouqRL","expanded_url":"https://x.com/gov_online/status/2110143550088482963/photo/1","ext_alt_text":"政府広報、公正取引委員会の新聞記事下広告。左側に「価格カルテルは、独禁法上の違法行為です。」と大きく書かれている。その下には「原材料費や人件費、物流費などの上昇を受け、価格を見直すことは、事業者にとって正当な経営判断です。しかし、値上げに際して、競争関係にある事業者同士が価格や値上げ幅、時期などを申し合わせることは、「価格カルテル」として独占禁止法上の問題となります。値上げは、それぞれの事業者が自主的に決定するもの。たとえコスト上昇という共通の事情があっても、事業者間で合意することは許されません。公正取引委員会は、カルテル行為に対して厳正に対処しています。」と書かれている。右側には、価格の上昇の申合せを示す建物のイラストを背景に、バツ印が描かれた札を持つ人物のイラストがある。下部には「価格の見直しは、自らの判断で。競争事業者とやり取りしない。」と書かれ、詳細内容に関する二次元コードと「事業者からの相談も受け付けています。」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":64,"w":64,"x":555,"y":183},{"h":77,"w":77,"x":1283,"y":14},{"h":110,"w":110,"x":1096,"y":266},{"h":119,"w":119,"x":1262,"y":347},{"h":113,"w":113,"x":872,"y":215}]},"medium":{"faces":[{"h":53,"w":53,"x":463,"y":152},{"h":64,"w":64,"x":1072,"y":11},{"h":91,"w":91,"x":915,"y":222},{"h":99,"w":99,"x":1054,"y":289},{"h":94,"w":94,"x":728,"y":179}]},"orig":{"faces":[{"h":64,"w":64,"x":555,"y":183},{"h":77,"w":77,"x":1283,"y":14},{"h":110,"w":110,"x":1096,"y":266},{"h":119,"w":119,"x":1262,"y":347},{"h":113,"w":113,"x":872,"y":215}]},"small":{"faces":[{"h":30,"w":30,"x":262,"y":86},{"h":36,"w":36,"x":607,"y":6},{"h":52,"w":52,"x":518,"y":125},{"h":56,"w":56,"x":597,"y":164},{"h":53,"w":53,"x":412,"y":101}]}},"id_str":"2109892332908949505","indices":[112,135],"media_key":"3_2109892332908949505","media_results":{"result":{"media_key":"3_2109892332908949505"}},"media_url_https":"https://pbs.twimg.com/media/HUfX5elbsAEgXWt.jpg","original_info":{"focus_rects":[{"h":641,"w":1145,"x":0,"y":0},{"h":641,"w":641,"x":74,"y":0},{"h":641,"w":562,"x":113,"y":0},{"h":641,"w":321,"x":234,"y":0},{"h":641,"w":1436,"x":0,"y":0}],"height":641,"width":1436},"sizes":{"large":{"h":641,"resize":"fit","w":1436},"medium":{"h":536,"resize":"fit","w":1200},"small":{"h":304,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MhQflouqRL"}],"urls":[{"display_url":"jftc.go.jp/dk/shisaku/kar…","expanded_url":"https://www.jftc.go.jp/dk/shisaku/karuteru.html","indices":[88,111],"url":"https://t.co/PggciVUfbB"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/MhQflouqRL","expanded_url":"https://x.com/gov_online/status/2110143550088482963/photo/1","ext_alt_text":"政府広報、公正取引委員会の新聞記事下広告。左側に「価格カルテルは、独禁法上の違法行為です。」と大きく書かれている。その下には「原材料費や人件費、物流費などの上昇を受け、価格を見直すことは、事業者にとって正当な経営判断です。しかし、値上げに際して、競争関係にある事業者同士が価格や値上げ幅、時期などを申し合わせることは、「価格カルテル」として独占禁止法上の問題となります。値上げは、それぞれの事業者が自主的に決定するもの。たとえコスト上昇という共通の事情があっても、事業者間で合意することは許されません。公正取引委員会は、カルテル行為に対して厳正に対処しています。」と書かれている。右側には、価格の上昇の申合せを示す建物のイラストを背景に、バツ印が描かれた札を持つ人物のイラストがある。下部には「価格の見直しは、自らの判断で。競争事業者とやり取りしない。」と書かれ、詳細内容に関する二次元コードと「事業者からの相談も受け付けています。」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":64,"w":64,"x":555,"y":183},{"h":77,"w":77,"x":1283,"y":14},{"h":110,"w":110,"x":1096,"y":266},{"h":119,"w":119,"x":1262,"y":347},{"h":113,"w":113,"x":872,"y":215}]},"medium":{"faces":[{"h":53,"w":53,"x":463,"y":152},{"h":64,"w":64,"x":1072,"y":11},{"h":91,"w":91,"x":915,"y":222},{"h":99,"w":99,"x":1054,"y":289},{"h":94,"w":94,"x":728,"y":179}]},"orig":{"faces":[{"h":64,"w":64,"x":555,"y":183},{"h":77,"w":77,"x":1283,"y":14},{"h":110,"w":110,"x":1096,"y":266},{"h":119,"w":119,"x":1262,"y":347},{"h":113,"w":113,"x":872,"y":215}]},"small":{"faces":[{"h":30,"w":30,"x":262,"y":86},{"h":36,"w":36,"x":607,"y":6},{"h":52,"w":52,"x":518,"y":125},{"h":56,"w":56,"x":597,"y":164},{"h":53,"w":53,"x":412,"y":101}]}},"id_str":"2109892332908949505","indices":[112,135],"media_key":"3_2109892332908949505","media_results":{"result":{"media_key":"3_2109892332908949505"}},"media_url_https":"https://pbs.twimg.com/media/HUfX5elbsAEgXWt.jpg","original_info":{"focus_rects":[{"h":641,"w":1145,"x":0,"y":0},{"h":641,"w":641,"x":74,"y":0},{"h":641,"w":562,"x":113,"y":0},{"h":641,"w":321,"x":234,"y":0},{"h":641,"w":1436,"x":0,"y":0}],"height":641,"width":1436},"sizes":{"large":{"h":641,"resize":"fit","w":1436},"medium":{"h":536,"resize":"fit","w":1200},"small":{"h":304,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MhQflouqRL"}]},"favorite_count":42,"favorited":false,"full_text":"📌価格カルテルは、独占禁止法上の違法行為です\n\n価格の見直しは、事業者自らの判断で行い、競争事業者とやり取りしない。\n\n詳しくは、公正取引委員会ウェブサイトをご確認ください👇\nhttps://t.co/PggciVUfbB https://t.co/MhQflouqRL","id_str":"2110143550088482963","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":2,"retweet_count":21,"retweeted":false,"user_id_str":"461064204"},