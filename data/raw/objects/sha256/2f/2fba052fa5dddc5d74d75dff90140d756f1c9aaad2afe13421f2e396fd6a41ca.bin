携強化に関する産学官検討委員会の第2回会合を開催しました。大空外務政務官は、開会の挨拶を行い、本検討委員会の日本とアフリカ双方にとっての意義について言及するとともに、本検討委員会における議論が日本とアフリカとの更なる経済関係の発展に繋がることへの期待を表明 https://t.co/ubhuJXXjfh","id_str":"2110305435219824693","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":4,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04294.html","indices":[237,260],"url":"https://t.co/46iJ2CRwdd"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTAzMDU0MzUwOTgxNjkzNDQ=","richtext":{"richtext_tags":[]},"text":"日本とアフリカとの経済連携強化に関する産学官検討委員会の第2回会合を開催しました。大空外務政務官は、開会の挨拶を行い、本検討委員会の日本とアフリカ双方にとっての意義について言及するとともに、本検討委員会における議論が日本とアフリカとの更なる経済関係の発展に繋がることへの期待を表明しました。会議には、座長を務める渡邊頼純慶應義塾大学名誉教授のほか、日本とアフリカの産学官の委員等が参加しました。また、各委員による発表・議論では、参加者の間で活発な意見交換が行われました。\n\nhttps://t.co/46iJ2CRwdd"}}},"rest_id":"2110305435219824693","unmention_data":{},"views":{"count":"4541","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110305435219824693","sortIndex":"2110338161455398908"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:0