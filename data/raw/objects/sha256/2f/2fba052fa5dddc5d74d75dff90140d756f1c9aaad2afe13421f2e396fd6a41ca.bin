q9","expanded_url":"https://x.com/ModJapan_jp/status/2109981696783532063/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2109981688935878657","indices":[106,129],"media_key":"3_2109981688935878657","media_results":{"result":{"media_key":"3_2109981688935878657"}},"media_url_https":"https://pbs.twimg.com/media/HUgpKruaEAE0SoA.jpg","original_info":{"focus_rects":[{"h":472,"w":842,"x":0,"y":124},{"h":596,"w":596,"x":123,"y":0},{"h":596,"w":523,"x":160,"y":0},{"h":596,"w":298,"x":272,"y":0},{"h":596,"w":842,"x":0,"y":0}],"height":596,"width":842},"sizes":{"large":{"h":596,"resize":"fit","w":842},"medium":{"h":596,"resize":"fit","w":842},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/2iuMi4Pcq9"}]},"favorite_count":1576,"favorited":false,"full_text":"令和８年１０月１３日（火）午後、中国軍の情報収集機（Ｙ-９）×１機が大陸方面から飛来し、東シナ海上の長崎県男女群島の南西沖から沖縄本島の北西沖にかけて往復飛行を行った後、大陸方面に向けて飛行したことを確認した。 https://t.co/2iuMi4Pcq9","id_str":"2109981696783532063","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":14,"quoted_status_id_str":"2109981505351270838","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2109981505351270838","url":"https://t.co/YGP4XW0VwY"},"reply_count":32,"retweet_count":384,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDk5ODE2OTY3MzMxMDYxNzY=","text":"令和８年１０月１３日（火）午後、中国軍の情報収集機（Ｙ-９）×１機が大陸方面から飛来し、東シナ海上の長崎県男女群島の南西沖から沖縄本島の北西沖にかけて往復飛行を行った後、大陸方面に向けて飛行したことを確認した。\nこれに対し、航空自衛隊の西部航空方面隊等の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"fav