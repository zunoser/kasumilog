u Oct 08 08:53:18 +0000 2009","name":"European External Action Service - EEAS 🇪🇺","screen_name":"eu_eeas"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4MDgwMzgxOQ==","is_blue_verified":true,"location":{"location":"HQ: Brussels"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1557394872964898818"},"profile_bio":{"description":"The EU diplomatic service, led by @kajakallas. Promoting peace, security & EU values globally. Insights into foreign policy.","entities":{"description":{},"url":{"urls":[{"display_url":"eeas.europa.eu","expanded_url":"http://eeas.europa.eu/","indices":[0,23],"url":"https://t.co/U3Nlh7laCQ"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":470617,"following":1136},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"80803819","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7379,"tweets":37593},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/U3Nlh7laCQ"}}}},"edit_control":{"edit_tweet_ids":["2109661542627299832"],"editable_until_msecs":"1791821082000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"data":{"associated_data":{},"destination_language":"ja","entities":{"hashtags":[],"symbols":[],"urls":[],"user_mentions":[]},"preview_translation":"EUは、国際的なパートナーに対し、EU主導の「No Fees/No Tolls（料金なし/通行料なし）」誓約に参加するよう呼びかけています。この誓約は、強制的で一方的な行動を拒否し、合法的な航行を妨げる違法な料金、通行料、制限に反対することを目的としています。","source_language":"en","translation":"EUは、国際的なパートナーに対し、EU主導の「No Fees/No Tolls（料金なし/通行料なし）」誓約に参加するよう呼びかけています。この誓約は、強制的で一方的な行動を拒否し、合法的な航行を妨げる違法な料金、通行料、制限に反対することを目的としています。\n\n国際海峡は、世界の生命線であり、貿易、エネルギー供給、必需品を世界中で流通させ続けています。\n\n航行の自由は、共有されるグローバルな利益です。\n\n詳細はこちら："},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":15,"bookmarked":false,"conversation_id_str":"2109661542627299832","created_at":"Mon Oct 12 15:04:42 +0000 2026","display_text_range":[0,274],"entities":{"media":[{"display_url":"pic.x.com/6XEroKVnRh","expanded_url":"https://x.com/eu_eeas/status/2109661542627299832/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2109661534922383361","indices":[275,298],"media_key":"3_2109661534922383361","media_results":{"result":{"media_key":"3_2109661534922383361"}},"media_url_https":"https://pbs.twimg.com/media/HUcF_RFaoAECr2M.jpg","original_info":{"focus_rects":[{"h":605,"w":1080,"x":0,"y":211},{"h":1080,"w":1080,"x":0,"y":0},{"h":1080,"w":947,"x":133,"y":0},{"h":1080,"w":540,"x":513,"y":0},{"h":1080,"w":1080,"x":0,"y":0}],"height":1080,"width":1080},"sizes":{"large":{"h":1080,"resize":"fit","w":1080},"medium":{"h":1080,"resize":"fit","w":1080},"small":{"h":680,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6XEroKVnRh"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/6XEroKVnRh","expanded_url":"https://x.com/eu_eeas/status/2109661542627299832/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2109661534922383361","indices":[275,298],"media_key":"3_2109661534922383361","media_results":{"result":{"media_key":"3_2109661534922383361"}},"media_url_https":"https://pbs.twimg.com/media/HUcF_RFaoAECr2M.jpg","original_info":{"focus