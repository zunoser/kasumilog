,"id_str":"2110284140344160256","indices":[143,166],"media_key":"3_2110284140344160256","media_results":{"result":{"media_key":"3_2110284140344160256"}},"media_url_https":"https://pbs.twimg.com/media/HUk8PrBasAAQmNf.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1463,"w":1463,"x":0,"y":0},{"h":1463,"w":1283,"x":0,"y":0},{"h":1463,"w":732,"x":0,"y":0},{"h":1463,"w":2048,"x":0,"y":0}],"height":1463,"width":2048},"sizes":{"large":{"h":1463,"resize":"fit","w":2048},"medium":{"h":857,"resize":"fit","w":1200},"small":{"h":486,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KyaPEJPklt"}]},"favorite_count":88,"favorited":false,"full_text":"藤井外務大臣政務官は、模擬国連会議全米大会第44代・第43代日本代表団派遣団による表敬を受けました。藤井政務官から、一行が日頃から国際社会が直面する問題や、マルチ外交交渉について高い関心を持ち活動していることを嬉しく思う、模擬国連会議全米大会日本代表団派遣事業での経験を通じて、将来、 https://t.co/KyaPEJPklt","id_str":"2110284376873287819","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":3,"retweet_count":10,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/fp/un/pa…","expanded_url":"https://www.mofa.go.jp/mofaj/fp/un/pageit_000001_03252.html","indices":[223,246],"url":"https://t.co/QSQwkeTMqo"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTAyODQzNzY3NDc1MDM2MTc=","richtext":{"richtext_tags":[]},"text":"藤井外務大臣政務官は、模擬国連会議全米大会第44代・第43代日本代表団派遣団による表敬を受けました。藤井政務官から、一行が日頃から国際社会が直面する問題や、マルチ外交交渉について高い関心を持ち活動していることを嬉しく思う、模擬国連会議全米大会日本代表団派遣事業での経験を通じて、将来、一行が世界を舞台に活躍することを期待する旨述べました。一行からは、模擬国連会議全米大会日本代表団派遣事業での取組や今後の事業運営に関する抱負が述べられました。\n\nhttps://t.co/QSQwkeTMqo"}}},"rest_id":"2110284376873287819","unmention_data":{},"views":{"count":"5272","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110284376873287819","sortIndex":"2110338161455398892"},{"content":{"__typename":"TimelineTime