te":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2110166193609085163"],"editable_until_msecs":"1791941400000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":7,"bookmarked":false,"conversation_id_str":"2110166193609085163","created_at":"Wed Oct 14 00:30:00 +0000 2026","display_text_range":[0,141],"entities":{"media":[{"display_url":"pic.x.com/jnFqBYOChv","expanded_url":"https://x.com/gov_online/status/2110166193609085163/photo/1","ext_alt_text":"政府広報提供テレビ番組、「ニッポン今だラボ」の10月14日（水曜日）放送のサムネイル。創薬研究の現場で、研究者が実験している様子の画像を背景に、出演者の今田耕司さん、森香澄さんの写真があり、今田耕司さんの写真に吹き出しで「日本第３位の産業!?」と書かれている。下部には大きく「健康と経済に必要不可欠!創薬とは!?」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":37,"w":37,"x":76,"y":473},{"h":50,"w":50,"x":638,"y":426}]},"medium":{"faces":[{"h":37,"w":37,"x":76,"y":473},{"h":50,"w":50,"x":638,"y":426}]},"orig":{"faces":[{"h":37,"w":37,"x":76,"y":473},{"h":50,"w":50,"x":638,"y":426}]},"small":{"faces":[{"h":26,"w":26,"x":53,"y":335},{"h":35,"w":35,"x":451,"y":301}]}},"id_str":"2109823380761526272","indices":[142,165],"media_key":"3_2109823380761526272","media_results":{"result":{"media_key":"3_2109823380761526272"}},"media_url_https":"https://pbs.twimg.com/media/HUeZL70awAAGMw9.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":2},{"h":540,"w":540,"x":420,"y":0},{"h":540,"w":474,"x":486,"y":0},{"h":540,"w":270,"x":609,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/jnFqBYOChv"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/jnFqBYOChv","expanded_url":"https://x.com/gov_online/status/2110166193609085163/photo/1","ext_alt_text":"政府広報提供テレビ番組、「ニッポン今だラボ」の10月14日（水曜日）放送のサムネイル。創薬研究の現場で、研究者が実験している様子の画像を背景に、出演者の今田耕司さん、森香澄さんの写真があり、今田耕司さんの写真に吹き出しで「日本第３位の産業!?」と書かれている。下部には大きく「健康と経済に必要不可欠!創薬とは!?」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":37,"w":37,"x":76,"y":473},{"h":50,"w":50,"x":638,"y":426}]},"medium":{"faces":[{"h":37,"w":37,"x":76,"y":473},{"h":50,"w":50,"x":638,"y":426}]},"orig":{"faces":[{"h":37,"w":37,"x":76,"y":473},{"h":50,"w":50,"x":638,"y":426}]},"small":{"faces":[{"h":26,"w":26,"x":53,"y":335},{"h":35,"w":35,"x":451,"y":301}]}},"id_str":"2109823380761526272","indices":[142,165],"media_key":"3_2109823380761526272","media_results":{"result":{"media_key":"3_2109823380761526272"}},"media_url_https":"https://pbs.twimg.com/media/HUeZL70awAAGMw9.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":2},{"h":540,"w":540,"x":420,"y":0},{"h":540,"w":474,"x":486,"y":0},{"h":540,"w":270,"x":609,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/jnFqBYOChv"}]},"favorite_count":124,"favorited":false,"full_text":"／\n今夜、フジテレビほかで放送📺！\n「ニッポン 今だ！ラボ」\n※地域により放送日時が異なります。\n＼\n\n今回のテーマは【ニッポンの創薬】🔎\n\n今田耕司さん・森香澄さんがナビゲート！\nナレーションは男性ブランコの浦井のりひろさん。\n難しく思われがちな国の政策を「自分ゴト」として解説。 https://t.co/jnFqBYOChv","id_str":"2110166193609085163","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":1,"retweet_count":38,"retweeted":false,"user_id_str":"461064204"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"fujitv.co.jp/nippon_imada_l…","expanded_url":"https://www.fujitv.co.jp/nippon_imada_labo/","indices":[188,211],"url":"https://t.co/ysZVWbHtn5"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTAxNjYxOTM1Mzc3NTcxODQ=","text":"／\n今夜、フジテレビほかで放送📺！\n「ニッポン 今だ！ラボ」\n※地域により放送日時が異なります。\n＼\n\n今回のテーマは【ニッポンの創薬】🔎\n\n今田耕司さん・森香澄さんがナビゲート！\nナレーションは男性ブランコの浦井のりひろさん。\n難しく思われがちな国の政策を「自分ゴト」として解説。\n「知るのは、今だ！」\n\n▼番組公式サイト\n（各地域での放送スケジュールや番組情報はこちら）\nhttps://t.co/ysZVWbHtn5\n\n放送後には、番組公式サイトで放送内容動画を公開するほか、\nTVerでも過去放送を配信中です！\n※再生できない場合はブラウザからご覧ください。"}}},"rest_id":"2110166193609085163","unmention_data":{},"views":{"count":"33688","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110166193609085163","sortIndex":"2110338161455398834"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":99},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/530187236663250944/sN73nkH6_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Thu Nov 06 01:42:29 +0000 2014","name":"警察庁","screen_name":"NPA_KOHO"},"dm_permissions":{"can_dm":true},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODkxNTE2ODA5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2-1-2"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2105462712964616587"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"警察庁公式アカウントです。\n\n発信する情報は「報道発表資料」「新着情報」を基本としています。当アカウントは発信専用のため警察庁からの返信等は行っておりません。ご利用にあたっては「警察庁X（旧：Twitter）運用ポリシー」https://t.co/i1GUZVK3RZをご覧ください。","entities":{"description":{"urls":[{"display_url":"np