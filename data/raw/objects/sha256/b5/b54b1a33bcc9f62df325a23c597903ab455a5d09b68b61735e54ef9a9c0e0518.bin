ting":false},"rest_id":"1120633726478823425","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8139,"tweets":16587},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/ctVL0atMBQ"}}}},"edit_control":{"edit_tweet_ids":["2092169050210123983"],"editable_until_msecs":"1787650546000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":true,"legacy":{"bookmark_count":234,"bookmarked":false,"conversation_id_str":"2092169050210123983","created_at":"Tue Aug 25 08:35:46 +0000 2026","display_text_range":[0,278],"entities":{"user_mentions":[{"id_str":"218434058","indices":[213,228],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"favorite_count":9607,"favorited":false,"full_text":"Japan is geographically distant from Ukraine, but we are very close in terms of our values, shared principles, and our common understanding of how important freedom and independence are. Thank you, Prime Minister @takaichi_sanae, for your congratulations on the 35th anniversary","id_str":"2092169050210123983","is_quote_status":false,"lang":"en","quote_count":97,"reply_count":195,"retweet_count":1545,"retweeted":false,"user_id_str":"1120633726478823425"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"218434058","indices":[213,228],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"id":"Tm90ZVR3ZWV0OjIwOTIxNjkwNTAxMDk0NjA0ODE=","richtext":{"richtext_tags":[]},"text":"Japan is geographically distant from Ukraine, but we are very close in terms of our values, shared principles, and our common understanding of how important freedom and independence are. Thank you, Prime Minister @takaichi_sanae, for your congratulations on the 35th anniversary of Ukraine’s independence.\n\nWe are constantly working to strengthen the defense of both our peoples and our regions. Russia’s cooperation with North Korea is truly dangerous for everyone in Asia as well. In light of all this, we highly value your messages about the importance of strengthening sanctions against Russia and increasing support for our country and our people. Thank you for speaking so warmly about the Ukrainian people and for always recognizing the courage of Ukrainians. Thank you, Japan!"}}},"rest_id":"2092169050210123983","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"318267","state":"EnabledWithCount"}}},"rest_id":"2092268465797439729","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"27135","state":"EnabledWithCount"}}}},"user_id_str":"412940784"},"rest_id":"2092270078020784555","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"3237","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2092270078020784555","sortIndex":"2092307522202370046"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2982479,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":516,"tweets":1728},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2092263243863789834"],"editable_until_msecs":"1787673004000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":81,"bookmarked":false,"conversation_id_str":"2092263243863789834","created_at":"Tue Aug 25 14:50:04 +0000 2026","display_text_range":[0,132],"entities":{},"favorite_count":5094,"favorited":false,"full_text":"この度、『世界銀行グループ』の「内部監査」を担当する副総裁に、慶長祐子氏が任命されました。\n\n日本人の女性が、世界銀行という国際機関の幹部として活躍されることを、とても嬉しく誇らしく思います。\n\n日本人の幹部登用については、バンガ総裁との会談時に要請していました。","id_str":"2092263243863789834","is_quote_status":false,"lang":"ja","quote_count":108,"reply_count":381,"retweet_count":496,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTIyNjMyNDM4MTMzNjc4MDg=","richtext":{"richtext_tags":[]},"text":"この度、『世界銀行グループ』の「内部監査」を担当する副総裁に、慶長祐子氏が任命されました。\n\n日本人の女性が、世界銀行という国際機関の幹部として活躍されることを、とても嬉しく誇らしく思います。\n\n日本人の幹部登用については、バンガ総裁との会談時に要請していました。\n\nバンガ総裁のご尽力に、感謝申し上げます。\n\n世界経済が様々な「リスク」と「不確実性」に直面する中、「貧困削減」と「繁栄の共有」の実現に向けた国際社会の課題は一層複雑化しています。\n\n今後とも、『世界銀行グループ』が、「開発資金の供給」「知見の共有」「民間投資の促進」などを通じて「国際開発協力」の中核的役割を果たしていくとともに、その中枢で日本人幹部が活躍することで、日本と『世界銀行グループ』との協力関係がより一層発展していくことを期待しています。"}}},"rest_id":"2092263243863789834","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"183098","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092263243863789834","sortIndex":"2092307522202370045"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2092307522202370052-tweet-2092243157102768360","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +