lable"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2092158762807345152","indices":[75,98],"media_key":"3_2092158762807345152","media_results":{"result":{"media_key":"3_2092158762807345152"}},"media_url_https":"https://pbs.twimg.com/media/HQjXT17aQAAtZM1.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":107},{"h":779,"w":779,"x":60,"y":0},{"h":779,"w":683,"x":108,"y":0},{"h":779,"w":390,"x":254,"y":0},{"h":779,"w":1200,"x":0,"y":0}],"height":779,"width":1200},"sizes":{"large":{"h":779,"resize":"fit","w":1200},"medium":{"h":779,"resize":"fit","w":1200},"small":{"h":441,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Gd25dzY60s"}]},"favorite_count":19,"favorited":false,"full_text":"8月23日（日）、佐々木副大臣は、宮城県仙台市にて開催された「海上保安庁巡視船からの油流出事案に関するタスクフォース」（第2回会議）に出席しました。 https://t.co/Gd25dzY60s","id_str":"2092158768188674337","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":4,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTIxNTg3NjgxMzgzMjYwMTY=","richtext":{"richtext_tags":[]},"text":"8月23日（日）、佐々木副大臣は、宮城県仙台市にて開催された「海上保安庁巡視船からの油流出事案に関するタスクフォース」（第2回会議）に出席しました。\n　当該タスクフォースでは、引き続き、漁業関係者の負担軽減策や加工・流通、観光業への影響の情報収集に取り組むことが確認されたほか、被害漁場及び周辺海域で養殖生産を行うことに問題がない旨の安全宣言が行われました。"}}},"rest_id":"2092158768188674337","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"6978","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092158768188674337","sortIndex":"2092307522202370006"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"Organ