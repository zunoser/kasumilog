:0},{"h":960,"w":480,"x":688,"y":0},{"h":960,"w":1280,"x":0,"y":0}],"height":960,"width":1280},"sizes":{"large":{"h":960,"resize":"fit","w":1280},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HHkdFsZBEr"},{"display_url":"pic.x.com/HHkdFsZBEr","expanded_url":"https://x.com/OKIDEN_Official/status/2091771623728873580/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2091771609678057472","indices":[144,167],"media_key":"3_2091771609678057472","media_results":{"result":{"media_key":"3_2091771609678057472"}},"media_url_https":"https://pbs.twimg.com/media/HQd3MkIbkAA-NBs.jpg","original_info":{"focus_rects":[{"h":717,"w":1280,"x":0,"y":243},{"h":960,"w":960,"x":320,"y":0},{"h":960,"w":842,"x":438,"y":0},{"h":960,"w":480,"x":752,"y":0},{"h":960,"w":1280,"x":0,"y":0}],"height":960,"width":1280},"sizes":{"large":{"h":960,"resize":"fit","w":1280},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/HHkdFsZBEr"}]},"favorite_count":116,"favorited":false,"full_text":"【沖縄電力からのお願い】\n#台風18号 が沖縄地方に接近しています。\n\n風雨が強くなる前に、ベランダや庭先の飛散しやすい物の片づけ、トタンや看板の固定など、早めの台風対策をお願いいたします。\n\nまた、停電が発生した場合に備えて懐中電灯、携帯型ラジオ、乾電池、飲料水、生活用水などの準備や https://t.co/HHkdFsZBEr","id_str":"2091771623728873580","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":80,"retweeted":false,"user_id_str":"1049927655498207232"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[13,19],"text":"台風18号"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"okiden.co.jp/shared/pdf/liv…","expanded_url":"https://www.okiden.co.jp/shared/pdf/livelihood/disaster/data01.pdf","indices":[251,274],"url":"https://t.co/9djP5mF6iH"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTE3NzE2MjM2MDczMzY5NjA=","text":"【沖縄電力からのお願い】\n#台風18号 が沖縄地方に接近しています。\n\n風雨が強くなる前に、ベランダや庭先の飛散しやすい物の片づけ、トタンや看板の固定など、早めの台風対策をお願いいたします。\n\nまた、停電が発生した場合に備えて懐中電灯、携帯型ラジオ、乾電池、飲料水、生活用水などの準備や\nスマートフォン、モバイルバッテリーの充電、ブレーカー操作の確認をお願いします。\n\n沖縄電力でも、南大東島に設置している「可倒式風力発電設備」を事前に傾倒するなど、台風への備えを進めています.\n\n〇台風対策のお願い\nhttps://t.co/9djP5mF6iH"}}},"rest_id":"2091771623728873580","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"13005","state":"EnabledWithCount"}}},"user_id_str":"266566401"},"rest_id":"2092112919756694002","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"822","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092112919756694002","sortIndex":"2092307522202369979"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2092091830842318848/Sl6Yclcv?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2092091830842318848/Sl6Yclcv?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"官房長官の定例記者会見の様子などをご覧になれます。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.kantei.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/209209