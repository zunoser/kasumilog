sults":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"218434058","indices":[213,228],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"id":"Tm90ZVR3ZWV0OjIwOTIxNjkwNTAxMDk0NjA0ODE=","richtext":{"richtext_tags":[]},"text":"Japan is geographically distant from Ukraine, but we are very close in terms of our values, shared principles, and our common understanding of how important freedom and independence are. Thank you, Prime Minister @takaichi_sanae, for your congratulations on the 35th anniversary of Ukraine’s independence.\n\nWe are constantly working to strengthen the defense of both our peoples and our regions. Russia’s cooperation with North Korea is truly dangerous for everyone in Asia as well. In light of all this, we highly value your messages about the importance of strengthening sanctions against Russia and increasing support for our country and our people. Thank you for speaking so warmly about the Ukrainian people and for always recognizing the courage of Ukrainians. Thank you, Japan!"}}},"rest_id":"2092169050210123983","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"318267","state":"EnabledWithCount"}}},"user_id_str":"218434058"},"rest_id":"2092278707234943319","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"21508","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092278707234943319","sortIndex":"2092307522202370048"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":