e_count":359,"favorited":false,"full_text":"高市総理大臣は、ニャムオソル・オチラル・モンゴル首相と会談及びワーキング・ディナーを行いました。日本はモンゴルの最も重要な第三の隣国であり、両首脳は、空の連結性の鍵であり、日本企業が運営に参画するチンギス・ハーン国際空港の拡張で協力する等、進化したFOIPの下、更なる協力を進めること https://t.co/eI3jp81twb","id_str":"2104921320714895445","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":13,"retweet_count":64,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/a_o/c_m1…","expanded_url":"https://www.mofa.go.jp/mofaj/a_o/c_m1/mn/pageit_000001_03235.html","indices":[187,210],"url":"https://t.co/lqLJDeHR5k"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ5MjEzMjA2MDE2MzY4NjY=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、ニャムオソル・オチラル・モンゴル首相と会談及びワーキング・ディナーを行いました。日本はモンゴルの最も重要な第三の隣国であり、両首脳は、空の連結性の鍵であり、日本企業が運営に参画するチンギス・ハーン国際空港の拡張で協力する等、進化したFOIPの下、更なる協力を進めることで一致しました。オチラル首相から、日本の平和国家としての歩みへの高い評価がありました。\n\nhttps://t.co/lqLJDeHR5k\n（写真提供：内閣広報室）"}}},"rest_id":"2104921320714895445","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"9296","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104921320714895445","sortIndex":"2104962532409081856"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"im