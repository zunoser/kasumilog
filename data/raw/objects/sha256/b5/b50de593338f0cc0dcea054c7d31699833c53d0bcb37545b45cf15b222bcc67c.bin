edia_results":{"result":{"media_key":"3_2104884688909418496"}},"media_url_https":"https://pbs.twimg.com/media/HTYNeO-awAAUj_1.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":238,"y":0},{"h":1734,"w":1521,"x":345,"y":0},{"h":1734,"w":867,"x":672,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/aJY0QnOW1f"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/aJY0QnOW1f","expanded_url":"https://x.com/takaichi_sanae/status/2104885148286386568/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":181,"w":181,"x":1491,"y":383}]},"medium":{"faces":[{"h":106,"w":106,"x":874,"y":224}]},"orig":{"faces":[{"h":231,"w":231,"x":1894,"y":487}]},"small":{"faces":[{"h":60,"w":60,"x":495,"y":127}]}},"id_str":"2104884688909418496","indices":[143,166],"media_key":"3_2104884688909418496","media_results":{"result":{"media_key":"3_2104884688909418496"}},"media_url_https":"https://pbs.twimg.com/media/HTYNeO-awAAUj_1.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":238,"y":0},{"h":1734,"w":1521,"x":345,"y":0},{"h":1734,"w":867,"x":672,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/aJY0QnOW1f"}]},"favorite_count":9226,"favorited":false,"full_text":"＜スギから生まれる高機能プラスチック代替素材＞\n\n3つ目は、「改質リグニン」という｢スギ｣を原料にした世界で初めての新素材です。\n\n国立研究開発法人森林研究・整備機構森林総合研究所の上席研究員でもある、（株）木質素研究所（リグニンラボ）の山田竜彦取締役CTOからご説明いただきました。 https://t.co/aJY0QnOW1f","id_str":"2104885148286386568","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":128,"reply_count":322,"retweet_count":1235,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"lignin-lab.jp","expanded_url":"https://lignin-lab.jp/","indices":[984,1007],"url":"https://t.co/lzL1QGGzdW"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ4ODUxNDgxMTQzNzg3NTI=","richtext":{"richtext_tags":[]},"text":"＜スギから生まれる高機能プラスチック代替素材＞\n\n3つ目は、「改質リグニン」という｢スギ｣を原料にした世界で初めての新素材です。\n\n国立研究開発法人森林研究・整備機構森林総合研究所の上席研究員でもある、（株）木質素研究所（リグニンラボ）の山田竜彦取締役CTOからご説明いただきました。\n\n「改質リグニン」は、強度や加工性に優れ、半導体材料や繊維強化プラスチックなどの石油由来の材料を超える、「高機能材料」としての利用が期待されています。\n\n「スギ」花粉症に悩む方々も多くおられますが、国内の「スギ」人工林は、その約６割が「利用期」を迎え、安定供給が可能になっており、「スギ」を活用することで中山間地域に新たな素材産業を創出することも期待できます。\n\n使い道としては、特に運輸部門で、「材料の強度・軽量化」や「バイオマス素材の活用」への関心が高いそうで、例えば、昨年末から、一部の私鉄で、「改質リグニン」を使った「ブレーキ」のテスト搭載が始まっているとのことでした。\n\n高機能プラスチックを「改質リグニン」で代替することが期待できるので、ＥＶやドローン、半導体の分野等での幅広い活用が期待できそうです。\n\nまた、国際情勢に左右されるナフサ由来のプラスチックを減らし、国産「スギ」で代替できるため、「経済安全保障」の面でも有効な技術といえます。\n\nデモンストレーションとして、車の「ボンネット」をご持参いただき、官房長官に、従来の製品と「改質リグニン」を使用した製品の両方を実際に持って、比較してもらいました。\n官房長官も「リグニンを使った製品は指でも持てる軽さ」と仰っていたので、私も持ってみましたが、本当に軽くて驚きました。\nかなり燃費が向上することでしょう。\n\nこの技術もまた、「エネルギー効率化」といった社会課題を解決すると同時に、「価格競争力」も期待できる技術であり、成長の「原動力」になり得ると感じました。\n\n以上、3つの「きらりと光る新技術」をご説明させていただきましたが、改めて、「横浜グリーンエクスポ」は、皆様が楽しめる万博にすることはもとより、「グリーン技術の産業見本市」としても成功させたいとの思いを強くいたしました。\n\n次回、また「きらりと光る新技術」をご披露いただくのをとても楽しみにしています。\n\n（株）木質素研究所（リグニンラボ）のリンク先：https://t.co/lzL1QGGzdW"}}},"rest_id":"2104885148286386568","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"253596","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104885148286386568","sortIndex":"2104962532409081839"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3007081,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":558,"tweets":1825},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104884611381858369"],"editable_until_msecs":"1790682172000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":80,"bookmarked":false,"conversation_id_str":"2104884611381858369","created_at":"Tue Sep 29 10:42:52 +0000 2026","display_text_range":[0,151],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/Lq8rcwtAyh","expanded_url":"https://x.com/takaichi_sanae/status/2104884611381858369/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":1099,"w":1099,"x":391,"y":0}]},"medium":{"faces":[{"h":644,"w":644,"x":229,"y":0}]},"orig":{"faces":[{"h":1396,"w":1396,"x":497,"y":0}]},"small":{"faces":[{"h":365,"w":365,"x":129,"y":0}]}},"id_str":"2104884081871994880","indices":[152,175],"media_key":"3_2104884081871994880","media_results":{"result":{"media_key":"3_2104884081871994880"}},"media_url_https":"https://pbs.twimg.com/media/HTYM65lawAAWUAw.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Lq8rcwtAyh"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/Lq8rcwtAyh","expanded_url":"https://x.com/takaichi_sanae/status/2104884611381858369/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":1099,"w":1099,"x":391,"y":0}]},"medium":{"faces":[{"h":644,"w":644,"x":229,"y":0}]},"orig":{"faces":[{"h":1396,"w":1396,"x":497,"y":0}]},"small":{"faces":[{"h":365,"w":365,"x":129,"y":0}]}},"id_str":"2104884081871994880","indices":[152,175],"media_key":"3_2104884081871994880","media_results":{"result":{"media_key":"3_2104884081871994880"}},"media_url_https":"https://pbs.twimg.com/media/HTYM65lawAAWUAw.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Lq8rcwtAyh"}]},"favorite_count":4238,"favorited":false,"full_text":"＜省エネと脱炭素を支える超断熱材素材＞\n\n2つ目にご披露いただいたのは、新しい断熱技術「TIISA」（ティーサ）です。\n\n国立研究開発法人物質・材料研究機構（NIMS）の主任研究員である、同機構発のベンチャー企業（株）Thermalyticaの創業者兼CTOのウー・ラダーさんからご説明いただきました。 https://t.co/Lq8rcwtAyh","id_str":"2104884611381858369","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":40,"reply_count":110,"retweet_count":565,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"thermalytica.com/ja","expanded_url":"https://thermalytica.com/ja","indices":[872,895],"url":"https://t.co/eiyQGYIFrk"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ4ODQ2MTEyMjI1ODEyNDg=","richtext":{"richtext_tags":[]},"text":"＜省エネと脱炭素を支える超断熱材素材＞\n\n2つ目にご披露いただいたのは、新しい断熱技術「TIISA」（ティーサ）です。\n\n国立研究開発法人物質・材料研究機構（NIMS）の主任研究員である、同機構発のベンチャー企業（株）Thermalyticaの創業者兼CTOのウー・ラダーさんからご説明いただきました。\n\n世界で消費されるエネルギーの約75％が無駄になっており、その大きな要因の一つが、建物の断熱不足に伴う「エネルギー損失」だそうです。\n\n従来、既存の「断熱材」で高い性能を得るには素材を厚くする必要がありましたが、20年の研究成果として、「超断熱材料」の「TIISA」と、その「TIISA」を含んだ世界初の「超断熱塗料」を開発されたそうで、わずか2〜3ミリの薄さでも1300℃の炎を遮断することができるようになったそうです。\n\n実際に、「超断熱塗料」を手に塗って、バーナーで火をあてる動画も拝見し、断熱・遮炎の効果を目の当たりにすることができました。\nデモンストレーションとして、私自らが、「超断熱塗料」と既存の「断熱塗料」をそれぞれ塗布した金属板を熱したものに触れ、効果の違いを体感しました。\n\nこの塗料は、市販のものと比べ約2.5倍の断熱性能を持つため、夏は涼しく、冬は暖かい、快適な室内環境を保つことができるそうで、エアコンだけでは十分な冷却効果が得られなかった施設に、実際に導入した結果、屋根と外壁に施工することで電気代を約６割削減できたとのことです。\n\n実際に、説明された方ご自身も、国連の事業の一環として、今年4月にウクライナを訪問され、キーウの暖房が機能しない子ども病院で塗装を行い、室内外の温度差を6.6℃改善することができたとされていました。\n\nまた、この断熱塗料は、液体水素の輸送に必要な-253℃の低温領域にも対応でき、「水素社会の実現」にも貢献できると伺いました。\n\n省エネルギーだけでなく、災害や厳しい環境の下で暮らす人々の命を守る技術として大いに期待しております。\n\n（株）Thermalytica のリンク先：　https://t.co/eiyQGYIFrk"}}},"rest_id":"2104884611381858369","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"157648","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104884611381858369","sortIndex":"2104962532409081838"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3007081,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":558,"tweets":1825},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104883973394735527"],"editable_until_msecs":"1790682020000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":35,"bookmarked":false,"conversation_id_str":"2104883973394735527","created_at":"Tue Sep 29 10:40:20 +0000 2026","display_text_range":[0,117],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/fIRS6Kmwfb","expanded_url":"https://x.com/takaichi_sanae/status/2104883973394735527/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2104883934907756544","indices":[118,141],"media_key":"3_2104883934907756544","media_results":{"result":{"media_key":"3_2104883934907756544"}},"media_url_https":"https://pbs.twimg.com/media/HTYMyWGacAA8Gp4.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/fIRS6Kmwfb"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/fIRS6Kmwfb","expanded_url":"https://x.com/takaichi_sanae/status/2104883973394735527/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2104883934907756544","indices":[118,141],"media_key":"3_2104883934907756544","media_results":{"result":{"media_key":"3_2104883934907756544"}},"media_url_https":"https://pbs.twimg.com/media/HTYMyWGacAA8Gp4.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/fIRS6Kmwfb"}]},"favorite_count":4034,"favorited":false,"full_text":"昨日、「横浜グリーンエクスポ」の関係者の皆様が官邸にお越しになり、3つの最先端の「グリーン技術」をご披露頂いたことを報告しましたが、それぞれについて、詳しくご紹介いたします。\n\n＜“土に還る” 公式ボランティア・スタッフユニフォーム＞ https://t.co/fIRS6Kmwfb","id_str":"2104883973394735527","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":32,"reply_count":123,"retweet_count":456,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"pieclex.com","expanded_url":"https://pieclex.com/","indices":[939,962],"url":"https://t.co/8I4TaVMPle"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ4ODM5NzMyMjY5NzkzMjg=","richtext":{"richtext_tags":[]},"text":"昨日、「横浜グリーンエクスポ」の関係者の皆様が官邸にお越しになり、3つの最先端の「グリーン技術」をご披露頂いたことを報告しましたが、それぞれについて、詳しくご紹介いたします。\n\n＜“土に還る” 公式ボランティア・スタッフユニフォーム＞\n\n1つ目は、「横浜グリーンエクスポ」の公式ボランティア・スタッフユニフォームに使用される、高機能でありながらも環境に良い「着るグリーンテック」です。\n\n開発された（株）ピエクレックスの玉倉大次代表取締役社長に、実際にユニフォームを着用いただきながらご説明いただきました。\n\n元になる素材は、トウモロコシ由来で、微生物の働きにより水や二酸化炭素などのレベルにまで分解される「生分解性」を持つ「ポリ乳酸繊維」で、植物が持つ力を活かし、世界初の「2つの機能」を実現されているそうです。\n\n1つは、「圧電技術」といい、動くことで発生する微弱な電気の力を用いて、薬剤を使わずに「菌の増殖を抑える」技術、もう1つは繊維自体から肌に優しい「乳酸を滲み出させる」技術だそうです。\n\nまた、一般的なアパレル製品は、繊維以外に、ボタン、ファスナーなど、さまざまな部材からできており、循環が容易ではないそうですが、こうした課題を解決するため、多くの企業・団体の方々と連携され、｢生分解性素材｣の利用促進、分解できないファスナーなどの「部材を取り外しやすい製品」の設計、製品回収、堆肥化まで責任を持つ仕組みを構築されているとのこと。\n\nこの「着るグリーンテック」は、横浜グリーンエクスポの1万人以上のボランティアスタッフらが着用するユニフォームで活用されることが決まっており、来場者の方に、「循環型社会」実現への取組が、楽しいものであることを感じてもらいたいとのことでした。\n\nデモンストレーションでは、使い終わった製品が堆肥になり、土へ還り、そこから植物が育っている様子もご披露いただきました。\n早ければおおよそ3か月、遅くとも1年半程度で、見えなくなるまで分解されるそうです。\n\n横浜グリーンエクスポを機に、多くの方々の協力を得て、日本、そして世界に、こうした技術による「循環型社会」実現への取組を広げていければと思います。\n\n（株）ピエクレックスのリンク先：　https://t.co/8I4TaVMPle"}}},"rest_id":"2104883973394735527","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"153309","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104883973394735527","sortIndex":"2104962532409081837"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2104596613293621248/-yOuy4HG?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_val