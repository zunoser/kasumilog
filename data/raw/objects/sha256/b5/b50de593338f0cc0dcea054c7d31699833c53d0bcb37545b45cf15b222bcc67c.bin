5","expanded_url":"https://x.com/MofaJapan_jp/status/2104799580353405013/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":42,"w":42,"x":43,"y":813}]},"medium":{"faces":[{"h":42,"w":42,"x":43,"y":813}]},"orig":{"faces":[{"h":42,"w":42,"x":43,"y":813}]},"small":{"faces":[{"h":23,"w":23,"x":24,"y":460}]}},"id_str":"2104799569020395520","indices":[137,160],"media_key":"3_2104799569020395520","media_results":{"result":{"media_key":"3_2104799569020395520"}},"media_url_https":"https://pbs.twimg.com/media/HTXADmrbIAAsIW6.jpg","original_info":{"focus_rects":[{"h":448,"w":800,"x":0,"y":406},{"h":800,"w":800,"x":0,"y":230},{"h":912,"w":800,"x":0,"y":174},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":800,"x":0,"y":0}],"height":1200,"width":800},"sizes":{"large":{"h":1200,"resize":"fit","w":800},"medium":{"h":1200,"resize":"fit","w":800},"small":{"h":680,"resize":"fit","w":453},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0CyrJ2SVV5"}]},"favorite_count":57,"favorited":false,"full_text":"／\n📢外務省主催【知識を実践へ落とし込む！「ビジネスと人権」実務セミナー】を名古屋で開催します！\n＼\n💬社内で人権課題に取り組み始めたけど、社内の理解を得ながらどうやって進めればいいのか…\n💬海外の取引先から人権DDの取組の開示を求められたけど、どう対応したらいいだろう… https://t.co/0CyrJ2SVV5","id_str":"2104799580353405013","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":2,"retweet_count":12,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/fp/hr_ha…","expanded_url":"https://www.mofa.go.jp/mofaj/fp/hr_ha/page22_001608_00001.html","indices":[290,313],"url":"https://t.co/UdIyl7lWFR"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ3OTk1ODAyMjc1MDYxNzY=","richtext":{"richtext_tags":[]},"text":"／\n📢外務省主催【知識を実践へ落とし込む！「ビジネスと人権」実務セミナー】を名古屋で開催します！\n＼\n💬社内で人権課題に取り組み始めたけど、社内の理解を得ながらどうやって進めればいいのか…\n💬海外の取引先から人権DDの取組の開示を求められたけど、どう対応したらいいだろう…\n✅そんなお悩みを持つ企業様向けに、外務省主催で、企業の人権対応を他社のリアルな取組事例から学ぶセミナーを名古屋にてハイブリッド形式で開催します。ビジネスと人権に取り組み始めたばかりの企業様や、取組方に悩んでいる企業様は、ぜひ御参加ください！\n●開催日：2026年10月29日(木)於:名古屋　\n●申込方法：https://t.co/UdIyl7lWFR\n●対面・オンラインのハイブリッド開催"}}},"rest_id":"2104799580353405013","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"10670","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104799580353405013","sortIndex":"2104962532409081786"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/CLAtFxhB3T"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1153541724804792320/1IxAaRLZ_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Tue Dec 09 09:21:37 +0000 2014","name":"気象庁","screen_name":"JMA_kishou"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTIzNjU4MDEy","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"気象庁 (JMA:Japan Meteorological Agency) 公式アカウントです。報道発表やイベント案内などをお届けします。\n警報などの防災気象情報は気象庁ホームページをご覧ください。\n※運用ポリシー：https://t.co/v07vjnVmr5","entities":{"description":{"urls":[{"display_url":"jma.go.jp/jma/menu/socia…","expanded_url":"https://www.jma.go.jp/jma/menu/social_info.html","indices":[108,131],