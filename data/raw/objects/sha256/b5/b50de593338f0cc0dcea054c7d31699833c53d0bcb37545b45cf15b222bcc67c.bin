ationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":94,"tweets":394},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2104836065106461005"],"editable_until_msecs":"1790670598000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":6,"bookmarked":false,"conversation_id_str":"2104836065106461005","created_at":"Tue Sep 29 07:29:58 +0000 2026","display_text_range":[0,139],"entities":{},"favorite_count":356,"favorited":false,"full_text":"【9月29日　小泉防衛大臣会見】\n \n冒頭、インドネシア共和国における国際緊急援助活動の終結、日モンゴル防衛相会談の実施について発表しました。\n \nその他、\n○台風25号対応\n○三文書の改定\n○普天間飛行場代替施設建設事業等の経費\n○タイフォンとハイマースの嘉手納飛行場での保管","id_str":"2104836065106461005","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":15,"retweet_count":65,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/QgYgtGTBolM?si…","expanded_url":"https://youtu.be/QgYgtGTBolM?si=QVOPqj3Fvvlnul0s","indices":[1504,1527],"url":"https://t.co/zzYOEL9WyX"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ4MzYwNjQ5MDUyMTYwMDA=","text":"【9月29日　小泉防衛大臣会見】\n \n冒頭、インドネシア共和国における国際緊急援助活動の終結、日モンゴル防衛相会談の実施について発表しました。\n \nその他、\n○台風25号対応\n○三文書の改定\n○普天間飛行場代替施設建設事業等の経費\n○タイフォンとハイマースの嘉手納飛行場での保管\n○日米共同統合演習「キーン・ソード」\n○健軍駐屯地での装備品展示\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「今日は２点あります。まず、１点目はインドネシアにおける国際緊急援助活動の終結についてです。インドネシア共和国における山林火災に対する国際緊急援助活動について、インドネシア政府との協議の結果を踏まえ、本日、私から統合作戦司令官に対し、その終結を命じました。本日計画している消火活動をもって、部隊は現地での活動を終了し、陸上自衛隊のＣＨ－４７輸送ヘリコプター３機を搭載した、海上自衛隊輸送艦「くにさき」は、準備が整い次第、本邦へ帰国する予定です。今回の派遣に当たっては、インドネシアとの平素からの友好関係、とりわけ、私とシャフリィ国防大臣をはじめとする両国国防当局の間で培ってきた信頼関係が、その基盤となりました。私自身、シャフリィ大臣から自衛隊による協力を検討してほしいとの連絡を直接受け、派遣後も、現地の状況や自衛隊の活動について緊密に意思疎通を続けてきました。今般の活動では、ＣＨ－４７輸送ヘリコプター３機により、昨日までに４０回以上の消火活動を実施し、約２２０トンの水を放水しました。シャフリィ大臣からは、現地で任務に当たる隊員に対する感謝と敬意が繰り返し伝えられています。また、自衛隊の活動に対するインドネシア国防省からの高い評価の表れとして、現地で任務に当たった隊員に対する表彰も予定をされています。私も、厳しい環境の中で任務を遂行した隊員の皆さんを、心から誇りに思います。また、自衛隊に寄せられた感謝や信頼は、国防当局間にとどまるものではありません。派遣された隊員からは、現地の方々から、一緒に写真を撮ってほしい、握手をしてほしい、そんな声を掛けられるなど、温かくインドネシアの皆さんに迎えられ、自衛隊に対する親しみや信頼を強く感じたという報告を受けています。今般の活動は、一人一人の隊員の献身と、それを支えた両国の国防当局間の強固な協力関係によって、着実に遂行することができました。防衛省・自衛隊としては、今回培われた信頼を礎として、インドネシアとの防衛協力を一層深めていきたいと思います。そして、今後とも、国際社会の一員として、人道的観点から必要な支援に積極的に取り組んでまいります。\n \nそして、２点目ですが、日本・モンゴル防衛大臣会談の実施についてです。明日９月３０日、モンゴルのダンバ・バトロト国防大臣が来日し、防衛省において、２０２４年２月以来となる日本・モンゴル防衛相会談を実施する予定です。モンゴルは、ロシアと中国に挟まれた戦略的要衝に位置し、自由、民主主義、法の支配といった価値や原則を共有する、平和と繁栄のための特別な戦略的パートナーであります。今回、バトロト大臣と初めて会談できることを大変うれしく思います。モンゴルとのこれまでの協力は、能力構築支援、部隊による相互訪問、陸自・空自の「カーンクエスト２６」への参加などがあります。今回の会談では、日・モンゴル防衛協力・交流の進展に向け、率直かつ具体的な議論を行いたいと考えています。また、この機会を通じて、バトロト大臣との信頼関係を深めていきたいと考えています。冒頭、今日は２点で以上です。」\n \n↓動画はこちら\n https://t.co/zzYOEL9WyX"}}},"rest_id":"2104836065106461005","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"27077","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2104837465513316669","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4233","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104837465513316669","sortIndex":"2104962532409081809"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{