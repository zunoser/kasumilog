,"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府の公式アカウントです。内閣府大臣官房政策評価広報課が運営しています。運営方針 https://t.co/LtXxYQ4rJW を御確認のうえ御利用ください。問い合わせは https://t.co/ANlK6wet0H","entities":{"description":{"urls":[{"display_url":"cao.go.jp/others/seihyou…","expanded_url":"https://www.cao.go.jp/others/seihyou/sns/x.html","indices":[42,65],"url":"https://t.co/LtXxYQ4rJW"},{"display_url":"cao.go.jp/goiken.html","expanded_url":"https://www.cao.go.jp/goiken.html","indices":[88,111],"url":"https://t.co/ANlK6wet0H"}]},"url":{"urls":[{"display_url":"cao.go.jp","expanded_url":"https://www.cao.go.jp/","indices":[0,23],"url":"https://t.co/8tRrZ0eypt"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":138144,"following":63},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2904127170","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1805,"tweets":9898},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/8tRrZ0eypt"}}}},"edit_control":{"edit_tweet_ids":["2104816454159970403"],"editable_until_msecs":"1790665922000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2104816454159970403","created_at":"Tue Sep 29 06:12:02 +0000 2026","display_text_range":[0,159],"entities":{"hashtags":[{"indices":[114,121],"text":"高齢社会対策"},{"indices":[122,128],"text":"多世代交流"}],"media":[{"display_url":"pic.x.com/F1HVOTU5Pv","expanded_url":"https://x.com/cao_japan/status/2104816454159970403/photo/1","ext_alt_text":"令和8年度「高齢社会フォーラム」の告知ポスター。\n\nキャッチコピーは「つながり、支え合い、愉しく暮らす ～多世代交流が生むウェルビーイングなまち～」。若者から高齢者まで幅広い世代が互いに支え合い、生きがいを持って生活できる地域社会のあり方を議論するフォーラム。\n\n【開催日時】令和8年10月28日（水）13:00～16:30（開場12:30）\n【会場】札幌エルプラザ3階（〒060-0808 北海道札幌市北区北8条西3丁目28）。JR札幌駅北口より徒歩3分、札幌市営地下鉄さっぽろ駅より徒歩7分、北12条駅より徒歩6分。\n【オンライン配信】YouTube Live（https://youtube.com/live/v1A8F6y3-LU?feature=share）で同時配信。\n\n【プログラム】12:30受付・開場、13:00開会、13:05内閣府による行政施策説明、13:20基調講演、13:50休憩、14:00パネルディスカッション、15:30休憩、15:45事例紹介、16:25閉会。\n\n【基調講演】大正大学地域創生学部教授・東京大学名誉教授　まきのあつし氏。演題「社会に『信任』をつくる ―人生100年時代の多世代交流と『ふるさと』づくり―」。\n\n【パネルディスカッション登壇者】株式会社ノビシロ代表取締役CEO あゆかわさよ氏、芝の家＆ご近所ラボ新橋 かとうりょうこ氏、一般社団法人ユアセル代表理事 たかはしともみ氏、やぶきとしお氏。\n\n【参加方法】WEBフォーム（https://forms.gle/aMVxc8zAnjuSkiNFA）又はQRコードから申込（当日参加も可能）。\n【主催】内閣府／札幌市。\n【問い合わせ】高齢社会フォーラム事務局 TEL:050-3122-3665（平日9-18時）、Mail:forum-info@olive.style\n\n水彩画で描かれた川と橋、高層ビル群、遊歩道を歩く多世代の人々のイラストが上部に配置されている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":79,"w":79,"x":651,"y":1454},{"h":79,"w":79,"x":869,"y":1455},{"h":85,"w":85,"x":1079,"y":1448},{"h":89,"w":89,"x":1297,"y":1437},{"h":111,"w":111,"x":1247,"y":994}]},"medium":{"faces":[{"h":46,"w":46,"x":381,"y":851},{"h":46,"w":46,"x":509,"y":852},{"h":50,"w":50,"x":632,"y":848},{"h":52,"w":52,"x":760,"y":842},{"h":65,"w":65,"x":730,"y":582}]},"orig":{"faces":[{"h":94,"w":94,"x":766,"y":1710},{"h":94,"w":94,"x":1023,"y":1712},{"h":101,"w":101,"x":1270,"y":1703},{"h":105,"w":105,"x":1526,"y":1691},{"h":131,"w":131,"x":1467,"y":1169}]},"small":{"faces":[{"h":26,"w":26,"x":216,"y":482},