ype":"video/mp4","url":"https://video.twimg.com/amplify_video/2097876408643334144/vid/avc1/1280x720/Mh_bKDHdXZVPUI43.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2097876408643334144/vid/avc1/1920x1080/GjFuJ8sRiqpWsjTU.mp4?tag=29"},{"bitrate":25128000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2097876408643334144/vid/avc1/3840x2160/PbGuPu3tg35vMMSD.mp4?tag=29"}]}}]},"favorite_count":718,"favorited":false,"full_text":"9月10日、インドネシア共和国において国際緊急援助活動を実施するため、陸上自衛隊CH-47ヘリコプターを搭載した海上自衛隊輸送艦「くにさき」がインドネシアのキジン港に入港しました。CH-47ヘリコプターは、準備が整い次第、消火活動を実施する予定です。 https://t.co/cwNLSz3Tv8","id_str":"2097876546161906013","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":12,"retweet_count":182,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTc4NzY1NDYxMTE2MDI2ODg=","text":"9月10日、インドネシア共和国において国際緊急援助活動を実施するため、陸上自衛隊CH-47ヘリコプターを搭載した海上自衛隊輸送艦「くにさき」がインドネシアのキジン港に入港しました。CH-47ヘリコプターは、準備が整い次第、消火活動を実施する予定です。\n\n防衛省・自衛隊は、インドネシア共和国国防省と緊密に連携し、被害の拡大防止に向けて全力で取り組んでまいります。"}}},"rest_id":"2097876546161906013","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"31029","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2097910518537781259-tweet-2097879455469613333","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":