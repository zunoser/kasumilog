se,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":3,"retweet_count":19,"retweeted":false,"user_id_str":"303730149"},"rest_id":"2114723602499281194","unmention_data":{},"views":{"count":"9685","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114723602499281194","sortIndex":"2114946715780906967"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3071107,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":597,"tweets":1902},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2114712978377572550"],"editable_until_msecs":"1793025438000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":297,"bookmarked":false,"conversation_id_str":"2114712978377572550","created_at":"Mon Oct 26 13:37:18 +0000 2026","display_text_range":[0,113],"entities":{"user_mentions":[{"id_str":"2670726740","indices":[29,41],"name":"Lula","screen_name":"LulaOficial"}]},"favorite_count":12328,"favorited":false,"full_text":"ブラジル選挙管理当局の発表を受け、ルーラ・ブラジル大統領（@LulaOficial）の再選に、心から祝意を表します。\n \nルーラ大統領が、その力強いリーダーシップで、ブラジルをこれからも導いていかれることを、期待申し上げます。","id_str":"2114712978377572550","is_quote_status":false,"lang":"ja","quote_count":233,"reply_count":1161,"retweet_count":1368,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"2670726740","indices":[29,41],"name":"Lula","screen_name":"LulaOficial"}]},"id":"Tm90ZVR3ZWV0OjIxMTQ3MTI5NzgyODUzNDI3MjA=","text":"ブラジル選挙管理当局の発表を受け、ルーラ・ブラジル大統領（@LulaOficial）の再選に、心から祝意を表します。\n \nルーラ大統領が、その力強いリーダーシップで、ブラジルをこれからも導いていかれることを、期待申し上げます。\n \n日メルコスールEPA交渉の推進をはじめ、共に日本とブラジルの「戦略的グローバル・パートナーシップ」を幅広い分野で更に深化させていくことを、楽しみにしています。\n \nTendo a confirmação pelo TSE, apresento as minhas sinceras felicitações ao Presidente Lula pela sua reeleição como Presidente do Brasil.\n \nEspero que o Presidente Lula lidere o Brasil com a sua forte liderança.\n \nEstou ansiosa para trabalhar com o Presidente para aprofundar ainda mais a \"Parceria Estratégica e Global\" entre o Japão e o Brasil numa ampla gama de áreas, incluindo a promoção das negociações do Acordo de Parceria Econômica (EPA) Japão-Mercosul."}}},"rest_id":"2114712978377572550","unmention_data":{},"views":{"count":"953010","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114712978377572550","sortIndex":"2114946715780906966"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kan