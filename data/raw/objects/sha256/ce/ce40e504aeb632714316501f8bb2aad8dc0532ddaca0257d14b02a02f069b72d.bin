:{"faces":[{"h":28,"w":28,"x":295,"y":278},{"h":42,"w":42,"x":112,"y":21},{"h":39,"w":39,"x":313,"y":185}]}},"id_str":"2114668833449631744","indices":[93,116],"media_key":"3_2114668833449631744","media_results":{"result":{"media_key":"3_2114668833449631744"}},"media_url_https":"https://pbs.twimg.com/media/HVjQGZta4AAYDy-.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OhF61aLCOi"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/OhF61aLCOi","expanded_url":"https://x.com/takaichi_sanae/status/2114668906699010482/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2114668833445482496","indices":[93,116],"media_key":"3_2114668833445482496","media_results":{"result":{"media_key":"3_2114668833445482496"}},"media_url_https":"https://pbs.twimg.com/media/HVjQGZsbkAAfLUR.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1612,"w":1612,"x":429,"y":0},{"h":1612,"w":1414,"x":528,"y":0},{"h":1612,"w":806,"x":832,"y":0},{"h":1612,"w":2600,"x":0,"y":0}],"height":1612,"width":2600},"sizes":{"large":{"h":1270,"resize":"fit","w":2048},"medium":{"h":744,"resize":"fit","w":1200},"small":{"h":422,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OhF61aLCOi"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/OhF61aLCOi","expanded_url":"https://x.com/takaichi_sanae/status/2114668906699010482/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":85,"w":85,"x":889,"y":839},{"h":127,"w":127,"x":337,"y":63},{"h":119,"w":119,"x":943,"y":559}]},"medium":{"faces":[{"h":50,"w":50,"x":521,"y":492},{"h":74,"w":74,"x":198,"y":37},{"h":70,"w":70,"x":552,"y":327}]},"orig":{"faces":[{"h":109,"w":109,"x":1129,"y":1066},{"h":162,"w":162,"x":429,"y":81},{"h":152,"w":152,"x":1198,"y":710}]},"small":{"faces":[{"h":28,"w":28,"x":295,"y":278},{"h":42,"w":42,"x":112,"y":21},{"h":39,"w":39,"x":313,"y":185}]}},"id_str":"2114668833449631744","indices":[93,116],"media_key":"3_2114668833449631744","media_results":{"result":{"media_key":"3_2114668833449631744"}},"media_url_https":"https://pbs.twimg.com/media/HVjQGZta4AAYDy-.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OhF61aLCOi"}]},"favorite_count":22128,"favorited":false,"full_text":"本日18時から、「サイバーセキュリティに関する関係閣僚会議」を開催しました。\n\n我が国の企業などに対する相次ぐサイバー攻撃によって、大規模な「情報漏えい被害」などが多数、生じています。 https://t.co/OhF61aLCOi","id_str":"2114668906699010482","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":420,"reply_count":1316,"retweet_count":3028,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ2Njg5MDY1ODU2NjU1MzY=","richtext":{"richtext_tags":[]},"text":"本日18時から、「サイバーセキュリティに関する関係閣僚会議」を開催しました。\n\n我が国の企業などに対する相次ぐサイバー攻撃によって、大規模な「情報漏えい被害」などが多数、生じています。\n\n漏えいした情報を悪用した二次被害への不安が高まるなど、深刻な事態となっており、早急に対策を強化する必要があります。\n各大臣には、必要な対策について、財政措置を含め早急に検討・調整を進め、来週中を目途に、政府としての『緊急対策パッケージ』を取りまとめるよう、指示をしました。\n\n＜被害企業などに対する支援の強化＞\n\n「被害企業などへの支援」については、IPA（独立行政法人情報処理推進機構）や警察の相談対応を充実させ、民間機関や地方自治体との連携も強化し、どこに相談しても必要なサポートを得られる体制を整える必要があります。\n\nまた、国家サイバー統括室には、経済産業省の協力も得て、初動から復旧まで「民間の高度な専門能力を活用するための仕組み」の構築を進めるよう、指示をしました。\n\n赤沢経済産業大臣には、「サイバーセキュリティお助け隊」を中小企業や小規模事業者が、十分に活用できるよう、体制や支援策の拡充を速やかに検討するよう、指示をしました。\n\n＜情報集約体制の強化・的確な情報発信＞\n\n「情報収集体制、捜査・分析調査体制の強化」と「的確な情報発信」も重要です。\n\n古川サイバー安全保障担当大臣には、サイバー協議会へのセキュリティベンダー企業などの参加拡大を促すなどして、情報収集力を高めるよう、指示をしました。\nまた、各大臣には、基幹インフラ・重要インフラに限らず、所管業界の被害企業から迅速に情報を収集し、国家サイバー統括室への情報集約を徹底するよう、指示をしました。\n\nその上で、国家サイバー統括室では、集約した情報を分析し、想定される脅威やリスクに応じて、経営層、専門家、国民の皆様向けなど、対象を明確にした情報発信を強化してまいります。\n\nまた、赤沢大臣には、中小企業や小規模事業者に対して、「相談窓口」の抜本的な拡充をはじめ、プッシュ型での情報提供を行うよう、指示をしました。\n\n＜「アクセス・無害化措置」などの対処オプションの戦略的な実施＞\n\n実態を解明したサイバー攻撃に対しては、「アクセス・無害化措置」も含め、あらゆる対処オプションを戦略的に選択し、実行します。\n\n古川大臣の調整の下、同盟国・同志国や海外の関係機関とも緊密に連携して、攻撃主体の特定など国際社会と一体となった取組を進めてまいります。\n\n＜システムの脆弱性の検証＞\n\n被害を未然に防ぐためには、「システムの脆弱性の検証」も重要です。\n\n赤沢大臣には、IPAの知見・人材を活用して、高性能AIも活用しながら、システムの脆弱性を見つけるトップガン人材が「模擬的な攻撃テスト」を行うことで、システムの脆弱性を発見し、対策を講じる取組と、サプライチェーン全体でサイバー攻撃の観測網を整備し、中小企業を含めた迅速な対策につなげる取組を、前倒しで実施するよう、指示をしました。\nまた、古川大臣には、こうした取組を横展開するための方策を検討するよう、指示をしました。\n\nまた、政府自身のシステムについても、サイバーセキュリティの確保が不可欠です。\n各大臣には、古川大臣を中心に、AISIの知見も活用しながら、「高性能AIを用いた脆弱性チェック」を前倒しで実施し、担当する府省庁のシステムの安全確保を改めて徹底するよう、指示をしました。\n\n政府の総力を結集し、取組を加速してまいります。"}}},"rest_id":"2114668906699010482","unmention_data":{},"views":{"count":"1192660","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114668906699010482","sortIndex":"2114946715780906962"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1769277,"following":47},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8348,"tweets":23457},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2114661503043543509"],"editable_until_msecs":"1793013165000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":52,"bookmarked":false,"conversation_id_str":"2114661503043543509","created_at":"Mon Oct 26 10:12:45 +0000 2026","display_text_range":[0,71],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/3MhyITDfjf","expanded_url":"https://x.com/kantei/status/2114661503043543509/video/1","ext_media_availability":{"status":"Available"},"id_str":"2114661005972418560","indices":[72,95],"media_key":"13_2114661005972418560","media_results":{"result":{"media_key":"13_2114661005972418560"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2114661005972418560/img/zfxwCq3l7ep2fThv.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/3MhyITDfjf","video_info":{"aspect_ratio":[16,9],"duration_millis":103400,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2114661005972418560/pl/tvXPgfp-Pubfm7dl.m3u8?tag=29&v=481"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114661005972418560/vid/avc1/480x270/7C79W7Th14nX5TAO.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114661005972418560/vid/avc1/640x360/jxDU6gxqtwlY5ez5.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114661005972418560/vid/avc1/1280x720/7rxJ0oQq6pGicBFL.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/3MhyITDfjf","expanded_url":"https://x.com/kantei/status/2114661503043543509/video/1","ext_media_availability":{"status":"Available"},"id_str":"2114661005972418560","indices":[72,95],"media_key":"13_2114661005972418560","media_results":{"result":{"media_key":"13_2114661005972418560"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2114661005972418560/img/zfxwCq3l7ep2fThv.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/3MhyITDfjf","video_info":{"aspect_ratio":[16,9],"duration_millis":103400,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2114661005972418560/pl/tvXPgfp-Pubfm7dl.m3u8?tag=29&v=481"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114661005972418560/vid/avc1/480x270/7C79W7Th14nX5TAO.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114661005972418560/vid/avc1/640x360/jxDU6gxqtwlY5ez5.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2114661005972418560/vid/avc1/1280x720/7rxJ0oQq6pGicBFL.mp4?tag=29"}]}}]},"favorite_count":2633,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２６日）、高市総理は、福田元内閣総理大臣の逝去についてのぶらさがり会見を行いました。\n \n※要旨（速報版）\n（記者） https://t.co/3MhyITDfjf","id_str":"2114661503043543509","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":31,"reply_count":123,"retweet_count":340,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ2NjE1MDI5ODQ4OTY1MTI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２６日）、高市総理は、福田元内閣総理大臣の逝去についてのぶらさがり会見を行いました。\n \n※要旨（速報版）\n（記者）\n　第９１代内閣総理大臣を務めた福田康夫氏がお亡くなりになられました。ご功績も踏まえて、ご逝去をどのように受け止めていらっしゃるか教えてください。\n\n（高市総理）\n　今程、ご遺族のもとにお伺いをし、福田康夫元総理にお別れをしてまいりました。 \n　悲しみの念を禁じ得ません。 \n　福田康夫元総理は、内閣総理大臣として国政を担われました。\n　そしてまた、長らく内閣官房長官としても活躍をされまして、その豊かな経験と、また卓越した識見のもと、本当に困難な課題に直面しながらも、１つ１つ力を尽くして取組みを続けてこられました。\n　内閣総理大臣としては、特に、消費者行政に力を入れられ、国民の皆様の安心を作るために頑張ってくださいました。 \n　また、北海道洞爺湖サミットの議長として国際社会の諸課題に取り組むとともに、我が国の存在感を大きく世界に発信をしてくださいました。 \n　その偉大なご功績を偲びつつ、改めまして、謹んで哀悼の誠を捧げさせていただきます。"}}},"rest_id":"2114661503043543509","unmention_data":{},"views":{"count":"181457","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114661503043543509","sortIndex":"2114946715780906961"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2112876624563822900"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profil