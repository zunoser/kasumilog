トリア・ナショナルデー・レセプションに出席し、外務省を代表して挨拶を行いました。生稲政務官は、近年の自治体間交流や企業間協力、先般の日オーストリア外相会談に触れ、文化、経済、外交の三分野を中心に、二国間関係が多層的に強化されている旨紹介 https://t.co/teHqRmlx3R","id_str":"2114627227505873003","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":12,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/erp/erp_…","expanded_url":"https://www.mofa.go.jp/mofaj/erp/erp_2/at/pageit_000001_03274.html","indices":[177,200],"url":"https://t.co/ywEZTCaZ06"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ2MjcyMjczODg0NDA1NzY=","richtext":{"richtext_tags":[]},"text":"生稲外務大臣政務官は、都内で開催されたオーストリア・ナショナルデー・レセプションに出席し、外務省を代表して挨拶を行いました。生稲政務官は、近年の自治体間交流や企業間協力、先般の日オーストリア外相会談に触れ、文化、経済、外交の三分野を中心に、二国間関係が多層的に強化されている旨紹介し、二国間・国際場裏の双方における引き続きの連携への期待を述べました。\n\nhttps://t.co/ywEZTCaZ06"}}},"rest_id":"2114627227505873003","unmention_data":{},"views":{"count":"5757","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114627227505873003","sortIndex":"2114946715780906929"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_per