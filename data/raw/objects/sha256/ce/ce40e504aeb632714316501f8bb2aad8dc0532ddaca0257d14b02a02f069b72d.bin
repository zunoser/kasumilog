video/mp4","url":"https://video.twimg.com/amplify_video/2114677840813932544/vid/avc1/1280x720/FqfP058XPWetrH4S.mp4?tag=29"}]}}]},"favorite_count":5872,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２６日）、高市総理は、サイバーセキュリティに関する関係閣僚会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様です。我が国の企業などに対する相次ぐサイバー攻撃によって、大規模な「情報漏えい被害」などが多数、生じています。 https://t.co/NC4hjrhneh","id_str":"2114678730031600034","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":110,"reply_count":295,"retweet_count":1153,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ2Nzg3Mjk5MzkzMTI2NDA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２６日）、高市総理は、サイバーセキュリティに関する関係閣僚会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　お疲れ様です。我が国の企業などに対する相次ぐサイバー攻撃によって、大規模な「情報漏えい被害」などが多数、生じています。\n　漏えいした情報を悪用した二次被害への不安が高まるなど深刻な事態となっており、早急な対策を強化していく必要がございます。\n\n　「被害企業などへの支援」につきましては、ＩＰＡや警察の相談対応を充実させ、民間機関や地方自治体との連携も強化し、どこに相談しても必要なサポートを得られる体制を整えて下さい。\n　また、国家サイバー統括室は、経済産業省の協力も得て、初動から復旧までの「民間の高度な専門能力を活用するための仕組み」の構築を進めて下さい。\n　赤沢経済産業大臣は、「サイバーセキュリティお助け隊」を中小企業や小規模事業者が十分に活用できるよう、「体制や支援策の拡充」を速やかに検討して下さい。\n\n　「情報収集体制、捜査・分析調査体制の強化」と、「的確な情報発信」も重要です。\n　古川サイバー安全保障担当大臣は、「サイバー協議会」への「セキュリティベンダー企業などの参加拡大」を促すなどして、「情報収集力」を高めて下さい。\n　また、各大臣は、基幹インフラ・重要インフラに限らず、「所管業界の被害企業から迅速に情報を収集」して、「国家サイバー統括室への情報集約」を徹底して下さい。\n　その上で、国家サイバー統括室は、集約した情報を「分析」し、「想定される脅威やリスク」に応じて、経営層、専門家、国民の皆様向けなど、「対象を明確にした情報発信」を強化して下さい。\n　赤沢大臣は、中小企業や小規模事業者に対して、「相談窓口」の抜本的な拡充をはじめ、プッシュ型での情報提供を行って下さい。\n\n　実態を解明したサイバー攻撃に対しては、「アクセス・無害化措置」も含め、あらゆる「対処オプション」を戦略的に選択し、実行いたします。\n　古川大臣の調整の下、同盟国・同志国や海外の関係機関とも緊密に連携して、「攻撃主体の特定」など「国際社会と一体となった取組」を進めて下さい。\n\n　被害を未然に防ぐためには、「システムの脆弱性の検証」も重要です。\n　赤沢大臣は、ＩＰＡの知見・人材を活用して、\n・高性能ＡＩも活用しながら、システムの脆弱性を見つけるトップガン人材が「模擬的な攻撃テスト」を行うことで、システムの脆弱性を発見し、対策を講じる取組、\n・そして、サプライチェーン全体でサイバー攻撃の観測網を整備し、中小企業を含めた迅速な対策につなげる取組、\nを前倒しで実施して下さい。\n　古川大臣は、こうした取組を横展開するための方策を検討して下さい。\n　また、「政府自身のシステム」についても、サイバーセキュリティの確保は不可欠です。\n　各大臣は、古川大臣を中心に、ＡＩＳＩの知見も活用しながら、「高性能ＡＩを用いた脆弱性チェック」を前倒しで実施し、担当する府省庁の「システムの安全確保」を改めて徹底して下さい。 \n\n　来週中を目途に、政府としての『緊急対策パッケージ』を取りまとめます。\n　各大臣は、必要な対策について、財政措置を含め早急に検討・調整を進めて下さい。\n\n　とにかく、政府の総力を結集して、取組を加速してまいりましょう。以上です。"}}},"rest_id":"2114678730031600034","unmention_data":{},"views":{"count":"429010","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114678730031600034","sortIndex":"2114946715780906965"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2114552601970909634"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.ja