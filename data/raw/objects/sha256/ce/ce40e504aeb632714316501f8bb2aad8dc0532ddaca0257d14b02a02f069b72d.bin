l":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":591042,"following":204},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20384,"tweets":49141},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2114642163523019128"],"editable_until_msecs":"1793008554000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":5,"bookmarked":false,"conversation_id_str":"2114642163523019128","created_at":"Mon Oct 26 08:55:54 +0000 2026","display_text_range":[0,144],"entities":{},"favorite_count":54,"favorited":false,"full_text":"2027年は、日本とマレーシアの外交関係樹立70周年に当たります。両国は、この記念の年に、「互いを豊かに、共に創る」というテーマのもと、両国で各種交流事業を実施し、両国間の関係を更に発展させる契機とするため、日・マレーシア外交関係樹立70周年記念行事で活用するロゴマークを広く募集します。","id_str":"2114642163523019128","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":3,"retweet_count":16,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/s_sa/sea…","expanded_url":"https://www.mofa.go.jp/mofaj/s_sa/sea2/my/pagew_000001_00004.html","indices":[197,220],"url":"https://t.co/i7Ts9sjERW"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ2NDIxNjM0MDU1ODIzMzY=","richtext":{"richtext_tags":[]},"text":"2027年は、日本とマレーシアの外交関係樹立70周年に当たります。両国は、この記念の年に、「互いを豊かに、共に創る」というテーマのもと、両国で各種交流事業を実施し、両国間の関係を更に発展させる契機とするため、日・マレーシア外交関係樹立70周年記念行事で活用するロゴマークを広く募集します。多くの方々からの応募をお待ちしております。\n応募締切は11月10日、募集要項は以下のリンクをご覧ください。https://t.co/i7Ts9sjERW"}}},"rest_id":"2114642163523019128","unmention_data":{},"views":{"count":"7867","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114642163523019128","sortIndex":"2114946715780906942"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_descriptio