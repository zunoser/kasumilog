8/pl/3aflh_nqjRamTwdS.m3u8?tag=29"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/320x568/BYXDUMxIGMXS_LF3.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/480x852/miIX24a4j8zPx4KP.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/720x1280/HFyyyfk8W13NnBN4.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113512243963035648/vid/avc1/1080x1920/kF6g797IKwmv2yC6.mp4?tag=29"}]}}]},"favorite_count":1690,"favorited":false,"full_text":"【「#わたしの自衛隊記念日」募集！】\n\n防衛省・自衛隊では、毎年11月1日を「自衛隊記念日」としています。\n自衛隊記念日の前後では、隊員の士気高揚を図りつつ、自衛隊に対する国民の皆様からの御理解を深めていただくため、全国各地で行事やイベントなど様々な取組を行っています。 https://t.co/DXZzR7F8de","id_str":"2114552601970909634","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":14,"reply_count":20,"retweet_count":322,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[2,13],"text":"わたしの自衛隊記念日"},{"indices":[294,305],"text":"わたしの自衛隊記念日"},{"indices":[363,370],"text":"自衛隊記念日"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ1NTI2MDE5MjQ4MTY4OTY=","text":"【「#わたしの自衛隊記念日」募集！】\n\n防衛省・自衛隊では、毎年11月1日を「自衛隊記念日」としています。\n自衛隊記念日の前後では、隊員の士気高揚を図りつつ、自衛隊に対する国民の皆様からの御理解を深めていただくため、全国各地で行事やイベントなど様々な取組を行っています。\n \nしかし、「皆さんにとっての」自衛隊記念日はもっと他にもあるはず！\n \n災害派遣で見かけた自衛隊。\n航空祭で見たブルーインパルス。\n基地見学での思い出。\n家族や友人とのエピソード。\n \nこれまで自衛隊と関わったことがある方も、ない方も、\n「初めて自衛隊を知った日」\n「心に残っている出来事」\nなどがあれば、\n \n「#わたしの自衛隊記念日」というハッシュタグをつけてぜひ教えてください。\n \n一人ひとりの「あなたの自衛隊記念日」をお待ちしています！\n \n#自衛隊記念日"}}},"rest_id":"2114552601970909634","unmention_data":{},"views":{"count":"103094","state":"EnabledWithCount"}}},"rest_id":"2114560146496192715","unmention_data":{},"views":{"count":"24280","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2114622133133562065","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4841","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114622133133562065","sortIndex":"2114946715780906928"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2112627098561187842/aT7la0sq?format=png&name=2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":