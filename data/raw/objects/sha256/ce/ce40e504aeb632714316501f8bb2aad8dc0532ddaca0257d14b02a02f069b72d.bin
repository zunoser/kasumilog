cked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"10228272","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":16208,"tweets":61620},"verification":{"verified":false,"verified_type":"Business"},"website":{"url":"https://t.co/GIOK0JwagA"}}}]},"rest_id":"https://t.co/ud9zBxNNJn"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2114560146496192715"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39808,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":100,"tweets":451},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2114915535486177617"],"editable_until_msecs":"1793073731000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2114915535486177617","created_at":"Tue Oct 27 03:02:11 +0000 2026","display_text_range":[0,160],"entities":{},"favorite_count":124,"favorited":false,"full_text":"【10月27日　小泉防衛大臣会見】\n冒頭、第13回拡大ASEAN国防相会議（ADMMプラス）及び第10回日ASEAN防衛担当大臣会合への出席について発表しました。\n \nその他、\n○日フィンランド防衛相会談\n○第13回拡大ASEAN国防相会議（ADMMプラス）\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら","id_str":"2114915535486177617","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":3,"retweet_count":27,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/Eqfd5WohCak?si…","expanded_url":"https://youtu.be/Eqfd5WohCak?si=k4BwSdbQ7CMPYepy","indices":[839,862],"url":"https://t.co/ud9zBxNNJn"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ5MTU1MzUzNTE5MDYzMDQ=","text":"【10月27日　小泉防衛大臣会見】\n冒頭、第13回拡大ASEAN国防相会議（ADMMプラス）及び第10回日ASEAN防衛担当大臣会合への出席について発表しました。\n \nその他、\n○日フィンランド防衛相会談\n○第13回拡大ASEAN国防相会議（ADMMプラス）\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「今日は冒頭１件です。諸般の調整が整えば、明日１０月２８日から３０日までの間、フィリピンを訪問し、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス）及び第１０回日ＡＳＥＡＮ防衛担当大臣会合に出席する予定です。昨年に続いて２回目の参加となります。\n \nＡＳＥＡＮは、「自由で開かれたインド太平洋」の実現に不可欠なパートナーであり、地域の平和と繁栄を支える要です。ＡＤＭＭプラスは、ＡＳＥＡＮ各国を含む地域の国防大臣等と率直な意見交換ができる、大変重要な機会です。\n \n今回、私からは、全ての国が自らを守り、自らの未来を自ら選ぶことができる、そんな地域を実現をするという我が国の決意を明確に発信したいと考えています。そのためにも、ＡＳＥＡＮの一体性・中心性を尊重しながら、各国が困難な状況にも対応できる力を高め、地域全体の安定につなげていくことが重要です。\n \n具体的には、ＡＤＭＭプラスの取組を更に発展させ、各国が自らの国を守り、紛争を未然に防ぐ力を高めていくこと、また、危機に直面しても対話を続けることの重要性を訴えます。その上で、日本は地域の平和と安定のために積極的に貢献し、誠実で透明性の高いパートナーであり続けることを明確に伝えたいと思います。\n \nさらに、この機会を活用し、アメリカ、フィリピン、韓国をはじめとする各国とのバイ会談、そして、他にも現地でいろいろ出てくると思いますが、積極的に各国のカウンターパートとの信頼関係の下で、防衛協力の具体的な成果につなげるような会談の機会も持っていきたいと思います。冒頭は以上です。」\n \n↓動画はこちら\nhttps://t.co/ud9zBxNNJn"}}},"rest_id":"2114915535486177617","unmention_data":{},"views":{"count":"16586","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2114915853452116253","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"3068","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114915853452116253","sortIndex":"2114946715780906997"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":99},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/530187236663250944/sN73nkH6_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Thu Nov 06 01:42:29 +0000 2014","name":"警察庁","screen_name":"NPA_KOHO"},"dm_permissions":{"can_dm":true},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODkxNTE2ODA5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2-1-2"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2110898522811769281"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"警察庁公式アカウントです。\n\n発信する情報は「報道発表資料」「新着情報」を基本としています。当アカウントは発