)へ、国土交通大臣賞の表彰状を授与しました。\n以下のページで各受賞者の概要を紹介しています！ https://t.co/rUarTqP5pv","id_str":"2114658291641159983","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":8,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[45,48],"text":"3R"},{"indices":[49,54],"text":"資源循環"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"3r-suishinkyogikai.jp/commend/jissek…","expanded_url":"https://www.3r-suishinkyogikai.jp/commend/jisseki/jisseki_r08/","indices":[140,163],"url":"https://t.co/5o7hbsNiuO"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTQ2NTgyOTE1MjM2ODIzMDQ=","richtext":{"richtext_tags":[]},"text":"10月26日の「リデュース・リユース・リサイクル推進功労者等表彰式」に草間政務官が出席。\n#3R #資源循環 に率先して取り組み、継続的な活動を通じて顕著な実績を挙げられた受賞者(2社)へ、国土交通大臣賞の表彰状を授与しました。\n以下のページで各受賞者の概要を紹介しています！\n\nhttps://t.co/5o7hbsNiuO"}}},"rest_id":"2114658291641159983","unmention_data":{},"views":{"count":"5105","state":"EnabledWithCount"}}}}},"entryId":"tweet-2114658291641159983","sortIndex":"2114946715780906960"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_reque