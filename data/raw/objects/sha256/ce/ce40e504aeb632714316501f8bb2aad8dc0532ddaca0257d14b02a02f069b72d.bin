_to_user_id_str":"1312820383532294144","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":3,"retweeted":false,"user_id_str":"1312820383532294144"},"rest_id":"2114927902827713003","unmention_data":{},"views":{"count":"1895","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2114927897559634072","2114927902827713003"],"enableDeduplication":true}}},"entryId":"list-conversation-2114946715780907017","sortIndex":"2114946715780906999"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2114946715780907018-tweet-2114917703945437382","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":9},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"公正取