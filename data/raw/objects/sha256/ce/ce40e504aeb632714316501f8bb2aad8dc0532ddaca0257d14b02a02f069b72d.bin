annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2114601541093224573","created_at":"Mon Oct 26 06:14:29 +0000 2026","display_text_range":[0,157],"entities":{"hashtags":[{"indices":[83,86],"text":"食育"}],"urls":[{"display_url":"tfm.co.jp/manabiyori/","expanded_url":"https://www.tfm.co.jp/manabiyori/","indices":[134,157],"url":"https://t.co/B8EYQ1GRle"}]},"favorite_count":28,"favorited":false,"full_text":"10月25日（日）に放送された政府広報提供ラジオ番組\n「杉浦太陽・松井玲奈 日曜まなびより」のテーマは、\n\n大人もこどもも食育を！\n知っておきたいこれからの「食」\n\n#食育 についてお話しています。\n番組を聴き逃した方は、アーカイブでどうぞ🎧\n\nアーカイブはコチラ↓\nhttps://t.co/B8EYQ1GRle","id_str":"2114601541093224573","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"quoted_status_id_str":"2114574889508347919","quoted_status_permalink":{"display":"x.com/gov_online/sta…","expanded":"https://twitter.com/gov_online/status/2114574889508347919","url":"https://t.co/J8cl5pj0xb"},"reply_count":4,"retweet_count":4,"retweeted":false,"user_id_str":"2335919749"},"quoted_status_result":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2114574891949363200/-CbiHdaT?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"「食育基本法」が制定されてから20年がたち、私たちの食を取り巻く環境は大きく変化しました。そこで、今年（2026年）5月に法律が改正され、食育の目的が「日本の食を守るため」に広がりました。政府広報提供ラジオ「杉浦太陽・松井玲奈　日曜まなびより」では、食べ物を安定して手に入れるためには、生産や流通などのコストが価格に適切に反映される「合理的な価格形成」の重要性などについてご紹介します。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.gov-online.go.jp","type":"STRING"}},{"key":"thumbnail_imag