ersation_id_str":"2103855530632753294","created_at":"Sat Sep 26 14:33:41 +0000 2026","display_text_range":[0,23],"entities":{"urls":[{"display_url":"x.com/MofaJapan_en/s…","expanded_url":"https://x.com/MofaJapan_en/status/2103854954658279866","indices":[0,23],"url":"https://t.co/pBMLUeiWrl"}]},"favorite_count":24,"favorited":false,"full_text":"https://t.co/pBMLUeiWrl","id_str":"2103855534474772606","in_reply_to_screen_name":"MofaJapan_jp","in_reply_to_status_id_str":"2103855530632753294","in_reply_to_user_id_str":"303730149","is_quote_status":true,"lang":"zxx","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"quoted_status_id_str":"2103854954658279866","quoted_status_permalink":{"display":"x.com/MofaJapan_en/s…","expanded":"https://x.com/MofaJapan_en/status/2103854954658279866","url":"https://t.co/pBMLUeiWrl"},"reply_count":4,"retweet_count":5,"retweeted":false,"user_id_str":"303730149"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":51},"affiliates_highlighted_label":{"label":{"badge":{"url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_bigger.jpg"},"description":"外務省","url":{"url":"https://twitter.com/MofaJapan_jp","urlType":"DeepLink"},"userLabelDisplayType":"Badge","userLabelType":"BusinessLabel"}},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102640077467649/QaRdW4oU_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303735625/1782867162"},"core":{"created_at":"Mon May 23 10:32:05 +0000 2011","name":"MOFA of Japan","screen_name":"MofaJapan_en"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzU2MjU=","is_blue_verified":true,"location":{"location":"Tokyo"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2103406416824541536"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"The Official English Account of the Ministry of Foreign Affairs of Japan.\nSocial Media List: https://t.co/PnH9N7WcqL","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/about/list_en.…","expanded_url":"https://www.mofa.go.jp/about/list_en.html","indices":[93,116],"url":"https://t.co/PnH9N7WcqL"}]},"url":{"urls":[{"display_url":"mofa.go.jp","expanded_url":"http://www.mofa.go.jp/","indices":[0,23],"url":"https://t.co/jDWRcTicQE"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":153439,"following":179},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8639,"tweets":19580},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2103854954658279866"],"editable_until_msecs":"1790436683000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2103854954658279866","created_at":"Sat Sep 26 14:31:23 +0000 2026","display_text_range":[0,133],"entities":{"media":[{"display_url":"pic.x.com/cPFhmRTiss","expanded_url":"https://x.com/MofaJapan_en/status/2103854954658279866/photo/1","ext_alt_text":"1. Japan expresses deep concern over the deterioration of the situation in northern Ethiopia since September 23, condemns the military actions by the Tigray People’s Liberation Front (TPLF), including the take-over of airports in the region, and calls on all parties to immediately de-escalate and resolve the situation through dialogue.\n\n\n2. Japan considers that the compliance and implementation of the Pretoria Agreement signed in 2022 is essential and supports the African Union (AU)-led mediation process. Japan calls on all parties to refrain from actions that would further aggravate the situation, and calls for ensuring humanitarian access to affected populations.","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103854947922292736","indices":[134,157],"media_key":"3_2103854947922292736","media_results":{"result":{"media_key":"3_2103854947922292736"}},"media_url_https":"https://pbs.twimg.com/media/HTJk7a3bMAAK2YS.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":61},{"h":960,"w":960,"x":0,"y":0},{"h":1094,"w":960,"x":0,"y":0},{"h":1200,"w":600,"x":360,"y":0},{"h":1200,"w":960,"x":0,"y":0}],"height":1200,"width":960},"sizes":{"large":{"h":1200,"resize":"fit","w":960},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/cPFhmRTiss"}],"urls":[{"display_url":"mofa.go.jp/press/statemen…","expanded_url":"https://www.mofa.go.jp/press/statement/pageite_000001_01842.html","indices":[110,133],"url":"https://t.co/ciLF6luoDm"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/cPFhmRTiss","expanded_url":"https://x.com/MofaJapan_en/status/2103854954658279866/photo/1","ext_alt_text":"1. Japan expresses deep concern over the deterioration of the situation in northern Ethiopia since September 23, condemns the military actions by the Tigray People’s Liberation Front (TPLF), including the take-over of airports in the region, and calls on all parties to immediately de-escalate and resolve the situation through dialogue.\n\n\n2. Japan considers that the compliance an