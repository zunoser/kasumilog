on May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2103319939235160372"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":590529,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20218,"tweets":48917},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2104050597150519350"],"editable_until_msecs":"1790483328000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":103,"bookmarked":false,"conversation_id_str":"2104050597150519350","created_at":"Sun Sep 27 03:28:48 +0000 2026","display_text_range":[0,124],"entities":{},"favorite_count":6314,"favorited":false,"full_text":"高市総理大臣は、ドナルド・J・トランプ米国大統領と電話会談を行いました。 冒頭、トランプ大統領からは、今般の米中首脳会談について詳細に説明がありました。両首脳は、経済安全保障を含む経済や安全保障など、中国をめぐる諸課題を中心に意見交換を行いました。","id_str":"2104050597150519350","is_quote_status":false,"lang":"ja","quote_count":120,"reply_count":340,"retweet_count":862,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/na/na1/u…","expanded_url":"https://www.mofa.go.jp/mofaj/na/na1/us/pageit_000001_03230.html","indices":[187,210],"url":"https://t.co/tetccPNj88"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQwNTA1OTcwNDE0Mzg3MjA=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、ドナルド・J・トランプ米国大統領と電話会談を行いました。 冒頭、トランプ大統領からは、今般の米中首脳会談について詳細に説明がありました。両首脳は、経済安全保障を含む経済や安全保障など、中国をめぐる諸課題を中心に意見交換を行いました。\n\n両首脳は、揺るぎない日米同盟を改めて確認するとともに、共に地域そして世界の平和と安定に貢献していくことで一致しました。\n\nhttps://t.co/tetccPNj88"}}},"rest_id":"2104050597150519350","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"159814","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104050597150519350","sortIndex":"2104464893389307859"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.