":0},{"h":675,"w":592,"x":454,"y":0},{"h":675,"w":338,"x":581,"y":0},{"h":675,"w":1200,"x":0,"y":0}],"height":675,"width":1200},"sizes":{"large":{"h":675,"resize":"fit","w":1200},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/8SkNJn4lcS"}]},"favorite_count":411,"favorited":false,"full_text":"【#台風25号 被害に伴う対応】\n印旛沼の堤防の緊急復旧について、千葉県の要請に基づき技術的支援を実施しており、本日から堤防の復旧作業に着手しました。まずは、工事用道路を整備します。\n\n#チーム印旛沼 https://t.co/8SkNJn4lcS","id_str":"2103383785471668275","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":0,"retweet_count":130,"retweeted":false,"user_id_str":"714372536490852352"},"rest_id":"2103383785471668275","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"37564","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2103627611381678583","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"812","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103627611381678583","sortIndex":"2104464893389307833"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":52},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1697575938316529664/Iob6ICh3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/331514169/1655191913"},"core":{"created_at":"Fri 