jz636","expanded_url":"https://x.com/takaichi_sanae/status/2103726390269145103/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":119,"w":119,"x":1247,"y":171},{"h":173,"w":173,"x":55,"y":699}]},"medium":{"faces":[{"h":69,"w":69,"x":731,"y":100},{"h":101,"w":101,"x":32,"y":409}]},"orig":{"faces":[{"h":126,"w":126,"x":1320,"y":181},{"h":184,"w":184,"x":59,"y":740}]},"small":{"faces":[{"h":39,"w":39,"x":414,"y":56},{"h":57,"w":57,"x":18,"y":232}]}},"id_str":"2103726231879557120","indices":[54,77],"media_key":"3_2103726231879557120","media_results":{"result":{"media_key":"3_2103726231879557120"}},"media_url_https":"https://pbs.twimg.com/media/HTHv3KPaIAA-5YC.jpg","original_info":{"focus_rects":[{"h":840,"w":1500,"x":0,"y":1327},{"h":1500,"w":1500,"x":0,"y":667},{"h":1710,"w":1500,"x":0,"y":457},{"h":2167,"w":1084,"x":52,"y":0},{"h":2167,"w":1500,"x":0,"y":0}],"height":2167,"width":1500},"sizes":{"large":{"h":2048,"resize":"fit","w":1418},"medium":{"h":1200,"resize":"fit","w":831},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xUuoDjz636"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/xUuoDjz636","expanded_url":"https://x.com/takaichi_sanae/status/2103726390269145103/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":119,"w":119,"x":1247,"y":171},{"h":173,"w":173,"x":55,"y":699}]},"medium":{"faces":[{"h":69,"w":69,"x":731,"y":100},{"h":101,"w":101,"x":32,"y":409}]},"orig":{"faces":[{"h":126,"w":126,"x":1320,"y":181},{"h":184,"w":184,"x":59,"y":740}]},"small":{"faces":[{"h":39,"w":39,"x":414,"y":56},{"h":57,"w":57,"x":18,"y":232}]}},"id_str":"2103726231879557120","indices":[54,77],"media_key":"3_2103726231879557120","media_results":{"result":{"media_key":"3_2103726231879557120"}},"media_url_https":"https://pbs.twimg.com/media/HTHv3KPaIAA-5YC.jpg","original_info":{"focus_rects":[{"h":840,"w":1500,"x":0,"y":1327},{"h":1500,"w":1500,"x":0,"y":667},{"h":1710,"w":1500,"x":0,"y":457},{"h":2167,"w":1084,"x":52,"y":0},{"h":2167,"w":1500,"x":0,"y":0}],"height":2167,"width":1500},"sizes":{"large":{"h":2048,"resize":"fit","w":1418},"medium":{"h":1200,"resize":"fit","w":831},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xUuoDjz636"}]},"favorite_count":20558,"favorited":false,"full_text":"今日は、「コンテンツ」分野での改革として、先の国会で成立した『著作権法の一部改正法』についてご紹介します。 https://t.co/xUuoDjz636","id_str":"2103726390269145103","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":509,"reply_count":518,"retweet_count":4382,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM3MjYzOTAxODk0NjE1MDQ=","richtext":{"richtext_tags":[]},"text":"今日は、「コンテンツ」分野での改革として、先の国会で成立した『著作権法の一部改正法』についてご紹介します。\n\n日本の優れた「コンテンツ」を育て、世界へ発信するとともに、それを創造する「クリエイター」の皆様に、素晴らしいパフォーマンスや作品に対する「適切な対価」が還元されることが重要です。\n\n公の場で音楽CDや配信音源などが利用された場合、「作詞家」や「作曲家」の皆様には「使用料」が還元される仕組みが整備されていましたが、その楽曲を歌ったり、演奏したりする「歌手」や「ミュージシャン」の皆様には、「適切な対価」が還元されるための仕組みが、これまで整備されていませんでした。\n\nこのため、今回の『著作権法』の改正により、公の場で音楽CDや配信音源などが利用された場合、「歌手」や「ミュージシャン」の皆様が「使用料」を受け取ることができる権利として、新たに「レコード演奏・伝達権」が創設されました。\nこの権利は、既に、世界の142か国・地域で導入されています。\n\n日本の音楽を含む「コンテンツ」は、世界中で高い評価を受けており、日本の魅力や価値観を世界へ発信する重要な「ソフトパワー」であり、政府としては、音楽を含む「コンテンツ」を「日本成長戦略」の17の戦略分野の1つに位置付けています。\n\nこうした中、今回の「レコード演奏・伝達権」の創設は、日本の「歌手」や「ミュージシャン」の皆様の活動を支援するとともに、日本の音楽がさらに世界へ普及していくための大きな「追い風」となります。\n\n今後は、小規模店舗などの皆様への配慮や、徴収された対価が確実に「歌手」や「ミュージシャン」の皆様に届く仕組みづくりなど、施行に向けた課題に丁寧に取り組むとともに、十分な準備と周知に努めてまいります。\n\n日本の音楽を含む「コンテンツ」の海外展開と、「クリエイター」の皆様の活動への支援に、しっかりと取り組んでまいります。"}}},"rest_id":"2103726390269145103","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2675893","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103726390269145103","sortIndex":"2104464893389307840"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2101902184103477314"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":384188,"following":478},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":fal