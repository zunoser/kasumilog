us/2103733476184969279/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103733253186396160","indices":[35,58],"media_key":"3_2103733253186396160","media_results":{"result":{"media_key":"3_2103733253186396160"}},"media_url_https":"https://pbs.twimg.com/media/HTH2P2paIAAINSe.jpg","original_info":{"focus_rects":[{"h":339,"w":605,"x":0,"y":288},{"h":605,"w":605,"x":0,"y":155},{"h":690,"w":605,"x":0,"y":112},{"h":873,"w":437,"x":0,"y":0},{"h":873,"w":605,"x":0,"y":0}],"height":873,"width":605},"sizes":{"large":{"h":873,"resize":"fit","w":605},"medium":{"h":873,"resize":"fit","w":605},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/U20GZmiQgv"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/U20GZmiQgv","expanded_url":"https://x.com/takaichi_sanae/status/2103733476184969279/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103733275135262720","indices":[35,58],"media_key":"3_2103733275135262720","media_results":{"result":{"media_key":"3_2103733275135262720"}},"media_url_https":"https://pbs.twimg.com/media/HTH2RIabQAACKHX.jpg","original_info":{"focus_rects":[{"h":339,"w":605,"x":0,"y":0},{"h":454,"w":454,"x":151,"y":0},{"h":454,"w":398,"x":179,"y":0},{"h":454,"w":227,"x":265,"y":0},{"h":454,"w":605,"x":0,"y":0}],"height":454,"width":605},"sizes":{"large":{"h":454,"resize":"fit","w":605},"medium":{"h":454,"resize":"fit","w":605},"small":{"h":454,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/U20GZmiQgv"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/U20GZmiQgv","expanded_url":"https://x.com/takaichi_sanae/status/2103733476184969279/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103733253186396160","indices":[35,58],"media_key":"3_2103733253186396160","media_results":{"result":{"media_key":"3_2103733253186396160"}},"media_url_https":"https://pbs.twimg.com/media/HTH2P2paIAAINSe.jpg","original_info":{"focus_rects":[{"h":339,"w":605,"x":0,"y":288},{"h":605,"w":605,"x":0,"y":155},{"h":690,"w":605,"x":0,"y":112},{"h":873,"w":437,"x":0,"y":0},{"h":873,"w":605,"x":0,"y":0}],"height":873,"width":605},"sizes":{"large":{"h":873,"resize":"fit","w":605},"medium":{"h":873,"resize":"fit","w":605},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/U20GZmiQgv"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/U20GZmiQgv","expanded_url":"https://x.com/takaichi_sanae/status/2103733476184969279/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103733275135262720","indices":[35,58],"media_key":"3_2103733275135262720","media_results":{"result":{"media_key":"3_2103733275135262720"}},"media_url_https":"https://pbs.twimg.com/media/HTH2RIabQAACKHX.jpg","original_info":{"focus_rects":[{"h":339,"w":605,"x":0,"y":0},{"h":454,"w":454,"x":151,"y":0},{"h":454,"w":398,"x":179,"y":0},{"h":454,"w":227,"x":265,"y":0},{"h":454,"w":605,"x":0,"y":0}],"height":454,"width":605},"sizes":{"large":{"h":454,"resize":"fit","w":605},"medium":{"h":454,"resize":"fit","w":605},"small":{"h":454,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/U20GZmiQgv"}]},"favorite_count":36894,"favorited":false,"full_text":"「競馬」が、実は「食料安全保障」に大きく貢献しているというお話です。 https://t.co/U20GZmiQgv","id_str":"2103733476184969279","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2104,"reply_count":1111,"retweet_count":9189,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM3MzM0NzYwODg1ODIxNDQ=","richtext":{"richtext_tags":[]},"text":"「競馬」が、実は「食料安全保障」に大きく貢献しているというお話です。\n\n高市内閣では、全ての田畑をフル活用すべく、５年間の「農業構造転換集中対策期間」において、農地の大区画化、共同利用施設の再編・集約化、スマート農業技術の導入の加速化、輸出産地の育成など、農業の構造転換への集中投資を実施していくため、｢別枠予算｣として国費1.3兆円を確保することとしています。\n\nこれに必要な財源の一部を確保するため、先の国会において、『農業構造転換の推進に必要な施策の集中的な実施の財源に充てるための日本中央競馬会の国庫納付金の納付に関する臨時措置法』が成立しました。\n\nこれまでも、日本中央競馬会（JRA）の収益の一部は国庫に納付され、畜産業の振興等に活用されてきましたが、この法律により、従来の国庫納付に加え、令和８年度から11年度までの４年間、JRAの特別積立金から毎年度250億円、合計1,000億円が、構造転換への集中投資のために国庫に納付されます。\n関係者の皆様の御理解と御尽力に感謝申し上げます。\n\n高齢化や人口減少が進む中にあっても、若い方々の就農や法人の参入などを通じて、農業の「担い手」が継続的に確保されていかなければなりません。\nそのためにも、この財源を活用し、我が国の農業の構造転換を加速させます。そして、生産性を抜本的に向上させ、「稼げる農業」を創り出してまいります。\n\n｢競馬｣を通じて積み立てられた大切な財源を、日本の「食」の新たな需要を創り出し、農業の「供給力」を高めるための力に変えて、我が国の農業が未来へ力強く駆けていけるよう取り組んでまいります。"}}},"rest_id":"2103733476184969279","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3560702","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103733476184969279","sortIndex":"2104464893389307841"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pb