https://video.twimg.com/amplify_video/2103841357634981888/vid/avc1/640x360/JaY4OzkAFus2q1ln.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103841357634981888/vid/avc1/1280x720/0SzopemKwodD4rPc.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/GDkCgPPth0","expanded_url":"https://x.com/kantei/status/2103841821952713130/video/1","ext_media_availability":{"status":"Available"},"id_str":"2103841357634981888","indices":[100,123],"media_key":"13_2103841357634981888","media_results":{"result":{"media_key":"13_2103841357634981888"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2103841357634981888/img/bBp81eC2BOH89yGA.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/GDkCgPPth0","video_info":{"aspect_ratio":[16,9],"duration_millis":136833,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2103841357634981888/pl/Nxj17XIBHNBhymf7.m3u8?tag=29&v=843"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103841357634981888/vid/avc1/480x270/uDjlNz2n6rMBrEoo.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103841357634981888/vid/avc1/640x360/JaY4OzkAFus2q1ln.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103841357634981888/vid/avc1/1280x720/0SzopemKwodD4rPc.mp4?tag=29"}]}}]},"favorite_count":14933,"favorited":false,"full_text":"【お知らせ】\n本日（９月２６日）、高市総理は、日米首脳電話会談についてのぶらさがり会見を行いました。\n※要旨（速報版）\n（記者）\n　高市総理は先ほど、トランプ・アメリカ大統領と電話会談をされました。 https://t.co/GDkCgPPth0","id_str":"2103841821952713130","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":407,"reply_count":829,"retweet_count":2604,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM4NDE4MjE4ODU2MzI1MTI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（９月２６日）、高市総理は、日米首脳電話会談についてのぶらさがり会見を行いました。\n※要旨（速報版）\n（記者）\n　高市総理は先ほど、トランプ・アメリカ大統領と電話会談をされました。\n　米中首脳会談を終えた直後のタイミングでの会談となりましたが、トランプ大統領からどのような説明を受け、総理からどのようなことを伝えたのかお聞きします。\n　また、アメリカのホワイトハウスは、今回の会談内容をまとめたファクトシートを発表し、両首脳はアメリカと中国が第２次世界大戦で同盟国として勝利するためにともに戦ったことを振り返ったとしています。この点についてトランプ大統領から説明はありましたでしょうか。また総理からこの点について指摘はしたのでしょうか。あわせてお聞きします。よろしくお願いします。\n（総理）\n　先ほど、午後９時から約２０分間、トランプ大統領と電話会談を行いました。\n　トランプ大統領からは、習近平国家主席の訪米直後というタイミングで電話をいただき、今般の米中首脳会談について、詳細に説明がございました。\n　その上で、トランプ大統領との間では、経済安全保障を含む経済や安全保障などですね、中国をめぐる諸課題を中心に意見交換を行いまして、日米の連携を確認しました。\n　９月２２日のニューヨークでの首脳会談に続きまして、１週間の間に二度の首脳間の会談を実施したということは、まさに日米同盟の絆の強さを示すものであります。\n　これからもトランプ大統領と緊密に連携をしていきたいと考えております。\n　具体的な会談の内容については外交上のやり取りでありますので、差し控えますけれども、先ほどご指摘の点、後段の点につきましては、私の方から、日本と米国は、今やもう最も信頼し合える同盟国となっているということを申し上げまして、共に、地域、そして世界の平和と安定に貢献していくということを確認しました。以上です。"}}},"rest_id":"2103841821952713130","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1972582","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103841821952713130","sortIndex":"2104464893389307847"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2103839703808229871"],"editable_until_msecs":"1790433047000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2336,"bookmarked":false,"conversation_id_str":"2103839703808229871","created_at":"Sat Sep 26 13:30:47 +0000 2026","display_text_range":[0,98],"entities":{},"favorite_count":97072,"favorited":false,"full_text":"先ほど、午後9時から、トランプ大統領と電話会談を行いました。\n\nトランプ大統領からは、習近平国家主席の訪米直後というタイミングで電話をいただき、今般の米中首脳会談について詳細に説明がございました。","id_str":"2103839703808229871","is_quote_status":false,"lang":"ja","quote_count":1697,"reply_count":4416,"retweet_count":11136,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM4Mzk3MDM3NzA0NzI0NDg=","richtext":{"richtext_tags":[]},"text":"先ほど、午後9時から、トランプ大統領と電話会談を行いました。\n\nトランプ大統領からは、習近平国家主席の訪米直後というタイミングで電話をいただき、今般の米中首脳会談について詳細に説明がございました。\n\nその上で、トランプ大統領との間で、経済安全保障を含む経済や安全保障など、中国をめぐる諸課題を中心に意見交換を行い、日米の連携を確認しました。\n\n今週22日のニューヨーク訪問時の首脳会談に続き、一週間の間に二度の首脳間の会談を実施したことは、まさに日米同盟の力強さを示すものと考えています。\n\n日本と米国は、今や最も信頼し合える同盟国となっており、共に、地域、そして世界の平和と安定に貢献していくことを確認しました。\n\n揺るぎない日米同盟を更なる高みに引き上げていくため、トランプ大統領と緊密に連携してまいります。"}}},"rest_id":"2103839703808229871","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"8684985","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103839703808229871","sortIndex":"2104464893389307846"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/57142913