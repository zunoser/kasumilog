,"is_translatable":false,"legacy":{"bookmark_count":56,"bookmarked":false,"conversation_id_str":"2103483187217461323","created_at":"Fri Sep 25 13:54:07 +0000 2026","display_text_range":[0,141],"entities":{},"favorite_count":1031,"favorited":false,"full_text":"本日午後9時00分、片山大臣は、スコット・ベッセント米国財務長官と電話会談を行いました。両大臣は、日米首脳会談でも議論があり、高市総理からも発言されたように、円の過小評価は問題であるという点を再確認しました。また、金融市場の動向等に関して意見交換を行い、両国間の協力をさらに強化して","id_str":"2103483187217461323","is_quote_status":false,"lang":"ja","quote_count":49,"reply_count":89,"retweet_count":246,"retweeted":false,"user_id_str":"331514169"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM0ODMxODcxNzk3NTc1Njg=","richtext":{"richtext_tags":[]},"text":"本日午後9時00分、片山大臣は、スコット・ベッセント米国財務長官と電話会談を行いました。両大臣は、日米首脳会談でも議論があり、高市総理からも発言されたように、円の過小評価は問題であるという点を再確認しました。また、金融市場の動向等に関して意見交換を行い、両国間の協力をさらに強化していくことを再確認しました。"}}},"rest_id":"2103483187217461323","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"82845","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103483187217461323","sortIndex":"2104464893389307832"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2