es":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2104128399874871296","indices":[73,96],"media_key":"3_2104128399874871296","media_results":{"result":{"media_key":"3_2104128399874871296"}},"media_url_https":"https://pbs.twimg.com/media/HTNdoaxaUAA8o1x.jpg","original_info":{"focus_rects":[{"h":297,"w":530,"x":0,"y":24},{"h":417,"w":417,"x":113,"y":0},{"h":417,"w":366,"x":164,"y":0},{"h":417,"w":209,"x":306,"y":0},{"h":417,"w":530,"x":0,"y":0}],"height":417,"width":530},"sizes":{"large":{"h":417,"resize":"fit","w":530},"medium":{"h":417,"resize":"fit","w":530},"small":{"h":417,"resize":"fit","w":530},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MHgKUKIpRv"}]},"favorite_count":15604,"favorited":false,"full_text":"シルバーウィークで空港を利用された方々の中には、「動植物探知犬」が旅客の手荷物を嗅ぐ「探知活動」の様子をご覧になった方もおられるかもしれません。 https://t.co/MHgKUKIpRv","id_str":"2104128457387233630","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":217,"reply_count":993,"retweet_count":1970,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"maff.go.jp/j/syouan/douei…","expanded_url":"https://www.maff.go.jp/j/syouan/douei/eisei/e_koutei/kaisei_kadenhou/kaisei_kakuron/attach/pdf/kaisei-r8-27.pdf","indices":[562,585],"url":"https://t.co/bIdGgcneBU"},{"display_url":"maff.go.jp/j/syouan/douei…","expanded_url":"https://www.maff.go.jp/j/syouan/douei/eisei/e_koutei/kaisei_kadenhou/kaisei_kakuron/kaisei-r8.html","indices":[614,637],"url":"https://t.co/tvhtVXxOdO"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQxMjg0NTcyMzYxODkxODQ=","richtext":{"richtext_tags":[]},"text":"シルバーウィークで空港を利用された方々の中には、「動植物探知犬」が旅客の手荷物を嗅ぐ「探知活動」の様子をご覧になった方もおられるかもしれません。\n\n海外からの家畜伝染病の国内への侵入を防ぐため、海外から手荷物として肉やハム・ソーセージなどの畜産物を日本に持ち込むことは禁止されています。\n｢探知犬｣は、旅客の手荷物等にこのような畜産物等が紛れ込んでいないかを発見するために活動しています。\n\n多くの国で｢アフリカ豚熱｣などの家畜の重大な病気が発生しています。\nこれらの病気は肉や肉製品を介して感染することが知られており、一度侵入すると国内の畜産農家に大きな被害が及ぶことになります。\n\n政府では、『家畜伝染病予防法』に基づき、国内の畜産業に甚大な影響を及ぼす家畜の病気の発生予防・まん延防止に取り組んでいます。\n本年5月に先の国会で成立したこの法律の改正では、「豚熱への効率的・迅速な対応」等に加え、「輸入禁止品への対応強化」など海外からの家畜伝染病を水際で食い止めるための取組が一層強化されました。\n\n国民の皆様におかれましても、海外から帰国される際に、肉製品の持ち込みはなさいませんようお願いいたします。\n\n＜家畜伝染病予防法の一部を改正する法律の概要＞\n家畜伝染病予防法の一部を改正する法律(令和8年5月19日公布)\nhttps://t.co/bIdGgcneBU\n家畜伝染病予防法の改正（令和8年）について：農林水産省\nhttps://t.co/tvhtVXxOdO"}}},"rest_id":"2104128457387233630","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"611343","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104128457387233630","sortIndex":"2104464893389307863"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104126459174641897"],"editable_until_msecs":"1790501415000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":267,"bookmarked":false,"conversation_id_str":"2104126459174641897","created_at":"Sun Sep 27 08:30:15 +0000 2026","display_text_range":[0,88],"entities":{},"favorite_count":18330,"favorited":false,"full_text":"高市内閣は、国民の皆様の暮らしの安全・安心を守り、我が国の経済と産業基盤を支えるため、様々な政策を推進しています。\n\n我が国にとって、国際貿易は経済活動を支える重要な基盤です。","id_str":"2104126459174641897","is_quote_status":false,"lang":"ja","quote_count":378,"reply_count":1338,"retweet_count":2140,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQxMjY0NTkxMTE3MTg5MTM=","richtext":{"richtext_tags":[]},"text":"高市内閣は、国民の皆様の暮らしの安全・安心を守り、我が国の経済と産業基盤を支えるため、様々な政策を推進しています。\n\n我が国にとって、国際貿易は経済活動を支える重要な基盤です。\n国際情勢の変化やサプライチェーンの再編、取引形態の多様化など、国際貿易を取り巻く環境は大きく変化しています。\n\nそこで今回は、先の国会で成立した『関税定率法等の一部を改正する法律』についてご紹介します。\n\n近年、海外ネット通販（越境EC）の利用が急拡大しています。\n消費者にとっては海外の商品を手軽に購入できる便利な仕組みである一方、輸入件数の急増に伴い、不正薬物や知的財産侵害物品（偽ブランド品や偽造化粧品）などの違法な貨物が海外から流入するリスクも高まっています。\n\nこのため、外国からの貨物を保管する保税業者について、適正な貨物管理を確保するための制度整備を行いました。\n保税業者は違法な貨物の国内流入を防止する上で重要な役割を担っており、法令遵守のための業務体制等を規定した規則の策定を義務付けるとともに、｢税関長による業務改善命令｣の制度を創設し、税関による事業者の実態に応じた「きめ細やかな監督」を可能としました。\n\nまた、海外事業者と国内事業者の間の競争上の不均衡を是正するため、海外事業者が越境ECサイトを通じて国内消費者に直接販売する商品に適用されていた、課税価格を海外小売価格の６割にする「課税価格決定の特例」を廃止し、内外の事業者がより公平な条件で競争できる環境を整備しました。\n\nさらに、不当に安価な輸入品による国内産業の損害を防ぐため、不当廉売関税制度も拡充しました。\n供給国や品目を変更して関税の適用を回避しようとする迂回行為に対し、迅速に同等の割増関税を課すことができる制度を創設しました。\n\n高市内閣としては、こうした制度改正を通じて、税関の水際取締りと円滑な国際物流を支える機能を一層強化し、「安全・安心な社会の実現」と「我が国産業の競争力確保」に取り組んでまいります。"}}},"rest_id":"2104126459174641897","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"772252","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104126459174641897","sortIndex":"2104464893389307862"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"med