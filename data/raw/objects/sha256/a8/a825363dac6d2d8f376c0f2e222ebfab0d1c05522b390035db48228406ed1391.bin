":"https://video.twimg.com/amplify_video/2103791824796372992/vid/avc1/640x360/AB6YMa4d6eCQNhO9.mp4?tag=14"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103791824796372992/vid/avc1/960x540/R6DdxLniBz_rihuS.mp4?tag=14"}]}}]},"favorite_count":3757,"favorited":false,"full_text":"【#台風25号 対応】\n台風の到来までに決壊箇所の荒締切を完了させるため、決壊した堤防の応急復旧を24時間体制で夜を徹して進めています。現在は、重い工事車両も通れるように鉄板を敷き、工事用道路を作っています。\n\n#チーム印旛沼　#関東地方整備局 https://t.co/4i8z7xfjH0","id_str":"2103793700765872187","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":66,"reply_count":42,"retweet_count":1020,"retweeted":false,"user_id_str":"714372536490852352"},"rest_id":"2103793700765872187","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"220999","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2104012833227002151","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"845","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104012833227002151","sortIndex":"2104464893389307854"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104009390152179803"],"editable_until_msecs":"1790473503000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":259,"bookmarked":false,"conversation_id_str":"2104009390152179803","created_at":"Sun Sep 27 00:45:03 +0000 2026","display_text_range":[0,129],"entities":{},"favorite_count":13800,"favorited":false,"full_text":"先の国会では、令和4年以来4年ぶりとなる『旅券法』の改正について、衆議院・参議院ともに全会一致で御承認をいただきました。\n\nこの改正の最大の目玉は、旅券（パスポート）の手数料の大幅な引き下げです。\n\n今年の7月1日から、旅券の手数料は、オンライン申請で、\n①","id_str":"2104009390152179803","is_quote_status":false,"lang":"ja","quote_count":246,"reply_count":706,"retweet_count":1702,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQwMDkzOTAwOTM0MjI1OTI=","richtext":{"richtext_tags":[]},"text":"先の国会では、令和4年以来4年ぶりとなる『旅券法』の改正について、衆議院・参議院ともに全会一致で御承認をいただきました。\n\nこの改正の最大の目玉は、旅券（パスポート）の手数料の大幅な引き下げです。\n\n今年の7月1日から、旅券の手数料は、オンライン申請で、\n① 18歳以上向けの旅券（有効期間10年）は、これまでの15,900円から8,900円に、\n② 18歳未満向けの旅券（有効期間5年）は、これまでの10,900円（12歳未満は5,900円）から4,400円に、\nそれぞれ引き下げられました。\n\nその結果、7月の一か月間の国内における旅券の申請数は、昨年7月と比較して約1.7倍に増加しました。\n\n今回の旅券手数料の引き下げにより、国民の皆様が旅券を取得しやすくなることを期待しています。"}}},"rest_id":"2104009390152179803","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"769277","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104009390152179803","sortIndex":"2104464893389307853"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104004556074238156"],"editable_until_msecs":"1790472351000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":870,"bookmarked":false,"conversation_id_str":"2104004556074238156","created_at":"Sun Sep 27 00:25:51 +0000 2026","display_text_range":[0,69],"entities":{},"favorite_count":27615,"favorited":false,"full_text":"先の国会において、『出入国管理及び難民認定法』が改正されましたので、改正内容をご紹介します。\n\n＜「在留許可手数料の額」の引上げについて＞","id_str":"2104004556074238156","is_quote_status":false,"lang":"ja","quote_count":356,"reply_count":1223,"retweet_count":4335,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQwMDQ1NTYwMTEzMDcwMDg=","richtext":{"richtext_tags":[]},"text":"先の国会において、『出入国管理及び難民認定法』が改正されましたので、改正内容をご紹介します。\n\n＜「在留許可手数料の額」の引上げについて＞\n\n外国人の適正かつ円滑な受入れや、秩序ある共生社会の実現に向けた受入れ環境整備などに係る施策を強化・拡充するためには、それに要する経費の増大が想定されます。\n\nそこで、受益者負担の観点から、在留外国人の方々に相応の負担を求めることとし、「在留許可手数料の額」が引き上げられました（例えば、「永住許可」の手数料は10,000円から200,000円に引き上げ）。\n\n改正法令は、本年10月1日から施行されます。\n\n＜「電子渡航認証制度（JESTA）」の導入について＞\n\nまた、改正法には、令和10年度中に「電子渡航認証制度（JESTA）」を導入することも盛り込まれています。\n\n「電子渡航認証制度（JESTA）」は、オンラインで事前に提供された情報をもとに、入国審査前の「スクリーニング」を行うことにより、好ましくない外国人の来日を未然に防止する効果があります。\n\n「査証審査」を受けずに入国できる外国人、例えば、観光を目的とする「短期滞在」の外国人についても、外国にいる段階から事前のチェックを行うことが可能となります。\n不法滞在を企図する外国人など、我が国にとって好ましくない外国人の入国を防止することで、より厳格な出入国管理が実現します。\n\n国民の皆様と外国人の双方が安全・安心に生活するため、今後も厳格かつ円滑な出入国在留管理の実現に取り組んでまいります。"}}},"rest_id":"2104004556074238156","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1095092","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104004556074238156","sortIndex":"2104464893389307852"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/4oPQvKU7oW"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104003292091269285"],"editable_until_msecs":"1790472049000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1472,"bookmarked":false,"conversation_id_str":"2104003292091269285","created_at":"Sun Sep 27 00:20:49 +0000 2026","display_text_range":[0,79],"entities":{},"favorite_count":31505,"favorited":false,"full_text":"『外国人の受入れ・秩序ある共生のための総合的対応策』に基づく施策の中から、国民の安全・安心に密接に関わる「不法滞在者対策」について、取組の状況をご紹介します。","id_str":"2104003292091269285","is_quote_status":false,"lang":"ja","quote_count":1135,"reply_count":3316,"retweet_count":5154,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"moj.go.jp/isa/09_00048.h…","expanded_url":"https://www.moj.go.jp/isa/09_00048.html","indices":[594,617],"url":"https://t.co/4oPQvKU7oW"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQwMDMyOTE5Mjc2OTk0NTY=","richtext":{"richtext_tags":[]},"text":"『外国人の受入れ・秩序ある共生のための総合的対応策』に基づく施策の中から、国民の安全・安心に密接に関わる「不法滞在者対策」について、取組の状況をご紹介します。\n\n政府では、難民該当性や人道配慮の必要性が認められないなど、制度の趣旨に沿わない「難民認定申請」を繰り返している者を含め、「退去強制事由」に該当する外国人を速やかに我が国から退去させるための『不法滞在者ゼロプラン』に取り組んでいます。\n\n今年5月、不法残留者数の増減要因の分析に基づき、重点的に取り組むべき施策を『不法滞在者ゼロプラン～強力推進パッケージ～』として取りまとめました。\n\n具体的には、\n・「護送官付き国費送還」の促進\n・「摘発」の強化\n・「難民認定審査」の迅速化\nなどの施策に取り組んでいます。\n\n昨年の上半期と令和8年の上半期を比べると、\n・送還全体の人数が15%増加（524人増加）\n・特に、送還を拒んだり妨げたりするなど、送還に応じない者に対する「護送官付き国費送還」は、54%増加（65人増加）\n・出入国在留管理庁が摘発した不法滞在者数は、64%増加（436人増加）\n・我が国に不法に残留する者の人数は、8.4%減少（6,000人減少）\n・「難民認定申請」の未処理件数は、47%減少（9,496人減少）\nとなっています。\n\n『不法滞在者ゼロプラン』は、大きな成果を挙げています。\n\n詳細については、こちら（https://t.co/4oPQvKU7oW）をご覧いただければと思います。"}}},"rest_id":"2104003292091269285","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2260253","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104003292091269285","sortIndex":"2104464893389307851"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104002081833242648"],"editable_until_msecs":"1790471761000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3735,"bookmarked":false,"conversation_id_str":"2104002081833242648","created_at":"Sun Sep 27 00:16:01 +0000 2026","display_text_range":[0,140],"entities":{},"favorite_count":52846,"favorited":false,"full_text":"政府では、在留外国人数の増加に伴って不安や不公平感を感じる国民の皆様がいらっしゃることに向き合い、「外国人政策」を「秩序」あるものとし、国民の皆様と外国人の双方が安全・安心に生活していけるようにするため、本年１月、『外国人の受入れ・秩序ある共生のための総合的対応策』を取りまとめ、","id_str":"2104002081833242648","is_quote_status":false,"lang":"ja","quote_count":2328,"reply_count":5438,"retweet_count":8016,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQwMDIwODE3Mjg0NTQ2NTY=","richtext":{"richtext_tags":[]},"text":"政府では、在留外国人数の増加に伴って不安や不公平感を感じる国民の皆様がいらっしゃることに向き合い、「外国人政策」を「秩序」あるものとし、国民の皆様と外国人の双方が安全・安心に生活していけるようにするため、本年１月、『外国人の受入れ・秩序ある共生のための総合的対応策』を取りまとめ、幅広い施策に取り組んでいます。\n\nそれらの施策の中から、外国人の「在留資格」に関する取組の状況をご説明したいと思います。\n\n＜「経営・管理」の在留資格の許可基準の見直しについて＞\n\n「経営・管理」とは、貿易などの事業の経営や管理に従事することを目的とする在留資格です。\n\n「経営・管理」については、諸外国の同様の制度に比べて、許可基準が緩く、移住目的の方法として悪用されているなどの問題が指摘されていました。\n\nそこで、昨年10月に許可基準の見直しを行い、新たな基準に基づく厳格な審査を実施してきました。\n\nその結果、令和8年上半期の「在留資格認定証明書交付件数」は、前年同期比90%減少（3,074件減少）となっています。\n\n＜「企業内転勤」の在留資格の審査の厳格化について＞\n\n「企業内転勤」とは、国外にある親会社の外国人職員が、国内の子会社に転勤する場合などに用いられる在留資格です。\n\n「企業内転勤」についても、実態を欠いた悪用事例が一部で確認されていました。\n\nそこで、本年4月から、国外・国内それぞれの事業所の存在を明らかにするための新たな資料の提出を求めるなど、厳格な審査を行うようにしました。\n\nその結果、令和8年上半期の「在留資格認定証明書交付件数」は、前年同期比で15%減少（739件減少）し、より実態に即した運用が行われるようになっています。\n\n＜「技術・人文知識・国際業務」の在留資格の審査の厳格化について＞\n\n「技術・人文知識・国際業務」とは、日本の会社などに雇用されて、自然科学・人文科学に関する技術・専門的知識や外国語の能力などを活かして働く場合に用いられる在留資格で、システムエンジニアや、経理・財務、通訳・語学教師など、幅広い分野で利用されています。\n\n「技術・人文知識・国際業務」についても、在留資格該当性のない活動に従事する事案が散見されるとの指摘があります。\n\nそこで、対策として、派遣元と派遣先の双方に対し、従事させる業務についての誓約書を求めたり、言語能力の確認（CEFR・B2相当の言語能力の確認）を行うことにしたりするなど、審査の強化に取り組んでいます。\n\n本年7月には、出入国在留管理庁の入国審査官など226名を緊急増員することとしましたので、更に取組を加速してまいります。\n\n＜「永住許可制度」の適正化について＞\n\n「永住者」とは、在留活動・在留期間の制限がなく、最も安定した法的地位として創設された在留資格であるため、特に慎重な審査を行う必要があります。\n\nこうした位置付けを踏まえ、『永住許可に関するガイドライン』を改定することとしました。\n\n主な改定内容は、以下の２点です。\n\n「永住者」の在留資格を得るためには、「独立生計要件」、つまり「独立の生計を営むに足りる資産又は技能を有すること」が必要となりますが、実際には、「永住者」の在留資格を得たにもかかわらず、独立の生計を営むことができないという事例が多くありました。\n\nそこで、「独立生計要件」について、\n・世帯年収の基準を「日本人世帯の平均年収を上回る水準」に見直すとともに、\n・将来の年金見込み額を新たに考慮することとする予定です。\n\nまた、いわゆる「国益要件」、つまり「その者の永住が日本国の利益に合すると認められること」についても、\n・一定水準の日本語能力を有しているか、\n・我が国の制度・ルールなどへの理解が一定水準以上に達しているか\nといった事項を新たに考慮することとする予定です。\n\n『新ガイドライン』は、パブリック・コメントで寄せられた意見を踏まえて検討を行った上で、10月1日に改定を予定しています。"}}},"rest_id":"2104002081833242648","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"6301213","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104002081833242648","sortIndex":"2104464893389307850"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2103991528284946618"],"editable_until_msecs":"1790469245000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":130,"bookmarked":false,"conversation_id_str":"2103991528284946618","created_at":"Sat Sep 26 23:34:05 +0000 2026","display_text_range":[0,107],"entities":{},"favorite_count":15569,"favorited":false,"full_text":"今日で、平成26年の御嶽山の噴火から12年となります。\n御嶽山は、長野県と岐阜県にまたがる火山で、12年前の噴火では、火口周辺で登山中だった多くの方々が被災され、死者・行方不明者63名という甚大な被害が生じました。","id_str":"2103991528284946618","is_quote_status":false,"lang":"ja","quote_count":95,"reply_count":315,"retweet_count":1669,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM5OTE1MjgxOTY4NDk2NjQ=","richtext":{"richtext_tags":[]},"text":"今日で、平成26年の御嶽山の噴火から12年となります。\n御嶽山は、長野県と岐阜県にまたがる火山で、12年前の噴火では、火口周辺で登山中だった多くの方々が被災され、死者・行方不明者63名という甚大な被害が生じました。\n\n改めて、お亡くなりになられた方々に哀悼の誠を捧げますとともに、ご遺族の皆様に心よりお悔やみを申し上げます。\nまた、被害に遭われた皆様に、心よりお見舞い申し上げます。\n\nこの痛ましい御嶽山噴火から得られた教訓を、決して風化させてはなりません。\n\n御嶽山の噴火の教訓も踏まえ、政府では、『活動火山対策特別措置法』の改正を中心に、火山防災対策に取り組んできました。\n\n＜平成27年の『活動火山対策特別措置法』の改正＞\n\n平成27年の改正では、噴火の可能性や噴火の際の影響が大きい地域を「火山災害警戒地域」として指定し、火山ごとに関係機関や専門家からなる「火山防災協議会」が設置されることとなりました。\n\n「火山防災協議会」での協議を踏まえ、火山活動の状況に応じた「避難開始時期」・「避難対象地域」が設定され、噴火警戒レベルに応じた「警戒が必要な範囲」と入山規制などの「とるべき防災対応」が市町村・都道府県の「地域防災計画」に定められます。\n\n火口に近いホテルやロープウェイなどの集客施設も「避難促進施設」として位置付けられ、管理者には、利用者への情報伝達や避難誘導、避難訓練の実施などを定めた「避難確保計画」の作成が義務付けられています。\n\n＜令和5年の『活動火山対策特別措置法』の改正＞\n\n令和5年の改正では、この「避難確保計画」の作成を一層進めるため、市町村長による管理者への援助に関する規定が設けられたほか、火山の調査研究を推進する司令塔として「火山調査研究推進本部」が設置されることとされました。\n\nまた、この改正では、火山に関する防災訓練や普及啓発を呼びかける機会とするため、浅間山に日本で最初の火山観測所が設置され、観測が始まった明治44年8月26日にちなんで、8月26日が「火山防災の日」とされました。\n\n日本には111の活火山があり、『活動火山対策特別措置法』に基づき「火山災害警戒地域」が指定された火山は、富士山など50に上ります。\n\n政府では、過去の災害から得られた教訓やこれまで集約・蓄積してきた知見を活かし、自治体の皆様ともしっかりと連携しながら、火山監視・観測体制の強化や警戒避難体制の整備、大規模噴火に伴う広域降灰対策の具体化など、火山防災対策に更に取り組んでまいります。"}}},"rest_id":"2103991528284946618","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"464317","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103991528284946618","sortIndex":"2104464893389307849"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2104464893389307960-tweet-2103855530632753294","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2103319939235160372"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":590529,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20218,"tweets":48917},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2103855530632753294"],"editable_until_msecs":"1790436820000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":15,"bookmarked":false,"conversation_id_str":"2103855530632753294","created_at":"Sat Sep 26 14:33:40 +0000 2026","display_text_range":[0,58],"entities":{"media":[{"display_url":"pic.x.com/kH7XMwxBzw","expanded_url":"https://x.com/MofaJapan_jp/status/2103855530632753294/photo/1","ext_alt_text":"１ 我が国は、９月２３日以降のエチオピア北部における情勢の悪化に深い懸念を表明し、ティグライ人民解放戦線（ＴＰＬＦ）による同地域における空港制圧を含む軍事行動を非難し、全ての当事者に即時の緊張緩和及び対話による解決を呼びかけます。\n\n\n２ 我が国は、２０２２年のプレトリア合意の順守と履行を重視し、アフリカ連合（ＡＵ）主導の仲介プロセスを支持・支援します。また、全ての当事者が事態を悪化させないことを求めるとともに、影響を受ける住民への人道アクセスの確保を求めます。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103855524001529856","indices":[59,82],"media_key":"3_2103855524001529856","media_results":{"result":{"media_key":"3_2103855524001529856"}},"media_url_https":"https://pbs.twimg.com/media/HTJlc87awAAo-B7.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":960,"w":960,"x":0,"y":0},{"h":1094,"w":960,"x":0,"y":0},{"h":1200,"w":600,"x":360,"y":0},{"h":1200,"w":960,"x":0,"y":0}],"height":1200,"width":960},"sizes":{"large":{"h":1200,"resize":"fit","w":960},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/kH7XMwxBzw"}],"urls":[{"display_url":"mofa.go.jp/mofaj/press/da…","expanded_url":"https://www.mofa.go.jp/mofaj/press/danwa/pageit_000001_03229.html","indices":[35,58],"url":"https://t.co/WxZFWVJVxv"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/kH7XMwxBzw","expanded_url":"https://x.com/MofaJapan_jp/status/2103855530632753294/photo/1","ext_alt_text":"１ 我が国は、９月２３日以降のエチオピア北部における情勢の悪化に深い懸念を表明し、ティグライ人民解放戦線（ＴＰＬＦ）による同地域における空港制圧を含む軍事行動を非難し、全ての当事者に即時の緊張緩和及び対話による解決を呼びかけます。\n\n\n２ 我が国は、２０２２年のプレトリア合意の順守と履行を重視し、アフリカ連合（ＡＵ）主導の仲介プロセスを支持・支援します。また、全ての当事者が事態を悪化させないことを求めるとともに、影響を受ける住民への人道アクセスの確保を求めます。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103855524001529856","indices":[59,82],"media_key":"3_2103855524001529856","media_results":{"result":{"media_key":"3_2103855524001529856"}},"media_url_https":"https://pbs.twimg.com/media/HTJlc87awAAo-B7.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":960,"w":960,"x":0,"y":0},{"h":1094,"w":960,"x":0,"y":0},{"h":1200,"w":600,"x":360,"y":0},{"h":1200,"w":960,"x":0,"y":0}],"height":1200,"width":960},"sizes":{"large":{"h":1200,"resize":"fit","w":960},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/kH7XMwxBzw"}]},"favorite_count":225,"favorited":false,"full_text":"エチオピア・ティグライ州情勢について、外務報道官談話を発出しました。\nhttps://t.co/WxZFWVJVxv https://t.co/kH7XMwxBzw","id_str":"2103855530632753294","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":13,"retweet_count":58,"retweeted":false,"user_id_str":"303730149"},"rest_id":"2103855530632753294","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"21023","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2104464893389307960-tweet-2103855534474772606","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/pBMLUeiWrl"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730