a_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2103747815742796025"],"editable_until_msecs":"1790411139000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":309,"bookmarked":false,"conversation_id_str":"2103747815742796025","created_at":"Sat Sep 26 07:25:39 +0000 2026","display_text_range":[0,99],"entities":{},"favorite_count":17191,"favorited":false,"full_text":"国際情勢が不安定化し、サプライチェーン分断の試みや、重要技術をめぐる国家間競争の激化が見られる中、経済安全保障、すなわち我が国の経済的な自律性と技術的優位性を確保することが喫緊の課題となっています。","id_str":"2103747815742796025","is_quote_status":false,"lang":"ja","quote_count":227,"reply_count":1220,"retweet_count":1985,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM3NDc4MTU2ODQxMDQxOTI=","richtext":{"richtext_tags":[]},"text":"国際情勢が不安定化し、サプライチェーン分断の試みや、重要技術をめぐる国家間競争の激化が見られる中、経済安全保障、すなわち我が国の経済的な自律性と技術的優位性を確保することが喫緊の課題となっています。\n\n本日は、こうした課題に対応するために先の国会に提出し、成立した『経済施策を一体的に講ずることによる安全保障の確保の推進に関する法律（経済安全保障推進法）及び株式会社国際協力銀行法の一部を改正する法律』をご紹介します。\n\n今回の改正のポイントは4点です。\n\n第1に、「重要物資」の安定供給確保に向けた取組を強化します。\n半導体や重要鉱物などの「物資」だけでなく、海底ケーブルの敷設や人工衛星の打上げといった、安定供給を支える重要な「サービス」も、支援対象に追加します。\n\n第2に、国民生活や経済活動を支える重要な基幹インフラの安定的な供給を確保するため、「医療分野」についても、その役務を提供するために導入される重要設備などを事前審査の対象に追加します。\n電子カルテや電子処方箋などの医療システムの安全性を高め、障害やサイバー攻撃による医療サービスへの影響を防ぎます。\n\n第3に、経済安全保障上重要な海外事業を支援するため、国際協力銀行（JBIC）の機能を拡充します。\n資源確保や重要インフラ整備など、日本にとって戦略的に重要な一方で採算性にリスクのある海外プロジェクトに対し、JBICを通じて民間のとるリスクを低減する形で資金を支援することで、こうしたプロジェクトを促進します。\n\n第4に、経済安全保障に関する調査研究を行う「総合的なシンクタンク」と、官民がリスクや対策を共有する「官民協議会」を創設します。\n調査分析体制や官民の連携を強化し、政府と企業が連携してリスクを早期に把握、迅速に対応できる体制を整備します。\n\n今回の法改正による新たな制度の下で、外交力・防衛力・経済力・技術力・情報力・人材力を含む総合的な国力を強化しつつ、我が国の平和と安全、繁栄を確保するため、経済安全保障の強化を進めてまいります。"}}},"rest_id":"2103747815742796025","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"899758","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103747815742796025","sortIndex":"2104464893389307843"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2103741768282063150"],"editable_until_msecs":"1790409697000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":282,"bookmarked":false,"conversation_id_str":"2103741768282063150","created_at":"Sat Sep 26 07:01:37 +0000 2026","display_text_range":[0,131],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/h8hDafZHFx","expanded_url":"https://x.com/takaichi_sanae/status/2103741768282063150/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103741659888730112","indices":[132,155],"media_key":"3_2103741659888730112","media_results":{"result":{"media_key":"3_2103741659888730112"}},"media_url_https":"https://pbs.twimg.com/media/HTH95MDbwAAjhE4.jpg","original_info":{"focus_rects":[{"h":1389,"w":2481,"x":0,"y":2034},{"h":2481,"w":2481,"x":0,"y":1040},{"h":2828,"w":2481,"x":0,"y":693},{"h":3521,"w":1761,"x":720,"y":0},{"h":3521,"w":2481,"x":0,"y":0}],"height":3521,"width":2481},"sizes":{"large":{"h":2048,"resize":"fit","w":1443},"medium":{"h":1200,"resize":"fit","w":846},"small":{"h":680,"resize":"fit","w":479},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/h8hDafZHFx"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/h8hDafZHFx","expanded_url":"https://x.com/takaichi_sanae/status/2103741768282063150/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103741659888730112","indices":[132,155],"media_key":"3_2103741659888730112","media_results":{"result":{"media_key":"3_2103741659888730112"}},"media_url_https":"https://pbs.twimg.com/media/HTH95MDbwAAjhE4.jpg","original_info":{"focus_rects":[{"h":1389,"w":2481,"x":0,"y":2034},{"h":2481,"w":2481,"x":0,"y":1040},{"h":2828,"w":2481,"x":0,"y":693},{"h":3521,"w":1761,"x":720,"y":0},{"h":3521,"w":2481,"x":0,"y":0}],"height":3521,"width":2481},"sizes":{"large":{"h":2048,"resize":"fit","w":1443},"medium":{"h":1200,"resize":"fit","w":846},"small":{"h":680,"resize":"fit","w":479},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/h8hDafZHFx"}]},"favorite_count":13904,"favorited":false,"full_text":"先の国会で成立した農作物の種苗に関する法律、『気候変動等対応品種法』について御紹介します。\n\n近年、厳しい夏の暑さが続いており、その影響は農業の現場にも広がっています。\n\n「昔と同じように作っているのに、実がならない」\n「暑さで野菜が傷んでしまい、出荷できない」 https://t.co/h8hDafZHFx","id_str":"2103741768282063150","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":201,"reply_count":642,"retweet_count":2198,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM3NDE3NjgyMjc1MjQ2MDg=","richtext":{"richtext_tags":[]},"text":"先の国会で成立した農作物の種苗に関する法律、『気候変動等対応品種法』について御紹介します。\n\n近年、厳しい夏の暑さが続いており、その影響は農業の現場にも広がっています。\n\n「昔と同じように作っているのに、実がならない」\n「暑さで野菜が傷んでしまい、出荷できない」\n全国の農家の皆様から、こうした切実な声が届いています。\n\nこのため、これからの日本の農業には、暑さに負けない、病気に負けない、安定してたくさん収穫できる「強い品種」が必要です。\n\nしかし、｢優れた品種｣を生み出すには、長い年月と努力の積み重ねが必要です。\nそこで、今回の法律では、産官学が力を合わせ、高温や病気に強い「優良品種」の開発と普及を進めることとしています。\n\n優れた日本の「品種」がどんどんと生まれ、農家の皆様が、これからも安心して農業を続けられるように、そして、日本の美味しい｢農産物｣を皆様の食卓へ届けられるように、高市内閣は、日本の｢強い農業｣の実現に取り組んでまいります。"}}},"rest_id":"2103741768282063150","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"388873","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103741768282063150","sortIndex":"2104464893389307842"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core