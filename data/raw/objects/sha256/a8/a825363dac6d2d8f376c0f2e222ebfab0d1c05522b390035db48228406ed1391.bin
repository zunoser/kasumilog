_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":179,"reply_count":59,"retweet_count":3011,"retweeted":false,"user_id_str":"714372536490852352"},"rest_id":"2104058782955589711","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"629939","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2104085552358379616","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"850","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104085552358379616","sortIndex":"2104464893389307861"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/qOa41OLgJQ"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3006075,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":550,"tweets":1817},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104066346250076416"],"editable_until_msecs":"1790487083000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":91,"bookmarked":false,"conversation_id_str":"2104066346250076416","created_at":"Sun Sep 27 04:31:23 +0000 2026","display_text_range":[0,147],"entities":{},"favorite_count":9819,"favorited":false,"full_text":"台風第 26 号が、本日（27 日）から 29 日頃にかけて強い勢力で南西諸島に接近し、週明け以降、本州の南を東進し、関東地方に接近するおそれがあります。\n\n台風が接近する沖縄地方や奄美地方では、30 日頃にかけて、高波、強風、高潮、土砂災害、低い土地の浸水、河川の増水に注意・警戒して下さい。","id_str":"2104066346250076416","is_quote_status":false,"lang":"ja","quote_count":131,"reply_count":575,"retweet_count":1234,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"disaportal.gsi.go.jp/maps/?ll=35.35…","expanded_url":"https://disaportal.gsi.go.jp/maps/?ll=35.353216,138.735352&z=5&base=pale&vs=c1j0l0u0t0h0z0","indices":[465,488],"url":"https://t.co/qOa41OLgJQ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQwNjYzNDYwNzgwOTc0MDg=","richtext":{"richtext_tags":[]},"text":"台風第 26 号が、本日（27 日）から 29 日頃にかけて強い勢力で南西諸島に接近し、週明け以降、本州の南を東進し、関東地方に接近するおそれがあります。\n\n台風が接近する沖縄地方や奄美地方では、30 日頃にかけて、高波、強風、高潮、土砂災害、低い土地の浸水、河川の増水に注意・警戒して下さい。\n\nまた、台風第 25号に伴う大雨により土砂災害や浸水被害が発生した千葉県や神奈川県でも、前線に伴う雨に加え、週の後半を中心に、台風の勢力や進路によっては警報級の大雨になる可能性もあります。\n\n特に、 これまでの記録的な大雨で地盤が緩んでいる地域では、少ない雨量でも土砂災害などが発生する危険があり、厳重な警戒が必要です。\n\n地元自治体が作成しているハザードマップなどで、お住まいのご自宅や地域が安全な場所かどうか、避難する場所や経路、避難情報の把握手段など、避難に備えて自らの避難行動を必ず確認し、備蓄品の確認、避難の際に持参する荷物をまとめるなども含め、事前の備えを進めて下さい。\n\nハザードマップをご覧になるには、こちらのサイト\nhttps://t.co/qOa41OLgJQ\nが便利です。\nスマートフォンでも閲覧でき、災害種別で「洪水・内水」や「土砂災害」を選択し、右下の位置情報の印を押すと、現在いる場所の危険性を確認できます。\n\nラジオ・テレビ・インターネットなどで、最新の防災気象情報や自治体からの避難情報に注意し、少しでも危険を感じれば、躊躇せず、早め早めに自らの命を守る行動をとっていただくよう、お願い申し上げます。\n\n政府としては、官邸危機管理センターに設置した「官邸連絡室」において、台風第 25号に伴う大雨による被害に対する救助活動、応急復旧などの災害応急対策とともに、台風第26 号や前線による大雨への対応について、自治体や関係機関と緊密に連携を図りながら、\n・国民の皆様に対する適時的確な情報提供、\n・被害状況の把握、\n・被害が発生した場合の人命第一の方針の下での災害応急対策\nなどに当たってまいります。"}}},"rest_id":"2104066346250076416","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"457768","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104066346250076416","sortIndex":"2104464893389307860"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2102896771261480960/AZbD-T0V?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_l