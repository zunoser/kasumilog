e":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103419591901024256/vid/avc1/480x852/_79fFN_zz_kvs_7e.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103419591901024256/vid/avc1/720x1280/8bfpGyErWeFjYUfK.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103419591901024256/vid/avc1/1080x1920/I-hVby8OI2Y_y4DD.mp4?tag=29"}]}}]},"favorite_count":380,"favorited":false,"full_text":"【1分でわかる！なぜいま三文書の改定？】  🤔「三文書ってなに？」 🤔「どうして改定する必要があるの？」 そんな疑問に1分でお答えします。\n \n現在の三文書を策定してから３年以上。\n安全保障環境はさらに大きく変化しています。 https://t.co/RhmUaDyv0I","id_str":"2103419906641576397","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":5,"retweet_count":105,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[529,533],"text":"三文書"},{"indices":[534,540],"text":"防衛力変革"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/henkaku/pdf/20251112b.pdf","indices":[296,319],"url":"https://t.co/JYGA2V8SvL"},{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/henkaku/pdf/20251218b.pdf","indices":[375,398],"url":"https://t.co/cLdhVmhk6Y"},{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"https://www.mod.go.jp/j/policy/agenda/meeting/henkaku/pdf/20260803c.pdf","indices":[453,476],"url":"https://t.co/jHy9eruHUa"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM0MTk5MDY0ODIxNTE0MjQ=","text":"【1分でわかる！なぜいま三文書の改定？】  🤔「三文書ってなに？」 🤔「どうして改定する必要があるの？」 そんな疑問に1分でお答えします。\n \n現在の三文書を策定してから３年以上。\n安全保障環境はさらに大きく変化しています。\nだからこそ、いま、新しい時代に対応した「防衛の在り方」を考える必要があるのです。\n \n防衛省・自衛隊は、本年中の三文書改定に向けて、国民の皆様の命と平和な暮らしを守り抜くため、何が必要か、具体的かつ現実的に議論を積み上げていきます。\n \n動画はほんの入り口です。\nご紹介しきれなかった詳細は、こちらをご覧ください。\n \n📌日本の周辺でどんなことが起こっているのか？\nhttps://t.co/JYGA2V8SvL\n※変革本部第2回資料　「我が国を取り巻く安全保障環境」へのリンク\n \n📌世界で見られる「新しい戦い方」とは？\nhttps://t.co/cLdhVmhk6Y\n※変革本部第3回資料　「ウクライナ侵略で見られる新しい戦い方と課題」へのリンク\n \n📌これからの方向性は？\nhttps://t.co/jHy9eruHUa\n※変革本部第9回資料　「現行の国家防衛戦略・防衛力整備計画の評価（課題と今後の方向性）」へのリンク\n \n#三文書\n#防衛力変革"}}},"rest_id":"2103419906641576397","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"23752","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2103422053483532682","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"5282","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103422053483532682","sortIndex":"2104464893389307820"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2101819263057375232/-X3ReYd9?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"上野大臣会見概要について紹介しています","type":"STRING"}},{"key":"domain","value":{"string_value":"www.mhlw.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2101819263057375232/-X3ReYd9?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2101819263057375232/-X3ReYd9?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_smal