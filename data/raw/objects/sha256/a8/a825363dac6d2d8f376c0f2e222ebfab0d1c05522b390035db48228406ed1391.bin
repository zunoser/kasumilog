h":1080},"sizes":{"large":{"h":1920,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":675},"small":{"h":680,"resize":"fit","w":383},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/4KGXnjOAlG","video_info":{"aspect_ratio":[9,16],"duration_millis":63800,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2103452789431218176/pl/LPyUKnWRgZLz5GBJ.m3u8?tag=29&v=cfc"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103452789431218176/vid/avc1/320x568/0eAzDRHbCoSnit_1.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103452789431218176/vid/avc1/480x852/m0DSn4lS8kLPN5sD.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103452789431218176/vid/avc1/720x1280/XMcAyAn0pf07zCA-.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2103452789431218176/vid/avc1/1080x1920/1FZX96ZbJrtwgvWr.mp4?tag=29"}]}}]},"favorite_count":2434,"favorited":false,"full_text":"「日本スタートアップ大賞2026」表彰式を開催しました。今回、内閣総理大臣賞に輝いたのは「株式会社Mujin」です。高市内閣では、戦略的な国内投資を全国に広げていくため、『日本成長戦略』において、「スタートアップ」を横断的課題の１つに位置付けています。スタートアップの皆様に、「戦略１７分 https://t.co/4KGXnjOAlG","id_str":"2103453003470745903","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":14,"reply_count":127,"retweet_count":273,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDM0NTMwMDM0Mjg4NDc2MTY=","richtext":{"richtext_tags":[]},"text":"「日本スタートアップ大賞2026」表彰式を開催しました。今回、内閣総理大臣賞に輝いたのは「株式会社Mujin」です。高市内閣では、戦略的な国内投資を全国に広げていくため、『日本成長戦略』において、「スタートアップ」を横断的課題の１つに位置付けています。スタートアップの皆様に、「戦略１７分野」の国内投資を牽引する重要な担い手になっていただくことを大いに期待しています。"}}},"rest_id":"