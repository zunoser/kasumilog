an_jp/status/2117165388840710463/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2117165378959007744","indices":[81,104],"media_key":"3_2117165378959007744","media_results":{"result":{"media_key":"3_2117165378959007744"}},"media_url_https":"https://pbs.twimg.com/media/HWGuseebYAAvh-d.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":92},{"h":1366,"w":1366,"x":682,"y":0},{"h":1366,"w":1198,"x":850,"y":0},{"h":1366,"w":683,"x":1246,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/iE9bJFnD0V"}]},"favorite_count":553,"favorited":false,"full_text":"11月2日、小田原防衛副大臣と上杉防衛大臣政務官は、防衛研究所を視察し、安全保障情勢に関する説明を受けたほか、防衛研究所が所蔵する貴重な史料などを見学しました。 https://t.co/iE9bJFnD0V","id_str":"2117165388840710463","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":4,"retweet_count":58,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcxNjUzODg3OTQ2MjYwNDg=","text":"11月2日、小田原防衛副大臣と上杉防衛大臣政務官は、防衛研究所を視察し、安全保障情勢に関する説明を受けたほか、防衛研究所が所蔵する貴重な史料などを見学しました。\n\n防衛研究所は、防衛省のシンクタンクであるとともに、日本唯一の国立の安全保障に関する学術研究機関です。安全保障などに関する調査研究を行い、幹部自衛官などへの教育や国外研究機関との交流、刊行物の出版などを行っています。"}}},"rest_id":"2117165388840710463","unmention_data":{},"views":{"count":"34288","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117165388840710463","sortIndex":"2117570482222923722"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicList