,{"h":59,"w":59,"x":553,"y":453},{"h":125,"w":125,"x":1037,"y":314},{"h":161,"w":161,"x":829,"y":205}]},"orig":{"faces":[{"h":120,"w":120,"x":658,"y":528},{"h":102,"w":102,"x":944,"y":774},{"h":214,"w":214,"x":1770,"y":536},{"h":276,"w":276,"x":1416,"y":350}]},"small":{"faces":[{"h":39,"w":39,"x":218,"y":175},{"h":33,"w":33,"x":313,"y":256},{"h":71,"w":71,"x":587,"y":177},{"h":91,"w":91,"x":470,"y":116}]}},"id_str":"2117164172094107648","indices":[115,138],"media_key":"3_2117164172094107648","media_results":{"result":{"media_key":"3_2117164172094107648"}},"media_url_https":"https://pbs.twimg.com/media/HWGtmOjacAAHg63.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":92},{"h":1536,"w":1536,"x":102,"y":0},{"h":1536,"w":1347,"x":197,"y":0},{"h":1536,"w":768,"x":486,"y":0},{"h":1536,"w":2048,"x":0,"y":0}],"height":1536,"width":2048},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xiy9iRKp30"}]},"favorite_count":407,"favorited":false,"full_text":"10月30日、小田原防衛副大臣は、トルコ共和国ナショナルデー・レセプションに出席し、オウズハン・エルトゥールル駐日大使やムスタファ・エルマス武官と懇談し日本とトルコの協力・連携を確認したほか、各国の関係者と懇談しました🇯🇵🤝🇹🇷 https://t.co/xiy9iRKp30","id_str":"2117164185411051783","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":5,"retweet_count":44,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcxNjQxODUzNTY1MDUwODg=","text":"10月30日、小田原防衛副大臣は、トルコ共和国ナショナルデー・レセプションに出席し、オウズハン・エルトゥールル駐日大使やムスタファ・エルマス武官と懇談し日本とトルコの協力・連携を確認したほか、各国の関係者と懇談しました🇯🇵🤝🇹🇷\n\nトルコは戦略的パートナーであり、幅広い分野での協力関係を発展させています。防衛省・自衛隊は、引き続き各レベルでの交流を通じ防衛協力を拡充していきます。"}}},"rest_id":"2117164185411051783","unmention_data":{},"views":{"count":"27312","state":"Enab