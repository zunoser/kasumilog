:680,"resize":"fit","w":520},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/T9rMDfoF8I"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/T9rMDfoF8I","expanded_url":"https://x.com/takaichi_sanae/status/2117457509539864963/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2117457381747785728","indices":[69,92],"media_key":"3_2117457381747785728","media_results":{"result":{"media_key":"3_2117457381747785728"}},"media_url_https":"https://pbs.twimg.com/media/HWK4RRobAAA7XII.jpg","original_info":{"focus_rects":[{"h":269,"w":481,"x":0,"y":0},{"h":362,"w":362,"x":23,"y":0},{"h":362,"w":318,"x":45,"y":0},{"h":362,"w":181,"x":114,"y":0},{"h":362,"w":481,"x":0,"y":0}],"height":362,"width":481},"sizes":{"large":{"h":362,"resize":"fit","w":481},"medium":{"h":362,"resize":"fit","w":481},"small":{"h":362,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/T9rMDfoF8I"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/T9rMDfoF8I","expanded_url":"https://x.com/takaichi_sanae/status/2117457509539864963/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":34,"w":34,"x":249,"y":383}]},"medium":{"faces":[{"h":34,"w":34,"x":249,"y":383}]},"orig":{"faces":[{"h":34,"w":34,"x":249,"y":383}]},"small":{"faces":[{"h":28,"w":28,"x":207,"y":319}]}},"id_str":"2117457381747736576","indices":[69,92],"media_key":"3_2117457381747736576","media_results":{"result":{"media_key":"3_2117457381747736576"}},"media_url_https":"https://pbs.twimg.com/media/HWK4RRoaQAA9FSg.jpg","original_info":{"focus_rects":[{"h":457,"w":816,"x":0,"y":51},{"h":508,"w":508,"x":52,"y":0},{"h":508,"w":446,"x":83,"y":0},{"h":508,"w":254,"x":179,"y":0},{"h":508,"w":816,"x":0,"y":0}],"height":508,"width":816},"sizes":{"large":{"h":508,"resize":"fit","w":816},"medium":{"h":508,"resize":"fit","w":816},"small":{"h":423,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/T9rMDfoF8I"}]},"favorite_count":13286,"favorited":false,"full_text":"毎月３日から７日までは「さかなの日」。\nその中でも、本日11月３日から７日は「いいさかなの日」となっていることを皆様はご存じでしょうか。 https://t.co/T9rMDfoF8I","id_str":"2117457509539864963","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":211,"reply_count":1247,"retweet_count":1380,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTc0NTc1MDk0NjQyNzY5OTI=","richtext":{"richtext_tags":[]},"text":"毎月３日から７日までは「さかなの日」。\nその中でも、本日11月３日から７日は「いいさかなの日」となっていることを皆様はご存じでしょうか。\n政府では、1,100を超える民間企業・団体の皆様と連携して、水産物の魅力や限りある水産資源を大切に使い続けることの重要性を発信する活動を展開しています。\n\n周りを海に囲まれた我が国では、昔から水産物が食卓を支えてきました。\nお寿司やお刺身、焼き魚、和食に欠かせない昆布やかつお節など、水産物は日本の多様な食文化を支えています。\n\nこれまで秋の旬の魚と言えば、サンマやサケなどを連想される方が多いのではないでしょうか。\n\nただ、近年は、我が国周辺の海で平均海面水温が過去最高を記録し、サンマやサケなどの不漁が続く一方で、これまで西の海で獲れていたブリやフグなどが北の海でも獲れるようになるなど、獲れる魚の種類や量が変化しています。\n\n現在、政府においては、来年春の閣議決定に向けて、水産に関する施策の総合的かつ計画的な推進を図るための『水産基本計画』の見直しに着手しています。\n\nその中では、こうした海洋環境の激変等に対応するため、\n・水産資源を持続的に利用するための「資源管理」の着実な実施、\n・未来の水産業を担う「経営基盤の強固な経営体」の創出、\n・「豊かで魅力ある浜づくり」など水産業の強靭化\nを進めることとしています。\n\n高市内閣が掲げる成長投資の戦略分野の一つである「陸上養殖」の推進も含め、水産業の「成長産業化」に全力で取り組んでまいります。\n\n11月はおいしいお魚が旬を迎える季節です。\n寒い季節に温まるブリ大根や昆布で出汁を取った鍋料理。\nまずは今週、旬の水産物を食卓へ！\n\n皆様も「いいさかなの日」に新鮮でおいしい水産物を食べて、日本の水産業を応援し、盛り上げてまいりましょう！"}}},"rest_id":"2117457509539864963","unmention_data":{},"views":{"count":"354961","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117457509539864963","sortIndex":"2117570482222923773"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":1},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/3692310981/5e84849fe6a5c60bc3a3818c6f4cbec4_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/286056244/1791195170"},"core":{"created_at":"Fri Apr 22 08:05:55 +0000 2011","name":"環境省","screen_name":"Kankyo_Jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODYwNTYyNDQ=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2115244872487833973"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"環境省の公式アカウントです。皆さまにお知らせしたい情報を発信していきます。なお、Xによせられたコメントへの返信はしておりません。運用方針はこちらhttps://t.co/5x04ocrpyS\n英語版Xはこちら @MOEJ_Climate","entities":{"description":{"urls":[{"display_url":"env.go.jp/info/sns/twitt…","expanded_url":"https://www.env.go.jp/info/sns/twitter.html","indices":[72,95],"url":"https://t.co/5x04ocrpyS"}]},"url":{"urls":[{"display_url":"env.go.jp/index.html","expanded_url":"https://www.env.go.jp/index.html","indices":[0,23],"url":"https://t.co/uhfdD6x8lt"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":355756,"following":67},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"286056244","super_follow_eligible":false,"super_followed_by":false,"super_