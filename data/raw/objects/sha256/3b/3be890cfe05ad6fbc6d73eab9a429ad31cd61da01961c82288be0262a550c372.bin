ls":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTc0NDg4MzM2NzY1MTczNzY=","richtext":{"richtext_tags":[]},"text":"今日は、文化の日です。\n\n午前中は宮中に参内し、文化勲章親授式に参列させていただきました。\n\n式典では、長年にわたり、それぞれの分野でご活躍され、大きなご功績を挙げられた8名の皆様に対し、天皇陛下から勲章が贈られました。\n\n受章された皆様、誠におめでとうございます。\n\nこれからもお元気で益々ご活躍されますことを、心からお祈り申し上げます。"}}},"rest_id":"2117448833722712480","unmention_data":{},"views":{"count":"434323","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117448833722712480","sortIndex":"2117570482222923771"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1793582764"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6l1S0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":298690,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4982,"tweets":12999},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2117444152346685903"],"editable_until_msecs":"1793676600000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":11,"bookmarked":false,"conversation_id_str":"2117444152346685903","created_at":"Tue Nov 03 02:30:00 +0000 2026","display_text_range":[0,152],"entities":{"media":[{"display_url":"pic.x.com/TfyFNNACak","expanded_url":"https://x.com/gov_online/status/2117444152346685903/photo/1","ext_alt_text":"上部に、地元のかかりつけ病院に行こうとしている親子のイラストが描かれている。その下には、次のように記載されている。「医療機関の上手なかかり方のポイント。1。日常的な病気は身近な診療所へ。待ち時間も少なく、大病院受診時のような定額料金がかかりません。2。できるだけ診療時間内に受診する。休日や夜間に受診すると追加の費用がかかることがあります。また、日中と診療体制も異なることから、検査などが十分にできないことがあります。3。かかりつけ医をもつ。体調の変化で気になることを気軽に相談でき、必要に応じて大病院を紹介してもらえます。上手に医療機関にかかり、医療費や待ち時間の負担を減らしましょう。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2117146419689885696","indices":[153,176],"media_key":"3_2117146419689885696","media_results":{"result":{"media_key":"3_2117146419689885696"}},"media_url_https":"https://pbs.twimg.com/media/HWGdc5sbEAAQpeq.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":928},{"h":1200,"w":1200,"x":0,"y":400},{"h":1368,"w":1200,"x":0,"y":232},{"h":1600,"w":800,"x":200,"y":0},{"h":1600,"w":1200,"x":0,"y":0}],"height":1600,"width":1200},"sizes":{"large":{"h":1600,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/TfyFNNACak"}],"urls":[{"display_url":"gov-online.go.jp/article/201902…","expanded_url":"https://www.gov-online.go.jp/article/201902/entry-8921.html","indices":[129,152],"url":"https://t.co/5RR5pA58TY"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/TfyFNNACak","expanded_url":"https://x.com/gov_online/status/2117444152346685903/photo/1","ext_alt_text":"上部に、地元のかかりつけ病院に行こうとしている親子のイラストが描かれている。その下には、次のように記載されている。「医療機関の上手なかかり方のポイント。1。日常的な病気は身近な診療所へ。待ち時間も少なく、大病院受診時のような定額料金がかかりません。2。できるだけ診療時間内に受診する。休日や夜間に受診すると追加の費用がかかることがあります。また、日中と診療体制も異なることから、検査などが十分にできないことがあります。3。かかりつけ医をもつ。体調の変化で気になることを気軽に相談でき、必要に応じて大病院を紹介してもらえます。上手に医療機関にかかり、医療費や待ち時間の負担を減らしましょう。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2117146419689885696","indices":[153,176],"media_key":"3_2117146419689885696","media_results":{"result":{"media_key":"3_2117146419689885696"}},"media_url_https":"https://pbs.twimg.com/media/HWGdc5sbEAAQpeq.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":928},{"h":1200,"w":1200,"x":0,"y":400},{"h":1368,"w":1200,"x":0,"y":232},{"h":1600,"w":800,"x":200,"y":0},{"h":1600,"w":1200,"x":0,"y":0}],"height":1600,"width":1200},"sizes":{"large":{"h":1600,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/TfyFNNACak"}]},"favorite_count":68,"favorited":false,"full_text":"「なんとなく安心だから」と、いきなり大病院を選ぶなどしていませんか？🏥\n\n受診の仕方によっては、待ち時間が長くなったり、追加で費用がかかったりすることもあります。\n上手に医療機関にかかるポイントをご紹介します。\n\n11月は「みんなで医療を考える月間」です。\nhttps://t.co/5RR5pA58TY https://t.co/TfyFNNACak","id_str":"2117444152346685903","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":6,"retweet_count":26,"retweeted":false,"user_id_str":"461064204"},"rest_id":"2117444152346685903","unmention_data":{},"views":{"count":"6235","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117444152346685903","sortIndex":"2117570482222923770"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/JX6Zp2nPb7"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzY2ODI3OTE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関 "},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2001095001481076943"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国税庁の公式アカウントです。税に関する情報を提供します。税務行政に対するご意見・ご要望は国税庁ホームページまで。https://t