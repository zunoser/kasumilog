}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/LKyOqTEKuG"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/LKyOqTEKuG","expanded_url":"https://x.com/takaichi_sanae/status/2117208994544492598/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":81,"w":81,"x":1143,"y":1067},{"h":115,"w":115,"x":1093,"y":207},{"h":105,"w":105,"x":795,"y":319},{"h":105,"w":105,"x":461,"y":319},{"h":123,"w":123,"x":1373,"y":279}]},"medium":{"faces":[{"h":48,"w":48,"x":670,"y":625},{"h":67,"w":67,"x":640,"y":121},{"h":61,"w":61,"x":466,"y":187},{"h":61,"w":61,"x":270,"y":187},{"h":72,"w":72,"x":804,"y":163}]},"orig":{"faces":[{"h":104,"w":104,"x":1452,"y":1355},{"h":147,"w":147,"x":1388,"y":264},{"h":134,"w":134,"x":1010,"y":406},{"h":134,"w":134,"x":586,"y":406},{"h":157,"w":157,"x":1744,"y":355}]},"small":{"faces":[{"h":27,"w":27,"x":379,"y":354},{"h":38,"w":38,"x":363,"y":69},{"h":35,"w":35,"x":264,"y":106},{"h":35,"w":35,"x":153,"y":106},{"h":41,"w":41,"x":456,"y":92}]}},"id_str":"2117208960042438656","indices":[100,123],"media_key":"3_2117208960042438656","media_results":{"result":{"media_key":"3_2117208960042438656"}},"media_url_https":"https://pbs.twimg.com/media/HWHWVOqakAAXZED.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":628,"y":0},{"h":1734,"w":1521,"x":735,"y":0},{"h":1734,"w":867,"x":1062,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/LKyOqTEKuG"}]},"favorite_count":8990,"favorited":false,"full_text":"本日、「防災士アンバサダー」の野口絵子さんが官邸にお見えになりました。\n\n災害対応の知識や技能を持つ「防災士」の皆様のお力は、これからの大きな災害に備え、地域の災害対応力を強化するために不可欠です。 https://t.co/LKyOqTEKuG","id_str":"2117208994544492598","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":91,"reply_count":967,"retweet_count":954,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcyMDg5OTQ0ODk5OTkzNjA=","richtext":{"richtext_tags":[]},"text":"本日、「防災士アンバサダー」の野口絵子さんが官邸にお見えになりました。\n\n災害対応の知識や技能を持つ「防災士」の皆様のお力は、これからの大きな災害に備え、地域の災害対応力を強化するために不可欠です。\n\n野口さんから、「防災士」の皆様が、防災意識の向上や基礎的知識の普及に熱心に取り組んで下さっていることを伺い、大変心強く感じました。\n\n本日発足した防災庁は、災害対応の司令塔として、我が国の産学官民の力を結集して取り組んでいきます。\n「防災士」の皆様にも、是非お力添えを賜りたく、よろしくお願い申し上げます。"}}},"rest_id":"2117208994544492598","unmention_data":{},"views":{"count":"300515","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117208994544492598","sortIndex":"2117570482222923752"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"locat