se,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":25,"reply_count":35,"retweet_count":454,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcyNDI4MjM0ODk3ODE3NjA=","text":"令和８年１１月２日（月）午前から午後にかけて、中国軍の偵察型無人機（ＷＺ－７）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、宮古島の南方沖から沖縄本島の南方沖にかけて飛行を行った後、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nまた、同日午後、中国軍の偵察型無人機（ＷＺ－７）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、宮古島の南方沖から沖縄本島の南方沖にかけて飛行を行った後、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\nこれらに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"rest_id":"2117242823535960246","unmention_data":{},"views":{"count":"260314","state":"EnabledWithCount"}}},"rest_id":"2117247605726195979","unmention_data":{},"views":{"count":"233871","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117247605726195979","sortIndex":"2117570482222923767"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_m