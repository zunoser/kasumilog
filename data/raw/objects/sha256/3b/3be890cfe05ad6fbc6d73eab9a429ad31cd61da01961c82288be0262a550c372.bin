deo/2117219043564556288/vid/avc1/480x270/2mEKTTedT-gnKrId.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2117219043564556288/vid/avc1/640x360/Q2G5gRu06vy_TpXn.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2117219043564556288/vid/avc1/1280x720/OgRmGKlUABC52U5A.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/D6lAud1nct","expanded_url":"https://x.com/kantei/status/2117219119707926651/video/1","ext_media_availability":{"status":"Available"},"id_str":"2117219043564556288","indices":[88,111],"media_key":"13_2117219043564556288","media_results":{"result":{"media_key":"13_2117219043564556288"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2117219043564556288/img/qUhgmGIjP3Q4NoEn.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/D6lAud1nct","video_info":{"aspect_ratio":[16,9],"duration_millis":210433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2117219043564556288/pl/lyq7NO98FFwH57r_.m3u8?tag=29&v=2e7"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2117219043564556288/vid/avc1/480x270/2mEKTTedT-gnKrId.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2117219043564556288/vid/avc1/640x360/Q2G5gRu06vy_TpXn.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2117219043564556288/vid/avc1/1280x720/OgRmGKlUABC52U5A.mp4?tag=29"}]}}]},"favorite_count":4438,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２日）、高市総理は、防災庁発足式に出席しました。\n\n※高市総理発言要旨（速報版）\n　皆様、お疲れ様でございます。\n　本日、「防災庁」が発足しました。 https://t.co/D6lAud1nct","id_str":"2117219119707926651","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":54,"reply_count":246,"retweet_count":623,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcyMTkxMTk2MjgxNjEwMjQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２日）、高市総理は、防災庁発足式に出席しました。\n\n※高市総理発言要旨（速報版）\n　皆様、お疲れ様でございます。\n　本日、「防災庁」が発足しました。\n　細野大臣、金子副大臣、大西大臣政務官をはじめ、お集まりの皆様と共に新たな一歩を踏み出せることを、心強く存じます。\n　国民の皆様の「命と暮らし」を守り抜くことは、国家の最も大切な責務の一つです。\n　我が国は、これまで、数多くの災害に見舞われ、多くの方々の、尊い命が失われました。\n　「南海トラフ地震」などが切迫している中で、自然災害自体を防ぐことはできませんが、事前の備えで、被害を減らすことはできます。\n　防災・減災で災害に強い国をつくることは、「日本列島を、強く豊かに。」することそのものです。\n　防災庁の皆様には、事前防災など平時の備えから、発災時の初動対応、そして避難所の設置・物資供給、復旧・復興を一気通貫で行う「災害対応の司令塔」として、「切れ目のない防災行政」を担っていただきます。\n　地域ごとのリスクや府省庁の縦割り、そして、対策の漏れを見逃さずに、「強い司令塔」として、各府省庁を動かして下さい。\n　想定外をつくらないために、あらゆる事態を考え抜き、必要なことは、躊躇なく決断し、実行して下さい。\n　災害対応では、１分、１秒の遅れが、国民の皆様の命を左右します。\n　政府一丸となった災害対応の要として、平時から関係機関と緊密に連携しながら、災害対応力を磨き上げて下さい。\n　皆様の仕事の先には、支援を待つ方々がおられます。\n　避難環境の抜本的な改善に加え、ワンストップ窓口として、復旧・復興まで、被災地に伴走して下さい。\n　もとより、防災は、国だけで成し遂げられるものではありません。\n　産学官民の要となって、企業、大学、NPO、また、ボランティアなどとの連携を一層加速させて下さい。\n　また、日本の防災技術と経験は、世界に誇れる財産です。\n　防災産業を成長の力に変え、日本の知見・製品・サービス・インフラを世界に広げる取組も進めて下さい。\n　災害は、今、この瞬間にも起こり得ます。\n　国民の皆様の「命と暮らし」を、守り抜く。そのために、一切の妥協はしない。\n　この覚悟の下、「世界一の防災大国」を目指して、共に力を尽くしてまいりましょう。\n　よろしくお願いいたします。ありがとうございます。"}}},"rest_id":"2117219119707926651","unmention_data":{},"views":{"count":"122606","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117219119707926651","sortIndex":"2117570482222923760"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineT