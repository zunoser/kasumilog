user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcxNjQ4MTY0Nzc2MDE3OTI=","text":"令和８年１１月１日、中国海軍ルーヤンⅢ級ミサイル駆逐艦及びフユ級高速戦闘支援艦の計２隻が、沖縄本島と宮古島との間の海域を北西進し、東シナ海に向けて航行したことを確認しました。\nまた、１１月２日、中国海軍ルーヤンⅢ級ミサイル駆逐艦及びフチ級補給艦の計２隻が、沖縄本島と宮古島との間の海域を南東進し、太平洋に向けて航行したことを確認しました。\n防衛省・自衛隊は、海上自衛隊の第１航空群所属「Ｐ－１」（鹿屋）及び第５航空群所属「Ｐ－３Ｃ」（那覇）により、警戒監視・情報収集を行いました。"}}},"rest_id":"2117164816515387626","unmention_data":{},"views":{"count":"62420","state":"EnabledWithCount"}}},"rest_id":"2117167324377862556","unmention_data":{},"views":{"count":"38721","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117167324377862556","sortIndex":"2117570482222923727"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116726937171226652"]},"possibly_sensitive":false,"