ed_url":"https://x.com/meti_NIPPON/status/2117218870092267937/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2117217887127773184","indices":[141,164],"media_key":"3_2117217887127773184","media_results":{"result":{"media_key":"3_2117217887127773184"}},"media_url_https":"https://pbs.twimg.com/media/HWHec2paoAAPQZC.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":184},{"h":3072,"w":3072,"x":1024,"y":0},{"h":3072,"w":2695,"x":1401,"y":0},{"h":3072,"w":1536,"x":2201,"y":0},{"h":3072,"w":4096,"x":0,"y":0}],"height":3072,"width":4096},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6RY4e25aLf"}]},"favorite_count":272,"favorited":false,"full_text":"赤澤大臣は、防災士アンバサダーを務めるミス日本グランプリの野口氏と面談。災害対策としての事前防災の重要性に加え、災害時に、たいしたことではない、自分は大丈夫と思い込んでしまう「正常性バイアス」を乗り越える重要性について、発信力のある防災士アンバサダーとして、社会全体に広く発信して https://t.co/6RY4e25aLf","id_str":"2117218870092267937","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"reply_count":6,"retweet_count":70,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[204,216],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTcyMTg4NzAwNDE5MzE3NzY=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、防災士アンバサダーを務めるミス日本グランプリの野口氏と面談。災害対策としての事前防災の重要性に加え、災害時に、たいしたことではない、自分は大丈夫と思い込んでしまう「正常性バイアス」を乗り越える重要性について、発信力のある防災士アンバサダーとして、社会全体に広く発信していただきたいとの期待を述べました。経済産業省としても、本日発足した防災庁と緊密に連携し、災害対応力の抜本的強化を進めていきます。#meti_daijin"}}},"rest_id":"2117218870092267937","unmention_data":{},"views":{"count":"18659","state":"EnabledWithCount"}}}}},"entryId":"tweet-2117218870092267937","sortInde