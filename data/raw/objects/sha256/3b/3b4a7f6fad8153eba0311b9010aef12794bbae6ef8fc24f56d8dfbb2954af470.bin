fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/oZIpeVYRRC"}]},"favorite_count":1946,"favorited":false,"full_text":"9月21日、インドネシアにおける国際緊急援助活動のため派遣されている輸送艦「くにさき」が、カリマンタン島クタパン沖に到着しました。準備が整い次第、クタパン沖の「くにさき」からCH-47輸送ヘリコプターにより消火活動を実施予定です。 https://t.co/oZIpeVYRRC","id_str":"2101924308927066150","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"quoted_status_id_str":"2101532257395806708","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2101532257395806708","url":"https://t.co/i9MVSa3vzC"},"reply_count":27,"retweet_count":285,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE5MjQzMDg4NzI0OTkyMDA=","text":"9月21日、インドネシアにおける国際緊急援助活動のため派遣されている輸送艦「くにさき」が、カリマンタン島クタパン沖に到着しました。準備が整い次第、クタパン沖の「くにさき」からCH-47輸送ヘリコプターにより消火活動を実施予定です。\n\n防衛省・自衛隊は、引き続き現地の状況を踏まえながら、関係機関と連携して対応してまいります。"}}},"previous_counts":{"bookmark_count":0,"favorite_count":6,"quote_count":0,"reply_count":0,"retweet_count":2},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2101532257395806708"}},"rest_id":"2101924308927066150","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"137805","state":"EnabledWithCount"}}},"rest_id":"2102356940731072831","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"41684","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102356940731072831","sortIndex":"2102638901133836250"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"