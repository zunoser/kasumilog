_count":9,"retweet_count":63,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/fp/unp/p…","expanded_url":"https://www.mofa.go.jp/mofaj/fp/unp/pageit_000001_03207.html","indices":[211,234],"url":"https://t.co/P8PqhzcVib"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIxNzc3OTA1MjMyNDg2NDI=","richtext":{"richtext_tags":[]},"text":"米国・ニューヨークを訪問中の茂木外務大臣は、イスハーク・ダール・パキスタン副首相兼外務大臣と会談を行いました。茂木大臣から、2027年の日・パキスタン外交関係樹立75周年に向けて、二国間関係を更に強化していきたい旨述べました。また、イラン情勢の沈静化に向けた、ダール副首相をはじめとするパキスタン政府の仲介努力に改めて敬意を表し、国際情勢が一層厳しさと複雑さを増す中、ダール副首相と緊密に連携していきたい旨述べました。\n\nhttps://t.co/P8PqhzcVib"}}},"rest_id":"2102177790644928889","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"38805","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102177790644928889","sortIndex":"2102638901133836233"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permiss