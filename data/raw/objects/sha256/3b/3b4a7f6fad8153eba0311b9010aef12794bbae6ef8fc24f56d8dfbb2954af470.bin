atio":[16,9],"duration_millis":281466,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2102479761595666432/pl/exIjdb1BPR1Bh6lB.m3u8?tag=29"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102479761595666432/vid/avc1/480x270/fJC1pZGwyjyyEbdd.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102479761595666432/vid/avc1/640x360/1o2BEDg7LTya86S8.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102479761595666432/vid/avc1/1280x720/MGRpCraJz5rcuK3q.mp4?tag=29"}]}}]},"favorite_count":27471,"favorited":false,"full_text":"【お知らせ】\n９月２２日（現地時間）、高市総理は、米国のトランプ大統領と会談を行いました。\n \n※両首脳による冒頭発言要旨（速報版、仮訳）\n（トランプ大統領） https://t.co/Z2gBgyHac2","id_str":"2102480506080391213","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":578,"reply_count":745,"retweet_count":5264,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDI0ODA1MDYwMDA2ODcxMDQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n９月２２日（現地時間）、高市総理は、米国のトランプ大統領と会談を行いました。\n \n※両首脳による冒頭発言要旨（速報版、仮訳）\n（トランプ大統領）\n　ありがとうございます。大変に尊敬されている日本の総理大臣と御一緒できるのは光栄です。総理は素晴らしい仕事をしてきました。総理の数字、私はいつもあなたの数字を見ていますが、日本の産業は非常にうまくいっています。日本はうまくいっています。極めて大きな進展で、総理と御一緒できるのは光栄です。総理は私の友人です。これまでの期間に互いをよく知るようになりました。彼女は偉大な総理大臣になるでしょう。歴代の偉大な総理大臣の一人として名を残すことになります。\n　そして今回も同じ顔ぶれの同席者の皆さんの中には、長年にわたってよく知っている人も何人かいます。彼らはタフで頭が切れます。あなた方と御一緒できて光栄です。本当にありがとうございます。\n \n（高市総理）\n　ドナルドが日米同盟に非常に力強くコミットメントしてくれていること、改めて感謝します。今、アジアも含めてですね、非常に安全保障環境が厳しい中で、今日、私たちが、ドナルドと私が国連本部でこうやって首脳会談をするということは、世界に向けて日米同盟の強さを示すことになると考えています。\n　知っていらっしゃると思いますけれども、先週私は内閣改造を行いました。１８人の閣僚のうち１０人が交代するという大きな改造でした。しかし、御安心ください。皆さんのカウンターパートはみんな留任しました。茂木外務大臣、それから片山財務大臣、そして赤澤経済産業大臣、そして小泉防衛大臣です。これからも政策責任者同士の人間関係をさらに深化させて日米同盟を揺るぎないものにしていきたいと考えています。\n　今、AＩですとか半導体ですとか、重要鉱物など、ドナルドと私のリーダーシップのおかげで、日米間で経済安全保障の協力も進んでいます。\n　今日はたくさんのイシューをお話ししたいので、そろそろ会談を始めましょう。ありがとう。"}}},"rest_id":"2102480506080391213","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2629625","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102480506080391213","sortIndex":"2102638901133836255"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2102638901133836322-tweet-2102464179596861862","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"