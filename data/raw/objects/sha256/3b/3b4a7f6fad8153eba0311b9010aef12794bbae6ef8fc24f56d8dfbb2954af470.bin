t":{"media_key":"3_2102233972814307328"}},"media_url_https":"https://pbs.twimg.com/media/HSyiqQBa4AAkaCu.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":139},{"h":720,"w":720,"x":0,"y":0},{"h":720,"w":632,"x":0,"y":0},{"h":720,"w":360,"x":0,"y":0},{"h":720,"w":960,"x":0,"y":0}],"height":720,"width":960},"sizes":{"large":{"h":720,"resize":"fit","w":960},"medium":{"h":720,"resize":"fit","w":960},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YUTBnfUknU"},{"display_url":"pic.x.com/YUTBnfUknU","expanded_url":"https://x.com/TEPCOPG/status/2102234485802885414/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2102233972822749184","indices":[113,136],"media_key":"3_2102233972822749184","media_results":{"result":{"media_key":"3_2102233972822749184"}},"media_url_https":"https://pbs.twimg.com/media/HSyiqQDbsAAOmGR.jpg","original_info":{"focus_rects":[{"h":526,"w":940,"x":0,"y":0},{"h":705,"w":705,"x":235,"y":0},{"h":705,"w":618,"x":322,"y":0},{"h":705,"w":353,"x":458,"y":0},{"h":705,"w":940,"x":0,"y":0}],"height":705,"width":940},"sizes":{"large":{"h":705,"resize":"fit","w":940},"medium":{"h":705,"resize":"fit","w":940},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YUTBnfUknU"}]},"favorite_count":869,"favorited":false,"full_text":"【台風25号による影響について】\n台風25号の影響により、現在、千葉エリアを中心に約4万6千軒の停電が発生しております。 (9/22 12:00時点)\n多大なるご不便とご迷惑をおかけしておりますことを深くお詫び申し上げます。 https://t.co/YUTBnfUknU","id_str":"2102234485802885414","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":34,"reply_count":25,"retweet_count":536,"retweeted":false,"user_id_str":"1244515141376303104"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"teideninfo.tepco.co.jp","expanded_url":"https://teideninfo.tepco.co.jp","indices":[218,241],"url":"https://t.co/q9DAMC1zLW"},{"display_url":"tepco.co.jp/pg/user/contac…","expanded_url":"https://www.tepco.co.jp/pg/user/contact.html","indices":[364,387],"url":"https://t.co/A1FSwV5Oeu"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIyMzQ0ODU3MDIyMzgyMDg=","richtext":{"richtext_tags":[]},"text":"【台風25号による影響について】\n台風25号の影響により、現在、千葉エリアを中心に約4万6千軒の停電が発生しております。 (9/22 12:00時点)\n多大なるご不便とご迷惑をおかけしておりますことを深くお詫び申し上げます。\n停電件数の多い千葉県に復旧作業班を重点的に配置し、停電が継続しているお客さまに一刻も早く電気をお届けできるよう、引き続き全力で復旧作業を進めてまいります。\n\n最新の停電情報については、こちらでご確認ください。\nhttps://t.co/q9DAMC1zLW\n\n台風の影響により電線が切れたり、電線に樹木や看板、アンテナなどが接触したりすることがあります。\n大変危険ですので絶対に近づかないでください。また、切れた電線を発見した場合は、すぐに東京電力までご連絡ください。\nご連絡・お問い合わせはこちら。\nhttps://t.co/A1FSwV5Oeu"}}},"previous_counts":{"bookmark_count":0,"favorite_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"rest_id":"2102234485802885414","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"258613","state":"EnabledWithCount"}}},"user_id_str":"266566401"},"rest_id":"2102286640358240268","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"945","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102286640358240268","sortIndex":"2102638901133836248"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.tw