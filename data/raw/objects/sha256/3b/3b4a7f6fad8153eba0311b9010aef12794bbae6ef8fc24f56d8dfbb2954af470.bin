ttps":"https://pbs.twimg.com/media/HS3WjDlWMAAgxx5.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":85,"y":0},{"h":1734,"w":867,"x":412,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KkRfXJZ735"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/KkRfXJZ735","expanded_url":"https://x.com/takaichi_sanae/status/2102573739888021796/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":87,"w":87,"x":847,"y":557}]},"medium":{"faces":[{"h":51,"w":51,"x":496,"y":326}]},"orig":{"faces":[{"h":111,"w":111,"x":1076,"y":708}]},"small":{"faces":[{"h":29,"w":29,"x":281,"y":185}]}},"id_str":"2102572510415933440","indices":[100,123],"media_key":"3_2102572510415933440","media_results":{"result":{"media_key":"3_2102572510415933440"}},"media_url_https":"https://pbs.twimg.com/media/HS3Wju3X0AAA4vJ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":247},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":85,"y":0},{"h":1734,"w":867,"x":412,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KkRfXJZ735"}]},"favorite_count":12165,"favorited":false,"full_text":"米国・ニューヨークにおける国連総会ハイレベルウィークの際に、ゼレンスキー・ウクライナ大統領（@ZelenskyyUa）と首脳会談を行いました。\n\n今年6月にエビアンでお話して以来の再会となりました。 https://t.co/KkRfXJZ735","id_str":"2102573739888021796","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":200,"reply_count":671,"retweet_count":1887,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"1120633726478823425","indices":[46,58],"name":"Volodymyr Zelenskyy / Володимир Зеленський","screen_name":"ZelenskyyUa"}]},"id":"Tm90ZVR3ZWV0OjIxMDI1NzM3Mzk4MTI1MzIyMjU=","richtext":{"richtext_tags":[]},"text":"米国・ニューヨークにおける国連総会ハイレベルウィークの際に、ゼレンスキー・ウクライナ大統領（@ZelenskyyUa）と首脳会談を行いました。\n\n今年6月にエビアンでお話して以来の再会となりました。\n\n私からは、ゼレンスキー大統領の強いリーダーシップのもと、祖国の平和のために立ち向かうウクライナの人々に改めて敬意を表するとともに、一日でも早く「公正かつ永続的な平和」を実現するため、各国が結束してウクライナを支えることが不可欠である旨、強調しました。\n\nまた、我が国はウクライナと共にあり、その方針に揺るぎはなく、国際社会と連携し、ウクライナ支援と対露制裁に取り組んでいく旨を述べました。\n\nゼレンスキー大統領からは、我が国のこれまでの支援に感謝が示されるとともに、現下のウクライナの取組に関して説明がありました。\n\nこれからも、日本としてウクライナを支えるべく、ゼレンスキー大統領と連携してまいります。"}}},"rest_id":"2102573739888021796","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"408037","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102573739888021796","sortIndex":"2102638901133836270"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"