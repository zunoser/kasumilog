回包括的核実験禁止条約（CTBT）フレンズ外相会合に出席しました。茂木大臣は、共同議長としてステートメントを行い、これまでの日本の貢献に言及するとともに、CTBTの普遍化の進展、実効性の確保、人材育成の推進という過去30年間の実績を未来への土台とし、CTBTの早期発効及び核軍縮の進展に向けて共に取り組んでいくことを訴えました。\n\nhttps://t.co/dzo7yLx8JR"}}},"rest_id":"2102538386171101346","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"30352","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102538386171101346","sortIndex":"2102638901133836262"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"broadcast_url","value":{"string_value":"https://x.com/i/broadcasts/1jGXgBdoeEjKZ","type":"STRING"}},{"key":"broadcast_width","value":{"string_value":"1920","type":"STRING"}},{"key":"broadcast_state","value":{"string_value":"ENDED","type":"STRING"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"412940784","path":[]}}},{"key":"broadcast_title","value":{"string_value":"高市内閣総理大臣 国連総会一般討論演説ー令和8年9月23日","type":"STRING"}},{"key":"broadcast_source","value":{"string_value":"LiveCms","type":"STRING"}},{"key":"broadcast_orientation","value":{"string_value":"0","type":"STRING"}},{"key":"broadcast_id","value":{"string_value":"1jGXgBdoeEjKZ","type":"STRING"}},{"key":"broadcast_thumbnail_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2102543803295162368/xI3IR45q?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"broadcaster_twitter_id","value":{"string_value":"412940784","type":"STRING"}},{"key":"broadcast_height","value":{"string_value":"1080","type":"STRING"}},{"key":"broadcast_thumbnail_original","value":{"image_value":{"h