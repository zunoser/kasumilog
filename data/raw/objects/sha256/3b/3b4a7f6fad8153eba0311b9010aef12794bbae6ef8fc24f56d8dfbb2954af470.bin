51,"favorited":false,"full_text":"米国・ニューヨークを訪問中の茂木外務大臣は、シシル・カナル・ネパール外務大臣と会談を行いました。茂木大臣は、ネパールが未曾有の災害により甚大な被害を受けたことについて、犠牲者に哀悼の誠を捧げ、お見舞いを伝えつつ、日本はネパールと共にあり、長年の友人であるネパールのために、できるこ https://t.co/a11vN1kK9Z","id_str":"2102183585461748024","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":7,"retweet_count":96,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/pageit_0…","expanded_url":"https://www.mofa.go.jp/mofaj/pageit_000001_03209.html","indices":[220,243],"url":"https://t.co/fNoLtyV0IE"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIxODM1ODUzNDQyNzg1Mjg=","richtext":{"richtext_tags":[]},"text":"米国・ニューヨークを訪問中の茂木外務大臣は、シシル・カナル・ネパール外務大臣と会談を行いました。茂木大臣は、ネパールが未曾有の災害により甚大な被害を受けたことについて、犠牲者に哀悼の誠を捧げ、お見舞いを伝えつつ、日本はネパールと共にあり、長年の友人であるネパールのために、できることは全て行う考えである旨述べました。また、茂木大臣は、2026年は日・ネパール外交関係樹立70周年であり、両国の友好関係の更なる深化に期待する旨述べました。\n\nhttps://t.co/fNoLtyV0IE"}}},"rest_id":"2102183585461748024","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"43139","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102183585461748024","sortIndex":"2102638901133836235"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_ur