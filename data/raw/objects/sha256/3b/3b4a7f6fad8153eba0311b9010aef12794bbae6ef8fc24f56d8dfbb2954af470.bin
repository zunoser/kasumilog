":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/p08z4QYqKZ"}]},"favorite_count":677,"favorited":false,"full_text":"国際緊急援助活動が自衛隊の行動として位置付けられた平成４年（１９９２年）以降、インドネシア共和国で自衛隊が国際緊急援助活動を実施するのは、今回で６回目となります。 https://t.co/p08z4QYqKZ","id_str":"2102356940731072831","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"quoted_status_id_str":"2101924308927066150","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2101924308927066150","url":"https://t.co/TChVUmY5NX"},"reply_count":13,"retweet_count":93,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIzNTY5NDA2MzQ2NzMxNTI=","text":"国際緊急援助活動が自衛隊の行動として位置付けられた平成４年（１９９２年）以降、インドネシア共和国で自衛隊が国際緊急援助活動を実施するのは、今回で６回目となります。\n\n自衛隊はこれまで、インドネシアにおいて地震・津波災害への対応や航空機の捜索救難活動などを実施し、今回は、国際緊急援助活動として、初めて山林火災の消火活動に取り組んでいます。\n\n防衛省・自衛隊は、被害の拡大防止に向けて、引き続きインドネシアへの支援に全力で取り組んでまいります。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_ta