734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/ldFzCMjTVJ"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/ldFzCMjTVJ","expanded_url":"https://x.com/takaichi_sanae/status/2102568851720241304/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":239,"w":239,"x":273,"y":481}]},"medium":{"faces":[{"h":140,"w":140,"x":160,"y":282}]},"orig":{"faces":[{"h":304,"w":304,"x":347,"y":611}]},"small":{"faces":[{"h":79,"w":79,"x":90,"y":159}]}},"id_str":"2102568318112571392","indices":[80,103],"media_key":"3_2102568318112571392","media_results":{"result":{"media_key":"3_2102568318112571392"}},"media_url_https":"https://pbs.twimg.com/media/HS3SvtUXIAA4S-s.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/ldFzCMjTVJ"}]},"favorite_count":16000,"favorited":false,"full_text":"現地時間22日13時過ぎから、国連総会出席のため訪問中の米国・ニューヨークにて、トランプ大統領(@realDonaldTrump)と日米首脳会談を行いました。 https://t.co/ldFzCMjTVJ","id_str":"2102568851720241304","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":134,"reply_count":497,"retweet_count":2100,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"25073877","indices":[48,64],"name":"Donald J. Trump","screen_name":"realDonaldTrump"}]},"id":"Tm90ZVR3ZWV0OjIxMDI1Njg4NTE2NDA2MjMxMDQ=","richtext":{"richtext_tags":[]},"text":"現地時間22日13時過ぎから、国連総会出席のため訪問中の米国・ニューヨークにて、トランプ大統領(@realDonaldTrump)と日米首脳会談を行いました。\n\nトランプ大統領にお会いするのは、本年6月のG7エビアンサミット以来4回目でしたが、今回も非常に打ち解けた雰囲気の中で、幅広い分野での協力や地域情勢についてしっかりと議論することができました。\n\n日米両国が共に高い関心をもって取り組んでいる経済安全保障については、AIや半導体、重要鉱物といった分野で、技術競争に勝ち、強靱性を高めるための協力を確認し、これを更に強化していくこととしました。\n\nまた、関税に係る日米間の合意についても、着実な実施の重要性を改めて確認し、双方で協力を進めていくことで一致しました。\n\n中国・北朝鮮などについてもトランプ大統領との間で率直な意見交換を行いました。\n\n特に、私自身が決意をもって取り組んでいる拉致問題については、その即時解決の重要性を改めて強調し、トランプ大統領から、全面的な支持を得ることができました。\n\n昨今の安全保障環境が厳しさを増している中、まさにこのタイミングで、トランプ大統領との間で、安全保障、経済、経済安全保障など、幅広い分野における日米協力やインド太平洋地域情勢などについてしっかりと議論を行ったことは極めて有意義だったと思います。\n\nこのほか、国際刑事裁判所（ICC）に関する考えについても、率直なやり取りを行いました。\n\nトランプ大統領との緊密なやり取りを通じて、日米同盟の更なる高みを目指していきます。"}}},"rest_id":"2102568851720241304","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"357039","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102568851720241304","sortIndex":"2102638901133836266"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/aBV0xK8XU4"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_per