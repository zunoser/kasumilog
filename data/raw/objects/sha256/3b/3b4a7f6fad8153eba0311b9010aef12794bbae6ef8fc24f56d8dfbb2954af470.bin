info":{"focus_rects":[],"height":1080,"width":1920},"sizes":{"large":{"h":1080,"resize":"fit","w":1920},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/11DUbBKWxh","video_info":{"aspect_ratio":[16,9],"duration_millis":50833,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2101940017555992576/pl/7rTjHce7lnGX7bXp.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/480x270/CJfbLSI0BD7w4M16.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/640x360/hTOSuRhkGgqPq1Wy.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/1280x720/yNv2nb4-pMXKlWgK.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2101940017555992576/vid/avc1/1920x1080/8sn2z4hMhPby4t23.mp4?tag=29"}]}}]},"favorite_count":413,"favorited":false,"full_text":"９月２０日に、輸送艦「くにさき」がキジン港を出港した際の様子です。\n\n山林火災の状況や安全に部隊運用を行う上で必要な気象条件などを考慮し、インドネシア側との調整の上で、輸送艦「くにさき」は、CH-47輸送ヘリを１機搭載し、クタパン沖へ移動しました。 https://t.co/11DUbBKWxh","id_str":"2101940382833463665","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2101532257395806708","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":0,"retweet_count":58,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE5NDAzODI3ODMyMDk0NzI=","text":"９月２０日に、輸送艦「くにさき」がキジン港を出港した際の様子です。\n\n山林火災の状況や安全に部隊運用を行う上で必要な気象条件などを考慮し、インドネシア側との調整の上で、輸送艦「くにさき」は、CH-47輸送ヘリを１機搭載し、クタパン沖へ移動しました。\n\nキジン港とクタパン沖の２ヶ所からCH-47輸送ヘリにより消火活動を実施します。"}}},"rest_id":"2101940382833463665","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"24772","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2101532257395806708","2101940382833463665"],"enableDeduplication":true}}},"entryId":"list-conversation-2102638901133836351","sortIndex":"2102638901133836225"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/7hqmpH6hGr"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2101902184103477314"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indi