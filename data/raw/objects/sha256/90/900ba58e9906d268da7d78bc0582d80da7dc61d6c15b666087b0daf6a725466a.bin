:[559,570],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"vt.tiktok.com/ZSV2mF61C/","expanded_url":"https://vt.tiktok.com/ZSV2mF61C/","indices":[262,285],"url":"https://t.co/lEXRQdpFHO"},{"display_url":"vt.tiktok.com/ZSV2mJPdc/","expanded_url":"https://vt.tiktok.com/ZSV2mJPdc/","indices":[289,312],"url":"https://t.co/hOJjXWLTxT"},{"display_url":"instagram.com/reel/Db9Zq42yg…","expanded_url":"https://www.instagram.com/reel/Db9Zq42yg9w/?igsh=OGttZWxweGZ3am9u&igsi=OGttZWxweGZ3am9u","indices":[328,351],"url":"https://t.co/DbNNuMvZX3"},{"display_url":"instagram.com/reel/Db_-draS3…","expanded_url":"https://www.instagram.com/reel/Db_-draS3e6/?igsh=MXV3eWRxNDRodTVzcQ==&igsi=MXV3eWRxNDRodTVzcQ==","indices":[355,378],"url":"https://t.co/0PwEh1TU8n"},{"display_url":"youtube.com/shorts/Vecz0AH…","expanded_url":"https://youtube.com/shorts/Vecz0AHy2ZA?si=1FWA9k2T8dKPvgjL","indices":[393,416],"url":"https://t.co/AeRDMFo0Q1"},{"display_url":"youtube.com/shorts/E3SJ0FU…","expanded_url":"https://youtube.com/shorts/E3SJ0FUNx_Q?si=ry5hTFKd0dSiu-sV","indices":[420,443],"url":"https://t.co/TB0SJbjKqt"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[534,557],"url":"https://t.co/kPJLLRPaZ9"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTkzMzIzMTE0NDc3NTI3MDY=","text":"🌦️#逆さまなてるてる坊主☔️\n\n毎日はにかむ僕たちは。\n（”#まいはに”）にて、\n日本テレビが手がける\nショートドラマ配信中📺（全2話）\n\nぜひ最後までお楽しみください✨\n\n《概要》\n親の仕事が恥ずかしいと\n思ったことはありますか？\n女子高生のルナは、\n工事現場で働く父親のことが\nなんだか恥ずかしくて、\n友達にも父親の仕事を知られたくない。\nある日の帰り道、友達・あゆの前で、\n偶然父に声をかけられたルナだったが、\nとっさに他人のふりをしてしまう……\n＿＿＿＿＿＿＿＿＿\n\n≪視聴はこちらから≫\n\n🎵TikTok\n１話\nhttps://t.co/lEXRQdpFHO\n２話\nhttps://t.co/hOJjXWLTxT\n\n📷Instagram\n１話\nhttps://t.co/DbNNuMvZX3\n２話\nhttps://t.co/0PwEh1TU8n\n\n▶️YouTube\n１話\nhttps://t.co/AeRDMFo0Q1\n２話\nhttps://t.co/TB0SJbjKqt\n＿＿＿＿＿＿＿＿＿\n\n国土交通省は「建設業への入職促進に向けた\n魅力発信事業」における\n「中高生・保護者向けPR」の一環として、\n本コンテンツに提供しています。\n\n詳しくはこちら\nhttps://t.co/kPJLLRPaZ9\n\n#MLIT建設産業PR"}}},"rest_id":"2099332311607038336","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"8454","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099332311607038336","sortIndex":"2099499375943221197"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":7},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1669644725908049922/31IO4zqt_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/3720424033/1647955077"},"core":{"created_at":"Tue Sep 29 00:54:57 +0000 2015","name":"出入国在留管理庁（Immigration Services Agency）","screen_name":"MOJ_IMMI"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozNzIwNDI0MDMz","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1821855103747592582"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"出入国在留管理庁(Immigration Services Agency)の公式Xアカウントです。皆様のお役に立つ情報を発信します。当アカウントへのリプライ等に対して個別の対応はいたしません。運用方針等はこちらです。→https://t.co/wZ7zE5al6a","entities":{"description":{"urls":[{"display_url":"moj.go.jp/isa/publicatio…","expanded_url":"https://www.moj.go.jp/isa/publications/publications","indices":[109,132],"url":"https://t.co/wZ7zE5al6a"}]},"url":{"urls":[{"display_url":"moj.go.jp/isa/index.html","expanded_url":"https://www.moj.go.jp/is