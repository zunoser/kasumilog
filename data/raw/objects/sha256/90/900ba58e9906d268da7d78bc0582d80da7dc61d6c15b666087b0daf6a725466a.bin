io":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360568,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6323,"tweets":12368},"verification":{"verified":false},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2099445554745168235"],"editable_until_msecs":"1789385400000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":21,"bookmarked":false,"conversation_id_str":"2099445554745168235","created_at":"Mon Sep 14 10:30:00 +0000 2026","display_text_range":[0,80],"entities":{"media":[{"display_url":"pic.x.com/CYPERcOtdb","expanded_url":"https://x.com/jointstaffpa/status/2099445554745168235/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2099443204387184640","indices":[81,104],"media_key":"3_2099443204387184640","media_results":{"result":{"media_key":"3_2099443204387184640"}},"media_url_https":"https://pbs.twimg.com/media/HSK4eJebIAAzPOf.png","original_info":{"focus_rects":[{"h":333,"w":595,"x":0,"y":275},{"h":595,"w":595,"x":0,"y":13},{"h":608,"w":5