ttps://www.mofa.go.jp/mofaj/ecm/rs/pageit_000001_00001.html","indices":[201,224],"url":"https://t.co/tnI1YUwWZz"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTk0NzQ2ODI3ODEyOTA0OTY=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、ファティ・ビロル国際エネルギー機関（IEA）事務局長の表敬を受けました。双方は、国際的なエネルギー情勢、パワー・アジアやパワーGXといった取組を含む日本のエネルギー政策、エネルギーの供給源の多角化や重要鉱物のサプライチェーンの強靱化に関して意見交換を行い、日本とIEAが現下のエネルギーを巡る厳しい国際情勢の下において、緊密に連携していくことで一致しました。（写真提供：内閣広報室）\n\nhttps://t.co/tnI1YUwWZz"}}},"rest_id":"2099474682886197280","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"5342","state":"EnabledWithCount"}}}}},"entryId":"tweet-2099474682886197280","sortIndex":"2099499375943221248"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377