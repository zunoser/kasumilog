mg.com/amplify_video/2126178723267497984/vid/avc1/480x270/wwP8l0Gx_Cmu9-rY.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126178723267497984/vid/avc1/640x360/e3lFkbQdscXKCeX2.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126178723267497984/vid/avc1/1280x720/-L186Of8CJ1pkW4A.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/nkB6csu6J7","expanded_url":"https://x.com/kantei/status/2126179101556064350/video/1","ext_media_availability":{"status":"Available"},"id_str":"2126178723267497984","indices":[106,129],"media_key":"13_2126178723267497984","media_results":{"result":{"media_key":"13_2126178723267497984"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2126178723267497984/img/Vmmg3ghQCrmQX7z5.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/nkB6csu6J7","video_info":{"aspect_ratio":[16,9],"duration_millis":144433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2126178723267497984/pl/06Ym_6s2r6oaRqm2.m3u8?tag=29&v=e53"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126178723267497984/vid/avc1/480x270/wwP8l0Gx_Cmu9-rY.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126178723267497984/vid/avc1/640x360/e3lFkbQdscXKCeX2.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126178723267497984/vid/avc1/1280x720/-L186Of8CJ1pkW4A.mp4?tag=29"}]}}]},"favorite_count":604,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２７日）、高市総理は、中央防災会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　委員の皆様におかれましては、ご多用の中、「中央防災会議」にお集まりいただき、ありがとうございます。 https://t.co/nkB6csu6J7","id_str":"2126179101556064350","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":25,"retweet_count":78,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYxNzkxMDE0ODA0OTMwNTY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２７日）、高市総理は、中央防災会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　委員の皆様におかれましては、ご多用の中、「中央防災会議」にお集まりいただき、ありがとうございます。\n　本年も、令和８年熊本地震をはじめ、その後も相次ぐ豪雨・大雨、また台風などですね、多くの災害が発生いたしました。\n　そして、激甚化・頻発化する自然災害への対応というのは喫緊の課題になっております。\n　今月２日、防災庁が発足しました。\n　事前防災など平時の備えから、発災時の初動対応、避難所の設置・物資供給、復旧・復興まで、防災庁を「災害対応の司令塔」として、防災行政を抜本的に強化していかなければなりません。\n　本日は、\n・国難級の大規模災害に対し、国が前面に立って国民の生命を守り抜くこと\n・防災を基軸とした社会に我が国を変えていくこと\nを基本的な考え方とする『国家戦略』を新たに『防災基本計画』に掲げることを決定しました。\n　また、防災政策に関する事項の調査を行う基本政策調査会の設置や、より実践的な訓練を機動的に実施するための総合防災訓練大綱の見直しも決定しました。\n　各大臣は、新たな『防災基本計画』の下、細野大臣を中心に緊密に連携し、平時からの事前防災の推進と災害対応力の更なる強化に全力で取り組んでください。\n　細野大臣は、府省庁の縦割り、対策の遅れを見逃さず、「強い司令塔」として、各府省庁を動かしてください。\n　また、指定公共機関、学識経験者の皆様におかれましても、専門的なお立場からの一層のご協力をお願い申し上げます。\n　本格的な冬の季節を迎え、雪による災害も懸念される時期になりました。高い緊張感をもって、災害への備えに万全を期してまいりましょう。\n　本日は誠にありがとうございました。"}}},"rest_id":"2126179101556064350","unmention_data":{},"views":{"count":"22127","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126179101556064350","sortIndex":"2126232242039554005"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2126232242039554092-tweet-2126176976293757252","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"ele