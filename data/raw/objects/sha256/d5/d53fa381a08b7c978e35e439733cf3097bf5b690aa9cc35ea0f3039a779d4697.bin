al_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":85,"y":0},{"h":1734,"w":867,"x":412,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/bj21cjJhzC"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/bj21cjJhzC","expanded_url":"https://x.com/takaichi_sanae/status/2126153114386608540/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2126153020685844480","indices":[139,162],"media_key":"3_2126153020685844480","media_results":{"result":{"media_key":"3_2126153020685844480"}},"media_url_https":"https://pbs.twimg.com/media/HYGc6FAagAAlD1x.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":247},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":0,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/bj21cjJhzC"}]},"favorite_count":3869,"favorited":false,"full_text":"「中央防災会議」は、防災に関する重要事項についてご審議をいただくという重要な役割を担っています。\n\n今朝の閣議後、今月２日に「防災庁」が発足して、初めてとなる「中央防災会議」を開催しました。\n\n本日は、\n・「国難級の大規模災害に対し、国が前面に立って国民の生命を守り抜くこと」 https://t.co/bj21cjJhzC","id_str":"2126153114386608540","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":42,"reply_count":345,"retweet_count":444,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYxNTMxMTQzMjM2NTY3MDQ=","richtext":{"richtext_tags":[]},"text":"「中央防災会議」は、防災に関する重要事項についてご審議をいただくという重要な役割を担っています。\n\n今朝の閣議後、今月２日に「防災庁」が発足して、初めてとなる「中央防災会議」を開催しました。\n\n本日は、\n・「国難級の大規模災害に対し、国が前面に立って国民の生命を守り抜くこと」\n・「防災を基軸とした社会に我が国を変えていくこと」\nを基本的な考え方とする『国家戦略』を、新たに『防災基本計画』に掲げることを決定しました。\n\nまた、\n・防災政策に関する事項の調査を行う「基本政策調査会」の設置\n・より実践的な訓練を機動的に実施するための「総合防災訓練大綱」の見直し\nも決定しました。\n\n各大臣には、新たな『防災基本計画』の下、細野防災大臣を中心に緊密に連携し、「平時からの事前防災の推進」と「災害対応力の更なる強化」に全力で取り組むよう、指示をしました。\n\n細野大臣には、「府省庁の縦割り」や「対策の遅れ」を見逃さず、防災庁が「強い司令塔」となって各府省庁を動かしていくよう、指示をしました。\n\n指定公共機関、学識経験者の委員の皆様にも、専門的なお立場からの一層のご協力をお願い申し上げました。\n\n本格的な冬の季節を迎え、雪による災害の発生も懸念される時期になります。\n\n高い緊張感をもって、災害への備えに万全を期してまいります。"}}},"rest_id":"2126153114386608540","unmention_data":{},"views":{"count":"158167","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126153114386608540","sortIndex":"2126232242039553990"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/0fSJl6YTKM"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings