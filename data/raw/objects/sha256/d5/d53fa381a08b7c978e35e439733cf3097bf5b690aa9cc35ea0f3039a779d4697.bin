"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2126144881882230784","indices":[150,173],"media_key":"3_2126144881882230784","media_results":{"result":{"media_key":"3_2126144881882230784"}},"media_url_https":"https://pbs.twimg.com/media/HYGVgVma8AA3ome.jpg","original_info":{"focus_rects":[{"h":816,"w":1458,"x":0,"y":0},{"h":1094,"w":1094,"x":0,"y":0},{"h":1094,"w":960,"x":0,"y":0},{"h":1094,"w":547,"x":0,"y":0},{"h":1094,"w":1458,"x":0,"y":0}],"height":1094,"width":1458},"sizes":{"large":{"h":1094,"resize":"fit","w":1458},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/7g4qFws9B0"}]},"favorite_count":326,"favorited":false,"full_text":"11月16日、防衛省・自衛隊は北海道の幌別（ほろべつ）駐屯地にて、第3施設団や第7高射特科連隊などの隊員約340名に対し、自衛隊の女性・平和・安全保障（#WPS）の活動事例の教育を行いました。隊員は懇談なども通じ WPSの意義や、WPSの視点を任務に取り入れることの重要性について理解を深めました。 https://t.co/7g4qFws9B0","id_str":"2126144899171135606","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":5,"retweet_count":26,"retweeted":false,"user_id_str":"268732024"},"rest_id":"2126144899171135606","unmention_data":{},"views":{"count":"16429","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126144899171135606","sortIndex":"2126232242039553982"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/963981452835614721/EBYtwxCX_normal.jpg"},"banner":{"image_url":"https: