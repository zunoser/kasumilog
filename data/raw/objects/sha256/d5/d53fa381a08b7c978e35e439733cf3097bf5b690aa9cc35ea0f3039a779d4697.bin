ia_key":"3_2126138352328146944","media_results":{"result":{"media_key":"3_2126138352328146944"}},"media_url_https":"https://pbs.twimg.com/media/HYGPkRHagAAakhI.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":900,"w":900,"x":0,"y":0},{"h":900,"w":789,"x":0,"y":0},{"h":900,"w":450,"x":165,"y":0},{"h":900,"w":1200,"x":0,"y":0}],"height":900,"width":1200},"sizes":{"large":{"h":900,"resize":"fit","w":1200},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/zhfHwAehg8"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/zhfHwAehg8","expanded_url":"https://x.com/MLIT_JAPAN/status/2126138357386494231/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":92,"w":92,"x":585,"y":326}]},"medium":{"faces":[{"h":92,"w":92,"x":585,"y":326}]},"orig":{"faces":[{"h":92,"w":92,"x":585,"y":326}]},"small":{"faces":[{"h":52,"w":52,"x":331,"y":184}]}},"id_str":"2126138352139370497","indices":[106,129],"media_key":"3_2126138352139370497","media_results":{"result":{"media_key":"3_2126138352139370497"}},"media_url_https":"https://pbs.twimg.com/media/HYGPkQaaAAEf7h-.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":114},{"h":900,"w":900,"x":0,"y":0},{"h":900,"w":789,"x":0,"y":0},{"h":900,"w":450,"x":0,"y":0},{"h":900,"w":1200,"x":0,"y":0}],"height":900,"width":1200},"sizes":{"large":{"h":900,"resize":"fit","w":1200},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/zhfHwAehg8"},{"display_url":"pic.x.com/zhfHwAehg8","expanded_url":"https://x.com/MLIT_JAPAN/status/2126138357386494231/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":67,"w":67,"x":614,"y":394},{"h":80,"w":80,"x":919,"y":274},{"h":161,"w":161,"x":752,"y":98},{"h":182,"w":182,"x":323,"y":