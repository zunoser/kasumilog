e":"EnabledWithCount"}}}}},"entryId":"tweet-2126128404286382346","sortIndex":"2126232242039553968"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3087571,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":660,"tweets":1994},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2126124465889464653"],"editable_until_msecs":"1795746148000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":320,"bookmarked":false,"conversation_id_str":"2126124465889464653","created_at":"Fri Nov 27 01:22:28 +0000 2026","display_text_range":[0,132],"entities":{},"favorite_count":12725,"favorited":false,"full_text":"本日、新たな日本人「宇宙飛行士」候補者の募集が、約6年ぶりに実施されることが公表されました。\n\n宇宙活動を最前線で担う日本人「宇宙飛行士」候補者は、「宇宙航空研究開発機構（JAXA）」において、来年春頃に募集を開始し、2028年秋頃に選抜結果が発表される予定です。","id_str":"2126124465889464653","is_quote_status":false,"lang":"ja","quote_count":139,"reply_count":378,"retweet_count":1453,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYxMjQ0NjU4MzA2NDk4NTY=","richtext":{"richtext_tags":[]},"text":"本日、新たな日本人「宇宙飛行士」候補者の募集が、約6年ぶりに実施されることが公表されました。\n\n宇宙活動を最前線で担う日本人「宇宙飛行士」候補者は、「宇宙航空研究開発機構（JAXA）」において、来年春頃に募集を開始し、2028年秋頃に選抜結果が発表される予定です。\n\n今回の募集は、2030年代後半の「月面有人活動」で活躍が期待される「宇宙飛行士」候補者を新たに選抜し、現役の「宇宙飛行士」の皆様の持つ知見や経験を継承いただくことを目指しています。\n\n今回の「宇宙飛行士」候補者の募集を待ち望んでいた方も多いのではないでしょうか。\n\n「宇宙飛行士」候補者の応募条件などの詳細は、今後、「宇宙航空研究開発機構（JAXA）」が公表する予定ですが、宇宙への情熱と使命感を持ち、有人宇宙活動の新たな歴史を切り拓く志を有する多くの皆様が挑戦されることを期待しています。\n\n前回の募集で選ばれた「諏訪理（すわ まこと）」宇宙飛行士は、来年春に「国際宇宙ステーション（ISS）」へ飛び立たれる予定です。\n\n先人たちが築いてきた日本人「宇宙飛行士」の活躍の歴史が、次世代へと受け継がれ、我が国の宇宙空間におけるプレゼンスが一層高まることを嬉しく思っています。\n\n高市内閣では、『日本成長戦略』の戦略17分野である「航空・宇宙」分野において、「月面探査・低軌道技術」を重要技術と位置付けており、日本人「宇宙飛行士」が活躍する、月面における「有人探査車」の開発・実証、「国際宇宙ステーション（ISS）」への物資補給機の開発などに取り組んでまいります。"}}},"rest_id":"2126124465889464653","unment