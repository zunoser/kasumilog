拶を行いました。生稲政務官は、ルーマニア・ナショナルデーへの祝意を述べるとともに、二国間関係が幅広い分野で順調に強化されていることに触れつつ、両国の友 https://t.co/xpXlKgP2dO","id_str":"2126175336346140779","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":3,"retweet_count":6,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/erp/seb/…","expanded_url":"https://www.mofa.go.jp/mofaj/erp/seb/ro/pageit_000001_03356.html","indices":[168,191],"url":"https://t.co/9OlIbBHbqn"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYxNzUzMzYyMzcwMDY4NDg=","richtext":{"richtext_tags":[]},"text":"生稲外務大臣政務官は、駐日ルーマニア大使館において開催されたルーマニア・ナショナルデー・レセプションに出席し、日本政府を代表して挨拶を行いました。生稲政務官は、ルーマニア・ナショナルデーへの祝意を述べるとともに、二国間関係が幅広い分野で順調に強化されていることに触れつつ、両国の友好・協力関係が一層発展することを願う旨を述べました。\n\nhttps://t.co/9OlIbBHbqn"}}},"rest_id":"2126175336346140779","unmention_data":{},"views":{"count":"4491","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126175336346140779","sortIndex":"2126232242039554003"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_gradu