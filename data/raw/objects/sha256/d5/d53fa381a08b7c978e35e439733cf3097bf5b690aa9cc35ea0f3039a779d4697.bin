"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2126224711587876864","indices":[118,141],"media_key":"3_2126224711587876864","media_results":{"result":{"media_key":"3_2126224711587876864"}},"media_url_https":"https://pbs.twimg.com/media/HYHeHCbaUAAGpHN.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":247},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":0,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/DbgDkUCnoK"}]},"favorite_count":1226,"favorited":false,"full_text":"本日午後、「日仏クラブ」の皆様が官邸にお越し下さり、日本側議長の貸谷伊知郎・豊田通商株式会社取締役副会長とフランス側議長のアントワーヌ・ゴセ・グランビルAXA取締役会長から、「日仏クラブ」第35回総会の結果について御説明を伺いました。 https://t.co/DbgDkUCnoK","id_str":"2126224766742704619","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":76,"retweet_count":126,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyMjQ3NjY2NzU2OTM1Njg=","richtext":{"richtext_tags":[]},"text":"本日午後、「日仏クラブ」の皆様が官邸にお越し下さり、日本側議長の貸谷伊知郎・豊田通商株式会社取締役副会長とフランス側議長のアントワーヌ・ゴセ・グランビルAXA取締役会長から、「日仏クラブ」第35回総会の結果について御説明を伺いました。\n\n私からは、両国の経済関係強化への日仏クラブ関係者の尽力に敬意を表するとともに、日仏クラブの第35回総会の開催をお祝い申し上げました。\n\nまた、価値と原則を共有する「特別なパートナー」であるフランスとの関係は一層重要となっており、経済関係の一層の強化に向け、政府として、企業間協力を後押ししていく旨を申し上げました。\n\n官民で連携し、日本とフランスの益々の発展のために取り組んでまいります。"}}},"rest_id":"2126224766742704619","unmention_data":{},"views":{"count":"54433","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126224766742704619","sortIndex":"2126232242039554037"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"sug