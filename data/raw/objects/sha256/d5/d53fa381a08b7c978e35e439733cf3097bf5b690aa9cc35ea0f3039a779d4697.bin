e":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2126138441465479169/pl/9iqR8HGAIQHiOtI4.m3u8?tag=14"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126138441465479169/vid/avc1/320x400/DnzeyGCUGKCpzs9p.mp4?tag=14"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126138441465479169/vid/avc1/480x600/wBh9W57-pLzXxbIJ.mp4?tag=14"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126138441465479169/vid/avc1/720x900/DcbxRjFr4rjkHaZM.mp4?tag=14"}]}}]},"favorite_count":7,"favorited":false,"full_text":"#サステナブルファッション の「18のヒント」をご紹介✨\n🌱買う時、選ぶ時のヒント🌱\nヒント８ 「メーカー売れ残り在庫販売での購入も考えてみる」\n一人ひとりの選択が、持続可能な未来につながります。\nhttps://t.co/pkTZCN25m0\nhttps://t.co/Ug5ukfXtfq\n#エシカル消費 https://t.co/uiqtD47jxt","id_str":"2126141459577569298","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":6,"retweeted":false,"user_id_str":"1372902183990042635"},"rest_id":"2126141459577569298","unmention_data":{},"views":{"count":"2500","state":"EnabledWithCount"}}},"user_id_str":"240204834"},"rest_id":"2126144425789423756","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"502","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126144425789423756","sortIndex":"2126232242039553981"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/NgQYdQiYVu"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3087571,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":660,"tweets":1994},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2126143484302336205"],"editable_until_msecs":"1795750683000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":107,"bookmarked":false,"conversation_id_str":"2126143484302336205","created_at":"Fri Nov 27 02:38:03 +0000 2026","display_text_range":[0,83],"entities":{},"favorite_count":8850,"favorited":false,"full_text":"私達の生活圏でも、クマの出没情報が相次ぎ、皆様の不安が一層強くなっていることと思います。\n\n今朝、「クマ被害対策関係閣僚会議」（議長：木原稔官房長官）を開催しました。","id_str":"2126143484302336205","is_quote_status":false,"lang":"ja","quote_count":184,"reply_count":751,"retweet_count":948,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"cas.go.jp/jp/seisaku/kum…","expanded_url":"https://www.cas.go.jp/jp/seisaku/kumahigai_taisaku/dai6/gijishidai.html","indices":[877,900],"url":"https://t.co/NgQYdQiYVu"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYxNDM0ODQxMjYxOTE2MTY=","richtext":{"richtext_tags":[]},"text":"私達の生活圏でも、クマの出没情報が相次ぎ、皆様の不安が一層強くなっていることと思います。\n\n今朝、「クマ被害対策関係閣僚会議」（議長：木原稔官房長官）を開催しました。\n\n高市内閣では、3月にクマ被害対策の『ロードマップ』を策定するともに、9月には「クマ被害対策担当大臣」（笹川博義大臣）を任命するなど、クマ被害対策を強化しています。\n\n本年4～6月のクマの出没情報は12,000件を超え、昨年の同時期に比べて倍増しましたが、その後は比較的落ち着いた推移となっており、人身被害件数についても昨年の同時期（4～10月）を下回っています。\n\nこの背景には、クマのエサであるどんぐりなどの豊凶が、近年、隔年で変動している影響もありますが、高市内閣発足以来、矢継ぎ早に講じてきた対策の成果も徐々に現れ始めているものと考えています。\n\n一方、依然として人身被害が発生している中で、クマの出没による地域経済や観光への影響も顕在化しています。\n\nさらに、秋田県において来年秋のどんぐりの凶作が予報されるなど、来年は、昨年と同様に「大量出没年」となる可能性が示唆されています。\n\nこのような現状認識の下、クマ被害対策に一層万全を期すよう、関係閣僚会議の議長を務める木原官房長官に指示をいたしました。\n\nまず、被害にあわれた方の治療や社会復帰支援など、医療的対応を強化する観点から、本日の関係閣僚会議から、厚生労働大臣を新たに構成員に加えることとしました。\n\nまた、春期に行う管理捕獲の強化、ガバメントハンターを含む専門人材の確保、ICTやドローンなどの新技術の開発と導入促進などの取組を更に進め、来年以降の大量出没の可能性に備えて、『ロードマップ』の改訂にも着手します。\n\n国民の皆様におかれましては、今年度の死亡事例の多くが山中で発生していることを踏まえ、クマの生息地への不要不急の立ち入りを控えていただくこと、また、やむを得ず立ち入る場合には、あらかじめ、自治体が発信する出没情報や注意事項を確認していただくようお願い申し上げます。\n\n＜関係閣僚会議資料へのリンク＞\nhttps://t.co/NgQYdQiYVu"}}},"rest_id":"2126143484302336205","unmention_data":{},"views":{"count":"304353","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126143484302336205","sortIndex":"2126232242039553980"},{"content":{"__typename":"TimelineTimelineItem","clientEventIn