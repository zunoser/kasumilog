e,"muting":false},"rest_id":"10228272","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":16228,"tweets":61811},"verification":{"verified":false,"verified_type":"Business"},"website":{"url":"https://t.co/GIOK0JwagA"}}}]},"rest_id":"https://t.co/qeLHwCWstp"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2126149246642790511"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39736,"following":84},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":107,"tweets":526},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2126161509760012501"],"editable_until_msecs":"1795754980000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":15,"bookmarked":false,"conversation_id_str":"2126161509760012501","created_at":"Fri Nov 27 03:49:40 +0000 2026","display_text_range":[0,165],"entities":{},"favorite_count":221,"favorited":false,"full_text":"【11月27日　小泉防衛大臣会見】\n冒頭、「Defense AI Vision」の策定、日シンガポール防衛相会談の実施について発表しました。\n \nその他、\n○Defense AI Vision\n○25式高速滑空弾の部隊配備\n○嘉手納飛行場における旧海軍駐機場の使用\nなどに関する質疑応答がありました。\n \n↓発表事項の全文はこちら","id_str":"2126161509760012501","is_quote_status":false,"lang":"ja","quote_count":4,"reply_count":6,"retweet_count":42,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/5aKfQtSBRAY?si…","expanded_url":"https://youtu.be/5aKfQtSBRAY?si=jcndzfucffvC4spH","indices":[1563,1586],"url":"https://t.co/qeLHwCWstp"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYxNjE1MDk1NjI5MTY4NjQ=","text":"【11月27日　小泉防衛大臣会見】\n冒頭、「Defense AI Vision」の策定、日シンガポール防衛相会談の実施について発表しました。\n \nその他、\n○Defense AI Vision\n○25式高速滑空弾の部隊配備\n○嘉手納飛行場における旧海軍駐機場の使用\nなどに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「今日は、冒頭２件です。まず、本日、「Ｄｅｆｅｎｓｅ ＡＩ Ｖｉｓｏｎ」を策定しました。防衛省ＡＩ活用推進基本方針を作成して２年余りですが、ＡＩをめぐる技術開発と実装はかつてない速さで進んでいます。\n \n本ビジョンの目的は、ＡＩとデータの活用そのものではなく、ＡＩとデータによって情報をより早く行動に変え、人の知性と部隊の行動を拡張することで、防衛力の発揮の仕方そのものを変えることです。人間が目的を定め、指揮し、責任を負うとともに、必要なＡＩとデータを自ら選び、使い続ける能力を確保することです。\n \nつまり、本ビジョンが目指すものは、ＡＩとデータを我が国を守る力に変え、自衛隊の持つ能力を相互につなぎ、一つの力として最大限に発揮するということです。\n \nそのために、\n情報を迅速に判断と行動につなぐ、\n人間が指揮し、責任を持つ、\nＡＩを自ら選び、改善し続ける、\nこの３つを重視してまいります。\n \n特に、真の統合を進めていくためには、陸・海・空の壁を越えて、データを迅速かつ的確に活用できることが不可欠です。このため、データを任務遂行能力を高める戦略的資産として位置付け、ＡＩ・データ・デジタルを組織横断的に統括し、防衛省・自衛隊全体で必要なデータを生かすための基盤を構築していきます。\n \nこのビジョンは公表して終わりではありません。三文書を踏まえ、速やかに実行計画を策定し、具体的な事業に落とし込み、できるものから早期に着手してまいります。\n \n技術がどれだけ変わっても、我が国の主権と国民の生命・財産を守り抜く使命は変わりません。ＡＩとデータをその使命を果たす力に変えていきます。\n \n２件目が、シンガポールとの会談です。今週２５日、シンガポールのチャン・チュンシン国防大臣と４回目となる防衛相会談を行いました。シンガポールの国防大臣としては７年ぶりの訪日であり、今回の訪日中には防衛相会談のほかにも浜離宮、こちらを散策しながら懇談も行い、個人的な信頼関係を一層深めることができました。\n \n防衛相会談では、防衛協力を更に発展させるための具体的な議論を行い、その成果を共同プレスステートメントとして発出しました。共同プレスステートメントの発出は、日・シンガポールの防衛大臣の間では初めてとなります。\n \n具体的には、\n今年初めて実施した海上自衛隊とシンガポール海軍の共同訓練「ＳＩＮＧＡＰＡＮ」を継続的に実施していくほか、潜水艦救難といった新たな分野にも訓練を拡大していくこと、\n陸上自衛隊の特殊部隊によるシンガポールの次世代市街地訓練施設「サフティ・シティ」の視察を早期に実現すること、\nシンガポール空軍のスマート・エアベース構想の取組を含め、省人化・無人化といった技術の分野での協力を検討していくこと、\nそして第２回となる日・シンガポール防衛インダストリーデーを来年４月に日本で開催し、装備・技術分野での協力を加速することで一致しました。\n \nシンガポールは地域と国際社会の課題に共に取り組む重要なパートナーであり、外交関係樹立６０周年の節目の年に、日・シンガポールの防衛協力を強化する道筋をつけられたことは大きな成果でした。チャン国防大臣とは今後とも緊密に意思疎通を図り、日・シンガポール間の防衛協力を更に推進していきたいと思います。冒頭２件、以上です。」\n \n↓動画はこちら\nhttps://t.co/qeLHwCWstp"}}},"rest_id":"2126161509760012501","unmention_data":{},"views":{"count":"22946","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2126161709916385298","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"3798","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126161709916385298","sortIndex":"2126232242039553992"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2126154763674992640/pisySDEx?format=jpg&name=800x419","width":800},"type":"IMAGE"}