":false,"full_text":"低気圧は日本の南に進み、前線が西日本や東日本を南下して、４日以降、本州の南岸に停滞する見通しです。\n土砂災害、低い土地の浸水、河川の増水や氾濫に厳重に警戒してください。また、強風や高波に注意・警戒してください。","id_str":"2095395384604741672","in_reply_to_screen_name":"MAFF_JAPAN","in_reply_to_status_id_str":"2095395382503313664","in_reply_to_user_id_str":"2335919749","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":9,"retweeted":false,"user_id_str":"2335919749"},"rest_id":"2095395384604741672","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3819","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2095395382503313664","2095395384604741672"],"enableDeduplication":true}}},"entryId":"list-conversation-2095628689294229541","sortIndex":"2095628689294229467"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/Jirtbo97XYw","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2095255236285964288/cLi0oCeo?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":158,"url":"https://pbs.twimg.com/card_img/2095255236285964288/cLi0oCeo?format=jpg&name=280x280","width":280},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66772","type":"STRING"}},{"key":"description","value":{"string_value":"2026年09月03日開催、第24回主要原子力施設設置者の原子力部門の責任者との意見交換会を公開いたします。■開催概要開催概要、...","type":"STRING"}},{"key":"player_width","value":{"string_value":"640","type":"STRING"}},{"ke