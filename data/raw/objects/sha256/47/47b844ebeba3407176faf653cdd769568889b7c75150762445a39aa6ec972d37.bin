y_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2095346051314057504","created_at":"Thu Sep 03 03:00:02 +0000 2026","display_text_range":[0,127],"entities":{"hashtags":[{"indices":[16,23],"text":"匠のモノサシ"}]},"favorite_count":26,"favorited":false,"full_text":"╋━━━━━━━\n\n　TV番組『#匠のモノサシ』📏\n\n　　　　　　　━━━━━━━╋\n\n◤\n 今日の数字は…60度！\n　　　　　　　　　◢\n\n💡ヒント\n建物の骨組みを作り上げる時に、安全性を支える工具！\n\nその工具は、ときに地上30mの高さで活躍します！","id_str":"2095346051314057504","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":7,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[16,23],"text":"匠のモノサシ"},{"indices":[385,396],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"ntv.co.jp/takuminomonosa…","expanded_url":"https://www.ntv.co.jp/takuminomonosashi/","indices":[263,286],"url":"https://t.co/GJJMYZnfXU"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[360,383],"url":"https://t.co/kPJLLRPaZ9"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTUzNDYwNTExNjcxNjY0NjU=","text":"╋━━━━━━━\n\n　TV番組『#匠のモノサシ』📏\n\n　　　　　　　━━━━━━━╋\n\n◤\n 今日の数字は…60度！\n　　　　　　　　　◢\n\n💡ヒント\n建物の骨組みを作り上げる時に、安全性を支える工具！\n\nその工具は、ときに地上30mの高さで活躍します！\n\n”現場の華”とも呼ばれる『とび工』の魅力と凄腕の職人技に迫ります！\n\n─────────────────\n\n📺放送局　日本テレビ(関東ローカル)\n🗓️日時　　9月3日(木) 　21時54分～\n\n─────────────────\n\n「匠のモノサシ」公式WEBサイト👇\nhttps://t.co/GJJMYZnfXU\n\n国土交通省は「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、本番組に提供しています。\n詳しくはこちら：https://t.co/kPJLLRPaZ9\n\n#MLIT建設産業PR"}}},"rest_id":"2095346051314057504","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"8917","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095346051314057504","sortIndex":"209562868929422944