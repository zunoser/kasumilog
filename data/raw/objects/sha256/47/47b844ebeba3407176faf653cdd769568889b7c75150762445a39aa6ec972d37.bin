udan: ／\n🔊  千葉豪雨情報のFAQを追加\n＼\n \nガボットに\n\n令和8年８月千葉豪雨に関する\n\n被災者支援情報のFAQを追加しました\n \n災害専用フリーダイヤルの番号やガイドブックなど、\n\n被災者の皆様に役立つ情報はこちらからご確認ください\n↓\nht…","id_str":"2095416871059431790","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":17,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":4},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1739165110516756480/dkkReKye_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1646525744/1771992097"},"core":{"created_at":"Mon Aug 05 01:02:51 +0000 2013","name":"総務省行政相談","screen_name":"MIC_soudan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNjQ2NTI1NzQ0","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"総務省行政評価局行政相談企画課の公式アカウントです。本アカウントは情報発信専用であり、行政相談は当省ホームページの「インターネットによる行政相談受付」をご利用ください。\nアカウント運用ポリシーはこちら【https://t.co/yKXgMvjPlq】","entities":{"description":{"urls":[{"display_url":"soumu.go.jp/main_content/0…","expanded_url":"https://www.soumu.go.jp/main_content/000242107.pdf","indices":[101,124],"url":"https://t.co/yKXgMvjPlq"}]},"url":{"urls":[{"display_url":"soumu.go.jp/main_sosiki/hy…","expanded_url":"http://www.soumu.go.jp/main_sosiki/hyouka/soudan_n/index.html","indices":[0,23],"url":"https://t.co/DA8nlS8Su7"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":16686,"following":16},"relationship_perspectives":{"blocked_by":false,"blo