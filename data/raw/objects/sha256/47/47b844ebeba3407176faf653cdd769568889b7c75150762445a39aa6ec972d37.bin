732057601/vid/avc1/1280x720/ibHAF9pmQfMH7FgP.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095489136732057601/vid/avc1/1920x1080/kqmQj0lBfqrNH6TJ.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/bSXnc8A111","expanded_url":"https://x.com/ModJapan_jp/status/2095489256949215724/video/1","ext_media_availability":{"status":"Available"},"id_str":"2095489136732057601","indices":[133,156],"media_key":"13_2095489136732057601","media_results":{"result":{"media_key":"13_2095489136732057601"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2095489136732057601/img/7rercipq864GN5DW.jpg","original_info":{"focus_rects":[],"height":1080,"width":1920},"sizes":{"large":{"h":1080,"resize":"fit","w":1920},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/bSXnc8A111","video_info":{"aspect_ratio":[16,9],"duration_millis":75433,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2095489136732057601/pl/8QBeeP0NnivxzoUK.m3u8?tag=29&v=0fd"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095489136732057601/vid/avc1/480x270/733hEGZDJdhCtaaN.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095489136732057601/vid/avc1/640x360/jKQpA7A5g2T0Kt6Z.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095489136732057601/vid/avc1/1280x720/ibHAF9pmQfMH7FgP.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2095489136732057601/vid/avc1/1920x1080/kqmQj0lBfqrNH6TJ.mp4?tag=29"}]}}]},"favorite_count":602,"favorited":false,"full_text":"昨日開催された、根岸住宅地区返還記念式典の様子です。\n\n式典では、返還記念の盾の贈呈や、返還に至る歩みを振り返る映像の上映が行われました。\n\n約79年の歴史を経て迎えたこの節目の日に、返還の実現に向けて長年尽力された多くの関係者の皆様への感謝と敬意が表されました。 https://t.co/bSXnc8A111","id_str":"2095489256949215724","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"quoted_status_id_str":"2095092562092527698","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2095092562092527698","url":"https://t.co/HzGMLkQgez"},"reply_count":8,"retweet_count":96,"retweeted":false,"user_id_str":"268732024"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"ht