ranslated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":8,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"MLIT_JAPAN"}}},"policy":"Community"},"conversation_id_str":"2091221412006740480","created_at":"Sat Aug 22 17:50:12 +0000 2026","display_text_range":[0,99],"entities":{},"favorite_count":185,"favorited":false,"full_text":"８月２３日０２：００頃に発生した茨城県を震源とする地震について、大臣指示を行いました。\n\n１．地方自治体とも緊密に連携し、早急に被害状況を把握するとともに、国民に対し、情報提供を適時的確に行うこと。","id_str":"2091221412006740480","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":1,"retweet_count":56,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTEyMjE0MTE5NzMxODE0NDA=","richtext":{"richtext_tags":[]},"text":"８月２３日０２：００頃に発生した茨城県を震源とする地震について、大臣指示を行いました。\n\n１．地方自治体とも緊密に連携し、早急に被害状況を把握するとともに、国民に対し、情報提供を適時的確に行うこと。\n\n２．地方自治体とのホットライン等を通じて情報を収集し、要請に応じて迅速に地方自治体への支援等を実施すること。"}}},"rest_id":"2091221412006740480","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"19147","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2091221412006740480","sortIndex":"2091766052823236545"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2080871133323346320"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1759333,"following":47},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8215,"tweets":23196},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2091219821962887378"],"editable_until_msecs":"1787424233198","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2091219821962887378","created_at":"