"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2981081,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":516,"tweets":1723},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2091221773073399886"],"editable_until_msecs":"1787424698000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":352,"bookmarked":false,"conversation_id_str":"2091221773073399886","created_at":"Sat Aug 22 17:51:38 +0000 2026","display_text_range":[0,131],"entities":{},"favorite_count":37851,"favorited":false,"full_text":"本日２時頃、茨城県南部を震源とする地震が発生し、東京都２３区、茨城県、埼玉県、千葉県で最大震度５弱の強い揺れを観測しました。\n\n津波の心配はありません。\n\n現時点で、人的被害や住家被害に関する情報はありませんが、引き続き、被害状況を確認中との報告を受けています。","id_str":"2091221773073399886","is_quote_status":false,"lang":"ja","quote_count":339,"reply_count":996,"retweet_count":3610,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTEyMjE3NzMwMjcyNzA2NTc=","richtext":{"richtext_tags":[]},"text":"本日２時頃、茨城県南部を震源とする地震が発生し、東京都２３区、茨城県、埼玉県、千葉県で最大震度５弱の強い揺れを観測しました。\n\n津波の心配はありません。\n\n現時点で、人的被害や住家被害に関する情報はありませんが、引き続き、被害状況を確認中との報告を受けています。\n\n政府としては、地震発生後、ただちに、官邸危機管理センターに官邸連絡室を設置し、私からも、被害状況の把握、国民の皆様に対する適時的確な情報提供などを指示し、対応に当たっています。\n\n揺れの強かった地域の皆様におかれては、引き続き、同程度の地震の発生に注意していただきますようお願いします。"}}},"rest_id":"2091221773073399886","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2292184","state":"EnabledWithCount"}}}}},"entryId":"tweet-2091221773073399886","sortIndex":"2091766052823236546"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"