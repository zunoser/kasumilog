た、重要鉱物、食料等の分野に焦点を当てた https://t.co/2zIkYbw9N6","id_str":"2091758894213365901","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":3,"retweet_count":4,"retweeted":false,"user_id_str":"331514169"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mof.go.jp/policy/interna…","expanded_url":"https://www.mof.go.jp/policy/international_policy/convention/dialogue/20260824.html","indices":[217,240],"url":"https://t.co/H51LWAIn0K"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTE3NTg4OTQxMDQzOTU3NzY=","richtext":{"richtext_tags":[]},"text":"本日、財務省は米州開発銀行（IDB）等と共催で「日本－中南米・カリブ（LAC）地域ビジネスフォーラム2026」を開催しました。片山大臣はフォーラムに先立ちゴールドファインIDB総裁と面会し、日本とIDBグループの連携強化等について意見交換を実施しました。また、重要鉱物、食料等の分野に焦点を当てた日本レジリエンス・イニシアティブへの追加拠出や、介護・保健分野における協力強化を含む各種合意文書の署名式を行いました。\n\n詳細はこちら▼\nhttps://t.co/H51LWAIn0K"}}},"rest_id":"2091758894213365901","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2302","state":"EnabledWithCount"}}}}},"entryId":"tweet-2091758894213365901","sortIndex":"2091766052823236607"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国