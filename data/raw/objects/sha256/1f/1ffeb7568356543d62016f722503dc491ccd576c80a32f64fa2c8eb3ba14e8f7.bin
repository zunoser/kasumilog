_str":"2090758293950218489","created_at":"Fri Aug 21 11:09:56 +0000 2026","display_text_range":[0,251],"entities":{"media":[{"display_url":"pic.x.com/6jIVPpf5UR","expanded_url":"https://x.com/MofaJapan_en/status/2090758293950218489/photo/1","ext_alt_text":"Appointment of Mr. NISHIOKA Tatsushi, Minister at the Embassy of Japan in the Republic of Korea, as the Secretary-General of the Trilateral Cooperation Secretariat\n\n1.    Effective September 1, Mr. NISHIOKA Tatsushi, Minister, Embassy of Japan in the Republic of Korea, will assume the post of the Secretary-General of the Trilateral Cooperation Secretariat (TCS), located in Seoul, the Republic of Korea.\n\n2.    The Government of Japan expects the new Secretary-General to contribute to the further development of trilateral cooperation as head of the TCS, an international organization comprising Japan, China, and the Republic of Korea.\n\n3.    The Government of Japan also highly appreciates the work of the incumbent Secretary-General LEE Hee-sup, who has served in this role for the past three years, and expresses its gratitude for his contributions to promoting trilateral cooperation among Japan, China, and the Republic of Korea.\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":95,"w":95,"x":366,"y":962}]},"medium":{"faces":[{"h":87,"w":87,"x":338,"y":888}]},"orig":{"faces":[{"h":95,"w":95,"x":366,"y":962}]},"small":{"faces":[{"h":49,"w":49,"x":191,"y":503}]}},"id_str":"2090757810988711936","indices":[252,275],"media_key":"3_2090757810988711936","media_results":{"result":{"media_key":"3_2090757810988711936"}},"media_url_https":"https://pbs.twimg.com/media/HQPdJttbAAAcECe.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":66},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":356,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6jIVPpf5UR"}],"urls":[{"display_url":"mofa.go.jp/press/statemen…","expanded_url":"https://www.mofa.go.jp/press/statement/pageite_000001_00010.html","indices":[228,251],"url":"https://t.co/5YLMBKhy0O"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/6jIVPpf5UR","expanded_url":"https://x.com/MofaJapan_en/status/2090758293950218489/photo/1","ext_alt_text":"Appointment of Mr. NISHIOKA Tatsushi, Minister at the Embassy of Japan in the Republic of Korea, as the Secretary-General of the Trilateral Cooperation Secretariat\n\n1.    Effective September 1, Mr. NISHIOKA Tatsushi, Minister, Embassy of Japan in the Republic of Korea, will assume the post of the Secretary-General of the Trilateral Cooperation Secretariat (TCS), located in Seoul, the Republic of Korea.\n\n2.    The Government of Japan expects the new Secretary-General to contribute to the further development of trilateral cooperation as head of the TCS, an international organization comprising Japan, China, and the Republic of Korea.\n\n3.    The Government of Japan also highly appreciates the work of the incumbent Secretary-General LEE Hee-sup, who has served in this role for the past three years, and expresses its gratitude for his contributions to promoting trilateral cooperation among Japan, China, and the Republic of Korea.\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":95,"w":95,"x":366,"y":962}]},"medium":{"faces":[{"h":87,"w":87,"x":338,"y":888}]},"orig":{"faces":[{"h":95,"w":95,"x":366,"y":962}]},"small":{"faces":[{"h":49,"w":49,"x":191,"y":503}]}},"id_str":"2090757810988711936","indices":[252,275],"media_key":"3_2090757810988711936","media_results":{"result":{"media_key":"3_2090757810988711936"}},"media_url_https":"https://pbs.twimg.com/media/HQPdJttbAAAcECe.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":66},{"h