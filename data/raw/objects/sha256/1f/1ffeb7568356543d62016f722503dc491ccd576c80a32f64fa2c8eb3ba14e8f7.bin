1082102640077467649/QaRdW4oU_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303735625/1782867162"},"core":{"created_at":"Mon May 23 10:32:05 +0000 2011","name":"MOFA of Japan","screen_name":"MofaJapan_en"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzU2MjU=","is_blue_verified":true,"location":{"location":"Tokyo"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2090732535760437454"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"The Official English Account of the Ministry of Foreign Affairs of Japan.\nSocial Media List: https://t.co/PnH9N7WcqL","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/about/list_en.…","expanded_url":"https://www.mofa.go.jp/about/list_en.html","indices":[93,116],"url":"https://t.co/PnH9N7WcqL"}]},"url":{"urls":[{"display_url":"mofa.go.jp","expanded_url":"http://www.mofa.go.jp/","indices":[0,23],"url":"https://t.co/jDWRcTicQE"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":151079,"following":179},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8502,"tweets":19392},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2090778798027640882"],"editable_until_msecs":"1787319084000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":true,"legacy":{"bookmark_count":6,"bookmarked":false,"conversation_id_str":"2090778798027640882","created_at":"Fri Aug 21 12:31:24 +0000 2026","display_text_range":[0,121],"entities":{"media":[{"display_url":"pic.x.com/YlvPxghJt6","expanded_url":"https://x.com/MofaJapan_en/status/2090778798027640882/photo/1","ext_alt_text":"\n1.    The Government of Japan is deeply concerned about progress in the settlement construction plan in the E1 area of the West Bank. The Government of Japan reiterates its deep regret over the continuing unilateral acts including settlement activities by the Government of Israel despite repeated calls by the international community, including Japan, and once again strongly urges the Government of Israel to reverse the plan and fully freeze its settlement activities. The Government of Japan also calls on the Government of Israel to take appropriate measures promptly to prevent settler violence.\n\n2.    Settlement activities are in violation of international law and undermine the viability of a two-state solution. The Government of Japan reiterates the significance of achieving peace in the Middle East through a two-state solution and, working with the international community, will make every diplomatic efforts to halt the Israeli government's settlement activities.","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":79,"w":79,"x":200,"y":874},{"h":299,"w":299,"x":54,"y":190}]},"medium":{"faces":[{"h":72,"w":72,"x":184,"y":807},{"h":276,"w":276,"x":49,"y":175}]},"orig":{"faces":[{"h":79,"w":79,"x":200,"y":874},{"h":299,"w":299,"x":54,"y":190}]},"small":{"faces":[{"h":41,"w":41,"x":104,"y":457},{"h":156,"w":156,"x":28,"y":99}]}},"id_str":"2090778603021881344","indices":[122,145],"media_key":"3_2090778603021881344","media_results":{"result":{"media_key":"3_2090778603021881344"}},"media_url_https":"https://pbs.twimg.com/media/HQPwD-EbUAAsCVQ.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":66},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":389,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YlvPxghJt6"}],"urls":[{"display_url":"mofa.go.jp/press/statemen…","expanded_url":"https://www.mofa.go.jp/press/statement/pageite_000001_01773.html","indices":[98,121],"url":"https://t.co/CncA58lxIN"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/YlvPxghJt6","expanded_url":"https://x.com/MofaJapan_en/status/2090778798027640882/photo/1","ext_alt_text":"\n1.    The Government of Japan is deeply concerned about progress in the settlement construction plan in the E1 area of the West Bank. The Government of Japan reiterates its deep regret over the continuing unilateral acts including settlement activities by the Government of Israel despite repeated calls by the international community, including Japan, and once again strongly urges the Government of Israel to reverse the plan and fully freeze its settlement activities. The Government of Japan also calls on the Government of Israel to take appropriate measures promptly to prevent settler violence.\n\n2.    Settlement activities are in violation of international law and undermine the viability of a two-state solution. The Government of Japan reiterates the significance of achieving peace in the Middle East through a two-state solution and, working with the international community, will make every diplomatic efforts to halt the Israeli government's settlement activities.","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":79,"w":79,"x":200,"y":874},{"h":299,"w":299,"x":54,"y":190}]},"medium":{"faces":[{"h":72,"w":72,"x":184,"y":807},{"h":276,"w":276,"x":49,"y":175}]},"orig":{"faces":[{"h":79,"w":79,