ps://t.co/a1DpzdfFfZ"},"reply_count":23,"retweet_count":552,"retweeted":false,"user_id_str":"268732024"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3327},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360593,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6268,"tweets":12328},"verification":{"verified":false},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_control_initial":{"