":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/JAv44gKmA2","video_info":{"aspect_ratio":[16,9],"duration_millis":452000,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2104902397458001920/pl/AjaXp92ZdKWOlFUe.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2104902397458001920/vid/avc1/480x270/qFFmtfMk3Ucp8pUH.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2104902397458001920/vid/avc1/640x360/8Y2tWIdt3JRqEfPY.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2104902397458001920/vid/avc1/1280x720/zI7lZRC783ufxizo.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/JAv44gKmA2","expanded_url":"https://x.com/kantei/status/2104903775156580677/video/1","ext_media_availability":{"status":"Available"},"id_str":"2104902397458001920","indices":[70,93],"media_key":"13_2104902397458001920","media_results":{"result":{"media_key":"13_2104902397458001920"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2104902397458001920/img/mkVzDcGLrHcZ8P4c.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/JAv44gKmA2","video_info":{"aspect_ratio":[16,9],"duration_millis":452000,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2104902397458001920/pl/AjaXp92ZdKWOlFUe.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2104902397458001920/vid/avc1/480x270/qFFmtfMk3Ucp8pUH.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2104902397458001920/vid/avc1/640x360/8Y2tWIdt3JRqEfPY.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2104902397458001920/vid/avc1/1280x720/zI7lZRC783ufxizo.mp4?tag=29"}]}}]},"favorite_count":2768,"favorited":false,"full_text":"【お知らせ】\n本日（９月２９日）、高市総理は、日・モンゴル首脳会談を行いました。\n\n※両首脳による冒頭発言(速報版、仮訳)\n\n（高市総理） https://t.co/JAv44gKmA2","id_str":"2104903775156580677","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":26,"reply_count":110,"retweet_count":422,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ5MDM3NzQ5OTcyMTMxODQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（９月２９日）、高市総理は、日・モンゴル首脳会談を行いました。\n\n※両首脳による冒頭発言(速報版、仮訳)\n\n（高市総理）\n　オチラル首相、この３月の首相御就任誠におめでとうございます。そして、首相就任後の初の二国間訪問先として、日本を選んでくださって、とても嬉しく思います。\n　また、「自由で開かれたインド太平洋（ＦＯＩＰ）」をですね、モンゴルが一貫して支持をしていただいていることをとても心強く思っております。\n　日本は「平和国家」として、また、モンゴルの最も重要な「第三の隣国」として、「進化したＦＯＩＰ」の下、モンゴルの「自律性」と「強靱性」を支えていきます。\n　本日は「空の連結性」の鍵であります、チンギス・ハーン国際空港の拡張について、交換公文が署名されたことを歓迎いたします。\n　こうした取組を重ねながら、平和と繁栄のためにモンゴルとの、この協力関係をますます強めていきたいなと思っております。\n\n（オチラル首相）※日本語仮訳\n　私はモンゴルの総理としての初めての公式外国訪問として、我が国の親しいパートナー、美しい国、日本を訪問し高市早苗総理大臣閣下とお会いできたことを心より嬉しく、光栄に存じます。\n　民主主義の共通の価値観を共有する重要な「第三の隣国」であり、特別なパートナーである日本との良好な関係及び協力を一層深化・発展させることは、モンゴルの外交政策における最重要課題の一つです。モンゴル政府は常に日本との関係を重視し、高い優先度を置いて取り組んでおります。\n　モンゴルにおける民主主義の定着、社会、経済の発展及び安定における歴代の日本政府及び日本国民の皆様から温かく継続的なご支援を賜りましたことに、心より感謝申し上げます。また、モンゴルは、日本が平和国家として世界の平和と安定の維持及び国際社会の発展に果たしてきた重要な役割と多大な貢献を高く評価していることを強調したいと思います。\n　モンゴルは平和を重視し、開放的かつ独立した多極的な外交政策のもと、２０２２年に両国が署名した「平和と繁栄のための特別な戦略的パートナーシップに関する共同声明」に盛り込まれた目標及び原則を着実に実施し、両国の発展と繁栄、そして両国民の幸福のため、引き続き緊密に協力してまいりたいと考えております。２０２２年、フレルスフ大統領が訪問の際に共同声明に署名しましたが、私も国家大会議における常任委員長として協力関係の拡大強化に取り組んでまいりました。\n　両国の友情、友好及び協力の象徴でもありますチンギス・ハーン国際空港の拡張事業につきましては、日本国政府の政府開発援助により、円借款の資金を活用して実施することで双方が最終的に合意しております。今回の訪問に際し、本事業にかかる貸付契約（LA）に署名するとともに、本日、交換公文の交換を成功裏に行うことができましたことを大変うれしく思っております。"}}},"previous_counts":{"bookmark_count":1,"favorite_count":31,"quote_count":0,"reply_count":0,"retweet_count":6},"rest_id":"2104903775156580677","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"108518","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104903775156580677","sortIndex":"2105186896480042955"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","enti