50}},"type":"photo","url":"https://t.co/Lq8rcwtAyh"}]},"favorite_count":6598,"favorited":false,"full_text":"＜省エネと脱炭素を支える超断熱材素材＞\n\n2つ目にご披露いただいたのは、新しい断熱技術「TIISA」（ティーサ）です。\n\n国立研究開発法人物質・材料研究機構（NIMS）の主任研究員である、同機構発のベンチャー企業（株）Thermalyticaの創業者兼CTOのウー・ラダーさんからご説明いただきました。 https://t.co/Lq8rcwtAyh","id_str":"2104884611381858369","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":59,"reply_count":164,"retweet_count":848,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"thermalytica.com/ja","expanded_url":"https://thermalytica.com/ja","indices":[872,895],"url":"https://t.co/eiyQGYIFrk"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ4ODQ2MTEyMjI1ODEyNDg=","richtext":{"richtext_tags":[]},"text":"＜省エネと脱炭素を支える超断熱材素材＞\n\n2つ目にご披露いただいたのは、新しい断熱技術「TIISA」（ティーサ）です。\n\n国立研究開発法人物質・材料研究機構（NIMS）の主任研究員である、同機構発のベンチャー企業（株）Thermalyticaの創業者兼CTOのウー・ラダーさんからご説明いただきました。\n\n世界で消費されるエネルギーの約75％が無駄になっており、その大きな要因の一つが、建物の断熱不足に伴う「エネルギー損失」だそうです。\n\n従来、既存の「断熱材」で高い性能を得るには素材を厚くする必要がありましたが、20年の研究成果として、「超断熱材料」の「TIISA」と、その「TIISA」を含んだ世界初の「超断熱塗料」を開発されたそうで、わずか2〜3ミリの薄さでも1300℃の炎を遮断することができるようになったそうです。\n\n実際に、「超断熱塗料」を手に塗って、バーナーで火をあてる動画も拝見し、断熱・遮炎の効果を目の当たりにすることができました。\nデモンストレーションとして、私自らが、「超断熱塗料」と既存の「断熱塗料」をそれぞれ塗布した金属板を熱したものに触れ、効果の違いを体感しました。\n\nこの塗料は、市販のものと比べ約2.5倍の断熱性能を持つため、夏は涼しく、冬は暖かい、快適な室内環境を保つことができるそうで、エアコンだけでは十分な冷却効果が得られなかった施設に、実際に導入した結果、屋根と外壁に施工することで電気代を約６割削減できたとのことです。\n\n実際に、説明された方ご自身も、国連の事業の一環として、今年4月にウクライナを訪問され、キーウの暖房が機能しない子ども病院で塗装を行い、室内外の温度差を6.6℃改善することができたとされていました。\n\nまた、この断熱塗料は、液体水素の輸送に必要な-253℃の低温領域にも対応でき、「水素社会の実現」にも貢献できると伺いました。\n\n省エネルギーだけでなく、災害や厳しい環境の下で暮らす人々の命を守る技術として大いに期待しております。\n\n（株）Thermalytica のリンク先：　https://t.co/eiyQGYIFrk"}}},"rest_id":"2104884611381858369","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"215808","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104884611381858369","sortIndex":"2105186896480042940"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3007251,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":558,"tweets":1825},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2104883973394735527"],"editable_until_msecs":"1790682020000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":55,"bookmarked":false,"conversation_id_str":"2104883973394735527","created_at":"Tue Sep 29 10:40:20 +0000 2026","display_text_range":[0,117],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/fIRS6Kmwfb","expanded_url":"https://x.com/takaichi_sanae/status/2104883973394735527/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2104883934907756544","indices":[118,141],"media_key":"3_2104883934907756544","media_results":{"result":{"media_key":"3_2104883934907756544"}},"media_url_https":"https://pbs.twimg.com/media/HTYMyWGacAA8Gp4.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/fIRS6Kmwfb"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/fIRS6Kmwfb","expanded_url":"https://x.com/takaichi_sanae/status/2104883973394735527/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2104883934907756544","indices":[118,141],"media_key":"3_2104883934907756544","media_results":{"result":{"media_key":"3_2104883934907756544"}},"media_url_https":"https://pbs.twimg.com/media/HTYMyWGacAA8Gp4.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/fIRS6Kmwfb"}]},"favorite_count":5941,"favorited":false,"full_text":"昨日、「横浜グリーンエクスポ」の関係者の皆様が官邸にお越しになり、3つの最先端の「グリーン技術」をご披露頂いたことを報告しましたが、それぞれについて、詳しくご紹介いたします。\n\n＜“土に還る” 公式ボランティア・スタッフユニフォーム＞ https://t.co/fIRS6Kmwfb","id_str":"2104883973394735527","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":43,"reply_count":165,"retweet_count":653,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"pieclex.com","expanded_url":"https://pieclex.com/","indices":[939,962],"url":"https://t.co/8I4TaVMPle"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ4ODM5NzMyMjY5NzkzMjg=","richtext":{"richtext_tags":[]},"text":"昨日、「横浜グリーンエクスポ」の関係者の皆様が官邸にお越しになり、3つの最先端の「グリーン技術」をご披露頂いたことを報告しましたが、それぞれについて、詳しくご紹介いたします。\n\n＜“土に還る” 公式ボランティア・スタッフユニフォーム＞\n\n1つ目は、「横浜グリーンエクスポ」の公式ボランティア・スタッフユニフォームに使用される、高機能でありながらも環境に良い「着るグリーンテック」です。\n\n開発された（株）ピエクレックスの玉倉大次代表取締役社長に、実際にユニフォームを着用いただきながらご説明いただきました。\n\n元になる素材は、トウモロコシ由来で、微生物の働きにより水や二酸化炭素などのレベルにまで分解される「生分解性」を持つ「ポリ乳酸繊維」で、植物が持つ力を活かし、世界初の「2つの機能」を実現されているそうです。\n\n1つは、「圧電技術」といい、動くことで発生する微弱な電気の力を用いて、薬剤を使わずに「菌の増殖を抑える」技術、もう1つは繊維自体から肌に優しい「乳酸を滲み出させる」技術だそうです。\n\nまた、一般的なアパレル製品は、繊維以外に、ボタン、ファスナーなど、さまざまな部材からできており、循環が容易ではないそうですが、こうした課題を解決するため、多くの企業・団体の方々と連携され、｢生分解性素材｣の利用促進、分解できないファスナーなどの「部材を取り外しやすい製品」の設計、製品回収、堆肥化まで責任を持つ仕組みを構築されているとのこと。\n\nこの「着るグリーンテック」は、横浜グリーンエクスポの1万人以上のボランティアスタッフらが着用するユニフォームで活用されることが決まっており、来場者の方に、「循環型社会」実現への取組が、楽しいものであることを感じてもらいたいとのことでした。\n\nデモンストレーションでは、使い終わった製品が堆肥になり、土へ還り、そこから植物が育っている様子もご披露いただきました。\n早ければおおよそ3か月、遅くとも1年半程度で、見えなくなるまで分解されるそうです。\n\n横浜グリーンエクスポを機に、多くの方々の協力を得て、日本、そして世界に、こうした技術による「循環型社会」実現への取組を広げていければと思います。\n\n（株）ピエクレックスのリンク先：　https://t.co/8I4TaVMPle"}}},"rest_id":"2104883973394735527","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"204244","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104883973394735527","sortIndex":"2105186896480042939"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2104596613293621248/-yOuy4HG?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mof.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":200,"url":"https://pbs.twimg.com/card_img/2104596613293621248/-yOuy4HG?format=png&name=280x280_2","width":200},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":203,"url":"https://pbs.twimg.com/card_img/2104596613293621248/-yOuy4HG?format=png&name=orig","width":200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2104596613293621248/-yOuy4HG?format=png&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value