":483,"y":189}]},"orig":{"faces":[{"h":111,"w":111,"x":1457,"y":670},{"h":159,"w":159,"x":431,"y":299},{"h":152,"w":152,"x":1421,"y":477},{"h":129,"w":129,"x":434,"y":500},{"h":137,"w":137,"x":2087,"y":535},{"h":180,"w":180,"x":1048,"y":411}]},"small":{"faces":[{"h":29,"w":29,"x":381,"y":175},{"h":41,"w":41,"x":112,"y":78},{"h":39,"w":39,"x":371,"y":124},{"h":33,"w":33,"x":113,"y":130},{"h":35,"w":35,"x":545,"y":139},{"h":47,"w":47,"x":274,"y":107}]}},"id_str":"2104906967349358592","indices":[49,72],"media_key":"3_2104906967349358592","media_results":{"result":{"media_key":"3_2104906967349358592"}},"media_url_https":"https://pbs.twimg.com/media/HTYhvAoacAAIMrt.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1712,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/FBwiTtfdPC"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/FBwiTtfdPC","expanded_url":"https://x.com/takaichi_sanae/status/2104907433605013543/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":81,"w":81,"x":297,"y":573}]},"medium":{"faces":[{"h":48,"w":48,"x":174,"y":336}]},"orig":{"faces":[{"h":104,"w":104,"x":378,"y":728}]},"small":{"faces":[{"h":27,"w":27,"x":98,"y":190}]}},"id_str":"2104906988383875072","indices":[49,72],"media_key":"3_2104906988383875072","media_results":{"result":{"media_key":"3_2104906988383875072"}},"media_url_https":"https://pbs.twimg.com/media/HTYhwO_bsAAeg_J.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":282,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/FBwiTtfdPC"}]},"favorite_count":12515,"favorited":false,"full_text":"先ほど、日本を公式訪問中のオチラル・モンゴル首相と首脳会談及びワーキング・ディナーを行いました。 https://t.co/FBwiTtfdPC","id_str":"2104907433605013543","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":127,"reply_count":892,"retweet_count":1247,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ5MDc0MzM1Mjk1NTY5OTI=","richtext":{"richtext_tags":[]},"text":"先ほど、日本を公式訪問中のオチラル・モンゴル首相と首脳会談及びワーキング・ディナーを行いました。\n\n首脳会談では、まず、私から、オチラル首相の就任後初の二国間訪問先として、日本を選んでいただいたことを歓迎した上で、モンゴルの最も重要な「第三の隣国」として、進化した「自由で開かれたインド太平洋（FOIP）」の下、モンゴルの自律性・強靱性を支えていく旨を申し上げました。\n\nその上で、「平和と繁栄のための特別な戦略的パートナーシップ」の下、更なる協力を進めることを確認し、安全保障面、さらにはAIといった新たな分野での協力についても議論していくことで一致しました。\n\nまた、来年の「外交関係樹立55周年」に当たり、当時の岸田総理とフレルスフ大統領が発表した2022年の首脳共同声明・行動計画を踏まえた、経済分野をはじめとする協力の進捗を共に確認し、両国で連携を強化していくこととしました。\n\nさらに、近年モンゴル経済が好調に発展を遂げていることを踏まえ、進化したFOIPの下、両国間の経済分野での協力関係をいかに深化させていくか意見を交わし、オチラル首相の推進するビジネス環境の整備促進のため、議論を一層深めるとともに、租税条約の締結に向けた交渉の早期開始や、社会保障協定の予備協議の実施で一致しました。\n\nこの首脳会談の機を捉え、本日、日本企業が運営に参画しているチンギス・ハーン国際空港の拡張に関する円借款の交換公文の署名・交換を行いました。\n\n空の連結性の鍵であるチンギス・ハーン国際空港における日・モンゴル間協力は重要であり、本協力は日本企業のモンゴルとの貿易やビジネスの促進に資するものです。\n\nパワー・アジアの下、石油備蓄や再生可能エネルギー関連分野で積極的に協力していくことも一致しました。\n\n国連を含む国際場裡での協力及び地域の平和と安定に向けた協力についても、一層強化していくことを確認したほか、私から、拉致問題へのモンゴルの理解と協力に対しても、改めてオチラル首相に感謝をお伝えました。\n\nオチラル首相からは、日本が「平和国家」として国際社会の平和と安定に長きにわたり貢献していることへの高い評価をいただくとともに、2022年の共同声明の内容を着実に実施していく旨の発言がありました。\n\nモンゴルの最も重要な「第三の隣国」として、これからもオチラル首相と緊密に連携してまいります。"}}},"rest_id":"2104907433605013543","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"346694","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104907433605013543","sortIndex":"2105186896480042957"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1769788,"following":47},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":fal