load":true},"display_url":"pic.x.com/aJY0QnOW1f","expanded_url":"https://x.com/takaichi_sanae/status/2104885148286386568/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":181,"w":181,"x":1491,"y":383}]},"medium":{"faces":[{"h":106,"w":106,"x":874,"y":224}]},"orig":{"faces":[{"h":231,"w":231,"x":1894,"y":487}]},"small":{"faces":[{"h":60,"w":60,"x":495,"y":127}]}},"id_str":"2104884688909418496","indices":[143,166],"media_key":"3_2104884688909418496","media_results":{"result":{"media_key":"3_2104884688909418496"}},"media_url_https":"https://pbs.twimg.com/media/HTYNeO-awAAUj_1.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":238,"y":0},{"h":1734,"w":1521,"x":345,"y":0},{"h":1734,"w":867,"x":672,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/aJY0QnOW1f"}]},"favorite_count":15167,"favorited":false,"full_text":"＜スギから生まれる高機能プラスチック代替素材＞\n\n3つ目は、「改質リグニン」という｢スギ｣を原料にした世界で初めての新素材です。\n\n国立研究開発法人森林研究・整備機構森林総合研究所の上席研究員でもある、（株）木質素研究所（リグニンラボ）の山田竜彦取締役CTOからご説明いただきました。 https://t.co/aJY0QnOW1f","id_str":"2104885148286386568","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":191,"reply_count":448,"retweet_count":2074,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"lignin-lab.jp","expanded_url":"https://lignin-lab.jp/","indices":[984,1007],"url":"https://t.co/lzL1QGGzdW"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ4ODUxNDgxMTQzNzg3NTI=","richtext":{"richtext_tags":[]},"text":"＜スギから生まれる高機能プラスチック代替素材＞\n\n3つ目は、「改質リグニン」という｢スギ｣を原料にした世界で初めての新素材です。\n\n国立研究開発法人森林研究・整備機構森林総合研究所の上席研究員でもある、（株）木質素研究所（リグニンラボ）の山田竜彦取締役CTOからご説明いただきました。\n\n「改質リグニン」は、強度や加工性に優れ、半導体材料や繊維強化プラスチックなどの石油由来の材料を超える、「高機能材料」としての利用が期待されています。\n\n「スギ」花粉症に悩む方々も多くおられますが、国内の「スギ」人工林は、その約６割が「利用期」を迎え、安定供給が可能になっており、「スギ」を活用することで中山間地域に新たな素材産業を創出することも期待できます。\n\n使い道としては、特に運輸部門で、「材料の強度・軽量化」や「バイオマス素材の活用」への関心が高いそうで、例えば、昨年末から、一部の私鉄で、「改質リグニン」を使った「ブレーキ」のテスト搭載が始まっているとのことでした。\n\n高機能プラスチックを「改質リグニン」で代替することが期待できるので、ＥＶやドローン、半導体の分野等での幅広い活用が期待できそうです。\n\nまた、国際情勢に左右されるナフサ由来のプラスチックを減らし、国産「スギ」で代替できるため、「経済安全保障」の面でも有効な技術といえます。\n\nデモンストレーションとして、車の「ボンネット」をご持参いただき、官房長官に、従来の製品と「改質リグニン」を使用した製品の両方を実際に持って、比較してもらいました。\n官房長官も「リグニンを使った製品は指でも持てる軽さ」と仰っていたので、私も持ってみましたが、本当に軽くて驚きました。\nかなり燃費が向上することでしょう。\n\nこの技術もまた、「エネルギー効率化」といった社会課題を解決すると同時に、「価格競争力」も期待できる技術であり、成長の「原動力」になり得ると感じました。\n\n以上、3つの「きらりと光る新技術」をご説明させていただきましたが、改めて、「横浜グリーンエクスポ」は、皆様が楽しめる万博にすることはもとより、「グリーン技術の産業見本市」としても成功させたいとの思いを強くいたしました。\n\n次回、また「きらりと光る新技術」をご披露いただくのをとても楽しみにしています。\n\n（株）木質素研究所（リグニンラボ）のリンク先：https://t.co/lzL1QGGzdW"}}},"rest_id":"2104885148286386568","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"371895","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104885148286386568","sortIndex":"2105186896480042941"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","scree