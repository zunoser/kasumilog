t_tweet_ids":["2090759078683554041"],"editable_until_msecs":"1787314383000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2090759078683554041","created_at":"Fri Aug 21 11:13:03 +0000 2026","display_text_range":[0,74],"entities":{"media":[{"display_url":"pic.x.com/LRhGeesmgH","expanded_url":"https://x.com/MofaJapan_jp/status/2090759078683554041/photo/1","ext_alt_text":"西岡達史在大韓民国日本国大使館公使の日中韓協力事務局長の就任について\n\n１　９月１日付で、西岡達史在大韓民国日本国大使館公使が、日中韓協力事務局（所在地：ソウル）の事務局長に就任します。\n\n２　我が国としては、西岡新事務局長が、日中韓３か国が加盟する国際機関たる日中韓協力事務局の長として、３か国協力の更なる発展に貢献することを期待しています。\n\n３　また、これまで３年間事務局長を務めた李熙燮（イ・ヒソプ）現事務局長の活動を高く評価し、日中韓３か国協力の推進に対する貢献に謝意を表します。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":41,"w":41,"x":418,"y":710}]},"medium":{"faces":[{"h":37,"w":37,"x":386,"y":656}]},"orig":{"faces":[{"h":41,"w":41,"x":418,"y":710}]},"small":{"faces":[{"h":21,"w":21,"x":218,"y":371}]}},"id_str":"2090758725015592960","indices":[75,98],"media_key":"3_2090758725015592960","media_results":{"result":{"media_key":"3_2090758725015592960"}},"media_url_https":"https://pbs.twimg.com/media/HQPd-6uaYAAWBKq.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":0},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":389,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/LRhGeesmgH"}],"urls":[{"display_url":"mofa.go.jp/mofaj/press/da…","expanded_url":"https://www.mofa.go.jp/mofaj/press/danwa/pageit_000001_00056.html","indices":[51,74],"url":"https://t.co/h1aaDhQIvf"}]},"exten