","original_info":{"focus_rects":[{"h":364,"w":650,"x":0,"y":0},{"h":531,"w":531,"x":76,"y":0},{"h":531,"w":466,"x":108,"y":0},{"h":531,"w":266,"x":208,"y":0},{"h":531,"w":650,"x":0,"y":0}],"height":531,"width":650},"sizes":{"large":{"h":531,"resize":"fit","w":650},"medium":{"h":531,"resize":"fit","w":650},"small":{"h":531,"resize":"fit","w":650},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/as3UQfMC7D"}]},"favorite_count":715,"favorited":false,"full_text":"令和８年８月２１日（金）午前から午後にかけて、ロシアの情報収集機（I L-20）×１機が、大陸方面から飛来し、日本海上空を石川県沖まで飛行後、 反転し、大陸方面へ飛行したことを確認しました。 これに対して航空自衛隊の北部航空方面隊等の戦闘機を緊急発進させ対応し ました。 https://t.co/as3UQfMC7D","id_str":"2090789841172902024","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":11,"reply_count":12,"retweet_count":221,"retweeted":false,"user_id_str":"864751444586397696"},"previous_counts":{"bookmark_count":5,"favorite_count":415,"quote_count":12,"reply_count":8,"retweet_count":100},"rest_id":"2090789841172902024","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"42536","state":"EnabledWithCount"}}},"rest_id":"2090790921264869603","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"30756","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090790921264869603","sortIndex":"2090886104730304511"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2090886104730304514-tweet-2090779001346568332","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2090628972732387328"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":585081,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20055,"tweets":48682},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2090779001346568332"],"editable_until_msecs":"1787319133000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":67,"bookmarked":false,"conversation_id_str":"2090779001346568332","created_at":"Fri Aug 21 12:32:13 +0000 2026","display_text_range":[0,55],"entities":{"media":[{"display_url":"pic.x.com/CKyCFPU35s","expanded_url":"https://x.com/MofaJapan_jp/status/2090779001346568332/photo/1","ext_alt_text":"ヨルダン川西岸地区情勢について\n\n１　我が国は、ヨルダン川西岸地区のＥ１地区における入植地建設計画が進められていることについて、深く懸念しています。我が国を含む国際社会による累次の呼びかけにもかかわらず、イスラエル政府が入植活動を含む一方的行為を継続していることについて、改めて強い遺憾の意を表明するとともに、イスラエル政府に対し、当該計画の撤回及び入植活動の完全凍結を改めて強く求めます。また、イスラエル政府が入植者による暴力を防止するために適切な措置を速やかに取ることを重ねて求めます。\n\n２　入植活動は国際法違反であり、「二国家解決」の実現を損なうものです。我が国として、「二国家解決」による中東和平の実現の重要性を改めて強調するとともに、引き続き国際社会と連携し、イスラエル政府による入植活動の阻止に向けて、あらゆる外交努力を行っていきます。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2090778994115559425","indices":[56,79],"media_key":"3_2090778994115559425","media_results":{"result":{"media_key":"3_2090778994115559425"}},"media_url_https":"https://pbs.twimg.com/media/HQPwavAbQAESme6.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":960,"w":960,"x":0,"y":0},{"h":1094,"w":960,"x":0,"y":0},{"h":1200,"w":600,"x":360,"y":0},{"h":1200,"w":960,"x":0,"y":0}],"height":1200,"width":960},"sizes":{"large":{"h":1200,"resize":"fit","w":960},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/CKyCFPU35s"}],"urls":[{"display_url":"mofa.go.jp/mofaj/press/da…","expanded_url":"https://www.mofa.go.jp/mofaj/press/danwa/pageit_000001_03145.html","indices":[32,55],"url":"https://t.co/QVVXBgtJjY"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/CKyCFPU35s","expanded_url":"https://x.com/MofaJapan_jp/status/2090779001346568332/photo/1","ext_alt_text":"ヨルダン川西岸地区情勢について\n\n１　我が国は、ヨルダン川西岸地区のＥ１地区における入植地建設計画が進められていることについて、深く懸念しています。我が国を含む国際社会による累次の呼びかけにもかかわらず、イスラエル政府が入植活動を含む一方的行為を継続していることについて、改めて強い遺憾の意を表明するとともに、イスラエル政府に対し、当該計画の撤回及び入植活動の完全凍結を改めて強く求めます。また、イスラエル政府が入植者による暴力を防止するために適切な措置を速やかに取ることを重ねて求めます。\n\n２　入植活動は国際法違反であり、「二国家解決」の実現を損なうものです。我が国として、「二国家解決」による中東和平の実現の重要性を改めて強調するとともに、引き続き国際社会と連携し、イスラエル政府による入植活動の阻止に向けて、あらゆる外交努力を行っていきます。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2090778994115559425","indices":[56,79],"media_key":"3_2090778994115559425","media_results":{"result":{"media_key":"3_2090778994115559425"}},"media_url_https":"https://pbs.twimg.com/media/HQPwavAbQAESme6.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":960,"w":960,"x":0,"y":0},{"h":1094,"w":960,"x":0,"y":0},{"h":1200,"w":600,"x":360,"y":0},{"h":1200,"w":960,"x":0,"y":0}],"height":1200,"width":960},"sizes":{"large":{"h":1200,"resize":"fit","w":960},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/CKyCFPU35s"}]},"favorite_count":484,"favorited":false,"full_text":"ヨルダン川西岸地区情勢について、外務報道官談話を発出しました。\nhttps://t.co/QVVXBgtJjY https://t.co/CKyCFPU35s","id_str":"2090779001346568332","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":48,"reply_count":19,"retweet_count":217,"retweeted":false,"user_id_str":"303730149"},"rest_id":"2090779001346568332","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"25428","state"