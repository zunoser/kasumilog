_count":0,"retweet_count":3,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[20,32],"text":"放課後ゲンバミッション"},{"indices":[100,104],"text":"ゲンミ"},{"indices":[299,303],"text":"ゲンミ"},{"indices":[305,315],"text":"国交省建設産業PR"},{"indices":[316,327],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/M4CywtOxC74","expanded_url":"https://youtu.be/M4CywtOxC74","indices":[174,197],"url":"https://t.co/0Nq8lxLhP0"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[274,297],"url":"https://t.co/kPJLLRPIOH"},{"display_url":"x.com/houkago_gennmi…","expanded_url":"https://x.com/houkago_gennmi/status/2105556887429369895","indices":[328,351],"url":"https://t.co/Dnu2Syqcdg"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU1NzA5MTc1NDQwMjIwMTY=","richtext":{"richtext_tags":[]},"text":"╋━━━━━━━\n\n　YouTube　『#放課後ゲンバミッション！』\n\n　　　　　　　　　　　　　　━━━━━━╋\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「 #ゲンミ！（現場ミッション）」に挑戦✨\n\n今回は『内装仕上工事』について\n職人さんの貴重なお話と、匠の技の凄さを\n中高生の目線でお届けします！\n\n📺https://t.co/0Nq8lxLhP0\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPIOH\n\n#ゲンミ！\n#国交省建設産業PR\n#MLIT建設産業PR\nhttps://t.co/Dnu2Syqcdg"}}},"previous_counts":{"bookmark_count":0,"favorite_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"quoted_status_result":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/M4CywtOxC74","type":"STRING"}},{"key":"player_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2105556890860310528/4UF8VPv3?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"player_image","value":{"image_value":{"height":158,"url":"https://pbs.twimg.com/card_img/2105556890860310528/4UF8VPv3?format=jp