ze":"crop","w":150}},"type":"photo","url":"https://t.co/g4tUN8z3jN"}]},"favorite_count":11234,"favorited":false,"full_text":"本日、「自民党 外国人政策本部 安全保障と土地法制に関するPT」を代表して、新藤外国人政策本部長、北村PT座長、本田PT事務局長代理、勝目PT事務局長次長が官邸にお越しになり、「安全保障と土地法制に関するPT提言」を頂戴しました。 https://t.co/g4tUN8z3jN","id_str":"2105603898862112851","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":140,"reply_count":665,"retweet_count":1411,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU2MDM4OTg3OTQ5NzkzMjg=","richtext":{"richtext_tags":[]},"text":"本日、「自民党 外国人政策本部 安全保障と土地法制に関するPT」を代表して、新藤外国人政策本部長、北村PT座長、本田PT事務局長代理、勝目PT事務局長次長が官邸にお越しになり、「安全保障と土地法制に関するPT提言」を頂戴しました。\n\n安全保障上の懸念がある土地などの取引について、どのような規制を設けるべきかは、我が国の国益、国民の皆様の暮らしや安全にも関わる、大変重要な課題です。\n\n「外国人政策本部」の皆様からは、これまでも2回にわたり貴重なご提言をいただき、政府でも有識者会議を開催するなど、具体的な制度の在り方について検討を進めてきました。\n\n本日のご提言には、安全保障の観点からの土地取得などのルールに加え、地下水保全、国土の適切な利用、マンションの取得ルールなど、幅広く有意義な内容が含まれています。\n\n頂戴したご提言を踏まえ、まずは、安全保障の観点からの土地取得の新たなルールなどを内容とする『重要土地等調査法』の改正案を、10月５日に開会する臨時国会に提出すべく、取組を進めてまいります。"}}},"rest_id":"2105603898862112851","unmention_data":{},"views":{"count":"352345","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105603898862112851","sortIndex":"2105844416353665007"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/3692310981/5e84849fe6a5c60b