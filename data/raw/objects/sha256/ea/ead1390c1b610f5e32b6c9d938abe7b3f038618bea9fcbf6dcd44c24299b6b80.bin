w":150,"x":1002,"y":504}]},"medium":{"faces":[{"h":73,"w":73,"x":741,"y":203},{"h":90,"w":90,"x":919,"y":150},{"h":84,"w":84,"x":396,"y":160},{"h":87,"w":87,"x":587,"y":295}]},"orig":{"faces":[{"h":126,"w":126,"x":1266,"y":348},{"h":154,"w":154,"x":1570,"y":256},{"h":144,"w":144,"x":676,"y":274},{"h":150,"w":150,"x":1002,"y":504}]},"small":{"faces":[{"h":41,"w":41,"x":420,"y":115},{"h":51,"w":51,"x":521,"y":85},{"h":47,"w":47,"x":224,"y":90},{"h":49,"w":49,"x":332,"y":167}]}},"id_str":"2105549745532063744","indices":[120,143],"media_key":"3_2105549745532063744","media_results":{"result":{"media_key":"3_2105549745532063744"}},"media_url_https":"https://pbs.twimg.com/media/HThqVn9aUAAhMSQ.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1536,"w":1536,"x":512,"y":0},{"h":1536,"w":1347,"x":701,"y":0},{"h":1536,"w":768,"x":1280,"y":0},{"h":1536,"w":2048,"x":0,"y":0}],"height":1536,"width":2048},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KL4gMlDN0x"}]},"favorite_count":1539,"favorited":false,"full_text":"本日10月1日、サイバー対処能力強化法等の施行により、自衛隊に「アクセス・無害化措置」任務が新たに付与されました。 \n \nサイバー空間では、国家を背景とするサイバー攻撃が平素から重要インフラを標的とし、国家安全保障上の脅威となっています。 https://t.co/KL4gMlDN0x","id_str":"2105549755237667195","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":19,"reply_count":30,"retweet_count":358,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU1NDk3NTUxNzkwMjg0ODA=","text":"本日10月1日、サイバー対処能力強化法等の施行により、自衛隊に「アクセス・無害化措置」任務が新たに付与されました。 \n \nサイバー空間では、国家を背景とするサイバー攻撃が平素から重要インフラを標的とし、国家安全保障上の脅威となっています。 \nこうしたなか、本任務に基づき、自衛隊の指揮統制・情報システムはもちろんのこと、国や民間の基幹インフラなどに対する重大なサイバー攻撃を未然に防止すべく、攻撃元サーバー等に対して能動的にアクセスし、脅威を取り除くことが、可能になりました。 \n \n本任務は、有事以前から国民生活・経済活動を守ることはもちろんのこと、有事における自衛隊の任務を確実に遂行する上で極めて重要です。このため、本任務の中核を担う自衛隊サイバー防衛隊を小泉防衛大臣が改めて視察し、本任務のために新たに設置された作戦室において、部隊を激励するとともに、作戦を指揮する統合作戦司令官に対し、本任務の遂行に万全の態勢を期すよう下令しました。 \n \n防衛省・自衛隊として、これまで培ったサイバー防衛能力を最大限発揮できるよう、警察機関や内閣官房国家サイバー統括室と連携しながら、必要な準備を重ねてきました。いかなる事態にあっても、国民の生命・財産と、わが国の領土・領海・領空、そして、我が国のサイバー空間を断固として守り抜くため、本任務の遂行に全力を尽くしてまいります。"}}},"rest_id":"2105549755237667195","unmention_data":{},"views":{"count":"114940","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105549755237667195","sortIndex":"2105844416353664958"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/1uDJmtkw8R"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":8},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"公正取引委員会の公式アカウントです。 \n公正かつ自由な競争について理解を深めていただくため、措置命令等の報道発表、関係法令（独占禁止法、取適法、フリーランス法、スマホ法等）の解説、イベント・採用情報等をお届けします。 \n#独占禁止法 #取適法 #スマホ法 #フリーランス法","entitie