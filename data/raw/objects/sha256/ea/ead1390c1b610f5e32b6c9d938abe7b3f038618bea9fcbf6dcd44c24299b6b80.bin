3725","created_at":"Thu Oct 01 05:20:55 +0000 2026","display_text_range":[0,130],"entities":{},"favorite_count":60,"favorited":false,"full_text":"10月1日、サイバー対処能力強化法に基づく官民連携の強化等に関する制度がスタートしました。\n総務省は、電気通信・放送・郵便の各分野において、国家サイバー統括室をはじめとする関係省庁等と緊密に連携し、基幹インフラのサイバーセキュリティ強化に取り組んでまいります。","id_str":"2105528362831933725","is_quote_status":true,"lang":"ja","quote_count":0,"quoted_status_id_str":"2105510786789753010","quoted_status_permalink":{"display":"x.com/cas_cyberpr/st…","expanded":"https://twitter.com/cas_cyberpr/status/2105510786789753010","url":"https://t.co/i7rFUWEoot"},"reply_count":4,"retweet_count":27,"retweeted":false,"user_id_str":"1469058582"},"quoted_status_result":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/7UWi6lP4ly"},"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":6},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1939847688519843840/ZOuxscmw_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/466036411/1773824532"},"core":{"created_at":"Tue Jan 17 00:31:24 +0000 2012","name":"NCO国家サイバー統括室","screen_name":"cas_cyberpr"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjYwMzY0MTE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国家サイバー統括室(NCO)の公式アカウントです。サイバーセキュリティに関する国の取組や普及啓発等の情報を発信しています。","entities":{"description":{},"url":{"urls":[{"display_url":"security-portal.cyber.go.jp","expanded_url":"https://security-portal.cyber.go.jp/","indices":[0,23],"url":"https://t.co/JzBaL2Ee4l"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type