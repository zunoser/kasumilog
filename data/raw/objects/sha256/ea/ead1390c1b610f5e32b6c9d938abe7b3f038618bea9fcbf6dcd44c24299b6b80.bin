post_with_availability":{"data":{"associated_data":{},"destination_language":"ja","entities":{"hashtags":[],"symbols":[],"urls":[],"user_mentions":[]},"preview_translation":"日本は深刻なサイバー脅威への対応能力を強化しています。10月1日、日本版「積極的サイバーディフェンス法」に基づき、「官民連携の強化」と「リモートアクセスと無害化措置」が正式に施行されました。これらの取り組みにより、日本はインド太平洋地域およびさらに広範な地域のサイバーセキュリティに","source_language":"zh","translation":"日本は深刻なサイバー脅威への対応能力を強化しています。10月1日、日本版「積極的サイバーディフェンス法」に基づき、「官民連携の強化」と「リモートアクセスと無害化措置」が正式に施行されました。これらの取り組みにより、日本はインド太平洋地域およびさらに広範な地域のサイバーセキュリティに一層貢献していくことでしょう。"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"JapanCyberGov"}}},"policy":"ByInvitation"},"conversation_id_str":"2105550982449070294","created_at":"Thu Oct 01 06:50:48 +0000 2026","display_text_range":[0,118],"entities":{"user_mentions":[{"id_str":"2059532201243582464","indices":[3,17],"name":"National Cybersecurity Office of Japan","screen_name":"JapanCyberGov"}]},"favorite_count":0,"favorited":false,"full_text":"RT @JapanCyberGov: 日本正在加强应对严重网络威胁的能力。10月1日，根据日本《主动网络防御法》，\"强化官民合作\"和\"远程访问与无害化措施\"正式生效。通过这些举措，日本将进一步为印太地区乃至更广泛区域的网络安全作出贡献。","id_str":"2105550982449070294","is_quote_status":false,"lang":"zh","quote_count":0,"reply_count":0,"retweet_count":5,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2061311823304163328/O03aML_b_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/20595322