594262603870212","created_at":"Thu Oct 01 09:42:46 +0000 2026","display_text_range":[0,141],"entities":{},"favorite_count":115,"favorited":false,"full_text":"エクアドルの首都キトにおいて、第2回日・エクアドル経済貿易委員会会合が開催されました。幅広い分野における日エクアドル経済関係の深化の方途について活発な議論が行われ、8月の茂木外務大臣のエクアドル訪問の際に確認されたとおり、今次会合を含む経済貿易委員会での議論の成果を年内をめどに両国","id_str":"2105594262603870212","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":3,"retweet_count":20,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04237.html","indices":[208,231],"url":"https://t.co/YIcVGLGZUR"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU1OTQyNjI0OTA2MDM1MjA=","richtext":{"richtext_tags":[]},"text":"エクアドルの首都キトにおいて、第2回日・エクアドル経済貿易委員会会合が開催されました。幅広い分野における日エクアドル経済関係の深化の方途について活発な議論が行われ、8月の茂木外務大臣のエクアドル訪問の際に確認されたとおり、今次会合を含む経済貿易委員会での議論の成果を年内をめどに両国の外相に報告し、その報告を踏まえ、EPAに関する共同研究を立ち上げることを検討するために、引き続き議論していくことで一致しました。\n\nhttps://t.co/YIcVGLGZUR"}}},"rest_id":"2105594262603870212","unmention_data":{},"views":{"count":"14242","state":"EnabledWithCount"}}}}},"entryId":"tweet-2105594262603870212","sortIndex":"2105844416353665000"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/z1DVI8pYN0"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_