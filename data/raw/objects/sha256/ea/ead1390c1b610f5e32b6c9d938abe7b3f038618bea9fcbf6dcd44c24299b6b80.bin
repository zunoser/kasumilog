https://pbs.twimg.com/media/HTiEM-baYAE8NMC.jpg","original_info":{"focus_rects":[{"h":605,"w":1080,"x":0,"y":94},{"h":1080,"w":1080,"x":0,"y":0},{"h":1231,"w":1080,"x":0,"y":0},{"h":1440,"w":720,"x":324,"y":0},{"h":1440,"w":1080,"x":0,"y":0}],"height":1440,"width":1080},"sizes":{"large":{"h":1440,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/LZncMlvj1I"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/LZncMlvj1I","expanded_url":"https://x.com/ModJapan_jp/status/2105583501009617319/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":68,"w":68,"x":101,"y":442},{"h":70,"w":70,"x":260,"y":1328},{"h":140,"w":140,"x":842,"y":975},{"h":265,"w":265,"x":527,"y":781}]},"medium":{"faces":[{"h":56,"w":56,"x":84,"y":368},{"h":58,"w":58,"x":216,"y":1106},{"h":116,"w":116,"x":701,"y":812},{"h":220,"w":220,"x":439,"y":650}]},"orig":{"faces":[{"h":68,"w":68,"x":101,"y":442},{"h":70,"w":70,"x":260,"y":1328},{"h":140,"w":140,"x":842,"y":975},{"h":265,"w":265,"x":527,"y":781}]},"small":{"faces":[{"h":32,"w":32,"x":47,"y":208},{"h":33,"w":33,"x":122,"y":627},{"h":66,"w":66,"x":397,"y":460},{"h":125,"w":125,"x":248,"y":368}]}},"id_str":"2105578184246976513","indices":[134,157],"media_key":"3_2105578184246976513","media_results":{"result":{"media_key":"3_2105578184246976513"}},"media_url_https":"https://pbs.twimg.com/media/HTiEM-baYAE8NMC.jpg","original_info":{"focus_rects":[{"h":605,"w":1080,"x":0,"y":94},{"h":1080,"w":1080,"x":0,"y":0},{"h":1231,"w":1080,"x":0,"y":0},{"h":1440,"w":720,"x":324,"y":0},{"h":1440,"w":1080,"x":0,"y":0}],"height":1440,"width":1080},"sizes":{"large":{"h":1440,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/LZncMlvj1I"}]},"favorite_count":418,"favorited":false,"full_text":"【なぜいまシリーズ㉑】\n\n第21弾は、「イラン情勢でみられた戦い方や課題」への対応について☝\n \nイラン情勢では、AIや無人機などを活用した「新しい戦い方」が展開された一方、「地の利」を活用するといったこれまでも行われていた普遍的な戦い方も、引き続き展開されました。 https://t.co/LZncMlvj1I","id_str":"2105583501009617319","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"quoted_status_id_str":"2092902614816133126","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2092902614816133126","url":"https://t.co/WMlNihVUP3"},"reply_count":10,"retweet_count":86,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[318,323],"text":"なぜいま"},{"indices":[476,482],"text":"防衛力変革"},{"indices":[483,487],"text":"三文書"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDU1ODM1MDA5MjU4MzMyMTY=","text":"【なぜいまシリーズ㉑】\n\n第21弾は、「イラン情勢でみられた戦い方や課題」への対応について☝\n \nイラン情勢では、AIや無人機などを活用した「新しい戦い方」が展開された一方、「地の利」を活用するといったこれまでも行われていた普遍的な戦い方も、引き続き展開されました。\nまた、多様な攻撃に対応できる防空能力の構築や持続的な対応能力の確保といった課題なども、改めて浮き彫りになりました。\n \nこうした戦い方の変化に適切に対応していくため、日本としても、防衛力の強化に加え、同盟国・同志国との連携を一層強化していくことが必要です。\n \n国民の皆様の命と平和な暮らしを守り抜くための重要なポイントを\n「なぜいま防衛力の変革が必要なのか（略して「#なぜいま」）」\nというシリーズでお伝えしています。\n \n普段の生活には関係ないと思われるかもしれませんが、日本を取り巻く安全保障環境が厳しさを増す中で、防衛省・自衛隊の取組は国民の平和な暮らしに直結するものです。\n本年中の三文書改定に向けて検討が進められる今、\nこの機会に、知っていただきたいと思っています。\n \n#防衛力変革\n#三文書"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sen