14816133126","created_at":"Thu Aug 27 09:10:42 +0000 2026","display_text_range":[0,89],"entities":{"media":[{"display_url":"pic.x.com/OBejkpVw9M","expanded_url":"https://x.com/ModJapan_jp/status/2092902614816133126/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":74,"w":74,"x":105,"y":379}]},"medium":{"faces":[{"h":61,"w":61,"x":87,"y":315}]},"orig":{"faces":[{"h":74,"w":74,"x":105,"y":379}]},"small":{"faces":[{"h":34,"w":34,"x":49,"y":178}]}},"id_str":"2092902399874904065","indices":[90,113],"media_key":"3_2092902399874904065","media_results":{"result":{"media_key":"3_2092902399874904065"}},"media_url_https":"https://pbs.twimg.com/media/HQt7pN4bMAELQEs.jpg","original_info":{"focus_rects":[{"h":605,"w":1080,"x":0,"y":22},{"h":1080,"w":1080,"x":0,"y":0},{"h":1231,"w":1080,"x":0,"y":0},{"h":1440,"w":720,"x":0,"y":0},{"h":1440,"w":1080,"x":0,"y":0}],"height":1440,"width":1080},"sizes":{"large":{"h":1440,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OBejkpVw9M"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/OBejkpVw9M","expanded_url":"https://x.com/ModJapan_jp/status/2092902614816133126/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":74,"w":74,"x":105,"y":379}]},"medium":{"faces":[{"h":61,"w":61,"x":87,"y":315}]},"orig":{"faces":[{"h":74,"w":74,"x":105,"y":379}]},"small":{"faces":[{"h":34,"w":34,"x":49,"y":178}]}},"id_str":"2092902399874904065","indices":[90,113],"media_key":"3_2092902399874904065","media_results":{"result":{"media_key":"3_2092902399874904065"}},"media_url_https":"https://pbs.twimg.com/media/HQt7pN4bMAELQEs.jpg","original_info":{"focus_rects":[{"h":605,"w":1080,"x":0,"y":22},{"h":1080,"w":1080,"x":0,"y":0},{"h":1231,"w":1080,"x":0,"y":0},{"h":1440,"w":720,"x":0,"y":0},{"h":1440,"w":1080,"x":0,"y":0}],"height":1440,"width":1080},"sizes":{"large":{"h":1440,"resize":"fit","w":1080},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OBejkpVw9M"}]},"favorite_count":536,"favorited":false,"full_text":"【なぜいまシリーズ⑳】\n第20弾は、「同盟国との協力」について☝\n\n日本を守るためには、日本自身の防衛力を強化するとともに、同盟国や同志国との連携を深めていくことも大変重要です。 https://t.co/OBejkpVw9M","id_str":"2092902614816133126","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"quoted_status_id_str":"2085289945972031574","quoted_status_permalink":{"display":"x.com/ModJapan_jp/st…","expanded":"https://twitter.com/ModJapan_jp/status/2085289945972031574","url":"https://t.co/F64FzgOLTj"},"reply_count":21,"retweet_count":128,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[237,242],"text":"なぜいま"},{"indices":[393,399],"text":"防衛力変革"},{"indices":[400,404],"text":"三文書"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTI5MDI2MTQ3NDkwOTc5ODQ=","text":"【なぜいまシリーズ⑳】\n第20弾は、「同盟国との協力」について☝\n\n日本を守るためには、日本自身の防衛力を強化するとともに、同盟国や同志国との連携を深めていくことも大変重要です。\n\n共同訓練や装備協力、運用面での連携強化などを通じて、日米同盟の抑止力・対処力を高めるとともに、同志国との協力へと輪を広げ、日本と地域の平和と安定を支える態勢の強化に取り組んでいます。\n\n国民の皆様の命と平和な暮らしを守り抜くための重要なポイントを\n「なぜいま防衛力の変革が必要なのか（略して「#なぜいま」）」\nというシリーズでお伝えしています。\n\n普段の生活には関係ないと思われるかもしれませんが、日本を取り巻く安全保障環境が厳しさを増す中で、防衛省・自衛隊の取組は国民の平和な暮らしに直結するものです。\n本年中の三文書改定に向けて検討が進められる今、\nこの機会に、知っていただきたいと思っています。\n\n#防衛力変革\n#三文書"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2085289945972031574"}},"rest_id":"2092902614816133126","unmention_data":{},"views":{"count":"85111","state":"EnabledWithCount"}}},"rest_id":"2105583501009617319","unmention_data":{},"views":{"count":"41698","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2105844416353665066-tweet-2105583501760455148","item":{"clientEve