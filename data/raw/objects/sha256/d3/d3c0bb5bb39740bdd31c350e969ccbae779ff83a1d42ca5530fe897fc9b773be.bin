10,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/UTcL6Luzgm"}]},"favorite_count":39,"favorited":false,"full_text":"【可搬式浄水装置による給水を明日から開始】\n熊本県八代市に設置した可搬式浄水装置の試運転が完了し、明日（9/12）から給水（生活用水）を開始します。水質検査の結果、飲み水としての基準を満たすことが確認された後は、飲料水として給水する予定です。 https://t.co/UTcL6Luzgm","id_str":"2098302634835025983","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":2,"retweet_count":15,"retweeted":false,"user_id_str":"525120344"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"water.go.jp/honsya/honsya/…","expanded_url":"https://www.water.go.jp/honsya/honsya/kisya/pdf/2026/09/20260911_honsya.pdf","indices":[165,188],"url":"https://t.co/z8fP8fG1z6"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTgzMDI2MzQ3MjE3ODM4MDg=","richtext":{"richtext_tags":[]},"text":"【可搬式浄水装置による給水を明日から開始】\n熊本県八代市に設置した可搬式浄水装置の試運転が完了し、明日（9/12）から給水（生活用水）を開始します。水質検査の結果、飲み水としての基準を満たすことが確認された後は、飲料水として給水する予定です。\n写真は浄水前の原水と浄水後の生産水を比較したもの、水質検査の採水（生産水）状況です。\nhttps://t.co/z8fP8fG1z6"}}},"rest_id":"2098302634835025983","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3432","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2098594332530081815","source":"<a href=\"http://twitter.com/download/android\" rel=\"nofollow\">Twitter for Android</a>","unmention_data":{},"views":{"count":"664","state":"EnabledWithCount"}}}}},"entryId":"tweet-2098594332530081815","sortIndex":"2098649853952262137"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2098649853952262152-tweet-20985839991