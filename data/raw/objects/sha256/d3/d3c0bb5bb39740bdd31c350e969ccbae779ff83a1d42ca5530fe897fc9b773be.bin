e":"crop","w":150}},"type":"photo","url":"https://t.co/HaMmhf4wRi"}]},"favorite_count":47,"favorited":false,"full_text":"🪐宇宙への探究心とともに進歩する技術🔭\n\n約400年前の望遠鏡の発明により天文観測🌌の分野は急成長しました。宇宙の研究は天体望遠鏡の技術革新とともに進んできたのです。\n「#一家に1枚 天体望遠鏡」では望遠鏡が天文学の課題に挑み続けた歴史を紐解きます。ダウンロードはツリーから👇 https://t.co/HaMmhf4wRi","id_str":"2098305542108143904","in_reply_to_screen_name":"mextjapan","in_reply_to_status_id_str":"2098305541432824257","in_reply_to_user_id_str":"242156036","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":1,"retweet_count":11,"retweeted":false,"user_id_str":"242156036"},"rest_id":"2098305542108143904","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"4771","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2098649853952262206-tweet-2098305542833766531","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2097257534344265728/dH-RWcrn?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"文部科学省は、科学技術について広く国民の皆様の理解と関心を深めて頂くため、毎年、4月18日の発明の日を含む月曜日から日曜日の「科学技術週間」において、科学技術関連行事（講演会、展覧会、映画会、座談会、施設公開等）の開催を推進しています。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.mext.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":207,"url":"https://pbs.twimg.com/card_img/2097257534344265728/dH-RWcrn?format=jpg&name=280x280_2","width":207},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":289,"url":"https://pbs.twimg.com/card_img/20972