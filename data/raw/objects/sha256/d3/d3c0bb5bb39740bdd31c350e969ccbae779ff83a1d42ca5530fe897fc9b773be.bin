しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6ku2s"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":296654,"following":89},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4941,"tweets":12921},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6ku2s"}}}},"edit_control":{"edit_tweet_ids":["2097135329929257015"],"editable_until_msecs":"1788834600000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2097135329929257015","created_at":"Tue Sep 08 01:30:00 +0000 2026","display_text_range":[0,146],"entities":{"media":[{"display_url":"pic.x.com/wwQwDBqbDv","expanded_url":"https://x.com/gov_online/status/2097135329929257015/photo/1","ext_alt_text":"上部に「災害時の熱中症にご注意ください。」と記載されており、その下には、次のように記載されている。片付け等の作業時の注意点。作業開始前には必ず体調を確認する。できるだけ2人以上で作業を行い、お互いの体調を確認する。休憩·水分·塩分の補給は、一定時間毎にとる。休憩時は、日陰等の涼しい場所を確保する。暑い時間帯の作業は避ける。汗をかいた時は水分・塩分の補給をする。その横には、水分補給をする女性のイラストが描かれている。災害時には、慣れない環境や作業で熱中症のリスクが高くなります。熱中症には十分にご注意ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097134637026058240","indices":[147,170],"media_key":"3_2097134637026058240","media_results":{"result":{"media_key":"3_2097134637026058240"}},"media_url_https":"https://pbs.twimg.com/media/HRqE114bIAA4tLT.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":318},{"h":900,"w":900,"x":0,"y":120},{"h":1026,"w":900,"x":0,"y":57},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/wwQwDBqbDv"}],"user_mentions":[{"id_str":"286056244","indices":[135,146],"name":"環境省","screen_name":"Kankyo_Jpn"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/wwQwDBqbDv","expanded_url":"https://x.com/gov_online/status/2097135329929257015/photo/1","ext_alt_text":"上部に「災害時の熱中症にご注意ください。」と記載されており、その下には、次のように記載されている。片付け等の作業時の注意点。作業開始前には必ず体調を確認する。できるだけ2人以上で作業を行い、お互いの体調を確認する。休憩·水分·塩分の補給は、一定時間毎にとる。休憩時は、日陰等の涼しい場所を確保する。暑い時間帯の作業は避ける。汗をかいた時は水分・塩分の補給をする。その横には、水分補給をする女性のイラストが描かれている。災害時には、慣れない環境や作業で熱中症のリスクが高くなります。熱中症には十分にご注意ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2097134637026058240","indices":[147,170],"media_key":"3_2097134637026058240","media_results":{"result":{"media_key":"3_2097134637026058240"}},"media_url_https":"https://pbs.twimg.com/media/HRqE114bIAA4tLT.jpg","original_info":{"focus_rects":[{"h":504,"w":900,"x":0,"y":318},{"h":900,"w":900,"x":0,"y":120},{"h":1026,"w":900,"x":0,"y":57},{"h":1200,"w":600,"x":150,"y":0},{"h":1200,"w":900,"x":0,"y":0}],"height":1200,"width":900},"sizes":{"large":{"h":1200,"resize":"fit","w":900},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/wwQwDBqbDv"}]},"favorite_count":61,"favorited":false,"full_text":"【災害時の熱中症予防】\n片付けなどの作業を行う際は、こまめな水分・塩分補給を心がけ、熱中症には十分ご注意ください。\nまた、休憩は涼しい場所でとりましょう。\n\n暑い時間帯の作業はできるだけ避け、体調が優れないときは、無理をせず、作業を行わないようにすることが大切です。\n\n@Kankyo_Jpn https://t.co/wwQwDBqbDv","id_str":"2097135329929257015","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":1,"retweet_count":37,"retweeted":false,"user_id_str":"461064204"},"rest_id":"2097135329929257015","source":"<a href=\"https://twitter.com\" rel=\"nofollow\">TweetDeck Web App</a>","unmention_data":{},"views":{"count":"12719","state":"EnabledWithCount"}}},"user_id_str":"461064204"},"rest_id":"2098355346423332995","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"state":"Enabled"}}}}},"entryId":"tweet-2098355346423332995","sortIndex":"2098649853952262118"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-