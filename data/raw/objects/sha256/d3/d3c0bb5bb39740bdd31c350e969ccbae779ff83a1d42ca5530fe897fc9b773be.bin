:{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2995683,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":533,"tweets":1776},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2098397595395895645"],"editable_until_msecs":"1789135547000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":448,"bookmarked":false,"conversation_id_str":"2098397595395895645","created_at":"Fri Sep 11 13:05:47 +0000 2026","display_text_range":[0,95],"entities":{},"favorite_count":35168,"favorited":false,"full_text":"2001年９月11日に米国で発生した同時多発テロ事件から、本日で25年を迎えます。\n\nこの事件により、3000名近い方が犠牲となりました。\n\nその中には24名の邦人の方もいらっしゃいました。","id_str":"2098397595395895645","is_quote_status":false,"lang":"ja","quote_count":167,"reply_count":814,"retweet_count":3609,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTgzOTc1OTUyODI2Njk1Njk=","richtext":{"richtext_tags":[]},"text":"2001年９月11日に米国で発生した同時多発テロ事件から、本日で25年を迎えます。\n\nこの事件により、3000名近い方が犠牲となりました。\n\nその中には24名の邦人の方もいらっしゃいました。\n\n御家族や御友人など大切な方をなくされた方のお気持ちに思いを致し、この機会に、改めて心からの哀悼の誠を捧げます。\n\nまた、厳粛にこの日を迎える米国国民への変わらぬ連帯を表明いたします。\n\nこの事件は極めて卑劣かつ許し難い攻撃でした。\n\nテロは自由で開かれた国際秩序に対する挑戦であり、いかなる理由であっても正当化できません。\n\n我が国として、テロを未然に防止すべく、国際社会とも連携して取り組んでまいります。\n\nToday marks 25 years since the terrorist attacks that occurred in the United States on September 11, 2001.\nThese attacks claimed the lives of nearly 3,000 individuals, including 24 Japanese nationals. \nOn this solemn occasion, extending my thoughts and deepest sympathies to those who lost their precious family members and friends, I once again express my heartfelt condolences and renew my unwavering solidarity with the American people as they solemnly observe this day.\n\nThese attacks were utterly despicable and unforgivable acts. \nTerrorism constitutes a challenge to the free and open international order and can never be justified for any reason whatsoever.\nJapan is committed to continuing its efforts, in close cooperation with the international community, to prevent such acts of terrorism in the future."}}},"rest_id":"2098397595395895645","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"842820","state":"EnabledWithCount"}}}}},"entryId":"tweet-2098397595395895645","sortIndex":"2098649853952262129"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}]}}},"profile_description_language":"ja","profile_image_shape"