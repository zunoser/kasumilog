alse,"possibly_sensitive_editable":true,"quote_count":5,"quoted_status_id_str":"2074041031142813858","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2074041031142813858","url":"https://t.co/RLiwVsHV7n"},"reply_count":26,"retweet_count":78,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTU4MDU4MjYzMjE3NDc5Njg=","text":"理系の仕事と進路のヒントに出会う。\n\n✧ 女子中高生 ×理工系分野出身の女性技官・女性自衛官 ✧\n \n8月25日、「Girls Meet STEM」を防衛省で開催し、82名の女子中高生にご参加いただきました！\n \n市ヶ谷のオフィス見学後の懇談では、理工系分野出身の女性技官や女性自衛官が、参加者からの質問に応じて、自身の進路選択の決め手や学生時代の経験、仕事のやりがいについて語り、活発な意見交換がされました。\n \n理工系分野には様々な学び方や働き方があります。\n本イベントが、参加者の皆さんが自身の将来を考えるきっかけとなれば幸いです。"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2074041031142813858"}},"rest_id":"2095805826376343913","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"102630","state":"EnabledWithCount"}}},"rest_id":"2098333141673112041","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"37958","state":"EnabledWithCount"}}}}},"entryId":"tweet-2098333141673112041","sortIndex":"2098649853952262097"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985