2439296","media_results":{"result":{"media_key":"3_2098558560112439296"}},"media_url_https":"https://pbs.twimg.com/media/HR-T5EvbcAAjIHM.jpg","original_info":{"focus_rects":[{"h":1603,"w":2862,"x":0,"y":527},{"h":2862,"w":2862,"x":0,"y":0},{"h":3263,"w":2862,"x":0,"y":0},{"h":4096,"w":2048,"x":0,"y":0},{"h":4096,"w":2862,"x":0,"y":0}],"height":4096,"width":2862},"sizes":{"large":{"h":2048,"resize":"fit","w":1431},"medium":{"h":1200,"resize":"fit","w":838},"small":{"h":680,"resize":"fit","w":475},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Mnejo7t8ED"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/Mnejo7t8ED","expanded_url":"https://x.com/takaichi_sanae/status/2098558653532094773/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":88,"w":88,"x":70,"y":440},{"h":116,"w":116,"x":476,"y":52}]},"medium":{"faces":[{"h":51,"w":51,"x":40,"y":257},{"h":67,"w":67,"x":278,"y":30}]},"orig":{"faces":[{"h":176,"w":176,"x":140,"y":880},{"h":232,"w":232,"x":952,"y":104}]},"small":{"faces":[{"h":29,"w":29,"x":23,"y":146},{"h":38,"w":38,"x":158,"y":17}]}},"id_str":"2098558560104075264","indices":[80,103],"media_key":"3_2098558560104075264","media_results":{"result":{"media_key":"3_2098558560104075264"}},"media_url_https":"https://pbs.twimg.com/media/HR-T5Etb0AAOhaN.jpg","original_info":{"focus_rects":[{"h":1603,"w":2862,"x":0,"y":0},{"h":2862,"w":2862,"x":0,"y":0},{"h":3263,"w":2862,"x":0,"y":0},{"h":4096,"w":2048,"x":0,"y":0},{"h":4096,"w":2862,"x":0,"y":0}],"height":4096,"width":2862},"sizes":{"large":{"h":2048,"resize":"fit","w":1431},"medium":{"h":1200,"resize":"fit","w":838},"small":{"h":680,"resize":"fit","w":475},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Mnejo7t8ED"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/Mnejo7t8ED","expanded_url":"https://x.com/takaichi_sanae/status/2098558653532094773/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2098558560112439296","indices":[80,103],"media_key":"3_2098558560112439296","media_results":{"result":{"media_key":"3_2098558560112439296"}},"media_url_https":"https://pbs.twimg.com/media/HR-T5EvbcAAjIHM.jpg","original_info":{"focus_rects":[{"h":1603,"w":2862,"x":0,"y":527},{"h":2862,"w":2862,"x":0,"y":0},{"h":3263,"w":2862,"x":0,"y":0},{"h":4096,"w":2048,"x":0,"y":0},{"h":4096,"w":2862,"x":0,"y":0}],"height":4096,"width":2862},"sizes":{"large":{"h":2048,"resize":"fit","w":1431},"medium":{"h":1200,"resize":"fit","w":838},"small":{"h":680,"resize":"fit","w":475},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Mnejo7t8ED"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/Mnejo7t8ED","expanded_url":"https://x.com/takaichi_sanae/status/2098558653532094773/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":88,"w":88,"x":70,"y":440},{"h":116,"w":116,"x":476,"y":52}]},"medium":{"faces":[{"h":51,"w":51,"x":40,"y":257},{"h":67,"w":67,"x":278,"y":30}]},"orig":{"faces":[{"h":176,"w":176,"x":140,"y":880},{"h":232,"w":232,"x":952,"y":104}]},"small":{"faces":[{"h":29,"w":29,"x":23,"y":146},{"h":38,"w":38,"x":158,"y":17}]}},"id_str":"2098558560104075264","indices":[80,103],"media_key":"3_2098558560104075264","media_results":{"result":{"media_key":"3_2098558560104075264"}},"media_url_https":"https://pbs.twimg.com/media/HR-T5Etb0AAOhaN.jpg","original_info":{"focus_rects":[{"h":1603,"w":2862,"x":0,"y":0},{"h":2862,"w":2862,"x":0,"y":0},{"h":3263,"w":2862,"x":0,"y":0},{"h":4096,"w":2048,"x":0,"y":0},{"h":4096,"w":2862,"x":0,"y":0}],"height":4096,"width":2862},"sizes":{"large":{"h":2048,"resize":"fit","w":1431},"medium":{"h":1200,"resize":"fit","w":838},"small":{"h":680,"resize":"fit","w":475},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Mnejo7t8ED"}]},"favorite_count":5809,"favorited":false,"full_text":"大規模な災害の発生後には、被災された方々の不安な気持ちや、「早く元の生活に戻したい」という思いにつけ込んだ、悪質な勧誘や契約トラブルが発生する傾向にあります。 https://t.co/Mnejo7t8ED","id_str":"2098558653532094773","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":122,"reply_count":416,"retweet_count":901,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTg1NTg2NTM0NjUwNzU3MTI=","richtext":{"richtext_tags":[]},"text":"大規模な災害の発生後には、被災された方々の不安な気持ちや、「早く元の生活に戻したい」という思いにつけ込んだ、悪質な勧誘や契約トラブルが発生する傾向にあります。\n\n例えば、「令和8年熊本地震」では、「地震により水の出が悪くなったため、被災者がネットで調べた事業者に作業を依頼したところ、改善しなかったにもかかわらず、高額な請求を受けた」という事案や、「地震後に訪ねてきた事業者から家の土台のひび割れを指摘され、補修工事を契約したところ、簡易な処置のみを行ったにもかかわらず、高額な請求を受けた」という事案がありました。\n\nまた、「令和8年8月千葉豪雨」では、「自動車が水没したため、被災者がそのレッカー移動を事業者に依頼したところ、その事業者のウェブサイトには『数千円から』の旨が記載されていたにもかかわらず、高額な料金を請求された」という事案がありました。\n\nこうした、災害に便乗した悪質商法等に十分ご注意ください。\n\n「すぐに工事が必要」、「保険を利用すれば実質的に無料で修理できる」などと勧誘をされても、その場ですぐに契約せず、複数の事業者から見積りや説明を受けるなど、契約の内容を十分に確認してください。\n\nまた、少しでも不審に感じたり、トラブルに遭ったりした場合には、被害拡大防止のためにも、早めの相談が重要です。\n\n一人で悩まず、「消費者ホットライン」、局番なしの「188」（いやや！）に電話でご相談ください。\n身近な消費生活センターや消費生活相談窓口をご案内します。"}}},"rest_id":"2098558653532094773","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"191987","state":"EnabledWithCount"}}}}},"entryId":"tweet-2098558653532094773","sortIndex":"2098649853952262133"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2098649853952262156-tweet-2098549094730109229","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2097855073892147218"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":587085,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20156,"tweets":48823},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2098549094730109229"],"editable_until_msecs":"1789171667000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":13,"bookmarked":false,"conversation_id_str":"2098549094730109229","created_at":"Fri Sep 11 23:07:47 +0000 2026","display_text_range":[0,70],"entities":{"media":[{"display_url":"pic.x.com/i32y4e6sTo","expanded_url":"https://x.com/MofaJapan_jp/status/2098549094730109229/photo/1","ext_alt_text":"外務報道官談話：イエメン及びサウジアラビアにおけるホーシー派の攻撃について\n令和8年9月12日\n１　7月20日のイエメンのホーシー派によるサウジアラビアに対する海上封鎖宣言以降、同派の軍事的攻撃が継続し、民間人を含め多くの死傷者が発生しています。日本は、こうしたホーシー派による一連の攻撃を改めて強く非難します。民間人や民間施設に対する攻撃、そして船舶の自由で安全な航行を阻害するいかなる行為も許容できません。ホーシー派に対し、イエメン内外における事態のエスカレーションを控えるよう重ねて強く求めます。\n\n２　イエメンの安定は中東地域全体の安定に直結しており、日本として、イエメン和平の実現の重要性を改めて強調します。また、バブ・エル・マンデブ海峡の自由で安全な航行の確保を含む中東の平和と安定は、エネルギー安全保障の観点からも、日本を始めとする国際社会全体にとって極めて重要です。日本は、引き続きイエメン及びサウジアラビアをはじめとする国際社会と連携しながら、事態の早期沈静化に向け、あらゆる外交努力を重ねていく考えです。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2098549015189372928","indices":[71,94],"media_key":"3_2098549015189372928","media_results":{"result":{"media_key":"3_2098549015189372928"}},"media_url_https":"https://pbs.twimg.com/media/HR-LNfIbwAA_DHD.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":0},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":389,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/i32y4e6sTo"}],"urls":[{"display_url":"mofa.go.jp/mofaj/press/da…","expanded_url":"https://www.mofa.go.jp/mofaj/press/danwa/pageit_000001_03193.html","indices":[47,70],"url":"https://t.co/W0CZUXWL1A"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/i32y4e6sTo","expanded_url":"https://x.com/MofaJapan_jp/status/2098549094730109229/photo/1","ext_alt_text":"外務報道官談話：イエメン及びサウジアラビアにおけるホーシー派の攻撃について\n令和8年9月12日\n１　7月20日のイエメンのホーシー派によるサウジアラビアに対する海上封鎖宣言以降、同派の軍事的攻撃が継続し、民間人を含め多くの死傷者が発生しています。日本は、こうしたホーシー派による一連の攻撃を改めて強く非難します。民間人や民間施設に対する攻撃、そして船舶の自由で安全な航行を阻害するいかなる行為も許容できません。ホーシー派に対し、イエメン内外における事態のエスカレーションを控えるよう重ねて強く求めます。\n\n２　イエメンの安定は中東地域全体の安定に直結しており、日本として、イエメン和平の実現の重要性を改めて強調します。また、バブ・エル・マンデブ海峡の自由で安全な航行の確保を含む中東の平和と安定は、エネルギー安全保障の観点からも、日本を始めとする国際社会全体にとって極めて重要です。日本は、引き続きイエメン及びサウジアラビアをはじめとする国際社会と連携しながら、事態の早期沈静化に向け、あらゆる外交努力を重ねていく考えです。\n","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2098549015189372928","indices":[71,94],"media_key":"3_2098549015189372928","media_results":{"result":{"media_key":"3_2098549015189372928"}},"media_url_https":"https://pbs.twimg.com/media/HR-LNfIbwAA_DHD.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":0},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":389,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/i32y4e6sTo"}]},"favorite_count":201,"favorited":false,"full_text":"イエメン及びサウジアラビアにおけるホーシー派の攻撃について、外務報道官談話を発出しました。\n\nhttps://t.co/W0CZUXWL1A https://t.co/i32y4e6sTo","id_str":"2098549094730109229","is_quote_status"