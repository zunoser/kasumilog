{"h":2897,"w":2541,"x":1555,"y":0},{"h":2897,"w":1449,"x":2647,"y":0},{"h":2897,"w":4096,"x":0,"y":0}],"height":2897,"width":4096},"sizes":{"large":{"h":1449,"resize":"fit","w":2048},"medium":{"h":849,"resize":"fit","w":1200},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/4ylrDg0aet"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/4ylrDg0aet","expanded_url":"https://x.com/takaichi_sanae/status/2098563607642693904/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2098563538818371584","indices":[110,133],"media_key":"3_2098563538818371584","media_results":{"result":{"media_key":"3_2098563538818371584"}},"media_url_https":"https://pbs.twimg.com/media/HR-Ya33bEAAynrH.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2897,"w":2897,"x":1199,"y":0},{"h":2897,"w":2541,"x":1555,"y":0},{"h":2897,"w":1449,"x":2647,"y":0},{"h":2897,"w":4096,"x":0,"y":0}],"height":2897,"width":4096},"sizes":{"large":{"h":1449,"resize":"fit","w":2048},"medium":{"h":849,"resize":"fit","w":1200},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/4ylrDg0aet"}]},"favorite_count":5997,"favorited":false,"full_text":"大規模な災害が発生した場合には、建物などの損壊に伴い、大量の「災害廃棄物」が発生します。\n\n災害廃棄物は、迅速に復旧や復興を進めるため、速やかに被災現場から仮置場へと撤去し、計画的に処理をしていくことが重要となります。 https://t.co/4ylrDg0aet","id_str":"2098563607642693904","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":46,"reply_count":367,"retweet_count":776,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTg1NjM2MDc1NjI5NjkwODg=","richtext":{"richtext_tags":[]},"text":"大規模な災害が発生した場合には、建物などの損壊に伴い、大量の「災害廃棄物」が発生します。\n\n災害廃棄物は、迅速に復旧や復興を進めるため、速やかに被災現場から仮置場へと撤去し、計画的に処理をしていくことが重要となります。\n\n災害廃棄物は、「一般廃棄物」として市町村に処理責任がありますが、被災された市町村のご負担を軽減するため、国として、積極的に財政面・技術面からの支援を行っています。\n\n高市内閣では、「令和8年熊本地震」の災害の規模を踏まえて、補助金と特別交付税による支援を組み合わせることで、災害廃棄物処理の事業費の97.5%を国が支援することを決定しました。\n\nまた、被災した家屋については、全壊家屋はもちろんのこと、半壊家屋についても、市町村による解体事業（公費解体）に対して支援を行うことにしました。\nこのため、全壊・半壊家屋の所有者の皆様は、家屋の解体費用をご負担いただく必要はございません。\n\n現地においては、ボランティアの皆様のご活躍もあって、被災された家屋の片付けが進んでいます。\n被災直後から国の職員や専門家が現地入りし、仮置場の効率的な運営や渋滞対策などの技術的な支援を行っています。\n\nまた、高市内閣は、災害廃棄物対策の強化を目的とし、先の国会に『廃棄物処理法等の一部を改正する法律案』を提出し、ご審議を経て法律が成立しました。\n\nこの法律により、特殊会社の「JESCO」が災害廃棄物処理の専門業務を担うこととなり、全国各地での災害時に現地に出向き、被害状況調査、廃棄物処理の発注・契約・施工管理、広域処理の調整など、被災市町村に対するきめ細かな支援を行ってまいります。"}}},"rest_id":"2098563607642693904","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"174180","state":"EnabledWithCount"}}}}},"entryId":"tweet-2098563607642693904","sortIndex":"2098649853952262134"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"lo