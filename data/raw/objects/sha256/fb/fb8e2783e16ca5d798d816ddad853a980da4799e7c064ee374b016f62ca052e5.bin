":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2997049,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":539,"tweets":1796},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2101882448766554186"],"editable_until_msecs":"1789966401000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":96,"bookmarked":false,"conversation_id_str":"2101882448766554186","created_at":"Mon Sep 21 03:53:21 +0000 2026","display_text_range":[0,117],"entities":{},"favorite_count":12463,"favorited":false,"full_text":"東京都大島町に「レベル5土砂災害特別警報」が発表されました。\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。","id_str":"2101882448766554186","is_quote_status":false,"lang":"ja","quote_count":161,"reply_count":905,"retweet_count":1603,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE4ODI0NDg3MTIwMjgxNjA=","richtext":{"richtext_tags":[]},"text":"東京都大島町に「レベル5土砂災害特別警報」が発表されました。\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。\n\n命の危険が迫っているため、地方自治体の指示に従い、直ちに身の安全を確保して下さい\n\n避難所までの移動がかえって危険な場合は、無理をせず、崖や沢から離れた場所など、今いる場所より少しでも安全な場所に移動するなど、命を守る行動を最優先して下さい。\n\n政府としては、「レベル5土砂災害特別警報」の発表を受け、「官邸危機管理センター」の体制を「官邸連絡室」に強化し、地方自治体とも連携し、国民の皆様に対する適時的確な情報提供、被害が発生した場合の被害状況の把握、人命第一の方針の災害応急対策など、危機管理に万全の対応をしてまいります。\n\n「台風第25号」の影響により、他の市町村にも、今後レベル５特別警報が発表される可能性があります。\nまた、レベル５特別警報が発表されていない地域でも、大雨になるおそれがあります。\n土砂災害、低い土地の浸水、河川の増水や氾濫などに厳重に警戒して下さい。"}}},"rest_id":"2101882448766554186","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"844961","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101882448766554186","sortIndex":"2102557030794395593"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2100358551340552192/UJmeJMB4?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2100358551340552192/UJmeJMB4?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"