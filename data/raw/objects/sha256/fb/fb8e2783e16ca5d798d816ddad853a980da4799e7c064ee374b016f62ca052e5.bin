40,"x":0,"y":0},{"h":540,"w":474,"x":27,"y":0},{"h":540,"w":270,"x":129,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/dTOpBblrSi"}]},"favorite_count":1519,"favorited":false,"full_text":"9月20日、インドネシアにおける国際緊急援助活動のため派遣されている輸送艦「くにさき」が、キジン港からカリマンタン島クタパン沖に向けて出港しました。\n\nこれは、山林火災の状況や気象条件などを踏まえ、インドネシア側との調整の下、今後の活動により適した位置へ移動するものです。 https://t.co/dTOpBblrSi","id_str":"2101532257395806708","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":17,"quoted_status_id_str":"2101273260767994248","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2101273260767994248","url":"https://t.co/gW4K5xQ2Gf"},"reply_count":10,"retweet_count":236,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE1MzIyNTczNDU1NjA1NzY=","text":"9月20日、インドネシアにおける国際緊急援助活動のため派遣されている輸送艦「くにさき」が、キジン港からカリマンタン島クタパン沖に向けて出港しました。\n\nこれは、山林火災の状況や気象条件などを踏まえ、インドネシア側との調整の下、今後の活動により適した位置へ移動するものです。\n\n防衛省・自衛隊は、引き続き現地の状況を踏まえながら、関係機関と連携して対応してまいります。"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2101273260767994248"}},"rest_id":"2101532257395806708","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"224375","state":"EnabledWithCount"}}},"rest_id":"2101924308927066150","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"132165","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101924308927066150","sortIndex":"2102557030794395606"},{"content":{"