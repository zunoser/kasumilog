um":{"h":1200,"resize":"fit","w":831},"small":{"h":680,"resize":"fit","w":471},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/4QND7GnnCi"}]},"favorite_count":11777,"favorited":false,"full_text":"人々が日々の暮らしを送り、経済活動を行う空間「都市」は、我が国の活力の源泉でもあります。\n\n今回は、先の国会で成立した『改正都市再生特別措置法』について紹介します。 https://t.co/4QND7GnnCi","id_str":"2101552105496735868","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":208,"reply_count":941,"retweet_count":1523,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE1NTIxMDU0Mjk1Nzc3Mjg=","richtext":{"richtext_tags":[]},"text":"人々が日々の暮らしを送り、経済活動を行う空間「都市」は、我が国の活力の源泉でもあります。\n\n今回は、先の国会で成立した『改正都市再生特別措置法』について紹介します。\n\n近年は、若者の｢地方都市離れ｣が進み、人口減少も相まって、地方都市で日常生活を送るために必要な機能を維持することが重要な課題となっています。\n\nこうした中、各「都市」が本来持つ｢個性｣を活かし、多くの人がそこで「暮らしたい」、「訪れたい」と思える｢魅力のある空間｣を創りあげていくことが重要です。\n\nこのため、「地域の稼ぐ力」や「賑わい」の創出に必要な施設について、都市の拠点となる「まちなか」への立地を促進する制度を創設しました。\n\n例えば、若者の働く場である｢オフィス｣や｢地場産業関連工場｣、起業を支援する｢インキュベーション施設｣、人々を呼び込む核となるホテルなどの｢集客施設｣が、その代表例となります。\n\nまた、都市間の国際競争が激化する中、「日本列島を強く、豊かに」するためには、国内外から投資や人材を呼び込むことのできる魅力的な「都市空間」を作っていくことも課題です。\n\n投資や人材を呼び込むためには、単に高層の綺麗な建物（ハード）だけではなく、官民協働で都市（まち）を育てていく取組（ソフト）も重要であり、民間事業者や地域まちづくり団体など、民間の持つ活力を最大限活かしつつ、行政がそれを後押しすることで、まち全体の魅力を高めていく仕組みを創設しました。\n\n地域の歴史・文化や景観・環境に根ざしたまちづくりや、都市の安全確保を進める制度も充実させました。\n\n政府一丸となって、日本各地の都市が持つ大きな「伸び代」を活かした「令和の都市（まち）リノベーション」の取組を進めてまいります。"}}},"rest_id":"2101552105496735868","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"524801","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101552105496735868","sortIndex":"2102557030794395572"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092927185678127486"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"農林水産省の公式アカウントです。ご意見・ご質問は、総合窓口にお寄せください。\n総合窓口→https://t.co/XLQwxIPiHh\n運用方針→https://t.co/2SnzXCNurZ","entities":{"description":{"urls":[{"display_url":"contactus.maff.go.jp/voice/sogo.html","expanded_url":"https://www.contactus.maff.go.jp/voice/sogo.html","indices":[44,67],"url":"https://t.co/XLQwxIPiHh"},{"display_url":"maff.go.jp/j/pr/social_me…","expanded_url":"https://www.maff.go.jp/j/pr/social_media/policy.html","indices":[73,96],"url":"https://t.co/2SnzXCNurZ"}]},"url":{"urls":[{"display_url":"maff.go.jp","expanded_url":"https://www.maff.go.jp/","indices":[0,23],"url":"https://t.co/cPtrdtbo0N"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":269330,"following":57},"relationship_perspectives":{"blocked_by":false,"block