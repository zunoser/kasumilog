x":0,"y":0}],"height":705,"width":940},"sizes":{"large":{"h":705,"resize":"fit","w":940},"medium":{"h":705,"resize":"fit","w":940},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YUTBnfUknU"}]},"favorite_count":835,"favorited":false,"full_text":"【台風25号による影響について】\n台風25号の影響により、現在、千葉エリアを中心に約4万6千軒の停電が発生しております。 (9/22 12:00時点)\n多大なるご不便とご迷惑をおかけしておりますことを深くお詫び申し上げます。 https://t.co/YUTBnfUknU","id_str":"2102234485802885414","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":32,"reply_count":25,"retweet_count":526,"retweeted":false,"user_id_str":"1244515141376303104"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"teideninfo.tepco.co.jp","expanded_url":"https://teideninfo.tepco.co.jp","indices":[218,241],"url":"https://t.co/q9DAMC1zLW"},{"display_url":"tepco.co.jp/pg/user/contac…","expanded_url":"https://www.tepco.co.jp/pg/user/contact.html","indices":[364,387],"url":"https://t.co/A1FSwV5Oeu"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIyMzQ0ODU3MDIyMzgyMDg=","richtext":{"richtext_tags":[]},"text":"【台風25号による影響について】\n台風25号の影響により、現在、千葉エリアを中心に約4万6千軒の停電が発生しております。 (9/22 12:00時点)\n多大なるご不便とご迷惑をおかけしておりますことを深くお詫び申し上げます。\n停電件数の多い千葉県に復旧作業班を重点的に配置し、停電が継続しているお客さまに一刻も早く電気をお届けできるよう、引き続き全力で復旧作業を進めてまいります。\n\n最新の停電情報については、こちらでご確認ください。\nhttps://t.co/q9DAMC1zLW\n\n台風の影響により電線が切れたり、電線に樹木や看板、アンテナなどが接触したりすることがあります。\n大変危険ですので絶対に近づかないでください。また、切れた電線を発見した場合は、すぐに東京電力までご連絡ください。\nご連絡・お問い合わせはこちら。\nhttps://t.co/A1FSwV5Oeu"}}},"previous_counts":{"bookmark_count":0,"favorite_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"rest_id":"2102234485802885414","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"243368","state":"EnabledWithCount"}}},"user_id_str":"266566401"},"rest_id":"2102286640358240268","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"915","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102286640358240268","sortIndex":"2102557030794395631"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}]}}},"profile_description_language":"j