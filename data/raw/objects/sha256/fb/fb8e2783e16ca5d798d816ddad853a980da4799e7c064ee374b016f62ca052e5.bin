:{"__typename":"User","core":{"screen_name":"MLIT_JAPAN"}}},"policy":"Community"},"conversation_id_str":"2101902184103477314","created_at":"Mon Sep 21 05:11:46 +0000 2026","display_text_range":[0,131],"entities":{},"favorite_count":86,"favorited":false,"full_text":"令和8年台風第25号による大雨について、大臣指示を行いました。\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、被害が発生した場合は、人命第一の方針の下、災害応急対策に全力で取り組むこと。","id_str":"2101902184103477314","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":2,"retweet_count":37,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE5MDIxODQwNjU2ODc1NTI=","richtext":{"richtext_tags":[]},"text":"令和8年台風第25号による大雨について、大臣指示を行いました。\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、被害が発生した場合は、人命第一の方針の下、災害応急対策に全力で取り組むこと。\n２．地方自治体とのホットライン等を通じて情報を収集し、要請に応じて迅速に地方自治体への支援等を実施すること。"}}},"rest_id":"2101902184103477314","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"12608","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2101902184103477314","sortIndex":"2102557030794395596"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/pvgRM8Jyxf"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1372728