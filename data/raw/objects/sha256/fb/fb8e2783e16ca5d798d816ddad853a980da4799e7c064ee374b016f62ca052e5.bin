{"h":391,"w":196,"x":0,"y":0},{"h":391,"w":440,"x":0,"y":0}],"height":391,"width":440},"sizes":{"large":{"h":391,"resize":"fit","w":440},"medium":{"h":391,"resize":"fit","w":440},"small":{"h":391,"resize":"fit","w":440},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Kf7LppQ1v0"}]},"favorite_count":2243,"favorited":false,"full_text":"１．北朝鮮は本日１７時５４分頃、北朝鮮東岸付近から、少なくとも１発の弾道ミサイルを、北東方向に向けて発射しました。詳細については現在日米韓で緊密に連携して分析中ですが、発射された弾道ミサイルは最高高度約７０ｋｍ程度で、約５９０ｋｍ程度飛翔し、落下したのは日本海の我が国の排他的経済 https://t.co/Kf7LppQ1v0","id_str":"2101625099635831279","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":34,"quoted_status_id_str":"2101604407641325868","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2101604407641325868","url":"https://t.co/BguNTiL056"},"reply_count":38,"retweet_count":612,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE2MjUwOTk1NjAzOTQ3NTI=","text":"１．北朝鮮は本日１７時５４分頃、北朝鮮東岸付近から、少なくとも１発の弾道ミサイルを、北東方向に向けて発射しました。詳細については現在日米韓で緊密に連携して分析中ですが、発射された弾道ミサイルは最高高度約７０ｋｍ程度で、約５９０ｋｍ程度飛翔し、落下したのは日本海の我が国の排他的経済水域（ＥＥＺ）外であると推定しています。\n２． 政府より、 付近を航行する航空機や船舶への情報提供を行ったところ、現時点において被害報告等の情報は確認されていません。\n３．総理には、本件について直ちに報告を行い、\n　① 情報収集・分析に全力を挙げ、国民に対して、迅速・的確な情報提供を行うこと\n　② 航空機、船舶等の安全確認を徹底すること\n　③ 不測の事態に備え、万全の態勢をとること\n　の３点について指示がありました。\n４．政府においては、官邸危機管理センターに設置している「北朝鮮情勢に関する官邸対策室」において、 関係省庁からの情報を集約するとともに、 緊急参集チームを招集し、 対応について協議を行いました。\n５．また、防衛省においては、防衛大臣が総理指示を受け、\n　① 米国、韓国等と緊密に連携しつつ、情報収集・分析に全力を挙げること\n　② 不測の事態の発生に備え、 引き続き警戒監視に万全を期すこ　　\n　との２点について指示を出しました。\n６． これまでの弾道ミサイル等の度重なる発射も含め、一連の北朝鮮の行動は、 我が国、 地域及び国際社会の平和と安全を脅かすものです。また、このような弾道ミサイル発射は、関連する安保理決議に違反し、国民の安全に関わる重大な問題です。我が国としては、北朝鮮に対して厳重に抗議し、強く非難しました。\n７．国民の生命・財産を守り抜くため、引き続き、米国や韓国等とも緊密に連携し、 情報の収集・分析及び警戒監視に全力をあげるとともに、 今後追加して公表すべき情報を入手した場合には、 速やかに発表することとします。"}}},"previous_counts":{"bookmark_count":1,"favorite_count":20,"quote_count":0,"reply_count":0,"retweet_count":9},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1264443,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":fal