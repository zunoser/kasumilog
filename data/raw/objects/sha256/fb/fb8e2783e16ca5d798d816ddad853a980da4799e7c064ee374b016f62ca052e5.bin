協議には、有吉孝史外務省アジア大洋州局審事官、白鏞塡（ペク・ヨンジン）韓国外交部朝鮮半島政策局長、デービッド・ウィラゾル米国国務次官補代理が参加しました。","id_str":"2101877761434599632","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":14,"retweet_count":30,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04201.html","indices":[140,163],"url":"https://t.co/EQLQLX4DAl"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE4Nzc3NjEzMjU1OTI1NzY=","richtext":{"richtext_tags":[]},"text":"9月21日、同月20日の北朝鮮による弾道ミサイル発射を受け、北朝鮮に関する日米韓外交当局間電話協議が実施されました。同電話協議には、有吉孝史外務省アジア大洋州局審事官、白鏞塡（ペク・ヨンジン）韓国外交部朝鮮半島政策局長、デービッド・ウィラゾル米国国務次官補代理が参加しました。\n\nhttps://t.co/EQLQLX4DAl"}}},"rest_id":"2101877761434599632","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"18554","state":"EnabledWithCount"}}}}},"entryId":"tweet-2101877761434599632","sortIndex":"2102557030794395592"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2102557030794395705-tweet-2101869024166699240","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"