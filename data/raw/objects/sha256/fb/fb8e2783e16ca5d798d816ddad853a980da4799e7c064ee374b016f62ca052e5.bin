[{"display_url":"mofa.go.jp/mofaj/pageit_0…","expanded_url":"https://www.mofa.go.jp/mofaj/pageit_000001_03209.html","indices":[220,243],"url":"https://t.co/fNoLtyV0IE"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIxODM1ODUzNDQyNzg1Mjg=","richtext":{"richtext_tags":[]},"text":"米国・ニューヨークを訪問中の茂木外務大臣は、シシル・カナル・ネパール外務大臣と会談を行いました。茂木大臣は、ネパールが未曾有の災害により甚大な被害を受けたことについて、犠牲者に哀悼の誠を捧げ、お見舞いを伝えつつ、日本はネパールと共にあり、長年の友人であるネパールのために、できることは全て行う考えである旨述べました。また、茂木大臣は、2026年は日・ネパール外交関係樹立70周年であり、両国の友好関係の更なる深化に期待する旨述べました。\n\nhttps://t.co/fNoLtyV0IE"}}},"rest_id":"2102183585461748024","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"41051","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102183585461748024","sortIndex":"2102557030794395618"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2102212943379091880"]},"possibly_sensitive":f