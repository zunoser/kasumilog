[194,217],"url":"https://t.co/SkVKw3ICxZ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDgwNzg5MDMxMTQwNTk3Nzc=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、第66回海外日系人大会開会式において祝辞を寄せ、中西官房副長官が代読しました。\n高市総理大臣は、祝辞の中で、海外日系人大会が、日系コミュニティの絆を更に深め、未来に向けた新たな発展への礎となることを願うとともに、日本と日系人とのつながりのみならず、日本と世界とのつながりが更に強固なものとなることを期待している旨を伝えました。\n（写真提供：公益財団法人海外日系人協会）\n\nhttps://t.co/SkVKw3ICxZ"}}},"previous_counts":{"bookmark_count":0,"favorite_count":5,"quote_count":0,"reply_count":1,"retweet_count":1},"rest_id":"2108078903172690391","unmention_data":{},"views":{"count":"11936","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108078903172690391","sortIndex":"2108317702228541402"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saiga