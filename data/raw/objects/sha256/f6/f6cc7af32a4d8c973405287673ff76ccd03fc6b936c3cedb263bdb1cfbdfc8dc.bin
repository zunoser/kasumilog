s":{"allow_download":true},"display_url":"pic.x.com/o7fS9c0CYK","expanded_url":"https://x.com/takaichi_sanae/status/2107817905274679656/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":319,"w":319,"x":895,"y":433}]},"medium":{"faces":[{"h":187,"w":187,"x":524,"y":253}]},"orig":{"faces":[{"h":406,"w":406,"x":1137,"y":550}]},"small":{"faces":[{"h":106,"w":106,"x":297,"y":143}]}},"id_str":"2107817810844155904","indices":[86,109],"media_key":"3_2107817810844155904","media_results":{"result":{"media_key":"3_2107817810844155904"}},"media_url_https":"https://pbs.twimg.com/media/HUB5IZqbgAAft4m.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/o7fS9c0CYK"}]},"favorite_count":34172,"favorited":false,"full_text":"本日、東京理科大学名誉教授の硤合憲三先生が「ノーベル化学賞」を受賞されることが決まりました。\n硤合先生、そして、一緒に研究をしてこられた皆様に、心よりお祝い申し上げます。 https://t.co/o7fS9c0CYK","id_str":"2107817905274679656","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":528,"reply_count":1878,"retweet_count":3197,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDc4MTc5MDUyMjQzNjQwMzI=","richtext":{"richtext_tags":[]},"text":"本日、東京理科大学名誉教授の硤合憲三先生が「ノーベル化学賞」を受賞されることが決まりました。\n硤合先生、そして、一緒に研究をしてこられた皆様に、心よりお祝い申し上げます。\n\n硤合先生は、ごくわずかな分子の違いが、自ら仲間を増やしながら大きな違いへと育っていく現象である、「Soai反応」（そあい はんのう）として知られている、「不斉自己触媒反応」（ふせい じこ しょくばい はんのう）を、発見されました。\n\nホモキラリティーの成立起源に関する研究であり、この成果は、「生命の起源」という人類共通の謎の解明にもつながる画期的なものと伺っており、日本人として、とても誇りに思います。\n\n硤合先生の今後の御活躍とともに、我が国の学術研究の一層の発展のため、引き続き、御尽力下さることを期待申し上げております。"}}},"rest_id":"2107817905274679656","unmention_data":{},"views":{"count":"930907","state":"EnabledWithCount"}}}}},"entryId":"tweet-2107817905274679656","sortIndex":"2108317702228541352"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHUI_x6MAJxEKAAIdQdxhSpcxKwgAAwAAAAEAAA"},"entryId":"cursor-top-2108317702228541441","sortIndex":"2108317702228541441"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHUI_x6L__6UKAAIdQHk3lxrxaAgAAwAAAAIAAA"},"entryId":"cursor-bottom-2108317702228541351","sortIndex":"2108317702228541351"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}