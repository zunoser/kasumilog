mi"}]},"id":"Tm90ZVR3ZWV0OjIxMDgwOTI1MzUzMzE4MzU5MDQ=","richtext":{"richtext_tags":[]},"text":"╋━━━━━━━\n\n　YouTube　『#放課後ゲンバミッション！』\n\n　　　　　　　　　　　　　　━━━━━━╋\n\n中高生リポーターが建設業界の現場に\nお邪魔して、職人さんにお話を伺い、\n様々な「#ゲンミ！（現場ミッション）」に挑戦✨\n\n今回は『#土木工事』と『#働き方改革』について施工管理の方に教えてもらい、中高生の目線でお届けします！\n\n働きやすい環境作りには最先端技術の存在が！\n\n果たしてミッション完了なるか！？\n\n📺https://t.co/yfSXPuUXy7\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPIOH\n\n#ゲンミ！\n#国交省建設産業PR\n#MLIT建設産業PR\n@houkago_gennmi"}}},"previous_counts":{"bookmark_count":0,"favorite_count":6,"quote_count":0,"reply_count":0,"retweet_count":1},"rest_id":"2108092535419838672","unmention_data":{},"views":{"count":"11346","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108092535419838672","sortIndex":"2108317702228541409"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092927185678127486"]},"possibly_sensi