0},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/pOezY3URmh"}]},"favorite_count":36,"favorited":false,"full_text":"石井政務官は、ICEF第13回年次総会開会式に出席。エネルギー安定供給、経済成長及び脱炭素の同時実現を目指す我が国のGXの取組を紹介するとともに、中東情勢などを背景にエネルギー安全保障の重要性が高まる中、化石燃料の調達安定性の向上とGXの加速・強化を一体的に進める必要性について述べました。 https://t.co/pOezY3URmh","id_str":"2108141234992930959","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":0,"retweet_count":8,"retweeted":false,"user_id_str":"266566401"},"rest_id":"2108141234992930959","unmention_data":{},"views":{"count":"6868","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108141234992930959","sortIndex":"2108317702228541437"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2108067148170186752/GJvO7PLK?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":182,"url":"https://pbs.twimg.com/card_img/2108067148170186752/GJvO7PLK?format=jpg&name=400x400","width":400},"type":"IMAGE"}},{"key":"description","value":{"string_value":"スマートフォンのモバイルバッテリーだけじゃない！ 今、電力システムを支える存在として注目されている「蓄電池」。なぜ導入が広がっているのか？ どんな種類があり、どのような役割を果たしているのか？ 再エネの活用や電力の安定供給との関係をわかりやすく解説します。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.enecho.meti.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2108067148170186752/GJvO7PLK?format=jpg&name=800x320_1","width