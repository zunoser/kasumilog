の背景に、登山やハイキングをする人のイラストと、「豚熱をひろげない アウトドア入門」の文字が描かれたポスター。吹き出しの中で、①家畜のいる施設には近づかない、②ごみは持ち帰る、③靴底や登山靴についた泥を落とす、の3つの行動をイラストで紹介している。野外活動の際に豚熱を広げないための対策への協力を呼びかける内容。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108014561232297984","indices":[151,174],"media_key":"3_2108014561232297984","media_results":{"result":{"media_key":"3_2108014561232297984"}},"media_url_https":"https://pbs.twimg.com/media/HUEsEx-aIAA27Fs.jpg","original_info":{"focus_rects":[{"h":388,"w":693,"x":0,"y":0},{"h":693,"w":693,"x":0,"y":0},{"h":790,"w":693,"x":0,"y":0},{"h":960,"w":480,"x":0,"y":0},{"h":960,"w":693,"x":0,"y":0}],"height":960,"width":693},"sizes":{"large":{"h":960,"resize":"fit","w":693},"medium":{"h":960,"resize":"fit","w":693},"small":{"h":680,"resize":"fit","w":491},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/paIhCe5x3X"}]},"favorite_count":94,"favorited":false,"full_text":"🚵‍♀️秋の行楽シーズン到来！🏕️\n\n＃豚熱 は人に感染しませんが、人や物を介してイノシシや豚に広がる可能性があります。\n\n山林などに行く際は\n🐗イノシシの死体を見つけたら自治体に連絡\n🥾靴の泥は山で落とす\n🚫家畜施設に近づかない\n🗑️ゴミは持ち帰る\n\n大切な豚たちを守るため、ご協力をお願いします。 https://t.co/paIhCe5x3X","id_str":"2108014565946769747","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":8,"retweet_count":40,"retweeted":false,"user_id_str":"2335919749"},"rest_id":"2108014565946769747","unmention_data":{},"views":{"count":"16482","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2108317702228541509-tweet-2108014578504475052","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_coun