x360/PHRmu3qfwclihCPF.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2120463330825691136/vid/avc1/1280x720/f0qZx2NCD-VDMWkE.mp4?tag=29"}]}}]},"favorite_count":765,"favorited":false,"full_text":"【お知らせ】\n本日（１１月１１日）、高市総理は、第７０回町村議会議長全国大会に出席しました。\n\n※高市総理発言要旨（速報版）\n　皆様、こんにちは。第７０回になります町村議会議長全国大会が、本日、こうして盛大に開催されましたこと、心よりお慶びを申し上げます。 https://t.co/xTzI0ZjXBQ","id_str":"2120463915788468440","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"reply_count":37,"retweet_count":103,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA0NjM5MTU2OTYxNzMwNTY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月１１日）、高市総理は、第７０回町村議会議長全国大会に出席しました。\n\n※高市総理発言要旨（速報版）\n　皆様、こんにちは。第７０回になります町村議会議長全国大会が、本日、こうして盛大に開催されましたこと、心よりお慶びを申し上げます。\n　町村議会議長の先生方には、日頃から、住民に最も身近な代表として、地域社会の発展や、また、住民福祉の向上に御尽力を賜っておりますことに、心より感謝を申し上げます。\n　高市内閣では、「強い経済」の実現に向けた政策を加速させて、「日本列島を強く、豊かに」してまいります。\n　日本の大きな伸び代は、地方にあります。『地域未来戦略』に関して、「市町村による計画策定」につきましても、「伴走支援体制」を強化して、一層推進してまいります。\n　私は、今とにかく日本列島の隅々まで、「産業クラスターの花」を咲かせたいと思っております。一緒に取り組んでくださいませ。どうしてもこれは地域経済の成長につなげていきたい、その強い思いを持っております。\n　また、現在、｢物価高｣への対応を最優先課題として取り組んでおるんですけれども、『消費税・支援金法案』を国会に提出しております。切れ目のない物価高対策を講じるという観点からですね、「電気・ガス代支援」について、負担軽減策を実施することといたしました。\n　標準的なご家庭では、１２月から２月までの間、この３か月間で、電気・ガスあわせて、｢７，０００円程度｣の負担引下げ効果を実現できます。例年は１月からということでしたが、もっと寒さの厳しい地域もありますので、まずは１２月から、３月については気候の状況を見てですね、判断するということで、少し早いスタートになります。\n　それから、電気・ガス料金支援の対象とならない特別高圧電力ですとかＬＰガスの利用者、また特に冬の時期に寒冷地で需要が見込まれる灯油利用者への支援につきましては、「重点支援地方交付金」による対応を調整しております。\n　町村議会議長の先生方には、もうぜひともお願いなんですけども、この重点支援地方交付金の交付が決定されましたら、何とか迅速にご対応をいただきますようお願いを申し上げます。\n　これからも、強い地域経済の構築のために、先生方と連携をして、取り組んでまいりますので、ご理解とご協力をお願い申し上げます。\n　とにかく、４７都道府県どこに住んでいても安全に生活することができる、必要な医療や福祉を受けることができる、そして、質の高い教育を受けることができる、ちゃんと働く場所がある、そういう日本列島を　私は次の世代に残したい。今やらなきゃ間に合わない、今始めなければ間に合わない。そんな思いで組んでおりますので、どうかお力添えをよろしくお願いいたします。\n　先生方のご健康と、そして益々のご活躍を心よりお祈り申し上げます。\n　本日は本当におめでとうございました。ありがとうございます。"}}},"rest_id":"2120463915788468440","unmention_data":{},"views":{"count":"37651","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120463915788468440","sortIndex":"2120637033209659381"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":9},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"公正取引委員会の公式アカウントです。 \n公正かつ自由な競争について理解を深めていただくため、措置命令等の報道発表、関係法令（独占禁止法、取適法、フリーランス法、スマホ法等）の解説、イベント・採用情報等をお届けします。 \n#独占禁止法 #取適法 #スマホ法 #フリーランス法","entities":{"description":{},"url":{"urls":[{"display_url":"jftc.go.jp/index.html","expanded_url":"http://www.jftc.go.jp/index.html","indices":[0,23],"url":"https://t.co/izoLg0k5lW"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profi