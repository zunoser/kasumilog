s":["2120445894415761632"],"editable_until_msecs":"1794392271000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":77,"bookmarked":false,"conversation_id_str":"2120445894415761632","created_at":"Wed Nov 11 09:17:51 +0000 2026","display_text_range":[0,120],"entities":{},"favorite_count":9116,"favorited":false,"full_text":"本日、京都府において今シーズン初となる「鳥インフルエンザ」の疑いのある事例が確認されました。\n\n私からは農林水産省をはじめとした関係各省に対して、本事例が「鳥インフルエンザ」だった場合は、防疫措置を迅速に進めることなどを直ちに指示しました。","id_str":"2120445894415761632","is_quote_status":false,"lang":"ja","quote_count":72,"reply_count":447,"retweet_count":1237,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kantei.go.jp/jp/105/discour…","expanded_url":"https://www.kantei.go.jp/jp/105/discourse/20261111message.html","indices":[510,533],"url":"https://t.co/jTbxw0xHpS"},{"display_url":"fsc.go.jp/sonota/tori/to…","expanded_url":"https://www.fsc.go.jp/sonota/tori/tori_infl_ah7n9.html","indices":[562,585],"url":"https://t.co/4dEzquZIKy"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA0NDU4OTQyNjkwMDk5MjA=","richtext":{"richtext_tags":[]},"text":"本日、京都府において今シーズン初となる「鳥インフルエンザ」の疑いのある事例が確認されました。\n\n私からは農林水産省をはじめとした関係各省に対して、本事例が「鳥インフルエンザ」だった場合は、防疫措置を迅速に進めることなどを直ちに指示しました。\n\n「鳥インフルエンザ」は近年秋頃から発生し、養鶏の現場に大きな被害を与えています。\n関係者の皆様はこの時期、日々の予防と、ひとたび発生があった場合の早期の封じ込めに大変な尽力をされており、この場をお借りして敬意を表するとともに、国としてもしっかりとこれを支えてまいります。\n\n発生に際しては法令に則って防疫措置を徹底していますので、ウイルスに感染した鶏肉や卵が市場に出回ることはありません。\n\nまた専門家からは「我が国の現状において、家きんの肉や卵を食べることにより、ヒトが鳥インフルエンザウイルスに感染する可能性はない」との見解が示されており、食に携わる方々の尽力により、消費者の皆様には今後も安心して美味しい鶏肉や卵を食べていただくことができます。\n\n高市内閣はこれからも「日本の食の安全・安心」を守ってまいります。\n\n＜鳥インフルエンザ事案に関する総理指示/ 首相官邸＞\nhttps://t.co/jTbxw0xHpS\n\n＜高病原性鳥インフルエンザについて/ 食品安全委員会＞https://t.co/4dEzquZIKy"}}},"rest_id":"2120445894415761632","unmention_data":{},"views":{"count":"267484","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120445894415761632","sortIndex":"2120637033209659371"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":99},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/530187236663250944/sN73nkH6_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Thu Nov 06 01:42:29 +0000 2014","name":"警察庁","screen_name":"NPA_KOHO"},"dm_permissions":{"can_dm":true},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODkxNTE2ODA5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2-1-2"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2115971953496625195"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"警察庁公式アカウントです。\n\n発信する情報は「報道発表資料」「新着情報」を基本としています。当アカウントは発信専用のため警察庁からの返信等は行っておりません。ご利用にあたっては「警察庁X（旧：Twitter）運用ポリシー」https://t.co/i1GUZVK3RZをご覧ください。","entities":{"description":{"urls":[{"display_url":"npa.go.jp/twitter/policy…","expanded_url":"https://www.npa.go.jp/twitter/policy.html","indices":[111,134],"url":"https://t.co/i1GUZVK3RZ"}]},"url":{"urls":[{"display_url":"npa.go.jp","expanded_url":"http://www.npa.go.jp/","indices":[0,23],"url":"https://t.co/nXofBu7sEB"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profil