unt":1062,"favorited":false,"full_text":"令和８年１１月１１日（水）午前、推定中国無人機×１機（推定）が東シナ海から飛来し、与那国島と台湾との間を通過して太平洋に至り、太平洋上で反転し、再び与那国島と台湾との間を通過して東シナ海に至ったことを確認した。 https://t.co/S6jt9tt4cu","id_str":"2120475475109966223","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":17,"reply_count":24,"retweet_count":330,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA0NzU0NzUwNDY5OTM5MjA=","richtext":{"richtext_tags":[]},"text":"令和８年１１月１１日（水）午前、推定中国無人機×１機（推定）が東シナ海から飛来し、与那国島と台湾との間を通過して太平洋に至り、太平洋上で反転し、再び与那国島と台湾との間を通過して東シナ海に至ったことを確認した。\nまた、同日午前から午後にかけて、中国軍の偵察型無人機（ＢＺＫ－００５）×１機が東シナ海から飛来し、与那国島と台湾との間を通過して太平洋に至り、太平洋上で旋回・反転の後、再び与那国島と台湾との間を通過し、東シナ海上で旋回後、大陸方面に向けて飛行したことを確認した。\nこれに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"rest_id":"2120475475109966223","unmention_data":{},"views":{"count":"48484","state":"EnabledWithCount"}}},"rest_id":"2120476244676677919","unmention_data":{},"views":{"count":"33824","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120476244676677919","sortIndex":"2120637033209659385"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸",