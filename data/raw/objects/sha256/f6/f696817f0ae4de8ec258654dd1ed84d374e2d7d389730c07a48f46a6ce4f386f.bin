館主催の第72回アルジェリア・ナショナルデー・レセプションに出席し、日本政府を代表して挨拶を行いました。 https://t.co/5YInwem9OE","id_str":"2120426861553656169","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":3,"retweet_count":7,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/me_a/me1…","expanded_url":"https://www.mofa.go.jp/mofaj/me_a/me1/dz/pagew_000001_00003.html","indices":[191,214],"url":"https://t.co/aEJtgvBPLH"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA0MjY4NjE0OTQ5MjczNjA=","richtext":{"richtext_tags":[]},"text":"藤井外務大臣政務官は、駐日アルジェリア大使館主催の第72回アルジェリア・ナショナルデー・レセプションに出席し、日本政府を代表して挨拶を行いました。\n藤井政務官は、昨今の中東・北アフリカ情勢を踏まえ、マグレブ地域の重要性は高まっていると述べるとともに、合同経済委員会等の枠組みにおける積極的な対話を通じて、エネルギー分野を始めとする様々な協力が進展することへの期待を表明しました。\n\nhttps://t.co/aEJtgvBPLH"}}},"previous_counts":{"bookmark_count":1,"favorite_count":20,"quote_count":0,"reply_count":0,"retweet_count":2},"rest_id":"2120426861553656169","unmention_data":{},"views":{"count":"4752","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120426861553656169","sortIndex":"2120637033209659355"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011