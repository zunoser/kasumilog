,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"266566401","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":5486,"tweets":23434},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/3tgZ0wGHvI"}}}},"edit_control":{"edit_tweet_ids":["2120461558950379571"],"editable_until_msecs":"1794396006000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2120461558950379571","created_at":"Wed Nov 11 10:20:06 +0000 2026","display_text_range":[0,62],"entities":{"hashtags":[{"indices":[7,14],"text":"ロボット大賞"}]},"favorite_count":22,"favorited":false,"full_text":"／\n第12回 #ロボット大賞 が決定しました🤖\n＼\nロボットの先進的な活用や研究開発など、特に優れた取組を表彰する制度です。","id_str":"2120461558950379571","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":2,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[7,14],"text":"ロボット大賞"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/11/…","expanded_url":"https://www.meti.go.jp/press/2026/11/20261111001.html","indices":[202,225],"url":"https://t.co/x9Zav04GNW"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjA0NjE1NTg4Mjg2MzgyMDg=","richtext":{"richtext_tags":[]},"text":"／\n第12回 #ロボット大賞 が決定しました🤖\n＼\nロボットの先進的な活用や研究開発など、特に優れた取組を表彰する制度です。\n全73件の応募の中から、経済産業大臣賞はラピュタロボティクス株式会社の自在型自動倉庫「ラピュタASRS」、中小企業庁長官賞は蠕動運動型管内検査・清掃ロボット「Sooha」に決定しました。\n11/18～20、東京ビッグサイトで受賞ロボット等の合同展示を行います。\n👇詳細はこちら\nhttps://t.co/x9Zav04GNW"}}},"rest_id":"2120461558950379571","unmention_data":{},"views":{"count":"6007","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120461558950379