uest_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjUyMDU5NTk=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。災害・危機管理関連の政府活動情報をお届けします。なお、このアカウントで発信やリポストした情報のうち被災者応援に関するものは、被災者の方が必要な情報に容易にアクセスできるよう、首相官邸（被災者応援情報）アカウント@kantei_hisaiでもリポストしますので、ご活用ください。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/L24EN3HjH7"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3141133,"following":26},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"265205959","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":700,"tweets":11128},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/L24EN3HjH7"}}}},"edit_control":{"edit_tweet_ids":["2120398234501910994"],"editable_until_msecs":"1794380908000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":225,"bookmarked":false,"conversation_id_str":"2120398234501910994","created_at":"Wed Nov 11 06:08:28 +0000 2026","display_text_range":[0,136],"entities":{},"favorite_count":3502,"favorited":false,"full_text":"【鳥インフルエンザ】\n京都府において鳥インフルエンザの疑い事例が確認されたため、総理は以下の4点を指示（11月11日13時40分に指示）。\n１．鳥インフルエンザと考えられる家きんが確認された場合、農林水産省はじめ関係各省が緊密に連携し、徹底した防疫措置を迅速に進めること。","id_str":"2120398234501910994","is_quote_status":false,"lang":"ja","quote_count":96,"reply_count":27,"retweet_count":1144,"retweeted":false,"user_id_str":"265205959"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjAzOTgyMzQ0NTE2MjgwMzI=","richtext":{"richtext_tags":[]},"text":"【鳥インフルエンザ】\n京都府において鳥インフルエンザの疑い事例が確認されたため、総理は以下の4点を指示（11月11日13時40分に指示）。\n１．鳥インフルエンザと考えられる家きんが確認された場合、農林水産省はじめ関係各省が緊密に連携し、徹底した防疫措置を迅速に進めること。\n２．現場の情報をしっかり収集すること。\n３．家きん業者に対し、厳重な警戒を要請するとともに、予防措置について適切な指導・支援を行うこと。\n４．国民に対して正確な情報を迅速に伝えること。"}}},"rest_id":"2120398234501910994","unmention_data":{},"views":{"count":"427698","state":"EnabledWithCount"}}},"user_id_str":"412940784"},"rest_id":"2120398313786913108","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"4356","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120398313786913108","sortIndex":"2120637033209659337"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/875540374780911616/70s-ef5h_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1469058582/1398238011"},"core":{"created_at":"Thu May 30 06:31:59 +0000 2013","name":"総務省","screen_name":"MIC_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNDY5MDU4NTgy","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関