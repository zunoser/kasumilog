54576242931","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1015","state":"EnabledWithCount"}}}}},"entryId":"tweet-2091827654576242931","sortIndex":"2092126906513096648"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2981996,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":516,"tweets":1726},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2091824795642155490"],"editable_until_msecs":"1787568470000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":110,"bookmarked":false,"conversation_id_str":"2091824795642155490","created_at":"Mon Aug 24 09:47:50 +0000 2026","display_text_range":[0,104],"entities":{},"favorite_count":11347,"favorited":false,"full_text":"綿貫民輔元衆議院議長のご逝去の報に接し、深い悲しみとともに、心より哀悼の誠を捧げます。\n\n先生は、長年にわたり国政に尽力され、我が国の議会政治の発展と地方の声を国政に反映するため、大きな役割を果たされました。","id_str":"2091824795642155490","is_quote_status":false,"lang":"ja","quote_count":64,"reply_count":461,"retweet_count":1079,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTE4MjQ3OTU1ODc1ODgwOTY=","richtext":{"richtext_tags":[]},"text":"綿貫民輔元衆議院議長のご逝去の報に接し、深い悲しみとともに、心より哀悼の誠を捧げます。\n\n先生は、長年にわたり国政に尽力され、我が国の議会政治の発展と地方の声を国政に反映するため、大きな役割を果たされました。\n\n衆議院議長として重責を担われた在任中は、議会の品位と秩序を重んじながら、公正かつ円滑な議会運営に尽くされました。\nそのご功績は、今日においても高く評価されています。\n\n国土基盤の整備と発展に大きく貢献され、国家の将来を論じられた姿は、多くの政治家の記憶に残るものです。\n\n私自身の綿貫先生との思い出は、若い頃、先生の御地元の富山を訪れたときのことです。\n美味しいお寿司をご馳走になり、お土産に富山の名産のチューリップの球根を頂きました。\nチューリップの球根は奈良に持ち帰って、母と一緒に育て、花を咲かせたことを、懐かしく思い起こしています。\n\nまた、南砺市の井波八幡宮の宮司を務める綿貫家の神職でもあられ、日本の伝統と地域を大切にされる綿貫先生には、奈良県内の神社でも神事を執り行っていただき、私にとって特別な存在であり、憧れの方でした。\n\n綿貫先生のこれまでのご功績に深く敬意を表するとともに、そのご遺徳を偲び、御霊のご平安と、御遺族の皆様のご健勝を、お祈り申し上げます。"}}},"rest_id":"2091824795642155490","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"368042","state":"EnabledWithCount"}}}}},"entryId":"tweet-2091824795642155490","sortIndex":"2092126906513096647"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":20},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2011671787697029123/GbiAhFPe_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2916368839/1785238079"},"core":{"created_at":"Tue Dec 02 07:37:39 +0000 2014","name":"海上保安庁","screen_name":"JCG_koho"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTE2MzY4ODM5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2‐1‐3"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"海上保安庁公式アカウントです。海上保安庁ホームページの新着情報を中心に、国民の皆さまにお知らせしたい情報を発信していきます。\n\n運用ポリシーはこちら\nhttps://t.co/UBPfTADUzc","entities":{"description":{"urls":[{"display_url":"kaiho.mlit.go.jp/soshiki/sns-ac…","expanded_url":"https://www.kaiho.mlit.go.jp/soshiki/sns-account.html","indices":[75,98],"url":"https://t.co/UBPfTADUzc"}]},"url":{"urls":[{"display_url":"kaiho.mlit.go.jp","expanded_url":"https://www.kaiho.mlit.go.jp/","indices":[0,23],"url":"https://t.co/1maG8nldqO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","pr