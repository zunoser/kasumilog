"},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2981996,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":516,"tweets":1726},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2092043195018625355"],"editable_until_msecs":"1787620540000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":42,"bookmarked":false,"conversation_id_str":"2092043195018625355","created_at":"Tue Aug 25 00:15:40 +0000 2026","display_text_range":[0,132],"entities":{},"favorite_count":7233,"favorited":false,"full_text":"台風第18号は、非常に強い勢力で沖縄県の大東島地方にかなり接近しており、26日にかけて、強い勢力で沖縄本島地方、奄美地方に接近する見込みです。\n\n沖縄地方や奄美地方では、26日にかけて暴風や高波に厳重に警戒し、奄美地方では26日は土砂災害に厳重に警戒してください。","id_str":"2092043195018625355","is_quote_status":false,"lang":"ja","quote_count":108,"reply_count":530,"retweet_count":791,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTIwNDMxOTQ5NjgyODEwODg=","richtext":{"richtext_tags":[]},"text":"台風第18号は、非常に強い勢力で沖縄県の大東島地方にかなり接近しており、26日にかけて、強い勢力で沖縄本島地方、奄美地方に接近する見込みです。\n\n沖縄地方や奄美地方では、26日にかけて暴風や高波に厳重に警戒し、奄美地方では26日は土砂災害に厳重に警戒してください。\nまた、沖縄地方や奄美地方では27日にかけて、土砂災害、低い土地の浸水、河川の増水、高潮にも注意・警戒が必要です。\n\n官邸では、台風第18号に備え、官邸危機管理センターに設置した「官邸連絡室」において、情報収集に当たっています。\n\n国民の皆様におかれましては、ラジオ・テレビ・インターネットなどで、防災気象情報や自治体からの最新の避難情報に十分注意し、少しでも危険を感じれば、躊躇せず、早め早めに自らの命を守る行動をとっていただくようお願い申し上げます。"}}},"rest_id":"2092043195018625355","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"220645","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092043195018625355","sortIndex":"2092126906513096660"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"