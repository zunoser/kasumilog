85216/photo/1","ext_alt_text":"（左・上段）Nakanoshima Qrossの取組について説明を受ける様子\n（左・下段）吉村知事や澤理事長との記念撮影\n（右）最先端の製造・研究拠点を視察する様子","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":49,"w":49,"x":843,"y":356}]},"medium":{"faces":[{"h":49,"w":49,"x":843,"y":356}]},"orig":{"faces":[{"h":49,"w":49,"x":843,"y":356}]},"small":{"faces":[{"h":27,"w":27,"x":477,"y":201}]}},"id_str":"2091787289613705216","indices":[147,170],"media_key":"3_2091787289613705216","media_results":{"result":{"media_key":"3_2091787289613705216"}},"media_url_https":"https://pbs.twimg.com/media/HQeFdQcaIAAw-oZ.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":162},{"h":834,"w":834,"x":0,"y":0},{"h":834,"w":732,"x":0,"y":0},{"h":834,"w":417,"x":0,"y":0},{"h":834,"w":1200,"x":0,"y":0}],"height":834,"width":1200},"sizes":{"large":{"h":834,"resize":"fit","w":1200},"medium":{"h":834,"resize":"fit","w":1200},"small":{"h":473,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Vq2sBOcCGN"}]},"favorite_count":51,"favorited":false,"full_text":"令和8年8月20日、林総務大臣は、大阪府を訪問しました。\nまず、大阪市において、Nakanoshima Qrossを訪問し、吉村大阪府知事、一般財団法人未来医療推進機構の澤理事長から、再生医療の実用化、産業化などを推進する取組についてお話を伺うとともに、最先端の製造・研究拠点を見学しました。 https://t.co/Vq2sBOcCGN","id_str":"2091787294730785216","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":4,"retweet_count":6,"retweeted":false,"user_id_str":"1469058582"},"rest_id":"2091787294730785216","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"9099","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2092126906513096781-tweet-2091787309058519187","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","twe