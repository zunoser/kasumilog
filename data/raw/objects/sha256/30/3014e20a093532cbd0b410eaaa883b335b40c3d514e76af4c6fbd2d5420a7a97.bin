ideo/2092087560331993088/vid/avc1/640x360/CEEOScEXItGG74bQ.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2092087560331993088/vid/avc1/1280x720/QwhMUkQ8PZYRSkQr.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/mufO3XrVJh","expanded_url":"https://x.com/kantei/status/2092088934113362133/video/1","ext_media_availability":{"status":"Available"},"id_str":"2092087560331993088","indices":[85,108],"media_key":"13_2092087560331993088","media_results":{"result":{"media_key":"13_2092087560331993088"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2092087560331993088/img/dzWxX7-AX6au4Vau.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/mufO3XrVJh","video_info":{"aspect_ratio":[16,9],"duration_millis":145733,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2092087560331993088/pl/F0swHdUTjYO43Ra2.m3u8?tag=29&v=a9c"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2092087560331993088/vid/avc1/480x270/l9DkTi__vVGfWZJZ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2092087560331993088/vid/avc1/640x360/CEEOScEXItGG74bQ.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2092087560331993088/vid/avc1/1280x720/QwhMUkQ8PZYRSkQr.mp4?tag=29"}]}}]},"favorite_count":455,"favorited":false,"full_text":"【お知らせ】\n 本日（８月２５日）、木原官房長官は、福島県内除去土壌等の県外最終処分の実現に向けた再生利用等推進会議を開催しました。\n\n※木原官房長官発言要旨（速報版） https://t.co/mufO3XrVJh","id_str":"2092088934113362133","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":18,"retweet_count":76,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTIwODg5MzQwNDYzMTA0MDA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n 本日（８月２５日）、木原官房長官は、福島県内除去土壌等の県外最終処分の実現に向けた再生利用等推進会議を開催しました。\n\n※木原官房長官発言要旨（速報版）\n　福島の復興に向けましては、中間貯蔵施設に保管されている除去土壌等について、２０４５年３月までに、福島県外での最終処分を実現するよう、昨年取りまとめたロードマップに基づき、政府一丸となって着実に取り組みを前進させていくことが必要であります。\n　特に除去土壌等の県外最終処分に向けては、復興再生利用が鍵となってまいります。次の段階として、地方支分部局２か所の施工を速やかに行うとともに、他の地方支分部局などで、案件を創出するため、関係府省庁が協力して、取り組んでください。\n　それに続き、実用途における先行事例の創出に向けても、検討を着実に進めていただくようにお願いをいたします。\n　また、県外最終処分の実現に向けて、技術的検討等を着実に進めていくことも重要です。このため、有識者会議における取り組みや、本日、環境大臣から説明がありましたけれども、除去土壌の掘り出しの試行なども進め、これらの進捗を踏まえ、段階的に、２０４５年３月までの工程の具体化、これを進めていただくようにお願いをいたします。\n　加えて、復興再生利用等の推進にあたっては、その必要性、安全性等に対する国民の幅広い理解の醸成が必要です。そして重要となってまいります。関係府省庁において、復興再生利用の現場を用いた情報を発信いただくとともに、現地の見学会や、パネルディスカッション等の機会をとらえて、復興再生利用に関する安全性等の分かりやすい発信を強化していただくように、こちらもお願いをいたします。\n　福島の復興に向けた、重要課題の1つである、福島県内除去土壌等の県外最終処分の実現に向けて、政府をあげて、引き続き、全力で取り組んでまいります。私から以上です。"}}},"rest_id":"2092088934113362133","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"26546","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092088934113362133","sortIndex":"2092126906513096687"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":597},"affiliates_highlighted_label":{},"avatar":{"image_url":"https: