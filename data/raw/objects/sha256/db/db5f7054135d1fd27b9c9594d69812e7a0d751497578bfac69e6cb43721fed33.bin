:750,"y":189},{"h":45,"w":45,"x":274,"y":243}]},"orig":{"faces":[{"h":86,"w":86,"x":1625,"y":411},{"h":99,"w":99,"x":594,"y":528}]},"small":{"faces":[{"h":22,"w":22,"x":425,"y":107},{"h":25,"w":25,"x":155,"y":138}]}},"id_str":"2125911225372749824","indices":[143,166],"media_key":"3_2125911225372749824","media_results":{"result":{"media_key":"3_2125911225372749824"}},"media_url_https":"https://pbs.twimg.com/media/HYDA_vRbsAAowVu.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1582,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yew3DoX6pg"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/yew3DoX6pg","expanded_url":"https://x.com/takaichi_sanae/status/2125911282444538187/photo/4","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":75,"w":75,"x":489,"y":601}]},"medium":{"faces":[{"h":44,"w":44,"x":287,"y":352}]},"orig":{"faces":[{"h":96,"w":96,"x":622,"y":764}]},"small":{"faces":[{"h":25,"w":25,"x":162,"y":199}]}},"id_str":"2125911225620217856","indices":[143,166],"media_key":"3_2125911225620217856","media_results":{"result":{"media_key":"3_2125911225620217856"}},"media_url_https":"https://pbs.twimg.com/media/HYDA_wMbwAAu_-n.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":247},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":152,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yew3DoX6pg"}]},"favorite_count":6891,"favorited":false,"full_text":"本日夕刻、訪日中のハイネ・マーシャル諸島共和国大統領をお迎えし、首脳会談をはじめとする一連の首脳行事を実施しました。\n\n私から、日本での再会を喜びつつ、『進化したFOIP（自由で開かれたインド太平洋）』の下で、両国が「共に、強く豊かになる」協力を積み重ねていきたい旨を申し上げました。 https://t.co/yew3DoX6pg","id_str":"2125911282444538187","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":42,"reply_count":645,"retweet_count":742,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU5MTEyODIzODE2ODQ3MzY=","richtext":{"richtext_tags":[]},"text":"本日夕刻、訪日中のハイネ・マーシャル諸島共和国大統領をお迎えし、首脳会談をはじめとする一連の首脳行事を実施しました。\n\n私から、日本での再会を喜びつつ、『進化したFOIP（自由で開かれたインド太平洋）』の下で、両国が「共に、強く豊かになる」協力を積み重ねていきたい旨を申し上げました。\n\nまた、海上保安能力強化やOSA（政府安全保障能力強化支援）の検討などを通じた安全保障分野での協力を進めるとともに、インフラ、漁業、農業、保健、防災、金融を含む様々な取組を通じて、マーシャル諸島の自律性・強靱性の強化を支えていきたい旨をお伝えしました。\n\nハイネ大統領からは、日本の考え方や取組を歓迎するとともに、これまでの日本による支援や協力に対する感謝と、二国間関係の一層の強化への強い意向を伺いました。\n\n会談では、地域情勢や国際場裡の連携についても意見交換を行い、太平洋島しょ地域の結束と一体性の維持・強化が重要であることを確認しました。\n\nまた、両国が共に平和国家として一貫して歩んできており、国際社会の平和のために積極的に貢献するとの決意を共有しました。\n\n来年夏に横浜で開催予定の「第11回太平洋・島サミット（PALM11）」の成功に向けた連携を含め、ハイネ大統領と緊密に協力してまいります。"}}},"rest_id":"2125911282444538187","unmention_data":{},"views":{"count":"207072","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125911282444538187","sortIndex":"2126101812304936950"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pb