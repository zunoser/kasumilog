otations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":12,"bookmarked":false,"conversation_id_str":"2125928943916384760","created_at":"Thu Nov 26 12:25:32 +0000 2026","display_text_range":[0,120],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/o6RQCN58Qr","expanded_url":"https://x.com/kantei/status/2125928943916384760/video/1","ext_media_availability":{"status":"Available"},"id_str":"2125928710008442880","indices":[121,144],"media_key":"13_2125928710008442880","media_results":{"result":{"media_key":"13_2125928710008442880"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2125928710008442880/img/MucWu36xkevFYC1H.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/o6RQCN58Qr","video_info":{"aspect_ratio":[16,9],"duration_millis":126833,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2125928710008442880/pl/zkrsh_n2E51ZPzfT.m3u8?tag=29&v=c5a"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125928710008442880/vid/avc1/480x270/A6yjtNOR4WeCl5oa.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125928710008442880/vid/avc1/640x360/W9pAczrGaOJNkPpi.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125928710008442880/vid/avc1/1280x720/GPjUkWFf1hpPiWrk.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/o6RQCN58Qr","expanded_url":"https://x.com/kantei/status/2125928943916384760/video/1","ext_media_availability":{"status":"Available"},"id_str":"2125928710008442880","indices":[121,144],"media_key":"13_2125928710008442880","media_results":{"result":{"media_key":"13_2125928710008442880"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2125928710008442880/img/MucWu36xkevFYC1H.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/o6RQCN58Qr","video_info":{"aspect_ratio":[16,9],"duration_millis":126833,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2125928710008442880/pl/zkrsh_n2E51ZPzfT.m3u8?tag=29&v=c5a"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125928710008442880/vid/avc1/480x270/A6yjtNOR4WeCl5oa.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125928710008442880/vid/avc1/640x360/W9pAczrGaOJNkPpi.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125928710008442880/vid/avc1/1280x720/GPjUkWFf1hpPiWrk.mp4?tag=29"}]}}]},"favorite_count":700,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２６日）、高市総理は、マーシャル諸島共和国のヒルダ・C・ハイネ大統領と会談を行いました。\n\n※両首脳による冒頭発言（速報版、仮訳）\n（高市総理）\n　ハイネ大統領を再び日本にお迎えできて、とても嬉しく思っております。 https://t.co/o6RQCN58Qr","id_str":"2125928943916384760","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":28,"retweet_count":101,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU5Mjg5NDM4MzY2MDIzNjg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２６日）、高市総理は、マーシャル諸島共和国のヒルダ・C・ハイネ大統領と会談を行いました。\n\n※両首脳による冒頭発言（速報版、仮訳）\n（高市総理）\n　ハイネ大統領を再び日本にお迎えできて、とても嬉しく思っております。 \n　１００年以上の交流と強固な友好関係を土台に、『進化したＦＯＩＰ』の下、「共に、強く豊かに」なる協力を積み重ねていきたいと考えています。\n　今、厳しい戦略環境の中でも、法の支配に基づく自由で開かれた国際秩序を維持・強化するために、来年夏のＰＡＬＭ１１（パーム・イレブン）に向けても、ハイネ大統領と連携していきたいと思います。 \n　この後、いろいろ議論できるのを楽しみにしてます。今日はありがとうございます。\n\n（ハイネ大統領）※日本語仮訳\n　高市総理に再びお会いできることを光栄に思います。今晩、我が代表団を代表し、日本到着以来、我々に対する温かい歓迎と心のこもったおもてなしに心より感謝申し上げます。\n　日本は長きにわたり、マーシャル諸島共和国にとって信頼できる友人であり、大切なパートナーであり続けてきました。相互尊重と共通の価値観に根差した両国の長年にわたる友好関係は、相互の確かな信頼に支えられ、発展し続けています。そのことは、両国の揺るぎないパートナーシップと協力関係にも表れています。\n　この点に関し、我が国の発展に対する日本の揺るぎない支援に感謝の意を表するとともに、我々の地域が直面する課題に対処し、機会を生かしていくという、両国共通の決意を改めて確認したいと思います。\n　世界の不確実性が高まる中、両国の長年にわたるパートナーシップは、これまで以上に重要となっています。本日の会談が、両国の協力を強化し、共通の利益を増進し、平和で安全で繁栄した太平洋地域であり続ける機会となることを期待しております。ありがとうございます。"}}},"rest_id":"2125928943916384760","unmention_data":{},"views":{"count":"35116","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125928943916384760","sortIndex":"2126101812304936954"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":fal