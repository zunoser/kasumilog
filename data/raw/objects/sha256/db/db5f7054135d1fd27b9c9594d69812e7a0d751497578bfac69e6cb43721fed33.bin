,"x":314,"y":169},{"h":23,"w":23,"x":208,"y":176},{"h":27,"w":27,"x":525,"y":153},{"h":93,"w":93,"x":513,"y":114},{"h":119,"w":119,"x":543,"y":106}]}},"id_str":"2125843477414203392","indices":[130,153],"media_key":"3_2125843477414203392","media_results":{"result":{"media_key":"3_2125843477414203392"}},"media_url_https":"https://pbs.twimg.com/media/HYCDYSda0AAlou2.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":108,"y":0},{"h":1734,"w":1521,"x":215,"y":0},{"h":1734,"w":867,"x":542,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/PXzCBhectw"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/PXzCBhectw","expanded_url":"https://x.com/takaichi_sanae/status/2125843606523318591/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2125843441259331584","indices":[130,153],"media_key":"3_2125843441259331584","media_results":{"result":{"media_key":"3_2125843441259331584"}},"media_url_https":"https://pbs.twimg.com/media/HYCDWLxbQAA-HdK.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1857,"w":1857,"x":743,"y":0},{"h":1857,"w":1629,"x":971,"y":0},{"h":1857,"w":929,"x":1547,"y":0},{"h":1857,"w":2600,"x":0,"y":0}],"height":1857,"width":2600},"sizes":{"large":{"h":1463,"resize":"fit","w":2048},"medium":{"h":857,"resize":"fit","w":1200},"small":{"h":486,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/PXzCBhectw"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/PXzCBhectw","expanded_url":"https://x.com/takaichi_sanae/status/2125843606523318591/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":71,"w":71,"x":1089,"y":461},{"h":91,"w":91,"x":1829,"y":455},{"h":85,"w":85,"x":1691,"y":463},{"h":69,"w":69,"x":1273,"y":471},{"h":75,"w":75,"x":303,"y":481},{"h":77,"w":77,"x":1433,"y":479},{"h":73,"w":73,"x":487,"y":491},{"h":77,"w":77,"x":131,"y":497},{"h":69,"w":69,"x":745,"y":512},{"h":65,"w":65,"x":947,"y":509},{"h":71,"w":71,"x":627,"y":531},{"h":83,"w":83,"x":1581,"y":461},{"h":281,"w":281,"x":1547,"y":345},{"h":359,"w":359,"x":1637,"y":319}]},"medium":{"faces":[{"h":42,"w":42,"x":638,"y":270},{"h":53,"w":53,"x":1072,"y":266},{"h":50,"w":50,"x":991,"y":271},{"h":40,"w":40,"x":746,"y":276},{"h":44,"w":44,"x":177,"y":282},{"h":45,"w":45,"x":840,"y":281},{"h":42,"w":42,"x":285,"y":288},{"h":45,"w":45,"x":77,"y":291},{"h":40,"w":40,"x":437,"y":300},{"h":38,"w":38,"x":555,"y":298},{"h":42,"w":42,"x":367,"y":311},{"h":48,"w":48,"x":926,"y":270},{"h":165,"w":165,"x":906,"y":202},{"h":210,"w":210,"x":959,"y":187}]},"orig":{"faces":[{"h":91,"w":91,"x":1383,"y":586},{"h":116,"w":116,"x":2323,"y":578},{"h":109,"w":109,"x":2148,"y":589},{"h":88,"w":88,"x":1617,"y":599},{"h":96,"w":96,"x":385,"y":611},{"h":99,"w":99,"x":1820,"y":609},{"h":93,"w":93,"x":619,"y":624},{"h":99,"w":99,"x":167,"y":632},{"h":88,"w":88,"x":947,"y":650},{"h":83,"w":83,"x":1203,"y":647},{"h":91,"w":91,"x":797,"y":675},{"h":106,"w":106,"x":2008,"y":586},{"h":358,"w":358,"x":1965,"y":439},{"h":457,"w":457,"x":2079,"y":406}]},"small":{"faces":[{"h":23,"w":23,"x":361,"y":153},{"h":30,"w":30,"x":607,"y":151},{"h":28,"w":28,"x":561,"y":154},{"h":23,"w":23,"x":422,"y":156},{"h":25,"w":25,"x":100,"y":159},{"h":25,"w":25,"x":476,"y":159},{"h":24,"w":24,"x":161,"y":163},{"h":25,"w":25,"x":43,"y":165},{"h":23,"w":23,"x":247,"y":170},{"h":21,"w":21,"x":314,"y":169},{"h":23,"w":23,"x":208,"y":176},{"h":27,"w":27,"x":525,"y":153},{"h":93,"w":93,"x":513,"y":114},{"h":119,"w":119,"x":543,"y":106}]}},"id_str":"2125843477414203392","indices":[130,153],"media_key":"3_2125843477414203392","media_results":{"result":{"media_key":"3_2125843477414203392"}},"media_url_https":"https://pbs.twimg.com/media/HYCDYSda0AAlou2.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":108,"y":0},{"h":1734,"w":1521,"x":215,"y":0},{"h":1734,"w":867,"x":542,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/PXzCBhectw"}]},"favorite_count":16756,"favorited":false,"full_text":"平成25年から毎年１回続いている「奈良の柿」PR官邸訪問ですが、国会答弁が入り、一度延期させて頂いておりましたが、本日、生産者の方、奈良の柿PRレディの方など、関係の皆様に、官邸にお越しいただきました。\n\n奈良県五條市は、市町村別の柿産出額が全国第１位です。 https://t.co/PXzCBhectw","id_str":"2125843606523318591","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":143,"reply_count":611,"retweet_count":1460,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU4NDM2MDY0NDc3MjY1OTI=","richtext":{"richtext_tags":[]},"text":"平成25年から毎年１回続いている「奈良の柿」PR官邸訪問ですが、国会答弁が入り、一度延期させて頂いておりましたが、本日、生産者の方、奈良の柿PRレディの方など、関係の皆様に、官邸にお越しいただきました。\n\n奈良県五條市は、市町村別の柿産出額が全国第１位です。\n柿づくりを長年支えてこられた生産者や関係の皆様の努力と情熱に、心から敬意を表します。\n\n試食した「富有柿」は、サクサクとした食感と豊かな甘さが印象的で、生産者の皆様が丹精込めて育てられた思いが伝わってきました。\nまた、柿はビタミンＣなどの栄養も豊富で、日本が誇る秋の味覚の一つです。\n\n特に、五條市では、AIを活用した選果機の導入などスマート農業にも積極的に取り組まれ、海外への輸出も継続されていると伺いました。\n\nさらに、五條市立 西吉野農業高校では全国から生徒を受け入れ、地元の柿農家や農業法人のほ場での実習を通じて次代の担い手育成に力を注がれています。\n奈良県のみならず、日本農業の担い手として育たれることを期待しています。\n\n今年も、恒例の一句を披露させていただきました。\n\n「にっぽんを　強く豊かに　奈良の柿」\n\n高市内閣は、日本の優れた農産物と食文化を次の世代へ引き継ぐとともに、「稼げる農林水産業」の実現に向け、担い手の育成、生産性向上、輸出拡大などを進めてまいります。"}}},"rest_id":"2125843606523318591","unmention_data":{},"views":{"count":"351199","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125843606523318591","sortIndex":"2126101812304936914"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":52},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1103507033079242752/zm3-5c2b_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1178494159/1570511962"},"core":{"created_at":"Thu Feb 14 10:16:42 +0000 2013","name":"法務省","screen_name":"MOJ_HOUMU"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTc4NDk0MTU5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関1-1-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"法務省の公式アカウントです。法務省ホームページに掲載する情報を中心に，法務省からお知らせしたい情報を発信します。\n運用方針はこちらです。→https://t.co/xUDg7yFxpk","entities":{"description":{"urls":[{"display_url":"moj.go.jp/hisho/kouhou/h…","expanded_url":"https://www.moj.go.jp/hisho/kouhou/hisho06_00190.html","indices":[69,92],"url":"https://t.co/xUDg7yFxpk"}]},"url":{"urls":[{"display_url":"moj.go.jp","expanded_url":"https://www.moj.go.jp/","indices":[0,23],"url":"https://t.co/TXATknTGxK"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":276654,"fol