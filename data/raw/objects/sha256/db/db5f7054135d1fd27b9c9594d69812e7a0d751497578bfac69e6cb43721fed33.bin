,"width":1200},"sizes":{"large":{"h":900,"resize":"fit","w":1200},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/bSRmNZtDXW"}]},"favorite_count":5,"favorited":false,"full_text":"📢開催報告を公開しました！\n\n自社の「強み」を、成長につながる「価値」へ変えるには？\n\n「つながる特許庁 in KANSAI／関西ビジネス知財フォーラム2026」では、成長を目指す関西企業のリアルな経営判断や、知財を経営に生かす実践について議論しました。\n\n✔ 技術を価値に変える経営戦略\n✔ https://t.co/bSRmNZtDXW","id_str":"2125765738879430858","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"quoted_status_id_str":"2125143014616273319","quoted_status_permalink":{"display":"x.com/INPIT_jp/statu…","expanded":"https://twitter.com/INPIT_jp/status/2125143014616273319","url":"https://t.co/N8JmwiojF0"},"reply_count":0,"retweet_count":3,"retweeted":false,"user_id_str":"719342924857626624"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[239,247],"text":"つながる特許庁"},{"indices":[248,266],"text":"関西ビジネス知財フォーラム2026"},{"indices":[267,272],"text":"開催報告"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"inpit.go.jp/branch/kansai/…","expanded_url":"https://www.inpit.go.jp/branch/kansai/event/20261126.html","indices":[214,237],"url":"https://t.co/hdtWlTTuHW"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU3NjU3Mzg3NDkzNjIxNzY=","richtext":{"richtext_tags":[]},"text":"📢開催報告を公開しました！\n\n自社の「強み」を、成長につながる「価値」へ変えるには？\n\n「つながる特許庁 in KANSAI／関西ビジネス知財フォーラム2026」では、成長を目指す関西企業のリアルな経営判断や、知財を経営に生かす実践について議論しました。\n\n✔ 技術を価値に変える経営戦略\n✔ 100億企業を目指す成長戦略\n✔ 支援を通じて企業はどう変わったのか\n\n講演やディスカッションの模様を、開催レポートでご紹介します👇\nhttps://t.co/hdtWlTTuHW\n\n#つながる特許庁 #関西ビジネス知財フォーラム2026 #開催報告"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":903},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/878117044134137856/