.com/media/HYCFA-raoAAgTTb.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/moN75yZEAq"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/moN75yZEAq","expanded_url":"https://x.com/takaichi_sanae/status/2125845478101364801/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":73,"w":73,"x":137,"y":521},{"h":77,"w":77,"x":307,"y":531},{"h":71,"w":71,"x":1583,"y":537},{"h":65,"w":65,"x":591,"y":539},{"h":71,"w":71,"x":455,"y":539},{"h":69,"w":69,"x":1189,"y":551},{"h":71,"w":71,"x":1735,"y":551},{"h":69,"w":69,"x":1873,"y":575},{"h":67,"w":67,"x":1327,"y":581},{"h":83,"w":83,"x":1259,"y":963},{"h":129,"w":129,"x":1081,"y":923}]},"medium":{"faces":[{"h":42,"w":42,"x":80,"y":305},{"h":45,"w":45,"x":180,"y":311},{"h":42,"w":42,"x":927,"y":315},{"h":38,"w":38,"x":346,"y":316},{"h":42,"w":42,"x":266,"y":316},{"h":40,"w":40,"x":696,"y":323},{"h":42,"w":42,"x":1016,"y":323},{"h":40,"w":40,"x":1098,"y":337},{"h":39,"w":39,"x":777,"y":340},{"h":48,"w":48,"x":738,"y":564},{"h":76,"w":76,"x":633,"y":541}]},"orig":{"faces":[{"h":93,"w":93,"x":175,"y":662},{"h":99,"w":99,"x":391,"y":675},{"h":91,"w":91,"x":2010,"y":683},{"h":83,"w":83,"x":751,"y":685},{"h":91,"w":91,"x":578,"y":685},{"h":88,"w":88,"x":1510,"y":700},{"h":91,"w":91,"x":2203,"y":700},{"h":88,"w":88,"x":2379,"y":731},{"h":86,"w":86,"x":1685,"y":738},{"h":106,"w":106,"x":1599,"y":1223},{"h":165,"w":165,"x":1373,"y":1173}]},"small":{"faces":[{"h":24,"w":24,"x":45,"y":173},{"h":25,"w":25,"x":102,"y":176},{"h":23,"w":23,"x":525,"y":178},{"h":21,"w":21,"x":196,"y":179},{"h":23,"w":23,"x":151,"y":179},{"h":23,"w":23,"x":394,"y":183},{"h":23,"w":23,"x":576,"y":183},{"h":23,"w":23,"x":622,"y":191},{"h":22,"w":22,"x":440,"y":193},{"h":27,"w":27,"x":418,"y":319},{"h":43,"w":43,"x":359,"y":306}]}},"id_str":"2125845275990466560","indices":[99,122],"media_key":"3_2125845275990466560","media_results":{"result":{"media_key":"3_2125845275990466560"}},"media_url_https":"https://pbs.twimg.com/media/HYCFA-raoAAgTTb.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/moN75yZEAq"}]},"favorite_count":5909,"favorited":false,"full_text":"今朝、タイのギャビン・ウォンクソンキット氏をはじめ、ASEAN各国の経済界で活躍する8名の皆様が官邸を訪ねて下さり、「日ASEANヤングビジネスリーダーズサミット2026」の提言書を拝受しました。 https://t.co/moN75yZEAq","id_str":"2125845478101364801","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":30,"reply_count":330,"retweet_count":607,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU4NDU0NzgwMTMyODQzNTI=","richtext":{"richtext_tags":[]},"text":"今朝、タイのギャビン・ウォンクソンキット氏をはじめ、ASEAN各国の経済界で活躍する8名の皆様が官邸を訪ねて下さり、「日ASEANヤングビジネスリーダーズサミット2026」の提言書を拝受しました。\n\nこのサミットは、日本とASEANの若手・次世代のビジネスリーダー間でコミュニティを形成し、両地域の社会課題解決・成長およびグローバル課題解決への貢献の基盤を構築するため、2023年から年1回開催されています。\n\n私は先週マニラを訪問し、「日ASEANサミット」と「AZEC首脳会合」で共同議長を務め、4月に発表した「パワー・アジア」を更に進展させていくイニシアティブを発信しました。\nさらに、「AZEC首脳会合」では、「脱炭素」「経済成長」「エネルギー安全保障」の同時実現を目指すAZECを、「エネルギー強靭化」と「経済強靭化・GX投資の加速化」を一層強化した「AZEC2.0」に進化させることで一致しました。\n\nご提言いただいた、「サプライチェーン強靭化」、「エネルギー安全保障」、「災害からの復興・レジリエンス」は、これらの取組の方向性と重なるものです。\n\n『自由で開かれたインド太平洋(FOIP)』を更に進化させ、地域の国々と共に、インド太平洋を、「自律性」と「強靱性」を備え、「共に、強く豊かに」していきます。\n\nその主役は、これからの時代を担う、本日お越しいただいた若手ビジネスリーダーの方々です。\n\n本日のご提言が具体的なビジネスと協力につながり、日本とASEANの未来が「強く豊かな」ものになることを期待しています。"}}},"rest_id":"2125845478101364801","unmention_data":{},"views":{"count":"192323","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125845478101364801","sortIndex":"2126101812304936915"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_intersti