=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125914066363600896/vid/avc1/480x270/33CphB5XqidFvHZD.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125914066363600896/vid/avc1/640x360/vGT7MHIeUUfHiYPu.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125914066363600896/vid/avc1/1280x720/JMHUpZmUJl6q269f.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2125914066363600896/vid/avc1/1920x1080/pts78nxzi83mXblM.mp4?tag=29"}]}}]},"favorite_count":165,"favorited":false,"full_text":"石井苗子政務官は、「経産省きものの日」にあたり、有志職員とともに、きものを着用。\n経済産業省本館1階のロビーにて行われた、伝統的工芸品である京友禅のきものや西陣織の帯の展示と併せて、我が国の伝統産業である和装産業のPRを行いました。 https://t.co/FPjqTz83rP","id_str":"2125915034337595445","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":10,"reply_count":8,"retweet_count":31,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[160,166],"text":"きものの日"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU5MTUwMzQyNzg4NzEwNDE=","richtext":{"richtext_tags":[]},"text":"石井苗子政務官は、「経産省きものの日」にあたり、有志職員とともに、きものを着用。\n経済産業省本館1階のロビーにて行われた、伝統的工芸品である京友禅のきものや西陣織の帯の展示と併せて、我が国の伝統産業である和装産業のPRを行いました。\n経済産業省では、引き続き、和装産業の振興および文化継承に向けて取り組んでまいります。\n＃きものの日"}}},"rest_id":"2125915034337595445","unmention_data":{},"views":{"count":"14673","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125915034337595445","sortIndex":"2126101812304936951"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineT