"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0A7Pkb6CcI"}]},"favorite_count":11769,"favorited":false,"full_text":"本日、ノーベル化学賞の受賞が決定されている硤合憲三東京理科大学栄誉教授が、官邸にお越し下さいました。\n\n改めて、硤合先生にノーベル化学賞の受賞及び文化勲章の受章について、お祝いを申し上げました。 https://t.co/0A7Pkb6CcI","id_str":"2125875431991824836","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":35,"reply_count":413,"retweet_count":1005,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU4NzU0MzE5MzMxNzM3NjA=","richtext":{"richtext_tags":[]},"text":"本日、ノーベル化学賞の受賞が決定されている硤合憲三東京理科大学栄誉教授が、官邸にお越し下さいました。\n\n改めて、硤合先生にノーベル化学賞の受賞及び文化勲章の受章について、お祝いを申し上げました。\n\n硤合先生が発見された不斉自己触媒反応は、生命の起源という人類共通の謎の解明にもつながる画期的な成果と伺っており、日本人として、とても誇りに思います。\n\n硤合先生のような世界に誇る研究成果が継続して生まれるよう、高市内閣では、我が国の研究力を抜本的に強化するため科研費の大幅拡充や大学等の基盤的経費の充実に取り組んでまいります。\n\n硤合先生の御健勝を祈念致しますとともに、我が国の学術研究の一層の発展のため、引き続き、御尽力下さることを期待申し上げています。"}}},"rest_id":"2125875431991824836","unmention_data":{},"views":{"count":"261387","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125875431991824836","sortIndex":"2126101812304936931"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"player_url","value":{"string_value":"https://www.youtube.com/embed/akaaYWSN_24","type":"STRING"}},{"key":"player_image_large","