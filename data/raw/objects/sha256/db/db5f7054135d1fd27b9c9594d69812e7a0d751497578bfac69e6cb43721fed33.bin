012790784","indices":[165,188],"media_key":"3_2125761186012790784","media_results":{"result":{"media_key":"3_2125761186012790784"}},"media_url_https":"https://pbs.twimg.com/media/HYA4iTGbAAACdEf.jpg","original_info":{"focus_rects":[{"h":1075,"w":1920,"x":0,"y":1085},{"h":1920,"w":1920,"x":0,"y":240},{"h":2160,"w":1895,"x":25,"y":0},{"h":2160,"w":1080,"x":594,"y":0},{"h":2160,"w":1920,"x":0,"y":0}],"height":2160,"width":1920},"sizes":{"large":{"h":2048,"resize":"fit","w":1820},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/alC0hxV5Oo"},{"display_url":"pic.x.com/alC0hxV5Oo","expanded_url":"https://x.com/MLIT_JAPAN/status/2125847019629801818/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2125761186121834496","indices":[165,188],"media_key":"3_2125761186121834496","media_results":{"result":{"media_key":"3_2125761186121834496"}},"media_url_https":"https://pbs.twimg.com/media/HYA4iTga4AAmDS_.jpg","original_info":{"focus_rects":[{"h":1075,"w":1920,"x":0,"y":381},{"h":1920,"w":1920,"x":0,"y":0},{"h":2160,"w":1895,"x":0,"y":0},{"h":2160,"w":1080,"x":0,"y":0},{"h":2160,"w":1920,"x":0,"y":0}],"height":2160,"width":1920},"sizes":{"large":{"h":2048,"resize":"fit","w":1820},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":604},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/alC0hxV5Oo"}]},"favorite_count":34,"favorited":false,"full_text":"|◤   　    🎥 YouTube配信中\n 　　　#放課後ゲンバミッション！   　◢|\n\n🏗️建物を壊す仕事が、街づくりの第一歩！？\n次の建物をつくるための「解体工事」の現場に中高生リポーターが潜入！\n▶️https://t.co/5g6D3GJ8xD\n\n今回、建物を解体する現場を訪れると・・\n大きな重機で鉄骨を切断❗️ https://t.co/alC0hxV5Oo","id_str":"2125847019629801818","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":4,"retweet_count":5,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[27,39],"text":"放課後ゲンバミッション"},{"indices":[441,451],"text":"国交省建設産業PR"},{"indices":[452,463],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/ryfIiSS3Gaw","expanded_url":"https://youtu.be/ryfIiSS3Gaw","indices":[106,129],"url":"https://t.co/r8DaYIxjWx"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[400,423],"url":"https://t.co/kPJLLRPIOH"}],"user_mentions":[{"id_str":"2100746664126648320","indices":[425,440],"name":"放課後ゲンバミッション","screen_name":"houkago_gennmi"}]},"id":"Tm90ZVR3ZWV0OjIxMjU4NDcwMTk0NzQ1NTA3ODQ=","text":"|◤   　    🎥 YouTube配信中\n 　　　#放課後ゲンバミッション！   　◢|\n\n🏗️建物を壊す仕事が、街づくりの第一歩！？\n次の建物をつくるための「解体工事」の現場に中高生リポーターが潜入！\n▶️https://t.co/r8DaYIxjWx\n\n今回、建物を解体する現場を訪れると・・\n大きな重機で鉄骨を切断❗️\n解体作業で発生する細かなほこり(粉じん)を防ぐための水まきを体験！\n\nさらに、建物の内装を解体する作業にも挑戦しました🔨\n\n解体工事は、ただ建物を壊すだけじゃない！\n次の建物を造るための準備をする、\n新しい街づくりに欠かせない仕事なんです✨\n\n迫力だけじゃない、解体工事の魅力を\nぜひ動画でチェックしてみてください👀\n\n本コンテンツは、国土交通省「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、制作しています。\n詳しくはこちら：https://t.co/kPJLLRPIOH\n\n@houkago_gennmi\n#国交省建設産業PR\n#MLIT建設産業PR"}}},"rest_id":"2125847019629801818","unmention_data":{},"views":{"count":"6232","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125847019629801818","sortIndex":"2126101812304936916"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_