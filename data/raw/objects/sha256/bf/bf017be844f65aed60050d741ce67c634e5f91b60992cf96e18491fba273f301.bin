tps://pbs.twimg.com/media/HXVk8JIbAAAocwM.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":278},{"h":1734,"w":1734,"x":108,"y":0},{"h":1734,"w":1521,"x":215,"y":0},{"h":1734,"w":867,"x":542,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GcvpDcESwH"}]},"favorite_count":636,"favorited":false,"full_text":"フィリピン・マニラを訪問中の高市総理大臣は、アンソニー・アルバニージー・オーストラリア首相（the Honorable Anthony Albanese, MP, Prime Minister of Australia）、ナレンドラ・モディ・インド首相（H.E. Mr. Narendra Modi, Prime Minister of https://t.co/GcvpDcESwH","id_str":"2122713921442439276","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":15,"retweet_count":115,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/fp/nsp/p…","expanded_url":"https://www.mofa.go.jp/mofaj/fp/nsp/page1_001702_00004.html","indices":[454,477],"url":"https://t.co/t6FoRuSazj"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI3MTM5MjEzMTY2MzQ2MjQ=","richtext":{"richtext_tags":[]},"text":"フィリピン・マニラを訪問中の高市総理大臣は、アンソニー・アルバニージー・オーストラリア首相（the Honorable Anthony Albanese, MP, Prime Minister of Australia）、ナレンドラ・モディ・インド首相（H.E. Mr. Narendra Modi, Prime Minister of India）及びドナルド・Ｊ・トランプ米国大統領（the Honorable Donald J. Trump, President of the United States of America）と日米豪印首脳会合を行いました。\n4か国首脳は、善を推進する力として、地域の平和と安定に対するコミットメントを表明しました。\nまた、4か国の首脳は、安倍元総理大臣が提唱して10年が経ち、FOIPのビジョンはこれまでになく力強くなっているとの認識を示した上で、これを引き続き支持していくことで一致し、FOIP実現に向けた揺るぎない結束を示しました。\n（写真提供：内閣広報室）\nhttps://t.co/t6FoRuSazj"}}},"rest_id":"2122713921442439276","unmention_data":{},"views":{"count":"12192","state":"EnabledWithCount"}}}}},"entryId":"twe