21,"w":121,"x":518,"y":512},{"h":468,"w":468,"x":1046,"y":315}]},"medium":{"faces":[{"h":90,"w":90,"x":388,"y":384},{"h":351,"w":351,"x":784,"y":236}]},"orig":{"faces":[{"h":121,"w":121,"x":518,"y":512},{"h":468,"w":468,"x":1046,"y":315}]},"small":{"faces":[{"h":51,"w":51,"x":220,"y":217},{"h":198,"w":198,"x":444,"y":133}]}},"id_str":"2122675027476926465","indices":[61,84],"media_key":"3_2122675027476926465","media_results":{"result":{"media_key":"3_2122675027476926465"}},"media_url_https":"https://pbs.twimg.com/media/HXVBsOpa0AEspP1.jpg","original_info":{"focus_rects":[{"h":896,"w":1600,"x":0,"y":152},{"h":1200,"w":1200,"x":400,"y":0},{"h":1200,"w":1053,"x":547,"y":0},{"h":1200,"w":600,"x":1000,"y":0},{"h":1200,"w":1600,"x":0,"y":0}],"height":1200,"width":1600},"sizes":{"large":{"h":1200,"resize":"fit","w":1600},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xyTJJOQMbu"}]},"favorite_count":168,"favorited":false,"full_text":"赤澤大臣は、高市総理が共同議長としてフィリピン・マニラにて開催した第4回AZEC首脳会合に出席。#meti_daijin https://t.co/xyTJJOQMbu","id_str":"2122675814697185709","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":0,"retweet_count":33,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[48,60],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/11/…","expanded_url":"https://www.meti.go.jp/press/2026/11/20261117004.html","indices":[398,421],"url":"https://t.co/KeQ3OH5haE"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI2NzU4MTQ1NTAzOTY5Mjg=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、高市総理が共同議長としてフィリピン・マニラにて開催した第4回AZEC首脳会合に出席。#meti_daijin\n先月の第4回AZEC閣僚会合の成果として、石油備蓄に関する今後の取組方針を示したワークプログラムに合意するとともに、「多様な道筋」によるエネルギー・トランジションを進めることで一致したこと、産油国とAZECパートナー国による初の特別セッションを開催し、産油国・消費国間の協力・連携を具現化したこと等を発言しました。\n会合では、「パワー・アジア」を強化する具体的な方策として、「アジア石油安全保障タスクフォース」の創設、ASEAN地域の共同備蓄構想と連携した日本発の備蓄プロジェクトの提示、アジア共通市場の創出に向けたアジア・イノベーション実装エコシステム「ブリッジ・アジア」イニシアティブが提唱されました。\n\n今回のフィリピン出張全般に関するプレスリリースもご覧ください。\nhttps://t.co/KeQ3OH5haE"}}},"rest_id":"2122675814697185709","unmention_data":{},"views":{"count":"9641","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122675814697185709","sortIndex":"2122907703528390603"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"