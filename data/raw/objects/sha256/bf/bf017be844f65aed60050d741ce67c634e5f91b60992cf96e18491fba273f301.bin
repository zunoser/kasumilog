splayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1771823,"following":48},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8404,"tweets":23579},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2122657702262480896"],"editable_until_msecs":"1794919607000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":130,"bookmarked":false,"conversation_id_str":"2122657702262480896","created_at":"Tue Nov 17 11:46:47 +0000 2026","display_text_range":[0,135],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/Gz8ITQtePG","expanded_url":"https://x.com/kantei/status/2122657702262480896/video/1","ext_media_availability":{"status":"Available"},"id_str":"2122654073954746368","indices":[136,159],"media_key":"13_2122654073954746368","media_results":{"result":{"media_key":"13_2122654073954746368"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2122654073954746368/img/OqorBLH-Y0BhMKhP.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/Gz8ITQtePG","video_info":{"aspect_ratio":[16,9],"duration_millis":539966,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122654073954746368/pl/4lUDf5FKvw2hT1Nw.m3u8?tag=29&v=bff"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122654073954746368/vid/avc1/480x270/Q29EXRv2sY6aaBXZ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122654073954746368/vid/avc1/640x360/chhMmmRoVvYRAnHU.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122654073954746368/vid/avc1/1280x720/fz3KB8Jd_xGMud0h.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/Gz8ITQtePG","expanded_url":"https://x.com/kantei/status/2122657702262480896/video/1","ext_media_availability":{"status":"Available"},"id_str":"2122654073954746368","indices":[136,159],"media_key":"13_2122654073954746368","media_results":{"result":{"media_key":"13_2122654073954746368"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2122654073954746368/img/OqorBLH-Y0BhMKhP.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/Gz8ITQtePG","video_info":{"aspect_ratio":[16,9],"duration_millis":539966,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122654073954746368/pl/4lUDf5FKvw2hT1Nw.m3u8?tag=29&v=bff"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122654073954746368/vid/avc1/480x270/Q29EXRv2sY6aaBXZ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122654073954746368/vid/avc1/640x360/chhMmmRoVvYRAnHU.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122654073954746368/vid/avc1/1280x720/fz3KB8Jd_xGMud0h.mp4?tag=29"}]}}]},"favorite_count":5768,"favorited":false,"full_text":"【お知らせ】\n１１月１７日（現地時間）、高市総理は、ＡＺＥＣ首脳会合に出席しました。\n\n※冒頭発言要旨（速報版、仮訳）\n（高市総理）\n　ただいまから、第４回ＡＺＥＣ首脳会合を開催いたします。\n　共同議長のマルコス大統領はじめ、御出席の各国首脳の皆様の御協力に感謝します。 https://t.co/Gz8ITQtePG","id_str":"2122657702262480896","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":53,"reply_count":147,"retweet_count":724,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI2NTc3MDIwODYzNTI4OTc=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n１１月１７日（現地時間）、高市総理は、ＡＺＥＣ首脳会合に出席しました。\n\n※冒頭発言要旨（速報版、仮訳）\n（高市総理）\n　ただいまから、第４回ＡＺＥＣ首脳会合を開催いたします。\n　共同議長のマルコス大統領はじめ、御出席の各国首脳の皆様の御協力に感謝します。\n　東ティモール、インド、韓国の今次会合への参加を心から歓迎します。\n　エネルギー供給問題が顕在化する中、エネルギー安全保障、経済成長、脱炭素の同時実現の重要性が一層増しています。\n　本年発表した「パワー・アジア」を強化し、ＡＺＥＣを「ＡＺＥＣ２．０」へと進化させたいと考えております。\n　エネルギー強靱化に向けて、ＩＥＡ、ＥＲＩＡと緊急時の放出・融通のルール作りを目指す「アジア石油安全保障タスクフォース」を創設し、その中核を担う、ＩＥＡ東京拠点を新たに設立いたします。これを、いわゆる「アジア版ＩＥＡ」として提唱したいです。\n　また、日本の休止タンクを活用し、フィリピン主導の共同備蓄とも連携した、「アジアの石油備蓄協力」を提案いたします。\n　バイオ燃料、ＳＭＲ、次世代太陽光も推進してまいります。\n　経済強靱化に向け、先端分野において世界人口約３割を占める「アジア共通市場」の創出を目指すため、「ブリッジ・アジア」イニシアティブを立ち上げます。\n　同時に、ＡＤＢ、ＥＲＩＡと連携し、トランジション・ファイナンス及びＧＸ投資を加速させます。\n　エネルギー、食料、防災、気候変動について、国際機関とも連携した危機管理投資も進めてまいります。\n　また、中東の湾岸諸国の経済・エネルギー強靱化に向けた包括的な協力計画として、「パワー・ガルフ」を提唱しております。産油国とアジア消費国の連携強化を進めてまいります。\n　気候変動対策と経済成長は必ず両立できます。\n　気候変動対策をしたら何か経済に悪い影響があるんじゃないか、そうおっしゃる方もいますが、私は違うと思います。必ず両立できます。\n　日本が産油国とアジアの結節点となり、「二国間クレジット制度」も活用し、ＡＺＥＣを通じて、この地域を「共に強く、豊か」にしてまいります。\n　これは、私が提唱する、『進化したＦＯＩＰ』の具現化であり、実現に向けた大きな一歩を皆様と共に踏み出したいと考えます。\n　次に、共同議長のマルコス大統領から御発言をいただきます。どうぞ。\n\n（マルコス大統領）\n　議長、高市早苗総理大臣、ＡＺＥＣメンバー国及びゲスト国の首脳、本日、御出席の代表団およびオブザーバーの皆様、御列席の皆様、おはようございます。\n　先月、まさにこの建物において、我々の閣僚は、アジアのエネルギー・ライフラインは依然として極めて脆弱であるという、否定のできない厳然たる事実を発信しました。ホルムズ海峡のような極めて重要な供給ルートに関する混乱は、決して地域にとどまることはなく、世界的なサプライチェーン全体に影響します。私がＡＺＥＣプラス・オンライン首脳会合で強調しましたように、いかなる国家も、単独の行動ではこの規模の衝撃から自国を守ることはできません。今年は、その現実がいささかの疑いもなく証明されました。\n　だからこそ、私は、ＡＺＥＣが原則から実施へとしっかりと移行していることを心強く思っています。「パワー・アジア」の立ち上げから、炭素市場の動員のための主要なアクション・フォーラムの設立や石油備蓄強化のためのワークプログラムの採択に至るまで、ＡＺＥＣは具体的な成果をもたらしています。本日、約６００のエネルギープロジェクトが進行しており、このパートナーシップは我々の地域のエネルギーシステムを直接的に強化しています。ＡＳＥＡＮの一部として、フィリピンは、ＡＺＥＣを重複した取組ではなく、我々の地域のエネルギー優先事項を加速させる極めて重要な推進力として捉えています。ＡＺＥＣ２．０の核心的なビジョンに導かれ、フィリピンは、エネルギー安全保障と経済成長が不可分に結びついていると認識しています。この観点から、我々は、エネルギー安全保障、経済成長、そして脱炭素化の推進をすべて同時に達成する、実用的で各国主導のアジェンダを必要としています。\n　フィリピンにとって我々の優先事項は明確です。我々は、強固なインフラと資金調達が支える戦略的石油備蓄を積極的に推進しています。この勢いを後押しするため、我々は、再生可能エネルギー、送電網の近代化、エネルギー貯蔵から、天然ガス、省エネルギー、そして地域全体のエネルギー安全保障に貢献する新興技術に至るまで、我々のエネルギー展望全体にわたる影響力の高い投資を歓迎します。\n　しかし、備蓄だけでは十分ではありません。持続可能で永続的なエネルギー安全保障は、石油消費国と石油産出国が一致団結して行動することを求めています。我々は、情報共有と実践的な貯蔵メカニズムを深めるとともに、海上交通路（シーレーン）を維持し、公正で透明な市場を維持するために国際法を遵守することを約束しなければなりません。買い手も売り手も、ボラティリティ（変動性）から利益を得ることはありません。エネルギーの強靱性は、我々の集団的なコミットメントを必要とする共有されたグローバルな公共財です。\n　同様に重要なのは、エネルギー移行への迅速かつバランスの取れたアプローチです。我々は、極めて重要な移行燃料としてのＬＮＧに関する地域協力を歓迎する一方で、グリーンエネルギー・オークション・プログラムを通じて２０３５年までに少なくとも２５ギガワットの再生可能エネルギー容量を確保するという目標に断固として取り組み続け、２０４０年までに発電ミックスにおけるその割合を５０％に引き上げることを目指し、日本といったパートナーとともに、多様化し、信頼性が高く、かつ低炭素なエネルギー源の一部として原子力発電の基礎を築きつつ、バイオ燃料、水素、アンモニア、及び炭素回収における実行可能な未開拓分野を追求しています。省エネは、エネルギー不安に対する我々の第一の防衛線であり続けており、我々は、国家電動モビリティ枠組みの下での省エネ向上及び的を絞ったイニシアティブへの投資を呼びかけます。\n　変革は、資本と誠実さによって推進されなければなりません。今年、我々はシンガポールとの間で初めてパリ協定第６条実施協定に署名しました。先月私は、グリーンファイナンスを促進し、我が国の決定する貢献（ＮＤＣ）を支援し、炭素クレジット取引を規制する、我が国の炭素市場政策枠組みを発表しました。\n　しかし、資金だけでエネルギー移行の成功が保証されるわけではありません。我々の国家公正な移行枠組みを通じて、我々は、低炭素経済への移行が適切な雇用を創出し、新たな産業に向けて我々の労働力を備え、この変化によって最も影響を受ける地域社会を保護することを確実にするために取り組んでいます。\n　相互に接続された世界において、自国の未来に単独でエネルギーを供給できる国はありません。フィリピンがエネルギー安全保障に向けて踏み出すあらゆる歩みは、我が国の国境で終わるものではありません。それは、我々の地域全体の強さ、安定、および集団的な強靱性を強化するものです。ＡＺＥＣの指針である「一つの目標、多様な道筋」は、各国の状況や開発の優先事項に適した各国のアプローチを尊重しつつ、我々を明確な目標に向けて団結させます。\n　したがって、我々はＡＺＥＣのパートナーに対し、フィリピンは確固たるビジョンを持ち、大胆かつ即座の行動をとり、そしてすべての人に進歩をもたらすパートナーシップを歓迎し、エネルギーの未来を描き続けることを確約します。ありがとうございました。"}}},"rest_id":"2122657702262480896","unmention_data":{},"views":{"count":"114141","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122657702262480896","sortIndex":"2122907703528390598"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1268754,"following":45},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7916,"tweets":22018},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2122652469025255477"],"editable_until_msecs":"179