53,"w":53,"x":658,"y":572},{"h":60,"w":60,"x":396,"y":182},{"h":66,"w":66,"x":630,"y":132},{"h":79,"w":79,"x":849,"y":144},{"h":65,"w":65,"x":195,"y":201}]},"orig":{"faces":[{"h":116,"w":116,"x":1426,"y":1241},{"h":132,"w":132,"x":860,"y":396},{"h":144,"w":144,"x":1366,"y":286},{"h":172,"w":172,"x":1840,"y":312},{"h":142,"w":142,"x":424,"y":436}]},"small":{"faces":[{"h":30,"w":30,"x":372,"y":324},{"h":34,"w":34,"x":224,"y":103},{"h":37,"w":37,"x":357,"y":74},{"h":44,"w":44,"x":481,"y":81},{"h":37,"w":37,"x":110,"y":114}]}},"id_str":"2122713696925536256","indices":[91,114],"media_key":"3_2122713696925536256","media_results":{"result":{"media_key":"3_2122713696925536256"}},"media_url_https":"https://pbs.twimg.com/media/HXVk3FkaUAAjU5n.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":278},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":282,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Jfm4b7e3ed"}]},"favorite_count":11608,"favorited":false,"full_text":"本日午後は、マルチ会合に出席したほか、二国間の首脳会談を実施しました。\n\n＜東アジア首脳会議（EAS）＞\nEASは、地域の主要国が地域・国際情勢を議論するプレミア・フォーラムです。 https://t.co/Jfm4b7e3ed","id_str":"2122713729192296945","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":85,"reply_count":684,"retweet_count":1198,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI3MTM3MjkxMDAwNzA5MTI=","richtext":{"richtext_tags":[]},"text":"本日午後は、マルチ会合に出席したほか、二国間の首脳会談を実施しました。\n\n＜東アジア首脳会議（EAS）＞\nEASは、地域の主要国が地域・国際情勢を議論するプレミア・フォーラムです。\n私から、東シナ海を含め、世界中のどこであれ、「力又は威圧による一方的な現状変更の試み」は決して受け入れられず、日本は「法の支配に基づく自由で開かれた国際秩序」を維持・強化し、紛争が平和的に解決されることを重視している旨を主張しました。\nまた、南シナ海を含むインド太平洋、台湾、北朝鮮、ミャンマー、中東、ウクライナといった地域情勢に関して、我が国の立場を発信しました。\nEASでは、議長国が設定したテーマ「共に未来を切り拓く：安定と再生」に関する宣言と、オンライン詐欺及び関連犯罪対策協力強化に関する首脳声明が採択されました。\n\n＜日タイ首脳会談、日韓首脳会談＞\n今回の機会を捉えて、タイ及び韓国と首脳会談を実施しました。\n\nアヌティン・タイ首相とは、初めての会談となりました。\n私から、地域各国の自律性と強靱性を高めるべく力を合わせたい旨をお伝えし、アヌティン首相からは、これまでの日本の貢献への深い謝意と様々な分野での協力強化に向けた期待を伺いました。\nエネルギー、宇宙、安全保障といった分野での協力を進展させることで一致したほか、タイ・カンボジア国境問題を含む地域情勢についての緊密な協力を確認しました。\n\n李在明韓国大統領とは、「シャトル外交」を積極的に実施していくことや、幅広い分野で具体的な成果を目指していくことで一致しました。\n日米同盟・韓米同盟の強化、日韓米協力の推進を再確認したほか、私から、拉致問題の即時解決に向けた理解と協力を求め、李大統領の支持を得ました。\n\n＜日米豪印（クアッド）首脳会合＞\nトランプ米国大統領、アルバニージー・オーストラリア首相、モディ・インド首相と、私にとっては初めてとなるクアッド首脳会合に出席しました。\n自由で開かれた国際秩序に対する挑戦が一段と激しさを増す中で、基本的価値を共有する民主主義国家である日米豪印の首脳が一堂に会し、戦略的認識をすり合わせました。\n「自由で開かれたインド太平洋（FOIP）」の実現に向けた揺るぎない結束を世界に力強く示すとともに、インド太平洋地域の各国が裨益する様々な具体的な協力で一致することができたことは、大きな成果です。\n４か国首脳は、「力又は威圧による一方的な現状変更の試み」に対する強い反対を表明するとともに、恣意的な輸出規制を含む経済的威圧に対する深刻な懸念を表明しました。\n私からは、海洋安全保障、経済安全保障、エネルギー、重要・新興技術を始め幅広い分野で、域内各国の「自律性」と「強靱性」を強化し、FOIPを実現していきたい旨をお伝えし、クアッドは地域が裨益する協力で結果を出していくとの決意を申し上げた上で、広範な課題について議論を交わしました。\n４か国の取組と方針を示すものとして、共同プレスリリースも発出されました。\n価値観を共有する民主主義国家として、常に地域の平和と安定に貢献してきたクアッドは、これからも地域のパートナーと共に、インド太平洋の未来を作っていきます。"}}},"rest_id":"2122713729192296945","unmention_data":{},"views":{"count":"419902","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122713729192296945","sortIndex":"2122907703528390609"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2122907703528390704-tweet-2122607844356943936","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result