0}},"type":"photo","url":"https://t.co/kWo3nxHdPX"}]},"favorite_count":925,"favorited":false,"full_text":"8月24日、自衛官の給与体系の独自見直しに関する有識者会議（第13回処遇・給与部会）を開催しました。\n \nこれまでの議論を踏まえた処遇・給与部会としての中間提言が取りまとめられました。 https://t.co/kWo3nxHdPX","id_str":"2092193873502289936","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":27,"retweet_count":113,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/policy/agend…","expanded_url":"http://www.mod.go.jp/j/policy/agenda/meeting/jinji/giji_shoguu.html","indices":[161,184],"url":"https://t.co/Wkof8MUboN"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTIxOTM4NzMzODQ4MzcxMjA=","text":"8月24日、自衛官の給与体系の独自見直しに関する有識者会議（第13回処遇・給与部会）を開催しました。\n \nこれまでの議論を踏まえた処遇・給与部会としての中間提言が取りまとめられました。\n \n防衛省は、提言の内容を踏まえ、自衛官の給与体系の独自見直しに向け、年内に結論が得られるよう、さらなる検討を進めてまいります！\n 　\nhttps://t.co/Wkof8MUboN"}}},"rest_id":"2092193873502289936","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"53802","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092193873502289936","sortIndex":"2092451665662705621"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2092451665662705708-tweet-2092192777413255341","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_resul