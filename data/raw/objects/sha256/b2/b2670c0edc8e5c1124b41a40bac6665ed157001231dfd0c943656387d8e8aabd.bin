rls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTIxNTg3NjgxMzgzMjYwMTY=","richtext":{"richtext_tags":[]},"text":"8月23日（日）、佐々木副大臣は、宮城県仙台市にて開催された「海上保安庁巡視船からの油流出事案に関するタスクフォース」（第2回会議）に出席しました。\n　当該タスクフォースでは、引き続き、漁業関係者の負担軽減策や加工・流通、観光業への影響の情報収集に取り組むことが確認されたほか、被害漁場及び周辺海域で養殖生産を行うことに問題がない旨の安全宣言が行われました。"}}},"rest_id":"2092158768188674337","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"10075","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092158768188674337","sortIndex":"2092451665662705593"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"description","value":{"string_value":"復興庁のホームページです。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.reconstruction.go.jp","type":"STRING"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"reconstruction.go.jp","type":"STRING"}},{"key":"title","value":{"string_value":"牧野復興大臣記者会見録［令和８年８月25日］","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/qhmZ7nENOZ","type":"STRING"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary","url":"https://t.co/qhmZ7nENOZ","user_refs_results":[]},"rest_id":"https://t.co/qhmZ7nENOZ"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":1},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1369820966382039040/xn_dTvqx_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2931953732/1741141864