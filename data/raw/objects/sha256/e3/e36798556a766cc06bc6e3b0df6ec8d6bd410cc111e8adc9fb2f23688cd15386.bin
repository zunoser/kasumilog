,"x":0,"y":247},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":0,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GfjfeNtuQe"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/GfjfeNtuQe","expanded_url":"https://x.com/takaichi_sanae/status/2126260611277566320/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":67,"w":67,"x":635,"y":427},{"h":95,"w":95,"x":285,"y":203},{"h":117,"w":117,"x":425,"y":453}]},"medium":{"faces":[{"h":39,"w":39,"x":372,"y":250},{"h":55,"w":55,"x":167,"y":119},{"h":68,"w":68,"x":249,"y":265}]},"orig":{"faces":[{"h":86,"w":86,"x":807,"y":543},{"h":121,"w":121,"x":363,"y":258},{"h":149,"w":149,"x":540,"y":576}]},"small":{"faces":[{"h":22,"w":22,"x":211,"y":142},{"h":31,"w":31,"x":94,"y":67},{"h":38,"w":38,"x":141,"y":150}]}},"id_str":"2126260575844155392","indices":[97,120],"media_key":"3_2126260575844155392","media_results":{"result":{"media_key":"3_2126260575844155392"}},"media_url_https":"https://pbs.twimg.com/media/HYH-unMbwAAqnpU.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GfjfeNtuQe"}]},"favorite_count":6478,"favorited":false,"full_text":"本日の夕刻、全国の知事の皆様にお集まりいただき、「全国都道府県知事会議」を開催いたしました。\n\nこの会議は、各地のリーダーとしてご尽力されている知事の皆様から直接ご意見を伺える貴重な機会です。 https://t.co/GfjfeNtuQe","id_str":"2126260611277566320","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":90,"reply_count":559,"retweet_count":657,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyNjA2MTEyMDYyOTU1NTI=","richtext":{"richtext_tags":[]},"text":"本日の夕刻、全国の知事の皆様にお集まりいただき、「全国都道府県知事会議」を開催いたしました。\n\nこの会議は、各地のリーダーとしてご尽力されている知事の皆様から直接ご意見を伺える貴重な機会です。\n\n知事の皆様には、現在、『地域未来戦略』に積極的に取り組んでいただいており、既に合計150を超える計画が策定・公表されています。\n\n本日は、今後5年間の支援方針を明らかにした『地域未来戦略実現フレーム』の策定などについて意見交換を行いました。\n\nまた、策定に向けて作業を進めている『人口総合戦略』ついても意見交換を行いました。\n\n人口減少は静かに進む国難であり、少子化の流れを反転させるとともに、「人口減少社会」に適応した新たな国のかたちを築かなければなりません。\n\nその他にも、\n・「国と地方の役割分担の見直し」、\n・「保育人材の確保・処遇改善」、\n・「国土強靱化の着実な推進」、\n・「地方税財政」、\n・「防災」、\n・「人材育成」など、\n多岐にわたる分野について、様々なご要望をいただくとともに、活発な意見交換を行うことができました。\n\nこれからも、地方の皆様のご意見を伺いながら、しっかりと連携して、「強い経済」の実現に向けた政策を進め、「日本列島を強く、豊かに」してまいります。"}}},"rest_id":"2126260611277566320","unmention_data":{},"views":{"count":"257149","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126260611277566320","sortIndex":"2126390288539713517"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"