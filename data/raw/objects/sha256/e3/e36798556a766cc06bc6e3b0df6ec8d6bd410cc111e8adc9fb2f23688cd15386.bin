small":{"faces":[{"h":29,"w":29,"x":119,"y":197}]}},"id_str":"2121141522032996352","indices":[145,168],"media_key":"3_2121141522032996352","media_results":{"result":{"media_key":"3_2121141522032996352"}},"media_url_https":"https://pbs.twimg.com/media/HW_O-dsbsAAu5gG.jpg","original_info":{"focus_rects":[{"h":931,"w":1663,"x":0,"y":75},{"h":1247,"w":1247,"x":0,"y":0},{"h":1247,"w":1094,"x":0,"y":0},{"h":1247,"w":624,"x":0,"y":0},{"h":1247,"w":1663,"x":0,"y":0}],"height":1247,"width":1663},"sizes":{"large":{"h":1247,"resize":"fit","w":1663},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/PnaOrJvA8x"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/PnaOrJvA8x","expanded_url":"https://x.com/ModJapan_jp/status/2121181293832479182/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":71,"w":71,"x":292,"y":482}]},"medium":{"faces":[{"h":51,"w":51,"x":210,"y":347}]},"orig":{"faces":[{"h":71,"w":71,"x":292,"y":482}]},"small":{"faces":[{"h":29,"w":29,"x":119,"y":197}]}},"id_str":"2121141522032996352","indices":[145,168],"media_key":"3_2121141522032996352","media_results":{"result":{"media_key":"3_2121141522032996352"}},"media_url_https":"https://pbs.twimg.com/media/HW_O-dsbsAAu5gG.jpg","original_info":{"focus_rects":[{"h":931,"w":1663,"x":0,"y":75},{"h":1247,"w":1247,"x":0,"y":0},{"h":1247,"w":1094,"x":0,"y":0},{"h":1247,"w":624,"x":0,"y":0},{"h":1247,"w":1663,"x":0,"y":0}],"height":1247,"width":1663},"sizes":{"large":{"h":1247,"resize":"fit","w":1663},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/PnaOrJvA8x"}]},"favorite_count":492,"favorited":false,"full_text":"【🛰防衛×宇宙🚀シリーズ㉝】\n第33弾は「防大生、宇宙を目指す」\n \n防衛大学校の校友会「宇宙システム技術研究同好会」が、明日14日(土)に開催される第34回衛星設計コンテストの最終審査会に出場!\n審査会の模様はYouTubeで配信されますので、未来の宇宙人材の活躍を是非ご視聴ください! https://t.co/PnaOrJvA8x","id_str":"2121181293832479182","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"quoted_status_id_str":"2113571148134858782","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2113571148134858782","url":"https://t.co/ruLv87j0YV"},"reply_count":6,"retweet_count":77,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[584,589],"text":"宇宙安保"},{"indices":[590,604],"text":"SDF_SpaceYear"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"satcon.jp/review/#id-pas…","expanded_url":"https://www.satcon.jp/review/#id-passed","indices":[558,581],"url":"https://t.co/bRlltMOc1E"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExODEyOTM2ODk4MzU1MjA=","text":"【🛰防衛×宇宙🚀シリーズ㉝】\n第33弾は「防大生、宇宙を目指す」\n \n防衛大学校の校友会「宇宙システム技術研究同好会」が、明日14日(土)に開催される第34回衛星設計コンテストの最終審査会に出場!\n審査会の模様はYouTubeで配信されますので、未来の宇宙人材の活躍を是非ご視聴ください!\n \n衛星設計コンテストは、高校生から大学院生までを対象にした教育プログラムで、参加者は様々な宇宙ミッションを創出し、その設計を行います。こうした学生の着想や創意工夫を育む取組が日本の宇宙業界の活発化に繋がることを期待しています！\n \n宇宙システム技術研究同好会が提案するのは、「GNSS(全地球測位システム)電波環境監視技術実証衛星みはり」🛰\nGPSや準天頂衛星みちびきなどの測位衛星は、車、飛行機、船舶のナビゲーションなどを担う重要な衛星ですが、近年は「ジャミング」や、誤った位置を利用者に見せる「スプーフィング」📡といった妨害技術が高度化しており、電波環境把握の重要性はますます増しています💡\nこの提案では、利用される周波数帯の電波品質などの健全性を軌道上から継続監視するとともに、GNSS帯で電波干渉を引き起こす地上発信源の位置推定をミッションとしています🌠\n \n☟第34回衛星設計コンテスト最終審査会のページはこちら\nhttps://t.co/bRlltMOc1E\n \n#宇宙安保\n#SDF_SpaceYear"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2113571148134858782"}},"rest_id":"2121181293832479182","unmention_data":{},"views":{"count":"47127","state":"EnabledWithCount"}}},"rest_id":"2126254726723305516","unmention_data":{},"views":{"count":"17392","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126254726723305516","sortIndex":"2126390288539713512"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":