humb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/P685fEG9Gq"}]},"favorite_count":522,"favorited":false,"full_text":"令和８年１１月２７日（金）午前から午後にかけて、推定中国無人機×１機（推定）が東シナ海から飛来し、与那国島と台湾との間を通過し、太平洋に至ったことを確認した。 https://t.co/P685fEG9Gq","id_str":"2126305036846219752","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":12,"retweet_count":181,"retweeted":false,"user_id_str":"864751444586397696"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYzMDUwMzY4MDAwMDQwOTc=","text":"令和８年１１月２７日（金）午前から午後にかけて、推定中国無人機×１機（推定）が東シナ海から飛来し、与那国島と台湾との間を通過し、太平洋に至ったことを確認した。\n また、同日午後、推定中国無人機×１機（推定）が東シナ海から飛来し、与那国島と台湾との間を通過した後、太平洋上で旋回し、再び与那国島と台湾の間を通過し、東シナ海に至ったことを確認したほか、推定中国無人機×１機（推定）が太平洋から飛来し、与那国島と台湾の間を通過し、東シナ海に至ったことを確認した。\nこれに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"rest_id":"2126305036846219752","unmention_data":{},"views":{"count":"24523","state":"EnabledWithCount"}}},"rest_id":"2126305851124453452","unmention_data":{},"views":{"count":"20673","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126305851124453452","sortIndex":"2126390288539713534"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2126390288539713539-tweet-2126240910082253290","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"ht