},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/hjnsqiqUDo"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/hjnsqiqUDo","expanded_url":"https://x.com/takaichi_sanae/status/2126277779637608711/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":153,"w":153,"x":677,"y":425},{"h":205,"w":205,"x":661,"y":159},{"h":207,"w":207,"x":1181,"y":375}]},"medium":{"faces":[{"h":90,"w":90,"x":396,"y":249},{"h":120,"w":120,"x":387,"y":93},{"h":121,"w":121,"x":692,"y":220}]},"orig":{"faces":[{"h":195,"w":195,"x":860,"y":540},{"h":261,"w":261,"x":840,"y":203},{"h":264,"w":264,"x":1500,"y":477}]},"small":{"faces":[{"h":51,"w":51,"x":224,"y":141},{"h":68,"w":68,"x":219,"y":53},{"h":69,"w":69,"x":392,"y":124}]}},"id_str":"2126277754215960576","indices":[134,157],"media_key":"3_2126277754215960576","media_results":{"result":{"media_key":"3_2126277754215960576"}},"media_url_https":"https://pbs.twimg.com/media/HYIOWhnbkAAuRL_.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1950,"w":1950,"x":0,"y":0},{"h":1950,"w":1711,"x":120,"y":0},{"h":1950,"w":975,"x":488,"y":0},{"h":1950,"w":2600,"x":0,"y":0}],"height":1950,"width":2600},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/hjnsqiqUDo"}]},"favorite_count":4186,"favorited":false,"full_text":"今夜、『経済同友会創立80周年記念祝賀会』にお招きいただきました。\n\n「経済同友会」は、「力強い経済成長の継続」と「他者を思いやる共助の精神」の両輪による「共助成長社会」の実現を目指されています。\n\n昨日、「経済同友会」がこの実現に向けて公表された『成長戦略』では、 https://t.co/hjnsqiqUDo","id_str":"2126277779637608711","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":47,"reply_count":531,"retweet_count":403,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyNzc3Nzk1NjYzNTAzMzY=","richtext":{"richtext_tags":[]},"text":"今夜、『経済同友会創立80周年記念祝賀会』にお招きいただきました。\n\n「経済同友会」は、「力強い経済成長の継続」と「他者を思いやる共助の精神」の両輪による「共助成長社会」の実現を目指されています。\n\n昨日、「経済同友会」がこの実現に向けて公表された『成長戦略』では、\n・「共助成長社会」実現のため、経済成長は必須条件であること、\n・成長に向けての出発点は、企業自身の行動であること、\n・2040年の成長実現に向けて、経営者には、企業経営を「守りから攻め」へ転換し、「投資」、「賃上げ」、「新陳代謝」を積極的に進めることが求められること、\nなどが掲げられており、私も、このスタンスに、大いに共感します。\n\n高市内閣では、『日本成長戦略』と『地域未来戦略』を両輪に、「責任ある積極財政」の考え方の下、「国内投資」、「賃上げ」、「新陳代謝」を進めていきます。\n\n「国内投資」については、『日本成長戦略』の下での「設備投資支援」に加え、税制も大胆に見直し、「大胆な投資促進税制」を創設するとともに、AI、量子など戦略技術への研究開発を促進するため、「研究開発税制」を抜本的に強化しました。\n\n「賃上げ」については、中小企業・小規模事業者の「賃上げ環境整備」として、官公需を含む「価格転嫁・取引適正化」の更なる徹底、「成長志向の企業」や「生産性向上」への支援強化、M&A・事業承継等の「事業再編」の推進、「伴走支援体制」の強化などを進めていきます。\n\nさらに、「新陳代謝」については、税制措置や、「改訂コーポレートガバナンスコード」・「成長投資ガイダンス」の普及などにより、「経営資源の成長投資へのシフト」や、「事業ポートフォリオの転換」を促進していきます。\n\n経済界の皆様には、政府と連携しながら、「大胆な投資」と「賃上げ」、そして「新陳代謝」に積極的に取り組んでいただきますことを、期待申し上げております。"}}},"rest_id":"2126277779637608711","unmention_data":{},"views":{"count":"176058","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126277779637608711","sortIndex":"2126390288539713527"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_n