xt":"赤澤大臣は、11/25に「第4回日ASEANヤングリーダーズサミット」に出席。挨拶では、日本とASEANの若手リーダーから受けた、サプライチェーンのレジリエンス強化、エネルギー協力、災害リスク軽減・復興協力を柱とする提言を歓迎し、コールドチェーンの整備についての提言にも期待を述べました。また、AI分野での協力に大きな可能性があるとして、日本の強みとASEANの革新的なアイデアを掛け合わせ、ともに未来を創っていくことを呼び掛けました。#meti_daijin"}}},"rest_id":"2125898596352676065","unmention_data":{},"views":{"count":"9658","state":"EnabledWithCount"}}},"rest_id":"2126320191659503694","unmention_data":{},"views":{"count":"4534","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126320191659503694","sortIndex":"2126390288539713536"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":609},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1432867630298419206/Uez_q2Zx_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1312820383532294144/1679630740"},"core":{"created_at":"Sun Oct 04 18:22:33 +0000 2020","name":"デジタル庁","screen_name":"digital_jpn"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzEyODIwMzgzNTMyMjk0MTQ0","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"デジタル庁公式アカウントです。政策やサービスの新着情報を発信します。デジタル庁ウェブサイト: https://t.co/w7z4JlAihT |英語版X:@digital_jpn_en|ソーシャルメディア運用ポリシー: https://t.co/ukune2Dn5V","entities":{"description":{"urls":[{"display_url":"digital.go.jp","expanded_url":"https://w