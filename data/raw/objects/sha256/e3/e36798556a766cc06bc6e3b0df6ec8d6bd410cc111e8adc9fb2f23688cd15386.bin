aces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2126276395768905728","indices":[142,165],"media_key":"3_2126276395768905728","media_results":{"result":{"media_key":"3_2126276395768905728"}},"media_url_https":"https://pbs.twimg.com/media/HYINHdAagAAx2K9.jpg","original_info":{"focus_rects":[{"h":1564,"w":2793,"x":0,"y":0},{"h":2793,"w":2793,"x":0,"y":0},{"h":3024,"w":2653,"x":108,"y":0},{"h":3024,"w":1512,"x":678,"y":0},{"h":3024,"w":2793,"x":0,"y":0}],"height":3024,"width":2793},"sizes":{"large":{"h":2048,"resize":"fit","w":1892},"medium":{"h":1200,"resize":"fit","w":1108},"small":{"h":680,"resize":"fit","w":628},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/5enEOOVFMu"}]},"favorite_count":27,"favorited":false,"full_text":"髙木副大臣は、モンゴル国ウランバートルで開催された第13回日本・モンゴル官民合同協議会に出席。モンゴルにおける予見可能性の高いビジネス環境の整備や新ウランバートル国際空港拡張事業に係るモンゴル政府の対応への期待を述べるとともに、両国の強みを活かせる分野について議論を深めていくこと、 https://t.co/5enEOOVFMu","id_str":"2126276532234846360","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":6,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyNzY1MzIxNzYwNDQwMzI=","richtext":{"richtext_tags":[]},"text":"髙木副大臣は、モンゴル国ウランバートルで開催された第13回日本・モンゴル官民合同協議会に出席。モンゴルにおける予見可能性の高いビジネス環境の整備や新ウランバートル国際空港拡張事業に係るモンゴル政府の対応への期待を述べるとともに、両国の強みを活かせる分野について議論を深めていくこと、また両国の未来を担う人材育成を進め、両国の利益に繋がる協力を進めていくことを述べました。また、協議会に併せ、エンフバヤル第一副首相兼経済・開発大臣と会談。モンゴルとの経済関係強化に資する日本の取組みに言及し、引き続き民間企業や人材の交流を促進したい旨を述べました。"}}},"rest_id":"2126276532234846360","unmention_data":{},"views":{"count":"4313","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126276532234846360","sortIndex":"2126390288539713524"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDe