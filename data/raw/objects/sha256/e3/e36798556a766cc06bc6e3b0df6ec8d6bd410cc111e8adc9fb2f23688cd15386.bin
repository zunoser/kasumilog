.twimg.com/amplify_video/2126178723267497984/vid/avc1/1280x720/-L186Of8CJ1pkW4A.mp4?tag=29"}]}}]},"favorite_count":1110,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２７日）、高市総理は、中央防災会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　委員の皆様におかれましては、ご多用の中、「中央防災会議」にお集まりいただき、ありがとうございます。 https://t.co/nkB6csu6J7","id_str":"2126179101556064350","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":39,"retweet_count":135,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYxNzkxMDE0ODA0OTMwNTY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２７日）、高市総理は、中央防災会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　委員の皆様におかれましては、ご多用の中、「中央防災会議」にお集まりいただき、ありがとうございます。\n　本年も、令和８年熊本地震をはじめ、その後も相次ぐ豪雨・大雨、また台風などですね、多くの災害が発生いたしました。\n　そして、激甚化・頻発化する自然災害への対応というのは喫緊の課題になっております。\n　今月２日、防災庁が発足しました。\n　事前防災など平時の備えから、発災時の初動対応、避難所の設置・物資供給、復旧・復興まで、防災庁を「災害対応の司令塔」として、防災行政を抜本的に強化していかなければなりません。\n　本日は、\n・国難級の大規模災害に対し、国が前面に立って国民の生命を守り抜くこと\n・防災を基軸とした社会に我が国を変えていくこと\nを基本的な考え方とする『国家戦略』を新たに『防災基本計画』に掲げることを決定しました。\n　また、防災政策に関する事項の調査を行う基本政策調査会の設置や、より実践的な訓練を機動的に実施するための総合防災訓練大綱の見直しも決定しました。\n　各大臣は、新たな『防災基本計画』の下、細野大臣を中心に緊密に連携し、平時からの事前防災の推進と災害対応力の更なる強化に全力で取り組んでください。\n　細野大臣は、府省庁の縦割り、対策の遅れを見逃さず、「強い司令塔」として、各府省庁を動かしてください。\n　また、指定公共機関、学識経験者の皆様におかれましても、専門的なお立場からの一層のご協力をお願い申し上げます。\n　本格的な冬の季節を迎え、雪による災害も懸念される時期になりました。高い緊張感をもって、災害への備えに万全を期してまいりましょう。\n　本日は誠にありがとうございました。"}}},"rest_id":"2126179101556064350","unmention_data":{},"views":{"count":"37425","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126179101556064350","sortIndex":"2126390288539713451"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2126390288539713622-tweet-2126176976293757252","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1774478,"following":48},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8438,"tweets":23635},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2126176976293757252"],"editable_until_msecs":"1795758668000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":9,"bookmarked":false,"conversation_id_str":"2126176976293757252","created_at":"Fri Nov 27 04:51:08 +0000 2026","display_text_range":[0,100],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/WwjAP5T69p","expanded_url":"https://x.com/kantei/status/2126176976293757252/video/1","ext_media_availability":{"status":"Available"},"id_str":"2126176230072594432","indices":[101,124],"media_key":"13_2126176230072594432","media_results":{"result":{"media_key":"13_2126176230072594432"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2126176230072594432/img/6prHLMwXQVX8mZ6D.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/WwjAP5T69p","video_info":{"aspect_ratio":[16,9],"duration_millis":272700,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2126176230072594432/pl/ybHLPTrA2F09DtoK.m3u8?tag=29&v=f29"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126176230072594432/vid/avc1/480x270/QT3bd0uzwjz1hHiX.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126176230072594432/vid/avc1/640x360/7EjYw1FLui7pLVR1.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126176230072594432/vid/avc1/1280x720/zhxH3zSOO7T1K2xH.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/WwjAP5T69p","expanded_url":"https://x.com/kantei/status/2126176976293757252/video/1","ext_media_availability":{"status":"Available"},"id_str":"2126176230072594432","indices":[101,124],"media_key":"13_2126176230072594432","media_results":{"result":{"media_key":"13_2126176230072594432"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2126176230072594432/img/6prHLMwXQVX8mZ6D.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/WwjAP5T69p","video_info":{"aspect_ratio":[16,9],"duration_millis":272700,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2126176230072594432/pl/ybHLPTrA2F09DtoK.m3u8?tag=29&v=f29"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126176230072594432/vid/avc1/480x270/QT3bd0uzwjz1hHiX.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126176230072594432/vid/avc1/640x360/7EjYw1FLui7pLVR1.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126176230072594432/vid/avc1/1280x720/zhxH3zSOO7T1K2xH.mp4?tag=29"}]}}]},"favorite_count":494,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２７日）、木原官房長官は、クマ被害対策等に関する関係閣僚会議を開催しました。\n\n※木原官房長官発言要旨（速報版）\n　本年４月から６月のクマの出没情報ですが、１万２千件を超え、 https://t.co/WwjAP5T69p","id_str":"2126176976293757252","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":34,"retweet_count":83,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYxNzY5NzYxODQ2OTI3MzY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２７日）、木原官房長官は、クマ被害対策等に関する関係閣僚会議を開催しました。\n\n※木原官房長官発言要旨（速報版）\n　本年４月から６月のクマの出没情報ですが、１万２千件を超え、 昨年の同時期に比べて倍増いたしましたが、その後は、比較的落ち着いて推移をしております。直近の９月の出没状況ですが、昨年と比べると、西日本は２倍程度ですが、出没の多い東日本は４分の１程度となり、全国的にみると、近年、おおむね２年に１度繰り返されます、いわゆる「平常年」の様相を示しております。\n　この背景には、クマのエサであるどんぐり等の豊凶、豊作であったり、凶作であったり、そういったことが近年、隔年で変動している影響というのが知られていますが、それに加えて、９月末までの捕獲数が「平常年」としては過去最多となるなど、「パッケージ」や「ロードマップ」、そういった、昨年来、私共が矢継ぎ早に講じてきた取組の成果が現れ始めております。\n　しかしながら、依然として人身被害や死亡事故が発生し、また、近年のクマの出没地域の拡大に伴い、観光施設の閉鎖や イベントの中止、訪日外国人旅行者を含む観光客への被害など、地域経済や観光への影響も顕在化しております。\n　さらに、秋田県において、すでに来年秋のどんぐりの凶作が予報されるなど、来年は、令和７年同様「大量出没年」となる可能性が示唆されております。\n　このような認識のもとで、クマ被害対策に一層万全を期すべき、との高市総理の指示を受けて、本日、関係閣僚会議を開催することとなったわけであります。なお、開催にあたっては、被害にあわれた方の治療や社会復帰支援など、医療的対応を強化するという観点から、 厚生労働大臣を、新たに構成員として加えることといたしました。\n　まず、クマ被害対策担当笹川大臣におかれては、①春期の管理捕獲の強化、②所在者不明の果樹の伐採の推進、③関東、北陸地方における統一的手法による個体数調査の実施、④捕獲者の育成や補償の充実など、専門人材の確保、⑤ＩＣＴやドローンなど新技術の開発及び導入促進、に向けて、必要な予算の確保を含め、計画的に取り組んでください。\n　葉梨国家公安委員会委員長におかれては、市街地等における警察によるライフル銃を使用したクマ駆除の体制の確保に向けた取組を進めてください。\n　青山文部科学副大臣におかれては、スクールバス等の運行支援を含む通学路の安全確保により、児童生徒が安心して通える学校づくりのための取組を進めてください。\n　井林国土交通大臣におかれては、都道府県等と連携し、河川の樹木伐採や草木の踏み倒し、観光地における旅行者の安全対策を強化してください。\n　武部農林水産大臣におかれては、農作物被害対策の加速化や、緩衝林帯の整備に取り組んでください。\n　上野厚生労働大臣におかれては、クマ外傷に関する医学的知見を収集し、医療現場で活用できるよう取組を進めてください。\n　こうした取組に加え、笹川担当大臣におかれては、クマ被害対策の司令塔として、関係閣僚と連携し、来年以降の大量出没の可能性も見据えながら、ロードマップの改訂に着手してください。\n　最後に、国民の皆様におかれましては、今年度の死亡事例の多くが山中、山の中で発生していることを踏まえ、クマ生息地への不要不急の立ち入りを控えていただくこと、やむを得ず立ち入る場合には、あらかじめ、自治体が発信する出没情報や注意事項を確認していただくように改めてお願いをいたします。\n　後方のモニターに、本日公開された広報動画を表示しております。政府としても、様々な媒体を通じて、国民の皆様に確かな情報発信を行ってまいります。\n　政府としては、引き続き、国民の皆様の安全・安心の確保を最優先とし、危機感と緊張感を持って、クマ被害対策を戦略的かつ計画的に実行してまいります。以上です。"}}},"rest_id":"2126176976293757252","unmention_data":{},"views":{"count":"36117","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2126390288539713622-tweet-2126177297401250254","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2126154920122535936/_my2hV9p?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66298","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2126154920122535936/_my2hV9p?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"全国で相次ぐクマの出没。その対策の現場で新たに注目を集める存在「ガバメントハンター」に密着。国民の皆様に気を付けてほしい内容や、最新...","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2126154920122535936/_my2hV9p?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2126154920122535936/_my2hV9p?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":720,"url":"https://pbs.twimg.com/card_img/2126154920122535936/_my2hV9p?format=jpg&name=orig","width":1280},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"10228272","path":[]}}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img