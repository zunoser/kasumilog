ttps":"https://pbs.twimg.com/media/HYHaifGaMAAXLzU.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":247},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1582,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/x2DIJzE55x"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/x2DIJzE55x","expanded_url":"https://x.com/takaichi_sanae/status/2126220832762675433/photo/2","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":143,"w":143,"x":1409,"y":147},{"h":233,"w":233,"x":407,"y":321}]},"medium":{"faces":[{"h":84,"w":84,"x":826,"y":86},{"h":137,"w":137,"x":238,"y":188}]},"orig":{"faces":[{"h":182,"w":182,"x":1790,"y":187},{"h":297,"w":297,"x":517,"y":408}]},"small":{"faces":[{"h":47,"w":47,"x":468,"y":48},{"h":77,"w":77,"x":135,"y":106}]}},"id_str":"2126220785060876288","indices":[109,132],"media_key":"3_2126220785060876288","media_results":{"result":{"media_key":"3_2126220785060876288"}},"media_url_https":"https://pbs.twimg.com/media/HYHaie-bEAAR5_s.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":282,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/x2DIJzE55x"}]},"favorite_count":4395,"favorited":false,"full_text":"今朝、第29回「規制改革推進会議」を開催し、小宮議長、中司大臣の下、新しい体制の下での議論を開始しました。\n\n他国に負けないスピードで経済成長に資する「国内投資」を実現するために、「規制・制度改革」は非常に重要です。 https://t.co/x2DIJzE55x","id_str":"2126220832762675433","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":32,"reply_count":314,"retweet_count":495,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyMjA4MzI2OTE0Mzc1Njg=","richtext":{"richtext_tags":[]},"text":"今朝、第29回「規制改革推進会議」を開催し、小宮議長、中司大臣の下、新しい体制の下での議論を開始しました。\n\n他国に負けないスピードで経済成長に資する「国内投資」を実現するために、「規制・制度改革」は非常に重要です。\n\n「規制改革推進会議」の委員の皆様には、「企業が挑戦できる環境の整備」に力点を置き、『日本成長戦略』の具体化に資する事項を優先的に議論していただきます。\n\n委員の皆様に議論を行っていただくにあたり、今後重点的に検討していくべき課題に合わせ、ワーキング・グループも改めて設置されました。\n\n①AI時代における個別の「規制・制度改革」のあり方について、AI・デジタル推進ワーキング・グループにおいて議論するとともに、\n②自動運転・モビリティサブワーキング・グループを新設し、自動運転やドローンなど技術革新の動向を先取りし、地域活性化につなげる議論をしていただきます。\n\nこのうち、『日本成長戦略』の戦略分野に資する「規制・制度改革」事項については、年末までに策定する『日本成長戦略実行計画』にも反映していきます。\n\n委員の皆様に、その他の項目についても、新たなワーキング・グループの下で、検討を加速させ、来年夏に策定予定の『規制改革実施計画』に向けて、答申を取りまとめていただくよう、お願いを申し上げました。\n\n「規制・制度改革」を機動的に進めていくためのツールとして、期間・対象者限定で実証の特例を認める「規制のサンドボックス制度」や、事業者単位で特例を創設する「新事業特例制度」などがあります。\n\n高市内閣では、これらの制度が積極的かつ効果的に活用されるための方策を、年末までに整理していきます。"}}},"rest_id":"2126220832762675433","unmention_data":{},"views":{"count":"168797","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126220832762675433","sortIndex":"2126390288539713480"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":33},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2011671787697029123/GbiAhFPe_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.