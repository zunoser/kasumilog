a/HYIN7_JbIAAHDSG.jpg","original_info":{"focus_rects":[{"h":488,"w":872,"x":0,"y":0},{"h":872,"w":872,"x":0,"y":0},{"h":994,"w":872,"x":0,"y":0},{"h":1048,"w":524,"x":340,"y":0},{"h":1048,"w":872,"x":0,"y":0}],"height":1048,"width":872},"sizes":{"large":{"h":1048,"resize":"fit","w":872},"medium":{"h":1048,"resize":"fit","w":872},"small":{"h":680,"resize":"fit","w":566},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/BwhQrNqFAZ"}]},"favorite_count":18,"favorited":false,"full_text":"髙木副大臣は、11/26にオーストラリア連邦西オーストラリア州のクック（Hon. Roger Cook https://t.co/BwhQrNqFAZ","id_str":"2126277348731572577","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":5,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyNzczNDg2ODEyMjgyODg=","richtext":{"richtext_tags":[]},"text":"髙木副大臣は、11/26にオーストラリア連邦西オーストラリア州のクック（Hon. Roger Cook MLA）首相と会談。日本と西オーストラリア州のエネルギー、重要鉱物等の投資促進等に関する協力覚書（MOC）に署名するとともに、資源・エネルギー分野を中心に、二国間経済関係の更なる発展に向けた議論を行いました。"}}},"rest_id":"2126277348731572577","unmention_data":{},"views":{"count":"4100","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126277348731572577","sortIndex":"2126390288539713526"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3088160,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":662,"tweets":1997},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2126276808148689183"],"editable_until_msecs":"1795782470000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":760,"bookmarked":false,"conversation_id_str":"2126276808148689183","created_at":"Fri Nov 27 11:27:50 +0000 2026","display_text_range":[0,135],"entities":{},"favorite_count":29454,"favorited":false,"full_text":"先日のAPEC首脳会議出席に関して、政府専用機の中国・深圳の空港への到着時刻を早めるよう私が指示したといった事実無根の報道がなされており、外務報道官から反論の投稿をしております。\n\n政府専用機の定時運航に尽力している自衛隊の名誉にも関わるため、私からリポストいたします。","id_str":"2126276808148689183","is_quote_status":true,"lang":"ja","quote_count":570,"quoted_status_id_str":"2125895814354714727","quoted_status_permalink":{"display":"x.com/PressSec_MofaJ…","expanded":"https://twitter.com/PressSec_MofaJP/status/2125895814354714727","url":"https://t.co/oWzwVLmKqw"},"reply_count":1381,"retweet_count":5098,"retweeted":false,"user_id_str":"218434058"},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":657},"affiliates_highlighted_label":{"label":{"badge":{"url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_bigger.jpg"},"description":"外務省","url":{"url":"https://twitter.com/MofaJapan_jp","urlType":"DeepLink"},"userLabelDisplayType":"Badge","userLabelType":"BusinessLabel"}},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1808800206970105856/Z9eRUo3p_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1739931763760312321/1791191324"},"core":{"created_at":"Wed Dec 27 08:51:06 +0000 2023","name":"北村 俊博　KITAMURA TOSHIHIRO","screen_name":"PressSec_MofaJP"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNzM5OTMxNzYzNzYwMzEyMzIx","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"Official account of Press Secretary/DG for Press and Public Diplomacy at the Ministry of Foreign Affairs(MOFA) of Japan.  外務報道官|Reposts are not endorsements.","entities":{"description":{},"url":{"urls":[{"display_url":"mofa.go.jp/index.html","expanded_url":"https://www.mofa.go.jp/index.html","indices":[0,23],"url":"https://t.co/hh0GWgk0Ng"}]}}},"profile_description_language":"en","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3959,"following":425},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1739931763760312321","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":92,"tweets":7189},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/hh0GWgk0Ng"}}}},"edit_control":{"edit_tweet_ids":["2125895814354714727"],"editable_until_msecs":"1795691634000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":227,"bookmarked":false,"conversation_id_str":"2125895814354714727","created_at":"Thu Nov 26 10:13:54 +0000 2026","display_text_range":[0,76],"entities":{},"favorite_count":6545,"favorited":false,"full_text":"高市総理のＡＰＥＣ首脳会議出席に際して、政府専用機の到着を早めて深圳の空港で他国首脳との接点を設けるとの指示や調整があったとの一部報道がなされています。","id_str":"2125895814354714727","is_quote_status":false,"lang":"ja","quote_count":113,"reply_count":195,"retweet_count":1273,"retweeted":false,"user_id_str":"1739931763760312321"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjU4OTU4MTQzMTI4NDk0MDg=","richtext":{"richtext_tags":[]},"text":"高市総理のＡＰＥＣ首脳会議出席に際して、政府専用機の到着を早めて深圳の空港で他国首脳との接点を設けるとの指示や調整があったとの一部報道がなされています。\nしかし、たとえば政府専用機は、高市総理の指示により予定より１時間早く深圳に到着したとの事実はなく、予定どおり到着しているなど、その報道の内容は全く事実に基づくものではありません。"}}},"rest_id":"2125895814354714727","unmention_data":{},"views":{"count":"1596093","state":"EnabledWithCount"}}},"rest_id