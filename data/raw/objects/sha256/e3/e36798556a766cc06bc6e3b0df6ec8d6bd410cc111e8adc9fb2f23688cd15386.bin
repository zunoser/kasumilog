id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[291,296],"text":"宇宙安保"},{"indices":[298,312],"text":"SDF_SpaceYear"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"x.com/JASDF_PAO/stat…","expanded_url":"https://x.com/JASDF_PAO/status/2126224572639023199?s=20","indices":[320,343],"url":"https://t.co/v0BecGZldR"},{"display_url":"mod.go.jp/asdf/report/20…","expanded_url":"https://www.mod.go.jp/asdf/report/20261127-1j.pdf","indices":[354,377],"url":"https://t.co/4C2I1DAn6P"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyNTQ3MjY2MTAxMzcwODg=","text":"【🛰防衛×宇宙🚀シリーズ㉞】\n第34弾は「地球の裏側との連携」\n \n11月23日、航空自衛隊とイタリア空軍は、「日伊宇宙状況把握及び宇宙領域把握に係る協力に関する技術取決め」を署名しました📜\n宇宙空間での脅威やリスクに一国で対応するには、宇宙はあまりに広大...\nこのため、他国との連携は不可欠です！\n \nこの取決めにより、イタリア空軍との間で宇宙関連情報の共有、専門家間の定期的な協議、訓練及び人的交流など実務的な協力を推進しつつ、双方の運用能力及び相互運用性の向上を図ります。\n防衛省・自衛隊は、宇宙空間の安定的利用を確保するため、同盟国・同志国との連携を強化していきます💪\n\n#宇宙安保 \n#SDF_SpaceYear\n\n☟空自Ｘ\n https://t.co/v0BecGZldR\n\n☟\n空自お知らせ\nhttps://t.co/4C2I1DAn6P"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2126245783813128254"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活