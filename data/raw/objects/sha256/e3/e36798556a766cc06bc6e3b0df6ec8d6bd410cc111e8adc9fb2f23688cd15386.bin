05846204469248"}},"media_url_https":"https://pbs.twimg.com/media/HYIn5sbakAAeAV4.jpg","original_info":{"focus_rects":[{"h":379,"w":676,"x":0,"y":136},{"h":515,"w":515,"x":161,"y":0},{"h":515,"w":452,"x":224,"y":0},{"h":515,"w":258,"x":394,"y":0},{"h":515,"w":676,"x":0,"y":0}],"height":515,"width":676},"sizes":{"large":{"h":515,"resize":"fit","w":676},"medium":{"h":515,"resize":"fit","w":676},"small":{"h":515,"resize":"fit","w":676},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mONdKPuqR0"}]},"favorite_count":360,"favorited":false,"full_text":"令和８年１１月２７日（金）午前から午後にかけて、推定中国無人機×１機（推定）が東シナ海から飛来し、与那国島と台湾との間を通過し、太平洋に至ったことを確認した。 https://t.co/mONdKPuqR0","id_str":"2126305851124453452","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"quoted_status_id_str":"2126305036846219752","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2126305036846219752","url":"https://t.co/A4sNwC5PT4"},"reply_count":8,"retweet_count":112,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYzMDU4NTEwNzQxMjE3Mjk=","text":"令和８年１１月２７日（金）午前から午後にかけて、推定中国無人機×１機（推定）が東シナ海から飛来し、与那国島と台湾との間を通過し、太平洋に至ったことを確認した。\n また、同日午後、推定中国無人機×１機（推定）が東シナ海から飛来し、与那国島と台湾との間を通過した後、太平洋上で旋回し、再び与那国島と台湾の間を通過し、東シナ海に至ったことを確認したほか、推定中国無人機×１機（推定）が太平洋から飛来し、与那国島と台湾の間を通過し、東シナ海に至ったことを確認した。\nこれに対し、航空自衛隊の南西航空方面隊の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3294},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":362839,"following":32},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6475,"tweets":12528},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2126305036846219752"],"editable_until_msecs":"1795789200000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":14,"bookmarked":false,"conversation_id_str":"2126305036846219752","created_at":"Fri Nov 27 13:20:00 +0000 2026","display_text_range":[0,79],"entities":{"media":[{"display_url":"pic.x.com/P685fEG9Gq","expanded_url