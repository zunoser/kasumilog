t_media_availability":{"status":"Available"},"id_str":"2126286112893382656","indices":[102,125],"media_key":"13_2126286112893382656","media_results":{"result":{"media_key":"13_2126286112893382656"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2126286112893382656/img/DrxS8cvjSD4RuJcZ.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/eZ6kGYpegY","video_info":{"aspect_ratio":[16,9],"duration_millis":169366,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2126286112893382656/pl/oqsUuTbl5yeM14qD.m3u8?tag=29&v=98a"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126286112893382656/vid/avc1/480x270/AbfeXQRUbsvg1_GJ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126286112893382656/vid/avc1/640x360/PTn1n94CFx189bdS.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126286112893382656/vid/avc1/1280x720/V5nxwE7-3Iab6wPF.mp4?tag=29"}]}}]},"favorite_count":686,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２７日）、高市総理は、全国都道府県知事会議に出席しました。\n\n※高市総理発言要旨（速報版）\n　こんばんは。本日は御多用のところ、全国からお越しいただき誠にありがとうございます。 https://t.co/eZ6kGYpegY","id_str":"2126286614129463542","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":32,"retweet_count":100,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyODY2MTQwMzI5NDkyNDk=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２７日）、高市総理は、全国都道府県知事会議に出席しました。\n\n※高市総理発言要旨（速報版）\n　こんばんは。本日は御多用のところ、全国からお越しいただき誠にありがとうございます。\n　各府県のリーダーとして御尽力されている皆様に、改めて敬意を表しますとともに、こうやって御意見を伺う機会を頂き、大変ありがたく思っております。\n　高市内閣では、「強い経済」の実現に向けた政策を加速させ、「日本列島を強く、豊かに」してまいります。\n　日本の大きな伸び代は、地方にあります。\n　『地域未来戦略』に関して、知事の皆様にも積極的に取り組んでいただき、おかげさまで合計１５０を超える計画が策定・公表されています。\n　年末までに、インフラ整備や投資支援などの措置を上乗せすることも含めて、今後５年間の支援方針を明らかにした「地域未来戦略実現フレーム」を策定いたします。\n　市町村支援を含め、更に取組を進めていただき、日本列島の隅々まで「産業クラスターの花」を咲かせてまいりましょう。\n　また、高市内閣は物価高対策、最優先で取り組んでおります。『消費税・支援金法案』を国会に提出しております。\n　また、切れ目のない物価高対策を講じるという観点から、電気・ガス代について、負担軽減策を実施することといたしました。\n　標準的なご家庭では、１２月から２月までの３か月間で、電気・ガス代あわせて、７，０００円程度の負担引下げ効果を実現することができます。\n　前回は1月からの支援でしたけれども、寒さが本格化する１２月に前倒しして支援を開始することといたしました。\n　そして、電気・ガス料金支援の対象とならない特別高圧電力やＬＰガスの利用者、また冬の時期に寒冷地で需要が見込まれます灯油利用者への支援につきましては、「重点支援地方交付金」により対応することといたしました。\n　知事の皆様におかれましては、「重点支援地方交付金」の交付が決定されましたら、迅速にご対応をいただきますようお願い申し上げます。\n　これからも、強い地域経済構築のために、知事の皆様と連携して、取り組んでまいりますので、ご理解とご協力賜りますようお願い申し上げます。\n　本日はありがとうございます。"}}},"rest_id":"2126286614129463542","unmention_data":{},"views":{"count":"30763","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126286614129463542","sortIndex":"2126390288539713531"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"V