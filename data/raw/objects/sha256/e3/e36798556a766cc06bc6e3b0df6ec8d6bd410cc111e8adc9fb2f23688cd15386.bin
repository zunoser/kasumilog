26","display_text_range":[0,121],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/m4Rt1HtIPc","expanded_url":"https://x.com/kantei/status/2126175041528459734/video/1","ext_media_availability":{"status":"Available"},"id_str":"2126174447459799040","indices":[122,145],"media_key":"13_2126174447459799040","media_results":{"result":{"media_key":"13_2126174447459799040"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2126174447459799040/img/irCwP_-hqRrpAtP_.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/m4Rt1HtIPc","video_info":{"aspect_ratio":[16,9],"duration_millis":192200,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2126174447459799040/pl/xaXGzLaRSCe3GU4U.m3u8?tag=29&v=107"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126174447459799040/vid/avc1/480x270/gexwQbzGdRhtVdd3.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126174447459799040/vid/avc1/640x360/F8a6hB_ZCHtpjTxB.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126174447459799040/vid/avc1/1280x720/XzGLpgDCbR-IbHiV.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/m4Rt1HtIPc","expanded_url":"https://x.com/kantei/status/2126175041528459734/video/1","ext_media_availability":{"status":"Available"},"id_str":"2126174447459799040","indices":[122,145],"media_key":"13_2126174447459799040","media_results":{"result":{"media_key":"13_2126174447459799040"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2126174447459799040/img/irCwP_-hqRrpAtP_.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/m4Rt1HtIPc","video_info":{"aspect_ratio":[16,9],"duration_millis":192200,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2126174447459799040/pl/xaXGzLaRSCe3GU4U.m3u8?tag=29&v=107"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126174447459799040/vid/avc1/480x270/gexwQbzGdRhtVdd3.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126174447459799040/vid/avc1/640x360/F8a6hB_ZCHtpjTxB.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126174447459799040/vid/avc1/1280x720/XzGLpgDCbR-IbHiV.mp4?tag=29"}]}}]},"favorite_count":1584,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２７日）、高市総理は、規制改革推進会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　委員の皆様、ありがとうございます。本日から、小宮議長、中司大臣の下、新しい体制で規制改革推進会議での議論を開始してまいります。 https://t.co/m4Rt1HtIPc","id_str":"2126175041528459734","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"reply_count":66,"retweet_count":226,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYxNzUwNDE0MzE5NjE2MDA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２７日）、高市総理は、規制改革推進会議を開催しました。\n\n※高市総理発言要旨（速報版）\n　委員の皆様、ありがとうございます。本日から、小宮議長、中司大臣の下、新しい体制で規制改革推進会議での議論を開始してまいります。\n　他国に負けないスピードで経済成長に資する「国内投資」を実現するために、「規制・制度改革」は非常に重要でございます。\n　「規制改革推進会議」の委員の皆様には、企業が挑戦できる環境の整備に力点を置いて、『日本成長戦略』の具体化に資する事項を優先的に議論していただきますようお願いをいたします。\n　議論を行っていただくにあたり、今後重点的に検討していくべき課題に合わせて、ワーキング・グループも改めて設置されました。ＡＩ時代における個別の「規制・制度改革」のあり方について、ＡＩ・デジタル推進ワーキング・グループにおいて議論していただくとともに、自動運転・モビリティサブワーキング・グループを新設し、自動運転やドローンなど、技術革新の動向を先取りして、地域活性化につなげる議論をしていただきます。\n　中司大臣は、このうち、『日本成長戦略』の戦略分野に資する「規制・制度改革」事項につきましては、年末までに策定する『日本成長戦略実行計画』にも反映をしてください。\n　その他の項目につきましても、新たなワーキング・グループの下で、検討を加速させて、来年夏に策定予定の『規制改革実施計画』に向けて、答申をお取りまとめいただきますようお願いいたします。\n　特に、「医療分野におけるＡＩの活用範囲の明確化」については、ＡＩ時代にあったスピード感で実現を目指し、例えばがん検診の画像読影を「医師２名」から「医師１名」に見直すことについても検討を加速し、結論を可及的速やかに出してください。\n　加えて、「規制・制度改革」を機動的に進めていくためのツールとして、期間・対象者限定で実証の特例を認める「規制のサンドボックス制度」ですとか、事業者単位で特例を創設する「新事業特例制度」などがございます。\n　中司大臣においては、これらの制度が積極的かつ効果的に活用されるための方策を関係大臣とも連携して、年末までに整理をしてください。\n　委員の皆様におかれましては、「日本成長戦略本部」や「ＡＩ・デジタル改革推進会議」、また「国家戦略特別区域諮問会議」とも連携していただきながら、民間投資を引き出す基礎となる「規制・制度改革」の議論を進めていただきますよう、お願いをいたします。\n　今日はありがとうございました。"}}},"rest_id":"2126175041528459734","unmention_data":{},"views":{"count":"39909","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126175041528459734","sortIndex":"2126390288539713448"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":