_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[209,226],"text":"日本の食輸出１万者支援プログラム"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"meti.go.jp/press/2026/11/…","expanded_url":"https://www.meti.go.jp/press/2026/11/20261127007.html","indices":[315,338],"url":"https://t.co/H0LRTt1M4o"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYzMjAxOTE1MDAwNzUwMDg=","richtext":{"richtext_tags":[]},"text":"経済産業省はJETRO等と連携し、11/25（水）～11/27（金）に日ASEANヤングビジネスリーダーズサミット2026を開催。\n第4回となる今回は、サプライチェーンレジリエンスの強化やエネルギー安全保障、災害・復興協力をテーマに、日ASEAN協力の具体的な議論が実施されました。\nまた、宮本副大臣が本日、石川県金沢市にて開催された、リーダーズと石川県の産業界とのネットワーク構築に向けたオフィシャルディナーに出席。#日本の食輸出１万者支援プログラム の一環として、北陸地域からASEANへの展開を目指す食品関係事業者やノングルテン米粉の製造事業者等とともに、日本の農林水産物・食品の魅力のPRを行いました。\n\n👇詳細はこちら\nhttps://t.co/H0LRTt1M4o"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1907032035689996327"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com