"video/mp4","url":"https://video.twimg.com/amplify_video/2126287849486225408/vid/avc1/1280x720/Ls_mEr284BU_Gpbt.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/tVdE48qOep","expanded_url":"https://x.com/kantei/status/2126288611788382365/video/1","ext_media_availability":{"status":"Available"},"id_str":"2126287849486225408","indices":[101,124],"media_key":"13_2126287849486225408","media_results":{"result":{"media_key":"13_2126287849486225408"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2126287849486225408/img/lWnw9U1cSuPev8ex.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/tVdE48qOep","video_info":{"aspect_ratio":[16,9],"duration_millis":229700,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2126287849486225408/pl/wHqd0Gv6i6RHwG1L.m3u8?tag=29&v=6c1"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126287849486225408/vid/avc1/480x270/jS3U4dUfL5OQtGzi.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126287849486225408/vid/avc1/640x360/klyZ3blI6Lg8Znhf.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126287849486225408/vid/avc1/1280x720/Ls_mEr284BU_Gpbt.mp4?tag=29"}]}}]},"favorite_count":559,"favorited":false,"full_text":"【お知らせ】\n本日（１１月２７日）、高市総理は、経済同友会創立８０周年祝賀会に出席しました。\n\n※高市総理発言要旨（速報版）\n　今夜は経済同友会ご創立８０周年ということで、心よりお慶びを申し上げます。 https://t.co/tVdE48qOep","id_str":"2126288611788382365","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":57,"retweet_count":74,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyODg2MTE3MDAzNDI3ODQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月２７日）、高市総理は、経済同友会創立８０周年祝賀会に出席しました。\n\n※高市総理発言要旨（速報版）\n　今夜は経済同友会ご創立８０周年ということで、心よりお慶びを申し上げます。\n　経済同友会は、「力強い経済成長の継続」と「他者を思いやる共助の精神」の両輪により「共助成長社会」の実現を目指されていると承知をしております。\n　昨日、経済同友会は、この実現に向けた『成長戦略』を発表されました。\n　その『戦略』では、「共助成長社会」実現のために、経済成長は必須条件であるということ、それから成長に向けての出発点は、企業自身の行動であること、そして、２０４０年の成長実現に向けて、経営者には、企業経営を「守りから攻め」へと転換し、「投資」「賃上げ」「新陳代謝」を積極的に進めることが求められる。こういったことが挙げられており、私も、このスタンスに、大いに共感いたしております。\n　高市内閣では、『日本成長戦略』と『地域未来戦略』を両輪に、「責任ある積極財政」の考え方の下、　「国内投資」「賃上げ」「新陳代謝」を進めてまいります。\n　「国内投資」につきましては、『日本成長戦略』の下での「設備投資支援」に加えて、税制も大胆に見直し、「大胆な投資促進税制」を創設するとともに、ＡＩ、量子など戦略技術への研究開発を促進するために、「研究開発税制」を抜本的に強化しました。\n　「賃上げ」につきましては、中小企業・小規模事業者の「賃上げ環境整備」として、官公需を含む「価格転嫁・取引適正化」の更なる徹底、そして、「成長志向の企業」や「生産性向上」への支援強化、М＆Ａ・事業承継等の「事業再編」の推進、「伴走支援体制」の強化などを進めてまいります。\n　さらに、「新陳代謝」については、税制措置や、「改訂コーポレートガバナンスコード」・「成長投資ガイダンス」の普及などによって、「経営資源の成長投資へのシフト」や、「事業ポートフォリオの転換」を促進してまいります。\n　本日お集りの皆様には、是非、政府と連携しながら、「大胆な投資」と「賃上げ」、そして「新陳代謝」に積極的に取り組んでいただきますことを、期待申し上げております。\n　山口代表幹事はじめ、皆様の益々の御活躍と経済同友会の更なる御発展を祈念申し上げます。\n　今日は全国知事会がありまして、知事との意見交換があり、急いで出ようと思いましたら、今日は国会でいろんなことがあったので、ぶら下がりで記者会見につかまり、そんなこんなで遅くなってしまいましたけれども、よかった、１０人ぐらいしかいてはらんへんかなと思ったのですが、たくさんの皆様にこうしてご一緒いただき、私もすごく嬉しく思います。\n　どうか、皆様お元気で御活躍ください。本当にありがとうございました。おめでとうございます。"}}},"rest_id":"2126288611788382365","unmention_data":{},"views":{"count":"32736","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126288611788382365","sortIndex":"2126390288539713532"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{