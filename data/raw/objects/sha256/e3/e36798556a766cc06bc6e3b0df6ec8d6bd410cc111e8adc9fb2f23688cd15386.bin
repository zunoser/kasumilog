cation/x-mpegURL","url":"https://video.twimg.com/amplify_video/2126224794601611265/pl/hl9s-2Y9N63CiFB0.m3u8?tag=29&v=2f8"},{"bitrate":432000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126224794601611265/vid/avc1/320x320/vxAm4dTmUDkTxI0M.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126224794601611265/vid/avc1/540x540/n8sUfpNHxv7-YAjB.mp4?tag=29"},{"bitrate":1280000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126224794601611265/vid/avc1/720x720/PaJb0dgSm1oDJC9F.mp4?tag=29"},{"bitrate":8768000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2126224794601611265/vid/avc1/1080x1080/ZpWAwU_IDEzb4VKf.mp4?tag=29"}]}}]},"favorite_count":19,"favorited":false,"full_text":"【#地震保険】\n今年も残すところあと一月あまりとなりました。\n地震保険では、保険料の一定額の所得控除が受けられる「地震保険料控除」があります。 https://t.co/zqK98PpwVY","id_str":"2126224820119760907","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":17,"retweet_count":4,"retweeted":false,"user_id_str":"331514169"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[1,6],"text":"地震保険"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"nta.go.jp/taxes/shiraber…","expanded_url":"https://www.nta.go.jp/taxes/shiraberu/taxanswer/shotoku/1145.htm","indices":[236,259],"url":"https://t.co/ThPHcJy32A"},{"display_url":"gov-online.go.jp/article/201701…","expanded_url":"https://www.gov-online.go.jp/article/201701/entry-9333.html","indices":[270,293],"url":"https://t.co/tObf06ORF3"},{"display_url":"jishin-hoken.jp","expanded_url":"https://www.jishin-hoken.jp/","indices":[314,337],"url":"https://t.co/I8kByYawL9"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyMjQ4MTk5ODU0Njk0NDE=","richtext":{"richtext_tags":[]},"text":"【#地震保険】\n今年も残すところあと一月あまりとなりました。\n地震保険では、保険料の一定額の所得控除が受けられる「地震保険料控除」があります。\n地震保険に加入している方は、年末調整時に申告することで控除を受けることができます。（年末調整で申告をしなかった場合でも、確定申告により控除を受けることができます。）\n\n所得税：地震保険料の全額（最高50,000円）を所得から控除\n個人住民税：地震保険料の2分の1（最高25,000円）を所得から控除\n\n国税庁「地震保険料控除」\nhttps://t.co/ThPHcJy32A\n政府広報オンライン\nhttps://t.co/tObf06ORF3\n地震保険特設サイト（日本損害保険協会）\nhttps://t.co/I8kByYawL9"}}},"rest_id":"2126224820119760907","unmention_data":{},"views":{"count":"5212","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126224820119760907","sortIndex":"2126390288539713484"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_inters