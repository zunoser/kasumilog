}},"id_str":"2126258556685160448","indices":[125,148],"media_key":"3_2126258556685160448","media_results":{"result":{"media_key":"3_2126258556685160448"}},"media_url_https":"https://pbs.twimg.com/media/HYH85FPakAAhYBO.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1463,"w":1463,"x":35,"y":0},{"h":1463,"w":1283,"x":125,"y":0},{"h":1463,"w":732,"x":400,"y":0},{"h":1463,"w":2048,"x":0,"y":0}],"height":1463,"width":2048},"sizes":{"large":{"h":1463,"resize":"fit","w":2048},"medium":{"h":857,"resize":"fit","w":1200},"small":{"h":486,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MiwsqpFHFw"}]},"favorite_count":29,"favorited":false,"full_text":"堀井外務副大臣は、フランシスコ・ガルセス・ベネズエラ運輸大臣（H.E. Mr. Francisco Garces, Minister of People's Power for Transport of Venezuela）による表敬を受けました。 https://t.co/MiwsqpFHFw","id_str":"2126258652453757228","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":8,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/la_c/sa/…","expanded_url":"https://www.mofa.go.jp/mofaj/la_c/sa/ve/pageit_000001_03358.html","indices":[271,294],"url":"https://t.co/Qg0zUcsUIf"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjYyNTg2NTIzMzIxMTgwMTY=","richtext":{"richtext_tags":[]},"text":"堀井外務副大臣は、フランシスコ・ガルセス・ベネズエラ運輸大臣（H.E. Mr. Francisco Garces, Minister of People's Power for Transport of Venezuela）による表敬を受けました。\n堀井副大臣から、6月の地震による甚大な被害に対するお見舞いを述べるとともに、引き続きベネズエラの復旧・復興に向けた支援を行っていく旨述べました。\n両者は、ベネズエラのビジネス環境整備等の経済関係についても意見交換を行い、ガルセス大臣は、日本政府及び日本企業とよく連携したい旨を述べました。\n\nhttps://t.co/Qg0zUcsUIf"}}},"rest_id":"2126258652453757228","unmention_data":{},"views":{"count":"4843","state":"EnabledWithCount"}}}}},"entryId":"tweet-2126258652453757228","sortIndex":"21263902885397135