s://t.co/3gwFaeM2GC"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/3gwFaeM2GC","expanded_url":"https://x.com/takaichi_sanae/status/2118654272196035011/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":179,"w":179,"x":1161,"y":687}]},"medium":{"faces":[{"h":105,"w":105,"x":680,"y":402}]},"orig":{"faces":[{"h":228,"w":228,"x":1475,"y":873}]},"small":{"faces":[{"h":59,"w":59,"x":385,"y":228}]}},"id_str":"2118654226310352896","indices":[126,149],"media_key":"3_2118654226310352896","media_results":{"result":{"media_key":"3_2118654226310352896"}},"media_url_https":"https://pbs.twimg.com/media/HWb4yzEb0AAHpcU.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1858,"w":1858,"x":44,"y":0},{"h":1858,"w":1630,"x":158,"y":0},{"h":1858,"w":929,"x":509,"y":0},{"h":1858,"w":2600,"x":0,"y":0}],"height":1858,"width":2600},"sizes":{"large":{"h":1464,"resize":"fit","w":2048},"medium":{"h":858,"resize":"fit","w":1200},"small":{"h":486,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/3gwFaeM2GC"}]},"favorite_count":6649,"favorited":false,"full_text":"本日、「APECビジネス諮問委員会（ABAC）」の日本委員の皆様が官邸を訪ねて下さり、「APEC首脳への提言」をいただきました。\n\nABACは、APEC参加21カ国・地域の首脳が指名したビジネス界の代表で構成されるAPEC唯一の公式民間諮問団体です。 https://t.co/3gwFaeM2GC","id_str":"2118654272196035011","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":27,"reply_count":384,"retweet_count":690,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2NTQyNzIxMjg4ODg4MzI=","richtext":{"richtext_tags":[]},"text":"本日、「APECビジネス諮問委員会（ABAC）」の日本委員の皆様が官邸を訪ねて下さり、「APEC首脳への提言」をいただきました。\n\nABACは、APEC参加21カ国・地域の首脳が指名したビジネス界の代表で構成されるAPEC唯一の公式民間諮問団体です。\n\n国際情勢に大きな揺らぎが生じている中、アジア太平洋地域の持続的な成長と繁栄を実現するためには、「ルールに基づく自由で開かれた貿易・投資環境」を官民が連携して維持・強化することが重要です。\n\n高市内閣では、『日本成長戦略』に基づき、提言に盛り込んでいただいた「海洋」や「量子」を含む「戦略17分野」において、官民による大胆な投資を促進しています。\n\nそして、その国内投資から生まれる、日本の強みを活かした、技術や製品、金融を含むサービスを世界の新たな成長市場へと結びつけ、我が国のみならず、アジア太平洋地域全体の成長につなげていきます。\n\nまた、AIを悪用したサイバー攻撃の増加も念頭に、「安全・安心で信頼できるAIの実現」に向け、多国間協力を推進し、ルール形成など\n「AIガバナンス」に関する国際的な議論を主導していきます。\n\nいただいた提言を受け止め、経済界の皆様と緊密に連携しながら、日本が先陣を切って、アジア太平洋地域の発展と繁栄に取り組んでいきます。"}}},"rest_id":"2118654272196035011","unmention_data":{},"views":{"count":"254761","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118654272196035011","sortIndex":"2119538335255887804"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"description":{},"url":{"urls":[{"display_url":"fdma.go.jp","expanded_url":"http://www.fdma.go.jp/","indices":[0,23],"url":"https://t.co/YCgAnjuA8