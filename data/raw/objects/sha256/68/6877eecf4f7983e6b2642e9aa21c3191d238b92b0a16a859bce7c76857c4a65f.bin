雇用創出に挑む取組に敬意を表しました。経済産業省は、こうした挑戦が各地へ広がるよう、中堅・中小企業の成長支援や国内投資の促進、地域発のイノベーション支援を通じ応援してまいります。"}}},"rest_id":"2118666887815151809","unmention_data":{},"views":{"count":"6487","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118666887815151809","sortIndex":"2119538335255887816"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1907032035689996327"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}