th":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/fGstR2xTa5"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/fGstR2xTa5","expanded_url":"https://x.com/takaichi_sanae/status/2118649749939388808/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":137,"w":137,"x":475,"y":215},{"h":175,"w":175,"x":859,"y":529},{"h":171,"w":171,"x":1111,"y":179},{"h":267,"w":267,"x":1677,"y":343}]},"medium":{"faces":[{"h":80,"w":80,"x":278,"y":126},{"h":102,"w":102,"x":503,"y":310},{"h":100,"w":100,"x":651,"y":105},{"h":156,"w":156,"x":983,"y":201}]},"orig":{"faces":[{"h":175,"w":175,"x":604,"y":274},{"h":223,"w":223,"x":1091,"y":672},{"h":218,"w":218,"x":1411,"y":228},{"h":340,"w":340,"x":2130,"y":436}]},"small":{"faces":[{"h":45,"w":45,"x":157,"y":71},{"h":58,"w":58,"x":285,"y":175},{"h":57,"w":57,"x":369,"y":59},{"h":88,"w":88,"x":557,"y":114}]}},"id_str":"2118649500059463680","indices":[133,156],"media_key":"3_2118649500059463680","media_results":{"result":{"media_key":"3_2118649500059463680"}},"media_url_https":"https://pbs.twimg.com/media/HWb0fsaacAAv_G2.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/fGstR2xTa5"}]},"favorite_count":12874,"favorited":false,"full_text":"本日17時15分から、「サイバーセキュリティに関する関係閣僚会議」を開催しました。\n\n昨今の深刻なサイバー攻撃の状況を踏まえ、早期に実施すべき施策を取りまとめた『緊急対策パッケージ』を策定しました。\n\n『緊急対策パッケージ』は、\n・AIも活用した基本的な対策の徹底 https://t.co/fGstR2xTa5","id_str":"2118649749939388808","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":183,"reply_count":641,"retweet_count":1845,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2NDk3NDk4NTEyNzUyNjQ=","richtext":{"richtext_tags":[]},"text":"本日17時15分から、「サイバーセキュリティに関する関係閣僚会議」を開催しました。\n\n昨今の深刻なサイバー攻撃の状況を踏まえ、早期に実施すべき施策を取りまとめた『緊急対策パッケージ』を策定しました。\n\n『緊急対策パッケージ』は、\n・AIも活用した基本的な対策の徹底\n・情報収集・集約、捜査・分析体制の強化\n・サイバー攻撃への対処の戦略的な実施\n・被害者支援・被害拡大防止策の強化\nの4つの柱からなります。\n\n政府として、『緊急対策パッケージ』の早期かつ効果的な実行を通じ、サイバーレジリエンスの向上と国民の皆様の不安の払しょくにつなげていきます。\n\n今朝の閣議で、直ちに必要となる約100億円の予備費を措置しましたが、『緊急対策パッケージ』全体の実施に必要となる財政措置の確保について、更に検討・調整を進めていきます。\n\nまた、制度面や体制面を含めた中長期的な課題についても更に検討を進め、官民一体となって、我が国全体の対処能力の強化に取り組みます。\n\n具体的には、日本を標的としたサイバー攻撃を把握するための情報収集能力を更に強化するため、『サイバー対処能力強化法』の改正について、検討を進めます。\n\nまた、AI時代のサイバー攻撃のスピードに対応し、政府として機動的な対応がとれるよう、「国家サイバー統括室」への情報集約に要する時間を大幅に短縮することが必要です。\n\n基幹インフラ事業者からの報告について、できれば数時間、少なくとも同日中には、攻撃を受けた旨の情報が伝わるようにすることを目指します。\n\n現行の政府機関などに加えて、民間企業への不審な通信を「国家サイバー統括室」が把握・分析することが可能な仕組みについても、主要国の例も参考にしながら、検討します。\n\nITシステムや機器のサプライチェーンリスクも見過ごすことはできません。\n政府システムの点検を進めるとともに、官民において、リスクを低減するために必要な制度について、「国家安全保障局」を中心に検討します。\n\n今、この瞬間にも、不正アクセスや情報漏えいの事案が相次ぎ、国民生活や企業活動に大きな影響が生じています。\n\n政府の総力を挙げて、我が国全体の対処能力を高めていきます。"}}},"rest_id":"2118649749939388808","unmention_data":{},"views":{"count":"436003","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118649749939388808","sortIndex":"2119538335255887802"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"use