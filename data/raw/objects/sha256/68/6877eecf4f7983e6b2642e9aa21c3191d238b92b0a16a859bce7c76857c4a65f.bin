://x.com/hmatsu63/status/2118920603633959103/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2118920364382466048","indices":[123,146],"media_key":"3_2118920364382466048","media_results":{"result":{"media_key":"3_2118920364382466048"}},"media_url_https":"https://pbs.twimg.com/media/HWfq2EpbsAAYPCB.jpg","original_info":{"focus_rects":[{"h":633,"w":1130,"x":0,"y":0},{"h":803,"w":803,"x":0,"y":0},{"h":803,"w":704,"x":0,"y":0},{"h":803,"w":402,"x":0,"y":0},{"h":803,"w":1130,"x":0,"y":0}],"height":803,"width":1130},"sizes":{"large":{"h":803,"resize":"fit","w":1130},"medium":{"h":803,"resize":"fit","w":1130},"small":{"h":483,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/isx8umDcaQ"}]},"favorite_count":1466,"favorited":false,"full_text":"昨日政府が発表したサイバー攻撃に対する対策パッケージの概要を、デジタル庁が国家サイバー統括室とともに分かりやすく、簡単にまとめたものです。「政府が何をするか」、「事業者には何をするべきか」、「国民の皆さんには何をして欲しいか」、三つの視点です。 https://t.co/isx8umDcaQ","id_str":"2118920603633959103","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":6,"reply_count":15,"retweet_count":275,"retweeted":false,"user_id_str":"1388380913583628291"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg5MjA2MDM1NjI2MDY1OTI=","text":"昨日政府が発表したサイバー攻撃に対する対策パッケージの概要を、デジタル庁が国家サイバー統括室とともに分かりやすく、簡単にまとめたものです。「政府が何をするか」、「事業者には何をするべきか」、「国民の皆さんには何をして欲しいか」、三つの視点です。\n三つ目は特に私も大臣の時から訴えていた「サイバー衛生」です。インフルエンザやコロナなどの感染症が流行したときには、マスクをつける、うがいをする、手洗いをする、換気をする、のと同じように、誰でもできるサイバー防御をお願いします。\n国全体でサイバー攻撃へのレジリエンス（復元力、弾力性）を高めていきましょう。"}}},"previous_counts":{"bookmark_count":0,"favorite_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"rest_id":"2118920603633959103","unmention_data":{},"views":{"count":"155060","state":"EnabledWithCount"