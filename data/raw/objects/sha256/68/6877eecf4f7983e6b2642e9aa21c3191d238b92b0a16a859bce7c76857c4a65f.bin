description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":12472,"following":249},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1283221862755913728","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":479,"tweets":1114},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/ymurbTMASP"}}}},"edit_control":{"edit_tweet_ids":["2118627795597234424"],"editable_until_msecs":"1793958803000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2118627795597234424","created_at":"Fri Nov 06 08:53:23 +0000 2026","display_text_range":[0,136],"entities":{},"favorite_count":132,"favorited":false,"full_text":"演奏会は、演奏だけではつくれない。\n \n川口市立高校の高校生特派員が、朝霞駐屯地で中央音楽隊の企画係長・本田さんを取材。\n「音楽のチカラを120％に引き上げる」ために、企画・構成・演出・進行をどう組み立てているのか。\nさらに、楽器の輸送まで自分たちで担う音楽隊の仕事とは。","id_str":"2118627795597234424","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":1,"retweet_count":29,"retweeted":false,"user_id_str":"1283221862755913728"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[237,247],"text":"自衛CANNEWS"},{"indices":[248,254],"text":"自衛官募集"},{"indices":[255,262],"text":"高校生特派員"},{"indices":[263,270],"text":"川口市立高校"},{"indices":[271,276],"text":"吹奏楽部"},{"indices":[277,283],"text":"中央音楽隊"},{"indices":[284,290],"text":"朝霞駐屯地"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/gsdf/jieikanbo…","expanded_url":"https://www.mod.go.jp/gsdf/jieikanbosyu/jcannews/","indices":[211,234],"url":"https://t.co/hn4ZjeUkVu"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2Mjc3OTU0NTAzOTY2NzM=","text":"演奏会は、演奏だけではつくれない。\n \n川口市立高校の高校生特派員が、朝霞駐屯地で中央音楽隊の企画係長・本田さんを取材。\n「音楽のチカラを120％に引き上げる」ために、企画・構成・演出・進行をどう組み立てているのか。\nさらに、楽器の輸送まで自分たちで担う音楽隊の仕事とは。\n華やかなステージを支える、もう一つの「プロの仕事」を動画でご覧ください。\n \n次回「陸上自衛隊中央音楽隊が目指すところ」。\n🔗自衛CAN NEWS\nhttps://t.co/hn4ZjeUkVu\n \n#自衛CANNEWS #自衛官募集 #高校生特派員 #川口市立高校 #吹奏楽部 #中央音楽隊 #朝霞駐屯地"}}},"rest_id":"2118627795597234424","unmention_data":{},"views":{"count":"15188","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2118633132627038616","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4797","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118633132627038616","sortIndex":"2119538335255887781"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/IFdhJoedVJ"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":15},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/960685038957244417/qRIY3RTr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/719219671/1597226136"},"core":{"created_at":"Fri Jul 27 02:08:13 +0000 2012","name":"原子力規制委員会 / NRA Japan","screen_name":"gensiryokukisei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo3MTkyMTk2NzE=","is_blue_verified":false,"location":{"location":"日本"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids