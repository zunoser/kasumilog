reply_count":855,"retweet_count":1729,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg5MTc0OTIwMzkwOTQyNzI=","richtext":{"richtext_tags":[]},"text":"今朝、北海道西方沖での大規模な地震により原子力発電所である「泊発電所」で事故が発生したことを想定した「原子力総合防災訓練」を行いました。\n\n発電所から5キロメートル圏内にある泊村、共和町の住民の皆様には、バス、ヘリ、船などにより、所定の避難所まで避難していただきました。\n\n警察、消防、自衛隊の皆様を含め、計1万人以上に参加いただく大規模で実践的な訓練です。\n\n官邸での「原子力災害対策本部会議」には、全閣僚や原子力規制委員会委員長はもちろんのこと、鈴木北海道知事、髙橋泊村長、成田共和町長にもオンラインで参加していただきました。\n\n国民の皆様の命を守るために、常に備えを怠らず、高市内閣として一致団結して防災対策に力を尽くしてまいります。"}}},"rest_id":"2118917492097904785","unmention_data":{},"views":{"count":"824949","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118917492097904785","sortIndex":"2119538335255887841"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["21160175727727