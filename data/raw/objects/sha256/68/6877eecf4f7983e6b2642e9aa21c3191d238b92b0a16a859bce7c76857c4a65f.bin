":{"string_value":"自衛隊には、さまざまな「できる」があります。何を守るために、何ができるのか。そして、その「できる」は、どうやって生まれているのか。仕事や人、技術、知識、日々の積み重ねまで、自衛隊のことを楽しく、わかりやすく伝えます。知るほどに、もっと知りたくなる。自衛CAN NEWS。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.mod.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":314,"url":"https://pbs.twimg.com/card_img/2117843068313595904/_wnLmV5I?format=jpg&name=600x600","width":600},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2117843068313595904/_wnLmV5I?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":628,"url":"https://pbs.twimg.com/card_img/2117843068313595904/_wnLmV5I?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2117843068313595904/_wnLmV5I?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"summary_photo_image_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2117843068313595904/_wnLmV5I?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":75,"url":"https://pbs.twimg.com/card_img/2117843068313595904/_wnLmV5I?format=jpg&name=144x144","width":144},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":628,"url":"https://pbs.twimg.com/card_img/2117843068313595904/_wnLmV5I?format=png&name=2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"photo_image_full_size_original","value":{"image_value":{"height":628,"url":"https://pbs.twimg.com/card_img/2117843068313595904/_wnLmV5I?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mod.go.jp","type":"STRING"}},{"key":"photo_image_full_size","value":{"image_value":{"height":314,"url":"https://pbs.twimg.com/car