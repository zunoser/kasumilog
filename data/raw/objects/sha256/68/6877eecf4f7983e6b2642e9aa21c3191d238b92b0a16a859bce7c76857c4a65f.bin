label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075873,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":620,"tweets":1940},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2118850008485441916"],"editable_until_msecs":"1794011783000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":329,"bookmarked":false,"conversation_id_str":"2118850008485441916","created_at":"Fri Nov 06 23:36:23 +0000 2026","display_text_range":[0,129],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/6z8MEdNotX","expanded_url":"https://x.com/takaichi_sanae/status/2118850008485441916/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2118849851224182784","indices":[130,153],"media_key":"3_2118849851224182784","media_results":{"result":{"media_key":"3_2118849851224182784"}},"media_url_https":"https://pbs.twimg.com/media/HWeqtqqbUAAdx4h.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":181},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":6,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6z8MEdNotX"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/6z8MEdNotX","expanded_url":"https://x.com/takaichi_sanae/status/2118850008485441916/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2118849851224182784","indices":[130,153],"media_key":"3_2118849851224182784","media_results":{"result":{"media_key":"3_2118849851224182784"}},"media_url_https":"https://pbs.twimg.com/media/HWeqtqqbUAAdx4h.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":181},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":6,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6z8MEdNotX"}]},"favorite_count":9449,"favorited":false,"full_text":"【日本列島を、強く豊かに。：山形編】\n\n本日は、『地域未来戦略』に基づき山形県が策定した、「半導体分野における地域産業クラスター計画」をご紹介します。\n\n山形県は、令和5年の「電子部品・デバイス・電子回路製造業」の出荷額が全国4位、付加価値額が全国1位です。 https://t.co/6z8MEdNotX","id_str":"2118850008485441916","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":128,"reply_count":776,"retweet_count":1224,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[846,858],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg4NTAwMDgzODg5MTUyMDA=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：山形編】\n\n本日は、『地域未来戦略』に基づき山形県が策定した、「半導体分野における地域産業クラスター計画」をご紹介します。\n\n山形県は、令和5年の「電子部品・デバイス・電子回路製造業」の出荷額が全国4位、付加価値額が全国1位です。\n\n大手半導体メーカーの生産拠点や、半導体素材となるウェハ製造企業などに加え、金型、鋳造、表面処理など半導体製造装置の製作を支える高度な技術を有する企業が集積し、素材・材料から精密加工・装置部品・後工程・保守までを支える高精度なものづくり基盤を有しています。\n\n一方で、少子高齢化と人口流出による労働力不足、半導体製造や開発を担う高度な技術者や専門人材の確保に課題を抱えています。\n\n山形県は、『地域未来戦略』の国の支援も活用して、半導体関連企業の県内進出の促進、精密加工に必要な設備の整備などによる県内企業の半導体関連分野への参入促進、人材育成などに対する官民投資を行うことで、県内の高精度なものづくり基盤を活かした半導体関連産業の更なる集積の拡大と、県内企業が半導体製造の中核工程を担う「産業クラスター」の形成を目指しています。\n\nまた、大学等と連携し、学生に対する半導体産業関連産業の啓発や、産学官が連携した実践的な研修プログラムの構築、多様な雇用の創出を進め、若者の県内定着を促進することとしています。\n\n私自身、吉村知事から以下の意気込みを伺いました。\n\n「山形県は、令和5年の半導体分野の付加価値額が全国1位であり、多様な企業が集積し、関連産業を支える要素技術の蓄積が強みであることから、更なる集積に向け、地域産業クラスター計画を策定しました。企業誘致をはじめ、企業間連携やオープンイノベーションの創出、新規参入の促進を図るとともに、産学官金の連携で専門人材の育成・確保に取り組んでいきます。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を全力で応援してまいります。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2118850008485441916","unmention_data":{},"views":{"count":"329693","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118850008485441916","sortIndex":"2119538335255887827"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_