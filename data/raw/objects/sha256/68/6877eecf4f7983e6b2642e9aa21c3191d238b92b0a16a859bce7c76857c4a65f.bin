57},{"h":29,"w":29,"x":219,"y":216}]}},"id_str":"2119321330130817024","indices":[92,115],"media_key":"3_2119321330130817024","media_results":{"result":{"media_key":"3_2119321330130817024"}},"media_url_https":"https://pbs.twimg.com/media/HWlXhWdbEAAdUNn.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1733,"w":1733,"x":867,"y":0},{"h":1733,"w":1520,"x":1080,"y":0},{"h":1733,"w":867,"x":1582,"y":0},{"h":1733,"w":2600,"x":0,"y":0}],"height":1733,"width":2600},"sizes":{"large":{"h":1365,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/jKGxXCgfjy"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/jKGxXCgfjy","expanded_url":"https://x.com/takaichi_sanae/status/2119321516470833238/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2119321307095719937","indices":[92,115],"media_key":"3_2119321307095719937","media_results":{"result":{"media_key":"3_2119321307095719937"}},"media_url_https":"https://pbs.twimg.com/media/HWlXgApbYAE-BFS.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":108,"y":0},{"h":1734,"w":1521,"x":215,"y":0},{"h":1734,"w":867,"x":542,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/jKGxXCgfjy"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/jKGxXCgfjy","expanded_url":"https://x.com/takaichi_sanae/status/2119321516470833238/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":75,"w":75,"x":133,"y":649},{"h":95,"w":95,"x":1475,"y":473},{"h":89,"w":89,"x":661,"y":651}]},"medium":{"faces":[{"h":44,"w":44,"x":78,"y":380},{"h":55,"w":55,"x":864,"y":277},{"h":52,"w":52,"x":387,"y":381}]},"orig":{"faces":[{"h":96,"w":96,"x":170,"y":825},{"h":121,"w":121,"x":1873,"y":601},{"h":114,"w":114,"x":840,"y":827}]},"small":{"faces":[{"h":25,"w":25,"x":44,"y":215},{"h":31,"w":31,"x":489,"y":157},{"h":29,"w":29,"x":219,"y":216}]}},"id_str":"2119321330130817024","indices":[92,115],"media_key":"3_2119321330130817024","media_results":{"result":{"media_key":"3_2119321330130817024"}},"media_url_https":"https://pbs.twimg.com/media/HWlXhWdbEAAdUNn.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1733,"w":1733,"x":867,"y":0},{"h":1733,"w":1520,"x":1080,"y":0},{"h":1733,"w":867,"x":1582,"y":0},{"h":1733,"w":2600,"x":0,"y":0}],"height":1733,"width":2600},"sizes":{"large":{"h":1365,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/jKGxXCgfjy"}]},"favorite_count":11564,"favorited":false,"full_text":"本日は、「全拉致被害者の即時一括帰国を求める国民大集会」に出席し、ご挨拶をさせていただくとともに、横田早紀江さんをはじめとするご家族の皆様の悲痛な思いを改めてお聞かせいただきました。 https://t.co/jKGxXCgfjy","id_str":"2119321516470833238","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":188,"reply_count":784,"retweet_count":1553,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTkzMjE1MTY0MTIxMDg4MDA=","richtext":{"richtext_tags":[]},"text":"本日は、「全拉致被害者の即時一括帰国を求める国民大集会」に出席し、ご挨拶をさせていただくとともに、横田早紀江さんをはじめとするご家族の皆様の悲痛な思いを改めてお聞かせいただきました。\n\n拉致被害者の皆様もご家族の皆様も年を重ねていかれる中、拉致問題はすぐにでも解決されなくてはなりません。\n\nこうした強い決意の下、具体的な成果に結び付けるべく、北朝鮮側に対しては、現在も働きかけを続けています。\n\n私の代で何としても突破口を開き、拉致問題を解決するとの決意に変わりはなく、ご家族の皆様が肉親を抱きしめるその日まで、私の使命は終わりません。\n\nこれまでも、二国間首脳会談の機会にも、例外なく、「拉致問題の即時解決に向けた協力」を各国首脳にお願いし、支持を得てきました。\n\n拉致問題の解決に向けては、国民の皆様お一人お一人が声を上げ続け、「全ての世代が一刻も早い解決を求めていること」を、北朝鮮側に示すことが極めて重要であり、解決に向けた大きな力となります。\n\n本日改めてお聞かせいただいた皆様の声を心に刻んで、高市内閣で拉致問題を解決すべく、取り組んでいきます。"}}},"rest_id":"2119321516470833238","unmention_data":{},"views":{"count":"326959","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119321516470833238","sortIndex":"2119538335255887864"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"description":{},"url":{"urls":[{"display_url":"fdma.go.jp","expanded_url":"http://www.fdma.go.jp/","indices":[0,23],"url":"https://t.co/YCgAnjuA83"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translati