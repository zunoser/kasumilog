h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/xfozTu6hKE"}]},"favorite_count":11390,"favorited":false,"full_text":"本日夕方、第9回「日本成長戦略会議」を開催しました。\n\nまず、『日本成長戦略実行計画』に盛り込む主な項目を取り上げました。\n\n特に、戦略17分野・62の主要な製品・技術等について、\n①「足元の収益源」、\n②「今後の稼ぎ頭」、\n③「経済安全保障の強化」\nに大きく分類し、そのうち、 https://t.co/xfozTu6hKE","id_str":"2118662281034658265","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":154,"reply_count":1342,"retweet_count":1313,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2NjIyODA5NDIzMzgwNDg=","richtext":{"richtext_tags":[]},"text":"本日夕方、第9回「日本成長戦略会議」を開催しました。\n\nまず、『日本成長戦略実行計画』に盛り込む主な項目を取り上げました。\n\n特に、戦略17分野・62の主要な製品・技術等について、\n①「足元の収益源」、\n②「今後の稼ぎ頭」、\n③「経済安全保障の強化」\nに大きく分類し、そのうち、\n2040年度までの経済波及効果や経済安全保障の観点から日本経済の自律性や不可欠性への貢献が大きいものなどを、「重点項目」としてお示ししました。\n\nまた、「足元の収益源」と位置付けられる、「半導体」・「創薬」や、「フィジカルAI」の事業者の皆様から、投資案件の具体化に向けた意気込みや課題をお聞かせいただきました。\n\n①各国が産業政策を競い合う中で、「半導体サプライチェーン」を国内に確立するため、大規模かつ計画的な投資支援策が不可欠であること、\n\n②フィジカルAIの国内投資を促進するため、国産AI基盤確立を加速すべきこと、\n\n③健康医療安全保障に直結する「革新的医薬品」の国内製造を促進するため、薬価における適切なイノベーション評価を含む我が国の「創薬環境」を向上させる必要があること\n\nなど、貴重な御指摘をいただきました。\n\nこうしたご指摘を踏まえ、国内投資案件が着実に引き出されるよう、『実行計画』の具体化を進めていきます。\n\n政府側の体制強化の一環として、先般、各府省庁幹部に「日本成長戦略推進担当官」を発令しました。\n\n城内大臣が取りまとめる『実行計画』の中では、具体化された「官民の投資額」や「達成すべき成果目標」が盛り込まれることになりますが、各担当官には、関係府省庁や民間企業とも緊密に連携し、「計画実行」と「成果の実現」について、責任をもって取り組んでもらいます。\n\n今般、日本銀行が「ETF売却の加速化」を決定しました。\n\nその｢追加売却益｣は、まさに日本の「成長の果実」であり、これを、危機管理投資・成長投資に再投資し、更なる成長につなげていくといった「経済の好循環」を実現していくことが適切だと考えます。\n\nこのため、今般の｢追加売却益｣は、『「強く豊かな日本」投資枠』のうち、経済安全保障上特に重要な分野などの事業を計上する「新しい特別会計」の財源として位置づけます。\n\nこの特別会計においては、追加売却益を償還財源とする「つなぎ国債」を発行することにより、資金を前倒しで調達し、計画的な公的支援にコミットすることで、投資の予見可能性を高め、民間投資を呼び込んでまいります。\n\nまた、会議のヒアリングの中で、「建設供給力」や「電力インフラの強化」が、「国内投資」促進のための喫緊の課題であるとのご指摘もいただきました。\n\n①建設供給力の確保、\n②成長分野への資金供給、\n③電力インフラ、\n④AX推進\nの「足元の4つの課題」についても、既に政府横断で議論を進めているところです。\n\n本日の議論も踏まえ、関係する民間企業とも連携し、即効性ある対策の検討を加速していきます。"}}},"rest_id":"2118662281034658265","unmention_data":{},"views":{"count":"418488","state":"EnabledWithCount"}}}}},"entryId":"tweet-2118662281034658265","sortIndex":"2119538335255887811"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1907032035689996327"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url"