slated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2118706402449654268","created_at":"Fri Nov 06 14:05:44 +0000 2026","display_text_range":[0,140],"entities":{"user_mentions":[{"id_str":"2070308568658767872","indices":[3,17],"name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"}]},"favorite_count":0,"favorited":false,"full_text":"RT @PressSec_JMOD: 我が国は、専守防衛の下、他国に脅威を与えるような軍事大国とはならないとの基本方針を堅持しています。\n\n本日、小泉防衛大臣は、日本を取り巻く安全保障環境が厳しさを増す中、我が国がどのように防衛力を強化し、何を目指していくのかについて発信しまし…","id_str":"2118706402449654268","is_quote_status":true,"lang":"ja","quote_count":0,"quoted_status_id_str":"2118695175249863085","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2118695175249863085","url":"https://t.co/uzBd0KiHcy"},"reply_count":0,"retweet_count":239,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2118699346392994116"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39772,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":102,"tweets":488},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2118699346392994116"],"editable_until_msecs":"1793975862000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":47,"bookmarked":false,"conversation_id_str":"2118699346392994116","created_at":"Fri Nov 06 13:37:42 +0000 2026","display_text_range":[0,122],"entities":{},"favorite_count":1184,"favorited":false,"full_text":"我が国は、専守防衛の下、他国に脅威を与えるような軍事大国とはならないとの基本方針を堅持しています。\n\n本日、小泉防衛大臣は、日本を取り巻く安全保障環境が厳しさを増す中、我が国がどのように防衛力を強化し、何を目指していくのかについて発信しました。","id_str":"2118699346392994116","is_quote_status":true,"lang":"ja","quote_count":8,"quoted_status_id_str":"2118695175249863085","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2118695175249863085","url":"https://t.co/uzBd0KiHcy"},"reply_count":23,"retweet_count":239,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg2OTkzNDYzMzgzODE4MjQ=","text":"我が国は、専守防衛の下、他国に脅威を与えるような軍事大国とはならないとの基本方針を堅持しています。\n\n本日、小泉防衛大臣は、日本を取り巻く安全保障環境が厳しさを増す中、我が国がどのように防衛力を強化し、何を目指していくのかについて発信しました。\n\n大臣は動画の中で、「日本が攻めていくことはありません」とした上で、「日本を攻撃しても、目的を達成することはできない」と相手に認識させる、こうした「拒否する力」を持つことで、戦争を起こさせないと述べています。\n\nまた、防衛力は自衛隊だけでつくるものではないとして、「企業が成長し、新しい技術が生まれる。その技術と経済力が防衛力を支え、安心して暮らし、働ける社会を守る」との考えも示しています。\n\n日本が何を守り、そのために防衛力をどのように変えていくのか。ぜひ大臣のメッセージをご覧ください。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2118695175249863085"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circ