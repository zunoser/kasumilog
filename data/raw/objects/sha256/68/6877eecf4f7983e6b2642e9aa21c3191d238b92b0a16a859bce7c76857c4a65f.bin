ssions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075873,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":620,"tweets":1940},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2119212443704623476"],"editable_until_msecs":"1794098194000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":387,"bookmarked":false,"conversation_id_str":"2119212443704623476","created_at":"Sat Nov 07 23:36:34 +0000 2026","display_text_range":[0,84],"entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/MVDQcUGD3O","expanded_url":"https://x.com/takaichi_sanae/status/2119212443704623476/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2119212321142894592","indices":[85,108],"media_key":"3_2119212321142894592","media_results":{"result":{"media_key":"3_2119212321142894592"}},"media_url_https":"https://pbs.twimg.com/media/HWj0YMVacAA79Ln.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":0,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MVDQcUGD3O"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/MVDQcUGD3O","expanded_url":"https://x.com/takaichi_sanae/status/2119212443704623476/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2119212321142894592","indices":[85,108],"media_key":"3_2119212321142894592","media_results":{"result":{"media_key":"3_2119212321142894592"}},"media_url_https":"https://pbs.twimg.com/media/HWj0YMVacAA79Ln.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":0,"y":0},{"h":2836,"w":2488,"x":0,"y":0},{"h":2836,"w":1418,"x":0,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MVDQcUGD3O"}]},"favorite_count":8903,"favorited":false,"full_text":"【日本列島を、強く豊かに。：香川編】\n\n本日は、『地域未来戦略』に基づき香川県が策定した、「造船・建機等鋼構造物関連分野における地域産業クラスター計画」をご紹介します。 https://t.co/MVDQcUGD3O","id_str":"2119212443704623476","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":152,"reply_count":738,"retweet_count":1189,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[831,843],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTkyMTI0NDM2MDQwNzg1OTI=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：香川編】\n\n本日は、『地域未来戦略』に基づき香川県が策定した、「造船・建機等鋼構造物関連分野における地域産業クラスター計画」をご紹介します。\n\n瀬戸内地域は、全国の新造船建造量の約半分を占める我が国最大の造船集積地であり、国としても、『地域未来戦略』に基づく「戦略産業クラスター計画」を策定し、次世代船舶の量産拠点としての競争力の強化や量産体制の確立に向け取り組んでいます。\n\n香川県には、造船、建機、船舶用主機関等の世界的シェアを持つ中堅・大手企業が集積するとともに、鋼材加工、製缶板金、溶接等を担う企業が多数立地し、鋼構造物関連のサプライチェーンが構築されており、造船・建機等鋼構造物関連の工業品出荷額も高い水準です。\n\n香川県は、このような強みを活かし、瀬戸内地域の「次世代船舶 戦略産業クラスター計画」と連携して、我が国の造船業の復権とグローバル市場での競争力強化を実現するため、造船・建機等鋼構造物関連産業の生産体制の強化を図り、「産業クラスター」の形成を目指しています。\n\n『地域未来戦略』の国の支援も活用し、工場や設備の整備、インフラ整備等に対する官民投資や、新技術に対応できる人材や高度デジタル人材の育成に取り組むことなどにより、生産基盤の強化や増産体制を構築し、輸出や国内シェアの拡大を図るとともに、製造工程のDX化による競争力の強化を目指しています。\n\n私自身、池田知事から以下の意気込みを伺いました。\n\n「香川県は、船舶やクレーンなどで世界的シェアを持つ企業を中心に、金属加工や溶接などの高度な基盤技術を持つ企業が多数集積し、サプライチェーンが形成されています。この県内企業の生産拠点の増設、人材育成などの取組みについて、県として後押ししてまいりますので、国のご支援をお願いします。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を全力で応援してまいります。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2119212443704623476","unmention_data":{},"views":{"count":"415817","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119212443704623476","sortIndex":"2119538335255887859"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/gRmyshvvgj"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1153541724804792320/1IxAaRLZ_normal.png"},"banner":{"image_u