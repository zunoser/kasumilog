1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2118695175249863085"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265965,"following":44},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7868,"tweets":21950},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2118987749785219451"],"editable_until_msecs":"1794044623000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":16,"bookmarked":false,"conversation_id_str":"2118987749785219451","created_at":"Sat Nov 07 08:43:43 +0000 2026","display_text_range":[0,69],"entities":{},"favorite_count":906,"favorited":false,"full_text":"11月7日、小泉防衛大臣は、原子力総合防災訓練に参加しました。\n訓練では、地震などの自然災害と原子力災害が同時に発生する厳しい事態を想定。","id_str":"2118987749785219451","is_quote_status":true,"lang":"ja","quote_count":8,"quoted_status_id_str":"2118915224174788761","quoted_status_permalink":{"display":"x.com/kantei/status/…","expanded":"https://twitter.com/kantei/status/2118915224174788761","url":"https://t.co/c7nqnYMZFD"},"reply_count":24,"retweet_count":145,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg5ODc3NDk3MzkwODU4MjQ=","text":"11月7日、小泉防衛大臣は、原子力総合防災訓練に参加しました。\n訓練では、地震などの自然災害と原子力災害が同時に発生する厳しい事態を想定。\n高市総理大臣（原子力災害対策本部長）からの指示を受け、小泉大臣は原子力災害派遣命令を発令し、自衛隊は住民の救助や避難支援を最優先に活動する方針を報告しました。\n防衛省・自衛隊は、いかなる事態においても国民の皆様の命と平和な暮らしを守り抜けるよう、各種訓練を通じて対処能力を高めるとともに、防災庁をはじめ関係機関との連携を一層強化してまいります。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式