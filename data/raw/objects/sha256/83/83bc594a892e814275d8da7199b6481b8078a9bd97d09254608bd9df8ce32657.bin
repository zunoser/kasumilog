RDqEe","expanded_url":"https://x.com/sonpokyokai/status/2072910377743208869/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2072910372479320064","indices":[98,121],"media_key":"3_2072910372479320064","media_results":{"result":{"media_key":"3_2072910372479320064"}},"media_url_https":"https://pbs.twimg.com/media/HMR1AELaQAAIeIs.png","original_info":{"focus_rects":[{"h":422,"w":754,"x":0,"y":0},{"h":493,"w":493,"x":0,"y":0},{"h":493,"w":432,"x":0,"y":0},{"h":493,"w":247,"x":0,"y":0},{"h":493,"w":754,"x":0,"y":0}],"height":493,"width":754},"sizes":{"large":{"h":493,"resize":"fit","w":754},"medium":{"h":493,"resize":"fit","w":754},"small":{"h":445,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/iDvdqRDqEe"}]},"favorite_count":38,"favorited":false,"full_text":"【軽消防自動車、高規格救急自動車を全国に12台寄贈】\n寄贈車両は、各地域における実際の消火活動や救急救命活動のほか、平時から住民の防災意識向上のための消防訓練など、様々な用途で活用されています。 https://t.co/iDvdqRDqEe","id_str":"2072910377743208869","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":0,"retweet_count":21,"retweeted":false,"user_id_str":"1747895030294171648"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[230,237],"text":"軽消防自動車"},{"indices":[238,247],"text":"高規格救急自動車"},{"indices":[248,251],"text":"防火"},{"indices":[252,255],"text":"防災"},{"indices":[256,260],"text":"消防庁"},{"indices":[261,264],"text":"寄贈"},{"indices":[265,270],"text":"損保協会"},{"indices":[271,276],"text":"損害保険"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"sonpo.or.jp/news/release/2…","expanded_url":"https://www.sonpo.or.jp/news/release/2026/260703_01.html","indices":[205,228],"url":"https://t.co/WIcS3NFdvb"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwNzI5MTAzNzc2Njc2NTc3Mjg=","richtext":{"richtext_tags":[]},"text":"【軽消防自動車、高規格救急自動車を全国に12台寄贈】\n寄贈車両は、各地域における実際の消火活動や救急救命活動のほか、平時から住民の防災意識向上のための消防訓練など、様々な用途で活用されています。\n今回の寄贈により、軽消防自動車（含む消防資機材）の累計寄贈台数は3,541台、救急自動車の累計寄贈台数は1,697台となり、これまでに計5,238台を全国各地に寄贈しています。\n詳細は以下リンクからご覧ください。\nhttps://t.co/WIcS3NFdvb\n\n#軽消防自動車 #高規格救急自動車 #防火 #防災 #消防庁 #寄贈 #損保協会 #損害保険"}}},"rest_id":"2072910377743208869","unmention_data":{},"views":{"count":"17236","state":"EnabledWithCount"}}}},"rest_id":"2112819011583123757","unmention_data":{},"views":{"count":"7091","state":"EnabledWithCount"}}}},"user_id_str":"137272821"},"rest_id":"2113065442181042572","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1511","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2113065442181042572","sortIndex":"2113129980744433631"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/281874178/1611288198"},"core":{"created_at":"Thu Apr 14 04:13:40 +0000 2011","name":"特許庁","screen_name":"jpo_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODE4NzQxNzg=","is_bl