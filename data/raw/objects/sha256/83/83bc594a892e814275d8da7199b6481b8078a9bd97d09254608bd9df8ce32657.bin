ews":{"count":"8836","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113118910379872636","sortIndex":"2113129980744433662"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3047717,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1890},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2113118173818224932"],"editable_until_msecs":"1792645207000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":274,"bookmarked":false,"conversation_id_str":"2113118173818224932","created_at":"Thu Oct 22 04:00:07 +0000 2026","display_text_range":[0,56],"entities":{},"favorite_count":10352,"favorited":false,"full_text":"今回のPHPの脆弱性対応のため、現在もウェブサイトを一時停止されている事業者などの皆様もいらっしゃると思います。","id_str":"2113118173818224932","is_quote_status":false,"lang":"ja","quote_count":130,"reply_count":126,"retweet_count":2652,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"3569246426","indices":[393,408],"name":"国家サイバー統括室(注意・警戒情報)","screen_name":"cyber_forecast"}]},"id":"Tm90ZVR3ZWV0OjIxMTMxMTgxNzM3NTk0NDcwNDA=","richtext":{"richtext_tags":[]},"text":"今回のPHPの脆弱性対応のため、現在もウェブサイトを一時停止されている事業者などの皆様もいらっしゃると思います。\n\n昨日は、高市早苗公式サイトも、すぐに事務所からサイト管理者、サーバー管理者に連絡をしてアクセスができない状態にした上、対応を行ってきましたが、先ほど措置が終了し、アクセスを再開できるようになりました。\n\n状況によっては、サイトを一時的に停止することも重要だと私自身も改めて感じた次第です。\n\n企業を含めサイトを開設されている方々の中には、深夜の対応が必要な場合など、今回のような注意・警戒情報にすぐには気付かない方もいらっしゃると思います。\n\nそうした場合、個社の中でサイト管理を担当されている方、あるいは委託を受けているサイト管理者やサーバー管理者の方が気付くことで、早急に対応に着手することができると思います。\n\n政府では、\n 国家サイバー統括室(注意・警戒情報)（@cyber_forecast） / X\nのアカウントで、重要な注意・警戒情報の発信を行っています。\n\nサイト管理者やサーバー管理者の皆様が、このアカウントを広くフォローして下さることが迅速な対応に繋がるのではないかと、今回の対応を通じて感じました。"}}},"rest_id":"2113118173818224932","unmention_data":{},"views":{"count":"224620","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113118173818224932","sortIndex":"2113129980744433661"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":7},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1669644725908049922/31IO4zqt_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/3720424033/1647955077"},"core":{"created_at":"Tue Sep 29 00:54:57 +0000 2015","name":"出入国在留管理庁（Immigration Services Agency）","screen_name":"MOJ_IMMI"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozNzIwNDI0MDMz","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2104707734738514141"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"出入国在留管理庁(Immigration Services Agency)の公式Xアカウントです。皆様のお役に立つ情報を発信します。当アカウントへのリプライ等に対して個別の対応はいたしません。運用方針等はこちらです。→https://t.co/wZ7zE5al6a","entities":{"description":{"urls":[{"display_url":"moj.go.jp/isa/publicatio…","expanded_url":"https://www.moj.go.jp/isa/publications/publications","indices":[109,132],"url":"https://t.co/wZ7zE5al6a"}]},"url":{"urls":[{"display_url":"moj.go.jp/isa/index.html","expanded_url":"https://www.moj.go.jp/isa/index.html","indices":[0,23],"url":"https://t.co/KXxqAfgmz0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"fo