Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112837922479325613"],"editable_until_msecs":"1792578390000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":160,"bookmarked":false,"conversation_id_str":"2112837922479325613","created_at":"Wed Oct 21 09:26:30 +0000 2026","display_text_range":[0,77],"entities":{},"favorite_count":10950,"favorited":false,"full_text":"【高市内閣発足1周年に当たり⑦】\n\n今日から、高市内閣2年目の「挑戦」が始まります。\n\n目下の重要政策は、「世界的な物価高」を受けての更なる対策強化です。","id_str":"2112837922479325613","is_quote_status":false,"lang":"ja","quote_count":435,"reply_count":2102,"retweet_count":1317,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1021kaiken.html","indices":[222,245],"url":"https://t.co/gZivRB3Y5P"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4Mzc5MjI0MDgwMDk3Mjg=","richtext":{"richtext_tags":[]},"text":"【高市内閣発足1周年に当たり⑦】\n\n今日から、高市内閣2年目の「挑戦」が始まります。\n\n目下の重要政策は、「世界的な物価高」を受けての更なる対策強化です。\n\n「決断と挑戦、そして実行の内閣」として、「重要な政策転換」を「実行」に移し､その「成果」を､日本列島の隅々までお届けしてまいります。\n\n「日本列島を、強く豊かに。」\n\n高市内閣の更なる歩みに、国民の皆様のご理解とご協力をお願い申し上げます。\n\n（参考）令和8年10月21日の会見の動画\nhttps://t.co/gZivRB3Y5P"}}},"rest_id":"2112837922479325613","unmention_data":{},"views":{"count":"1039747","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112837922479325613","sortIndex":"2113129980744433603"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet