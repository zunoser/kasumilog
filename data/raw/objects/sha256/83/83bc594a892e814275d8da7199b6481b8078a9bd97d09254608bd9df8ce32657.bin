/x.com/kantei/status/2112840172358558196/video/1","ext_media_availability":{"status":"Available"},"id_str":"2112838936951427073","indices":[129,152],"media_key":"13_2112838936951427073","media_results":{"result":{"media_key":"13_2112838936951427073"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2112838936951427073/img/02jcsVMXu4yQeaib.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/4623sZSFmL","video_info":{"aspect_ratio":[16,9],"duration_millis":1084966,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2112838936951427073/pl/jl9wicbERojVeLbk.m3u8?tag=29&v=d3f"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112838936951427073/vid/avc1/480x270/EL9XbIoFb6Bi2gg4.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112838936951427073/vid/avc1/640x360/PrGD_IHOFIszdyUc.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112838936951427073/vid/avc1/1280x720/iHBCBpOqiRf5eIp7.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/4623sZSFmL","expanded_url":"https://x.com/kantei/status/2112840172358558196/video/1","ext_media_availability":{"status":"Available"},"id_str":"2112838936951427073","indices":[129,152],"media_key":"13_2112838936951427073","media_results":{"result":{"media_key":"13_2112838936951427073"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2112838936951427073/img/02jcsVMXu4yQeaib.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/4623sZSFmL","video_info":{"aspect_ratio":[16,9],"duration_millis":1084966,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2112838936951427073/pl/jl9wicbERojVeLbk.m3u8?tag=29&v=d3f"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112838936951427073/vid/avc1/480x270/EL9XbIoFb6Bi2gg4.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112838936951427073/vid/avc1/640x360/PrGD_IHOFIszdyUc.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2112838936951427073/vid/avc1/1280x720/iHBCBpOqiRf5eIp7.mp4?tag=29"}]}}]},"favorite_count":6360,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２１日）、高市総理は、総理就任１年の節目を迎えての会見を行いました。\n\n※要旨（速報版）\n（高市総理）\n　皆様こんにちは。\n　本日、内閣総理大臣に就任してから１年の節目を迎えました。\n　自民党総裁選挙に３回にわたって挑戦する中で、 https://t.co/4623sZSFmL","id_str":"2112840172358558196","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":111,"reply_count":446,"retweet_count":834,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4NDAxNzIwNzMzNzM2OTY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２１日）、高市総理は、総理就任１年の節目を迎えての会見を行いました。\n\n※要旨（速報版）\n（高市総理）\n　皆様こんにちは。\n　本日、内閣総理大臣に就任してから１年の節目を迎えました。\n　自民党総裁選挙に３回にわたって挑戦する中で、\n・エネルギー資源安全保障、防災、健康医療安全保障など、リスクを最小化するための「危機管理投資」、\n・また、日本の優れた技術を社会実装するための「成長投資」、\nこれを促進することで、「安全な国創り」と「強い経済」を実現しなければならないと、一貫して訴えてまいりました。\n　最初に総裁選挙に挑戦した２０２１年の時点で、既に、世界は大きな転換点にございました。\n　各国は、巨額かつ長期にわたる「戦略的な産業政策」を競い合い、高度な技術、人材、投資を巡る国家間の競争が激しさを増しつつありました。\n　「今やらなければ間に合わない」という強い危機感を胸に、３回目の総裁選挙で自民党総裁となり、総理就任後は、早速「実行」に向けて動き出しました。\n　今年２月の衆議院議員選挙では、総理としての進退をかけ、『政権公約』として、「危機管理投資」と「成長投資」を実行するための「責任ある積極財政」の方向性をお示しするとともに、「今、重要な政策転換に『挑戦』しなければ間に合わない」と強く訴え、国民の皆様に信を問いました。\n　「公約」を一つずつ着実に実現していくことこそが使命であるとの思いで、この１年間は走り続けてまいりました。\n　臨時国会と今年の特別国会を通じて、政府提出法案「７４本」を、全て成立させることができました。\n　「責任ある積極財政」は、まさに、「日本経済が音を立てて動き出す」ことを目指した闘いです。\n　産業界や地方公共団体のご理解も得て、今、「世の中の空気」は変わりつつあると感じています。\n　数値上も、日本経済には、「確かな変化」が表れています。\n　「ＧＤＰ」は、名目で、「７００兆円経済」が視野に入ってきました。\n　春季労使交渉の「賃上げ率」は、３年連続で５％を超えています。\n　１年前は４万円台だった「株価」は、６万５０００円を超える水準となるなど、市況の上昇もありまして、「国や地方自治体が保有する金融資産」は、１年間で８０兆円増加して、９９０兆円を超えました。\n　皆様の年金を運用しているＧＰＩＦの「２０２５年度の運用益」は、前年度から４０兆円近く増加しました。\n　昨年度の「税収」は、前年度よりも約９兆円増加し、過去最高の８４．２兆円となりました。\n　日本経済は、３０年近く続いたデフレ的な経済構造の下、「働いても、なかなか賃金が上がらない」という停滞から、「経済の好循環」への道へ踏み出せるかどうかの「分岐点」にございます。\n　この変化の兆しを一時的なものに終わらせないため、『日本成長戦略』と『地域未来戦略』を両輪に、「予算編成方針」も大胆に見直しました。政府が一歩前に出て、「国内投資の呼び水」として、大規模かつ長期の、予見可能性の高い財政支出を計画的に行い、大胆な「民間国内投資」を力強く引き出してまいります。\n　「成長」なくして、「賃上げ」も、「税収増」も、「社会保障の充実」もありません。\n　だからこそ、国民の皆様の「手取り」を増やせる「強い経済」を実現しながら､｢財政の持続可能性｣も確保する｡\n　その両方を実現する「責任ある積極財政」を掲げてまいりました。\n　高市内閣の成長戦略は、一部の都市や大企業だけのものではございません。\n　日本の大きな伸び代は、「地方」にあります。\n　『地域未来戦略』によって、「地方の景色を一変させよう」という地方自治体の皆様のあふれんばかりの「情熱」と「挑戦」を、国が二人三脚で支え、日本列島の隅々まで「産業クラスターの花」を咲かせてまいります。\n　また、『自民党総裁選挙公約』や『政権公約』で掲げさせていただきました「重要な政策転換」である\n・「政府のインテリジェンス機能の強化」\n・「安全保障政策の抜本的強化」\nについても、着実に具体化を進めてまいりました。\n　「インテリジェンス機能を強化」するために、「国家情報会議」と「国家情報局」を設置しました。\n　しかし、これは第一歩にすぎません。\n　政府の情報活動の「中長期的な推進方策」を『国家情報戦略』として取りまとめるとともに、更なる「機能強化」にも取り組んでまいります。\n　「情報力」を強くするということは、「外交力」「防衛力」「経済力」「技術力」の強化にもつながりますから、「総合的な国力」を強化する上でも、必要です。\n　「総合的な国力」の強化に向けては、「防衛力」のみならず「技術力」や「経済安全保障」にも深く関わる『三文書』も見直してまいります。\n　この１年間、日本列島は、「令和８年熊本地震」をはじめ、地震、台風、豪雨など、度重なる自然災害に見舞われました。\n　改めて、お亡くなりになった方々に哀悼の誠を捧げますとともに、謹んで御遺族の皆様にお悔やみを申し上げます。\n　そして被災された全ての方々に、心からお見舞いを申し上げます。\n　何よりも「人命」を守ることを最優先に、迅速な「避難支援」、被災者の方々の「生活と生業の再建」、「インフラの復旧・復興」に向けて全力で取り組んできました。これからも、そういたします。\n　今日から、高市内閣２年目の「挑戦」が始まります。\n　目下の重要政策は、「世界的な物価高」を受けての更なる対策強化でございます。\n　「決断と挑戦、そして実行の内閣」として、「重要な政策転換」を「実行」に移し､その「成果」を､日本列島の隅々までお届けしてまいります。もちろん、国民の皆様のお手元にお届けすること、これが最優先でございます。\n　「日本列島を、強く豊かに。」\n　高市内閣の更なる歩みに、国民の皆様のご理解とご協力をお願い申し上げます。\n　私からは以上です。\n\n（記者）\n　総理、冒頭の発言でもありましたけれども、改めてお伺いさせていただきます。高市内閣が発足して、今日で１年となります。この間、注力した政策とその成果をお聞きします。また、内政や外交における今後の課題をどのように捉え、取り組んでいくお考えか、教えてください。\n\n（高市総理）\n　ありがとうございます。\n　ロシアのウクライナ侵略によって、エネルギーや穀物の価格高騰が生じていた中での、内閣総理大臣への就任でした。\n　さらに、本年２月には、中東情勢の悪化により、エネルギーをはじめ、世界的に、物価高騰は加速しました。\n　そのような中で、内閣の最優先課題として取り組んできたのが「物価高対策」です。\n　例えば、\n・「ガソリン・軽油の暫定税率廃止」に１．７兆円、\n・「子育て世帯への支援」に３，６７７億円、\n・「中東情勢を受けた燃料油補助」に１兆４，０８５億円、\n・「電気・ガス料金支援」に１兆４３１億円\nを措置するなど、「切れ目のない物価高対策」に取り組んでまいりました。\n　また、２．１兆円措置した「重点支援地方交付金」に基づく措置については、これから地方自治体により執行されるものもございます。\n　また、１．８兆円規模の税制改正で措置した｢所得税の負担軽減｣も、納税者お一人あたり、３万円から６万円を、今年の年末調整でお届けします。\n　こうした政策の効果もありまして、「物価上昇率」は、１年前は＋２．９％でしたが、現在、Ｇ７で最も低い水準の＋１．９％に抑えられています。\n　また、「物価の伸び」を「賃金の伸び」がどれだけ上回ったかを示す「実質賃金上昇率」も、１年前は「マイナス」でした。直近では９か月連続プラスで、Ｇ７で最も高い水準の１．９％になりました。\n　しかしながら、その成果を十分「実感」できていない方々が多くおられることも、重く受け止めております。\n　特に「飲食料品」は、一般的な物価上昇率より高い＋３％程度で上昇をしています。\n特に低価格品への切替えなど節約余地の小さい低所得世帯にとっては、より大きな負担となっています。\n　だからこそ、「切れ目のない物価高対策」の手を緩めることなく、『消費税・支援金法案』を今国会に提出させていただきました。\n　外交では、本年５月に、『進化したＦＯＩＰ』を発表しました。これは､エネルギーや重要物資のサプライチェーンを強化するため、『パワー・アジア』を含め、「インド太平洋諸国」や「中東諸国」との協力や連携を深めてきたものでございます。\n　また、「日米同盟」を更に揺るぎないものとして、我が国の「平和」と「安定」を追求してまいりました。\n　「ともに、強く豊かに」という方針の下、ＡＳＥＡＮ、ＡＰＥＣ、Ｇ２０を含む一連の外交機会を捉えて､各国との連携を深めて、国際社会の共通課題に一致して立ち向かっていく、そういう機運を高めてまいりたいと考えております。\n\n（記者）\n　この１年で得た教訓や反省みたいなものがありましたら、教えていただけますでしょうか。\n\n（高市総理）\n　この１年で得た教訓や反省ですね。非常に難しいご質問です。\n　とにかくこの１年は国際情勢が目まぐるしく変わりました。中東情勢の悪化、それもいつ出口が見えるのかわからない。そういう状況の中で、今打てる、最善の手を打ってまいりました。\n　ですから、常に世界中の情勢、情報をしっかりと集めて、週に何度も、頻繁に国家情報局長、また外務省などからの説明も受けております。国家安全保障局長からの説明を受けております。\n　そんな中で世界中に目を配りながら、それが日本にどういう影響を及ぼすのか、先手先手で予想しながら政策を構築していく、その重要性というものを十分に認識した、これまで以上に認識したということでございます。\n\n（記者）\n　反省点はなにか、お感じになられたことは何かございますか。\n\n（高市総理）\n　たとえば物価高対策ですね。先ほど申し上げましたけれども、十分じゃないというお声がたくさんあると承知をしております。\n　しかしながら、昨年１０月の高市内閣の発足以降、約１０．９兆円の規模でございます。やれる限りのことは切れ目なくやってきている。それにさらにですね、今年度中に給付をというお声もあるんですけれども、まだ既に決めた給付が行き届いていないところもあります。年末調整で返ってくるお金もございますので、そういうことを考えますと、皆様の大事な税金ですから、これは必要なときに、でも本当に必要な、緊要性のあるときには躊躇なく予備費も活用させていただくということで取組を続けていきとうございます。\n　一番、今、世界各国に比べて日本の物価上昇率が低く抑えられている要因というのは、これはガソリン、軽油、重油、灯油、それと対象にした航空機燃料もそうですけれども、この燃料油補助だったと思います。日本で例えばガソリンがリッター当たり１７０円前後というところでですね、国によってはリッター当たり３００円台後半から、時には４００円を超えるというような先進国もある中で、日本は一番低く抑えられている。それは回り回って、お車をお持ちでない方も、輸送コストが下がっていたり、地域の色んな産業で使われる油ですから、これは皆様の生活に、生活を少しでも楽にするために貢献できていると、本当にＧ７諸国の中で最も低い価格を維持しているというのは貢献できていると思うのですが、的確にそういった情報をお伝えしきれていないということです。\n　もう少ししっかりと国民の皆様への発信を強化しながら、今できること、そしてこれからやることを見通していただける、そういった広報のあり方というのも考えていかなきゃいけないな、これが反省点でございます。\n\n（記者）\n　高市政権発足から１年ということで、同時に連立のパートナーの日本維新の会との連立を組んでからも１年ということになりますけれども、この１年間、維新の会と連立を組んでみて、いかがだったのかということと、今後の連立のあり方についてお考えをお聞かせいただければと思います。\n\n（高市総理）\n　はい。\n　日本維新の会の皆様には感謝してもしきれないぐらいの思いを持っております。\n　昨年、私は自民党総裁にはなれたけれども、総理にはなれないんじゃないかというような状況でございました。衆・参ともに自民党は少数でございましたし、そしてまた残念ながら公明党の離脱、政権離脱ということもある中で、日本維新の会がですね、連立を組もうと言ってくださった。しかも、この「連立政権合意書」の中には、私自身が総裁選挙で訴えた政策、これも私の著書も含めて、また自民党総裁選挙のときの「自由民主」に出た、１人１枚ずつのスペースを賜った公約まで細かく読み込んでいただいた上で、合意書を作る作業をともにやりました。\n　ですから、そういったご配慮に大変感謝をいたしております。\n　また、無駄なものはカットしていこう、もっと有効なことに使っていこうとか、できる限り現役世代の負担を減らしていこう、こういった取り組みのエンジンになっていただいている。そのように考えております。\n　これからも「連立政権合意書」に記された内容を１つずつ実行に移していく。そして先般の内閣改造におきましては、初めて政務三役に参加をしていただきましたので、また新たなスタートだと思いますので、ともにですね、責任をより重く担っていただくパートナーとして歩んでいきたいな、そんなふうに考えております。"}}},"rest_id":"2112840172358558196","unmention_data":{},"views":{"count":"241281","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112840172358558196","sortIndex":"2113129980744433605"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":606},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1432867630298419206/Uez_q2Zx_normal.png"},"banner":{"image_url":"https://pbs.twim