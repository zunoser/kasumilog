jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3047717,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1890},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112837515472445574"],"editable_until_msecs":"1792578292000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":90,"bookmarked":false,"conversation_id_str":"2112837515472445574","created_at":"Wed Oct 21 09:24:52 +0000 2026","display_text_range":[0,106],"entities":{},"favorite_count":7023,"favorited":false,"full_text":"【高市内閣発足1周年に当たり⑥】\n\n就任以来、10か国を訪問、13回の国際会議に出席、48の国・機関との間で会談などを実施し、米国、韓国、インド、ASEAN、G7などとの首脳外交で信頼関係を構築してまいりました。","id_str":"2112837515472445574","is_quote_status":false,"lang":"ja","quote_count":88,"reply_count":409,"retweet_count":827,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1021kaiken.html","indices":[367,390],"url":"https://t.co/gZivRB3Y5P"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4Mzc1MTU0MDUzNzM0NDA=","richtext":{"richtext_tags":[]},"text":"【高市内閣発足1周年に当たり⑥】\n\n就任以来、10か国を訪問、13回の国際会議に出席、48の国・機関との間で会談などを実施し、米国、韓国、インド、ASEAN、G7などとの首脳外交で信頼関係を構築してまいりました。\n\n本年5月に、『進化したFOIP』を発表し､エネルギーや重要物資のサプライチェーンを強化するため、『パワー・アジア』を含め、「インド太平洋諸国」や「中東諸国」との協力や連携を深めてきました。\n\nまた、「日米同盟」を更に揺るぎないものとし、我が国の「平和」と「安定」を追求してまいりました。\n\n「ともに、強く豊かに」との方針の下、来月からのASEAN、APEC、G20を含む一連の外交機会を捉え､各国との連携を深め、国際社会の共通課題に一致して立ち向かう機運を高めていきます。\n\n（参考）令和8年10月21日の会見の動画\nhttps://t.co/gZivRB3Y5P"}}},"rest_id":"2112837515472445574","unmention_data":{},"views":{"count":"441845","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112837515472445574","sortIndex":"2113129980744433602"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":7},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1669644725908049922/31IO4zqt_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/3720424033/1647955077"},"core":{"created_at":"Tue Sep 29 00:54:57 +0000 2015","name":"出入国在留管理庁（Immigration Services Agency）","screen_name":"MOJ_IMMI"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozNzIwNDI0MDMz","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2104707734738514141"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"出入国在留管理庁(Immigration Services Agency)の公式Xアカウントです。皆様のお役に立つ情報を発信します。当アカウントへのリプライ等に対して個別の対応はいたしません。運用方針等はこちらです。→https://t.co/wZ7zE5al6a","entities":{"description":{"urls":[{"display_url":"m