analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":38407,"bookmarked":false,"conversation_id_str":"2112890642590564386","created_at":"Wed Oct 21 12:55:59 +0000 2026","display_text_range":[0,92],"entities":{},"favorite_count":319966,"favorited":false,"full_text":"皆様に、今夜に対応して頂きたい大至急のお願いです。\n \n多くのウェブサイトで使用されているPHPに関し、PHPのセキュリティチームが、重大な２件の脆弱性に関する注意喚起を行っています。","id_str":"2112890642590564386","is_quote_status":false,"lang":"ja","quote_count":17288,"reply_count":3997,"retweet_count":79707,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"3569246426","indices":[331,346],"name":"国家サイバー統括室(注意・警戒情報)","screen_name":"cyber_forecast"}]},"id":"Tm90ZVR3ZWV0OjIxMTI4OTA2NDI1MjMzNzc2NjQ=","text":"皆様に、今夜に対応して頂きたい大至急のお願いです。\n \n多くのウェブサイトで使用されているPHPに関し、PHPのセキュリティチームが、重大な２件の脆弱性に関する注意喚起を行っています。\n \n公開しているウェブサイトでPHPを使用しているか確認し、今夜、10月21日午後11時（日本時間）に公開される修正パッチについて、可及的速やかに適用できるよう準備をお願いします。\n \n修正パッチを速やかに適用することが困難な場合は、例えばウェブサイト等を一時的に停止させることも、リスクを低減させるための有効策の一つと考えられます。\n \n国家サイバー統括室のXアカウントでも関係する情報を発信していますので、そちらも参考にして下さい。\n国家サイバー統括室(注意・警戒情報)（@cyber_forecast） / X"}}},"rest_id":"2112890642590564386","unmention_data":{},"views":{"count":"68559392","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112890642590564386","sortIndex":"2113129980744433623"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/5bEzes2ShZ"},"cashtag_attachments":[],"core":{"user_result