:640,"x":0,"y":0}],"height":416,"width":640},"sizes":{"large":{"h":416,"resize":"fit","w":640},"medium":{"h":416,"resize":"fit","w":640},"small":{"h":416,"resize":"fit","w":640},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/WWCTNO5dji"}]},"favorite_count":411,"favorited":false,"full_text":"10月20日、小田原防衛副大臣は、ジョルジオ・アリベルティ駐日EU代表部次期大使の歓迎会に出席し、同大使の着任に祝意を述べるとともに、各国の関係者らと懇談しました🇯🇵🤝🇪🇺 https://t.co/WWCTNO5dji","id_str":"2112840425153372300","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":40,"retweet_count":38,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4NDA0MjUwOTg4ODMwNzI=","text":"10月20日、小田原防衛副大臣は、ジョルジオ・アリベルティ駐日EU代表部次期大使の歓迎会に出席し、同大使の着任に祝意を述べるとともに、各国の関係者らと懇談しました🇯🇵🤝🇪🇺\n\n日本とEUの防衛協力・交流は幅広い範囲で進展しています。引き続き、日EU安全保障・防衛パートナーシップに基づき緊密に連携していきます。"}}},"rest_id":"2112840425153372300","unmention_data":{},"views":{"count":"25462","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112840425153372300","sortIndex":"2113129980744433606"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","scre