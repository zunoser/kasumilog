_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3047717,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1890},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112835327056343263"],"editable_until_msecs":"1792577771000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":79,"bookmarked":false,"conversation_id_str":"2112835327056343263","created_at":"Wed Oct 21 09:16:11 +0000 2026","display_text_range":[0,119],"entities":{},"favorite_count":5880,"favorited":false,"full_text":"【高市内閣発足1周年に当たり③】\n\n『自民党総裁選挙公約』や衆議院議員選挙時の『政権公約』で掲げた「重要な政策転換」である\n・「政府のインテリジェンス機能の強化」\n・「安全保障政策の抜本的強化」\nについても、着実に具体化を進めてきました。","id_str":"2112835327056343263","is_quote_status":false,"lang":"ja","quote_count":46,"reply_count":253,"retweet_count":766,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1021kaiken.html","indices":[413,436],"url":"https://t.co/gZivRB3qgh"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4MzUzMjY5NzY2NDcxNjg=","richtext":{"richtext_tags":[]},"text":"【高市内閣発足1周年に当たり③】\n\n『自民党総裁選挙公約』や衆議院議員選挙時の『政権公約』で掲げた「重要な政策転換」である\n・「政府のインテリジェンス機能の強化」\n・「安全保障政策の抜本的強化」\nについても、着実に具体化を進めてきました。\n\n「インテリジェンス機能を強化」するため、「国家情報会議」と「国家情報局」を設置しました。\n\nしかし、これは第一歩にすぎません。\n\n政府の情報活動の「中長期的な推進方策」を『国家情報戦略』として取りまとめるとともに、更なる「機能強化」にも取り組んでいきます。\n\n「情報力」を強くすることは、「外交力」「防衛力」「経済力」「技術力」の強化にもつながりますから、「総合的な国力」を強化する上でも、必要です。\n\n「総合的な国力」の強化に向けては、「防衛力」のみならず「技術力」や「経済安全保障」にも深く関わる『三文書』も、年末に向けて見直します。\n\n（参考）令和8年10月21日の会見の動画\nhttps://t.co/gZivRB3qgh"}}},"rest_id":"2112835327056343263","unmention_data":{},"views":{"count":"213408","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112835327056343263","sortIndex":"2113129980744433595"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_g