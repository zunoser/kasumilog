"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":384639,"following":478},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"571429134","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8055,"tweets":88638},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/yYaoVyKjKO"}}}},"edit_control":{"edit_tweet_ids":["2112876624563822900"],"editable_until_msecs":"1792587617000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2,"bookmarked":false,"conversation_id_str":"2112876624563822900","created_at":"Wed Oct 21 12:00:17 +0000 2026","display_text_range":[0,121],"entities":{},"favorite_count":51,"favorited":false,"full_text":"令和8年10月21日からの大雨について、大臣指示を行いました。\n\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、人命第一の方針の下、災害応急対策に全力で取り組むこと。","id_str":"2112876624563822900","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":1,"retweet_count":32,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4NzY2MjQ0OTY3ODc0NTY=","richtext":{"richtext_tags":[]},"text":"令和8年10月21日からの大雨について、大臣指示を行いました。\n\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、人命第一の方針の下、災害応急対策に全力で取り組むこと。\n２．地方自治体とのホットライン等を通じて情報を収集し、要請に応じて迅速に地方自治体への支援等を実施すること。"}}},"rest_id":"2112876624563822900","unmention_data":{},"views":{"count":"9966","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112876624563822900","sortIndex":"2113129980744433620"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/LOiA6lm4yv"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"description":{},"url":{"urls":[{"display_url":"fdma.go.jp","expanded_url":"http://www.fdma.go.jp/","indices":[0,23],"url":"https://t.co/YCgAnjuA83"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":876680,"following":18},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false