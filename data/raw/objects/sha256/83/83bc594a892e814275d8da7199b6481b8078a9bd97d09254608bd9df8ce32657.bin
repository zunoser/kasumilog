ranslator_type":"none"},"relationship_counts":{"followers":3047717,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1890},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112832943810855368"],"editable_until_msecs":"1792577202000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":260,"bookmarked":false,"conversation_id_str":"2112832943810855368","created_at":"Wed Oct 21 09:06:42 +0000 2026","display_text_range":[0,120],"entities":{},"favorite_count":16785,"favorited":false,"full_text":"【高市内閣発足1周年に当たり①】\n\n本日、内閣総理大臣に就任してから1周年の節目を迎えました。\n\n自民党総裁選挙に3回にわたって挑戦する中で、\n・エネルギー資源安全保障、防災、健康医療安全保障など、リスクを最小化するための「危機管理投資」、","id_str":"2112832943810855368","is_quote_status":false,"lang":"ja","quote_count":301,"reply_count":1246,"retweet_count":2083,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1021kaiken.html","indices":[634,657],"url":"https://t.co/gZivRB3qgh"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4MzI5NDM2NTk4ODA0NDg=","richtext":{"richtext_tags":[]},"text":"【高市内閣発足1周年に当たり①】\n\n本日、内閣総理大臣に就任してから1周年の節目を迎えました。\n\n自民党総裁選挙に3回にわたって挑戦する中で、\n・エネルギー資源安全保障、防災、健康医療安全保障など、リスクを最小化するための「危機管理投資」、\n・日本の優れた技術を社会実装するための「成長投資」\nを促進することで、「安全な国創り」と「強い経済」を実現しなければならないと、一貫して訴えてまいりました。\n\n最初に総裁選挙に挑戦した2021年の時点で、既に、世界は大きな転換点にありました。\n\n各国は、巨額かつ長期にわたる「戦略的な産業政策」を競い合い、高度な技術、人材、投資を巡る国家間の競争が激しさを増しつつありました。\n\n「今やらなければ間に合わない」との強い危機感を胸に、3回目の総裁選挙で自民党総裁となり、総理就任後は、早速「実行」に向けて動き出しました。\n\n今年2月の衆議院議員選挙では、総理としての進退をかけ、『政権公約』として、「危機管理投資」と「成長投資」を実行するための「責任ある積極財政」の方向性をお示しするとともに、「今、重要な政策転換に『挑戦』しなければ間に合わない」と強く訴え、国民の皆様に信を問いました。\n\n「公約」を一つずつ着実に実現していくことこそが使命であるとの思いで、この1年間は走り続けてきました。\n\n臨時国会と特別国会を通じて、政府提出法案「74本」を、全て成立させることができました。\n\n（参考）令和8年10月21日の会見の動画\nhttps://t.co/gZivRB3qgh"}}},"rest_id":"2112832943810855368","unmention_data":{},"views":{"count":"476022","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112832943810855368","sortIndex":"2113129980744433587"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072169437722296320/8bWktzdb_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/276848601/1762248306"},"core":{"created_at":"Mon Apr 04 06:12:20 +0000 2011","name":"金融庁","screen_name":"fsa_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNzY4NDg2MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関３－２－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"金融庁の公式アカウントです。\n金融庁ウェブサイトに掲載する情報を中心に情報発信します。#金融庁\nhttps://t.co/kw2wiuCipw","entities":{"description":{"urls":[{"display_url":"fsa.go.jp/copyright/s