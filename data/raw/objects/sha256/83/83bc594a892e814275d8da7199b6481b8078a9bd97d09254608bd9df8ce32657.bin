,"x":33,"y":148},{"h":27,"w":27,"x":66,"y":324},{"h":34,"w":34,"x":355,"y":300},{"h":44,"w":44,"x":213,"y":299}]}},"id_str":"2112433380210163712","indices":[143,166],"media_key":"3_2112433380210163712","media_results":{"result":{"media_key":"3_2112433380210163712"}},"media_url_https":"https://pbs.twimg.com/media/HVDe95cawAA-gJ8.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":540,"w":540,"x":0,"y":0},{"h":540,"w":474,"x":27,"y":0},{"h":540,"w":270,"x":129,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KUlUXQiHrR"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/KUlUXQiHrR","expanded_url":"https://x.com/gov_online/status/2112702910291431817/photo/1","ext_alt_text":"政府広報提供テレビ番組、「ニッポン今だラボ」の10月21日（水曜日）放送のサムネイル。創薬研究施設で研究を行う人や打合せをする人、高層ビル群などの画像を背景に、「薬のタネから実用化、創薬エコシステム、協力して進める仕組み」と書かれている。その横に出演者である今田耕司さん、森香澄さんの写真と、今田耕司さんの写真の隣に吹き出しで「官民ワンチームで連携?」と書かれている。下部には大きく「新薬開発を支援する創薬エコシステム」と書かれている。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":36,"w":36,"x":566,"y":56},{"h":37,"w":37,"x":47,"y":209},{"h":39,"w":39,"x":94,"y":458},{"h":48,"w":48,"x":502,"y":424},{"h":63,"w":63,"x":301,"y":423}]},"medium":{"faces":[{"h":36,"w":36,"x":566,"y":56},{"h":37,"w":37,"x":47,"y":209},{"h":39,"w":39,"x":94,"y":458},{"h":48,"w":48,"x":502,"y":424},{"h":63,"w":63,"x":301,"y":423}]},"orig":{"faces":[{"h":36,"w":36,"x":566,"y":56},{"h":37,"w":37,"x":47,"y":209},{"h":39,"w":39,"x":94,"y":458},{"h":48,"w":48,"x":502,"y":424},{"h":63,"w":63,"x":301,"y":423}]},"small":{"faces":[{"h":25,"w":25,"x":400,"y":39},{"h":26,"w":26,"x":33,"y":148},{"h":27,"w":27,"x":66,"y":324},{"h":34,"w":34,"x":355,"y":300},{"h":44,"w":44,"x":213,"y":299}]}},"id_str":"2112433380210163712","indices":[143,166],"media_key":"3_2112433380210163712","media_results":{"result":{"media_key":"3_2112433380210163712"}},"media_url_https":"https://pbs.twimg.com/media/HVDe95cawAA-gJ8.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":540,"w":540,"x":0,"y":0},{"h":540,"w":474,"x":27,"y":0},{"h":540,"w":270,"x":129,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KUlUXQiHrR"}]},"favorite_count":165,"favorited":false,"full_text":"／\n今夜、フジテレビほかで放送📺！\n「ニッポン 今だ！ラボ」\n※地域により放送日時が異なります。\n＼\n\n今回のテーマは【創薬エコシステム】🔎\n\n今田耕司さん・森香澄さんがナビゲート！\nナレーションは男性ブランコの浦井のりひろさん。\n難しく思われがちな国の政策を「自分ゴト」として解説。 https://t.co/KUlUXQiHrR","id_str":"2112702910291431817","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":5,"retweet_count":37,"retweeted":false,"user_id_str":"461064204"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"fujitv.co.jp/nippon_imada_l…","expanded_url":"https://www.fujitv.co.jp/nippon_imada_labo/","indices":[189,212],"url":"https://t.co/ysZVWbHtn5"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI3MDI5MTAyNDEwNjI5MTI=","text":"／\n今夜、フジテレビほかで放送📺！\n「ニッポン 今だ！ラボ」\n※地域により放送日時が異なります。\n＼\n\n今回のテーマは【創薬エコシステム】🔎\n\n今田耕司さん・森香澄さんがナビゲート！\nナレーションは男性ブランコの浦井のりひろさん。\n難しく思われがちな国の政策を「自分ゴト」として解説。\n「知るのは、今だ！」\n\n▼番組公式サイト\n（各地域での放送スケジュールや番組情報はこちら）\nhttps://t.co/ysZVWbHtn5\n\n放送後には、番組公式サイトで放送内容動画を公開するほか、\nTVerでも過去放送を配信中です！\n※再生できない場合はブラウザからご覧ください。"}}},"rest_id":"2112702910291431817","unmention_data":{},"views":{"count":"40313","state":"EnabledWithCount"}}},"user_id_str":"266566401"},"rest_id":"2113074938920005927","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count