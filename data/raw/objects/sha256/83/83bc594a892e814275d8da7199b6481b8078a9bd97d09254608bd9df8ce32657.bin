eatures":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2112868739029078016","indices":[137,160],"media_key":"3_2112868739029078016","media_results":{"result":{"media_key":"3_2112868739029078016"}},"media_url_https":"https://pbs.twimg.com/media/HVJq7HbbEAA93-4.png","original_info":{"focus_rects":[{"h":391,"w":699,"x":0,"y":137},{"h":658,"w":658,"x":20,"y":0},{"h":658,"w":577,"x":61,"y":0},{"h":658,"w":329,"x":185,"y":0},{"h":658,"w":699,"x":0,"y":0}],"height":658,"width":699},"sizes":{"large":{"h":658,"resize":"fit","w":699},"medium":{"h":658,"resize":"fit","w":699},"small":{"h":640,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/6EPpHSjvib"}]},"favorite_count":50,"favorited":false,"full_text":"【子吉川（秋田県）にレベル５氾濫特別警報発表】\nこれまでに経験したことのないような大雨で、河川の氾濫がすでに発生または、発生している可能性が極めて高くなっています。\n命の危険が迫っているため直ちに身の安全を確保してください。\nhttps://t.co/giG51HE90p https://t.co/6EPpHSjvib","id_str":"2112868941802717560","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":34,"retweeted":false,"user_id_str":"2335919749"},"rest_id":"2112868941802717560","unmention_data":{},"views":{"count":"9860","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112868941802717560","sortIndex":"2113129980744433618"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3047717,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":591,"tweets":1890},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2112863360681406954"],"editable_until_msecs":"1792584454000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":120,"bookmarked":false,"conversation_id_str":"2112863360681406954","created_at":"Wed Oct 21 11:07:34 +0000 2026","display_text_range":[0,104],"entities":{},"favorite_count":11534,"favorited":false,"full_text":"現在、東北地方や北陸地方の日本海側で前線に伴う大雨となっています。\n\n本日（21日）19時45分、秋田県・子吉川に「レベル５氾濫特別警報」が発表されました。\n既に氾濫が発生又は切迫している状況となっています。","id_str":"2112863360681406954","is_quote_status":false,"lang":"ja","quote_count":90,"reply_count":365,"retweet_count":1383,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTI4NjMzNjA2MjY4NzY0MTY=","richtext":{"richtext_tags":[]},"text":"現在、東北地方や北陸地方の日本海側で前線に伴う大雨となっています。\n\n本日（21日）19時45分、秋田県・子吉川に「レベル５氾濫特別警報」が発表されました。\n既に氾濫が発生又は切迫している状況となっています。\n\n政府としては、警戒態勢強化のため、19時45分、官邸危機管理センターに「官邸連絡室」を設置しました。\n私から、被害状況の把握などの災害応急対策、国民の皆様に対する適時的確な情報提供などを指示し、対応に当たっています。\n\n特別警報が発表中の地域の皆様は、浸水しにくい高い場所などで、直ちに身の安全を確保して下さい。\n屋外の移動が危険な場合は、自宅の２階などへの垂直避難をするなど命を守る行動をとって下さい。\n\n他の地域においても、今後の天候によっては、特別警報が発表される可能性があります。\n雨や風が強くなる前に備えを確認した上で、ラジオ・テレビ・インターネットなどで、自治体からの最新の避難情報に十分注意し、少しでも危険を感じれば、躊躇せず、早め早めに自らの命を守る行動をとっていただきますようお願いいたします。"}}},"rest_id":"2112863360681406954","unmention_data":{},"views":{"count":"1223615","state":"EnabledWithCount"}}}}},"entryId":"tweet-2112863360681406954","sortIndex":"2113129980744433617"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2112817483854012416/OM2Hbeu2?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66516","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2112817483854012416/OM2H