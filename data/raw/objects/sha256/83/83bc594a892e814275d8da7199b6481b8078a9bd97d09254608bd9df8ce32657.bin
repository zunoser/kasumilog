ity":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":5,"bookmarked":false,"conversation_id_str":"2113103061174333825","created_at":"Thu Oct 22 03:00:03 +0000 2026","display_text_range":[0,19],"entities":{"media":[{"display_url":"pic.x.com/r4Il2R4XUT","expanded_url":"https://x.com/MLIT_JAPAN/status/2113103061174333825/photo/1","ext_alt_text":"※本画像の内容は、生成AIにより作成・加工されています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":52,"w":52,"x":704,"y":262}]},"medium":{"faces":[{"h":52,"w":52,"x":704,"y":262}]},"orig":{"faces":[{"h":52,"w":52,"x":704,"y":262}]},"small":{"faces":[{"h":29,"w":29,"x":398,"y":148}]}},"id_str":"2110914758706884608","indices":[20,43],"media_key":"3_2110914758706884608","media_results":{"result":{"media_key":"3_2110914758706884608"}},"media_url_https":"https://pbs.twimg.com/media/HUt5yffacAAMdTn.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":128},{"h":800,"w":800,"x":0,"y":0},{"h":800,"w":702,"x":0,"y":0},{"h":800,"w":400,"x":0,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/r4Il2R4XUT"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/r4Il2R4XUT","expanded_url":"https://x.com/MLIT_JAPAN/status/2113103061174333825/photo/1","ext_alt_text":"※本画像の内容は、生成AIにより作成・加工されています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":52,"w":52,"x":704,"y":262}]},"medium":{"faces":[{"h":52,"w":52,"x":704,"y":262}]},"orig":{"faces":[{"h":52,"w":52,"x":704,"y":262}]},"small":{"faces":[{"h":29,"w":29,"x":398,"y":148}]}},"id_str":"2110914758706884608","indices":[20,43],"media_key":"3_2110914758706884608","media_results":{"result":{"media_key":"3_2110914758706884608"}},"media_url_https":"https://pbs.twimg.com/media/HUt5yffacAAMdTn.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":128},{"h":800,"w":800,"x":0,"y":0},{"h":800,"w":702,"x":0,"y":0},{"h":800,"w":400,"x":0,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/r4Il2R4XUT"}]},"favorite_count":22,"favorited":false,"full_text":"【あなたの行動が物流を支える｜第3回】 https://t.co/r4Il2R4XUT","id_str":"2113103061174333825","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":9,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[958,968],"text":"あなたが支える物流"},{"indices":[969,980],"text":"トラック・物流Gメン"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTMxMDMwNjA3NTA3MDA1NDQ=","text":"【あなたの行動が物流を支える｜第3回】\n\n災害の発生時や社会的な不安が高まったとき、トイレットペーパーなどの特定の商品に購入が集中することがあります。「なくなるかもしれない」と考え、いつもより多く購入したくなることもあるかもしれません。しかし、多くの人が同じタイミングで必要以上に購入すると、物流の各現場に短期間で大きな負荷がかかります。\n\n店舗では棚の商品が急速に減り、通常より多くの商品を短時間で補充する必要が生じます。倉庫や物流センターでは、同じ商品の注文や出荷準備が集中し、保管していた商品を急いで仕分け、店舗別にまとめる作業が増えます。輸送の現場でも、限られた車両と人員の中で、急増した物量への対応が必要になります。\n\n商品が一時的に店頭から少なくなっていても、必ずしも社会全体の在庫がなくなったとは限りません。需要が短期間に集中し、補充や輸送が追いつかなくなっている場合もあります。こうしたときにさらに買いだめが広がると、本当に商品を必要としている人へ行き渡りにくくなり、店舗、倉庫、輸送の負担も一層高まります。\n\n私たちにできることは、公的機関や事業者などから発信される正確な情報を確認し、落ち着いて、家庭で必要な量を購入することです。一人ひとりが必要以上の買いだめを控えることで、商品の需要が平準化され、店舗への補充や倉庫での仕分け、輸送も計画的に進めやすくなります。\n\n必要な商品を、本当に必要な人へ安定して届けるために。買い物の際には、まず必要な量を考えてみませんか。日々の選択が、物流で働く人たちの負担を抑え、持続可能な物流を支えることにつながります。\n\n物流の現場には、一度に運べる量や、対応できる車両・作業者の数に限りがあります。需要が急に増えても、トラックや作業者をすぐに増やせるとは限りません。通常とは異なる物量への対応が続けば、ほかの商品を運ぶ計画や、物流で働く人たちの業務にも影響が広がる可能性があります。\n\n自分の家庭に本当に必要な量を確認し、周囲の人も購入できる量を残すという視点を持つことが大切です。買いだめをしないことは、単なる買物のマナーではなく、限られた物流の力を社会全体で有効に使うための協力でもあります。\n※本画像の内容は、生成AIにより作成・加工されています。\n\n#あなたが支える物流\n#トラック・物流Gメン"}}},"rest_id":"2113103061174333825","unmention_data":{},"views":{"count":"2497","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113103061174333825","sortIndex":"2113129980744433653"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1224123536375083008/E7_kBUOM_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2335919749/1644473153"},"core":{"created_at":"Mon Feb 10 01:39:30 +0000 2014","name":"農林水産省","screen_name":"MAFF_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzM1OTE5NzQ5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2092927185678127486"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"農林水産省の公式アカウントです。ご意見・ご質問は、総合窓口にお寄せください。\n総合窓口→https://t.co/XLQwxIPiHh\n運用方針→https://t.co/2SnzXCNurZ","entities":{"description":{"urls":[{"display_url":"contactus.maff.go.jp/voice/sogo.html","expanded_url":"https://www.contactus.maff.go.jp/voice/sogo.html","indices":[44,67],"url":"https://t.co/XLQwxIPiHh"},{"display_url":"maff.go.jp/j/pr/social_me…","expanded_url":"https://www.maff.go.jp/j/pr/social_media/policy.html","indices":[73,96],"url":"https://t.co/2SnzXCNurZ"}]},"url":{"u