se,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":69,"tweets":276},"verification":{"verified":false},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2090402489086656596"],"editable_until_msecs":"1787229365000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2090402489086656596","created_at":"Thu Aug 20 11:36:05 +0000 2026","display_text_range":[0,125],"entities":{},"favorite_count":292,"favorited":false,"full_text":"【8月20日　小泉防衛大臣臨時会見】\n北朝鮮による弾道ミサイル発射に伴い、臨時会見を行いました。\n \n↓発表事項の全文はこちら\n「北朝鮮は、日本時間の１７時４分頃、弾道ミサイルを発射しました。\n詳細については、現在、日米韓で緊密に連携して分析中です。","id_str":"2090402489086656596","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":3,"retweet_count":51,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/8Di5Cad2-RM?si…","expanded_url":"https://youtu.be/8Di5Cad2-RM?si=VMDihs_w1XWuNJLK","indices":[717,740],"url":"https://t.co/0PsbAk0xrn"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTA0MDI0ODg5Mzk5NDU5ODQ=","text":"【8月20日　小泉防衛大臣臨時会見】\n北朝鮮による弾道ミサイル発射に伴い、臨時会見を行いました。\n \n↓発表事項の全文はこちら\n「北朝鮮は、日本時間の１７時４分頃、弾道ミサイルを発射しました。\n詳細については、現在、日米韓で緊密に連携して分析中です。\n落下したのは、日本海の我が国の排他的経済水域外であると推定しています。\n総理には、本件について直ちに報告を行い、情報収集・分析に全力を挙げ、国民に対して迅速・的確な情報提供を行うこと。航空機、船舶等の安全確認を徹底すること。\n不測の事態に備え、万全の態勢をとること。\n以上３点について指示がありました。\nまた、防衛省においては、防衛大臣が総理指示を受け、アメリカ、韓国等と緊密に連携しつつ、情報収集・分析に全力を挙げること。\n不測の事態の発生に備え、引き続き、警戒監視に万全を期すことの２点について、秘書官を通じて指示を出しました。\n現在までのところ、航空機や船舶からの被害報告等の情報は確認されておりません。\nなお、東京では、宮崎副大臣が指揮を執って、本事案の対応を行っています。\nこれまでの弾道ミサイル等の度重なる発射も含め、一連の北朝鮮の行動は、我が国、地域及び国際社会の平和と安全を脅かすものです。\nまた、このような弾道ミサイル発射は関連する安保理決議に違反し、国民の安全に関わる重大な問題です。\n今回の発射については、我が国として北朝鮮に対し、北京の大使館ルートを通じて厳重に抗議し、強く非難しました。\n防衛省としては、国民の生命・財産を守り抜くため、引き続き、アメリカや韓国等とも緊密に連携し、情報の収集・分析及び警戒監視に全力を挙げてまいります。」\n\n↓動画はこちら\nhttps://t.co/0PsbAk0xrn"}}},"rest_id":"2090402489086656596","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"25745","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2090402670637142289","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4137","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090402670637142289","sortIndex":"2090514194834128890"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description"