,"y":195},{"h":1365,"w":1365,"x":393,"y":0},{"h":1365,"w":1197,"x":477,"y":0},{"h":1365,"w":683,"x":734,"y":0},{"h":1365,"w":2048,"x":0,"y":0}],"height":1365,"width":2048},"sizes":{"large":{"h":1365,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/7QOe6HSiSr"}]},"favorite_count":604,"favorited":false,"full_text":"8月20日、インドを訪問中の小泉防衛大臣は、シン国防大臣と日印防衛相会談を実施しました。両大臣は、日本とインドの「特別戦略的グローバル・パートナーシップ」のもと、両国の防衛面の連携が着実に強化されてきたことを歓迎するとともに、海洋安全保障協力に関する覚書に署名し、自由で開かれたイン https://t.co/7QOe6HSiSr","id_str":"2090397946596438385","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":7,"retweet_count":95,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/approach/exc…","expanded_url":"https://www.mod.go.jp/j/approach/exchange/area/2026/20260820_ind-j.html","indices":[192,215],"url":"https://t.co/wzFJGmSW1h"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTAzOTc5NDY0ODMyOTgzMDQ=","text":"8月20日、インドを訪問中の小泉防衛大臣は、シン国防大臣と日印防衛相会談を実施しました。両大臣は、日本とインドの「特別戦略的グローバル・パートナーシップ」のもと、両国の防衛面の連携が着実に強化されてきたことを歓迎するとともに、海洋安全保障協力に関する覚書に署名し、自由で開かれたインド太平洋の実現のため防衛協力を一層深化させていくことを確認しました。\n\n日印共同プレスステートメント：https://t.co/wzFJGmSW1h"}}},"rest_id":"2090397946596438385","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"24886","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090397946596438385","sortIndex":"2090514194834128889"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"Ti