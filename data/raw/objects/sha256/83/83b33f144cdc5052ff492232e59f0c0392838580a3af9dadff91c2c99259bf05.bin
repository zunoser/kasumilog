normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39630,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":69,"tweets":276},"verification":{"verified":false},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2090403275837432118"],"editable_until_msecs":"1787229553000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2090403275837432118","created_at":"Thu Aug 20 11:39:13 +0000 2026","display_text_range":[0,116],"entities":{},"favorite_count":227,"favorited":false,"full_text":"【8月20日　宮﨑防衛副大臣臨時会見】\n\n北朝鮮による弾道ミサイル発射に伴い、臨時会見を行いました。\n\n↓発表事項の全文はこちら\n「北朝鮮は本日１７時４分頃、北朝鮮内陸部から複数発の弾道ミサイルを北東方向に向けて発射をいたしました。","id_str":"2090403275837432118","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":2,"retweet_count":48,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/m0UdR3QTAiM?si…","expanded_url":"https://youtu.be/m0UdR3QTAiM?si=jUeJ8jRjMPpJPmXy","indices":[737,760],"url":"https://t.co/DYtzeZ0p02"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTA0MDMyNzU2NjEyNzUxMzY=","text":"【8月20日　宮﨑防衛副大臣臨時会見】\n\n北朝鮮による弾道ミサイル発射に伴い、臨時会見を行いました。\n\n↓発表事項の全文はこちら\n「北朝鮮は本日１７時４分頃、北朝鮮内陸部から複数発の弾道ミサイルを北東方向に向けて発射をいたしました。\n詳細については現在、日米韓で緊密に連携して分析中でありますが、発射された弾道ミサイルは最高高度約９０ｋｍ程度で約３２０ｋｍ程度飛翔し、落下したのは朝鮮半島東岸付近の我が国の排他的経済水域（ＥＥＺ）の外であると推定をしております。\n総理には本件について直ちに報告を行い、情報収集・分析に全力を挙げ、国民に対し、迅速・的確な情報提供を行うこと。\n航空機、船舶などの安全確認を徹底すること。\n不測の事態に備え、万全の態勢をとること。\n以上３点について御指示がありました。\nまた、防衛省においては、防衛大臣が総理指示を受け、アメリカ、韓国などと緊密に連携しつつ、情報収集・分析に全力を挙げること。\n不測の事態の発生に備え、引き続き、警戒監視に万全を期すこと。\n以上の２点につきまして指示を出したところであります。\nこれまでの弾道ミサイルなどの度重なる発射も含め、一連の北朝鮮の行動は我が国、地域、国際社会の平和と安全を脅かすものであります。\nまた、このような弾道ミサイル発射は、関連する安保理決議に違反し、国民の安全に関わる重大な問題です。\n今回の発射については、我が国として北朝鮮に対し、北京の大使館ルートを通じて厳重に抗議をし、強く非難をいたしました。\n防衛省としては、国民の生命・財産を守り抜くため、引き続き、アメリカや韓国などとも緊密に連携し、情報の収集・分析及び警戒監視に全力を挙げてまいります。\n私からは以上です。」\n\n↓動画はこちら\nhttps://t.co/DYtzeZ0p02"}}},"rest_id":"2090403275837432118","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"26199","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2090403650481070460","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4226","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090403650481070460","sortIndex":"2090514194834128891"},{"content":{"__typename":"TimelineTimel