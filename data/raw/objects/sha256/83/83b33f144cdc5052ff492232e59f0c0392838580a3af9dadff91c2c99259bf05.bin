":[141,164],"media_key":"3_2090377354409615360","media_results":{"result":{"media_key":"3_2090377354409615360"}},"media_url_https":"https://pbs.twimg.com/media/HQKDIOgbIAAPgo1.jpg","original_info":{"focus_rects":[{"h":158,"w":282,"x":0,"y":40},{"h":249,"w":249,"x":0,"y":0},{"h":249,"w":218,"x":0,"y":0},{"h":249,"w":125,"x":0,"y":0},{"h":249,"w":282,"x":0,"y":0}],"height":249,"width":282},"sizes":{"large":{"h":249,"resize":"fit","w":282},"medium":{"h":249,"resize":"fit","w":282},"small":{"h":249,"resize":"fit","w":282},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/ZowVlvw751"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/ZowVlvw751","expanded_url":"https://x.com/ModJapan_jp/status/2090377361741226488/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2090377354409615360","indices":[141,164],"media_key":"3_2090377354409615360","media_results":{"result":{"media_key":"3_2090377354409615360"}},"media_url_https":"https://pbs.twimg.com/media/HQKDIOgbIAAPgo1.jpg","original_info":{"focus_rects":[{"h":158,"w":282,"x":0,"y":40},{"h":249,"w":249,"x":0,"y":0},{"h":249,"w":218,"x":0,"y":0},{"h":249,"w":125,"x":0,"y":0},{"h":249,"w":282,"x":0,"y":0}],"height":249,"width":282},"sizes":{"large":{"h":249,"resize":"fit","w":282},"medium":{"h":249,"resize":"fit","w":282},"small":{"h":249,"resize":"fit","w":282},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/ZowVlvw751"}]},"favorite_count":1440,"favorited":false,"full_text":"１．北朝鮮は本日１７時４分頃、北朝鮮内陸部から、複数発の弾道ミサイルを、北東方向に向けて発射しました。詳細については現在日米韓で緊密に連携して分析中ですが、発射された弾道ミサイルは、最高高度約９０ｋｍ程度で、約３２０ｋｍ程度飛翔し、落下したのは朝鮮半島東岸付近の我が国の排他的経済 https://t.co/ZowVlvw751","id_str":"2090377361741226488","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":39,"quoted_status_id_str":"2090355781812326586","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2090355781812326586","url":"https://t.co/uRqTSKSWKH"},"reply_count":33,"retweet_count":503,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTAzNzczNjE2MzIxODIyNzI=","text":"１．北朝鮮は本日１７時４分頃、北朝鮮内陸部から、複数発の弾道ミサイルを、北東方向に向けて発射しました。詳細については現在日米韓で緊密に連携して分析中ですが、発射された弾道ミサイルは、最高高度約９０ｋｍ程度で、約３２０ｋｍ程度飛翔し、落下したのは朝鮮半島東岸付近の我が国の排他的経済水域（ＥＥＺ）外であると推定しています。\n\n２．政府より、付近を航行する航空機や船舶への情報提供を行ったところ、現時点において被害報告等の情報は確認されていません。\n\n３．総理には、本件について直ちに報告を行い、\n①    情報収集・分析に全力を挙げ、国民に対して、迅速・的確な情報提供を行うこと\n②    航空機、船舶等の安全確認を徹底すること\n③    不測の事態に備え、万全の態勢をとること\nの３点について指示がありました。\n\n４．政府においては、官邸危機管理センターに設置している「北朝鮮情勢に関する官邸対策室」において、関係省庁からの情報を集約するとともに、緊急参集チームを招集し、対応について協議を行いました。\n\n５．また、防衛省においては、防衛大臣が総理指示を受け、\n① 米国、韓国等と緊密に連携しつつ、情報収集・分析に全力を挙げること\n② 不測の事態の発生に備え、引き続き警戒監視に万全を期すこと\nの２点について指示を出しました。\n\n６．これまでの弾道ミサイル等の度重なる発射も含め、一連の北朝鮮の行動は、我が国、地域及び国際社会の平和と安全を脅かすものです。また、このような弾道ミサイル発射は、関連する安保理決議に違反し、国民の安全に関わる重大な問題です。我が国としては、北朝鮮に対して厳重に抗議し、強く非難しました。\n\n７．国民の生命・財産を守り抜くため、引き続き、米国や韓国等とも緊密に連携し、情報の収集・分析及び警戒監視に全力をあげるとともに、今後追加して公表すべき情報を入手した場合には、速やかに発表することとします。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings