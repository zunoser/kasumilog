,"tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7837,"tweets":21910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115688336904131043"],"editable_until_msecs":"1793257981000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":20,"bookmarked":false,"conversation_id_str":"2115688336904131043","created_at":"Thu Oct 29 06:13:01 +0000 2026","display_text_range":[0,140],"entities":{},"favorite_count":944,"favorited":false,"full_text":"１．北朝鮮は、本日１２時３６分頃、弾道ミサイルの可能性があるものを発射しました。現在、日米韓で緊密に連携し、その詳細を分析中ですが、発射された弾道ミサイルの可能性があるものは朝鮮半島東岸付近に落下したと推定され、我が国の領域や排他的経済水域（ＥＥＺ）への飛来は確認されておらず、現","id_str":"2115688336904131043","is_quote_status":true,"lang":"ja","quote_count":15,"quoted_status_id_str":"2115652855051014649","quoted_status_permalink":{"display":"x.com/ModJapan_jp/st…","expanded":"https://twitter.com/ModJapan_jp/status/2115652855051014649","url":"https://t.co/RoSPa5vnOL"},"reply_count":10,"retweet_count":270,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2ODgzMzY4MjQzNjA5NjA=","richtext":{"richtext_tags":[]},"text":"１．北朝鮮は、本日１２時３６分頃、弾道ミサイルの可能性があるものを発射しました。現在、日米韓で緊密に連携し、その詳細を分析中ですが、発射された弾道ミサイルの可能性があるものは朝鮮半島東岸付近に落下したと推定され、我が国の領域や排他的経済水域（ＥＥＺ）への飛来は確認されておらず、現時点において、付近を航行する航空機や船舶の被害報告等の情報は確認されていません。\n\n２．総理には、本件について直ちに報告を行い、\n①情報収集・分析に全力を挙げ、国民に対して、迅速・的確な情報提供を行うこと\n②航空機、船舶等の安全確認を徹底すること\n③不測の事態に備え、万全の態勢をとること\nの３点について指示がありました。\n\n３．政府においては、官邸危機管理センターに設置している「北朝鮮情勢に関する官邸対策室」において、関係省庁からの情報を集約するとともに、緊急参集チームを招集し、対応について協議を行いました。\n\n４．また、防衛省においては、防衛大臣が総理指示を受け、\n① 米国、韓国等と緊密に連携しつつ、情報収集・分析に全力を挙げること\n② 不測の事態の発生に備え、引き続き警戒監視に万全を期すこと\nの２点について指示を出しました。\n\n５．これまでの弾道ミサイル等の度重なる発射も含め、一連の北朝鮮の行動は、我が国、地域及び国際社会の平和と安全を脅かすものです。\n\n６．国民の生命・財産を守り抜くため、引き続き、米国や韓国等とも緊密に連携し、情報の収集・分析及び警戒監視に全力をあげるとともに、今後追加して公表すべき情報を入手した場合には、速やかに発表することとします。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"followin