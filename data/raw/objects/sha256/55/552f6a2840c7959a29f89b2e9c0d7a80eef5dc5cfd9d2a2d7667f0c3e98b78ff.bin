display_url":"mhlw.go.jp","expanded_url":"http://www.mhlw.go.jp/","indices":[0,23],"url":"https://t.co/XJir5J4Swz"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1035409,"following":18},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"180585090","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":24670,"tweets":45211},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/XJir5J4Swz"}}}},"edit_control":{"edit_tweet_ids":["2115602065607249993"],"editable_until_msecs":"1793237413000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":6,"bookmarked":false,"conversation_id_str":"2115602065607249993","created_at":"Thu Oct 29 00:30:13 +0000 2026","display_text_range":[0,158],"entities":{"hashtags":[{"indices":[9,17],"text":"世界脳卒中デー"}],"urls":[{"display_url":"jsa-web.org/citizen/4855.h…","expanded_url":"https://www.jsa-web.org/citizen/4855.html","indices":[135,158],"url":"https://t.co/ZPTBicE5iE"}]},"favorite_count":115,"favorited":false,"full_text":"【10月29日は #世界脳卒中デー】\n脳卒中の予防や再発防止のためには、脳卒中について正しく理解し、予防と早期受診の大切さを知っていただくことが重要です。\n今年も、全国各地で世界脳卒中機構（WSO）のシンボルカラーであるインディゴ・ブルーのライトアップが行われます。\n\nhttps://t.co/ZPTBicE5iE","id_str":"2115602065607249993","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":4,"retweet_count":49,"retweeted":false,"user_id_str":"180585090"},"rest_id":"2115602065607249993","unmention_data":{},"views":{"count":"29177","state":"EnabledWit