sibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"The Official English Account of the Ministry of Foreign Affairs of Japan.\nSocial Media List: https://t.co/PnH9N7WcqL","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/about/list_en.…","expanded_url":"https://www.mofa.go.jp/about/list_en.html","indices":[93,116],"url":"https://t.co/PnH9N7WcqL"}]},"url":{"urls":[{"display_url":"mofa.go.jp","expanded_url":"http://www.mofa.go.jp/","indices":[0,23],"url":"https://t.co/jDWRcTicQE"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":154030,"following":178},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8795,"tweets":19791},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2115661938109870171"],"editable_until_msecs":"1793251687000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"data":{"associated_data":{},"destination_language":"ja","entities":{"hashtags":[],"symbols":[],"urls":[],"user_mentions":[]},"preview_translation":"スペイン、カスティーリャ・ラ・マンチャ州トレド県で発生した列車衝突事故の犠牲者の皆様に、心からの哀悼の意を表します。また、ご遺族の皆様に深くお見舞い申し上げます。負傷された方々のご回復を心よりお祈りいたします。","source_language":"en","translation":"スペイン、カスティーリャ・ラ・マンチャ州トレド県で発生した列車衝突事故の犠牲者の皆様に、心からの哀悼の意を表します。また、ご遺族の皆様に深くお見舞い申し上げます。負傷された方々のご回復を心よりお祈りいたします。\nさらに、スペイン政府から、列車の乗客リストに日本人2名が含まれていたとの連絡がありました。外務省は対応本部を設置し、現在、彼らの無事を確認すべく作業を進めております。日本政府は、スペイン当局と協力し、自国民の保護に最大限の努力を続けていく所存です。"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2115661938109870171","created_at":"Thu Oct 29 04:28:07 +0000 2026","display_text_range":[0,278],"entities":{"media":[{"display_url":"pic.x.com/JRrHnoBLX0","expanded_url":"https://x.com/MofaJapan_en/status/2115661938109870171/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115661631925702656","indices":[279,302],"media_key":"3_2115661631925702656","media_results":{"result":{"media_key":"3_2115661631925702656"}},"media_url_https":"https://pbs.twimg.com/media/HVxXC4Pa0AArJom.png","original_info":{"focus_rects":[{"h":589,"w":1052,"x":434,"y":0},{"h":589,"w":589,"x":666,"y":0},{"h":589,"w":517,"x":702,"y":0},{"h":589,"w":295,"x":813,"y":0},{"h":589,"w":1920,"x":0,"y":0}],"height":589,"width":1920},"sizes":{"large":{"h":589,"resize":"fit","w":1920},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/JRrHnoBLX0"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/JRrHnoBLX0","expanded_url":"https://x.com/MofaJapan_en/status/2115661938109870171/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115661631925702656","indices":[279,302],"media_key":"3_2115661631925702656","media_results":{"result":{"media_key":"3_2115661631925702656"}},"media_url_https":"https://pbs.twimg.com/media/HVxXC4Pa0AArJom.png","original_info":{"focus_rects":[{"h":589,"w":1052,"x":434,"y":0},{"h":589,"w":589,"x":666,"y":0},{"h":589,"w":517,"x":702,"y":0},{"h":589,"w":295,"x":813,"y":0},{"h":589,"w":1920,"x":0,"y":0}],"height":589,"width":1920},"sizes":{"large":{"h":589,"resize":"fit","w":1920},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/JRrHnoBLX0"}]},"favorite_count":97,"favorited":false,"full_text":"I would like to extend my sincere condolences to the victims of the train collision in the Province of Toledo, Castilla-La Mancha, Spain and express my sympathy to their families. I also pray for the swift recovery of those who were injured.\nFurthermore, the Government of Spain https://t.co/JRrHnoBLX0","id_str":"2115661938109870171","is_quote_status":false,"lang":"en","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":8,"retweet_count":24,"retweeted":false,"user_id_str":"303735625"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2NjE5MzgwMzAxOTA1OTI=","richtext":{"richtext_tags":[]},"text":"I would like to extend my sincere condolences to the victims of the train collision in the Province of Toledo, Castilla-La Mancha, Spain and express my sympathy to their families. I also pray for the swift recovery of those who were injured.\nFurthermore, the Government of Spain has informed us that two Japanese nationals were included on the train's passenger list. The Ministry of Foreign Affairs has established response headquarters and is currently working to confirm their safety. The Government of Japan will continue to do its utmost to ensure the protection of its nationals, in cooperation with the Spanish authorities."}}},"rest_id":"2115661938109870171","unmention_data":{},"views":{"count":"9186","state":"EnabledWithCount"}}},"rest_id":"2115663200117305460","unmention_data":{},"views":{"count":"4480","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115621937397617029","2115663200117305460"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130729","sortIndex":"2116281523115130669"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_