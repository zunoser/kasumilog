WV0OjIxMTUzOTA0NTc3MjM0NTM0NDA=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、10/27にAPECビジネス諮問委員会(ABAC)日本委員と面談。「APEC首脳への提言」を受け取るとともに、WTOの機能強化、サプライチェーン・物流の強靱化、AI・量子技術を通じた社会実装による社会課題解決、デジタル通貨とトークン化金融インフラの推進など、多岐に亘る提言内容について、説明を受けました。これを受け大臣から、ハイブリッドな通商戦略を推進する上で、ビジネス界との連携を強めていきたい旨を述べました。#meti_daijin"}}},"rest_id":"2115390457773740330","unmention_data":{},"views":{"count":"10911","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115390457773740330","sortIndex":"2116281523115130619"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":15},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/960685038957244417/qRIY3RTr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/719219671/1597226136"},"core":{"created_at":"Fri Jul 27 02:08:13 +0000 2012","name":"原子力規制委員会 / NRA Japan","screen_name":"gensiryokukisei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo3MTkyMTk2NzE=","is_blue_verified":false,"location":{"location":"日本"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2107017952050679971"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[{"icon_name":"IconBriefcaseStroke","id":713,"name":"科学・テクノロジー"}],"professional_type":"Business","rest_id":"1538427574485131264"},"profile_bio":{"description":"本アカウントは原子力規制委員会の公式アカウントです。委員会の活動や原子力規制に関わる情報をお届けします。～人と環境を守る、確かな規制へ～\n#NRAJa