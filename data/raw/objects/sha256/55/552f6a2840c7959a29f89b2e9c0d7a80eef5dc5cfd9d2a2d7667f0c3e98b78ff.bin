5,"x":310,"y":122}]},"orig":{"faces":[{"h":182,"w":182,"x":406,"y":203},{"h":208,"w":208,"x":1490,"y":601},{"h":251,"w":251,"x":672,"y":266}]},"small":{"faces":[{"h":47,"w":47,"x":106,"y":53},{"h":54,"w":54,"x":389,"y":157},{"h":65,"w":65,"x":175,"y":69}]}},"id_str":"2115420668120686592","indices":[132,155],"media_key":"3_2115420668120686592","media_results":{"result":{"media_key":"3_2115420668120686592"}},"media_url_https":"https://pbs.twimg.com/media/HVt748HaYAASqlS.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":758,"y":0},{"h":1734,"w":1521,"x":865,"y":0},{"h":1734,"w":867,"x":1192,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/2udDd3S1tK"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/2udDd3S1tK","expanded_url":"https://x.com/takaichi_sanae/status/2115420719899082981/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":459,"w":459,"x":427,"y":459}]},"medium":{"faces":[{"h":269,"w":269,"x":250,"y":269}]},"orig":{"faces":[{"h":583,"w":583,"x":543,"y":583}]},"small":{"faces":[{"h":152,"w":152,"x":142,"y":152}]}},"id_str":"2115420668250697728","indices":[132,155],"media_key":"3_2115420668250697728","media_results":{"result":{"media_key":"3_2115420668250697728"}},"media_url_https":"https://pbs.twimg.com/media/HVt748maMAAIsFx.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":85,"y":0},{"h":1734,"w":867,"x":412,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/2udDd3S1tK"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/2udDd3S1tK","expanded_url":"https://x.com/takaichi_sanae/status/2115420719899082981/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":99,"w":99,"x":1441,"y":455}]},"medium":{"faces":[{"h":58,"w":58,"x":844,"y":266}]},"orig":{"faces":[{"h":126,"w":126,"x":1830,"y":578}]},"small":{"faces":[{"h":32,"w":32,"x":478,"y":151}]}},"id_str":"2115420668112277504","indices":[132,155],"media_key":"3_2115420668112277504","media_results":{"result":{"media_key":"3_2115420668112277504"}},"media_url_https":"https://pbs.twimg.com/media/HVt748FaEAAJ4QH.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1781,"w":1781,"x":0,"y":0},{"h":1781,"w":1562,"x":0,"y":0},{"h":1781,"w":891,"x":270,"y":0},{"h":1781,"w":2600,"x":0,"y":0}],"height":1781,"width":2600},"sizes":{"large":{"h":1403,"resize":"fit","w":2048},"medium":{"h":822,"resize":"fit","w":1200},"small":{"h":466,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/2udDd3S1tK"}]},"favorite_count":11993,"favorited":false,"full_text":"本日、訪日中のフリードリヒ・メルツ・ドイツ首相@bundeskanzlerと、首脳会談をはじめ一連の首脳行事を実施しました。\n\n厳しさを増す国際情勢において、「国際社会の平和と安定」に共に貢献するとの確固たる意志を持つ、両国の連携はかつてなく重要になっています。 https://t.co/2udDd3S1tK","id_str":"2115420719899082981","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":134,"reply_count":1354,"retweet_count":1360,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"1915405915085561861","indices":[23,37],"name":"Bundeskanzler Friedrich Merz","screen_name":"bundeskanzler"}]},"id":"Tm90ZVR3ZWV0OjIxMTU0MjA3MTk3MTQ2NTIxNjA=","richtext":{"richtext_tags":[]},"text":"本日、訪日中のフリードリヒ・メルツ・ドイツ首相@bundeskanzlerと、首脳会談をはじめ一連の首脳行事を実施しました。\n\n厳しさを増す国際情勢において、「国際社会の平和と安定」に共に貢献するとの確固たる意志を持つ、両国の連携はかつてなく重要になっています。\n\n今回、価値や原則を共有する同志国である両国が「プレミアム・パートナー」として、その揺るぎない絆を世界に示すことができ、大変嬉しく存じます。\n\n会談では、メルツ首相との間で、幅広い分野における戦略的連携を一層強化することで一致し、その決意の表れとして、『日独首脳共同声明』、『先端技術協力に関する日独首脳共同宣言』及び『経済安全保障協力に関する日独首脳共同宣言』を発出しました。\n\nまた、メルツ首相とは、進化した「自由で開かれたインド太平洋（FOIP）」及びドイツの「インド太平洋ガイドライン」に沿って、協力を強化することの重要性を共有しました。\n\n本日、両国を代表する多くの企業関係者を迎え、官民合わせておよそ30の協力覚書が交換されたことも大変喜ばしく、こうした日本・ドイツ間の協力が、日本が推進する『成長戦略』とも連動し、両国の経済成長を更に後押しすることを期待しています。\n\nメルツ首相とは経済安全保障での連携についても議論し、戦略的分野での産業支援策において、双方の利益が互恵的な形で考慮される重要性を確認したほか、「強靱で信頼できるサプライチェーン」の構築に向けて取り組むことでも一致しました。\n\nこのほか、インド太平洋情勢やウクライナ情勢といった、地域及び国際場裏における課題についても強固な連携を確認できました。\n\nかけがえのない「プレミアム・パートナー」として、日本はドイツと共に成長し、国際社会が直面する諸課題の解決に貢献してまいります。"}}},"rest_id":"2115420719899082981","unmention_data":{},"views":{"count":"452482","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115420719899082981","sortIndex":"2116281523115130625"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifi