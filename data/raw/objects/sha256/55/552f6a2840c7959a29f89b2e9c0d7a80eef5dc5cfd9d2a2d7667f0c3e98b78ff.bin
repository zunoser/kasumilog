rl":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7837,"tweets":21910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115621290979848561"],"editable_until_msecs":"1793241996000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2115621257198940663","created_at":"Thu Oct 29 01:46:36 +0000 2026","display_text_range":[0,137],"entities":{},"favorite_count":110,"favorited":false,"full_text":"結果概要：\n\n１０月２８日（水）、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス）出席のためフィリピンを訪問中の小泉防衛大臣は、ピート・ヘグセス米戦争長官、リチャード・マールズ豪副首相兼国防大臣及びギルベルト・テオドロ比国防大臣との間で、日米豪比防衛相会談を実施しました。","id_str":"2115621290979848561","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2115621257198940663","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":29,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/approach/anp…","expanded_url":"https://www.mod.go.jp/j/approach/anpo/2026/1028a_usa_aus_phl-j.html","indices":[336,359],"url":"https://t.co/gJIf3n9Kg0"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2MjEyOTA4NjI0MjQwNjQ=","text":"結果概要：\n\n１０月２８日（水）、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス）出席のためフィリピンを訪問中の小泉防衛大臣は、ピート・ヘグセス米戦争長官、リチャード・マールズ豪副首相兼国防大臣及びギルベルト・テオドロ比国防大臣との間で、日米豪比防衛相会談を実施しました。\n\n小泉防衛大臣から政策協議の更なる強化を提案した上で、閣僚は、この１年で実施した政策協議や共同訓練等の取組を踏まえ、地域の平和と安定のため、４か国の政策協議や共同訓練といった様々な防衛協力を更に推進していくことで一致しました。\n\n安全保障環境が一層厳しさを増す中、同盟国・同志国との連携は地域の平和と安定にとって不可欠です。防衛省としては、今後も様々な機会を活用し、協力を強化してまいります。\n\nhttps://t.co/gJIf3n9Kg0"}}},"rest_id":"2115621290979848561","unmention_data":{},"views":{"count":"12794","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115621257198940663","2115621290979848561"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130747","sortIndex":"2116281523115130651"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072169437722296320/8bWktzdb_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/276848601/1762248306"},"core":{"created_at":"Mon Apr 04 06:12:20 +0000 2011","name":"金融庁","screen_name":"fsa_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNzY4NDg2MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関３－２－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"金融庁の公式アカウントです。\n金融庁ウ