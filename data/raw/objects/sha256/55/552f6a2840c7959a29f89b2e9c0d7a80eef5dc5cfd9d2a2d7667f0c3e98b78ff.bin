ion":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115493966170997166"],"editable_until_msecs":"1793211640169","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2115493966170997166","created_at":"Wed Oct 28 17:20:40 +0000 2026","display_text_range":[0,77],"entities":{"user_mentions":[{"id_str":"2070308568658767872","indices":[3,17],"name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"}]},"favorite_count":0,"favorited":false,"full_text":"RT @PressSec_JMOD: 【10月28日　小泉防衛大臣臨時会見】\nフィリピン訪問に伴い、臨時会見を行いました。\n \n↓発表事項の全文はこちら…","id_str":"2115493966170997166","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":46,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2115277735396528149"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39812,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":100,"tweets":470},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2115493775153979586"],"editable_until_msecs":"1793211594000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":9,"bookmarked":false,"conversation_id_str":"2115493775153979586","created_at":"Wed Oct 28 17:19:54 +0000 2026","display_text_range":[0,57],"entities":{},"favorite_count":267,"favorited":false,"full_text":"【10月28日　小泉防衛大臣臨時会見】\nフィリピン訪問に伴い、臨時会見を行いました。\n \n↓発表事項の全文はこちら","id_str":"2115493775153979586","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":6,"retweet_count":46,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU0OTM3NzUwNDA3MTI3MDQ=","text":"【10月28日　小泉防衛大臣臨時会見】\nフィリピン訪問に伴い、臨時会見を行いました。\n \n↓発表事項の全文はこちら\n「本日は、各国の国防大臣との会談などを行うとともに、第１０回日ＡＳＥＡＮ防衛担当大臣会合に出席をしました。今日は到着後、まずアメリカのヘグセス長官と９度目となる日米防衛相会談を行いました。ヘグセス長官とは、厳しさを増す地域情勢について危機感を共有し、日米同盟の抑止力・対処力をこれまで以上の速度と強度で強化していくことで一致しました。私からは、三文書の改定に向け着実に取り組んでいることや、我が国に向けられた侵攻や脅威を拒否する力を強化していく決意を伝え、日米同盟としてもこの拒否する力を高めていく方向性を確認したほか、防衛装備や技術に関する日米協力である「オペレーション・スーパーチャージ」に関して、Ｆ－３５に不可欠な空対空ミサイルＡＭＲＡＡＭの最終組立・検査施設の日本国内における設置についに合意することができました。これにより、日米双方が必要とする装備品の確実な取得だけではなく、我が国の防衛産業基盤の強化にもつながる画期的な合意となりました。日米同盟を言葉だけではなく、行動で更なる高みに引き上げてまいります。続いて、韓国のカン・シンチョル国防部長官とは、カン長官就任後初めての日韓防衛相会談を行い、地域情勢について率直に意見を交わすとともに、ハイレベル間での緊密な意思疎通を継続し、日韓防衛協力を今後更に活発化させていくことで一致しました。インドのシン国防大臣とは、海洋安全保障や航空自衛隊戦闘機による初のインド訪問、約４０社が参加した日印防衛産業フォーラムなど、８月の会談以降、日印防衛協力が着実に進展していることを確認しました。また、インドの射場の活用については、陸上自衛隊が現地視察を実施するといった具体的な進捗を踏まえ、「２＋２」に向け、更に調整を加速していくこととなりました。そして、最後に、本年中の「２＋２」及び防衛相会談の開催に向け、協力を更に加速していくことでも一致しました。次に、第１０回日ＡＳＥＡＮ防衛担当大臣会合では、厳しさを増す安全保障環境の中、ＡＳＥＡＮの一体性、中心性、強靱性がこれまでになく重要になっていることを踏まえ、これを日本として力強く支えていくとの決意を表明しました。その上で、ＡＤＭＭプラスがより大きな役割を果たしていくため、ＡＳＥＡＮ主導で、その下にある専門家会合を更に強化していくための様々なアイデアについて議論しました。ＡＳＥＡＮからは、これまでの日本のイニシアチブへの感謝が示されるとともに、日本の今後の更なる貢献への期待が表明され、我々としても勇気づけられたところです。続く日米豪フィリピンの会談（ＳＱＵＡＤ）は、参加した米豪フィリピン全ての国が日本との間でＡＣＳＡを締結しており、そのような形で初めて実施することの意義を４人の閣僚で確認することができました。前回の会談以降、各国の参謀総長をトップとする防衛協力委員会（ＤＣＣ）の設立や共同訓練等の取組など、様々な進展がありました。今回の会合では、私から政策協議の更なる強化を提案した上で、地域の平和と安定のため、４か国の政策協議や共同訓練といった様々な防衛協力を更に推進していくことでも一致しました。そして、フィリピンのテオドロ国防大臣とは、ＲＡＡ、そしてＡＣＳＡという制度的基盤を具体的な部隊運用につなげていくとともに、秘密軍事情報保護協定の締結に向け協力していくことを確認しました。その上で、移転に向けた協議を継続している「あぶくま」型護衛艦については、最初の１隻を今後数年以内に見込まれる除籍後のできる限り早い時期に移転することを目指して協議を継続することに加え、日本側はフィリピン海軍が実施する教育訓練への支援を移転に先立って開始するとともに、維持・整備を両国で連携しながら進めていくことについて防衛当局間で一致し、今後、両国政府内で必要な調整を行うことを確認しました。運用、後方支援、人材育成、情報共有を含め、日本とフィリピンの防衛協力を一段と深化させてまいります。ベトナムのザン副首相兼国防大臣とは、人的交流や部隊間交流を更に推進し、防衛当局間の連携を加速していくことを確認しました。また、高速揚陸艇の共同開発・共同生産の可能性を含め、防衛装備・技術協力の具体化に向けた議論を進めていくことで一致しています。来月、日本に来られますので、その時にまた改めて会談を行っていきたいと思っています。最後に、シンガポールのチャン大臣とは、外交関係樹立６０周年という節目の年に、初の共同訓練「シンガパン」を実施したことを歓迎し、そして海軍種間の協力に加え、陸軍種、空軍種、防衛装備分野へと日・シンガポール防衛協力の幅を更に広げていくことで一致しました。"}}},"rest_id":"2115493775153979586","unmention_data":{},"views":{"count":"23378","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2115493966170997166","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"5951","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115493966170997166","sortIndex":"2116281523115130635"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/dzdqJLMfpC"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1153541724804792320/1IxAaRLZ_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Tue Dec 09 09:21:37 +0000 2014","name":"気象庁","screen_name":"JMA_kishou"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTIzNjU4MDEy","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"気象庁 (JMA:Japan Meteorological Agency) 公式アカウントです。報道発表やイベント案内などをお届けします。\n警報などの防災気象情報は気象庁ホームページをご覧ください。\n※運用ポリシー：https://t.co/v07vjnVmr5","entities":{"description":{"urls":[{"display_url":"jma.go.jp/jma/menu/socia…","expanded_url":"https://www.jma.go.jp/jma/menu/social_info.html","indices":[108,131],"url":"https://t.co/v07vjnVmr5"}]},"url":{"urls":[{"display_url":"jma.go.jp/jma/index.html","expanded_url":"https://www.jma.go.jp/jma/index.html","indices":[0,23],"url":"https://t.co/3abXj9G0Rj"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""