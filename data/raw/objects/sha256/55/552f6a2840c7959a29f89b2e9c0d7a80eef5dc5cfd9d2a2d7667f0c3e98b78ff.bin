ns":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3074878,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":606,"tweets":1917},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2115691956013875524"],"editable_until_msecs":"1793258844000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":882,"bookmarked":false,"conversation_id_str":"2115691956013875524","created_at":"Thu Oct 29 06:27:24 +0000 2026","display_text_range":[0,119],"entities":{},"favorite_count":30757,"favorited":false,"full_text":"先ほど、モンゴルのオチラル首相と首脳電話会談を実施しました。\n\n10月8日、モンゴル東部ドルノド県で発生した草原火災については、日本政府としても被害の大きさを深刻に受け止めており、モンゴル国民の皆様に対して、心からお見舞いを申し上げます。","id_str":"2115691956013875524","is_quote_status":false,"lang":"ja","quote_count":345,"reply_count":1082,"retweet_count":4443,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"newsroom.kddi.com/news/detail/kd…","expanded_url":"https://newsroom.kddi.com/news/detail/kddi_nr_s-80_4786.html","indices":[426,449],"url":"https://t.co/OSRx5Q1TmO"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2OTE5NTU4NjY5OTI2NDA=","richtext":{"richtext_tags":[]},"text":"先ほど、モンゴルのオチラル首相と首脳電話会談を実施しました。\n\n10月8日、モンゴル東部ドルノド県で発生した草原火災については、日本政府としても被害の大きさを深刻に受け止めており、モンゴル国民の皆様に対して、心からお見舞いを申し上げます。\n\n火災の詳しい原因については、現在、モンゴル当局によって調査が行われていますが、KDDIは、子会社（現地法人）であるモビコムについて、「火災発生当時、同社が整備した通信ネットワークの開通式典への出席及び4G通信ネットワークの通信品質などの現地確認を目的に自然保護区を訪問し、モンゴル国境港湾局の車両が同社の車両の前後を走行する体制で行動していた」旨を発表しています。\n\nまた、KDDIは、「当局の調査に全面的に協力するとともに、被害を受けた自然環境の状況把握と早期回復、地域の環境保全に向けた取組を、モンゴル関係当局と連携しながら積極的に行う」旨を発表しています。\n発表内容の更なる詳細は以下を御参照ください。\nhttps://t.co/OSRx5Q1TmO\n\n日本政府としては、10月27日に、森林・自然環境保全分野のJICA専門家をモンゴルに派遣しました。\n\n派遣した専門家からの報告も踏まえつつ、モンゴル政府とも緊密に意思疎通しながら、モンゴルへの必要な機材供与や、火災復興・環境回復分野での人材育成を始め、被害地域の回復にも資する協力をパッケージとして行っていく考えです。"}}},"rest_id":"2115691956013875524","unmention_data":{},"views":{"count":"2414143","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115691956013875524","sortIndex":"2116281523115130692"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/281874178/1611288198"},"core":{"created_at":"Thu Apr 14 04:13:40 +0000 2011","name":"特許庁","screen_name":"jpo_NIPPON"},"dm_permissions":{"can_dm":false},