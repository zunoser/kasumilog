}},"edit_control":{"edit_tweet_ids":["2115393464380858684"],"editable_until_msecs":"1793187678000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2115393464380858684","created_at":"Wed Oct 28 10:41:18 +0000 2026","display_text_range":[0,146],"entities":{"urls":[{"display_url":"mof.go.jp/policy/interna…","expanded_url":"https://www.mof.go.jp/policy/international_policy/mdbs/idb/ebrd20251001.html","indices":[123,146],"url":"https://t.co/dU0SZIONeq"}]},"favorite_count":30,"favorited":false,"full_text":"【公募情報】\n米州開発銀行（IDB）では11月16日（月）から17日（火）に、東京にリクルート・ミッションを派遣し、将来IDBへの入行を希望される方との面談を予定しています。\n応募締め切りは11月4日（水）です。\n詳細は、こちらをご覧ください。\nhttps://t.co/dU0SZIONeq","id_str":"2115393464380858684","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":27,"retweet_count":5,"retweeted":false,"user_id_str":"331514169"},"rest_id":"2115393464380858684","unmention_data":{},"views":{"count":"11653","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115393464380858684","sortIndex":"2116281523115130620"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266