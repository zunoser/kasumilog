video/2115666375293497344/vid/avc1/480x270/cJHXXeQc_CrMOOSq.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115666375293497344/vid/avc1/640x360/AVk860bb8J8tg3BY.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2115666375293497344/vid/avc1/1280x720/1oqr9IXL83nDDsIi.mp4?tag=29"}]}}]},"favorite_count":4460,"favorited":false,"full_text":"【お知らせ】\n１０月２８日、高市総理とドイツのメルツ首相は、日・独共同記者発表を行いました\n\n※両首脳の発言(速報版、仮訳)\n（高市総理）\n　皆様、こんばんは。まずはメルツ首相の来日を心から歓迎をいたします。 https://t.co/DNqdyvZ1xo","id_str":"2115667515129082017","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":59,"reply_count":144,"retweet_count":792,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2Njc1MTQ5MTUxNzY0NDk=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n１０月２８日、高市総理とドイツのメルツ首相は、日・独共同記者発表を行いました\n\n※両首脳の発言(速報版、仮訳)\n（高市総理）\n　皆様、こんばんは。まずはメルツ首相の来日を心から歓迎をいたします。\n　厳しさを増す国際情勢において、国際社会の平和と安定に共に貢献するとの確固たる意志を持つ、日独両国の連携はかつてなく重要です。\n　本日、価値や原則を共有する同志国である両国が「プレミアム・パートナー」として、その揺るぎない絆を世界に示すことをとても嬉しく思います。\n　先ほどの会談では、メルツ首相との間で、幅広い分野における戦略的連携を一層強化することで一致いたしました。\n　この後発表する、『首脳共同声明』、そして、先端技術及び経済安全保障分野の『首脳共同宣言』の３つの文書は、その決意の表れです。\n　今回、安全保障の分野では「欧州・大西洋とインド太平洋の安全保障が不可分」との認識を改めて共有しました。\n　日本としても、インド太平洋地域へのドイツの積極的な関与の継続を歓迎しています。\n　両国の部隊間協力の深化に役立つ機会や枠組みの検討、そして、相互補完が可能な防衛産業分野の協力も推進してまいります。\n　次に、産業技術面について、両国に通じる「ものづくり精神」に基づき、産業技術立国として、アジアと欧州をリードする日独が連携していくということは、大きな意味を持ちます。\n　フュージョンや水素分野を含め、先端技術分野において、官民で連携し、具体的な協力を推進することを確認しました。\n　特に、ＡＩ分野における協力については、「日独ＡＩハイレベル対話」の立ち上げや、ＡＩサミットの日本開催に向けた連携で一致しました。\n　さらに、本日、両国を代表する多くの企業関係者を迎え、官民合わせておよそ３０の協力覚書が交換されました。\n　こうした日独間の協力が、日本が推進する『成長戦略』とも連動し、両国の経済成長を更に後押しすることを期待いたします。\n　この高度な技術力と経済力を守り、育て、成長していくために不可欠なのが、経済安全保障での連携です。\n　不可欠な相互補完性を有する日独は、ルールに基づく自由で開かれた、公平な国際経済秩序を守る上で重要な同志国です。\n　メルツ首相との間で、戦略的分野での、産業支援策について、双方の利益が互恵的な形で、考慮される重要性を確認しました。\n　強靱で信頼できるサプライチェーンの構築に向け、両国は、重要鉱物の供給源の多角化や代替供給源の開発を進め、また、重要技術の保護にも取り組みます。\n　インド太平洋情勢やウクライナ情勢といった地域及び国際場裡における課題についても強固な連携を確認しました。この後の夕食会でも議論を深めてまいります。\n　両国は、かけがえのない「プレミアム・パートナー」として共に成長し、国際社会が直面する諸課題の解決にしっかりと貢献をしていきます。\n　メルツ首相、ありがとう。ダンケ・シェーン！\n\n（メルツ首相）　※日本語仮訳\n　高市総理、素晴らしいおもてなしをいただき、本日東京にご招待いただき感謝します。今回、連邦首相という立場で初めてこの都市、そしてこの国を訪問できたことを大変嬉しく思います。\n　皆様もご存じのとおり、日本はドイツにとって特別な意味を持つ友人で、緊密なパートナーです。地理的には非常に遠く離れていますが、日本とドイツは隣人なのです。\n　我々は今、新しい時代の転換点に立っています。この時代は、我々に新たな対策を求め、様々な類似した課題を突きつけています。我々は、国際的なルールを形骸化させる大国による新たな政治的な動きを目の当たりにしています。また、我々の生活を変えるような驚異的な新技術も目撃しています。こうした全てが合わさって、新しい時代を形成しています。\n　我々はそれらに対する答えを導き出します。そこに我々の共通の関係へのチャンスがあるのです。なぜなら、我々は共にグローバルパートナーとしてのネットワークを築いているからです。\n　ドイツにとって、日本は親しい友人であり、真の「プレミアム・パートナー」として極めて重要な役割を担っています。我々は基本的な利益を分かち合い、価値も共有しています。最も大きく、最も強い者達だけに活動の余地を与えるのではない世界を、共に構築できるという概念を共有しています。\n　日本とドイツの間には約９０００キロメートルの距離があります。それでも、我々は互いに非常に近い存在です。\n　日本とドイツは、自由、安全保障、そして繁栄を力強く主張する民主主義を堅持する国家です。我々は権利とルールに基づく国際秩序の支持者であり、擁護者です。\n　我々は、自由で公正な貿易を求めており、それを必要としています。両国の経済規模は世界最大級です。両国の科学者たちは、次世代テクノロジー分野において、一部共同で研究を行っています。我々は互いにとって、そして、アジアや欧州の隣国にとって信頼できる強力なパートナーです。\n　その中で、我々は同様の課題に直面しており、いくつか簡単に挙げさせていただきます。　\n　第一に、ロシアによるウクライナへの侵略を通じて、かつてないほど、国際的な平和秩序がこれまでにないほど脅かされています。これはアジアにもあてはまるのです。\n　高市総理は、先ほどの首脳会談で「ロシアは日本の隣国でもある」とおっしゃいました。だからこそ、我々は、大国が帝国主義的で修正主義的な戦争を行うことが許されれば、他の全ての国が被害を受けることになります。\n　東京では、ウクライナが地理的にどれほど遠くに離れていようとも、このことが理解されています。\n　日本によるウクライナへの継続的かつ実質的な支援に対して、我々は深く感謝しています。欧州全体が日本の支援に感謝しています。\n　第二に、インド太平洋地域において、我々は緊張の高まりを懸念の目で見つめています。これは特に、台湾海峡に当てはまります。ここでも、国連憲章が定める武力行使の禁止が適用されます。全ての当事者が最大限の慎重さをもって行動することが極めて重要です。\n　ドイツは、従来の「一つの中国」政策を堅持しますが、それをどのように具体化するかは我々が決定します。\n　第三に、経済安全保障というテーマは、ここ数年でますます重要性を増しています。日本、ＥＵ、ドイツが学んだことは、サプライチェーンであれ、原材料であれ、一方的な依存を軽減しなければならないということです。これには新しいパートナーのネットワークが役に立ちます。デリスキング、多角化、強靱性を高めることは時代の要請です。日本とドイツのパートナーシップにとって、ここには大きな可能性があります。「三人寄れば文殊の知恵」という日本のことわざの通り、我々は本日、パートナーシップを拡大するためのプロジェクトパッケージについて合意しました。\n　我々は、安全保障分野での協力を深めていきます。その一例として、今月、１００人を超えるドイツ軍兵士がインド太平洋地域における「キーン・ソード」に参加しています。これは、信頼と相互運用能力の向上に寄与するものです。\n　我々の活動は、決して攻撃的なものではありません。日本とドイツが、欧州とインド太平洋の双方において、安全と繁栄を共に守るというシグナルを送るものです。\nまた、将来の革新的な防衛に向けた共同開発などを通じて、防衛分野での協力を強化していきます。この文脈において、戦闘機製造における協力の可能性についても探っていきたいと考えています。これに関する（独政府内への）検討指示は既に準備されています。\n　我々は経済安全保障に関する共同宣言にも署名しました。我々は共同で、重要鉱物資源について、特定国への過度な依存を軽減していきます。本日発表した重要鉱物に関する共同宣言は、原材料のバリューチェーンを強化するための重要な出発点になります。\n　我々のパートナーシップは、危機対応にとどまりません。\n　ドイツと日本の企業は、戦略的なプロジェクトでも協力しています。我々は、こうした取り組みを通じて、共通の未来を少しずつ築いています。\n　我々はＡＩに関する対話の立ち上げを決定しました。高市総理が言及されたように、日本とドイツは、ＡＩの利用や規制の問題においても、人間を中心に据えた価値を基盤とするＡＩの開発に共に取り組んでいきます。さらに、先端技術協力に関する共同宣言において、我々は、半導体、６Ｇ移動通信ネットワーク、フュージョンエネルギー分野の協力の強化を強調しました。こうした協力は、すでに企業間の具体的な共同事業にも表れています。次世代テクノロジー、エネルギー、インフラ、防衛装備品などの分野において、両国の企業は、２０件を超える協力覚書により、イノベーションに力を注いでいます。我々はこのイノベーションを共に推進していきます。\n　私たちが協力の基盤とできるものは数多くあります。だからこそ、高市総理が２０２７年にベルリンで開催される日独政府間協議に参加いただくことを私は大変嬉しく思います。これは、我々のパートナーシップが速いペースで、かつ良好な軌道に乗っていることを示しています。\n　また、日本が２０２８年のハノーバー・メッセでパートナー国となることも付言しておきます。我々は今後、非常に緊密な時間のサイクルの中で、協力を深めていくことになります。我々が共にこのように認識し、共にこの道を進んでいることに深く感謝いたします。"}}},"rest_id":"2115667515129082017","unmention_data":{},"views":{"count":"340181","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115667515129082017","sortIndex":"2116281523115130670"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2116281523115130729-tweet-2115621937397617029","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2115997609659916673"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":591048,"following":204},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20406,"tweets":49175},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2115621937397617029"],"editable_until_msecs":"1793242150000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":8,"bookmarked":false,"conversation_id_str":"2115621937397617029","created_at":"Thu Oct 29 01:49:10 +0000 2026","display_text_range":[0,111],"entities":{"media":[{"display_url":"pic.x.com/1aXyXEDcDu","expanded_url":"https://x.com/MofaJapan_jp/status/2115621937397617029/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115621836663013376","indices":[112,135],"media_key":"3_2115621836663013376","media_results":{"result":{"media_key":"3_2115621836663013376"}},"media_url_https":"https://pbs.twimg.com/media/HVwy2fVbwAAnkk5.png","original_info":{"focus_rects":[{"h":589,"w":1052,"x":0,"y":0},{"h":589,"w":589,"x":138,"y":0},{"h":589,"w":517,"x":174,"y":0},{"h":589,"w":295,"x":285,"y":0},{"h":589,"w":1920,"x":0,"y":0}],"height":589,"width":1920},"sizes":{"large":{"h":589,"resize":"fit","w":1920},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/1aXyXEDcDu"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/1aXyXEDcDu","expanded_url":"https://x.com/MofaJapan_jp/status/2115621937397617029/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115621836663013376","indices":[112,135],"media_key":"3_2115621836663013376","media_results":{"result":{"media_key":"3_2115621836663013376"}},"media_url_https":"https://pbs.twimg.com/media/HVwy2fVbwAAnkk5.png","original_info":{"focus_rects":[{"h":589,"w":1052,"x":0,"y":0},{"h":589,"w":589,"x":138,"y":0},{"h":589,"w":517,"x":174,"y":0},{"h":589,"w":295,"x":285,"y":0},{"h":589,"w":1920,"x":0,"y":0}],"height":589,"width":1920},"sizes":{"large":{"h":589,"resize":"fit","w":1920},"medium":{"h":368,"resize":"fit","w":1200},"small":{"h":209,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/1aXyXEDcDu"}]},"favorite_count":335,"favorited":false,"full_text":"スペインのカスティーリャ・ラ・マンチャ州トレド県で発生した列車衝突事故に関し、犠牲となられた方々に哀悼の誠を捧げるとともに、御遺族に対し謹んでお悔やみ申し上げます。また、負傷された方々の一日も早い御快復をお祈りいたします。 https://t.co/1aXyXEDcDu","id_str":"2115621937397617029","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":9,"retweet_count":91,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2MjE5MzczNDMwNDU2MzM=","richtext":{"richtext_tags":[]},"text":"スペインのカスティーリャ・ラ・マンチャ州トレド県で発生した列車衝突事故に関し、犠牲となられた方々に哀悼の誠を捧げるとともに、御遺族に対し謹んでお悔やみ申し上げます。また、負傷された方々の一日も早い御快復をお祈りいたします。\nまた、スペイン政府からは、列車の乗客リストに日本人2名が含まれているとの連絡を受けています。外務省では現地対策本部等を設置して、同2名の安否を確認中です。引き続き、スペイン当局の協力も得つつ、日本政府として邦人保護に全力で取り組んでまいります。"}}},"rest_id":"2115621937397617029","unmention_data":{},"views":{"count":"39493","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2116281523115130729-tweet-2115663200117305460","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/mX88F3oZNb"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_