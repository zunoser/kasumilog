s_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2115481264971252161","created_at":"Wed Oct 28 16:30:11 +0000 2026","display_text_range":[0,140],"entities":{},"favorite_count":64,"favorited":false,"full_text":"千葉県北東部を震源とする地震について、大臣指示を行いました。\n１．地方自治体とも緊密に連携し、早急に被害状況を把握するとともに、国民に対し、情報提供を適時的確に行うこと。\n２．地方自治体とのホットライン等を通じて情報を収集し、要請に応じて迅速に地方自治体への支援等を実施すること。","id_str":"2115481264971252161","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":3,"retweet_count":24,"retweeted":false,"user_id_str":"571429134"},"rest_id":"2115481264971252161","unmention_data":{},"views":{"count":"16043","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115481264971252161","sortIndex":"2116281523115130633"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/W6kYoiHasN"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notif