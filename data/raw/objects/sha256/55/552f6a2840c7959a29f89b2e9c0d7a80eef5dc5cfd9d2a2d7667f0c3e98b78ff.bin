nt":95,"favorited":false,"full_text":"大久保ガザ再建支援担当大使は、シャアス・ガザ行政国民委員会（NCAG）委員長とガザ再建に向けた日・NCAGワーキンググループ第1回会合をオンラインで開催しました。大久保大使からは、ガザ再建に向け「包括的計画」の着実な履行が重要である旨改めて強調するとともに、日本として、「ガザ復旧プログラ","id_str":"2115633945262141725","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":11,"retweet_count":27,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04384.html","indices":[192,215],"url":"https://t.co/DAyOVY4ggv"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2MzM5NDUxNDg4ODcwNDE=","richtext":{"richtext_tags":[]},"text":"大久保ガザ再建支援担当大使は、シャアス・ガザ行政国民委員会（NCAG）委員長とガザ再建に向けた日・NCAGワーキンググループ第1回会合をオンラインで開催しました。大久保大使からは、ガザ再建に向け「包括的計画」の着実な履行が重要である旨改めて強調するとともに、日本として、「ガザ復旧プログラム」の具現化を含め、関係国・機関と連携しつつ、今後も積極的に役割を果たしていく旨述べました。\n\nhttps://t.co/DAyOVY4ggv"}}},"rest_id":"2115633945262141725","unmention_data":{},"views":{"count":"10512","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115633945262141725","sortIndex":"2116281523115130658"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1595652744500908032/vw4r2sfI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/242156036/1412822664"},"core":{"created_at":"Mon Jan 24 02:43:14 +0000 2011","name":"文部科学省　MEXT","screen_name":"mextjapan"},"dm_permiss