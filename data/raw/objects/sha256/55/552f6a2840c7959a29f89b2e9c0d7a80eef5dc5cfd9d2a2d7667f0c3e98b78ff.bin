],"media_key":"3_2115429224958074880","media_results":{"result":{"media_key":"3_2115429224958074880"}},"media_url_https":"https://pbs.twimg.com/media/HVuDrA0bIAA2gpp.jpg","original_info":{"focus_rects":[{"h":1693,"w":3023,"x":0,"y":1068},{"h":3023,"w":3023,"x":0,"y":403},{"h":3446,"w":3023,"x":0,"y":191},{"h":4031,"w":2016,"x":1007,"y":0},{"h":4031,"w":3023,"x":0,"y":0}],"height":4031,"width":3023},"sizes":{"large":{"h":2048,"resize":"fit","w":1536},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/pCrBu3dy2M"},{"display_url":"pic.x.com/pCrBu3dy2M","expanded_url":"https://x.com/meti_NIPPON/status/2115429309188042946/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":115,"w":115,"x":929,"y":817},{"h":289,"w":289,"x":435,"y":85},{"h":425,"w":425,"x":25,"y":705}]},"medium":{"faces":[{"h":67,"w":67,"x":544,"y":479},{"h":169,"w":169,"x":255,"y":50},{"h":249,"w":249,"x":14,"y":413}]},"orig":{"faces":[{"h":154,"w":154,"x":1241,"y":1091},{"h":386,"w":386,"x":581,"y":114},{"h":568,"w":568,"x":34,"y":942}]},"small":{"faces":[{"h":38,"w":38,"x":308,"y":271},{"h":96,"w":96,"x":144,"y":28},{"h":141,"w":141,"x":8,"y":234}]}},"id_str":"2115429261301657600","indices":[145,168],"media_key":"3_2115429261301657600","media_results":{"result":{"media_key":"3_2115429261301657600"}},"media_url_https":"https://pbs.twimg.com/media/HVuDtINaMAAyB_a.jpg","original_info":{"focus_rects":[{"h":1530,"w":2733,"x":0,"y":533},{"h":2360,"w":2360,"x":0,"y":0},{"h":2360,"w":2070,"x":0,"y":0},{"h":2360,"w":1180,"x":0,"y":0},{"h":2360,"w":2733,"x":0,"y":0}],"height":2360,"width":2733},"sizes":{"large":{"h":1768,"resize":"fit","w":2048},"medium":{"h":1036,"resize":"fit","w":1200},"small":{"h":587,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/pCrBu3dy2M"}]},"favorite_count":114,"favorited":false,"full_text":"赤澤大臣は、訪日中のメルツドイツ連邦共和国首相が出席した「日独ハイレベル経済サミット」に出席。EUの産業加速化法案への懸念を伝えるとともに、相互補完的な産業基盤を有する日独が、信頼できるパートナーとして、産業競争力と経済安全保障の強化に向けて協力を深める重要性を発信しました。#meti_ https://t.co/pCrBu3dy2M","id_str":"2115429309188042946","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":3,"retweet_count":23,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[138,150],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU0MjkzMDkxMzM1NDk1Njg=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、訪日中のメルツドイツ連邦共和国首相が出席した「日独ハイレベル経済サミット」に出席。EUの産業加速化法案への懸念を伝えるとともに、相互補完的な産業基盤を有する日独が、信頼できるパートナーとして、産業競争力と経済安全保障の強化に向けて協力を深める重要性を発信しました。#meti_daijin"}}},"rest_id":"2115429309188042946","unmention_data":{},"views":{"count":"12447","state":"EnabledWithCount"}}}}},"entryId":"tweet-2115429309188042946","sortIndex":"2116281523115130628"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location