ities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7837,"tweets":21910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115423372624441367"],"editable_until_msecs":"1793194809000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2115423353628659876","created_at":"Wed Oct 28 12:40:09 +0000 2026","display_text_range":[0,88],"entities":{},"favorite_count":103,"favorited":false,"full_text":"結果概要：\n\n令和８年１０月２８日、小泉進次郎日本国防衛大臣とラージナート・シン印国防大臣は、フィリピンにおいて日印防衛相会談を実施した。\n両大臣は、８月の日印防衛相会談以降、","id_str":"2115423372624441367","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2115423353628659876","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":0,"retweet_count":19,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/approach/exc…","expanded_url":"https://www.mod.go.jp/j/approach/exchange/area/2026/20261028_ind-j.html","indices":[499,522],"url":"https://t.co/CSvFMAqQgr"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU0MjMzNzI0Nzc3MTQ0MzI=","text":"結果概要：\n\n令和８年１０月２８日、小泉進次郎日本国防衛大臣とラージナート・シン印国防大臣は、フィリピンにおいて日印防衛相会談を実施した。\n両大臣は、８月の日印防衛相会談以降、\n・インド海軍副参謀長による訪日等を通じ、日本の技術的専門性及びインドの生産能力を活用した、機雷対処能力の強化や海軍種の造船・設計における共同開発の可能性など、双方の戦略的・運用上のニーズに資する具体的な海洋安全保障協力に関する議論が進展していること\n・空軍種間の共同訓練「ヴィーア・ガーディアン２６」において、航空自衛隊戦闘機による初のインド訪問が実現し、また、これに合わせて行われた航空幕僚長のインド訪問も通じて、空軍種間の連携強化に向けた議論が進展していること\n・在京インド大使館において、日印双方の企業約４０社が参加する日印防衛産業フォーラムの開催が実現したこと\nなど、８月の防衛相会談において両大臣で一致した方向性に沿って日印防衛協力が着実に進展していることを歓迎した。\n\nまた、本年中に東京において第４回日印外務・防衛閣僚会合（「２＋２」）及び防衛相会談を開催すべく、議論を更に加速していくことで一致した。\n\nhttps://t.co/CSvFMAqQgr"}}},"rest_id":"2115423372624441367","unmention_data":{},"views":{"count":"16361","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115423353628659876","2115423372624441367"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130772","sortIndex":"2116281523115130626"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","