ial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7837,"tweets":21910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115616591266418724"],"editable_until_msecs":"1793240876000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2115447872066109440","created_at":"Thu Oct 29 01:27:56 +0000 2026","display_text_range":[0,104],"entities":{},"favorite_count":99,"favorited":false,"full_text":"結果概要：\n\n令和８年１０月２８日、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス会合）出席のためフィリピン訪問中の小泉防衛大臣は、シンガポールのチャン国防大臣と防衛相会談を行ったところ、概要以下のとおり。","id_str":"2115616591266418724","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2115447872066109440","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":22,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/approach/exc…","expanded_url":"https://www.mod.go.jp/j/approach/exchange/area/2026/20261028_sgp-j.html","indices":[616,639],"url":"https://t.co/Fl10cdqyd5"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2MTY1OTExMTEyMDA3Njk=","text":"結果概要：\n\n令和８年１０月２８日、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス会合）出席のためフィリピン訪問中の小泉防衛大臣は、シンガポールのチャン国防大臣と防衛相会談を行ったところ、概要以下のとおり。\n\n・冒頭、小泉大臣から、安全保障環境が厳しさを増す中で、地域と国際社会の課題に共に取り組む重要なパートナーであるシンガポールとの防衛協力を一層強化していきたい旨述べ\nました。これに対し、チャン大臣からは日本は信頼できるパートナーであり、引き続き緊密に連携していきたい旨の発言がありました。\n\n・両大臣は、今年の日・シンガポール外交関係樹立６０周年という記念すべき年に、両国の艦艇が相互に寄港し、８月には初の共同訓練「ＳＩＮＧＡＰＡＮ」を実施したことを歓迎するとともに、両国の防衛当局間で緊密な意思疎通が維持され、５月の防衛相会談で確認した大臣間での定期的な協議が早速実施できたことを評価しました。\n\n・また、両大臣は、両大臣のリーダーシップの下で、海軍種間における協力の深化に加え、陸軍種間や空軍種間、防衛装備分野での協力の可能性も含め、協議を継続し、防衛協力を更に推進させることで一致しました。\n\n・さらに、小泉大臣は、シンガポールが来年ＡＳＥＡＮ議長国となることも念頭に、二国間のみならず、多国間協力においても連携を深め、地域の平和と安定に貢献していきたい旨述べ、チャン大臣からは強く同意する旨の発言がありました。\n\nhttps://t.co/Fl10cdqyd5"}}},"rest_id":"2115616591266418724","unmention_data":{},"views":{"count":"11676","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115447872066109440","2115616591266418724"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130750","sortIndex":"2116281523115130648"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/281874178/1611288198"},"core":{"created_at":"Thu Apr 14 04:13:40 +0000 2011","name":"特許庁","screen_name":"jpo_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODE4NzQxNzg=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関3-4-3"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{