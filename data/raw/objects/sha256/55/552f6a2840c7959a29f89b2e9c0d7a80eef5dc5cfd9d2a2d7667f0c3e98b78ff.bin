mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7837,"tweets":21910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115375307796697214"],"editable_until_msecs":"1793183349000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":8,"bookmarked":false,"conversation_id_str":"2115295857289601322","created_at":"Wed Oct 28 09:29:09 +0000 2026","display_text_range":[0,45],"entities":{},"favorite_count":106,"favorited":false,"full_text":"※内容に一部修正がございましたので、再度投稿いたします。\n\n結果概要：\n１．総論・地域情勢","id_str":"2115375307796697214","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2115295857289601322","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","quote_count":5,"reply_count":2,"retweet_count":24,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/approach/anp…","expanded_url":"https://www.mod.go.jp/j/approach/anpo/2026/1028a_usa-j.html","indices":[1604,1627],"url":"https://t.co/AzQk1knoC2"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTUzNzUzMDc1OTExODg0ODA=","text":"※内容に一部修正がございましたので、再度投稿いたします。\n\n結果概要：\n１．総論・地域情勢\n両閣僚は、両者の初の防衛相会談から１周年となる節目において、日米両首脳が一致している日米同盟の抑止力・対処力の強化に向けた取組について、これまで以上の速度と強度で取り組むことで一致し、小泉大臣から、三文書の改定に向け着実に取り組んでいることを述べた。\n小泉大臣は、力又は威圧による一方的な現状変更を抑止するとともに、万が一、我が国への侵攻が生起したとしても、これを阻止・排除する能力を持つことにより相手に目的を達成させない、拒否する防衛力を強化していく決意を述べた。両閣僚は、地域の平和と安定のために、より一層連携し、その揺るぎない姿を示していくことの重要性を確認した。\n両閣僚は、最近の我が国周辺における核・ミサイル戦力の増強や力又は威圧による一方的な現状変更の試みを含め、日米同盟を取り巻く厳しい安全保障環境について幅広く意見交換を行った。\n小泉大臣より、ヘグセス長官が昨年３月２９日に硫黄島で行った演説に言及した上で、両閣僚は、日米同盟が、昨日の敵が今日の友となったことを示しており、これまで、そして将来にわたって、インド太平洋地域における自由、繁栄、安全、そして平和の礎であり続けるとの認識で一致した。\n\n２．日米防衛協力\n・両閣僚は、周辺国における軍事力の質・量の拡大や軍事活動の活発化も踏まえ、統合防空ミサイル防衛能力の強化を含め、平素から有事まであらゆる事態に緊密に連携して対処していくことの必要性について一致した。\n・両閣僚は、今月の日米共同統合演習「キーン・ソード２７」においては、過去最大規模での日米の部隊の一時展開を含め、日本各地におけるより高度かつ実践的な共同訓練の進捗により、日米同盟の態勢と能力が強化されていることを歓迎した。同時に、両閣僚は、今後、こうしたより高度かつ実践的な共同訓練に係る取組を、更なる射撃訓練も含め、一層の切迫感を持って前に進めていくことを確認した。\n・両閣僚は、日米同盟の抑止力・対処力を一層強化するための取組の一例として、\n①日米の柔軟かつ分散された航空機運用の推進\n②自衛隊と米軍の施設のアクセスの拡大\n③南西地域における共同プレゼンスの向上を一層推進するための方策\nについて具体的に議論し、進捗を確認した。\n・両閣僚は、防衛装備・技術協力について、小泉大臣から日米協力の取組を更に加速させるためのイニシアティブである「オペレーション・スーパーチャージ」のフォローアップを行い、具体的な方策について議論した。特に、両閣僚は、ＳＭ－３ブロックⅡＡについて、生産量の拡大を実現するため、必要な技術情報を共有することに合意した。また、日本国内における中距離空対空ミサイル（ＡＭＲＡＡＭ）の最終組立・検査（ＦＡＣＯ）施設の設置に合意した。小泉大臣は、艦船に係る協力の重要性を強調した。\n・両閣僚は、大規模な個人情報の漏えいを含む悪意あるサイバー活動が国内外で相次ぐ中、こうした活動が両国の国民生活や経済活動、ひいては安全保障に深刻な影響を及ぼすことを防ぐため、引き続き、日米で協力・連携を強化することで一致した。\n\n３．米軍関係者による事件・事故の再発防止、米軍再編\n小泉大臣から、沖縄県で今月発生した強盗殺人事件に関して、改めて日本政府の立場を伝えた。両閣僚は、事件の発生防止のために実効性のある措置を取るべく、日本所在の防衛・外務当局間で引き続き議論していくことを確認した。\n両閣僚は、抑止力を維持し、地元への影響を軽減するため、普天間飛行場の継続的な使用を回避する唯一の解決策である辺野古における普天間飛行場代替施設の建設と普天間飛行場の返還を含め、沖縄統合計画及びその他の既存の二国間取決めに従った在日米軍再編の着実な実施が極めて重要であることを確認した。\n\nhttps://t.co/AzQk1knoC2"}}},"rest_id":"2115375307796697214","unmention_data":{},"views":{"count":"22975","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115295857289601322","2115375307796697214"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130788","sortIndex":"2116281523115130610"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHV6K1S4AJlwKAAIdXHsjV9oBWQgAAwAAAAEAAA"},"entryId":"cursor-top-2116281523115130700","sortIndex":"2116281523115130700"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHV6K1S3__u8KAAIdW1Kie9rQfggAAwAAAAIAAA"},"entryId":"cursor-bottom-2116281523115130609","sortIndex":"2116281523115130609"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}