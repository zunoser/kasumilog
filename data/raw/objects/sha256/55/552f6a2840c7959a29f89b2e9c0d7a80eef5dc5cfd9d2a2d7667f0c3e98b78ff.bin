s_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/approach/exc…","expanded_url":"https://www.mod.go.jp/j/approach/exchange/area/2026/20261028_kor-j.html","indices":[350,373],"url":"https://t.co/CnRhg0zDZl"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTUzODQ4ODU5NTEyMzQwNDg=","text":"結果概要：\n１０月２８日（水）、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＭＤＤプラス）出席のためフィリピンを訪問中の小泉防衛大臣は、韓国の姜信哲（カン・シンチョル）国防部長官との間で、会談を行いました。\nまず、小泉大臣から、姜長官の就任に対しお祝いを述べ、強固な信頼関係に基づき緊密に連携していきたいとの意思を伝えました。\nそして、両閣僚は、北朝鮮の核・ミサイル開発を含む地域情勢について意見交換を行い、日韓・日米韓で引き続き緊密に連携していくことを確認しました。\nまた、両閣僚は、日韓防衛協力について意見交換を行い、本年に入り、日韓防衛当局のハイレベル間での緊密な意思疎通が行われていることを歓迎しました。両閣僚は、こうしたモメンタムを維持し、日韓防衛協力を更に活発化させていくことで一致しました。\n\nhttps://t.co/CnRhg0zDZl"}}},"rest_id":"2115384886093918628","unmention_data":{},"views":{"count":"14810","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115384560263516629","2115384886093918628"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130787","sortIndex":"2116281523115130611"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2116281523115130788-tweet-2115295857289601322","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":