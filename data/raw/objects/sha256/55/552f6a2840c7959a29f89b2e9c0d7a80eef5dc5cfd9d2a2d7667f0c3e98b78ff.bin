pZ"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1265314,"following":43},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"268732024","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7837,"tweets":21910},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/2xSIikAYYe"}}}},"edit_control":{"edit_tweet_ids":["2115607669839138973"],"editable_until_msecs":"1793238749000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2115443949179654196","created_at":"Thu Oct 29 00:52:29 +0000 2026","display_text_range":[0,71],"entities":{},"favorite_count":90,"favorited":false,"full_text":"結果概要:\n\n２０２６年１０月２８日、小泉進次郎日本国防衛大臣とギルベルト・テオドロ比国防大臣は、フィリピンにおいて日比防衛相会談を実施した。","id_str":"2115607669839138973","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2115443949179654196","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":12,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mod.go.jp/j/approach/exc…","expanded_url":"https://www.mod.go.jp/j/approach/exchange/area/2026/20261028_phl-j.html","indices":[1570,1593],"url":"https://t.co/zD8HAr1dpZ"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2MDc2Njk2MzM2NTg4ODA=","text":"結果概要:\n\n２０２６年１０月２８日、小泉進次郎日本国防衛大臣とギルベルト・テオドロ比国防大臣は、フィリピンにおいて日比防衛相会談を実施した。\n両閣僚は、近年ますます複雑化しているインド太平洋地域の安全保障環境を踏まえ、東シナ海及び南シナ海における、力又は威圧によるいかなる一方的な現状変更の試みに強く反対することを改めて表明するとともに、近年の日本周辺の海空域における中国による威圧的な活動の規模及び頻度の増大や、南シナ海情勢における、中国によるフィリピンに対する危険かつ威圧的な活動の継続・強化に関して、深刻な懸念を共有した。\n\n両閣僚は、地域情勢が緊迫化する中で、自由で開かれたインド太平洋（ＦＯＩＰ）の取組を進展させ、地域の平和と安定を確保するため、両国の関係をさらに強化することの重要性を確認し、両国の「包括的・戦略的パートナーシップ」の下、日フィリピンの防衛協力における取組が、制度面と運用面の両輪で更に進展していることを歓迎した。\n\n特に、２０２６年５月に日フィリピン円滑化協定（ＲＡＡ）を適用した「バリカタン２６」において、自衛隊が地対艦ミサイルの実射を含む実動訓練を実施したことに加え、本年８月に発効した日フィリピン物品役務相互提供協定（ＡＣＳＡ）については、防衛当局間の手続を取り決め、１０月の日比共同訓練ドウシン・バヤニハンの機会に、初めてＡＣＳＡを適用してフィリピン空軍から航空自衛隊が補給を受けるなど、これまで以上に両国の防衛面での連携が一層強化されていることを確認した。\n\nその上で、両閣僚は、運用面でのさらなる連携強化には、制度面を含む情報共有の基盤整備が急務であるとの認識で一致し、秘密軍事情報保護協定に関する政府間の交渉に防衛当局として最大限協力していくことを確認した。\n\n両閣僚は、本年５月に設置したワーキング・グループにおいて具体的な議論が進捗していることを歓迎した。\n\nワーキング・グループでの議論を踏まえ、両閣僚は、あぶくま型護衛艦の最初の１隻を、今後数年内に見込まれる除籍後のできる限り早い時期に移転することを目指して協議を継続すること、日本側はフィリピン海軍が実施する教育訓練への支援を、移転に先立って開始するとともに、維持整備を両国で連携しながら進めていくことについて、防衛当局間で一致し、今後、両国政府内で必要な調整を行うことを確認した。\n\n両閣僚は、この移転を通じ、艦艇運用、後方支援、人材育成、情報共有までを含む包括的な協力を深化させ、特に海洋安全保障分野における防衛協力を新たなステージに上げる意図を確認した。さらに、同盟国・同志国との連携にも大きく寄与し、この地域の平和と安定の確保に繋がるものであることを確認した。\n\nまた、ＴＣ－９０については、２０２７年度に１機をフィリピンに移転すべく、運用や整備面での協力の詳細について、ワーキング・グループで議論することで一致した。さらに、防衛装備品の生産基盤の強化を含め、二国間の防衛当局間の連携の更なる強化に資する防衛装備・技術協力について、ワーキング・グループでの議論を加速させていくことで一致した。\n\n両閣僚は、二国間関係での連携に加え、日米豪比、ＡＳＥＡＮ等の多国間における防衛面での協力を強化していくことを確認した。その具体例として、日本とフィリピンが共同議長を務めるＡＤＭＭプラス第５期海洋安全保障専門家会合の取組として、本年３月に東京で主催した机上訓練の成果を踏まえ、本年９月に海上自衛隊と、フィリピン海軍及びＡＤＭＭプラス参加国が参加して実施した「共同協力活動（ＪＣＡ）」が成功を収めたことの、大きな意義を確認するとともに、同活動により、地域の海洋安全保障及び強靱性に対する日比協力の貢献が一層高まったことを確認した。\n\nhttps://t.co/zD8HAr1dpZ"}}},"rest_id":"2115607669839138973","unmention_data":{},"views":{"count":"11677","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115443949179654196","2115607669839138973"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130759","sortIndex":"2116281523115130639"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2114909414373335040/ykE6oMZY?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.75","ty