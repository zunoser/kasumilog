端技術、経済安全保障などの様々な分野での協力を通じて、自由で開かれた国際秩序の維持・強化に向","id_str":"2115450389151785173","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":20,"retweet_count":38,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/erp/erp_…","expanded_url":"https://www.mofa.go.jp/mofaj/erp/erp_2/de/pageit_000001_03282.html","indices":[171,194],"url":"https://t.co/64uesk1t7C"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU0NTAzODkwMTc1NzU0MjQ=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、ドイツのフリードリヒ・メルツ首相と会談及びワーキング・ディナーを行いました。日独が長年にわたって築いてきた信頼関係に基づき、両国はプレミアム・パートナーとして、安全保障、先端技術、経済安全保障などの様々な分野での協力を通じて、自由で開かれた国際秩序の維持・強化に向け、日独の揺るぎない連携を更に深めていくことで一致しました。\nhttps://t.co/64uesk1t7C"}}},"rest_id":"2115450389151785173","unmention_data":{},"views":{"count":"18751","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2116281523115130703-tweet-2115696414382776468","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":