_str":"2115417808809177088","indices":[142,165],"media_key":"3_2115417808809177088","media_results":{"result":{"media_key":"3_2115417808809177088"}},"media_url_https":"https://pbs.twimg.com/media/HVt5SgWbMAAKKhb.jpg","original_info":{"focus_rects":[{"h":472,"w":842,"x":0,"y":124},{"h":596,"w":596,"x":123,"y":0},{"h":596,"w":523,"x":160,"y":0},{"h":596,"w":298,"x":272,"y":0},{"h":596,"w":842,"x":0,"y":0}],"height":596,"width":842},"sizes":{"large":{"h":596,"resize":"fit","w":842},"medium":{"h":596,"resize":"fit","w":842},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/c8fIc6eGBe"},{"display_url":"pic.x.com/c8fIc6eGBe","expanded_url":"https://x.com/ModJapan_jp/status/2115417817025786219/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2115417808968589312","indices":[142,165],"media_key":"3_2115417808968589312","media_results":{"result":{"media_key":"3_2115417808968589312"}},"media_url_https":"https://pbs.twimg.com/media/HVt5Sg8boAAjbvs.jpg","original_info":{"focus_rects":[{"h":472,"w":842,"x":0,"y":0},{"h":596,"w":596,"x":123,"y":0},{"h":596,"w":523,"x":160,"y":0},{"h":596,"w":298,"x":272,"y":0},{"h":596,"w":842,"x":0,"y":0}],"height":596,"width":842},"sizes":{"large":{"h":596,"resize":"fit","w":842},"medium":{"h":596,"resize":"fit","w":842},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/c8fIc6eGBe"}]},"favorite_count":1051,"favorited":false,"full_text":"令和８年１０月２８日（水）午前から午後にかけて、中国軍の偵察型無人機（ＢＺＫ－００５）×１機及び情報収集機（Ｙ－９）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、太平洋上で反転し、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。 https://t.co/c8fIc6eGBe","id_str":"2115417817025786219","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"quoted_status_id_str":"2115417053448622107","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2115417053448622107","url":"https://t.co/dKSVEmRVCq"},"reply_count":11,"retweet_count":287,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU0MTc4MTY5NjI4NDI2MjU=","text":"令和８年１０月２８日（水）午前から午後にかけて、中国軍の偵察型無人機（ＢＺＫ－００５）×１機及び情報収集機（Ｙ－９）×１機が東シナ海から飛来し、沖縄本島と宮古島の間を通過して太平洋に至り、太平洋上で反転し、再び沖縄本島と宮古島の間を通過して、大陸方面に向けて飛行したことを確認した。\n\nまた、同日午後、中国軍の哨戒機（Ｙ－９）×１機が大陸方面から飛来し、東シナ海上の長崎県男女群島の南西沖から沖縄本島の北西沖にかけて飛行を行った後、大陸方面に向けて飛行したことを確認した。\n\nこれらに対し、航空自衛隊の南西航空方面隊等の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3294},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_langua