s":[486,509],"url":"https://t.co/VEtGXczVi2"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTU2MTQyMjE5ODM3MzU4MDg=","text":"結果概要：\n\n令和８年１０月２８日、第１３回拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス）出席のためフィリピンを訪問中の小泉防衛大臣は、ベトナムのザン副首相兼国防大臣と防衛相会談を行ったところ、概要以下のとおり。\n\n・冒頭、小泉大臣から、本年７月のザン副首相兼国防大臣の訪日以来の再会を歓迎するとともに、厳しさを増す地域や国際情勢の中で、日ベトナムの連携がますます重要になっており、両国の包括的・戦略的パートナーシップを防衛当局間で強化していく重要性について述べました。両大臣は、防衛面での一層の連携強化のため、具体的な議論を行いました。\n\n・両大臣は、本年７月の防衛相会談での議論を踏まえ、引き続き、防衛大学校等への留学などの人的交流、ＰＫＯ分野を含む部隊間交流などの二国間協力を推進していくことを確認しました。\n\n・また、両大臣は、装備移転に係る課長級のワーキンググループにおいて、高速揚陸艇の共同開発・共同生産の可能性を含む防衛装備・技術協力に向けた議論が進んでいることを確認し、今後も両大臣のリーダーシップの下、協力の実現に向けて議論を継続することで一致しました。\n\nhttps://t.co/VEtGXczVi2"}}},"rest_id":"2115614222117933305","unmention_data":{},"views":{"count":"11490","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2115445965348082010","2115614222117933305"],"enableDeduplication":true}}},"entryId":"list-conversation-2116281523115130752","sortIndex":"2116281523115130646"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"