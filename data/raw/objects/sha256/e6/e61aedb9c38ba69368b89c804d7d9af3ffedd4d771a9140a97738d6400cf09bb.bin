,"y":155},{"h":70,"w":70,"x":128,"y":158}]},"orig":{"faces":[{"h":37,"w":37,"x":220,"y":29},{"h":58,"w":58,"x":699,"y":160},{"h":66,"w":66,"x":509,"y":153},{"h":68,"w":68,"x":315,"y":155},{"h":70,"w":70,"x":128,"y":158}]},"small":{"faces":[{"h":27,"w":27,"x":162,"y":21},{"h":42,"w":42,"x":516,"y":118},{"h":48,"w":48,"x":376,"y":113},{"h":50,"w":50,"x":232,"y":114},{"h":51,"w":51,"x":94,"y":116}]}},"id_str":"2109812159920390144","indices":[120,143],"media_key":"3_2109812159920390144","media_results":{"result":{"media_key":"3_2109812159920390144"}},"media_url_https":"https://pbs.twimg.com/media/HUeO-y7awAAbmoh.jpg","original_info":{"focus_rects":[{"h":450,"w":804,"x":0,"y":0},{"h":450,"w":450,"x":0,"y":0},{"h":450,"w":395,"x":9,"y":0},{"h":450,"w":225,"x":94,"y":0},{"h":450,"w":920,"x":0,"y":0}],"height":450,"width":920},"sizes":{"large":{"h":450,"resize":"fit","w":920},"medium":{"h":450,"resize":"fit","w":920},"small":{"h":333,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/RYFZjmvLxw"}]},"favorite_count":2,"favorited":false,"full_text":"◤本日12時～開催！無料オンライン #ウェビナー のご案内◢\n\nことし7月に #NEDO シリコンバレー事務所より発表されたばかりの最新ガイドブック、『～米国に挑戦する #スタートアップ を成功に導く知的財産ガイド ケーススタディ編～』。 https://t.co/RYFZjmvLxw","id_str":"2109818905321431478","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":3,"retweeted":false,"user_id_str":"938375954149261312"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[18,24],"text":"ウェビナー"},{"indices":[39,44],"text":"NEDO"},{"indices":[85,93],"text":"スタートアップ"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDk4MTg5MDUxNzg4Nzc5NTI=","text":"◤本日12時～開催！無料オンライン #ウェビナー のご案内◢\n\nことし7月に #NEDO シリコンバレー事務所より発表されたばかりの最新ガイドブック、『～米国に挑戦する #スタートアップ を成功に導く知的財産ガイド ケーススタディ編～』。\n\n本ガイドブックの執筆を担当したTMI総合法律事務所シリコンバレーオフィスの専門家3名に\n💡米国展開で直面しやすい知財の落とし穴\n💡戦略的な立ち回りについて\n💡より実践的な「6つのケーススタディ」\nといった内容を、肩ひじ張らない雰囲気で楽しく深掘りしていただきます。\n\n・米国進出を検討中のスタートアップ・知財担当者\n・既に展開中のスタートアップ・知財担当者\n・スタートアップを支援する専門家\nといった方におすすめのウェビナーです。\n\nぜひご参加ください。\n\n👇開催直前まで参加申込を受付中！詳細は下記リンクからご覧ください。"}}},"rest_id":"2109818905321431478","unmention_data":{},"views":{"count":"903","state":"EnabledWithCount"}}}},"user_id_str":"281874178"},"rest_id":"2109828538744594907","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"109","state":"EnabledWithCount"}}}}}},"entryId":"tweet-2109828538744594907","sortIndex":"2109912765077389257"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit