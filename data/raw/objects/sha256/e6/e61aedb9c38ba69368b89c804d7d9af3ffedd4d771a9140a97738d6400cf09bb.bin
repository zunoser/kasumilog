383050752","indices":[3,19],"name":"内閣府政策統括官（共生・共助担当）","screen_name":"kyoseikyojo_cao"}]},"favorite_count":0,"favorited":false,"full_text":"RT @kyoseikyojo_cao: ＼ともともフェスタ2026開催！／\n障害のある人もない人も、共に楽しみ交流する「ともともフェスタ2026」が始まり、オープニングセレモニーを行いました。明日も御来場お待ちしております！\n https://t.co/nsj3DoqDgK…","id_str":"2109777127902150681","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":6,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1853716532645535744/nByOEnD7_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1853694958383050752/1731399557"},"core":{"created_at":"Tue Nov 05 07:08:10 +0000 2024","name":"内閣府政策統括官（共生・共助担当）","screen_name":"kyoseikyojo_cao"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODUzNjk0OTU4MzgzMDUwNzUy","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府共生・共助担当の公式アカウントです。\n内閣府政策統括官（共生・共助担当）が管理・運営しております。\n運用方針（https://t.co/nSooMa6Gc5）を御確認のうえ御利用ください。","entities":{"description":{"urls":[{"display_url":"www8.cao.go.jp/souki/sns/x.ht…","expanded_url":"https://www8.cao.go.jp/souki/sns/x.html","indices":[58,81],"url":"https:/