[{"h":71,"w":71,"x":1835,"y":375},{"h":71,"w":71,"x":967,"y":419},{"h":73,"w":73,"x":1537,"y":439},{"h":69,"w":69,"x":393,"y":441},{"h":69,"w":69,"x":1265,"y":449},{"h":73,"w":73,"x":145,"y":457},{"h":71,"w":71,"x":707,"y":549}]},"medium":{"faces":[{"h":42,"w":42,"x":1075,"y":220},{"h":42,"w":42,"x":567,"y":246},{"h":43,"w":43,"x":900,"y":257},{"h":40,"w":40,"x":230,"y":258},{"h":40,"w":40,"x":741,"y":263},{"h":43,"w":43,"x":85,"y":268},{"h":42,"w":42,"x":414,"y":322}]},"orig":{"faces":[{"h":140,"w":140,"x":3585,"y":734},{"h":140,"w":140,"x":1890,"y":820},{"h":144,"w":144,"x":3003,"y":859},{"h":136,"w":136,"x":769,"y":863},{"h":136,"w":136,"x":2472,"y":878},{"h":144,"w":144,"x":285,"y":894},{"h":140,"w":140,"x":1382,"y":1074}]},"small":{"faces":[{"h":23,"w":23,"x":609,"y":124},{"h":23,"w":23,"x":321,"y":139},{"h":24,"w":24,"x":510,"y":146},{"h":23,"w":23,"x":130,"y":146},{"h":23,"w":23,"x":420,"y":149},{"h":24,"w":24,"x":48,"y":151},{"h":23,"w":23,"x":234,"y":182}]}},"id_str":"2108522798004260864","indices":[160,183],"media_key":"3_2108522798004260864","media_results":{"result":{"media_key":"3_2108522798004260864"}},"media_url_https":"https://pbs.twimg.com/media/HUL6UDfbUAAHVl_.jpg","original_info":{"focus_rects":[{"h":2074,"w":3704,"x":296,"y":0},{"h":2074,"w":2074,"x":1461,"y":0},{"h":2074,"w":1819,"x":1589,"y":0},{"h":2074,"w":1037,"x":1980,"y":0},{"h":2074,"w":4000,"x":0,"y":0}],"height":2074,"width":4000},"sizes":{"large":{"h":1062,"resize":"fit","w":2048},"medium":{"h":622,"resize":"fit","w":1200},"small":{"h":353,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mYFTSTVYPf"},{"display_url":"pic.x.com/mYFTSTVYPf","expanded_url":"https://x.com/kyoseikyojo_cao/status/2108524309794975980/photo/1","ext_alt_text":"キャッチコピー「出会う、ふれあう、未来がかわる」を掲げた、障害の有無にかかわらず、こどもから大人まで、誰もが、一緒に楽しみ、交流できるインクルーシブイベント「ともともフェスタ2026（Tomotomo Festa 2026）」の告知ポスターです。開催日時は2026年10月9日(金)11:00〜19:00（行幸通りは17:00まで）及び10日(土)11:00〜17:00、入場無料です。会場は東京駅丸の内口 行幸通り及び丸ビル1階マルキューブを予定しており、音楽ステージ・体験型ワークショップ・展示などの楽しいコンテンツやみんなで遊べる遊具もあります。行幸通りは、東京都千代田区丸の内２丁目２番地、各線「東京駅」丸の内中央口より徒歩１分、東京メトロ千代田線「二重橋前駅」より徒歩3分です。丸ビルは東京都千代田区丸の内２丁目４番地１号、各線「東京駅」から地下で直結、徒歩４分、東京メトロ千代田線「二重橋前駅」より徒歩４分です。主催：内閣府・ともともフェスタ2026実行委員会、協力：東京法務局・全国人権擁護委員連合会・東京都人権擁護委員連合会・株式会社アイシン・味の素株式会社・錦城護謨株式会社・株式会社講談社・タカオ株式会社・株式会社乃村工藝社　未来創造研究所・株式会社毎日新聞社、後援：こども家庭庁・法務省・文部科学省・厚生労働省・国土交通省・東京都・鳥取県・千代田区。特設WEBサイト: https://www.tomotomo.go.jp/festa2026/。バリアフリー情報や出展・出演・イベント情報は特設ホームページを御覧ください。イベントへのお問い合わせは、ともともフェスタ2026運営事務局 info@tomotomo.go.jp ,03-5730-3157までお寄せください。受付時間は平日10時から17時（土日祝日、年末年始は除く）です。ポスターには、車いすユーザー・白杖ユーザーを含む多様な年齢・背景の人々のイラストが描かれています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108524168639811584","indices":[160,183],"media_key":"3_2108524168639811584","media_results":{"result":{"media_key":"3_2108524168639811584"}},"media_url_https":"https://pbs.twimg.com/media/HUL7j1gaEAA3uD_.png","original_info":{"focus_rects":[{"h":269,"w":481,"x":0,"y":0},{"h":481,"w":481,"x":0,"y":0},{"h":548,"w":481,"x":0,"y":0},{"h":679,"w":340,"x":141,"y":0},{"h":679,"w":481,"x":0,"y":0}],"height":679,"width":481},"sizes":{"large":{"h":679,"resize":"fit","w":481},"medium":{"h":679,"resize":"fit","w":481},"small":{"h":679,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mYFTSTVYPf"}],"urls":[{"display_url":"tomotomo.go.jp","expanded_url":"https://tomotomo.go.jp","indices":[94,117],"url":"https://t.co/nsj3DoqDgK"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/mYFTSTVYPf","expanded_url":"https://x.com/kyoseikyojo_cao/status/2108524309794975980/photo/1","ext_alt_text":"内閣府が主催する「ともともフェスタ2026〜出会う、ふれあう、未来がかわる〜」の開会式テープカットの場面。赤いカーペットの上に7名が横一列に並び、全員が白手袋を着用して赤白のリボン付きテープを手にしている。左から、黒いワンピース姿の女性、いまいえりこ内閣府副大臣、さとうさとし氏、なかつかひろし内閣府特命担当大臣、ふかがわせいこ氏、さかもとりゅうたろう内閣府大臣政務官、ふじもとひろし氏が並んでいる。背景には「ともともフェスタ2026」の大型バックボードと、主催・協力・後援団体名が記載されており、窓越しに緑の木々が見える。","ext_med