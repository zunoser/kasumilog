3,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/p08z4QYqKZ"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/p08z4QYqKZ","expanded_url":"https://x.com/ModJapan_jp/status/2102356940731072831/photo/1","ext_media_availability":{"status":"Available"},"features":{"all":{"tags":[{"name":"Kemhan RI","screen_name":"Kemhan_RI","type":"user","user_id":"714719021816541184"}]},"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2102356932858458112","indices":[82,105],"media_key":"3_2102356932858458112","media_results":{"result":{"media_key":"3_2102356932858458112"}},"media_url_https":"https://pbs.twimg.com/media/HS0Sfd4bsAATYQk.jpg","original_info":{"focus_rects":[{"h":538,"w":960,"x":0,"y":0},{"h":540,"w":540,"x":0,"y":0},{"h":540,"w":474,"x":0,"y":0},{"h":540,"w":270,"x":0,"y":0},{"h":540,"w":960,"x":0,"y":0}],"height":540,"width":960},"sizes":{"large":{"h":540,"resize":"fit","w":960},"medium":{"h":540,"resize":"fit","w":960},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/p08z4QYqKZ"}]},"favorite_count":743,"favorited":false,"full_text":"国際緊急援助活動が自衛隊の行動として位置付けられた平成４年（１９９２年）以降、インドネシア共和国で自衛隊が国際緊急援助活動を実施するのは、今回で６回目となります。 https://t.co/p08z4QYqKZ","id_str":"2102356940731072831","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"quoted_status_id_str":"2101924308927066150","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2101924308927066150","url":"https://t.co/TChVUmY5NX"},"reply_count":17,"retweet_count":101,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIzNTY5NDA2MzQ2NzMxNTI=","text":"国際緊急援助活動が自衛隊の行動として位置付けられた平成４年（１９９２年）以降、インドネシア共和国で自衛隊が国際緊急援助活動を実施するのは、今回で６回目となります。\n\n自衛隊はこれまで、インドネシアにおいて地震・津波災害への対応や航空機の捜索救難活動などを実施し、今回は、国際緊急援助活動として、初めて山林火災の消火活動に取り組んでいます。\n\n防衛省・自衛隊は、被害の拡大防止に向けて、引き続きインドネシアへの支援に全力で取り組んでまいります。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による発信▸ @ModJapan_en 災害派遣等の発信▸ @ModJapan_saigai 【Facebook】https://t.co/MhbTYVAO9J 【Instagram】 https://t.co/xfOJ2bbbiJ","entities":{"description":{"urls":[{"display_url":"facebook.com/mod.japn","expanded_url":"http://facebook.com/mod.japn","indices":[104,127],"url":"https://t.co/MhbTYVAO9J"},{"display_url":"Instagram.com/modjapan","expanded_url":"http://Instagram.com/modjapan","indices":[140,163],"url":"https://t.co/xfOJ2bbbiJ"}]},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp/","indices":[0,23],"url":"https://t.co/2xSIikAYYe"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1264492,"following":43},"relationship_perspectives":{"blocked_b