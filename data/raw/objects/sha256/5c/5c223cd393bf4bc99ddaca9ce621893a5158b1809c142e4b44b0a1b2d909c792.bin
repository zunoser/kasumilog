n_millis":206066,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2102580398924726272/pl/VhkwoxiPsdlzqyBK.m3u8?tag=29&v=c53"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102580398924726272/vid/avc1/480x270/d0Ask4W1xdgE_nnk.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102580398924726272/vid/avc1/640x360/sswH2SmVinR-Xo7d.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102580398924726272/vid/avc1/1280x720/qxuF4VpMBn5po43m.mp4?tag=29"}]}}]},"favorite_count":4493,"favorited":false,"full_text":"【お知らせ】\n９月２２日（現地時間）、高市総理は、ウクライナのゼレンスキー大統領と会談を行いました。\n \n※両首脳による冒頭発言要旨（速報版、仮訳）\n（高市総理） https://t.co/Rds1fl4B6K","id_str":"2102581186333982793","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":68,"reply_count":189,"retweet_count":835,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDI1ODExODYyNzEwMDY3MjA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n９月２２日（現地時間）、高市総理は、ウクライナのゼレンスキー大統領と会談を行いました。\n \n※両首脳による冒頭発言要旨（速報版、仮訳）\n（高市総理）\n　６月にG７のエビアン・サミットのときに夕食会で隣の席になってお話をしました後、こうして首脳会談ができて嬉しく思います。ゼレンスキー大統領の強いリーダーシップの下で、祖国の平和のために立ち向かっておられるウクライナの方々に改めて敬意を表します。\n　一日でも早く「公正かつ永続的な平和」を実現するために、各国が結束してウクライナを支えることが重要です。日本はウクライナと共にあります。その方針は揺るぎません。国際社会と連携して、「ウクライナ支援」と「対露制裁」に取り組んで参ります。\n \n（ゼレンスキー大統領）\n　ありがとうございます。高市総理、本日はお会いできて光栄です。G７の際にお話したことを良く覚えています。貴総理のウクライナ支援に向けた力強いお言葉に大変感謝しており、本日の会談を実施していただいたことに感謝しています。また個人的に、貴総理、日本及び日本国民の皆様には、ロシアによる全面侵攻開始以降、一貫して支援をいただいていることに非常に感謝しており、人道分野やエネルギー分野での支援には特に感謝しています。\n　G７の際にもお話しましたが、もちろん、戦争は終わって欲しいと考えています。和平が達成されれば、そしてそれは必ず達成されると考えていますが、その際には日本のビジネスや、復旧復興に取り組む方々、また一般の日本人が多くウクライナを訪問することを喜んで心待ちにしています。日本の人々は我々が最も困難な時に、共に立っていただいた方々としてウクライナでは非常に大きく感謝されており、現時点でも復興に取り組んでいただいていることにも感謝しています。一連の支援パッケージや、テロリスト国家に対する制裁パッケージについても感謝しています。"}}},"rest_id":"2102581186333982793","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"179079","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102581186333982793","sortIndex":"2102724122432765922"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":