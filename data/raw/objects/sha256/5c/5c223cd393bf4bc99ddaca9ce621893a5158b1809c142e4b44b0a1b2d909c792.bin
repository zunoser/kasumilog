157}]},"medium":{"faces":[{"h":70,"w":70,"x":494,"y":127},{"h":74,"w":74,"x":192,"y":92}]},"orig":{"faces":[{"h":152,"w":152,"x":1071,"y":276},{"h":162,"w":162,"x":416,"y":200}]},"small":{"faces":[{"h":39,"w":39,"x":280,"y":72},{"h":42,"w":42,"x":108,"y":52}]}},"id_str":"2102572041811484672","indices":[87,110],"media_key":"3_2102572041811484672","media_results":{"result":{"media_key":"3_2102572041811484672"}},"media_url_https":"https://pbs.twimg.com/media/HS3WIdLXYAAwUvi.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1950,"w":1950,"x":650,"y":0},{"h":1950,"w":1711,"x":889,"y":0},{"h":1950,"w":975,"x":1268,"y":0},{"h":1950,"w":2600,"x":0,"y":0}],"height":1950,"width":2600},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/9W8CRPbxwe"}]},"favorite_count":10914,"favorited":false,"full_text":"米国・ニューヨークでの国連総会出席に際して、グテーレス国連事務総長と会談を行いました。\n\nグテーレス事務総長とは、5月に訪日いただいた際に会談をして以来の再会となりました。 https://t.co/9W8CRPbxwe","id_str":"2102572402714497230","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":43,"reply_count":271,"retweet_count":1159,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDI1NzI0MDI2NDc0NzgyNzI=","richtext":{"richtext_tags":[]},"text":"米国・ニューヨークでの国連総会出席に際して、グテーレス国連事務総長と会談を行いました。\n\nグテーレス事務総長とは、5月に訪日いただいた際に会談をして以来の再会となりました。\n\n私からは、より強靭かつ実効的な国連の実現のため、UN80イニシアティブを始めとする国連改革における連携を確認し、安保理改革について、常任・非常任理事国双方の拡大を含む改革が不可欠であると申し上げました。\n\nまた、国連関係機関における邦人職員の増強を改めて要請しました。\n\nグテーレス国連事務総長からは、国連の活動に関する日本の支援に謝意をいただき、国連改革に向けた努力における日本の貢献に対する期待の声をいただきました。\n\n国連を中心とする多国間主義に対する、日本のコミットメントは不変です。\n\n今後も国連と連携しながら、共に平和と繁栄を創ってまいります。"}}},"rest_id":"2102572402714497230","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"253689","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102572402714497230","sortIndex":"2102724122432765920"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2997445,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following