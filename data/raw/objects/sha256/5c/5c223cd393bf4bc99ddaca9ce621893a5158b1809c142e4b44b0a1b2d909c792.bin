c1/1920x1080/8sn2z4hMhPby4t23.mp4?tag=29"}]}}]},"favorite_count":418,"favorited":false,"full_text":"９月２０日に、輸送艦「くにさき」がキジン港を出港した際の様子です。\n\n山林火災の状況や安全に部隊運用を行う上で必要な気象条件などを考慮し、インドネシア側との調整の上で、輸送艦「くにさき」は、CH-47輸送ヘリを１機搭載し、クタパン沖へ移動しました。 https://t.co/11DUbBKWxh","id_str":"2101940382833463665","in_reply_to_screen_name":"ModJapan_jp","in_reply_to_status_id_str":"2101532257395806708","in_reply_to_user_id_str":"268732024","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":0,"retweet_count":59,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDE5NDAzODI3ODMyMDk0NzI=","text":"９月２０日に、輸送艦「くにさき」がキジン港を出港した際の様子です。\n\n山林火災の状況や安全に部隊運用を行う上で必要な気象条件などを考慮し、インドネシア側との調整の上で、輸送艦「くにさき」は、CH-47輸送ヘリを１機搭載し、クタパン沖へ移動しました。\n\nキジン港とクタパン沖の２ヶ所からCH-47輸送ヘリにより消火活動を実施します。"}}},"rest_id":"2101940382833463665","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"25035","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2101532257395806708","2101940382833463665"],"enableDeduplication":true}}},"entryId":"list-conversation-2102724122432766028","sortIndex":"2102724122432765876"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/7hqmpH6hGr"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"ava