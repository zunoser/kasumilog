bookmarked":false,"conversation_id_str":"2102057403466633348","created_at":"Mon Sep 21 15:28:33 +0000 2026","display_text_range":[0,63],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/P39ujCVKKD","expanded_url":"https://x.com/kantei/status/2102057403466633348/video/1","ext_media_availability":{"status":"Available"},"id_str":"2102056407440953345","indices":[64,87],"media_key":"13_2102056407440953345","media_results":{"result":{"media_key":"13_2102056407440953345"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2102056407440953345/img/1fINKds-MoUxHvc2.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/P39ujCVKKD","video_info":{"aspect_ratio":[16,9],"duration_millis":185400,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2102056407440953345/pl/gkyJzUDVDoXMxgri.m3u8?tag=29&v=c0d"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102056407440953345/vid/avc1/480x270/gFtNUkWYJrvOT1of.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102056407440953345/vid/avc1/640x360/p8bYfox7XCj1v2uk.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102056407440953345/vid/avc1/1280x720/_U7wda-c1KcclrSG.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/P39ujCVKKD","expanded_url":"https://x.com/kantei/status/2102057403466633348/video/1","ext_media_availability":{"status":"Available"},"id_str":"2102056407440953345","indices":[64,87],"media_key":"13_2102056407440953345","media_results":{"result":{"media_key":"13_2102056407440953345"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2102056407440953345/img/1fINKds-MoUxHvc2.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/P39ujCVKKD","video_info":{"aspect_ratio":[16,9],"duration_millis":185400,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2102056407440953345/pl/gkyJzUDVDoXMxgri.m3u8?tag=29&v=c0d"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102056407440953345/vid/avc1/480x270/gFtNUkWYJrvOT1of.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102056407440953345/vid/avc1/640x360/p8bYfox7XCj1v2uk.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102056407440953345/vid/avc1/1280x720/_U7wda-c1KcclrSG.mp4?tag=29"}]}}]},"favorite_count":17370,"favorited":false,"full_text":"【お知らせ】\n本日（９月21日）、高市総理は、国連総会出席についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（記者） https://t.co/P39ujCVKKD","id_str":"2102057403466633348","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":472,"reply_count":778,"retweet_count":2820,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIwNTc0MDMzOTExMzE2NDg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（９月21日）、高市総理は、国連総会出席についてのぶらさがり会見を行いました。\n\n※要旨（速報版）\n（記者）\n　総理はこれからニューヨークで国連総会に出席し、一般討論演説に臨まれますが、日本の総理大臣としてどのようなメッセージを発信されるのでしょうか。また、２２日に予定されているトランプ大統領との首脳会談では、米中首脳会談を直前に控える中で、日米首脳間でどのような認識を共有されるお考えでしょうか。加えて、他の国との首脳会談の調整状況についてもお伺いします。\n\n（高市総理）\n　まず冒頭に、台風で犠牲になられた方々に哀悼の誠を捧げます。そして、けがをされた方々に心よりお見舞いを申し上げます。本当に緊張感を持って万全の対応をするように、官房長官そして細野大臣に指示をした上でございますけれども、ただ今から国連総会に出席をするため渡米いたします。\n　今年は、日本の「国連加盟７０周年」という節目の年でございます。『一般討論演説』の内容なのですが、今日もギリギリまでペン入れをしておりましたので、まだ最終調整中ではございますけれども、私としては北朝鮮による「拉致の問題」、それから、これだけ、日本国内でもそうですが、世界各地で災害が起きているということで、「気候変動対策」の重要性、また、「法の支配」の重視、そして国連改革の必要性などを訴えたいと考えております。\n　また、国際社会が直面している課題に対する日本の貢献についても説明をいたします。「進化したＦＯＩＰ」の下、エネルギーを始めとするサプライチェーンの強靱化、グローバルサウスとの連携、またＡＩのような技術革新に伴う課題への対応などについて、日本としてしっかりとリーダーシップを発揮していく、その決意を表明したいと考えております。\n　二国間会談についてのお尋ねでございますが、まずは国連事務総長との間では、５月に会談をしましたことに続きまして、「安保理改革」について議論をしたいと考えております。\n　また、トランプ大統領との日米首脳会談を含め、各国の首脳との会談については最終調整中でございます。国連や諸外国との連携協力を改めて確認する考えでございます。以上です。"}}},"rest_id":"2102057403466633348","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3065075","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102057403466633348","sortIndex":"2102724122432765881"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei