102177498771730432"}},"media_url_https":"https://pbs.twimg.com/media/HSxvTB0bsAAX0ek.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1463,"w":1463,"x":0,"y":0},{"h":1463,"w":1283,"x":23,"y":0},{"h":1463,"w":732,"x":298,"y":0},{"h":1463,"w":2048,"x":0,"y":0}],"height":1463,"width":2048},"sizes":{"large":{"h":1463,"resize":"fit","w":2048},"medium":{"h":857,"resize":"fit","w":1200},"small":{"h":486,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/O5NPyNTYmz"}]},"favorite_count":314,"favorited":false,"full_text":"米国・ニューヨークを訪問中の茂木外務大臣は、イスハーク・ダール・パキスタン副首相兼外務大臣と会談を行いました。茂木大臣から、2027年の日・パキスタン外交関係樹立75周年に向けて、二国間関係を更に強化していきたい旨述べました。また、イラン情勢の沈静化に向けた、ダール副首相をはじめとする https://t.co/O5NPyNTYmz","id_str":"2102177790644928889","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":9,"retweet_count":63,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/fp/unp/p…","expanded_url":"https://www.mofa.go.jp/mofaj/fp/unp/pageit_000001_03207.html","indices":[211,234],"url":"https://t.co/P8PqhzcVib"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIxNzc3OTA1MjMyNDg2NDI=","richtext":{"richtext_tags":[]},"text":"米国・ニューヨークを訪問中の茂木外務大臣は、イスハーク・ダール・パキスタン副首相兼外務大臣と会談を行いました。茂木大臣から、2027年の日・パキスタン外交関係樹立75周年に向けて、二国間関係を更に強化していきたい旨述べました。また、イラン情勢の沈静化に向けた、ダール副首相をはじめとするパキスタン政府の仲介努力に改めて敬意を表し、国際情勢が一層厳しさと複雑さを増す中、ダール副首相と緊密に連携していきたい旨述べました。\n\nhttps://t.co/P8PqhzcVib"}}},"rest_id":"2102177790644928889","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"39706","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102177790644928889","sortIndex":"2102724122432765884"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest