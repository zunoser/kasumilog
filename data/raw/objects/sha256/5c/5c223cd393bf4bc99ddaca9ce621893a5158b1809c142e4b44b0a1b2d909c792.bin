:1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1582,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/u0enHUi6Tv"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/u0enHUi6Tv","expanded_url":"https://x.com/takaichi_sanae/status/2102723365069054281/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":91,"w":91,"x":1387,"y":207},{"h":79,"w":79,"x":1015,"y":257}]},"medium":{"faces":[{"h":53,"w":53,"x":813,"y":121},{"h":46,"w":46,"x":594,"y":150}]},"orig":{"faces":[{"h":116,"w":116,"x":1762,"y":264},{"h":101,"w":101,"x":1289,"y":327}]},"small":{"faces":[{"h":30,"w":30,"x":460,"y":69},{"h":26,"w":26,"x":337,"y":85}]}},"id_str":"2102722932934111232","indices":[84,107],"media_key":"3_2102722932934111232","media_results":{"result":{"media_key":"3_2102722932934111232"}},"media_url_https":"https://pbs.twimg.com/media/HS5fXeaa8AAMYTo.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":278},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/u0enHUi6Tv"}]},"favorite_count":602,"favorited":false,"full_text":"米国・ニューヨークでの一連の日程を終えて、これから日本に帰国します。\n\n今回の訪問の締めくくりに、先ほど、私にとって初めてとなる国連総会での一般討論演説を行いました。 https://t.co/u0enHUi6Tv","id_str":"2102723365069054281","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":16,"retweet_count":99,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDI3MjMzNjQ5ODk0MDcyMzI=","richtext":{"richtext_tags":[]},"text":"米国・ニューヨークでの一連の日程を終えて、これから日本に帰国します。\n\n今回の訪問の締めくくりに、先ほど、私にとって初めてとなる国連総会での一般討論演説を行いました。\n\n日本の国連加盟70周年の節目の年に、日本の総理大臣として、歴史ある国連本部の壇上に立ち、日本の立場をしっかりと発信してまいりました。\n\n国際秩序が揺らぐ今、国連が役割を果たせていないという指摘もあります。\n\nそのような中だからこそ、日本は国連のために大きな責任を果たしていきます。\n\n先ほどの一般討論演説では、2つの切り口から、その決意を訴え、日本の具体的な貢献を発信しました。\n\n第1に、国際情勢の緊迫化により生じる課題への対処について。\n\n中東情勢が緊迫化し、国際公共財たるホルムズ海峡において、自由で安全な航行が困難になっています。\n\n日本は、国際社会と連携し、中東地域全体の事態の早期沈静化・安定化のため、外交努力を継続しています。\n\nまた、進化したFOIPの下で、エネルギー・重要物資のサプライチェーンを強靱化するために、パワー・アジアに加えて、現在、湾岸諸国との包括的な協力計画をまとめていることも打ち出しました。\n\n核兵器のない世界に向けた国際社会の連帯を呼びかけ、北朝鮮の完全な非核化や拉致問題の一刻も早い解決を訴えました。\n\n力や威圧による一方的な現状変更の試みは、世界のどこであっても認めることができないことを主張しました。\n\nICJ、ICC、ITLOSなどの様々な国際裁判所を一貫して支持し、判事を輩出していることにも表れているとおり、日本は、いかなる紛争の解決においても法の支配を重視していくことを表明しました。\n\n第2に、日本の、「国連」を中心とする「多国間主義」へのコミットメントについて。\n\n日本が推進してきた地球規模課題への取組を通じた、「グローバルサウスとの連帯」をアピールしました。\n\nまた、全ての国が真剣に気候変動対策に取り組まなければならないことを訴え、日本の知見や技術の共有を通じて世界の防災対策に貢献する意思を強調しました。\n\n信頼できるAIの実現に向けて、AIサミットを早期に日本で開催する意思を国際社会に示しました。\n\n国際社会の課題に対処するため、国連は、より強靱、かつ実効的な国連に生まれ変わらなければならず、安全保障理事会の改革の必要性や国連憲章の旧敵国条項の削除も求めました。\n\n日本は、国連加盟以来70年間、専守防衛の考えの下、平和国家として、国際社会の平和と繁栄に一貫して貢献してきており、この方針は、今後も一切変わりません。\n\n秋以降の外交機会も含め、各国との連携を深め、国際社会の課題への対処に、力を注いでまいります。"}}},"rest_id":"2102723365069054281","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"21037","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102723365069054281","sortIndex":"2102724122432765952"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2102724122432765953-tweet-210272019630171