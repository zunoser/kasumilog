"x":338,"y":416},{"h":73,"w":73,"x":331,"y":374}]}},"id_str":"2102168516837482496","indices":[146,169],"media_key":"3_2102168516837482496","media_results":{"result":{"media_key":"3_2102168516837482496"}},"media_url_https":"https://pbs.twimg.com/media/HSxnINgboAA9h2_.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1462,"w":1462,"x":586,"y":0},{"h":1462,"w":1282,"x":766,"y":0},{"h":1462,"w":731,"x":1222,"y":0},{"h":1462,"w":2048,"x":0,"y":0}],"height":1462,"width":2048},"sizes":{"large":{"h":1462,"resize":"fit","w":2048},"medium":{"h":857,"resize":"fit","w":1200},"small":{"h":485,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/r7auFQ3HRy"}]},"favorite_count":618,"favorited":false,"full_text":"米国・ニューヨークを訪問中の茂木外務大臣は、日米韓外相会合を実施しました。三者は、北朝鮮への対応や安全保障、経済安全保障分野における協力の進展を歓迎し、地域の平和と安定のため、引き続き三か国の具体的な取組を積み重ねていくことを確認しました。\n\nhttps://t.co/sgL2txbxWP https://t.co/r7auFQ3HRy","id_str":"2102170410888651091","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":19,"retweet_count":104,"retweeted":false,"user_id_str":"303730149"},"rest_id":"2102170410888651091","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"52468","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102170410888651091","sortIndex":"2102724122432765883"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2997445,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":544,"tweets":1801},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2102086914589544829"],"editable_until_msecs":"1790015149000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":206,"bookmarked":false,"conversation_id_str":"2102086914589544829","created_at":"Mon Sep 21 17:25:49 +0000 2026","display_text_range":[0,125],"entities":{},"favorite_count":22961,"favorited":false,"full_text":"台風25号によって犠牲になられた方に、哀悼の誠を捧げます。\nそして、けがをされた方々に、心よりお見舞いを申し上げます。\n\n緊張感を持って万全の対応をするように木原官房長官と細野大臣に指示をした上で、国連総会に出席をするため渡米する飛行機に乗りました。","id_str":"2102086914589544829","is_quote_status":false,"lang":"ja","quote_count":350,"reply_count":1668,"retweet_count":2233,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDIwODY5MTQ1MzkxOTY0MTY=","richtext":{"richtext_tags":[]},"text":"台風25号によって犠牲になられた方に、哀悼の誠を捧げます。\nそして、けがをされた方々に、心よりお見舞いを申し上げます。\n\n緊張感を持って万全の対応をするように木原官房長官と細野大臣に指示をした上で、国連総会に出席をするため渡米する飛行機に乗りました。\n\n本年は、日本の「国連加盟70周年」という節目の年です。\n\n一般討論演説の内容は、日曜日もギリギリまでペン入れをしており、まだ最終調整中ですが、私としては特に、\n①北朝鮮による「拉致問題」、\n②「気候変動対策」の重要性、\n③「法の支配」の重視、\n④国連改革の必要性 、\nなどを訴えたいと考えています。\n\nまた、国際社会が直面する課題に対する日本の貢献についても、説明する予定です。\n・「進化したFOIP」の旗の下、 エネルギーを始めとするサプライチェーン強靭化、\n・グローバルサウスとの連携、\n・ＡＩのような技術革新に伴う課題への対応、\nなどにつき、 日本としてしっかりとリーダーシップを発揮していく決意を表明してまいります。\n\nまた、国連事務総長との会談では、5月の会談に続き、「安保理改革」について議論したいと考えています。\n\nさらに、トランプ大統領との日米首脳会談や各国との首脳会談を最終調整しています。\n国連や諸外国との連携・協力を改めて確認してまいります。"}}},"rest_id":"2102086914589544829","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1092048","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102086914589544829","sortIndex":"2102724122432765882"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_labe