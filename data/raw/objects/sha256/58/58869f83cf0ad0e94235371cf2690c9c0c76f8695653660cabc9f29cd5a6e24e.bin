3},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/kOKwKidz1Q","video_info":{"aspect_ratio":[9,16],"duration_millis":124633,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2108529974202507264/pl/dIYKnPww8ZLcN7nt.m3u8?tag=29&v=456"},{"bitrate":632000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108529974202507264/vid/avc1/320x568/YKfO0UgaZX5-W6TF.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108529974202507264/vid/avc1/480x852/M2ypo0zGjMMIzH3L.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108529974202507264/vid/avc1/720x1280/c3EZNuNORvgbpJnN.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108529974202507264/vid/avc1/1080x1920/6WU9XhzUaQr2-tdq.mp4?tag=29"}]}}]},"favorite_count":1476,"favorited":false,"full_text":"【高市総理・所信表明演説（外交、防衛力・インテリジェンス機能の強化）】\n法の支配の重要性を発信するとともに、和平調停の取組を含め、紛争の平和的解決に、より積極的な役割を果たすなど、法の支配に基づく国際秩序を維持・強化してまいります。 https://t.co/kOKwKidz1Q","id_str":"2108530264335065470","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":13,"reply_count":68,"retweet_count":220,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1005shoshinhyomei.html","indices":[280,303],"url":"https://t.co/VLOHmIUPX1"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1MzAyNjQyNjM4NDM4NDA=","richtext":{"richtext_tags":[]},"text":"【高市総理・所信表明演説（外交、防衛力・インテリジェンス機能の強化）】\n法の支配の重要性を発信するとともに、和平調停の取組を含め、紛争の平和的解決に、より積極的な役割を果たすなど、法の支配に基づく国際秩序を維持・強化してまいります。\n平和は、願うだけで実現するものではありません。高市内閣は、平和と安定のための外交努力を重ねるとともに、防衛力の強化を着実に進め、国民の皆様の生命と財産、そして日本の領土・領海・領空を断固として守り抜いてまいります。\n\n10月5日に行われた高市総理の所信表明演説の動画及びテキストは、官邸HPに掲載しています。\n▼詳細はこちら\nhttps://t.co/VLOHmIUPX1"}}},"rest_id":"2108530264335065470","unmention_data":{},"views":{"count":"33476","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108530264335065470","sortIndex":"2108662825902669813"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"tra