tus/2108516924946579618/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":208,"w":208,"x":410,"y":308}]},"medium":{"faces":[{"h":121,"w":121,"x":240,"y":180}]},"orig":{"faces":[{"h":208,"w":208,"x":410,"y":308}]},"small":{"faces":[{"h":69,"w":69,"x":136,"y":102}]}},"id_str":"2108516913248964608","indices":[146,169],"media_key":"3_2108516913248964608","media_results":{"result":{"media_key":"3_2108516913248964608"}},"media_url_https":"https://pbs.twimg.com/media/HUL09hEbkAAobXK.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":219},{"h":1366,"w":1366,"x":85,"y":0},{"h":1366,"w":1198,"x":169,"y":0},{"h":1366,"w":683,"x":427,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/SULk60TBnL"}]},"favorite_count":660,"favorited":false,"full_text":"10月９日、小泉防衛大臣は、アメリカよりパパロ太平洋軍司令官@USPACOMの表敬訪問を受け、日米同盟の一層の強化、そして地域の平和と安定のため全力を尽くしていくことを確認しました。また、沖縄県那覇市で発生した強盗殺人事件に関し、日本政府として、米側に対し強く抗議するとともに、捜査への全面 https://t.co/SULk60TBnL","id_str":"2108516924946579618","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":13,"retweet_count":92,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"24112747","indices":[30,38],"name":"U.S. Pacific Command","screen_name":"USPACOM"}]},"id":"Tm90ZVR3ZWV0OjIxMDg1MTY5MjQ4ODM3MTQwNDg=","text":"10月９日、小泉防衛大臣は、アメリカよりパパロ太平洋軍司令官@USPACOMの表敬訪問を受け、日米同盟の一層の強化、そして地域の平和と安定のため全力を尽くしていくことを確認しました。また、沖縄県那覇市で発生した強盗殺人事件に関し、日本政府として、米側に対し強く抗議するとともに、捜査への全面的な協力、米軍関係者の綱紀粛正、事件・事故の再発防止の徹底、ご遺族に対する適切な対応を強く求め、引き続き緊密に連携していくことを確認しました。"}}},"rest_id":"2108516924946579618","unmention_d