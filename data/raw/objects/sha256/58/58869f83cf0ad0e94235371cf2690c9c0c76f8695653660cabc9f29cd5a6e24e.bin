{"data":{"list":{"tweets_timeline":{"timeline":{"instructions":[{"entries":[{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3011776,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":576,"tweets":1856},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2108601196542140817"],"editable_until_msecs":"1791568275000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":168,"bookmarked":false,"conversation_id_str":"2108601196542140817","created_at":"Fri Oct 09 16:51:15 +0000 2026","display_text_range":[0,83],"entities":{},"favorite_count":4134,"favorited":false,"full_text":"我が国は、先程の米国によるICCに対する制裁発表を受けて、カナダ、デンマーク、ドイツ、フランス、イタリア、オランダ及び英国と共同で、次の内容の外相声明を発出しました。","id_str":"2108601196542140817","is_quote_status":false,"lang":"ja","quote_count":107,"reply_count":356,"retweet_count":605,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg2MDExOTY0ODMzNjI4MTY=","richtext":{"richtext_tags":[]},"text":"我が国は、先程の米国によるICCに対する制裁発表を受けて、カナダ、デンマーク、ドイツ、フランス、イタリア、オランダ及び英国と共同で、次の内容の外相声明を発出しました。\n\n国際刑事裁判所（ICC）のローマ規程の締約国である私たち署名国は、ICCの独立性、公平性、及び完全性に対する継続的かつ揺るぎない支持を改めて表明します。\n\nICCの断固たる支持者として、私たちは、米国による裁判所への制裁の発表を遺憾に思い、強く反対します。\n\n私たちは、裁判所がローマ規程に基づく任務を引き続き果たせるよう、こうした措置に備えるために裁判所が行った取り組みを高く評価するとともに、その実現を可能にするための揺るぎない支持を改めて強調します。\n\nそれでもなお、実施された場合、これらの制裁は、裁判所の業務、その献身的なスタッフ、およびその家族に重大な影響を及ぼすでしょう。彼らは、最も深刻な国際犯罪で訴追された者を裁きにかけ、被害者を支援するために日々尽力しています。\n\n私たちは、ICCへの支持において一致団結し続けるとともに、2026年12月の締約国会議に向けた準備を進めるにあたり、非締約国との建設的かつ包括的な対話に取り組む姿勢を堅持します。私たちは引き続き協力し合い、裁判所の重要な活動を支援し、ルールに基づく国際秩序を守り、責任追及を推進していきます。"}}},"rest_id":"2108601196542140817","unmention_data":{},"views":{"count":"264018","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108601196542140817","sortIndex":"2108662825902669824"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=orig","width":1200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":630,"url":"https://pbs.twimg.com/card_img/2107974813260390400/1SiGpm8X?format=png&name=2048x2048_2_exp","width":1200},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"mofa.go.jp","type":"STRING"}},{"key":"thumbnail_image_color","value":{"image_color_value":{"palette":[{"percentage":75.17,"rgb":{"blue":255,"green":255,"red":255}},{"percentage":14.68,"rgb":{"blue":160,"green":0,"red":0}},{"percentage":6.18,"rgb":{"blue":4,"green":4,"red":4}},{"percentage":2.24,"rgb":{"blue":196,"green":119,"red":120}},{"percentage":0.44,"rgb":{"blue":208,"green":154,"red":153}}]},"type":"IMAGE_COLOR"}},{"key":"title","value":{"string_value":"国際刑事裁判所（ICC）に関する外相共同声明の発出","type":"STRING"}},