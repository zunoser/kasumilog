ia_key":"3_2108544230725672960","media_results":{"result":{"media_key":"3_2108544230725672960"}},"media_url_https":"https://pbs.twimg.com/media/HUMNzmmaYAAkg4H.jpg","original_info":{"focus_rects":[{"h":472,"w":842,"x":0,"y":124},{"h":596,"w":596,"x":123,"y":0},{"h":596,"w":523,"x":160,"y":0},{"h":596,"w":298,"x":272,"y":0},{"h":596,"w":842,"x":0,"y":0}],"height":596,"width":842},"sizes":{"large":{"h":596,"resize":"fit","w":842},"medium":{"h":596,"resize":"fit","w":842},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uDSvDsO4xH"}]},"favorite_count":400,"favorited":false,"full_text":"令和８年１０月９日（金）午後、ロシアの情報収集機（ＩＬ－２０）×１機が、大陸方面から飛来し、オホーツク海を経由し太平洋に進出した後、岩手県沖まで南下、反転し、オホーツク海を経由して日本海に至ったことを確認した。 https://t.co/uDSvDsO4xH","id_str":"2108544238116065772","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"quoted_status_id_str":"2108543012695618026","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2108543012695618026","url":"https://t.co/lOKuNV8qy0"},"reply_count":4,"retweet_count":116,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1NDQyMzgwNjE2MDQ4NjQ=","text":"令和８年１０月９日（金）午後、ロシアの情報収集機（ＩＬ－２０）×１機が、大陸方面から飛来し、オホーツク海を経由し太平洋に進出した後、岩手県沖まで南下、反転し、オホーツク海を経由して日本海に至ったことを確認した。\nこれに対し、航空自衛隊の北部航空方面隊等の戦闘機を緊急発進させ対応した。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360640,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6360,"tweets":12405},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2108543012695618026"],"editable_until_msecs":"1791554403000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":6,"bookmarked":false,"conversation_id_str":"2108543012695618026","created_at":"Fri Oct 09 13:00:03 +0000 2026","display_text_range":[0,105],"entities":{"media":[{"display_url":"pic.x.com/vGBWTM1BgS","expanded_url":"https://x.com/jointstaffpa/stat