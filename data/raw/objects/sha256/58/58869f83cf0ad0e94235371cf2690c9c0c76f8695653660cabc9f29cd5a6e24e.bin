e},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":576,"tweets":1856},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2108507707892212181"],"editable_until_msecs":"1791545986000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":449,"bookmarked":false,"conversation_id_str":"2108507707892212181","created_at":"Fri Oct 09 10:39:46 +0000 2026","display_text_range":[0,44],"entities":{},"favorite_count":18855,"favorited":false,"full_text":"今日の閣議において、公務員の給与改定に関する取扱方針と、関係法案の改正案を決定しました。","id_str":"2108507707892212181","is_quote_status":false,"lang":"ja","quote_count":481,"reply_count":1579,"retweet_count":1851,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1MDc3MDc4NDYwNTM4ODg=","richtext":{"richtext_tags":[]},"text":"今日の閣議において、公務員の給与改定に関する取扱方針と、関係法案の改正案を決定しました。\n\n私自身は、総理に就任した昨年10月21日から、総理大臣給与を自主返納していましたが、高市内閣としては、昨年末から閣僚、副大臣、政務官等については、「議員歳費を超える分を受け取らない措置」を開始しており、これを継続します。\n\nちなみに、この措置により、年間約6.5億円の節約になります。"}}},"rest_id":"2108507707892212181","unmention_data":{},"views":{"count":"2611033","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108507707892212181","sortIndex":"2108662825902669800"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"r