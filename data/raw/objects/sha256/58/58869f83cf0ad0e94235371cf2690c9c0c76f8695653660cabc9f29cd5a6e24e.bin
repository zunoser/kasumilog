:"pic.x.com/BTpKorg4as","expanded_url":"https://x.com/ModJapan_jp/status/2108546986530206202/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2108546979521544192","indices":[114,137],"media_key":"3_2108546979521544192","media_results":{"result":{"media_key":"3_2108546979521544192"}},"media_url_https":"https://pbs.twimg.com/media/HUMQTmqawAA_0BL.jpg","original_info":{"focus_rects":[{"h":472,"w":842,"x":0,"y":0},{"h":596,"w":596,"x":123,"y":0},{"h":596,"w":523,"x":160,"y":0},{"h":596,"w":298,"x":272,"y":0},{"h":596,"w":842,"x":0,"y":0}],"height":596,"width":842},"sizes":{"large":{"h":596,"resize":"fit","w":842},"medium":{"h":596,"resize":"fit","w":842},"small":{"h":481,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/BTpKorg4as"}]},"favorite_count":462,"favorited":false,"full_text":"フランス哨戒機が７度目となる「瀬取り」に対する警戒監視活動を実施予定🇯🇵🤝🇫🇷\n10月中旬から11月上旬の間、🇫🇷海軍哨戒機「ファルコン50M」が、北朝鮮籍船舶の「瀬取り」を含む違法な海上活動に対する警戒監視活動を実施します👀 https://t.co/BTpKorg4as","id_str":"2108546986530206202","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":65,"retweet_count":111,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1NDY5ODY0ODgyNTg1NjA=","text":"フランス哨戒機が７度目となる「瀬取り」に対する警戒監視活動を実施予定🇯🇵🤝🇫🇷\n10月中旬から11月上旬の間、🇫🇷海軍哨戒機「ファルコン50M」が、北朝鮮籍船舶の「瀬取り」を含む違法な海上活動に対する警戒監視活動を実施します👀\n \n防衛省・自衛隊は国際社会とともに、国連安保理決議の実効性確保に取り組みます💪"}}},"rest_id":"2108546986530206202","unmention_data":{},"views":{"count":"22576","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108546986530206202","sortIndex":"2108662825902669820"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_twe