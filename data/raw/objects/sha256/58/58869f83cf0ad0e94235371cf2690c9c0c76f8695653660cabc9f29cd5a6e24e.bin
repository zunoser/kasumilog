eo/2108520994554163200/vid/avc1/720x1280/BaIoKO7e1b68MjZk.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2108520994554163200/vid/avc1/1080x1920/z66JWADCZ-FET8hf.mp4?tag=29"}]}}]},"favorite_count":966,"favorited":false,"full_text":"【高市総理・所信表明演説（人口減少社会への対応）】\n人口減少は、静かに進む国難です。少子化の流れを反転させるとともに、人口減少社会に適応した新たな国のかたちを築かなければなりません。 https://t.co/CFDS3bCUTg","id_str":"2108521342756872630","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":31,"reply_count":153,"retweet_count":163,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"kantei.go.jp/jp/105/stateme…","expanded_url":"https://www.kantei.go.jp/jp/105/statement/2026/1005shoshinhyomei.html","indices":[231,254],"url":"https://t.co/VLOHmIUPX1"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg1MjEzNDI2OTQwNDM2NDk=","richtext":{"richtext_tags":[]},"text":"【高市総理・所信表明演説（人口減少社会への対応）】\n人口減少は、静かに進む国難です。少子化の流れを反転させるとともに、人口減少社会に適応した新たな国のかたちを築かなければなりません。\n人手不足は、人口減少社会の最大の課題です。医療・介護、物流・公共交通などのエッセンシャルサービスを守り、国内投資拡大にも対応するため、AXの社会実装を大胆に進めます。\n\n10月5日に行われた高市総理の所信表明演説の動画及びテキストは、官邸HPに掲載しています。\n▼詳細はこちら\nhttps://t.co/VLOHmIUPX1"}}},"rest_id":"2108521342756872630","unmention_data":{},"views":{"count":"40203","state":"EnabledWithCount"}}}}},"entryId":"tweet-2108521342756872630","sortIndex":"2108662825902669812"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"fa