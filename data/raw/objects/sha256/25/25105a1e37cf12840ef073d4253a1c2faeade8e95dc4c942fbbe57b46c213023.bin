le_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":195,"following":1},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1942787083636203521","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":28,"tweets":129},"verification":{"verified":false},"website":{"url":"https://t.co/ghrnEoIQLo"}}}},"edit_control":{"edit_tweet_ids":["2118547468719915482"],"editable_until_msecs":"1793939651000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2118547468719915482","created_at":"Fri Nov 06 03:34:11 +0000 2026","display_text_range":[0,133],"entities":{},"favorite_count":9,"favorited":false,"full_text":"【開催まであと6日📣  参加者募集中！】\n\n11/12（木）の個人向けセミナーでは、スウェーデンやドイツの事例と比較しながら、日本の育児休業の特徴と多様な取得のあり方についてわかりやすく解説します🌱\n\n🎤講師：甲南大学教授 中里英樹氏\n\n✅男性の育休取得は何のため？","id_str":"2118547468719915482","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":0,"retweet_count":2,"retweeted":false,"user_id_str":"1942787083636203521"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[300,304],"text":"共育て"},{"indices":[305,310],"text":"プレパパ"},{"indices":[311,316],"text":"男性育休"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"t.co/yinGzPskjr","expanded_url":"https://tomoiku.mhlw.go.jp/seminarevent/individual/1112/","indices":[275,298],"url":"https://t.co/yinGzPskjr"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTg1NDc0Njg2NDQ0OTUzNjA=","richtext":{"richtext_tags":[]},"text":"【開催まであと6日📣  参加者募集中！】\n\n11/12（木）の個人向けセミナーでは、スウェーデンやドイツの事例と比較しながら、日本の育児休業の特徴と多様な取得のあり方についてわかりやすく解説します🌱\n\n🎤講師：甲南大学教授 中里英樹氏\n\n✅男性の育休取得は何のため？\n✅国際比較から見る日本の育児休業制度\n✅育休を自分らしいライフ・キャリアに活かすには\n\nこれから父親になる方や、ご夫婦で育休取得を考えている方におすすめです。ぜひご参加ください！\n\n📅11/12（木）12:00〜13:00\n💻オンライン開催・参加無料\n\n🔻詳細・お申し込みはこちら\nhttps://t.co/yinGzPskjr\n\n#共育て #プレパパ #男性育休"}}},"rest_id":"2118547468719915482","unmention_data":{},"views":{"count":"8774","state":"EnabledWithCount"}}},"user_id_str":"180585090"},"rest_id":"2119977544414109732","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2165","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119977544414109732","sortIndex":"2120295728793255863"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/miq7n8P0WC"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1153541724804792320/1IxAaRLZ_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Tue Dec 09 09:21:37 +0000 2014","name":"気象庁","screen_name":"JMA_kishou"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTIzNjU4MDEy","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"気象庁 (JMA:Japan Meteorological Agency) 公式アカウントです。報道発表やイベント案内などをお届けします。\n警報などの防災気象情報は気象庁ホームページをご覧ください。\n※運用ポリシー：https://t.co/v07vjnVmr5","entities":{"description":{"urls":[{"display_url":"jma.go.jp/jma/menu/socia…","expanded_