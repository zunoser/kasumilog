bleDeduplication":true}}},"entryId":"list-conversation-2120295728793255998","sortIndex":"2120295728793255874"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/siHKH3bRrd"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3075854,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":624,"tweets":1946},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2119995052680519879"],"editable_until_msecs":"1794284782000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":472,"bookmarked":false,"conversation_id_str":"2119995052680519879","created_at":"Tue Nov 10 03:26:22 +0000 2026","display_text_range":[0,118],"entities":{},"favorite_count":23853,"favorited":false,"full_text":"日本が強みを有する「お米」や「米粉」の消費拡大や需要創出は、万が一の事態における「食料安全保障」の強化や日本の豊かな水田の維持につながる重要な取組です。\n\n特に「米粉」は、近年、美味しさやその特徴を活かした様々な商品が増えてきています。","id_str":"2119995052680519879","is_quote_status":false,"lang":"ja","quote_count":498,"reply_count":1604,"retweet_count":2801,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"jyuku.komeko-times.jp/award2","expanded_url":"https://jyuku.komeko-times.jp/award2","indices":[460,483],"url":"https://t.co/siHKH3bRrd"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTk5OTUwNTI1NTQ2MTY4MzI=","richtext":{"richtext_tags":[]},"text":"日本が強みを有する「お米」や「米粉」の消費拡大や需要創出は、万が一の事態における「食料安全保障」の強化や日本の豊かな水田の維持につながる重要な取組です。\n\n特に「米粉」は、近年、美味しさやその特徴を活かした様々な商品が増えてきています。\nさらに、小麦アレルギーの方やグルテンを気にする方にも安心してご利用いただける「ノングルテン」（グルテン含有量がグルテンフリーよりも２０倍厳しい基準）といった、新たな付加価値を持つ食材としても注目されています。\n\n私も、外交行事の場を借りて、外国から来られるお客様に、「米粉」で出来たスィーツなどをふるまい、需要の開拓に取り組んでいます。\n\nそうした中、このたび、農林水産省で、ノングルテン米粉をはじめとする「米粉」の消費拡大や需要創出に向け、今後期待できる商品や優秀な取組を発掘・表彰するため「米粉アワード」を創設し、本日から募集を開始しています。\n\n是非、多くの皆様にご応募いただき、「米粉」の更なる需要拡大につながることを期待しています。\n\n【米粉アワード2026特設サイト】\nhttps://t.co/siHKH3bRrd"}}},"rest_id":"2119995052680519879","unmention_data":{},"views":{"count":"1093833","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119995052680519879","sortIndex":"2120295728793255873"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2119992034291585024/gbX0wkXJ?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2119992034291585024/gbX0wkXJ?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"官房長官の定例記者会見の様子などをご覧になれます。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.kantei.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2119992034291585024/gbX0wkXJ?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2119992034291585024/gbX0wkXJ?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":540,"url":"https://pbs.twimg.com/card_img/2119992034291585024/gbX0wkXJ?format=jpg&name=orig","width":960},"type":"IMAGE"}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2119992034291585024/gbX0wkXJ?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"summary_photo_image_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/21