tent_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123748010618499072/vid/avc1/1280x720/JXjWQc9y2a8rMx7z.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123748010618499072/vid/avc1/1920x1080/q1f5dnLswx30Ztm_.mp4?tag=29"},{"bitrate":25128000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2123748010618499072/vid/avc1/3840x2160/T7YPH8fD-fs9AUp5.mp4?tag=29"}]}}]},"favorite_count":1497,"favorited":false,"full_text":"11月20日、小泉防衛大臣は、チリのフェルナンド・バロス国防大臣と防衛省において初の日・チリ防衛相会談を実施しました。\n\n日本とチリは地理的には遠く離れているものの、太平洋を挟んだ隣人として、民主主義や法の支配といった基本的価値を共有する重要なパートナーです。 https://t.co/cqZDUxLTKB","id_str":"2123748393264767408","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":9,"quoted_status_id_str":"2123337489993847260","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2123337489993847260","url":"https://t.co/1rJVFKjFqB"},"reply_count":22,"retweet_count":282,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM3NDgzOTMxOTM1NTgwMTY=","text":"11月20日、小泉防衛大臣は、チリのフェルナンド・バロス国防大臣と防衛省において初の日・チリ防衛相会談を実施しました。\n\n日本とチリは地理的には遠く離れているものの、太平洋を挟んだ隣人として、民主主義や法の支配といった基本的価値を共有する重要なパートナーです。\n\n両大臣は、両国の防衛協力を新たな段階へと発展させるための文書に署名するとともに、太平洋地域の平和・安全・安定に向けた共通の責務と戦略的利益を確認し、戦略的協力の更なる強化とより堅固で継続的なパートナーシップの構築に向けて一致しました。\n\n今後も日本とチリの防衛協力・交流の更なる深化を図っていきます。🇯🇵🤝🇨🇱"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523