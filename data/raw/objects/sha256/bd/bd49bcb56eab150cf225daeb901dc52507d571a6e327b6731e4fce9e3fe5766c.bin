"pic.x.com/42inovGPM5","expanded_url":"https://x.com/takaichi_sanae/status/2123917676452192392/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":198,"w":198,"x":92,"y":1036}]},"medium":{"faces":[{"h":116,"w":116,"x":53,"y":607}]},"orig":{"faces":[{"h":396,"w":396,"x":184,"y":2072}]},"small":{"faces":[{"h":65,"w":65,"x":30,"y":343}]}},"id_str":"2123917547976392704","indices":[77,100],"media_key":"3_2123917547976392704","media_results":{"result":{"media_key":"3_2123917547976392704"}},"media_url_https":"https://pbs.twimg.com/media/HXmrwcNaAAAdv6G.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":2836,"w":2836,"x":1136,"y":0},{"h":2836,"w":2488,"x":1310,"y":0},{"h":2836,"w":1418,"x":1845,"y":0},{"h":2836,"w":4096,"x":0,"y":0}],"height":2836,"width":4096},"sizes":{"large":{"h":1418,"resize":"fit","w":2048},"medium":{"h":831,"resize":"fit","w":1200},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/42inovGPM5"}]},"favorite_count":11762,"favorited":false,"full_text":"【日本列島を、強く豊かに。：茨城編】\n\n本日は、『地域未来戦略』に基づき茨城県が策定した、「宇宙関連分野における地域産業クラスター計画」をご紹介します。 https://t.co/42inovGPM5","id_str":"2123917676452192392","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":154,"reply_count":779,"retweet_count":1393,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[800,812],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjM5MTc2NzYzNzY2MzMzNDQ=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：茨城編】\n\n本日は、『地域未来戦略』に基づき茨城県が策定した、「宇宙関連分野における地域産業クラスター計画」をご紹介します。\n\n茨城県つくば地域には、宇宙航空研究開発機構（JAXA）の筑波宇宙センターをはじめ、多くの研究機関や大学が集積しており、近年、宇宙関連ベンチャーの立地も相次いでいます。\n\nまた、県北の臨海地域には、電機・機械産業の工場群とそれらを支える協力企業といった県内ものづくり企業が集積しており、宇宙機器製造分野におけるサプライヤーとしての役割が期待されています。\n\n一方で、人工衛星等の宇宙機器の部品はその多くを海外に依存しており、サプライチェーンが国内で完結できていないという課題があります。\n\nこのため、茨城県は、『地域未来戦略』の国の支援も活用し、研究機関の試験設備や宇宙機器製品の製造装置などに対する官民投資を行い、つくば地域に集積する宇宙関連企業を核に、県内のものづくり企業等をサプライヤーとする「宇宙産業クラスター」の形成を目指しています。\n\n宇宙関連企業の更なる集積を図るとともに、サプライヤーとなるものづくり企業については、従来の部品加工・受託加工から、高付加価値かつ価格決定力のある製品の製造への転換を図り、宇宙機器の国産化、地場産業化の実現を目指しています。\n\n私自身、大井川知事から以下の意気込みを伺いました。\n\n「本県では、2018年から全国に先駆けて宇宙産業振興に取り組んできたところであり、この計画では、本県がさらに宇宙分野で勝ち抜くために、宇宙ベンチャーを核とし、JAXA等の研究機関や、ものづくり企業との連携のもと、宇宙機器のコンポーネントを開発・製造する産業クラスター形成を目指しています。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を全力で応援してまいります。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2123917676452192392","unmention_data":{},"views":{"count":"396190","state":"EnabledWithCount"}}}}},"entryId":"tweet-2123917676452192392","sortIndex":"2125107750542245802"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式