:false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3087100,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":650,"tweets":1982},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2124347058635280853"],"editable_until_msecs":"1795322381000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":106,"bookmarked":false,"conversation_id_str":"2124347058635280853","created_at":"Sun Nov 22 03:39:41 +0000 2026","display_text_range":[0,94],"entities":{},"favorite_count":7266,"favorited":false,"full_text":"11月は、「人材開発促進月間」です。\n\nものづくりなどの優れた技能は、我が国の経済力の基盤となるものであり、その振興を図るとともに、職業能力を正しく評価し、向上を図っていくことが重要です。","id_str":"2124347058635280853","is_quote_status":false,"lang":"ja","quote_count":137,"reply_count":1232,"retweet_count":809,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"reskilling-action.mhlw.go.jp","expanded_url":"https://reskilling-action.mhlw.go.jp/","indices":[1061,1084],"url":"https://t.co/7H1wQhNqhm"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjQzNDcwNTg0MzgxODQ5NjA=","text":"11月は、「人材開発促進月間」です。\n\nものづくりなどの優れた技能は、我が国の経済力の基盤となるものであり、その振興を図るとともに、職業能力を正しく評価し、向上を図っていくことが重要です。\n\n国内では、若者が様々な職種で技能を競い合う「技能五輪全国大会」が行われており、今年は12月4日から開催されます。\nまた、「技能五輪国際大会」は、次回の2028年大会が、日本で21年ぶりに愛知で開催される予定です。\n国内外の皆様に次代の日本を支える優れた技能に触れていただき、知っていただく絶好の機会です。\n\n職業能力を評価する仕組みとして、「技能検定」があります。\n・ものづくりや社会インフラを支える機械保全、電子機器組立て、とび、左官、\n・生活を支えるビルクリーニングやパン製造、\n・情報化社会を支えるウェブデザインや情報配線施工など、\n計133職種で検定が行われ、合格した方は「技能士」と名乗ることができます。\n\nこうした技能を磨き上げ、その道で第一人者と目されている技能者に対し、今月9日に、「卓越した技能者（現代の名工）」として141名に厚生労働大臣表彰を行いました。\n\nあわせて、産業構造の変化とともに職業人生が長期化・多様化している中で、「リ・スキリング」（新しいスキルや知識を習得して、別の職務や業務ができるようになること）の取組が重要になっています。\n\n全国のポリテクセンターや都道府県において、専門技能・技術の向上のための訓練や、生産性向上に必要な知識習得のための訓練などを実施しています。\n\n労働者個人に対しては、「教育訓練給付金」（教育訓練を受講した方に費用の一部を支給）や「教育訓練休暇給付金」（教育訓練に専念するため休暇を取得した場合に賃金の一定割合を支給）による支援とともに、ハローワーク窓口やオンラインで「キャリアコンサルティング」を提供しています。\n\n企業に対しては、「人材開発支援助成金」（職業訓練を実施した場合に訓練経費や訓練期間中の賃金の一部を助成）による支援とともに、生産性向上人材育成支援センター（全国で87カ所）において「伴走型の相談支援」を行っています。\n\nさらに、技能五輪国際大会(2028年)までの3年間を集中実施期間として、「全世代型リ・スキリング国民運動」を展開し、労働者、企業、教育機関、業界団体など、様々なレベルでの取組促進や機運醸成を図ることとしています。\n先週、この国民運動の「特設サイト」も開設していますので、ご関心のある方は是非参考にしていただければと思います。\nhttps://t.co/7H1wQhNqhm"}}},"rest_id":"2124347058635280853","unmention_data":{},"views":{"count":"358562","state":"EnabledWithCount"}}}}},"entryId":"tweet-2124347058635280853","sortIndex":"2125107750542245812"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisp