迫瑞希 さんに自然体でお話を伺っていただきました🥂\n今回は、BPキャピタル株式会社の浜田さんと濱村さんを迎えし、地方創生や知財活用の重要性について語っていただきました。ぜひご覧ください！","id_str":"2125061851113550118","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"quoted_status_id_str":"2121166198221979996","quoted_status_permalink":{"display":"x.com/IP_BASE/status…","expanded":"https://twitter.com/IP_BASE/status/2121166198221979996","url":"https://t.co/Z8cEdsZfnw"},"reply_count":2,"retweet_count":1,"retweeted":false,"user_id_str":"281874178"},"quoted_status_result":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2123312520567922688/_BLD30fI?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.6632","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2123312520567922688/_BLD30fI?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description","value":{"string_value":"特許庁『IP BASEチャンネル』MC大迫瑞季の新企画！記念すべき第１回はBPキャピタル株式会社の浜田さんと濱村さんの２名をお迎えし...","type":"STRING"}},{"key":"domain","value":{"string_value":"www.youtube.com","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2123312520567922688/_BLD30fI?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2123312520567922688/_BLD30fI?format=jpg&name=386x202","width":386},