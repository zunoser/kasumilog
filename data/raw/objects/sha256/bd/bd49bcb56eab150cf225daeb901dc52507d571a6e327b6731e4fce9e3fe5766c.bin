control":{"edit_tweet_ids":["2121166198221979996"],"editable_until_msecs":"1794564005000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"IP_BASE"}}},"policy":"ByInvitation"},"conversation_id_str":"2121166198221979996","created_at":"Fri Nov 13 09:00:05 +0000 2026","display_text_range":[0,141],"entities":{"hashtags":[{"indices":[1,8],"text":"IPBASE"},{"indices":[31,39],"text":"スタートアップ"},{"indices":[48,51],"text":"知財"},{"indices":[98,103],"text":"大迫瑞季"}]},"favorite_count":0,"favorited":false,"full_text":"◤#IPBASE YouTubeチャンネルで動画公開中！◢\n\n#スタートアップ に知ってほしい、#知財 に関するコンテンツを配信する「IP BASEチャンネル」。\n新企画として、チャンネルMCの #大迫瑞季 がお酒を片手にゆるりとお話を伺う『大迫瑞季の乾杯トーク』がはじまりました！","id_str":"2121166198221979996","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":1,"retweet_count":0,"retweeted":false,"user_id_str":"938375954149261312"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[1,8],"text":"IPBASE"},{"indices":[31,39],"text":"スタートアップ"},{"indices":[48,51],"text":"知財"},{"indices":[98,103],"text":"大迫瑞季"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/wpDn6djVBiI","expanded_url":"https://youtu.be/wpDn6djVBiI","indices":[636,659],"url":"https://t.co/Iyo2N7QtDd"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjExNjYxOTgwNjY4Mzk1NTI=","text":"◤#IPBASE YouTubeチャンネルで動画公開中！◢\n\n#スタートアップ に知ってほしい、#知財 に関するコンテンツを配信する「IP BASEチャンネル」。\n新企画として、チャンネルMCの #大迫瑞季 がお酒を片手にゆるりとお話を伺う『大迫瑞季の乾杯トーク』がはじまりました！\nインタビューしたのは、このお二人です。\n\nBPキャピタル株式会社\n👨‍💻執行役員／マネージングパートナー 浜田智さん\n👨‍💻チーフキャピタリスト 濱村晃司さん\n\n「地域から日本を元気にする」をスローガンに掲げるBPキャピタル株式会社が第1号ファンドとして立ち上げたのが『奥能登SDGsファンド』。\n石川県在住の濱村さんは当初、このファンドには金融機関側として携わっていたそう。\nその後、震災をきっかけに復興ファンドがスタートしたタイミングでBPキャピタルへ合流したのだとか。\n今回はそんなエピソードをお聞きしながら、独自の特許技術をもつ出資先が生産する新しい和酒『能登浄酎』をふるまっていただきました！\n\nさらに、出資を通じて事業化を後押しした陸上養殖のお魚、甘味料不使用のグラノーラも味わいながら、知財活用の重要性や地方創生の取り組みについてお話いただきました☺\n\n地域のスタートアップと投資家、どちらの視点でもご参考いただける動画になっています。\nぜひご視聴ください！👇\n\n▼【大迫瑞季の乾杯トーク #1】ただ者じゃない人を募集！？地域から日本を元気にするBPキャピタルの思いとは？\nhttps://t.co/Iyo2N7QtDd"}}},"rest_id":"2121166198221979996","unmention_data":{},"views":{"count":"1833","state":"EnabledWithCount"}}}},"rest_id":"2125061851113550118","unmention_data":{},"views":{"count":"1152","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2125107750542245932-tweet-2125061851490943213","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/281874178/1611288198"},"core":{"created_at":"Thu Apr 14 04:13:40 +0000 2011","name":"特許庁","screen_name":"jpo_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODE4NzQxNzg=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関3-4-3"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"特許庁の公式アカウントです。特許庁ホームページの主な更新情報等に関する情報を提供します。運用方針は以下をご覧ください。https://t.co/7eNLi8gZcH　\n公的機関との間でのリプライやリツイートについて試行中です。","entities":{"description":{"urls":[{"display_url":"meti.go.jp/sns/sns_policy…","expanded_url":"https://www.meti.go.jp/sns/sns_policy.html","indices":[59,82],"url":"htt