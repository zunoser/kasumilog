it","w":541},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/vSUCh3eCDF"}]},"favorite_count":126,"favorited":false,"full_text":"振り込め詐欺などの被害に遭った場合でも、振り込んだお金が返ってくる可能性があります。\n速やかに警察と振込先の金融機関に連絡してください。\n\n※11月23日から29日にかけて、新聞各紙にモノクロの広告を順次掲載しています。\nhttps://t.co/oZJtzHJz3i https://t.co/vSUCh3eCDF","id_str":"2124646610520977612","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":5,"reply_count":15,"retweet_count":62,"retweeted":false,"user_id_str":"461064204"},"rest_id":"2124646610520977612","unmention_data":{},"views":{"count":"13184","state":"EnabledWithCount"}}}}},"entryId":"tweet-2124646610520977612","sortIndex":"2125107750542245815"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"description","value":{"string_value":"リチウムイオン電池の特性や火災事故の現状を解説しています。「買うとき・使うとき・捨てるとき」の3つの観点から、安全に使用するためのポイントや事故防止の具体的な対策をご紹介します。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.fdma.go.jp","type":"STRING"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"fdma.go.jp","type":"STRING"}},{"key":"title","value":{"string_value":"リチウムイオン電池総合対策ポータル本部 | 総務省消防庁","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/RTeusaPwsU","type":"STRING"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary","url":"https://t.co/RTeusaPwsU","user_refs_results":[]},"rest_id":"https://t.co/RTeusaPwsU"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3087100,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":650,"tweets":1982},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2124641302050648313"],"editable_until_msecs":"1795392534000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":282,"bookmarked":false,"conversation_id_str":"2124641302050648313","created_at":"Sun Nov 22 23:08:54 +0000 2026","display_text_range":[0,133],"entities":{},"favorite_count":27556,"favorited":false,"full_text":"朝晩を中心に冷え込みを感じる季節となりました。\n\n冬は、空気が乾燥し、住宅火災が多くなる季節です。\n\n住宅火災の原因は、電気器具類、コンロ、たばこ、ストーブが上位を占めています。\n\n寒さが増し、電気毛布やこたつ、ストーブなどの暖房器具を使い始めた方も多いと思います。","id_str":"2124641302050648313","is_quote_status":false,"lang":"ja","quote_count":259,"reply_count":1865,"retweet_count":2834,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"fdma.go.jp/relocation/lit…","expanded_url":"https://www.fdma.go.jp/relocation/lithium-ion/","indices":[704,727],"url":"https://t.co/RTeusaPwsU"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjQ2NDEzMDE4NzAzNjY3MjA=","richtext":{"richtext_tags":[]},"text":"朝晩を中心に冷え込みを感じる季節となりました。\n\n冬は、空気が乾燥し、住宅火災が多くなる季節です。\n\n住宅火災の原因は、電気器具類、コンロ、たばこ、ストーブが上位を占めています。\n\n寒さが増し、電気毛布やこたつ、ストーブなどの暖房器具を使い始めた方も多いと思います。\n\n暖房器具を使用する際には破損がないか確認し、ストーブの周りや電源コードの上に物を置かないようにしましょう。\n外出時や就寝前には火の元を確認するなど、日頃から火災予防を心がけて下さい。\n\nまた、火災の早期発見と速やかな避難には、住宅用火災警報器が役に立ちます。\n設置の確認と定期的な点検をお願い申し上げます。\n\n冬は、林野火災も発生しやすくなります。\n\n林野火災は、ひとたび発生すると、強風などによって急速に燃え広がり、大きな被害をもたらすおそれもあります。\n屋外での火の取扱いには、十分注意して下さい。\n\nそして、もう一つ気をつけていただきたいのが、リチウムイオン電池による火災です。\n\n買うとき、使うとき、捨てるとき。\n ・賢く選ぶ。（Cool choice）\n ・丁寧に使う。（Careful use）\n ・正しく捨てる、そして資源循環。\n（Correct disposal with better  recycling）\nそれぞれの場面で、安全を守る「3つのC」を大切にして下さい。\n \n政府では、『リチウムイオン電池総合対策パッケージ』を取りまとめました。\n\n消防庁では、リチウムイオン電池総合対策ポータルサイトを作成し、事故防止や適切な廃棄に役立つ情報を一元的に発信しています。\n\n【リチウムイオン電池総合対策ポータルサイト】\nhttps://t.co/RTeusaPwsU\n\n「自分は大丈夫」と思わず、今一度、身の回りの火の元を確認してみて下さい。\n\n一人ひとりの心がけが、ご自身やご家族、そして地域の皆様の命と暮らしを守ることにつながります。\n\n皆様のご協力を、よろしくお願い申し上げます。"}}},"rest_id":"2124641302050648313","unmention_data":{},"views":{"count":"887491","state":"EnabledWithCount"}}}}},"entryId":"tweet-2124641302050648313","sortIndex":"2125107750542245814"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"su