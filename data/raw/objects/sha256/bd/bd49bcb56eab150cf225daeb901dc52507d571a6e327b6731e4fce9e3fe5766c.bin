":{"large":{"h":720,"resize":"fit","w":1040},"medium":{"h":720,"resize":"fit","w":1040},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KqNf9EIh53"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/KqNf9EIh53","expanded_url":"https://x.com/takaichi_sanae/status/2125029230631371118/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2125023478827143169","indices":[108,131],"media_key":"3_2125023478827143169","media_results":{"result":{"media_key":"3_2125023478827143169"}},"media_url_https":"https://pbs.twimg.com/media/HX2ZmFrbUAEAJJ9.jpg","original_info":{"focus_rects":[{"h":582,"w":1040,"x":0,"y":98},{"h":720,"w":720,"x":320,"y":0},{"h":720,"w":632,"x":384,"y":0},{"h":720,"w":360,"x":520,"y":0},{"h":720,"w":1040,"x":0,"y":0}],"height":720,"width":1040},"sizes":{"large":{"h":720,"resize":"fit","w":1040},"medium":{"h":720,"resize":"fit","w":1040},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/KqNf9EIh53"}]},"favorite_count":8583,"favorited":false,"full_text":"本日11月24日（いいにほんしょく）は、「和食の日」ということで、和食に関するお話です。\n\n2013年に「和食；日本人の伝統的な食文化」がユネスコ無形文化遺産に登録され、「和食文化」は、世界共通の財産となりました。 https://t.co/KqNf9EIh53","id_str":"2125029230631371118","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":135,"reply_count":772,"retweet_count":962,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"maff.go.jp/j/keikaku/syok…","expanded_url":"https://www.maff.go.jp/j/keikaku/syokubunka/k_ryouri/index.html","indices":[712,735],"url":"https://t.co/ZSx9B8ekyK"},{"display_url":"maff.go.jp/j/keikaku/syok…","expanded_url":"https://www.maff.go.jp/j/keikaku/syokubunka/traditional-foods/index.html","indices":[737,760],"url":"https://t.co/wd1i9IN156"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjUwMjkyMzA0ODAzODQwMDA=","richtext":{"richtext_tags":[]},"text":"本日11月24日（いいにほんしょく）は、「和食の日」ということで、和食に関するお話です。\n\n2013年に「和食；日本人の伝統的な食文化」がユネスコ無形文化遺産に登録され、「和食文化」は、世界共通の財産となりました。\n\n和食は、「自然を尊重する」という心に基づいた日本人の食慣習であり、我が国が世界に誇る食文化です。\n多様で新鮮な食材とその持ち味を尊重しながら、自然の美しさや季節の移ろいを表現するとともに、健康的な食生活を支える栄養バランスにより、日本人の心と体を育み、暮らしと健康を支えてきました。\n\n和食の日を含む11月には、学校での「食育授業」や「和食給食の提供」など、全国で和食に親しむ活動が行われ、和食文化の保護・継承が推進されています。\n\n一方、海外に目を向けると、訪日外国人旅行客を対象に行った調査において、「日本滞在中にしたこと」及び「次回日本を訪れた時にしたいこと」の両方で「日本食を食べること」が第１位となるなど、世界的にも、日本の「食」への関心が益々高くなっています。\n\n令和７年の訪日外国人旅行者数は、約4,300万人ですが、今後とも増加が見込まれます。\n政府としては、令和12年の旅行者数の目標を6,000万人としています。\nこうした目標を達成する上でも、日本の食文化産業が、日本の「稼ぎ頭」のひとつとなるよう、日本各地の食と風土の魅力をより一層訴えていく必要があります。\n\n高市内閣では、「稼げる農林水産業・食品産業」を実現しつつ、「和食文化」を未来に向けて守り伝えていけるよう、「食文化産業の振興」に加え、「和食の保護・継承」や「海外への日本食・食文化の魅力発信」を着実に行ってまいります。\n\nhttps://t.co/ZSx9B8ekyK\n\nhttps://t.co/wd1i9IN156"}}},"rest_id":"2125029230631371118","unmention_data":{},"views":{"count":"212249","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125029230631371118","sortIndex":"2125107750542245827"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"tweet_id","value":{"string_value":"2125027968984723702","type":"STRING"}},{"key":"narrow_cast_space_type","value":{"string_value":"0","type":"STRING"}},{"key":"id","value":{"string_value":"1WXZnXAnWdoAlR","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/VART7AhI0r","type":"STRING"}}],"card_platform":{"platfor