880"}},"media_url_https":"https://pbs.twimg.com/media/HX26SwbasAAOE4E.jpg","original_info":{"focus_rects":[{"h":672,"w":1200,"x":0,"y":0},{"h":800,"w":800,"x":0,"y":0},{"h":800,"w":702,"x":0,"y":0},{"h":800,"w":400,"x":70,"y":0},{"h":800,"w":1200,"x":0,"y":0}],"height":800,"width":1200},"sizes":{"large":{"h":800,"resize":"fit","w":1200},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/svhaNlAa8f"}]},"favorite_count":6,"favorited":false,"full_text":"11月9日、原子力規制委員会は国際アドバイザーとの意見交換会合を開催しました。会合では、「データ信頼性の確保と不正事案への規制対応」および「Enabling Regulation＝事業者の主体的な安全向上を促す規制」について意見交換を行い、原子力安全の更なる向上に向けた知見を共有しました。 https://t.co/svhaNlAa8f","id_str":"2125059435211157865","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":1,"retweeted":false,"user_id_str":"719219671"},"rest_id":"2125059435211157865","unmention_data":{},"views":{"count":"646","state":"EnabledWithCount"}}}}},"entryId":"tweet-2125059435211157865","sortIndex":"2125107750542245841"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1793582764"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2119704741051785477"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indices":[0,23],"url":"https://t.co/NPEOH6l1S0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":299540,"following":90},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"461064204","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":5005,"tweets":13034},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6l1S0"}}}},"edit_control":{"edit_tweet_ids":["2125054298585260358"],"editable_until_msecs":"1795491001000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":6,"bookmarked":false,"conversation_id_str":"2125054298585260358","created_at":"Tue Nov 24 02:30:01 +0000 2026","display_text_range":[0,105],"entities":{"media":[{"display_url":"pic.x.com/39Ia76DXFw","expanded_url":"https://x.com/gov_online/status/2125054298585260358/photo/1","ext_alt_text":"上部に「2026年12月からイデコがパワーアップ！」と記載されており、その下には、次のように記載されている。「制度改正のポイント。1。かけ金の上限額の引上げ。働き方などによって上限額は異なりますが、老後への備えの選択肢が広がります。かけ金の上限額の引上げの解説図。加入資格が第1号被保険者、任意加入被保険者（自営業者など）の拠出限度額（月額）は、68,000円（国民年金き金と合わせて68,000円が上限）から75,000円（国民年金き金と合わせて75,000円が上限）へ引上げ。加入資格が第2号被保険者（会社員など）で、会社が企業年金を実施していない会社員の拠出限度額（月額）は、23,000円から62,000円へ引上げ。加入資格が第2号被保険者（会社員など）で、会社が企業年金を実施している会社員の拠出限度額（月額）は、20,000円（企業年金と合わせて55,000円が上限）から、62,000円（企業年金と合わせて62,000円が上限）へ引上げと記載されている。図は、厚生労働省「私的年金制度、イデコの改正のポイント」から政府広報室作成。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":105,"w":105,"x":310,"y":789},{"h":114,"w":114,"x":365,"y":652}]},"medium":{"faces":[{"h":105,"w":105,"x":310,"y":789},{"h":114,"w":114,"x":365,"y":652}]},"orig":{"faces":[{"h":105,"w":105,"x":310,"y":789},{"h":114,"w":114,"x":365,"y":652}]},"small":{"faces":[{"h":59,"w":59,"x":175,"y":447},{"h":64,"w":64,"x":206,"y":369}]}},"id_str":"2125026946073681921","indices":[106,129],"media_key":"3_2125026946073681921","media_results":{"result":{"media_key":"3_2125026946073681921"}},"media_url_https":"https://pbs.twimg.com/media/HX2cv6La4AEIrBM.jpg","original_info":{"focus_rects":[{"h":598,"w":1067,"x":0,"y":150},{"h":1067,"w":1067,"x":0,"y":0},{"h":1200,"w":1053,"x":0,"y":0},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":1067,"x":0,"y":0}],"height":1200,"width":1067},"sizes":{"large":{"h":1200,"resize":"fit","w":1067},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/39Ia76DXFw"},{"display_url":"pic.x.com/39Ia76DXFw","expanded_url":"https://x.com/gov_online/status/2125054298585260358/photo/2","ext_alt_text":"2。加入可能年齢の引上げ。加入できる年齢が、一定の条件を満たせば70歳未満まで引き上げられます。加入可能年齢の引上げの図。第1号被保険者及び第3号被保険者は60歳まで、第2号被保険者は65歳まで加入できるほか、60歳以上65歳未満の国民年金任意加入被保険者も加入可能となっていた。今回の制度改正により、加入可能年齢の上限が70歳まで引き上げられ、国民年金被保険者以外の者も加入できるようになる。図は厚生労働省「私的年金制度、イデコの改正のポイント」から政府広報室作成。詳しくはイデコ公式サイトをご確認ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2125026945775845376","indices":[106,129],"media_key":"3_2125026945775845376","media_results":{"result":{"media_key":"3_2125026945775845376"}},"media_url_https":"https://pbs.twimg.com/media/HX2cv5EaQAAKVsL.jpg","original_info":{"focus_rects":[{"h":598,"w":1067,"x":0,"y":602},{"h":1067,"w":1067,"x":0,"y":133},{"h":1200,"w":1053,"x":0,"y":0},{"h":1200,"w":600,"x":29,"y":0},{"h":1200,"w":1067,"x":0,"y":0}],"height":1200,"width":1067},"sizes":{"large":{"h":1200,"resize":"fit","w":1067},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/39Ia76DXFw"}],"urls":[{"display_url":"gov-online.go.jp/useful/202610/…","expanded_url":"https://www.gov-online.go.jp/useful/202610/video-326870.html","indices":[71,94],"url":"https://t.co/aIQxKDaPBe"}],"user_mentions":[{"id_str":"180585090","indices":[95,105],"name":"厚生労働省","screen_name":"MHLWitter"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/39Ia76DXFw","expanded_url":"https://x.com/gov_online/status/2125054298585260358/photo/1","ext_alt_text":"上部に「2026年12月からイデコがパワーアップ！」と記載されており、その下には、次のように記載されている。「制度改正のポイント。1。かけ金の上限額の引上げ。働き方などによって上限額は異なりますが、老後への備えの選択肢が広がります。かけ金の上限額の引上げの解説図。加入資格が第1号被保険者、任意加入被保険者（自営業者など）の拠出限度額（月額）は、68,000円（国民年金き金と合わせて68,000円が上限）から75,000円（国民年金き金と合わせて75,000円が上限）へ引上げ。加入資格が第2号被保険者（会社員など）で、会社が企業年金を実施していない会社員の拠出限度額（月額）は、23,000円から62,000円へ引上げ。加入資格が第2号被保険者（会社員など）で、会社が企業年金を実施している会社員の拠出限度額（月額）は、20,000円（企業年金と合わせて55,000円が上限）から、62,000円（企業年金と合わせて62,000円が上限）へ引上げと記載されている。図は、厚生労働省「私的年金制度、イデコの改正のポイント」から政府広報室作成。」","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":105,"w":105,"x":310,"y":789},{"h":114,"w":114,"x":365,"y":652}]},"medium":{"faces":[{"h":105,"w":105,"x":310,"y":789},{"h":114,"w":114,"x":365,"y":652}]},"orig":{"faces":[{"h"