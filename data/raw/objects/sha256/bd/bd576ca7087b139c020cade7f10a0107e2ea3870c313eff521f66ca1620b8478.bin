OjIxMTM1OTIwNjg5NjI3NTg2NTY=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、訪日中のシミナ・ミクロネシア大統領と会談を行いました。高市総理大臣は、進化した自由で開かれたインド太平洋（FOIP）の下、両国が共に、強く豊かになる協力を積み重ねていきたい旨述べた上で、今般決定した貨客船供与に向けた調査の実施を含め、自律性と強靱性を高めるための協力を継続していく旨述べました。これに対し、シミナ大統領から、進化したFOIPの考え方や取組を歓迎する旨の発言がありました。\n両首脳は、太平洋・島サミット（PALM）創設30周年の節目に当たる2027年夏に横浜で開催予定のPALM11の成功に向け、引き続き緊密に連携していくことで一致しました。\nhttps://t.co/ec4ZDngxYA"}}},"rest_id":"2113592069088489880","unmention_data":{},"views":{"count":"15988","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2114525190858735641-tweet-2113806701468229632","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2112845618712609268"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/an