805,"w":805,"x":262,"y":0},{"h":805,"w":706,"x":361,"y":0},{"h":805,"w":403,"x":625,"y":0},{"h":805,"w":1067,"x":0,"y":0}],"height":805,"width":1067},"sizes":{"large":{"h":805,"resize":"fit","w":1067},"medium":{"h":805,"resize":"fit","w":1067},"small":{"h":513,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/N2RIoI7qYl"}]},"favorite_count":1258,"favorited":false,"full_text":"令和８年１０月２３日（金）午前から午後にかけて、ロシアの情報収集機（ＩＬ－２０）×１機が、大陸方面から飛来し、日本海上空を島根県沖まで飛行後、反転し、大陸方面へ飛行したことを確認した。\nこれに対し、航空自衛隊の北部航空方面隊等の戦闘機を緊急発進させ対応した。 https://t.co/N2RIoI7qYl","id_str":"2113591378357936172","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":14,"reply_count":28,"retweet_count":350,"retweeted":false,"user_id_str":"864751444586397696"},"rest_id":"2113591378357936172","unmention_data":{},"views":{"count":"57804","state":"EnabledWithCount"}}},"rest_id":"2113595892515446936","unmention_data":{},"views":{"count":"71887","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113595892515446936","sortIndex":"2114525190858735583"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1769045,"following":47},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8345,"tweets":23448},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2113583129093161277"],"editable_until_msecs":"1792756061000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":562,"bookmarked":false,"conversation_id_str":"2113583129093161277","created_at":"Fri Oct 23 10:47:41 +0000 2026","display_text_range":[0,133],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/849oFhTZS5","expanded_url":"https://x.com/kantei/status/2113583129093161277/video/1","ext_media_availability":{"status":"Available"},"id_str":"2113582950046748672","indices":[134,157],"media_key":"13_2113582950046748672","media_results":{"result":{"media_key":"13_2113582950046748672"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2113582950046748672/img/Xh7yGD44rfM6I5--.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/849oFhTZS5","video_info":{"aspect_ratio":[16,9],"duration_millis":414633,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2113582950046748672/pl/OavJiGJf5rJsdpZT.m3u8?tag=29&v=ed6"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113582950046748672/vid/avc1/480x270/LzNty3ZH3zazaCuH.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113582950046748672/vid/avc1/640x360/Efj1lK-7UagKfAAT.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113582950046748672/vid/avc1/1280x720/OmCzG1CqsQG4hFGA.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/849oFhTZS5","expanded_url":"https://x.com/kantei/status/2113583129093161277/video/1","ext_media_availability":{"status":"Available"},"id_str":"2113582950046748672","indices":[134,157],"media_key":"13_2113582950046748672","media_results":{"result":{"media_key":"13_2113582950046748672"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2113582950046748672/img/Xh7yGD44rfM6I5--.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/849oFhTZS5","video_info":{"aspect_ratio":[16,9],"duration_millis":414633,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2113582950046748672/pl/OavJiGJf5rJsdpZT.m3u8?tag=29&v=ed6"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113582950046748672/vid/avc1/480x270/LzNty3ZH3zazaCuH.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113582950046748672/vid/avc1/640x360/Efj1lK-7UagKfAAT.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113582950046748672/vid/avc1/1280x720/OmCzG1CqsQG4hFGA.mp4?tag=29"}]}}]},"favorite_count":12670,"favorited":false,"full_text":"【お知らせ】\n本日（１０月２３日）、高市総理は、中東情勢を踏まえた「緊急的激変緩和措置」についてのぶら下がり会見を行いました。\n\n※要旨（速報版）\n　皆様お疲れ様でございます。\n　中東情勢を踏まえた「緊急的激変緩和措置」について、今後の対応に関して説明をいたします。 https://t.co/849oFhTZS5","id_str":"2113583129093161277","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":520,"reply_count":816,"retweet_count":2243,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM1ODMxMjg5NDIxMjUwNTY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１０月２３日）、高市総理は、中東情勢を踏まえた「緊急的激変緩和措置」についてのぶら下がり会見を行いました。\n\n※要旨（速報版）\n　皆様お疲れ様でございます。\n　中東情勢を踏まえた「緊急的激変緩和措置」について、今後の対応に関して説明をいたします。\n　ガソリン、軽油、重油、灯油など燃料油に対する補助につきましては、あくまでも「激変緩和措置」であることに加え、与党の皆様からも、そして国民民主党、中道、立憲民主党など野党の皆様からも「財政負担」への懸念から、「段階的な見直し」や「出口戦略」を考えるべきとのご指摘をいただいてまいりました。\n　そこで、中東情勢が「今後の物価動向」や「経済」に与える影響を注視しながら、今後の「支援の在り方」について、各党のご提案を踏まえつつ検討するよう、本日、経済産業大臣に指示をいたします。\n　あわせて、当面の燃料油支援に必要な「基金規模」を確保するため、経済産業大臣に対し、財務大臣と所要の調整を進めるように指示をいたします。\n　私からは以上でございます。\n\n（記者）\n　よろしくお願いいたします。その見直しについて伺います。一部の報道ではすでに１１月から縮小して月平均で５円程度上昇していくというような与党案も報じられております。総理が指示される見直しというのは与党案をベースにしたものなのか、それとも白紙ベースのものなのでしょうか。\n\n（総理）\n　経済産業大臣に検討するよう、本日これから指示をするところですので、予断はいたしませんが、支援単価や措置の出口も含めて、「支援の在り方」を柔軟に検討いたします。まだ何も決まったものではございません。\n\n（記者）\n　もう１点お願いいたします。総理はこれまでも、先日の政権発足１周年の会見の際などにですね、燃料の補助が物価上昇率を抑えるのに貢献していると思うといったようなお話もされていたと思います。与野党の指摘があったというお話でしたが、それでもなぜ今この指示を出されるのか、もう一度改めてご説明をお願いいたします。\n\n（総理）\n　はい、あの私自身ですね、物価上昇率を抑えるために、この燃料油補助というのは非常に大きく貢献したと思っております。特に現在もですけれども、ヨーロッパ各国などとの価格と比較しますと、圧倒的に日本は安い状況でございます。例えばリッター４００円を超えている国々もありますが、日本は約１７０円という水準で、これは軽油にも重油にも灯油にも適用されますので、そういう意味では、あまり実感として伝わらないかもしれないんですが、輸送コストであったり、様々な産業を支えるコストであったり、いろんな形で、皆様の暮らし向きに関わる物価を抑える役に立ってきたと思います。しかしながら、これまで国会論戦の場でも、各党の皆さんから、出口を考えるべきではないかと、また、段階的に見直していくべきではないかというご指摘もいただきましたので、ここで１度検討を指示しようと考えた次第でございます。\n\n（記者）\n　来年４月からの消費税減税による効果と相殺できるとするんだとか、そういったことではないですか。\n\n（総理）\n　切れ目のない物価高対策としては、お勤めになっている人でしたら今年の１２月、特に所得税減税ということで、１人３万円から６万円、これが年末調整で戻るというようなこともありますし、来年４月からの消費税減税もまだ法律案審議中でございますけれども、もし可決いただきましたら、そういった対応も始まります。しかしながら、燃料油の補助については与野党関係なく各党からご指摘をいただいておりますので、ここで一度適正な水準、そしてまた、これも中東情勢が非常に不透明な中でございますので、原油価格ですとか、使用額というものを見通すのは大変困難なものではありますが、足元の原油価格、そして基金の執行状況も踏まえながら、検討をしていただきたい、そのように考えております。\n\n（記者）\n　野党からの指摘はこれまでもあったと思うんですけれども、なぜこのタイミングで指示をしたということになるのでしょうか。\n\n（総理）\n　当面は、必要な基金を確保するための話し合いを、冒頭に申し上げましたとおり、財務大臣と行うよう指示をいたします。いきなり来月から変わるということではなく、指示をいたします。しかしながら、このタイミングでやはり措置の出口をどうするんだというお声もいただいておりますので、検討をしてもらうということでございます。\n\n（記者）\n　１問だけ。結論をいつ出されるのかだけ教えてください。\n\n（総理）\n　そうですね、検討状況によりますし、まず現在行っている補助に対しても必要な基金の規模も確保しなければいけませんので、それは両にらみでやっていかなきゃいけないことでございます。今何月何日と申し上げるわけにはいきませんが、できるだけ早く検討していただくということになります。\n　どうもお疲れ様です。"}}},"rest_id":"2113583129093161277","unmention_data":{},"views":{"count":"3295207","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113583129093161277","sortIndex":"2114525190858735582"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","t