itional_media_info":{"monetizable":false},"display_url":"pic.x.com/bnEHGNgIw2","expanded_url":"https://x.com/kantei/status/2113641165438488848/video/1","ext_media_availability":{"status":"Available"},"id_str":"2113640494744186880","indices":[136,159],"media_key":"13_2113640494744186880","media_results":{"result":{"media_key":"13_2113640494744186880"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2113640494744186880/img/coR7SChHCpznIVae.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/bnEHGNgIw2","video_info":{"aspect_ratio":[16,9],"duration_millis":175166,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2113640494744186880/pl/hkZormJ9PdvxqiH9.m3u8?tag=29&v=a94"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113640494744186880/vid/avc1/480x270/VToKJX4fg3Uq-la8.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113640494744186880/vid/avc1/640x360/lY7aCcNpAOMuT1J2.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2113640494744186880/vid/avc1/1280x720/HKzwwyS1sWolMn0c.mp4?tag=29"}]}}]},"favorite_count":2379,"favorited":false,"full_text":"【お知らせ】 \n本日(１０月２３日)、高市総理はミクロネシア連邦のシミナ大統領と会談しました。\n\n※両首脳による冒頭発言(速報版、仮訳)\n（高市総理）\n　カモラーレ。（注：ミクロネシア連邦の言葉で「こんにちは」。）\n　本年２度目となるシミナ大統領の訪日を歓迎いたします。 https://t.co/bnEHGNgIw2","id_str":"2113641165438488848","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"reply_count":202,"retweet_count":279,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM2NDExNjUzNDYyNDY2NTY=","richtext":{"richtext_tags":[]},"text":"【お知らせ】 \n本日(１０月２３日)、高市総理はミクロネシア連邦のシミナ大統領と会談しました。\n\n※両首脳による冒頭発言(速報版、仮訳)\n（高市総理）\n　カモラーレ。（注：ミクロネシア連邦の言葉で「こんにちは」。）\n　本年２度目となるシミナ大統領の訪日を歓迎いたします。\n　まず、貴国の独立４０周年をお祝い申し上げます。両国の強固な友好関係は、日系人のつながりも含めて、独立前から続く、１００年以上の交流に支えられてまいりました。\n　これを土台に、進化した「自由で開かれたインド太平洋（ＦＯＩＰ）」の下、「共に、強く豊かになる」協力を積み重ねていきましょう。\n　そして、来年夏に日本の横浜で開催予定のＰＡＬＭ１１（第１１回太平洋・島サミット）に向けまして、シミナ大統領と連携していきたいと存じます。\n　まずは御挨拶申し上げます。\n\n（シミナ大統領）※日本語仮訳\n　高市総理、総理の就任後に初めてお目にかかりますが、まず、総理の歴史的な快挙に対し、心からの祝意をお伝え申し上げます。\n　日本を訪れて友人に会い、両国の素晴らしいパートナーシップを顧みながら、両国間の「キズナ」をさらに強化できるということは常に大きな喜びです。\n　我が国の政府と国民は、連帯の精神の下、日本の政府と国民の皆様に対して、最近発生した自然災害によって失われた方々と、広範囲にわたる被害に対し、心からの哀悼の意を表します。日本国民の皆様の安全をお祈りするとともに、復興までの間、我々は常に皆様と共にあります。\n　ご存じのとおり、ミクロネシア連邦は、私たち太平洋島嶼国が「大きな海洋国家」としても捉えている、この広大な海に点在する島からなる小さな島国であり、他の多くの開発途上島嶼国と同様に、持続的な開発を達成するための我が国の取組は、気候変動や地政学的な不安定さによって、ますます脅かされています。\n　本日は、ミクロネシア連邦と日本のパートナーシップをさらに前進させ、「自由で開かれたインド太平洋」の平和、友好、協力を促進するために、いかにして共に取り組んでいけるかということを、高市総理と議論できることを楽しみにしております。\n　ありがとうございました。"}}},"rest_id":"2113641165438488848","unmention_data":{},"views":{"count":"64324","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113641165438488848","sortIndex":"2114525190858735587"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at"