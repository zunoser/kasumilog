//pbs.twimg.com/media/HVUBy7rbgAAinn4.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":758,"y":0},{"h":1734,"w":1521,"x":865,"y":0},{"h":1734,"w":867,"x":1192,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/btPuEKIRva"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/btPuEKIRva","expanded_url":"https://x.com/takaichi_sanae/status/2113597601794924773/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":75,"w":75,"x":541,"y":443}]},"medium":{"faces":[{"h":44,"w":44,"x":317,"y":259}]},"orig":{"faces":[{"h":96,"w":96,"x":688,"y":563}]},"small":{"faces":[{"h":25,"w":25,"x":179,"y":147}]}},"id_str":"2113597574796181504","indices":[92,115],"media_key":"3_2113597574796181504","media_results":{"result":{"media_key":"3_2113597574796181504"}},"media_url_https":"https://pbs.twimg.com/media/HVUBy8PagAAcw7E.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1452,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/btPuEKIRva"}]},"favorite_count":13965,"favorited":false,"full_text":"先ほど、訪日中のシミナ・ミクロネシア連邦大統領と首脳会談を行いました。\n\n本年はミクロネシア連邦の独立40周年であり、私から祝意を表明するとともに、シミナ大統領の訪日を歓迎しました。 https://t.co/btPuEKIRva","id_str":"2113597601794924773","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":94,"reply_count":972,"retweet_count":1327,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM1OTc2MDE3MjM2NTgyNDA=","richtext":{"richtext_tags":[]},"text":"先ほど、訪日中のシミナ・ミクロネシア連邦大統領と首脳会談を行いました。\n\n本年はミクロネシア連邦の独立40周年であり、私から祝意を表明するとともに、シミナ大統領の訪日を歓迎しました。\n\n両国が「共に、強く豊かになる」協力を積み重ねつつ、進化した「自由で開かれたインド太平洋（FOIP）」の実現に向け、共に協力していきたい旨お伝えし、ミクロネシア連邦の「自律性」と「強靱性」を高めるための協力を継続していく旨を申し上げました。\n\nシミナ大統領からは、これまでの幅広い分野への支援や協力に関する日本への感謝や、二国間関係の一層の強化への強い意向が表明されました。\n\n進化した「自由で開かれたインド太平洋（FOIP）」の考え方や取組を歓迎するとの御言葉も伺いました。\n\n地域情勢や国際場裡の連携についても議論し、太平洋島しょ国地域の結束と一体性の維持・強化の重要性を確認しました。\n\n太平洋・島サミット（PALM）創設30周年の節目に当たる来年夏に横浜で開催予定の「PALM11」の成功に向けて、ミクロネシア連邦と緊密に連携してまいります。"}}},"rest_id":"2113597601794924773","unmention_data":{},"views":{"count":"389337","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113597601794924773","sortIndex":"2114525190858735584"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notification