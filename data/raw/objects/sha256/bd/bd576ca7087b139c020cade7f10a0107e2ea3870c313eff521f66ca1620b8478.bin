count":20,"retweet_count":212,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM4NjMwNzU5NTA2NTM0NDA=","text":"10月24日、小泉防衛大臣と小田原防衛副大臣は、海上自衛隊遠洋練習航海部隊の帰国行事に出席しました。小泉大臣は、約5か月間にわたる練習航海を終えて帰国した隊員に対し訓示を行いました。\n\n今年3月に幹部候補生学校を卒業した若手幹部（実習幹部）たちは、北米を中心とした5か国・11寄港地を巡る遠洋練習航海を通じて、幹部自衛官として必要な知識・技能を修得するとともに、国際感覚を学び、無事帰国しました🌎⚓"}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"2056545448517939581"}},"rest_id":"2113863076017848611","unmention_data":{},"views":{"count":"122548","state":"EnabledWithCount"}}},"rest_id":"2113972983199076859","unmention_data":{},"views":{"count":"180879","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113972983199076859","sortIndex":"2114525190858735598"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzY2ODI3OTE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関 "},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_