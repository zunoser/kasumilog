site":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2113604470932418910"],"editable_until_msecs":"1792761149000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2113604470932418910","created_at":"Fri Oct 23 12:12:29 +0000 2026","display_text_range":[0,142],"entities":{},"favorite_count":60,"favorited":false,"full_text":"堀井外務副大臣主催による夕食会が開催され、実務訪問賓客として訪日中のシミナ・ミクロネシア大統領などが出席しました。堀井副大臣は、ミクロネシアの重要性に触れつつ、自由で開かれたインド太平洋（FOIP）の実現のため、ミクロネシアの自律性や強靱性の強化を今後も後押ししていく旨述べました。こ","id_str":"2113604470932418910","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":14,"retweet_count":9,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04340.html","indices":[262,285],"url":"https://t.co/TMf7NkJOc3"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM2MDQ0NzA3OTM5OTAxNDQ=","richtext":{"richtext_tags":[]},"text":"堀井外務副大臣主催による夕食会が開催され、実務訪問賓客として訪日中のシミナ・ミクロネシア大統領などが出席しました。堀井副大臣は、ミクロネシアの重要性に触れつつ、自由で開かれたインド太平洋（FOIP）の実現のため、ミクロネシアの自律性や強靱性の強化を今後も後押ししていく旨述べました。これに対し、シミナ大統領から、これまでの協力に対する謝意が述べられました。\n両者は、二国間関係や地域情勢に関して意見交換を行い、2027年夏の第11回太平洋・島サミットの成功に向けた連携を含め、引き続き緊密に協力していくことで一致しました。\nhttps://t.co/TMf7NkJOc3"}}},"rest_id":"2113604470932418910","unmention_data":{},"views":{"count":"10519","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113604470932418910","sortIndex":"2114525190858735585"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":