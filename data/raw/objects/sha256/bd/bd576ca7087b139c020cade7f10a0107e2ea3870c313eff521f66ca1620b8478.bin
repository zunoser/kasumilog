o.jp/stf/seisakunitsuite/bunya/kenkou_iryou/kenkou/kekkaku-kansenshou/infulenza/kusuri_kyoukyuu.html","indices":[106,129],"url":"https://t.co/xJEJK7MIDT"}]},"favorite_count":111,"favorited":false,"full_text":"この度のインフルエンザの流行状況を踏まえ、タミフルなどの抗インフルエンザウイルス薬の供給量や在庫量について、毎週金曜日に公表しています。\n\n10月18日時点で、メーカーなどに3,215万人分が確保されています。\nhttps://t.co/xJEJK7MIDT","id_str":"2113525880849125782","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":6,"retweet_count":58,"retweeted":false,"user_id_str":"180585090"},"rest_id":"2113525880849125782","unmention_data":{},"views":{"count":"30671","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113525880849125782","sortIndex":"2114525190858735530"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"description","value":{"string_value":"環境省では、ALPS処理水の処分に関する様々な対応のうち、環境中の放射性物質の状況を確認するための海域環境モニタリングの実施を担っています。このウェブサイトでは、環境省に加え、関係省庁等で実施しているトリチウム等に係るモニタリングの結果をまとめて掲載しています。","type":"STRING"}},{"key":"domain","value":{"string_value":"policies.env.go.jp","type":"STRING"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"policies.env.go.jp","type":"STRING"}},{"key":"title","value":{"string_value":"ALPS処理水に係る海域モニタリング情報 | 環境省","type":"STRING"}},{"key":"card_url","value":{"scribe_key":"card_url","string_value":"https://t.co/fpAOpMJxGY","type":"STRING"}}],"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"Swift","version":"12"}}},"name":"summary_large_image","url":"https://t.co/fpAOpMJxGY","user_refs_results":[]},"rest_id":"https://t.co/fpAOpMJxGY"},"cashtag_attachments":[],"cor