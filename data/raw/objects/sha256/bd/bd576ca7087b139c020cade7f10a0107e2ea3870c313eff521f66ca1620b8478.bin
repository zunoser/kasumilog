rl":"https://t.co/apDR7FDsfq"}]},"favorite_count":1437,"favorited":false,"full_text":"10月24日、小泉防衛大臣と小田原防衛副大臣は、海上自衛隊遠洋練習航海部隊の帰国行事に出席しました。小泉大臣は、約5か月間にわたる練習航海を終えて帰国した隊員に対し訓示を行いました。 https://t.co/apDR7FDsfq","id_str":"2113863076017848611","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":10,"quoted_status_id_str":"2056545448517939581","quoted_status_permalink":{"display":"x.com/modjapan_jp/st…","expanded":"https://twitter.com/modjapan_jp/status/2056545448517939581","url":"https://t.co/kFqvaTYtSB"},"reply_count":20,"retweet_count":212,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM4NjMwNzU5NTA2NTM0NDA=","text":"10月24日、小泉防衛大臣と小田原防衛副大臣は、海上自衛隊遠洋練習航海部隊の帰国行事に出席しました。小泉大臣は、約5か月間にわたる練習航海を終えて帰国した隊員に対し訓示を行いました。\n\n今年3月に幹部候補生学校を卒業した若手幹部（実習幹部）たちは、北米を中心とした5か国・11寄港地を巡る遠洋練習航海を通じて、幹部自衛官として必要な知識・技能を修得するとともに、国際感覚を学び、無事帰国しました🌎⚓"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省の政策や各種活動などの最新情報を発信します。英語による