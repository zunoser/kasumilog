":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/kzKR1sHDD4"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/kzKR1sHDD4","expanded_url":"https://x.com/takaichi_sanae/status/2113547239515955602/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":87,"w":87,"x":1591,"y":425}]},"medium":{"faces":[{"h":51,"w":51,"x":932,"y":249}]},"orig":{"faces":[{"h":111,"w":111,"x":2021,"y":540}]},"small":{"faces":[{"h":29,"w":29,"x":528,"y":141}]}},"id_str":"2113547013912686592","indices":[87,110],"media_key":"3_2113547013912686592","media_results":{"result":{"media_key":"3_2113547013912686592"}},"media_url_https":"https://pbs.twimg.com/media/HVTTz6RacAA0QvP.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1452,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/kzKR1sHDD4"}]},"favorite_count":10857,"favorited":false,"full_text":"本日、ブレッド・ロビンソン「ワールドラグビー」会長が官邸にお越し下さいました。\n\n「ワールドラグビー」は、4年に1度開催される「ラグビーワールドカップ」を主催されています。 https://t.co/kzKR1sHDD4","id_str":"2113547239515955602","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":80,"reply_count":276,"retweet_count":1114,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM1NDcyMzk0NDQ2NjQzMjA=","richtext":{"richtext_tags":[]},"text":"本日、ブレッド・ロビンソン「ワールドラグビー」会長が官邸にお越し下さいました。\n\n「ワールドラグビー」は、4年に1度開催される「ラグビーワールドカップ」を主催されています。\n\n2019年には、日本で「ラグビーワールドカップ」が開催され、大きな盛り上がりを見せたことは皆様の記憶にも新しいと思います。\n日本で初めて開催された「ラグビーワールドカップ」は、国、自治体、経済界などが一体となり、大会成功へ向けて取り組んだ結果、国内外で大きな感動を呼び、日本を世界に発信する好機となりました。\n\n現在、日本は、2035年の「ラグビーワールドカップ」の開催地に立候補しています。\n再び日本で「ラグビーワールドカップ」を開催することができれば、アジアをはじめとして、より多くの方々に、ラグビーの素晴らしさを知ってもらうことができ、ラグビー界の更なる発展に貢献することができると考えています。\n\n私からロビンソン会長に、日本での開催に向けた御支援をお願い申し上げました。\n\n今後も、国際大会の日本への招致をはじめとして、しっかりとスポーツを応援していきます。"}}},"rest_id":"2113547239515955602","unmention_data":{},"views":{"count":"331380","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113547239515955602","sortIndex":"2114525190858735549"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/562796849531080704/O1hexq4Z_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/281874178/1611288198"},"core":{"created_at":"Thu Apr 14 04:13:40 +0000 2011","name":"特許庁","screen_name":"jpo_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyODE4NzQxNzg=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関3-4-3"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"特許庁の公式アカウントです。特許庁ホームページの主な更新情報等に関する情報を提供します。運用方針は以下をご覧ください。https://t.co/7eNLi8gZcH　\n公的機関との間でのリプライやリツイ