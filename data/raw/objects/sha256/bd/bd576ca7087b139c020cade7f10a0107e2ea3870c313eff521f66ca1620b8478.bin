27,"w":27,"x":425,"y":204},{"h":40,"w":40,"x":147,"y":72},{"h":44,"w":44,"x":138,"y":249}]}},"id_str":"2113556881470103553","indices":[91,114],"media_key":"3_2113556881470103553","media_results":{"result":{"media_key":"3_2113556881470103553"}},"media_url_https":"https://pbs.twimg.com/media/HVTcyRyboAEOn9q.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":628,"y":0},{"h":1734,"w":1521,"x":735,"y":0},{"h":1734,"w":867,"x":1062,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GhjcUcGOwo"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/GhjcUcGOwo","expanded_url":"https://x.com/takaichi_sanae/status/2113557106091827352/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2113556881470103552","indices":[91,114],"media_key":"3_2113556881470103552","media_results":{"result":{"media_key":"3_2113556881470103552"}},"media_url_https":"https://pbs.twimg.com/media/HVTcyRyboAAQ2ec.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":116},{"h":1698,"w":1698,"x":0,"y":0},{"h":1698,"w":1489,"x":0,"y":0},{"h":1698,"w":849,"x":0,"y":0},{"h":1698,"w":2600,"x":0,"y":0}],"height":1698,"width":2600},"sizes":{"large":{"h":1338,"resize":"fit","w":2048},"medium":{"h":784,"resize":"fit","w":1200},"small":{"h":444,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GhjcUcGOwo"}]},"favorite_count":22091,"favorited":false,"full_text":"本日、「自民党 国家サイバーセキュリティ戦略本部」を代表して平本部長、大野幹事長、小森事務局長が官邸にお越しになり、『サイバーセキュリティの抜本的強化に関する提言』を頂戴しました。 https://t.co/GhjcUcGOwo","id_str":"2113557106091827352","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":289,"reply_count":1131,"retweet_count":2842,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM1NTcxMDYwMjA1NjkwODg=","richtext":{"richtext_tags":[]},"text":"本日、「自民党 国家サイバーセキュリティ戦略本部」を代表して平本部長、大野幹事長、小森事務局長が官邸にお越しになり、『サイバーセキュリティの抜本的強化に関する提言』を頂戴しました。\n\n国内企業を狙ったサイバー攻撃により、国民の皆様の大切な個人情報が漏洩する事案も相次いでおり、サイバー情勢は、官民を挙げて緊急で対応を要する事態にあります。\n\nご提言には、官邸主導で全省庁を挙げた対策を加速させることに加え、10月1日から施行された『サイバー対処能力強化法』などに基づく取組の加速など、各省庁・機関に対する具体的な個別提言が盛り込まれています。\n\n「質・量ともに深刻化するサイバー脅威」に対し、政府においても、早急に、官邸主導で必要な体制を整備し、「国家サイバー統括室」を司令塔として、\n・「国家サイバー統括室」による一元的な情報集約と情報分析\n・情報分析に基づく、国民の皆様や事業者の皆様への的確な注意喚起、情報発信の実施\n・『サイバー対処能力強化法』・『整備法』によって新たに導入された「アクセス・無害化措置」などの対処オプションの適時・適切な実施\nなど、関係省庁が一体となって取組を進め、我が国のサイバーセキュリティを強化してまいります。"}}},"rest_id":"2113557106091827352","unmention_data":{},"views":{"count":"616101","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113557106091827352","sortIndex":"2114525190858735560"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2113556272419328000/F8d04bUb?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.66497","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":150,"url":"https://pbs.twimg.com/card_img/2113556272419328000/F8d04bUb?format=jpg&name=280x150","width":267},"type":"IMAGE"}},{"key":"description",