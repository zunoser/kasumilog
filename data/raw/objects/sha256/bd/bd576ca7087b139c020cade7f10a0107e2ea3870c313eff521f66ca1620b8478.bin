n_jp/status/2056545448517939581/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":115,"w":115,"x":1205,"y":1160}]},"medium":{"faces":[{"h":69,"w":69,"x":723,"y":696}]},"orig":{"faces":[{"h":115,"w":115,"x":1205,"y":1160}]},"small":{"faces":[{"h":39,"w":39,"x":409,"y":394}]}},"id_str":"2056545414674010112","indices":[100,123],"media_key":"3_2056545414674010112","media_results":{"result":{"media_key":"3_2056545414674010112"}},"media_url_https":"https://pbs.twimg.com/media/HIpRKJoaUAAyYyi.jpg","original_info":{"focus_rects":[{"h":1120,"w":2000,"x":0,"y":213},{"h":1333,"w":1333,"x":84,"y":0},{"h":1333,"w":1169,"x":166,"y":0},{"h":1333,"w":667,"x":417,"y":0},{"h":1333,"w":2000,"x":0,"y":0}],"height":1333,"width":2000},"sizes":{"large":{"h":1333,"resize":"fit","w":2000},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":453,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/UZ0KDeK0Bb"}]},"favorite_count":1397,"favorited":false,"full_text":"5月16日、海上自衛隊横須賀地区で遠洋練習航海部隊の出国行事が執り行われました。\n\n行事には宮﨑防衛副大臣と吉田防衛大臣政務官が出席し、宮﨑防衛副大臣は練習航海に出発する隊員に対し訓示を行いました。 https://t.co/UZ0KDeK0Bb","id_str":"2056545448517939581","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":16,"retweet_count":173,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwNTY1NDU0NDg0Njc1MzM4MjU=","text":"5月16日、海上自衛隊横須賀地区で遠洋練習航海部隊の出国行事が執り行われました。\n\n行事には宮﨑防衛副大臣と吉田防衛大臣政務官が出席し、宮﨑防衛副大臣は練習航海に出発する隊員に対し訓示を行いました。\n\n今年3月に幹部候補生学校を卒業した実習幹部たちは、式典終了後、約5か月間に渡る練習航海に出発しました。今年度は北米を中心とした5か国、11寄港地を巡り、航海を通じて、幹部自衛官として必要な資質を育みます🌎⚓"}}},"rest_id":"2056545448517939581","unmention_data":{},"views":{"count":"83738","state":"EnabledWithCount"}}},"rest_id":"2113863076017848611","unmention_data":{},"views":{"count":"