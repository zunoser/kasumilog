y":false,"super_following":false,"tweet_counts":{"media_tweets":596,"tweets":1899},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2113828956927623383"],"editable_until_msecs":"1792814671000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":69,"bookmarked":false,"conversation_id_str":"2113828956927623383","created_at":"Sat Oct 24 03:04:31 +0000 2026","display_text_range":[0,104],"entities":{},"favorite_count":8893,"favorited":false,"full_text":"本日、「第5回アジアパラ競技大会（2026/愛知・名古屋）」が閉幕します。\n\n今大会は、初めての日本での開催となり、「TEAM JAPAN」の皆様は、各競技において、素晴らしいパフォーマンスを発揮されました。","id_str":"2113828956927623383","is_quote_status":false,"lang":"ja","quote_count":80,"reply_count":1043,"retweet_count":814,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM4Mjg5NTY4NjA0OTM4MjQ=","richtext":{"richtext_tags":[]},"text":"本日、「第5回アジアパラ競技大会（2026/愛知・名古屋）」が閉幕します。\n\n今大会は、初めての日本での開催となり、「TEAM JAPAN」の皆様は、各競技において、素晴らしいパフォーマンスを発揮されました。\n\n選手の皆様が、この大舞台でも失敗を恐れず、自らを信じ、持てる力を最大限発揮される姿、仲間と助け合いながら、最後まで諦めずに勝利を目指す姿、ライバルと競い合い、お互いの健闘をたたえ合う姿は、「パラスポーツ」の素晴らしさを改めて私たちに感じさせてくれました。\n\n日本中に多くの勇気と感動を届けて下さった選手の皆様に、心から感謝申し上げます。\nこれまで選手の挑戦を支え続けてこられた御家族、指導者、関係者の皆様にも、深く敬意を表します。\n\n本大会は、「パラスポーツ」の魅力と素晴らしさを広く国内外に発信するとともに、多くの方々が「パラスポーツ」に触れ、より身近に感じる貴重な機会となりました。\n\n2年後の「ロサンゼルス パラリンピック」、4年後にカタール・ドーハで開催される次回「アジアパラ競技大会」といった、次なる大舞台で、「TEAM JAPAN」の皆様がより一層御活躍されることを願っております。"}}},"rest_id":"2113828956927623383","unmention_data":{},"views":{"count":"397803","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113828956927623383","sortIndex":"2114525190858735594"},{"content":{"__typename":"TimelineTimel