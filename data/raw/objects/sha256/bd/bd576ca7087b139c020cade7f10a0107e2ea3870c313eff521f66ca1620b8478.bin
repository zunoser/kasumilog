113793180256899337/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":116,"w":116,"x":108,"y":1082}]},"medium":{"faces":[{"h":67,"w":67,"x":63,"y":633}]},"orig":{"faces":[{"h":232,"w":232,"x":216,"y":2164}]},"small":{"faces":[{"h":38,"w":38,"x":35,"y":359}]}},"id_str":"2113793061365112833","indices":[80,103],"media_key":"3_2113793061365112833","media_results":{"result":{"media_key":"3_2113793061365112833"}},"media_url_https":"https://pbs.twimg.com/media/HVWzlwdaYAE-29e.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":3072,"w":3072,"x":0,"y":0},{"h":3072,"w":2695,"x":0,"y":0},{"h":3072,"w":1536,"x":0,"y":0},{"h":3072,"w":4096,"x":0,"y":0}],"height":3072,"width":4096},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GgIFf8CpTK"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/GgIFf8CpTK","expanded_url":"https://x.com/takaichi_sanae/status/2113793180256899337/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":116,"w":116,"x":108,"y":1082}]},"medium":{"faces":[{"h":67,"w":67,"x":63,"y":633}]},"orig":{"faces":[{"h":232,"w":232,"x":216,"y":2164}]},"small":{"faces":[{"h":38,"w":38,"x":35,"y":359}]}},"id_str":"2113793061365112833","indices":[80,103],"media_key":"3_2113793061365112833","media_results":{"result":{"media_key":"3_2113793061365112833"}},"media_url_https":"https://pbs.twimg.com/media/HVWzlwdaYAE-29e.jpg","original_info":{"focus_rects":[{"h":2294,"w":4096,"x":0,"y":0},{"h":3072,"w":3072,"x":0,"y":0},{"h":3072,"w":2695,"x":0,"y":0},{"h":3072,"w":1536,"x":0,"y":0},{"h":3072,"w":4096,"x":0,"y":0}],"height":3072,"width":4096},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/GgIFf8CpTK"}]},"favorite_count":13020,"favorited":false,"full_text":"【日本列島を、強く豊かに。：三重編】\n\n本日は、『地域未来戦略』に基づき三重県が策定した、「半導体関連産業分野における地域産業クラスター計画」をご紹介します。 https://t.co/GgIFf8CpTK","id_str":"2113793180256899337","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":257,"reply_count":1364,"retweet_count":1612,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[858,870],"text":"日本列島を_強く豊かに"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTM3OTMxODAxNzI5NDMzNjA=","richtext":{"richtext_tags":[]},"text":"【日本列島を、強く豊かに。：三重編】\n\n本日は、『地域未来戦略』に基づき三重県が策定した、「半導体関連産業分野における地域産業クラスター計画」をご紹介します。\n\n半導体は、DX（デジタルトランスフォーメーション）やGX（グリーントランスフォーメーション）の実現や経済安全保障の強化に繋がる、『日本成長戦略』の要となる戦略分野であり、他の分野の「成長投資」や「危機管理投資」を支える基盤です。\n\n三重県は、中部圏や近畿圏といった大都市への近さや、安定した工業用水の供給といった立地条件の良さなどを背景に、世界最大級のフラッシュメモリ工場をはじめ、ロジック半導体やパワー半導体、さらには、半導体の原材料、部素材、製造装置、保守メンテナンスなどに強みを持つ企業約100社が集積する、全国有数の半導体製造拠点です。\n\nまた、四日市コンビナートの化学企業を中心に、先端半導体向けの部素材の研究開発施設を持つ工場が多数立地しています。\n\n三重県は、こうした強みを活かし、『地域未来戦略』の国の支援も活用し、半導体関連設備、教育設備などへの官民投資を行うとともに、大規模産業用地の確保、企業の操業環境向上に必要なインフラ整備に取り組み、半導体関連産業の更なる発展を図る「産業クラスター」を形成することを目指しています。\n\n核となる企業による設備投資を促すとともに、県内の産学官が連携した人材育成環境の構築、人材確保や販路拡大など企業が操業しやすい体制を構築することで、県内での再投資や県外からの新規立地を促進し、更なる半導体関連産業の集積を図っていく野心的な内容になっています。\n\n私自身、一見知事から以下の意気込みを伺いました。\n\n「三重県には 100 社を超える半導体企業があります。三重県全県を挙げて、日本の成長に協力をさせていただくように、地域産業クラスターを計画していきたいと思っています。」\n\n高市内閣は、「地方の景色を一変させよう」という地方自治体のあふれんばかりの「情熱」と「挑戦」を全力で応援してまいります。\n\n#日本列島を_強く豊かに"}}},"rest_id":"2113793180256899337","unmention_data":{},"views":{"count":"572527","state":"EnabledWithCount"}}}}},"entryId":"tweet-2113793180256899337","sortIndex":"2114525190858735589"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails"