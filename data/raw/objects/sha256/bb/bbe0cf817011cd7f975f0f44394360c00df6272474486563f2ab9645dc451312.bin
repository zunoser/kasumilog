ity":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":34,"bookmarked":false,"conversation_id_str":"2120063215774388649","created_at":"Tue Nov 10 07:57:14 +0000 2026","display_text_range":[0,100],"entities":{},"favorite_count":5576,"favorited":false,"full_text":"本日、宮中に参内し、令和8年秋の叙勲の親授式・伝達式に参列させていただきました。\n\n今回は、18名の皆様が大綬章を、65名の皆様が重光章を受章されました。\n\n受章された皆様、誠におめでとうございます。","id_str":"2120063215774388649","is_quote_status":false,"lang":"ja","quote_count":20,"reply_count":194,"retweet_count":510,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjAwNjMyMTU3MjgxOTc2MzI=","richtext":{"richtext_tags":[]},"text":"本日、宮中に参内し、令和8年秋の叙勲の親授式・伝達式に参列させていただきました。\n\n今回は、18名の皆様が大綬章を、65名の皆様が重光章を受章されました。\n\n受章された皆様、誠におめでとうございます。\n\n長きにわたり、それぞれの分野でご活躍され、大きなご功績を挙げられた皆様に、改めて敬意を表しますとともに、心よりお祝い申し上げます。\n\n本日、叙勲という素晴らしい日を迎えられましたが、これからもお元気で益々ご活躍されますことを、祈念申し上げます。\n\nまた、そのご活躍を通じ、特に、若い世代の方々に希望と勇気を与え続けていただきますことを、期待申し上げております。"}}},"rest_id":"2120063215774388649","unmention_data":{},"views":{"count":"135998","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120063215774388649","sortIndex":"2120091594488020969"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core"