456,"w":2600,"x":0,"y":115},{"h":1784,"w":1784,"x":210,"y":0},{"h":1784,"w":1565,"x":320,"y":0},{"h":1784,"w":892,"x":656,"y":0},{"h":1784,"w":2600,"x":0,"y":0}],"height":1784,"width":2600},"sizes":{"large":{"h":1405,"resize":"fit","w":2048},"medium":{"h":823,"resize":"fit","w":1200},"small":{"h":467,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/97FyBkc8Eq"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/97FyBkc8Eq","expanded_url":"https://x.com/takaichi_sanae/status/2119806610000195605/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":209,"w":209,"x":975,"y":69},{"h":341,"w":341,"x":721,"y":463}]},"medium":{"faces":[{"h":122,"w":122,"x":571,"y":40},{"h":200,"w":200,"x":422,"y":271}]},"orig":{"faces":[{"h":266,"w":266,"x":1239,"y":88},{"h":434,"w":434,"x":916,"y":589}]},"small":{"faces":[{"h":69,"w":69,"x":324,"y":23},{"h":113,"w":113,"x":239,"y":154}]}},"id_str":"2119806284455387136","indices":[60,83],"media_key":"3_2119806284455387136","media_results":{"result":{"media_key":"3_2119806284455387136"}},"media_url_https":"https://pbs.twimg.com/media/HWsQlaGaoAASU0j.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":115},{"h":1784,"w":1784,"x":210,"y":0},{"h":1784,"w":1565,"x":320,"y":0},{"h":1784,"w":892,"x":656,"y":0},{"h":1784,"w":2600,"x":0,"y":0}],"height":1784,"width":2600},"sizes":{"large":{"h":1405,"resize":"fit","w":2048},"medium":{"h":823,"resize":"fit","w":1200},"small":{"h":467,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/97FyBkc8Eq"}]},"favorite_count":13584,"favorited":false,"full_text":"今夜（日本時間22時から）、フランス政府の主催で開催された、「ＡＩセキュリティ」に関する会合にオンライン参加しました。 https://t.co/97FyBkc8Eq","id_str":"2119806610000195605","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":238,"reply_count":996,"retweet_count":1372,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTk4MDY2MDk5MjQ3MjY3ODQ=","richtext":{"richtext_tags":[]},"text":"今夜（日本時間22時から）、フランス政府の主催で開催された、「ＡＩセキュリティ」に関する会合にオンライン参加しました。\n\n私からは、フロンティアＡＩの発展はこれまでにない機会を生み出しつつある一方、我が国でも喫緊の課題となっているサイバー攻撃などへの悪用や制御の喪失といった安全保障上の新たな挑戦ともなっており、その影響は国境を越えることから国際社会の連携が不可欠である旨を申し上げました。\n\nその上で、フロンティアＡＩの安全性確保という目標を各国と共有しつつ、その実現には監督の在り方も含め、様々なアプローチがあり得る中、イノベーションの促進とリスク対応の両立の観点から、国際的な場で議論を深めることが重要であるとの考えをお伝えしました。\n\n日本は、２０２３年のＧ７で「広島ＡＩプロセス」の立ち上げを主導しました。\n国際社会におけるＡＩガバナンスの共通基盤として機能しているこの枠組みが、常に進化するＡＩの新たな課題に的確に対応できるよう、その実効性ある活用を各国に促していく旨も表明しました。\n\nさらに、日本は新しい課題に対応するために「ＡＩ法」を含む関連制度の見直しを進めている旨ご紹介した上で、ＡＩセーフティ・インスティテュートの知見も活かし、リスク評価や情報共有などについて各国との協力を深め、「安全、安心で信頼できるＡＩ」を共創していく旨を申し上げました。\n\n全てのステークホルダーが責任を自覚し、協力して取組を実行していくことが「安全なＡＩ」の実現への近道です。\n日本は「ＡＩサミット」を早期に開催し、「進化したＦＯＩＰ」の下、この分野での国際協力の進展に貢献していきます。"}}},"rest_id":"2119806610000195605","unmention_data":{},"views":{"count":"436887","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119806610000195605","sortIndex":"2120091594488020906"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1791191305"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"M