612668555577/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2120070556196515840","indices":[155,178],"media_key":"3_2120070556196515840","media_results":{"result":{"media_key":"3_2120070556196515840"}},"media_url_https":"https://pbs.twimg.com/media/HWwA8DDbsAAXdLY.png","original_info":{"focus_rects":[{"h":926,"w":1654,"x":0,"y":998},{"h":1654,"w":1654,"x":0,"y":634},{"h":1886,"w":1654,"x":0,"y":453},{"h":2339,"w":1170,"x":0,"y":0},{"h":2339,"w":1654,"x":0,"y":0}],"height":2339,"width":1654},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":849},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/NfBwVLZetb"}]},"favorite_count":24,"favorited":false,"full_text":"【支払の適正化に関する調査の結果】\n来年4月施行の支払告示を踏まえ、告示の対象となる5種類の委託取引について、代金の支払期日までの期間等の現状を調査。取適法対象外の取引であること等を理由に、給付の受領後60日を超えた支払いが行われている実態が明らかになりました\nhttps://t.co/hdAHrBmTAQ https://t.co/NfBwVLZetb","id_str":"2120070612668555577","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":4,"retweeted":false,"user_id_str":"2455900080"},"rest_id":"2120070612668555577","unmention_data":{},"views":{"count":"1666","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2120091594488021012-tweet-2120070615227076745","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":9},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/14