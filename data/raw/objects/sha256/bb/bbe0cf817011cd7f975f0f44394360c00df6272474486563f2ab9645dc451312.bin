 08:26:38 +0000 2026","display_text_range":[0,118],"entities":{},"favorite_count":2,"favorited":false,"full_text":"【（つづき）支払の適正化に関する調査の結果】\n支払告示では、給付の受領日から60日を超えて代金を支払うことを禁止しています。委託事業者は、取適法の対象取引に限らず、支払告示の対象となり得ることを意識して支払の適正化を図ることが必要です。","id_str":"2120070615227076745","in_reply_to_screen_name":"jftc","in_reply_to_status_id_str":"2120070612668555577","in_reply_to_user_id_str":"2455900080","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":1,"retweeted":false,"user_id_str":"2455900080"},"rest_id":"2120070615227076745","unmention_data":{},"views":{"count":"714","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2120070612668555577","2120070615227076745"],"enableDeduplication":true}}},"entryId":"list-conversation-2120091594488021012","sortIndex":"2120091594488020972"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2119857278383984640/km5IZ2tY?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mof.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":200,"url":"https://pbs.twimg.com/card_img/2119857278383984640/km5IZ2tY?format=png&name=280x280_2","width":200},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":203,"url":"https://pbs.twimg.com/card_img/2119857278383984640/km5IZ2tY?format=png&name=orig","width":200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img