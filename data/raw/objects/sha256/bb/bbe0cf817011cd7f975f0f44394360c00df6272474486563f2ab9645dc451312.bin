},{"h":151,"w":151,"x":731,"y":90}]},"orig":{"faces":[{"h":100,"w":100,"x":1520,"y":250},{"h":118,"w":118,"x":12,"y":374},{"h":246,"w":246,"x":566,"y":436},{"h":258,"w":258,"x":1248,"y":154}]},"small":{"faces":[{"h":33,"w":33,"x":504,"y":83},{"h":39,"w":39,"x":3,"y":124},{"h":81,"w":81,"x":187,"y":144},{"h":85,"w":85,"x":414,"y":51}]}},"id_str":"2119803478008819712","indices":[113,136],"media_key":"3_2119803478008819712","media_results":{"result":{"media_key":"3_2119803478008819712"}},"media_url_https":"https://pbs.twimg.com/media/HWsOCDRacAAx-a6.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1463,"w":1463,"x":0,"y":0},{"h":1463,"w":1283,"x":23,"y":0},{"h":1463,"w":732,"x":298,"y":0},{"h":1463,"w":2048,"x":0,"y":0}],"height":1463,"width":2048},"sizes":{"large":{"h":1463,"resize":"fit","w":2048},"medium":{"h":857,"resize":"fit","w":1200},"small":{"h":486,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/0HMkPiESy5"}]},"favorite_count":311,"favorited":false,"full_text":"フランス・パリを訪問中の茂木外務大臣は、ジャン＝ノエル・バロ・フランス欧州・外務大臣（H.E. Mr. Jean-Noël Barrot, Minister for Europe and Foreign Affairs of https://t.co/0HMkPiESy5","id_str":"2119804813957579223","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":2,"retweet_count":53,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/erp/erp_…","expanded_url":"https://www.mofa.go.jp/mofaj/erp/erp_1/fr/pageit_000001_00006.html","indices":[224,247],"url":"https://t.co/y2JQO8M5xx"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTk4MDQ4MTM4MTkxNzkwMDk=","richtext":{"richtext_tags":[]},"text":"フランス・パリを訪問中の茂木外務大臣は、ジャン＝ノエル・バロ・フランス欧州・外務大臣（H.E. Mr. Jean-Noël Barrot, Minister for Europe and Foreign Affairs of France）と会談を行いました。茂木大臣から、インド太平洋国家でもあるフランスとの関係を重視している旨述べた上で、国際秩序が大きく揺らぐ中、日仏間で一層連携し、G7でも国際社会の諸課題に共に取り組みたい旨述べました。\n\nhttps://t.co/y2JQO8M5xx"}}},"rest_id":"2119804813957579223","unmention_data":{},"views":{"count":"15234","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119804813957579223","sortIndex":"2120091594488020905"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHWwUEozAJxEKAAIdbA9EIRtxpQgAAwAAAAEAAA"},"entryId":"cursor-top-2120091594488020993","sortIndex":"2120091594488020993"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHWwUEoy__6YKAAIdaw8_QRrB1wgAAwAAAAIAAA"},"entryId":"cursor-bottom-2120091594488020904","sortIndex":"2120091594488020904"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}