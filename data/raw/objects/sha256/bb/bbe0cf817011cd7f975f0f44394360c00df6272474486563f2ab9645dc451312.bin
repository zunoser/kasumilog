28.html","indices":[204,227],"url":"https://t.co/P1kvIwVRv7"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTk4MTQ0ODA3MDQyMTcwODg=","richtext":{"richtext_tags":[]},"text":"フランス・パリを訪問中の茂木外務大臣は、G7外相会合の「危機・国際的課題」に関するセッション（ワーキング・ランチ形式）に参加しました（G7各国外相及びEU上級代表が参加。ルーク・リンドバーグ世界食糧計画（WFP）事務局長も一部参加）。本セッションにおいて、G7各国外相は、インド太平洋、アフリカ、中南米を始めとする地域情勢及びグローバル・ガバナンスといった国際的課題について、率直な意見交換を行いました。\n\nhttps://t.co/P1kvIwVRv7"}}},"rest_id":"2119814480813297973","unmention_data":{},"views":{"count":"17358","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119814480813297973","sortIndex":"2120091594488020907"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],