ranslatable":false,"legacy":{"bookmark_count":27,"bookmarked":false,"conversation_id_str":"2119821475876311314","created_at":"Mon Nov 09 15:56:38 +0000 2026","display_text_range":[0,110],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/khorw51JEo","expanded_url":"https://x.com/kantei/status/2119821475876311314/video/1","ext_media_availability":{"status":"Available"},"id_str":"2119820050706374656","indices":[111,134],"media_key":"13_2119820050706374656","media_results":{"result":{"media_key":"13_2119820050706374656"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2119820050706374656/img/X1zCy2bZwOQ7-9oW.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/khorw51JEo","video_info":{"aspect_ratio":[16,9],"duration_millis":182533,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2119820050706374656/pl/90W7fOxXiAktMfMX.m3u8?tag=29&v=c43"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119820050706374656/vid/avc1/480x270/4pha6oU4kRvzpdom.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119820050706374656/vid/avc1/640x360/J4NiWH3PQCnI0LkI.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119820050706374656/vid/avc1/1280x720/UUvs8e65g_NAPJ80.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/khorw51JEo","expanded_url":"https://x.com/kantei/status/2119821475876311314/video/1","ext_media_availability":{"status":"Available"},"id_str":"2119820050706374656","indices":[111,134],"media_key":"13_2119820050706374656","media_results":{"result":{"media_key":"13_2119820050706374656"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2119820050706374656/img/X1zCy2bZwOQ7-9oW.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/khorw51JEo","video_info":{"aspect_ratio":[16,9],"duration_millis":182533,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2119820050706374656/pl/90W7fOxXiAktMfMX.m3u8?tag=29&v=c43"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119820050706374656/vid/avc1/480x270/4pha6oU4kRvzpdom.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119820050706374656/vid/avc1/640x360/J4NiWH3PQCnI0LkI.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2119820050706374656/vid/avc1/1280x720/UUvs8e65g_NAPJ80.mp4?tag=29"}]}}]},"favorite_count":1351,"favorited":false,"full_text":"【お知らせ】\n１１月９日、高市総理は、ベトナムのトー・ラム書記長兼国家主席と会談を行いました。\n\n※両首脳による冒頭発言（速報版、仮訳）\n（高市総理）\n　トー・ラム書記長兼国家主席及び御一行の訪日を改めて歓迎いたします。 https://t.co/khorw51JEo","id_str":"2119821475876311314","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":14,"reply_count":130,"retweet_count":168,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTk4MjE0NzU3OTY2ODA3MDQ=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n１１月９日、高市総理は、ベトナムのトー・ラム書記長兼国家主席と会談を行いました。\n\n※両首脳による冒頭発言（速報版、仮訳）\n（高市総理）\n　トー・ラム書記長兼国家主席及び御一行の訪日を改めて歓迎いたします。\n　５月のベトナム訪問時に私が発表した、『進化したＦＯＩＰ』への支持に改めて感謝申し上げます。\n　その実現に向け、日ベトナム間の具体的な協力を積み重ねてまいりたいと思っております。\n　先ほど、ラム書記長の国会演説を拝聴して、新しい時代のベトナムが進める改革による経済成長の勢いというものを実感いたしました。日本・ベトナム関係を共に前進させたいと思っております。\n　今回の訪日が、両国の『包括的戦略的パートナーシップ』を新たな高みに引き上げることを確信しております。\n　ありがとうございます。\n\n（トー・ラム書記長兼国家主席）※日本語仮訳\n　こんにちは。高市早苗総理大臣閣下、そして日本の皆様、ベトナム訪問団の皆様。\n　この度は日本で再び総理にお目にかかることができて嬉しく思います。今回は美しい日本を訪問して、このように再会できて嬉しく思います。\n　そして、私はとても感激を受けました。このように天皇皇后両陛下、皇室、日本国会、そして日本総理大臣また日本政府から、心温まるご歓待いただきましたことに感銘を受けております。この場を借りてレー・ミン・フン首相閣下、そしてベトナムの指導者達から挨拶を預かりましたのでお伝え申し上げます。\n　そして、先般、ベトナムをアジア初の外遊先として選んでいただきましたことを高く評価します。これはまさにベトナムに対する日本の関心、そして高い優先の表れだと思います。日本は、ベトナムの最も最重要、戦略的パートナーシップと見なしており、誠実で信頼できる、またベトナムの持続可能な発展に向けて共に歩んでいただけるパートナーとして見ております。日本が、この地域と世界に積極的な役割を果たせることを支持します。日本が、強く豊かな日本を取り戻すため、必要な戦略をすることを支持したいと思います。\n　そして今回は、ぜひ両国の関係を新たな高みに引き上げるために一緒に意見交換していただきたい。これから両国は、質の高い成長と戦略的自律性・強靱性の実現に向け、共に歩み、共に創り、共に利益を享受するパートナーシップとしてやっていきたいと考えております。\n　ありがとうございました。ぜひ首相閣下から意見を頂戴できればと思います。"}}},"rest_id":"2119821475876311314","unmention_data":{},"views":{"count":"59273","state":"EnabledWithCount"}}}}},"entryId":"tweet-2119821475876311314","sortIndex":"2120091594488020909"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"loca