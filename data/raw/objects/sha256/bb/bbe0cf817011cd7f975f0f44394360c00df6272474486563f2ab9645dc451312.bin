":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/uLD4sh7Mwo"}]},"favorite_count":1942,"favorited":false,"full_text":"本日午後、李大淳（イ・デスン）会長を始め韓日協力委員会一行の皆様が官邸にお越し下さいました。\nなお、日韓協力委員会から、麻生太郎会長、中曽根弘文会長代行兼理事長、長島昭久副理事長、松下新平事務総長もご同席くださいました。 https://t.co/uLD4sh7Mwo","id_str":"2120073712972312679","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":26,"reply_count":148,"retweet_count":232,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjAwNzM3MTI5MTc3MTY5OTI=","richtext":{"richtext_tags":[]},"text":"本日午後、李大淳（イ・デスン）会長を始め韓日協力委員会一行の皆様が官邸にお越し下さいました。\nなお、日韓協力委員会から、麻生太郎会長、中曽根弘文会長代行兼理事長、長島昭久副理事長、松下新平事務総長もご同席くださいました。\n\n私から、皆様の訪日を歓迎しつつ、昨9日の「日韓・韓日協力委員会合同総会」の開催と成功をお祝い申し上げました。\n\n日本と韓国は、国際社会の様々な課題に、パートナーとして協力すべき重要な隣国であり、現下の戦略環境において、日韓、日韓米の連携強化は一層重要です。\n\n日韓関係の重要性が高まる中で、日韓・韓日協力委員会が果たすべき役割は、更に大きくなっており、今後も官民で連携して取り組んでまいります。"}}},"rest_id":"2120073712972312679","unmention_data":{},"views":{"count":"95264","state":"EnabledWithCount"}}}}},"entryId":"tweet-2120073712972312679","sortIndex":"2120091594488020974"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_coun