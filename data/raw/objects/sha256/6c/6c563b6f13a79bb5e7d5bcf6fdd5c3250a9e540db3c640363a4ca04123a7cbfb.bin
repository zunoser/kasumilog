ning":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2090012605255716865","created_at":"Wed Aug 19 09:46:50 +0000 2026","display_text_range":[0,140],"entities":{"user_mentions":[{"id_str":"1744650615643639809","indices":[3,18],"name":"警察庁（災害情報専用）","screen_name":"NPA_saigaiKOHO"}]},"favorite_count":0,"favorited":false,"full_text":"RT @NPA_saigaiKOHO: 警視庁の被災者支援部隊が、八代郡の氷川町公民館を訪問しました。\n被災者の皆様の苦しみや辛さを和らげ、笑顔を取り戻す力になりたい。警察官には熱い思いがあります。\n被災地のためにできることは何か、試行錯誤しながら今日も活動していきます。 ht…","id_str":"2090012605255716865","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":280,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":56},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1744651893413236736/ARtnUwkl_normal.png"},"banner":{"image_url":""},"core":{"created_at":"Tue Jan 09 09:26:12 +0000 2024","name":"警察庁（災害情報専用）","screen_name":"NPA_saigaiKOHO"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxNzQ0NjUwNjE1NjQzNjM5ODA5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2丁目1番2号"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"警察庁公式アカウントです。 発信する情報は「国内災害情報」「災害時警察活動」等です。発信専用のため返信等は行っておりません。ご利用にあたっては「警察庁（災害情報専用）X（旧：Twitter）運用ポリシーhttps://t.co/PluqK5Z3rXをご覧ください。","entities":{"description":{"urls":[{"display_url":"npa.go.jp/twitter/NPAsai…","expanded_url":"https://www.npa.go.jp/twitter/NPAsaigaipolicy.html","indices":[101,124],"url":"ht