t"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2089976834389913667"],"editable_until_msecs":"1787127881000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1451,"bookmarked":false,"conversation_id_str":"2089976834389913667","created_at":"Wed Aug 19 07:24:41 +0000 2026","display_text_range":[0,66],"entities":{"media":[{"display_url":"pic.x.com/sxj5MOaMng","expanded_url":"https://x.com/MofaJapan_jp/status/2089976834389913667/photo/1","ext_alt_text":"外務報道官談話：国際刑事裁判所（ＩＣＣ）に対する米国の制裁\n１　今般、国際刑事裁判所（ＩＣＣ）の裁判所長である赤根智子判事が、米国の制裁措置の対象として新たに追加されました。\n２　我が国は、国際社会における最も重大な犯罪の処罰と撲滅、法の支配の徹底のため、常設の国際刑事法廷であるＩＣＣを一貫して支持してきています。このような立場から、今回の措置は大変残念です。\n３　我が国としては、引き続き、関係国等と意思疎通を取りつつ、国際社会における法の支配の強化に取り組んでいく考えです。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":53,"w":53,"x":573,"y":418},{"h":60,"w":60,"x":405,"y":455}]},"medium":{"faces":[{"h":48,"w":48,"x":529,"y":386},{"h":55,"w":55,"x":374,"y":420}]},"orig":{"faces":[{"h":53,"w":53,"x":573,"y":418},{"h":60,"w":60,"x":405,"y":455}]},"small":{"faces":[{"h":27,"w":27,"x":300,"y":218},{"h":31,"w":31,"x":212,"y":238}]}},"id_str":"2089976702730743808","indices":[67,90],"media_key":"3_2089976702730743808","media_results":{"result":{"media_key":"3_2089976702730743808"}},"media_url_https":"https://pbs.twimg.com/media/HQEWvOsbsAAA6u7.png","original_info":{"focus_rects":[{"h":582,"w":1039,"x":0,"y":0},{"h":1039,"w":1039,"x":0,"y":0},{"h":1184,"w":1039,"x":0,"y":0},{"h":1299,"w":650,"x":389,"y":0},{"h":1299,"w":1039,"x":0,"y":0}],"height":1299,"width":1039},"sizes":{"large":{"h":1299,"resize":"fit","w":1039},"medium":{"h":1200,"resize":"fit","w":960},"small":{"h":680,"resize":"fit","w":544},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/sxj5MOaMng"}],"u