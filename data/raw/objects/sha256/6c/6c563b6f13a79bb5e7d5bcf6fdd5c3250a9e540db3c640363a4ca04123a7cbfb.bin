:false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":7,"reply_count":17,"retweet_count":121,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/me_a/me2…","expanded_url":"https://www.mofa.go.jp/mofaj/me_a/me2/sa/pageit_000001_03140.html","indices":[237,260],"url":"https://t.co/zF6kU4lUji"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTAwODU3OTU0MzI3MDYwNDg=","richtext":{"richtext_tags":[]},"text":"サウジアラビアを訪問中の茂木外務大臣は、ファイサル・ビン・ファルハーン・アール・サウード・サウジアラビア外務大臣との間で第3回外相級戦略対話を行いました。茂木大臣から、ホルムズ海峡やバブ・エル・マンデブ海峡の不安定な状況が続く中、サウジアラビアが世界に対するエネルギー供給に尽力していることへの謝意を伝えました。両大臣は、米・イラン間の最終的な合意の早期実現及びホルムズ海峡におけるいかなる追加的費用もない形での自由で安全な航行の確保が重要であるとの認識で一致しました。\n\nhttps://t.co/zF6kU4lUji"}}},"rest_id":"2090085795554320651","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"20300","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090085795554320651","sortIndex":"2090287472717070300"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/3692310981/5e84849fe6a5c60bc3a3818c6f4cbec4_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/286056244/1782437584"},"core":{"created_at":"Fri Apr 22 08:05:55 +0000 2011","name":"環境省","screen_name":"Kankyo_Jpn"},"dm_permissions":{"can_dm":false},"follow