.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2970154,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":515,"tweets":1709},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2090228653305315331"],"editable_until_msecs":"1787187920000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":141,"bookmarked":false,"conversation_id_str":"2090228653305315331","created_at":"Thu Aug 20 00:05:20 +0000 2026","display_text_range":[0,78],"entities":{},"favorite_count":8972,"favorited":false,"full_text":"49年前の本日、木星、土星、天王星、海王星のグランドツアーを初めて実現し、人類による宇宙探査の歴史を切り拓いた探査機「ボイジャー2号」が打ち上げられました。","id_str":"2090228653305315331","is_quote_status":false,"lang":"ja","quote_count":168,"reply_count":529,"retweet_count":1033,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTAyMjg2NTMyMzM5NjMwMDg=","richtext":{"richtext_tags":[]},"text":"49年前の本日、木星、土星、天王星、海王星のグランドツアーを初めて実現し、人類による宇宙探査の歴史を切り拓いた探査機「ボイジャー2号」が打ち上げられました。\n\n近年の宇宙開発利用は、新規参入事業者の急増や技術革新の進展などにより急速に多様化しており、我が国においても、開発段階において人工衛星に模した物体をロケットに搭載して試験的に打ち上げるなど、ロケットの打上げ形態も多様化しています。\n\nこうした状況に対応するため、先の国会において、『改正宇宙活動法』が成立しましたので、改正内容をご紹介します。\n\n第一に、人工衛星の開発段階の試験打上げとして行われる、人工衛星の搭載又は分離を伴わない打上げについても、法の規制対象に追加しました。\nこれにより、公共の安全を確保するとともに、「第三者損害」が生じた場合には政府補償の対象に追加することで、新規事業者の開発を後押しします。\n\n第二に、人工衛星に模した物体など、人工衛星に該当しない人工の物体についても、その構造が法律の基準に適合していることを打上げ前に認定する制度を創設しました。\nこれにより、公共の安全を確保し、宇宙空間の有害な汚染等を防止するとともに、基準への適合性について、事業者の予見可能性をより高めていきます。\n\n宇宙への投資は、安全保障・経済・国民生活を支える「次世代の国家インフラへの重要な投資」であり、高市内閣では、「宇宙分野」を『日本成長戦略』の「17の戦略分野」に位置づけています。\n\n『改正宇宙活動法』により、国際的責任を果たしつつ、我が国の宇宙活動の安全性を確保し、我が国の打上げ能力の強化や宇宙産業の発展を後押しするとともに、『日本成長戦略』の下で技術開発や民間事業者への支援を強化し、宇宙先進国の一角として世界をリードしてまいります。"}}},"rest_id":"2090228653305315331","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"277574","state":"EnabledWithCount"}}}}},"entryId":"tweet-2090228653305315331","sortIndex":"2090287472717070303"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzY2ODI3OTE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関 "},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2001095001481076943"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国税庁の公式アカウントです。税に関する情報を提供します。フォローやリプライは行いません。税務行政に対するご意見・ご要望は国税庁ホームページまで。https://t.co/R1uFb0Nu5B","entities":{"description":{"urls":[{"display_url":"nta.go.jp/iken/mail.htm","expanded_url":"https://www.nta.go.jp/iken/mail.htm","indices":[72,95],"url":"https://t.co/R1uFb0Nu5B"}]},"url":{"urls":[{"display_url":"nta.go.jp","expanded_url":"http://www.nta.go.jp","indices":[0,22],"url":"http://t.co/lihYeigkCT"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":199779,"following":15},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"236682791","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":1604,"tweets":39