/HRNDvgWbEAAx29R.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":278},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":0,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mUVSWLmNzM"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/mUVSWLmNzM","expanded_url":"https://x.com/takaichi_sanae/status/2095092936631542261/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2095092735023910912","indices":[126,149],"media_key":"3_2095092735023910912","media_results":{"result":{"media_key":"3_2095092735023910912"}},"media_url_https":"https://pbs.twimg.com/media/HRNDvgKaEAAPU4b.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":115},{"h":1727,"w":1727,"x":873,"y":0},{"h":1727,"w":1515,"x":1085,"y":0},{"h":1727,"w":864,"x":1736,"y":0},{"h":1727,"w":2600,"x":0,"y":0}],"height":1727,"width":2600},"sizes":{"large":{"h":1360,"resize":"fit","w":2048},"medium":{"h":797,"resize":"fit","w":1200},"small":{"h":452,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/mUVSWLmNzM"}]},"favorite_count":19215,"favorited":false,"full_text":"本日、防衛省にて自衛隊指揮官幹部会同に出席し、訓示を行いました。\nその後、官邸に幹部の皆さんをお招きし、昼食をともにしながら率直な意見交換を行いました。\n\n7月に発生した熊本地震では、自衛隊は発災直後から全力で対応にあたり、幅広い支援を展開しました。 https://t.co/mUVSWLmNzM","id_str":"2095092936631542261","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":201,"reply_count":863,"retweet_count":1970,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTUwOTI5MzY1NjQ0NDEwODg=","richtext":{"richtext_tags":[]},"text":"本日、防衛省にて自衛隊指揮官幹部会同に出席し、訓示を行いました。\nその後、官邸に幹部の皆さんをお招きし、昼食をともにしながら率直な意見交換を行いました。\n\n7月に発生した熊本地震では、自衛隊は発災直後から全力で対応にあたり、幅広い支援を展開しました。\n自らや家族が被災しながらも任務に当たった隊員もいたと聞いています。\nまた、今この瞬間も、中東・アフリカ地域での海賊対処、日本の領土・領海・領空を守るための24時間365日の警戒監視、そして厳しい訓練に耐える隊員がいます。\nこうした地道な積み重ねが、今日の国民の皆様の自衛隊へのゆるぎない信頼につながっており、自衛隊への期待はかつてなく高まっています。\n\n年内には『国家安全保障戦略』をはじめとする「三文書」を改定し、防衛力強化の新たな方向性を打ち出します。\n今後、AIや無人アセット、宇宙、サイバー、電磁波などの専門領域を徹底して活用していくことが必要です。\n多くの人の知恵を集め、これからの時代に必要な防衛力とは何かを考え抜き、そして、果断に実行に移していかなければなりません。\n\nそして、どれほど優れた装備を整えても、最後にそれを動かすのは「人」です。\n隊員一人ひとりが高い士気と誇りを持ち、国防という崇高な任務に邁進できるよう、自衛官の処遇改善などの環境整備にも取り組みます。\n\n国民の皆様の命と平和な暮らしを、断固として守り抜く。\n自衛隊の最高指揮官として、その決意を新たにいたしました。"}}},"rest_id":"2095092936631542261","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"371346","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095092936631542261","sortIndex":"2095371101990289365"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_v