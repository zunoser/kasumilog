{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/LLjGLhufUl","expanded_url":"https://x.com/NPA_saigaiKOHO/status/2095093123554869594/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2095091268766617600","indices":[144,167],"media_key":"3_2095091268766617600","media_results":{"result":{"media_key":"3_2095091268766617600"}},"media_url_https":"https://pbs.twimg.com/media/HRNCaJ7bUAArEDd.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":389},{"h":1536,"w":1536,"x":204,"y":0},{"h":1536,"w":1347,"x":299,"y":0},{"h":1536,"w":768,"x":588,"y":0},{"h":1536,"w":2048,"x":0,"y":0}],"height":1536,"width":2048},"sizes":{"large":{"h":1536,"resize":"fit","w":2048},"medium":{"h":900,"resize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/LLjGLhufUl"}]},"favorite_count":1198,"favorited":false,"full_text":"特別自動車警ら部隊は熊本の安全・安心を確保すべく、絶えず警戒の手を緩めません。写真は愛知県警察の部隊がパトロールに向かう様子と大阪府警察の部隊が宇城市小川町付近をパトロールする様子です。夜間帯や警戒要望場所のパトロールも欠かさず行います。\n#令和８年熊本地震 #愛知県警察 #大阪府警察 https://t.co/LLjGLhufUl","id_str":"2095093123554869594","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":4,"reply_count":9,"retweet_count":195,"retweeted":false,"user_id_str":"1744650615643639809"},"rest_id":"2095093123554869594","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"39112","state":"EnabledWithCount"}}},"user_id_str":"2891516809"},"rest_id":"2095093339662275007","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1092","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095093339662275007","sortIndex":"2095371101990289366"},{"content":{"__typename":"TimelineTimelineItem","clientEventIn