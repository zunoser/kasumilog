":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"mlit.go.jp","expanded_url":"http://www.mlit.go.jp/","indices":[0,23],"url":"https://t.co/yYaoVyKjKO"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":383161,"following":477},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"571429134","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":7935,"tweets":88279},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/yYaoVyKjKO"}}}},"edit_control":{"edit_tweet_ids":["2095346040572637665"],"editable_until_msecs":"1788408000000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2095346040572637665","created_at":"Thu Sep 03 03:00:00 +0000 2026","display_text_range":[0,139],"entities":{"hashtags":[{"indices":[16,23],"text":"匠のモノサシ"}]},"favorite_count":13,"favorited":false,"full_text":"╋━━━━━━━\n\n　TV番組『#匠のモノサシ』📏\n\n　　　　　　　━━━━━━━╋\n\n＜匠のモノサシ過去の放送を一挙紹介！＞\n\nそれぞれの数字は・・・・\n\n第２話・・・0.8秒！鉄筋工\n職人技と工具でレースを決行！果たして勝負の行方はーーー？\n\n第３話・・・12mm！型わく工","id_str":"2095346040572637665","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":0,"retweet_count":6,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[16,23],"text":"匠のモノサシ"},{"indices":[501,512],"text":"MLIT建設産業PR"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"ntv.co.jp/takuminomonosa…","expanded_url":"https://www.ntv.co.jp/takuminomonosashi/","indices":[320,343],"url":"https://t.co/GJJMYZnNNs"},{"display_url":"ntv.co.jp/takuminomonosa…","expanded_url":"https://www.ntv.co.jp/takuminomonosashi/backnumber/","indices":[356,379],"url":"https://t.co/IxE1g9icPW"},{"display_url":"mlit.go.jp/totikensangyo/…","expanded_url":"https://www.mlit.go.jp/totikensangyo/const/sosei_const_tk1_000089.html","indices":[476,499],"url":"https://t.co/kPJLLRPIOH"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTUzNDYwNDA0MjU4ODU2OTY=","text":"╋━━━━━━━\n\n　TV番組『#匠のモノサシ』📏\n\n　　　　　　　━━━━━━━╋\n\n＜匠のモノサシ過去の放送を一挙紹介！＞\n\nそれぞれの数字は・・・・\n\n第２話・・・0.8秒！鉄筋工\n職人技と工具でレースを決行！果たして勝負の行方はーーー？\n\n第３話・・・12mm！型わく工\nミリ単位の精度が求められる作業はまさに匠の技！\n\n第４話・・・55MPa！橋りょう特殊工\n橋をつくるために必要な圧力は、指先1本に約560kgの負荷がのっているのと同じレベル！？\n\n第５話・・・0.1mm！左官工\n鏡のような壁を作り出す匠の究極の技は必見！\n\n第６話・・・10歳！電工\n電気設備を扱うちいさな職人さん！？\n\n「匠のモノサシ」公式WEBサイト👇\nhttps://t.co/GJJMYZnNNs\n\nバックナンバー一覧👇\nhttps://t.co/IxE1g9icPW\n\n⏰見逃し配信は、2027年9月23日まで\n \n国土交通省は「建設業への入職促進に向けた魅力発信事業」における「中高生・保護者向けPR」の一環として、本番組に提供しています。\n詳しくはこちら：https://t.co/kPJLLRPIOH\n\n#MLIT建設産業PR"}}},"rest_id":"2095346040572637665","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"1907","state":"EnabledWithCount"}}}}},"entryId":"tweet-2095346040572637665","sortIndex":"2095371101990289393"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2095371101990289424-tweet-2095344687024345474","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typ