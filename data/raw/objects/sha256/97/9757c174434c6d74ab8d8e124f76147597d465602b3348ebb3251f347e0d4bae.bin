resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/bOqCOcJGFF","video_info":{"aspect_ratio":[16,9],"duration_millis":376166,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122647497743192064/pl/VB6EKoeHRJHCAKob.m3u8?tag=29&v=dbc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122647497743192064/vid/avc1/480x270/6IWkcTlP2JtMnYza.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122647497743192064/vid/avc1/640x360/Au1fLM8IW9CQdI7y.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122647497743192064/vid/avc1/1280x720/SWRMJ8OSvBGtZIJ4.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/bOqCOcJGFF","expanded_url":"https://x.com/kantei/status/2122649021215126003/video/1","ext_media_availability":{"status":"Available"},"id_str":"2122647497743192064","indices":[106,129],"media_key":"13_2122647497743192064","media_results":{"result":{"media_key":"13_2122647497743192064"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2122647497743192064/img/rxv1ol0rTLBeN0vS.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/bOqCOcJGFF","video_info":{"aspect_ratio":[16,9],"duration_millis":376166,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122647497743192064/pl/VB6EKoeHRJHCAKob.m3u8?tag=29&v=dbc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122647497743192064/vid/avc1/480x270/6IWkcTlP2JtMnYza.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122647497743192064/vid/avc1/640x360/Au1fLM8IW9CQdI7y.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122647497743192064/vid/avc1/1280x720/SWRMJ8OSvBGtZIJ4.mp4?tag=29"}]}}]},"favorite_count":538,"favorited":false,"full_text":"【お知らせ】\n１１月１７日（現地時間）、高市総理は、日ＡＳＥＡＮ首脳会議に出席しました。\n\n※冒頭発言要旨（速報版、仮訳）\n（マルコス大統領）\n　高市早苗総理大臣、陛下、閣下、ご列席の皆様、おはようございます。 https://t.co/bOqCOcJGFF","id_str":"2122649021215126003","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":24,"retweet_count":99,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI2NDkwMjEwNzI1MDY4ODA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n１１月１７日（現地時間）、高市総理は、日ＡＳＥＡＮ首脳会議に出席しました。\n\n※冒頭発言要旨（速報版、仮訳）\n（マルコス大統領）\n　高市早苗総理大臣、陛下、閣下、ご列席の皆様、おはようございます。\n　第２９回日ＡＳＥＡＮ首脳会議に皆様をお迎えできることを、大変嬉しく思います。\n　ＡＳＥＡＮと日本は、政府間の信頼と国民同士の永続的な絆に支えられたパートナーシップを築いてまいりました。\n　来年、ＡＳＥＡＮは設立６０周年を迎えます。また、福田ドクトリンの５０周年も迎えます。\n　その原則である「平和」「協力」「心と心の触れ合う相互信頼関係」は、今日もなお私達の関係を形づくっています。\n　本年は、東南アジアにおける友好協力条約（ＴＡＣ）５０周年を迎えます。この節目を記念する国連総会決議を共同提案いただいた日本に感謝申し上げます。\n　２０２３年、私達は関係を包括的戦略的パートナーシップへと格上げし、日ＡＳＥＡＮ友好協力に関する共同ビジョン・ステートメントを採択しました。\n　これらは、次世代に向けた私達の志を示すものです。「平和と安定のためのパートナー」として、ＡＳＥＡＮは、ＡＳＥＡＮの中心性及びインド太平洋に関するＡＳＥＡＮアウトルック（ＡＯＩＰ）に対する日本の支持を高く評価しています。\n　また、拡大ＡＳＥＡＮ国防相会議（ＡＤＭＭプラス）及び防衛協力強化のための日ＡＳＥＡＮイニシアティヴ：ジャスミン（ＪＡＳＭＩＮＥ）を通じた協力、並びに越境犯罪、オンライン詐欺及びサイバー脅威への対処における共同の取組も高く評価しています。\n　「未来の経済・社会を共創するパートナー」として、私達は、地域的な包括的経済連携（ＲＣＥＰ）協定及び日ＡＳＥＡＮ包括的経済連携（ＡＪＣＥＰ）協定を通じて経済統合を深化させており、同協定のアップグレードの可能性に関する議論も進めています。\n　私達の取組は、日ＡＳＥＡＮ経済共創に関する未来デザイン及び行動計画、並びに新たな日ＡＳＥＡＮ ＡＩ共創イニシアティブに導かれています。\n　アジア・エネルギー資源強靱化パートナーシップ（ＰＯＷＥＲＲ Ａｓｉａ）及びＡＳＥＡＮパワーグリッドを通じたエネルギー安全保障への日本の支援を歓迎します。\n　また、ＡＳＥＡＮ＋３緊急米備蓄（ＡＰＴＥＲＲ）及びみどり協力プランを通じた食料安全保障への日本の支援を歓迎します。\n　「世代を超えた心と心のパートナー」として、私達は、対日理解促進交流プログラム（ＪＥＮＥＳＹＳ）、東南アジア青年の船事業、次世代共創パートナーシップ－文化のＷＡ２．０－、さくらサイエンスプログラムを通じて、国民同士の距離を縮めています。\n　ＡＳＥＡＮ感染症対策センター（ＡＣＰＨＥＥＤ）及びＡＳＥＡＮ防災人道支援調整センター（ＡＨＡセンター）に対する日本の支援は、より健康が保障され、災害に強靱なＡＳＥＡＮの構築に役立っています。\n　本日は、私達が共に成し遂げてきた成果と、日ＡＳＥＡＮ関係の今後の方向性について、実りある議論ができることを楽しみにしています。\n　それでは、高市早苗総理大臣より冒頭発言をお願いいたします。\n\n（高市総理）\n　マルコス・フィリピン大統領及びウォン・シンガポール首相の御尽力に感謝を申し上げます。\n　国際秩序が大きく揺らぐ中で、日本は、『進化したＦＯＩＰ』の下、自由、開放性、多様性、包摂性、法の支配に基づく国際秩序の維持・強化に向けて、一層主体的な役割を果たしてまいります。\n　日本はＡＳＥＡＮの中心性・一体性を尊重し、ＦＯＩＰ実現の要であるＡＳＥＡＮ各国と手を携え、ＡＯＩＰとの相乗効果を高めながら、「自律性」と「強靱性」を身につけて、「共に、強く豊か」になることを目指しています。\n　本日、「経済強靱性の実現に関する共同声明」を採択でき、大変喜ばしいことです。パワー・アジアの下、日本は、経済・エネルギーの強靱化を進めてまいります。また、恣意的な輸出規制の課題にも対応するため、重要鉱物を含むサプライチェーンも強化します。\n　ＡＩの急速な進展に伴う新たな脆弱性に対応すべく、今般、「ＡＩ安全性・セキュリティに関する日ＡＳＥＡＮパートナーシップ」を立ち上げました。ＡＳＥＡＮと共に解決策を探っていきます。\n　「日・ＡＳＥＡＮ経済連携協定」の強化に向けた検討も進めます。\n　次に、「共同ビジョン声明」の三本柱に沿った協力の進展を共有します。\n　第一の柱「平和と安定のためのパートナー」に関し、日本は、ＡＳＥＡＮ諸国の海上保安・海洋安全保障能力の強化支援や、ＡＳＥＡＮＡＰＯＬを通じた特殊詐欺対策を継続いたします。\n　第二の柱「未来の経済・社会を共創するパートナー」に関し、日ＡＳＥＡＮ・ＡＩ共創イニシアティブ、ＦＯＩＰデジタル回廊構想などを推進するほか、ＡＨＡセンターへの支援を通じて、地域の防災強靱性を強化します。\n　第三の柱「世代を超えた心と心のパートナー」に関し、ＪＥＮＥＳＹＳや東南アジア青年の船を通じた青少年交流、 ＮＥＸＵＳを通じた科学技術協力によるイノベーション共創を継続してまいります。\n　とにかく、これからも皆様と力を合わせて歩んでいきたいと思っております。ありがとう。"}}},"rest_id":"2122649021215126003","unmention_data":{},"views":{"count":"31669","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122649021215126003","sortIndex":"2122682497434124277"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profi