]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2122650338478206976","indices":[157,180],"media_key":"3_2122650338478206976","media_results":{"result":{"media_key":"3_2122650338478206976"}},"media_url_https":"https://pbs.twimg.com/media/HXUrPI9bMAASZio.jpg","original_info":{"focus_rects":[{"h":666,"w":1190,"x":0,"y":383},{"h":1190,"w":1190,"x":0,"y":121},{"h":1357,"w":1190,"x":0,"y":38},{"h":1686,"w":843,"x":0,"y":0},{"h":1686,"w":1190,"x":0,"y":0}],"height":1686,"width":1190},"sizes":{"large":{"h":1686,"resize":"fit","w":1190},"medium":{"h":1200,"resize":"fit","w":847},"small":{"h":680,"resize":"fit","w":480},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/CnpllguXiv"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/CnpllguXiv","expanded_url":"https://x.com/FDMA_SYOBODAN/status/2122650452152267178/photo/3","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":102,"w":102,"x":936,"y":1332}]},"medium":{"faces":[{"h":72,"w":72,"x":666,"y":948}]},"orig":{"faces":[{"h":102,"w":102,"x":936,"y":1332}]},"small":{"faces":[{"h":41,"w":41,"x":377,"y":537}]}},"id_str":"2122650360498278400","indices":[157,180],"media_key":"3_2122650360498278400","media_results":{"result":{"media_key":"3_2122650360498278400"}},"media_url_https":"https://pbs.twimg.com/media/HXUrQa_a0AAEL7j.jpg","original_info":{"focus_rects":[{"h":666,"w":1190,"x":0,"y":1020},{"h":1190,"w":1190,"x":0,"y":496},{"h":1357,"w":1190,"x":0,"y":329},{"h":1686,"w":843,"x":347,"y":0},{"h":1686,"w":1190,"x":0,"y":0}],"height":1686,"width":1190},"sizes":{"large":{"h":1686,"resize":"fit","w":1190},"medium":{"h":1200,"resize":"fit","w":847},"small":{"h":680,"resize":"fit","w":480},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/CnpllguXiv"}]},"favorite_count":9,"favorited":false,"full_text":"＃消防団員 確保マニュアル紹介⑥-１（大学との連携）📝\n\n若年層の入団促進を図るには、学生へのアプローチが効果的です🧑‍🎓\n現在、学生団員は増加傾向にあります。大学、短期大学、専門学校と連携して、学生への入団促進を効果的・効率的に進めましょう🚒\n\n詳しくはこちら👇\nhttps://t.co/XAyRnbB7ym https://t.co/CnpllguXiv","id_str":"2122650452152267178","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":2,"retweeted":false,"user_id_str":"1682374304993005569"},"rest_id":"2122650452152267178","unmention_data":{},"views":{"count":"6050","state":"EnabledWithCount"}}},"user_id_str":"137272821"},"rest_id":"2122650992563126432","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1185","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122650992563126432","sortIndex":"2122682497434124278"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_t