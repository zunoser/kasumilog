":45,"x":16,"y":292},{"h":44,"w":44,"x":113,"y":302},{"h":45,"w":45,"x":223,"y":302},{"h":42,"w":42,"x":803,"y":307},{"h":42,"w":42,"x":1126,"y":318},{"h":42,"w":42,"x":459,"y":319},{"h":42,"w":42,"x":331,"y":323},{"h":40,"w":40,"x":694,"y":323},{"h":39,"w":39,"x":1018,"y":331},{"h":42,"w":42,"x":924,"y":342}]},"orig":{"faces":[{"h":99,"w":99,"x":35,"y":634},{"h":96,"w":96,"x":246,"y":655},{"h":99,"w":99,"x":484,"y":655},{"h":93,"w":93,"x":1741,"y":667},{"h":91,"w":91,"x":2440,"y":690},{"h":91,"w":91,"x":995,"y":693},{"h":93,"w":93,"x":718,"y":700},{"h":88,"w":88,"x":1505,"y":700},{"h":86,"w":86,"x":2206,"y":718},{"h":93,"w":93,"x":2003,"y":741}]},"small":{"faces":[{"h":25,"w":25,"x":9,"y":165},{"h":25,"w":25,"x":64,"y":171},{"h":25,"w":25,"x":126,"y":171},{"h":24,"w":24,"x":455,"y":174},{"h":23,"w":23,"x":638,"y":180},{"h":23,"w":23,"x":260,"y":181},{"h":24,"w":24,"x":187,"y":183},{"h":23,"w":23,"x":393,"y":183},{"h":22,"w":22,"x":576,"y":187},{"h":24,"w":24,"x":523,"y":193}]}},"id_str":"2122592477094031360","indices":[87,110],"media_key":"3_2122592477094031360","media_results":{"result":{"media_key":"3_2122592477094031360"}},"media_url_https":"https://pbs.twimg.com/media/HXT2nKgbMAA99b3.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":995,"y":0},{"h":1734,"w":867,"x":1322,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/dtuy5SRqNq"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/dtuy5SRqNq","expanded_url":"https://x.com/takaichi_sanae/status/2122592985649176886/photo/4","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":89,"w":89,"x":405,"y":1147}]},"medium":{"faces":[{"h":52,"w":52,"x":237,"y":672}]},"orig":{"faces":[{"h":114,"w":114,"x":515,"y":1457}]},"small":{"faces":[{"h":29,"w":29,"x":134,"y":381}]}},"id_str":"2122592536300802048","indices":[87,110],"media_key":"3_2122592536300802048","media_results":{"result":{"media_key":"3_2122592536300802048"}},"media_url_https":"https://pbs.twimg.com/media/HXT2qnEa0AAZwAn.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":278},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":152,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/dtuy5SRqNq"}]},"favorite_count":16015,"favorited":false,"full_text":"フィリピン・マニラに到着して2日目の本日午前は、一連のASEAN関連首脳会議に参加しました。\n\n＜ASEAN+3（日中韓）首脳会議＞\n日本は、日中韓側の調整国を務めました。 https://t.co/dtuy5SRqNq","id_str":"2122592985649176886","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":103,"reply_count":711,"retweet_count":1586,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjI1OTI5ODU1MzU4ODEyMTg=","richtext":{"richtext_tags":[]},"text":"フィリピン・マニラに到着して2日目の本日午前は、一連のASEAN関連首脳会議に参加しました。\n\n＜ASEAN+3（日中韓）首脳会議＞\n日本は、日中韓側の調整国を務めました。\n金融協力や緊急米の備蓄といった、緊急時のセーフティーネット構築を中心とした枠組みであるこの会議では、私から、日本の実務協力の貢献及び防災や組織犯罪対策を始めとした未来志向の協力の深化について申し上げました。\n会議の成果として、海上貿易・連結性及びエネルギー・食料安全保障に関する首脳共同声明が発出されました。\n\n＜アジア・ゼロエミッション共同体（AZEC）首脳会合＞\n日本は、共同議長を務めました。\nエネルギー安全保障、経済成長、脱炭素の同時実現を掲げるAZECに、経済・エネルギー強靱化の視点を強化し、「AZEC2.0」へ進化させることを確認する共同声明を発出しました。\nこの声明には、「パワー・アジア」の強化も盛り込み、「パワー・ガルフ」でも提唱している、産油国とアジアの消費国とのエネルギー連携拡大も打ち出しました。\nサプライチェーンを含めた「経済強靱化」のニーズに応え、グローバルな危機管理投資の促進につなげてまいります。\n\n＜日ASEAN首脳会議＞\n日本は、共同議長を務めました。\n日本とASEANの協力の着実な進展を踏まえ、双方の関心が高い新興経済分野での協力を推進し、未来への投資を加速させるべく、日ASEAN首脳共同声明を発出して、連携を確認しました。\n私から、地域の平和と繁栄へ貢献してきた我が国の姿勢を改めて強調しつつ、ASEANと共に歩み続けるとの決意を表明しました。\n\n＜日メコン首脳会議＞\n日本は、共同議長を務めました。\nメコン地域における連結性強化や組織的犯罪を含む越境課題について、協力の進捗・方向性を議論し、共同議長声明を発出しました。\nまた、ミャンマー情勢やカンボジア・タイ国境問題に係る日本の立場を伝達しました。\n日本はメコン諸国と共に、具体的課題に取り組んでまいります。\n\n本日午後も、各国首脳と活発に議論していきます。"}}},"rest_id":"2122592985649176886","unmention_data":{},"views":{"count":"395503","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122592985649176886","sortIndex":"2122682497434124231"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2122682497434124346-tweet-2117172619820884128","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":9},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"公正取引委員会の公式アカウントです。 \n公正かつ自由な競争について理解を深めていただくため、措置命令等の報道発表、関係法令（独占禁止法、取適法、フリーランス法、スマホ法等）の解説、イベント・採用情報等をお届けします。 \n#独占禁止法 #取適法 #スマホ法 #フリーランス法","entities":{"description":{},"url":{"urls":[{"display_url":"jftc.go.jp/index.html","expanded_url":"http://www.jftc.go.jp/index.html","indices":[0,23],"url":"https://t.co/izoLg0k5lW"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":100578,"following":36},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2455900080","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4172,"tweets":6483},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/izoLg0k5lW"}}}},"edit_control":{"edit_tweet_ids":["2117172619820884128"],"editable_until_msecs":"1793611862000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":true},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2117172619820884128","created_at":"Mon Nov 02 08:31:02 +0000 2026","display_text_range":[0,151],"entities":{"media":[{"display_url":"pic.x.com/4bbodE9Q9E","expanded_url":"https://x.com/jftc/status/2117172619820884128/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":205,"w":205,"x":933,"y":759}]},"medium":{"faces":[{"h":120,"w":120,"x":546,"y":445}]},"orig":{"faces":[{"h":239,"w":239,"x":1086,"y":884}]},"small":{"faces":[{"h":68,"w":68,"x":310,"y":252}]}},"id_str":"2117172585658286080","indices":[152,175],"media_key":"3_2117172585658286080","media_results":{"result":{"media_key":"3_2117172585658286080"}},"media