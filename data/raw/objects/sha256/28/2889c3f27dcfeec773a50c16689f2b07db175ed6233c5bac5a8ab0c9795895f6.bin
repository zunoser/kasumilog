]}}]},"favorite_count":37,"favorited":false,"full_text":"【#令和8年8月千葉豪雨 対応】#TECFORCE（緊急災害対策派遣隊）及び #TECFORCEﾊﾟｰﾄﾅｰ を派遣中です。千葉豪雨から２週間が経過し、＃関東地方整備局 の取り組みをスライドでまとめました。県道生実本納線（旧千葉外房有料道路）の早期通行止め解除に向け引き続き支援します！\n\n#国土交通省 https://t.co/0kStTF5zVH","id_str":"2094235083326861458","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":10,"retweeted":false,"user_id_str":"714372536490852352"},"rest_id":"2094235083326861458","source":"<a href=\"http://twitter.com/download/android\" rel=\"nofollow\">Twitter for Android</a>","unmention_data":{},"views":{"count":"2698","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2094255079167852832","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"512","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094255079167852832","sortIndex":"2094298180119166948"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/WpqQdmAdQH"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":8},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"公正取引委員会の公式アカウントです。 \n公正かつ自由な競争について理解を深めていただくため、措置命令等の報道発表、関係法令（独占禁止法、取適法、フリーランス法、スマホ法等）の解説、イベント・採用情報等をお届けします。 \n#独占禁止法 #取適法 #スマホ法 #フリーランス法","entities":{"description":{},"url":{"urls":[{"display_url":"jftc.go.jp/index.html","expanded_url":"http://www.jftc.go.jp/index.html","indices":[0,23],"url":"https://t.co/izoLg0k5lW"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":99656,"following":34},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2455900080","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":4053,"tweets":6319},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/izoLg0k5lW"}}}},"edit_control":{"edit_tweet_ids":["2094251906034209035"],"editable_until_msecs":"1788147138000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2094251906034209035","created_at":"Mon Aug 31 02:32:18 +0000 2026","display_text_range":[0,158],"entities":{"hashtags":[{"indices":[149,152],"text":"予算"},{"indices":[153,158],"text":"概算要求"}],"urls":[{"display_url":"jftc.go.jp/houdou/pressre…","expanded_url":"https://www.jftc.go.jp/houdou/pressrelease/2026/aug/260831gaiisanyokyu.html","indices":[125,148],"url":"https://t.co/WpqQdmAdQH"}]},"favorite_count":11,"favorited":false,"full_text":"【令和9年度概算要求】\n令和9年度予算の概算要求総額は、148億5千5百万円です。\n公正かつ自由な競争による経済の活性化と消費者利益の増進を図るとともに、イノベーションの促進に向けた競争政策の積極的展開のための予算を要求しています。\n詳細はこちら▽\nhttps://t.co/WpqQdmAdQH\n#予算 #概算要求","id_str":"2094251906034209035","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":8,"retweeted":false,"user_id_str":"2455900080"},"rest_id":"2094251906034209035","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2001","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094251906034209035","sortIndex":"2094298180119166947"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府の公式アカウントです。内閣府大臣官房政策評価広報課が運営しています。運営方針 https://t.co/LtXxYQ4rJ