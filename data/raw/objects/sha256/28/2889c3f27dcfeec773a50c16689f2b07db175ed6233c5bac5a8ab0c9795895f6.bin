t":2313,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTMyNzk3MjQwNTEwMzgyMDg=","richtext":{"richtext_tags":[]},"text":"本日、チームみらいの安野党首ほか、「チームみらい」の皆様が官邸を訪ねて下さり、「AI家庭教師」をしてくださいました。\n\n安野党首のレクチャーのもと、政府が2026年に実施した物価高対策について、家庭ごとの個別の状況を入力してどれくらいの金額効果があるかを試算できる、「物価高対策のシミュレーター」をAIで作成しました。\nAIを使ってアプリを作成することは初めてでしたが、音声入力により、簡単に作成することができました。\n\nまた、チームみらいの皆様から、「AIインタビュー」の実施をはじめとした、政治におけるAIの活用事例を紹介いただきました。\n\n現在、政府においても、政府職員18万人を対象に、ガバメントAI「源内」の積極的な活用を進めています。\n政府自ら率先してAIの利活用を進め、行政サービスの高度化と行政運営の効率化につなげてまいります。"}}},"rest_id":"2093279724118200396","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1698645","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093279724118200396","sortIndex":"2094298180119166890"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1674231387166220288/iK7GwtIr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/180585090/1680484704"},"core":{"created_at":"Fri Aug 20 00:19:17 +0000 2010","name":"厚生労働省","screen_name":"MHLWitter"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODA1ODUwOTA=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifica