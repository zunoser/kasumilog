"https://t.co/wBzrJ8ehrX"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1093,"following":12},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1853694958383050752","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":140,"tweets":316},"verification":{"verified":false},"website":{"url":"https://t.co/wBzrJ8ehrX"}}}},"edit_control":{"edit_tweet_ids":["2094283284545155425"],"editable_until_msecs":"1788154619000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"kyoseikyojo_cao"}}},"policy":"ByInvitation"},"conversation_id_str":"2088165569896075765","created_at":"Mon Aug 31 04:36:59 +0000 2026","display_text_range":[0,147],"entities":{"hashtags":[{"indices":[0,5],"text":"手話の日"},{"indices":[23,34],"text":"手話ふれあいフェスタ"},{"indices":[120,125],"text":"手話の日"}],"media":[{"display_url":"pic.x.com/MvVuOFONWa","expanded_url":"https://x.com/kyoseikyojo_cao/status/2094283284545155425/photo/1","ext_alt_text":"内閣府が主催する「手話ふれあいフェスタオンラインシンポジウム」の告知チラシ。９月23日（水）に「手話ふれあいフェスタオンラインシンポジウム」を開催。参加無料で、YouTube（https://x.gd/NssQs）にてライブ配信（12:30オープン、13:00スタート）。「手話のある風景を、日常へ」をテーマに、NHK手話ニュースキャスター兼私立明晴学園校長のおのこうすけ氏による司会進行の下、講演やパネルディスカッション等を実施。プログラムは、①開会挨拶、②歌手のこばやしさちこ氏によるビデオメッセージ、③全日本ろうあ連盟本部事務所長・元デフリンピック運営委員会事務局長のくらのなおき氏による基調報告（タイトル：共生社会への第一歩-デフリンピックが広げた手話言語と理解の輪-）、④NPO法人インフォメーションギャップバスター理事長のいとうよしひろ氏による基調講演（タイトル：手話が『ある』日常へ―きこえる人ときこえない人が、同じ景色を楽しむために）、⑤株式会社アイシンのなかむらまさき氏によるミニ講演⑴（タイトル：ユーザーと共にYYSystemを創る）、⑥Land Heyのひらしまもね氏といとうよしひろ氏の対談を行うミニ講演⑵、⑦株式会社CSLI代表取締役・コンサート手話通訳者のはせがわえみり氏によるミニ講演⑶（タイトル：コンサート手話通訳-誰もが一緒に楽しめる場をつくるために-）、⑧一般社団法人MUSICA ARCHE代表理事のSasa-Marie（はぎわらまさこ）氏、手話アーティストのにしわきしょうご氏、「となりのきのこ」代表・舞台手話通訳者のたなかゆか氏、俳優のいまいあきと氏の4名をパネラーに迎え、コーディネーターであるいとうよしひろ氏を交えたパネルディスカッション、⑨いとうよしひろ氏による閉会の挨拶・講評の全９プログラムから構成。問い合わせ先情報は次のとおりです。運営事務局：株式会社アカンパニーテクノロジーズ、電話番号：050-5810-4152、FAX：03-4496-4822、メール：event_info@e-webinar.net、お問合せフォーム：https://x.gd/cHP4b。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":195,"w":195,"x":169,"y":151}]},"medium":{"faces":[{"h":114,"w":114,"x":99,"y":88}]},"orig":{"faces":[{"h":335,"w":335,"x":291,"y":260}]},"small":{"faces":[{"h":64,"w":64,"x":56,"y":50}]}},"id_str":"2094279488482037760","indices":[148,171],"media_key":"3_2094279488482037760","media_results":{"result":{"media_key":"3_2094279488482037760"}},"media_url_https":"https://pbs.twimg.com/media/HRBgGUtb0AAVkyF.jpg","original_info":{"focus_rects":[{"h":1389,"w":2480,"x":0,"y":446},{"h":2480,"w":2480,"x":0,"y":0},{"h":2827,"w":2480,"x":0,"y":0},{"h":3508,"w":1754,"x":0,"y":0},{"h":3508,"w":2480,"x":0,"y":0}],"height":3508,"width":2480},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MvVuOFONWa"},{"display_url":"pic.x.com/MvVuOFONWa","expanded_url":"https://x.com/kyoseikyojo_cao/status/2094283284545155425/photo/1","ext_alt_text":"手話ふれあいフェスタオンラインシンポジウムの登壇者プロフィール。総合司会：おのこうすけ（日本手話と書記日本語によるバイリンガルろう教育を目指し、龍の子学園の創設、明晴学園開校に尽力）。ビデオメッセージ：こばやしさちこ（1964年10歳でデビュー。現在、NHK-Eテレ「みんなの手話」にてキャラクターの声を担当）。基調報告：くらのなおき（全日本ろうあ連盟理事やデフリンピック準備室事務局長を経て2023年7月から2026年3月までデフリンピック運営委員会事務局長を務め、東京2025デフリンピックの招致や準備運営に深く携わる。）。基調講演：いとうよしひろ（情報バリアをなくすNPOを設立、代表を務める。現在は情報アクセシビリティ、ビジネスと人権の啓発活動が中心）。ミニ講演①：なかむらまさき（2015年より音声認識やナレッジデータベースの研究開発に従事。コロナ禍で聴覚障害者との出会いを契機に「意思疎通支援システムYYSystem」の開発を推進）。ミニ講演②：ひらしまもね（姉妹で「Land Hey」として手話を広める活動を続け、デフサッカー応援サポーターとしても活動。ろう者として初めてミス日本ミス着物を受賞）。ミニ講演③：はせがわえみり（2013年より「誰もが一緒に楽しめる場」を目指し、コンサート手話通訳の活動を開始。現在は「コンサート・イベント体験翻訳設計」を専門に、企業・行政等と連携しながらアクセシビリティの実現に取り組む。）。パネラー：Sasa-Marie（はぎわらまさこ）（令和6年度文化庁新進芸術家海外研修で英国・カナダにて、ろう者と音楽、Deaf-Ledによる文化芸術振興をリサーチ）。パネラー：にしわきしょうご（2023年にデフアクターズ・コース修了。多様な団体やプロジェクトに携わる傍ら、NHK「手話で楽しむみんなのテレビ」「みんなの手話」等のメディアや公演に出演中）。パネラー：たなかゆか（2023年に「となりのきのこ」を立ち上げる。舞台手話通訳機関「THEATRESIGN」にて研修を受講し、これまでに3 0作品以上の舞台手話通訳を担当）。パネラー：いまいあきと（2009年日本ろう者劇団に入団、翌年『エレファントマン』(2010）で初主演・俳優デビュー。主な出演作に、おみぽ監督『ぼくが生きてる、ふたつの世界』(2024)、いまいミカ監督『黄色い子』(2025)など)。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":73,"w":73,"x":555,"y":493},{"h":77,"w":77,"x":529,"y":791},{"h":79,"w":79,"x":543,"y":1111},{"h":79,"w":79,"x":1147,"y":1417},{"h":77,"w":77,"x":543,"y":1715},{"h":87,"w":87,"x":519,"y":183},{"h":87,"w":87,"x":1157,"y":484},{"h":123,"w":123,"x":775,"y":1363},{"h":125,"w":125,"x":787,"y":1664},{"h":499,"w":499,"x":45,"y":857},{"h":621,"w":621,"x":595,"y":813}]},"medium":{"faces":[{"h":43,"w":43,"x":325,"y":289},{"h":45,"w":45,"x":310,"y":463},{"h":46,"w":46,"x":318,"y":651},{"h":46,"w":46,"x":672,"y":830},{"h":45,"w":45,"x":318,"y":1004},{"h":51,"w":51,"x":304,"y":107},{"h":51,"w":51,"x":678,"y":283},{"h":72,"w":72,"x":454,"y":798},{"h":73,"w":73,"x":461,"y":974},{"h":292,"w":292,"x":26,"y":502},{"h":364,"w":364,"x":348,"y":476}]},"orig":{"faces":[{"h":126,"w":126,"x":952,"y":846},{"h":133,"w":133,"x":907,"y":1356},{"h":137,"w":137,"x":931,"y":1904},{"h":137,"w":137,"x":1966,"y":2428},{"h":133,"w":133,"x":931,"y":2939},{"h":150,"w":150,"x":890,"y":315},{"h":150,"w":150,"x":1983,"y":829},{"h":212,"w":212,"x":1329,"y":2336},{"h":215,"w":215,"x":1349,"y":2850},{"h":856,"w":856,"x":78,"y":1469},{"h":1065,"w":1065,"x":1020,"y":1394}]},"small":{"faces":[{"h":24,"w":24,"x":184,"y":164},{"h":25,"w":25,"x":175,"y":262},{"h":26,"w":26,"x":180,"y":369},{"h":26,"w":26,"x":381,"y":470},{"h":25,"w":25,"x":180,"y":570},{"h":29,"w":29,"x":172,"y":61},{"h":29,"w":29,"x":384,"y":160},{"h":41,"w":41,"x":257,"y":453},{"h":41,"w":41,"x":261,"y":552},{"h":166,"w":166,"x":15,"y":284},{"h":206,"w":206,"x":197,"y":270}]}},"id_str":"2094275127580254208","indices":[148,171],"media_key":"3_2094275127580254208","media_results":{"result":{"media_key":"3_2094275127580254208"}},"media_url_https":"https://pbs.twimg.com/media/HRBcIfFbYAAWSxQ.jpg","original_info":{"focus_rects":[{"h":1389,"w":2480,"x":0,"y":2024},{"h":2480,"w":2480,"x":0,"y":1028},{"h":2827,"w":2480,"x":0,"y":681},{"h":3508,"w":1754,"x":726,"y":0},{"h":3508,"w":2480,"x":0,"y":0}],"height":3508,"width":2480},"sizes":{"large":{"h":2048,"resize":"fit","w":1448},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":481},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MvVuOFONWa"}],"urls":[{"display_url":"x.gd/NssQs","expanded_url":"https://x.gd/NssQs","indices":[90,113],"url":"https://t.co/LLVEBQnMn8"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/MvVuOFONWa","expanded_url":"https://x.com/kyoseikyojo_cao/status/2094283284545155425/photo/1","ext_alt_text":"内閣府が主催する「手話ふれあいフェスタオンラインシンポジウム」の告知チラシ。９月23日（水）に「手話ふれあいフェスタオンラインシンポジウム」を開催。参加無料で、YouTube（https://x.gd/NssQs）にてライブ配信（12:30オープン、13:00スタート）。「手話のある風景を、日常へ」をテーマに、NHK手話ニュースキャスター兼私立明晴学園校長のおのこうすけ氏による司会進行の下、講演やパネルディスカッション等を実施。プログラムは、①開会挨拶、②歌手のこばやしさちこ氏によるビデオメッセージ、③全日本ろうあ連盟本部事務所長・元デフリンピック運営委員会事務局長のくらのなおき氏による基調報告（タイトル：共生社会への第一歩-デフリンピックが広げた手話言語と理解の輪-）、④NPO法人インフォメーションギャップバスター理事長のいとうよしひろ氏による基調講演（タイトル：手話が『ある』日常へ―きこえる人ときこえない人が、同じ景色を楽しむために）、⑤株式会社アイシンのなかむらまさき氏によるミニ講演⑴（タイトル：ユーザーと共にYYSystemを創る）、⑥Land Heyのひらしまもね氏といとうよしひろ氏の対談を行うミニ講演⑵、⑦株式会社CSLI代表取締役・コンサート手話通訳者のはせがわえみり氏によるミニ講演⑶（タイトル：コンサート手話通訳-誰もが一緒に楽しめる場をつくるために-）、⑧一般社団法人MUSICA ARCHE代表理事のSasa-Marie（はぎわらまさこ）氏、手話アーティストのにしわきしょうご氏、「となりのきのこ」代表・舞台手話通訳者のたなかゆか氏、俳優のいまいあきと氏の4名をパネラーに迎え、コーディネーターであるいとうよしひろ氏を交えたパネルディスカッション、⑨いとうよしひろ氏による閉会の挨拶・講評の全９プログラムから構成。問い合わせ先情報は次のとおりです。運営事務局：株式会社アカンパニーテクノロジーズ、電話番号：050-5810-4152、FAX：03-4496-4822、メール：event_info@e-webinar.net、お問合せフォーム：https://x.gd/cHP4b。","ext_media_availability":{