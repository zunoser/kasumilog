00","indices":[118,141],"media_key":"3_2093285193146880000","media_results":{"result":{"media_key":"3_2093285193146880000"}},"media_url_https":"https://pbs.twimg.com/media/HQzXyt8a0AABNaO.jpg","original_info":{"focus_rects":[{"h":660,"w":1179,"x":3,"y":0},{"h":660,"w":660,"x":407,"y":0},{"h":660,"w":579,"x":448,"y":0},{"h":660,"w":330,"x":572,"y":0},{"h":660,"w":1182,"x":0,"y":0}],"height":660,"width":1182},"sizes":{"large":{"h":660,"resize":"fit","w":1182},"medium":{"h":660,"resize":"fit","w":1182},"small":{"h":380,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Xj8i2uIh1Q"}]},"favorite_count":77,"favorited":false,"full_text":"令和8年熊本地震の影響により、JR九州鹿児島本線（宇土～八代間）で運休が発生しています。\nJR九州では、宇土～八代間で実施している代行バス輸送について、新学期に対応するため9/1より運行本数の増便および一部の便の時刻変更を実施します。 https://t.co/Xj8i2uIh1Q","id_str":"2093285198217842855","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":41,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"jrkyushu.co.jp","expanded_url":"https://www.jrkyushu.co.jp/","indices":[222,245],"url":"https://t.co/SOfn4Ugt5f"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTMyODUxOTgxNjMzMjQ5Mjg=","richtext":{"richtext_tags":[]},"text":"令和8年熊本地震の影響により、JR九州鹿児島本線（宇土～八代間）で運休が発生しています。\nJR九州では、宇土～八代間で実施している代行バス輸送について、新学期に対応するため9/1より運行本数の増便および一部の便の時刻変更を実施します。\nなお、JR九州では、利用状況や利用者の皆様からのご要望を踏まえ、バス事業者の協力のもと、必要に応じて代行バスの運行ダイヤの見直しを行うこととしております。詳細はJR九州のHPをご確認ください。\n\n▼JR九州\nhttps://t.co/SOfn4Ugt5f"}}},"rest_id":"2093285198217842855","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"12569","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093285198217842855","sortIndex":"2094298180119166895"},{"content":{"__typename":"TimelineTimelineItem"