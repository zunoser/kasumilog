expanded_url":"https://www.mofa.go.jp/mofaj/press/kaiken/kaikenw_000001_00250.html","indices":[233,256],"url":"https://t.co/mLw7upOWLl"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTMyNzE1ODIzNDUyNDA1NzY=","richtext":{"richtext_tags":[]},"text":"茂木外務大臣の記者会見が行われ、ネパール・中国における洪水被害、トルクメニスタン、スロバキア、オーストリア及びモンゴル訪問に関する冒頭発言を行った他、ネパール・中国における洪水被害、イラン情勢、米国による国際刑事裁判所（ＩＣＣ）赤根所長への制裁、包括的核実験禁止条約（ＣＴＢＴ）、サウジアラビア・オマーンに対する危険情報、中国における邦人の拘束事案に関する質疑応答を行いました。\nhttps://t.co/z6XDrBhsU2\n\n会見記録はこちらをご確認ください。\nhttps://t.co/mLw7upOWLl"}}},"rest_id":"2093271582466822355","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"29789","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093271582466822355","sortIndex":"2094298180119166882"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHRBxGUfAJxEKAAIdEHB5J9uABQgAAwAAAAEAAA"},"entryId":"cursor-top-2094298180119166977","sortIndex":"2094298180119166977"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHRBxGUe__58KAAIdDMtp41rQ0wgAAwAAAAIAAA"},"entryId":"cursor-bottom-2094298180119166881","sortIndex":"2094298180119166881"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}