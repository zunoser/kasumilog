_by":false,"super_following":false,"tweet_counts":{"media_tweets":7924,"tweets":88249},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/yYaoVyKjKO"}}}},"edit_control":{"edit_tweet_ids":["2093801508299239527"],"editable_until_msecs":"1788039755000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2093801508299239527","created_at":"Sat Aug 29 20:42:35 +0000 2026","display_text_range":[0,130],"entities":{},"favorite_count":118,"favorited":false,"full_text":"令和8年8月29日からの大雨について、大臣指示を行いました。\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、被害が発生した場合は、人命第一の方針の下、災害応急対策に全力で取り組むこと。","id_str":"2093801508299239527","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":6,"retweet_count":39,"retweeted":false,"user_id_str":"571429134"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTM4MDE1MDgyNjE1MzE2NDg=","richtext":{"richtext_tags":[]},"text":"令和8年8月29日からの大雨について、大臣指示を行いました。\n１．地方自治体とも緊密に連携し、早急に被害状況を把握し、国民に対し、避難や大雨等に関する情報提供を適時的確に行うとともに、被害が発生した場合は、人命第一の方針の下、災害応急対策に全力で取り組むこと。\n\n２．地方自治体とのホットライン等を通じて情報を収集\nし、要請に応じて迅速に地方自治体への支援等を実施すること。"}}},"rest_id":"2093801508299239527","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"39013","state":"EnabledWithCount"}}}}},"entryId":"tweet-2093801508299239527","sortIndex":"2094298180119166917"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typena