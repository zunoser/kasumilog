:"2092185929167638844","created_at":"Tue Aug 25 09:42:51 +0000 2026","display_text_range":[0,149],"entities":{},"favorite_count":5,"favorited":false,"full_text":"ALPS 処理水の海洋放出開始から丸3 年が経過し、４年目を迎えた8 月24 日、「ALPS 処理水の処分に関する基本方針の着実な実行に向けた関係閣僚等会議」を持ち回りで開催しました。会議では、改めて、「政府としてALPS 処理水の処分が完了するまで全責任を持って取り組む」との方針を確認しました。","id_str":"2092185929167638844","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":1,"retweet_count":1,"retweeted":false,"user_id_str":"266566401"},"rest_id":"2092185929167638844","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1297","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2092188275757285379-tweet-2092185931688399219","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#