/vid/avc1/1920x1080/gX6vascAIz-82cxS.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/vq4RuMcvYG","expanded_url":"https://x.com/ModJapan_saigai/status/2091898689958895833/video/1","ext_media_availability":{"status":"Available"},"id_str":"2091889740845023232","indices":[65,88],"media_key":"13_2091889740845023232","media_results":{"result":{"media_key":"13_2091889740845023232"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2091889740845023232/img/niS6-76-ZEdm3hTe.jpg","original_info":{"focus_rects":[],"height":1080,"width":1920},"sizes":{"large":{"h":1080,"resize":"fit","w":1920},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/vq4RuMcvYG","video_info":{"aspect_ratio":[16,9],"duration_millis":88133,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2091889740845023232/pl/imZG4L70ybuR5OQ1.m3u8?tag=29&v=0b3"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2091889740845023232/vid/avc1/480x270/081YE4ca3M8ctBJu.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2091889740845023232/vid/avc1/640x360/k-LFNKYHLDXzAQ32.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2091889740845023232/vid/avc1/1280x720/N8g799cLLI-2f6iA.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2091889740845023232/vid/avc1/1920x1080/gX6vascAIz-82cxS.mp4?tag=29"}]}}]},"favorite_count":2684,"favorited":false,"full_text":"昨日（23日）、小泉防衛大臣は熊本県内の被災地を訪れ、令和8年熊本地震に伴う災害派遣活動にあたる自衛隊部隊を視察・激励しました。 https://t.co/vq4RuMcvYG","id_str":"2091898689958895833","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":27,"reply_count":24,"retweet_count":461,"retweeted":false,"user_id_str":"1182556649120075776"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTE4OTg2ODk5MDQzOTgzMzY=","richtext":{"richtext_tags":[]},"text":"昨日（23日）、小泉防衛大臣は熊本県内の被災地を訪れ、令和8年熊本地震に伴う災害派遣活動にあたる自衛隊部隊を視察・激励しました。\n\n人命救助を行った「イオンモール熊本」と「日本製紙八代工場」、入浴支援などを行っている避難所や海上自衛隊の艦艇を訪れ、厳しい暑さの中、熱中症対策を徹底しながら活動する隊員を激励しました。\n\nまた、防衛省が借り上げている民間船舶「はくおうⅡ」による入浴支援や宿泊支援の状況などを確認しました。\n\nさらに、熊本県庁で木村知事と意見交換を行ったほか、熊本県災害対策本部や政府現地対策本部を訪問し、災害対応にあたる職員を激励しました。木村知事からは、自衛隊の活動に対する感謝のお言葉をいただきました。\n\n防衛省・自衛隊は、引き続き関係機関と緊密に連携し、被災された皆さまへの支援に全力で取り組んでまいります。"}}},"rest_id":"2091898689958895833","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"699718","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2092037445605027888","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"3892","state":"EnabledWithCount"}}}}},"entryId":"tweet-2092037445605027888","sortIndex":"2092188275757285291"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":20},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2011671787697029123/GbiAhFPe_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2916368839/1785238079"},"core":{"created_at