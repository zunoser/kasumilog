TUと協力し、信頼できる情報通信基盤の発展及び国際的な電気通信の発展に貢献していきます。","id_str":"2122161568041635974","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":2,"retweet_count":7,"retweeted":false,"user_id_str":"1469058582"},"rest_id":"2122161568041635974","unmention_data":{},"views":{"count":"6757","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2122426767493824599-tweet-2122161569710952834","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2119064743134846976/tiGLa7O0?format=jpg&name=120x120","width":120},"type":"IMAGE"}},{"key":"description","value":{"string_value":"　2026年11月9日から27日までの日程でカタール（ドーハ）にて開催されている国際電気通信連合（ITU）全権委員会議において、現地時間11月13日、次期電気通信標準化局長選挙が行われ、我が国から立候補した現職の尾上　誠蔵（おのえ せいぞう）電気通信標準化局長が再選されました。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.soumu.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2119064743134846976/tiGLa7O0?format=jpg&name=120x120","width":120},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/2119064743134846976/tiGLa7O0?format=jpg&name=orig","width":120},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"1469058582","path":[]}}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2119064743134846976/tiGLa7O0?format=jpg&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":120,"url":"https://pbs.twimg.com/card_img/211906474