esize":"fit","w":1200},"small":{"h":510,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/OIkP4BXc2p"}]},"favorite_count":42,"favorited":false,"full_text":"赤澤大臣は、アジア開発銀行の神田総裁と会談。\n原子力協力に関する協力覚書に加え、ERIA（東アジア・アセアン経済研究センター）の渡辺総長ご同席の下、三者間のトランジション・ファイナンスに関する協力覚書の署名式も執り行いました。 https://t.co/OIkP4BXc2p","id_str":"2122338813397889253","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":7,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[222,234],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIzMzg4MTMzNDMzMzQ0MDA=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、アジア開発銀行の神田総裁と会談。\n原子力協力に関する協力覚書に加え、ERIA（東アジア・アセアン経済研究センター）の渡辺総長ご同席の下、三者間のトランジション・ファイナンスに関する協力覚書の署名式も執り行いました。\nアジア各国がエネルギー安全保障を確保しつつ現実的なエネルギー移行を進めていく上で、アジア開発銀行の役割は非常に重要です。今後、同行との協力を深めていくべく、「パワー・アジア」における連携も含め様々な議論を行いました。#meti_daijin"}}},"rest_id":"2122338813397889253","unmention_data":{},"views":{"count":"4402","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122338813397889253","sortIndex":"2122426767493824512"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{