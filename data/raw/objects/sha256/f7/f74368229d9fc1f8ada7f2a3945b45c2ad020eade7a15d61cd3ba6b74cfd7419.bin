6年）7月に改正されました。政府広報提供ラジオ「杉浦太陽・松井玲奈　日曜まなびより」では、法改正の三つの大きなポイント、飲酒運転や高速度運転への新たな数値基準の導入、新たに危険運転致死傷罪の対象となった危険な運転行為について詳しくご紹介します。","type":"STRING"}},{"key":"domain","value":{"string_value":"www.gov-online.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":320,"url":"https://pbs.twimg.com/card_img/2122221364740608000/tMmnSZAu?format=jpg&name=800x320_1","width":569},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2122221364740608000/tMmnSZAu?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":540,"url":"https://pbs.twimg.com/card_img/2122221364740608000/tMmnSZAu?format=jpg&name=orig","width":960},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"461064204","path":[]}}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2122221364740608000/tMmnSZAu?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"summary_photo_image_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2122221364740608000/tMmnSZAu?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":81,"url":"https://pbs.twimg.com/card_img/2122221364740608000/tMmnSZAu?format=jpg&name=144x144","width":144},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":540,"url":"https://pbs.twimg.com/card_img/2122221364740608000/tMmnSZAu?format=png&name=2048x2048_2_exp","width":960},"type":"IMAGE"}},{"key":"photo_image_full_size_original","value":{"image_value":{"height":540,"url":"https://pbs.twimg.com/card_img/2122221364740608000/tMmnSZAu?format=jpg&name=orig","width":960},"type":"IMAGE"}},{"key":"vanity_url","value":{"scribe_key":"vanity_url","string_value":"gov-online.go.jp","type":"STRING"}},{"key"