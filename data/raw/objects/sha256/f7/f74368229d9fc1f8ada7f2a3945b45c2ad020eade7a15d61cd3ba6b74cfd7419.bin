b":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/j9ylsvL62F"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/j9ylsvL62F","expanded_url":"https://x.com/ModJapan_jp/status/2122216237765902629/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":176,"w":176,"x":610,"y":374},{"h":216,"w":216,"x":1208,"y":192}]},"medium":{"faces":[{"h":103,"w":103,"x":357,"y":219},{"h":126,"w":126,"x":707,"y":112}]},"orig":{"faces":[{"h":176,"w":176,"x":610,"y":374},{"h":216,"w":216,"x":1208,"y":192}]},"small":{"faces":[{"h":58,"w":58,"x":202,"y":124},{"h":71,"w":71,"x":401,"y":63}]}},"id_str":"2122216228312014848","indices":[101,124],"media_key":"3_2122216228312014848","media_results":{"result":{"media_key":"3_2122216228312014848"}},"media_url_https":"https://pbs.twimg.com/media/HXOgamkbYAAKd8m.jpg","original_info":{"focus_rects":[{"h":1147,"w":2048,"x":0,"y":0},{"h":1366,"w":1366,"x":597,"y":0},{"h":1366,"w":1198,"x":681,"y":0},{"h":1366,"w":683,"x":939,"y":0},{"h":1366,"w":2048,"x":0,"y":0}],"height":1366,"width":2048},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/j9ylsvL62F"}]},"favorite_count":342,"favorited":false,"full_text":"11月12日、こやり防衛副大臣は、スペインのバルカルセ国防長官と会談を行いました。\n\n日本とスペインの間では、EUの枠組みの下で海賊対処共同訓練を実施するなど、実践的な防衛協力が着実に進展しています。 https://t.co/j9ylsvL62F","id_str":"2122216237765902629","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":12,"retweet_count":35,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIyMTYyMzc3MTU2NjA4MDA=","text":"11月12日、こやり防衛副大臣は、スペインのバルカルセ国防長官と会談を行いました。\n\n日本とスペインの間では、EUの枠組みの下で海賊対処共同訓練を実施するなど、実践的な防衛協力が着実に進展しています。\n\n会談では、欧州・大西洋とインド太平洋の安全保障は不可分であるとの認識を共有し、地域情勢や防衛政策などについて意見交換を行いました。\n\nまた、日スペイン防衛協力・交流を更に発展させていくことを確認しました🇯🇵🇪🇸"}}},"rest_id":"2122216237765902629","unmention_data":{},"views":{"count":"23512","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122216237765902629","sortIndex":"2122426767493824450"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/996639601262452736/4RIAr7j3_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2904127170/1526452282"},"core":{"created_at":"Wed Nov 19 05:03:34 +0000 2014","name":"内閣府","screen_name":"cao_japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTA0MTI3MTcw","is_blue_verified":false,"location":{"location":"〒100-8914 東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2121135978303611239"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"内閣府の公式アカウントです。内閣府大臣官房政策評価広報課が運営しています。運営方針 https://t.co/LtXxYQ4rJW を御確認のうえ御利用ください。問い合わせは https://t.co/ANlK6wet0H","entities":{"description":{"urls":[{"display_url":"cao.go.jp/others/seihyou…","expanded_url":"https://www.cao.go.jp/others/seihyou/sns/x.html","indices":[42,65],"url":"https://t.co/LtXxYQ4rJW"},{"display_url":"cao.go.jp/goiken.html","expanded_url":"htt