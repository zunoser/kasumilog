"pic.x.com/J1aVfhsk0S","expanded_url":"https://x.com/takaichi_sanae/status/2122335387280675303/photo/4","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":69,"w":69,"x":693,"y":1107},{"h":93,"w":93,"x":1263,"y":327},{"h":103,"w":103,"x":975,"y":256},{"h":107,"w":107,"x":581,"y":283}]},"medium":{"faces":[{"h":40,"w":40,"x":406,"y":648},{"h":54,"w":54,"x":740,"y":192},{"h":60,"w":60,"x":571,"y":150},{"h":63,"w":63,"x":340,"y":166}]},"orig":{"faces":[{"h":88,"w":88,"x":881,"y":1406},{"h":119,"w":119,"x":1604,"y":416},{"h":132,"w":132,"x":1239,"y":325},{"h":137,"w":137,"x":738,"y":360}]},"small":{"faces":[{"h":23,"w":23,"x":230,"y":367},{"h":31,"w":31,"x":419,"y":108},{"h":34,"w":34,"x":324,"y":85},{"h":35,"w":35,"x":193,"y":94}]}},"id_str":"2122335313603571712","indices":[73,96],"media_key":"3_2122335313603571712","media_results":{"result":{"media_key":"3_2122335313603571712"}},"media_url_https":"https://pbs.twimg.com/media/HXQMuR2bsAAYrkk.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/J1aVfhsk0S"}]},"favorite_count":5661,"favorited":false,"full_text":"ASEAN関連首脳会議に出席するため、フィリピン・マニラに到着しました。\n\n初日となる本日は、フィリピンのマルコス大統領と首脳会談を行いました。 https://t.co/J1aVfhsk0S","id_str":"2122335387280675303","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":45,"reply_count":314,"retweet_count":598,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIzMzUzODcyMTM1MzMxODQ=","richtext":{"richtext_tags":[]},"text":"ASEAN関連首脳会議に出席するため、フィリピン・マニラに到着しました。\n\n初日となる本日は、フィリピンのマルコス大統領と首脳会談を行いました。\n対面でお会いするのは、本年5月のマルコス大統領夫妻の国賓訪日以来でしたが、今回も幅広い分野での協力や地域情勢についてしっかりと議論し、信頼関係を深めることができました。\n\n私からは、ASEAN議長国としてのマルコス大統領の御尽力に敬意を表し、明日から行われるASEAN関連首脳会議を含め、多国間の場でも連携を強化していきたい旨お伝えしました。\n\n会談では、安全保障、エネルギー、経済協力といった幅広い分野での協力を強化し、「包括的・戦略的パートナー」として二国間関係を一層発展させていくことで一致しました。\n日本は、『進化したFOIP』の下、地域の平和と安定のため、これからもフィリピンと緊密に連携してまいります。\n\nまた、今夜はマルコス大統領が主催するガラディナーに御招待いただき、各国首脳や国際機関の皆様とお話しする機会に恵まれました。\n\n明日以降の会合では日本の立場をしっかり発信してまいります。"}}},"rest_id":"2122335387280675303","unmention_data":{},"views":{"count":"179640","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122335387280675303","sortIndex":"2122426767493824510"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2116017572772766140"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"pro