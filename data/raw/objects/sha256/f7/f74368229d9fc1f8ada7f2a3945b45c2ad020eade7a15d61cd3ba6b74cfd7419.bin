161716","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":0,"retweet_count":5,"retweeted":false,"user_id_str":"266566401"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[228,240],"text":"meti_daijin"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIzMzU0ODkwODA1NjE2NjQ=","richtext":{"richtext_tags":[]},"text":"赤澤大臣は、フィリピン・マニラにて同国のシャロン・ガリン（H.E. Ms. Sharon S. Garin）エネルギー大臣と会談。\n経済産業省とフィリピン・エネルギー省との石油備蓄に関する協力覚書などの署名式も執り行いました。\n赤澤大臣からは、先日のＡＺＥＣ閣僚会合を共同議長として開催いただき、髙木副大臣とも会談いただいたことへの感謝を伝えるとともに、石油備蓄のみならず原子力や洋上風力、ＬＮＧ・ガスを含む幅広い分野で協力を深めていきたい旨を述べました。#meti_daijin"}}},"rest_id":"2122335489156161716","unmention_data":{},"views":{"count":"4200","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122335489156161716","sortIndex":"2122426767493824511"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"paro