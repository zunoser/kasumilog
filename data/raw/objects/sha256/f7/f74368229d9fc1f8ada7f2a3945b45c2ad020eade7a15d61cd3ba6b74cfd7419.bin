75,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/c9tU8aET8g","video_info":{"aspect_ratio":[16,9],"duration_millis":89133,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122301571556118528/pl/1-zy3alzVJgNbK0p.m3u8?tag=29&v=515"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122301571556118528/vid/avc1/480x270/XgEH2Ur96FtsgNGI.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122301571556118528/vid/avc1/640x360/ykLUyYzWbiE0Unk_.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122301571556118528/vid/avc1/1280x720/gPjZEMgRx5FuYNhr.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/c9tU8aET8g","expanded_url":"https://x.com/kantei/status/2122301892860706841/video/1","ext_media_availability":{"status":"Available"},"id_str":"2122301571556118528","indices":[128,151],"media_key":"13_2122301571556118528","media_results":{"result":{"media_key":"13_2122301571556118528"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2122301571556118528/img/USzZ7EO68PEhgZLt.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/c9tU8aET8g","video_info":{"aspect_ratio":[16,9],"duration_millis":89133,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122301571556118528/pl/1-zy3alzVJgNbK0p.m3u8?tag=29&v=515"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122301571556118528/vid/avc1/480x270/XgEH2Ur96FtsgNGI.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122301571556118528/vid/avc1/640x360/ykLUyYzWbiE0Unk_.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122301571556118528/vid/avc1/1280x720/gPjZEMgRx5FuYNhr.mp4?tag=29"}]}}]},"favorite_count":1328,"favorited":false,"full_text":"【お知らせ】\n本日１１月１６日（現地時間）、高市総理は、フィリピンのマルコス大統領と会談を行いました。\n\n※両首脳による冒頭発言要旨（速報版、仮訳）\n（マルコス大統領）\n　高市総理、フィリピンへようこそ。第４９回ＡＳＥＡＮ首脳会議への御参加を歓迎します。 https://t.co/c9tU8aET8g","id_str":"2122301892860706841","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":17,"reply_count":76,"retweet_count":215,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIzMDE4OTI3OTc4NTc3OTI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日１１月１６日（現地時間）、高市総理は、フィリピンのマルコス大統領と会談を行いました。\n\n※両首脳による冒頭発言要旨（速報版、仮訳）\n（マルコス大統領）\n　高市総理、フィリピンへようこそ。第４９回ＡＳＥＡＮ首脳会議への御参加を歓迎します。\n　我々の前回の会談の夕食会でのカラオケ・セッションを大変楽しい思い出として記憶しています。\n　また、我々の二国間関係を進めるために我々が成し遂げた非常に重要な全ての取組についてもです。\n\n（高市総理）\n　５月の国賓訪日、それから先月の電話会談に続いて、こうやってマニラでお会いできてとても嬉しいです。\n　ＡＳＥＡＮ議長国としてのマルコス大統領の大変な御尽力に敬意を表し、感謝をしております。\n　私達の「包括的・戦略的パートナーシップ」に基づいて、この後の会談で、二国間関係を一層力強いものにして参りましょう。"}}},"rest_id":"2122301892860706841","unmention_data":{},"views":{"count":"104180","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122301892860706841","sortIndex":"2122426767493824501"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attach