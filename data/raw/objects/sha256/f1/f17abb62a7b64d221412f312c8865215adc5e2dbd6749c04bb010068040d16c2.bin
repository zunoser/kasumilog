riginal_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":758,"y":0},{"h":1734,"w":1521,"x":865,"y":0},{"h":1734,"w":867,"x":1192,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/u0enHUi6Tv"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/u0enHUi6Tv","expanded_url":"https://x.com/takaichi_sanae/status/2102723365069054281/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":73,"w":73,"x":359,"y":415}]},"medium":{"faces":[{"h":42,"w":42,"x":210,"y":243}]},"orig":{"faces":[{"h":93,"w":93,"x":457,"y":528}]},"small":{"faces":[{"h":24,"w":24,"x":119,"y":138}]}},"id_str":"2102722787601510400","indices":[84,107],"media_key":"3_2102722787601510400","media_results":{"result":{"media_key":"3_2102722787601510400"}},"media_url_https":"https://pbs.twimg.com/media/HS5fPBAbcAAt_rX.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1582,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/u0enHUi6Tv"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/u0enHUi6Tv","expanded_url":"https://x.com/takaichi_sanae/status/2102723365069054281/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":91,"w":91,"x":1387,"y":207},{"h":79,"w":79,"x":1015,"y":257}]},"medium":{"faces":[{"h":53,"w":53,"x":813,"y":121},{"h":46,"w":46,"x":594,"y":150}]},"orig":{"faces":[{"h":116,"w":116,"x":1762,"y":264},{"h":101,"w":101,"x":1289,"y":327}]},"small":{"faces":[{"h":30,"w":30,"x":460,"y":69},{"h":26,"w":26,"x":337,"y":85}]}},"id_str":"2102722932934111232","indices":[84,107],"media_key":"3_2102722932934111232","media_results":{"result":{"media_key":"3_2102722932934111232"}},"media_url_https":"https://pbs.twimg.com/media/HS5fXeaa8AAMYTo.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":278},{"h":1734,"w":1734,"x":498,"y":0},{"h":1734,"w":1521,"x":605,"y":0},{"h":1734,"w":867,"x":932,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/u0enHUi6Tv"}]},"favorite_count":62627,"favorited":false,"full_text":"米国・ニューヨークでの一連の日程を終えて、これから日本に帰国します。\n\n今回の訪問の締めくくりに、先ほど、私にとって初めてとなる国連総会での一般討論演説を行いました。 https://t.co/u0enHUi6Tv","id_str":"2102723365069054281","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":438,"reply_count":2205,"retweet_count":6713,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDI3MjMzNjQ5ODk0MDcyMzI=","richtext":{"richtext_tags":[]},"text":"米国・ニューヨークでの一連の日程を終えて、これから日本に帰国します。\n\n今回の訪問の締めくくりに、先ほど、私にとって初めてとなる国連総会での一般討論演説を行いました。\n\n日本の国連加盟70周年の節目の年に、日本の総理大臣として、歴史ある国連本部の壇上に立ち、日本の立場をしっかりと発信してまいりました。\n\n国際秩序が揺らぐ今、国連が役割を果たせていないという指摘もあります。\n\nそのような中だからこそ、日本は国連のために大きな責任を果たしていきます。\n\n先ほどの一般討論演説では、2つの切り口から、その決意を訴え、日本の具体的な貢献を発信しました。\n\n第1に、国際情勢の緊迫化により生じる課題への対処について。\n\n中東情勢が緊迫化し、国際公共財たるホルムズ海峡において、自由で安全な航行が困難になっています。\n\n日本は、国際社会と連携し、中東地域全体の事態の早期沈静化・安定化のため、外交努力を継続しています。\n\nまた、進化したFOIPの下で、エネルギー・重要物資のサプライチェーンを強靱化するために、パワー・アジアに加えて、現在、湾岸諸国との包括的な協力計画をまとめていることも打ち出しました。\n\n核兵器のない世界に向けた国際社会の連帯を呼びかけ、北朝鮮の完全な非核化や拉致問題の一刻も早い解決を訴えました。\n\n力や威圧による一方的な現状変更の試みは、世界のどこであっても認めることができないことを主張しました。\n\nICJ、ICC、ITLOSなどの様々な国際裁判所を一貫して支持し、判事を輩出していることにも表れているとおり、日本は、いかなる紛争の解決においても法の支配を重視していくことを表明しました。\n\n第2に、日本の、「国連」を中心とする「多国間主義」へのコミットメントについて。\n\n日本が推進してきた地球規模課題への取組を通じた、「グローバルサウスとの連帯」をアピールしました。\n\nまた、全ての国が真剣に気候変動対策に取り組まなければならないことを訴え、日本の知見や技術の共有を通じて世界の防災対策に貢献する意思を強調しました。\n\n信頼できるAIの実現に向けて、AIサミットを早期に日本で開催する意思を国際社会に示しました。\n\n国際社会の課題に対処するため、国連は、より強靱、かつ実効的な国連に生まれ変わらなければならず、安全保障理事会の改革の必要性や国連憲章の旧敵国条項の削除も求めました。\n\n日本は、国連加盟以来70年間、専守防衛の考えの下、平和国家として、国際社会の平和と繁栄に一貫して貢献してきており、この方針は、今後も一切変わりません。\n\n秋以降の外交機会も含め、各国との連携を深め、国際社会の課題への対処に、力を注いでまいります。"}}},"rest_id":"2102723365069054281","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1796733","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102723365069054281","sortIndex":"2102984395735433172"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2102984395735433261-tweet-2102720196301713431","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1768210,"following":47},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8284,"tweets":23340},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2102720196301713431"],"editable_until_msecs":"1790166136000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":502,"bookmarked":false,"conversation_id_str":"2102720196301713431","created_at":"Wed Sep 23 11:22:16 +0000 2026","display_text_range":[0,130],"entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/AW7dNKLj1e","expanded_url":"https://x.com/kantei/status/2102720196301713431/video/1","ext_media_availability":{"status":"Available"},"id_str":"2102718922302894080","indices":[131,154],"media_key":"13_2102718922302894080","media_results":{"result":{"media_key":"13_2102718922302894080"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2102718922302894080/img/-O_Pdp8x1x14mJTt.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/AW7dNKLj1e","video_info":{"aspect_ratio":[16,9],"duration_millis":1391600,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2102718922302894080/pl/Zva4ZHblo8EvJmyd.m3u8?tag=29&v=17b"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102718922302894080/vid/avc1/480x270/UsDpi1g7YTZk_aQw.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102718922302894080/vid/avc1/640x360/xzkZ6GfR5Japn2a5.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102718922302894080/vid/avc1/1280x720/8R_etDsJuFC6mGqX.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/AW7dNKLj1e","expanded_url":"https://x.com/kantei/status/2102720196301713431/video/1","ext_media_availability":{"status":"Available"},"id_str":"2102718922302894080","indices":[131,154],"media_key":"13_2102718922302894080","media_results":{"result":{"media_key":"13_2102718922302894080"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2102718922302894080/img/-O_Pdp8x1x14mJTt.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/AW7dNKLj1e","video_info":{"aspect_ratio":[16,9],"duration_millis":1391600,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2102718922302894080/pl/Zva4ZHblo8EvJmyd.m3u8?tag=29&v=17b"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102718922302894080/vid/avc1/480x270/UsDpi1g7YTZk_aQw.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102718922302894080/vid/avc1/640x360/xzkZ6GfR5Japn2a5.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102718922302894080/vid/avc1/1280x720/8R_etDsJuFC6mGqX.mp4?tag=29"}]}}]},"favorite_count":10404,"favorited":false,"full_text":"【お知らせ】（1/2）\n9月22日（現地時間）、高市総理は、アメリカ（ニューヨーク）において、国連総会出席等についての内外記者会見を行いました。\n\n※冒頭発言全文（速報版）\n（高市総理）\n　お疲れ様でございます。先ほど、国連総会の場で一般討論演説を行いました。 https://t.co/AW7dNKLj1e","id_str":"2102720196301713431","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":95,"reply_count":227,"retweet_count":1973,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDI3MjAxOTYxNjc0OTU2ODI=","richtext":{"richtext_tags":[]},"text":"【お知らせ】（1/2）\n9月22日（現地時間）、高市総理は、アメリカ（ニューヨーク）において、国連総会出席等についての内外記者会見を行いました。\n\n※冒頭発言全文（速報版）\n（高市総理）\n　お疲れ様でございます。先ほど、国連総会の場で一般討論演説を行いました。\n　本年は、まさに、日本の国連加盟70周年の節目の年に当たります。\n　今、その国連を中心とする、戦後の自由で開かれた国際秩序が、大きく揺らいでいます。\n　「国連は、世界の平和と安定のための役割を果たせていないのではないか」という声も聞こえてきています。\n　そのような中であっても、いえ、そういう状況だからこそ、私は、日本の多国間主義、そして国連に対する姿勢は、揺るがないと申し上げました。\n　私は、就任以来、力強い日本外交を推進してきました。\n　本年5月には、進化したＦＯＩＰを発表し、戦略的な外交を一体的に推進しているところです。\n　日本は、平和国家として、国連と歩んだ70年間を礎に、国連への信頼を取り戻すべく、責任を果たしてまいります。\n　先ほどの一般討論演説は、2つの切り口から、その決意を訴え、日本の具体的な貢献を発信する絶好の機会となりました。\n　第1に、国際情勢の緊迫化により生じる課題への対処について。\n　中東情勢が緊迫化し、国際公共財たるホルムズ海峡において、自由で安全な航行が困難になっています。\n　日本は、国際社会と連携し、中東地域全体の事態の早期沈静化・安定化のため、外交努力を継続しております。\n　また、進化したFOIPの下で、エネルギー・重要物資のサプライチェーンを強靱化するために、パワー・アジアに加えて、現在、湾岸諸国との包括的な協力計画をまとめているということも打ち出しました。\n　核兵器のない世界に向けた国際社会の連帯を呼びかけ、北朝鮮の完全な非核化や拉致問題の一刻も早い解決を訴えました。\n　力や威圧による一方的な現状変更の試みは、世界のどこであっても認めることができないことを主張しました。\n　日本は、いかなる紛争の解決においても法の支配を重視しています。\n　それは、日本がＩＣＪ、ＩＣＣ、ＩＴＬＯＳなどの様々な国際裁判所を一貫して支持し、判事を輩出していることにも表れています。\n　第2に、日本の、国連を中心とする多国間主義へのコミットメントについて。\n　日本が推進してきた地球規模課題への取組を通じた、グローバルサウスとの連帯（※）をアピールしました。\n　また、日本の技術力を活用すれば、気候変動対策と経済成長は両立できるので、全ての国が真剣に気候変動対策に取り組まなければならないということを訴えました。\n　日本は世界一の防災大国を目指しております。日本の知見や技術の共有を通じて、世界の防災対策に貢献する意思と、新たに国際防災協力担当大臣を任命したことも強調しました。\n　信頼できるAIの実現に向けてAIサミットを早期に日本で開催する意思を国際社会に表明しました。\n　国際社会の課題に対処するためには、国連はより強靱、かつ実効的な国連に生まれ変わらなければなりません。\n　機能不全に陥っている安全保障理事会の改革の必要性を、強く訴えました。\n　国連憲章の早急な見直し、つまり、旧敵国条項の削除も求めました。\n　最後に、日本は、国連加盟以来70年間、専守防衛の考えの下、平和国家として、国際社会の平和と繁栄に一貫して貢献してきており、この方針は今後も一切変わらないことを強調しました。\n　また、今回のニューヨーク訪問の機会を捉え、グテーレス国連事務総長や各国首脳との会談も行いました。\n　グテーレス事務総長との会談では、私から、事務総長が進めてこられた国連改革を支持しつつ、現代の国際社会を反映していない安全保障理事会の改革の緊急性を改めて訴えました。\n　また、邦人職員の増強も働きかけました。\n　グテーレス事務総長からは、多国間主義に対する日本の力強いコミットメントと行動に謝意が表されました。\n　トランプ大統領とは、日米同盟や自由で開かれたインド太平洋を含む地域情勢について率直に議論し、経済、安全保障、そしてAI、半導体、重要鉱物といった、経済安全保障における協力を一層強化していくことで一致しました。\n　アジアでも厳しさを増す安全保障環境の下、本日、まさにこのタイミングでのトランプ大統領との会談は、日米同盟の強さを世界に示すものになったと確信しております。\n　日本と米国が共に強く、豊かになるため、そして、地域の平和と安定のため、日米同盟を更に揺るぎのないものにしていく覚悟です。\n　また、トルコのエルドアン大統領と、先月の電話会談に続いて、現下の中東情勢や二国間関係について首脳会談で議論を行いました。\n　中東情勢に関し、私から、地域全体の事態の早期沈静化及び安定化、また、ホルムズ海峡におけるいかなる追加的費用もない形での自由で安全な航行の確保が極めて重要であることを指摘しました。\n　その上で、エルドアン大統領からは、日本の立場への賛同が示され、両国が緊密に連携していくことで一致しました。\n　さらに、ウクライナのゼレンスキー大統領と、首脳会談を行いました。\n　私から、日本はウクライナと共にあり国際社会と連携しながら、今年の冬に向けたエネルギー分野を含め、ウクライナ支援と対露制裁を継続する考えを述べました。\n　ゼレンスキー大統領から、日本のこれまでの支援への謝意が表明されるとともに、ウクライナの取組に関し説明がありました。\n　この他、オーストラリアのアルバニージー首相や英国のバーナム首相、トリニダート・トバゴのパサード＝ビセッサー首相、ブータンのトブゲー首相と懇談をし、二国間関係の更なる推進を確認する、良い機会となりました。\n　これから年末にかけまして、ＡＳＥＡＮ、ＡＰＥＣ、Ｇ２０が続きます。\n　私は、この一連の外交機会をとらえて各国との連携を深め、国際社会の諸課題に一致して立ち向かう機運を高めてまいります。\n　私からは冒頭以上でございます。ありがとうございます。\n※「連携」と発言しましたが、正しくは「連帯」です。"}}},"rest_id":"2102720196301713431","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"796713","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2102984395735433261-tweet-2102721356668522728","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1929442960221028353/I0KsGLtz_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/412940784/1464569515"},"core":{"created_at":"Tue Nov 15 09:24:43 +0000 2011","name":"首相官邸","screen_name":"kantei"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0MTI5NDA3ODQ=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1589269994889957377"},"profile_bio":{"description":"本アカウントは首相官邸の公式アカウントです。日々の総理に関する情報や内閣の重要政策についての情報などをお届けします。","entities":{"description":{},"url":{"urls":[{"display_url":"kantei.go.jp","expanded_url":"https://www.kantei.go.jp/","indices":[0,23],"url":"https://t.co/lKMociTte5"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1768210,"following":47},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"412940784","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8284,"tweets":23340},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/lKMociTte5"}}}},"edit_control":{"edit_tweet_ids":["2102721356668522728"],"editable_until_msecs":"1790166412000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":64,"bookmarked":false,"conversation_id_str":"2102720196301713431","created_at":"Wed Sep 23 11:26:52 +0000 2026","display_text_range":[0,45],"entities":{},"favorite_count":1784,"favorited":false,"full_text":"(2/2) 高市総理による内外記者会見（質疑応答部分）\n\n※要旨（速報版、仮訳)\n（記者）","id_str":"2102721356668522728","in_reply_to_screen_name":"kantei","in_reply_to_status_id_str":"2102720196301713431","in_reply_to_user_id_str":"412940784","is_quote_status":false,"lang":"ja","quote_count":10,"reply_count":39,"retweet_count":401,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDI3MjEzNTY0ODgyMjg4NjQ=","richtext":{"richtext_tags":[]},"text":"(2/2) 高市総理による内外記者会見（質疑応答部分）\n\n※要旨（速報版、仮訳)\n（記者）\n　今、外交について総理からご説明がありましたけれども、何点か補足的に私から質問させていただきたいと思います。まず、日米首脳会談についてです。総理、今、まさにこのタイミングで会談したと、このタイミングというのは、米中首脳会談を前にしたタイミングを指していると思いますけれども、総理からですね、トランプ大統領に対し、日中関係の現状についてどのような考えを伝えたのか。また、今回の会談を通じて、対中国への認識でどのような確認ができたのかお聞きしたいと思います。\n　また、トランプ政権がＩＣＣに対してですね、いろいろ圧力を強めていると思います。総理はこれまで赤根所長の制裁対象についてですね、「日本の立場と相いれるものではなく、アメリカに対し必要な働きかけを行う」と説明してきました。今回の会談で日本としてどのような考えを伝えたのか、併せてお聞きしたいと思います。\n　そして、国連総会での一般討論演説についても、ご説明ありました。日本の国連加盟７０周年の節目の演説となったと思います。国際協調や多国間主義に逆風が吹く中、日本として国連でどのような役割を果たしていくのか。\n　最後にですね、今回の訪問は秋の首脳外交の皮切りとなりました。この秋に予定される国際会議にいくつか総理も触れましたけれども、外交面でどのような成果を目指していくのか改めて伺いたいと思います。\n\n（高市総理）\n　ありがとうございます。トランプ大統領とは、日米同盟や自由で開かれたインド太平洋を含む地域情勢について率直に議論をし、日米同盟の強さを示すことができたと思っております。\n　その中で、来る米中首脳会談も念頭に、中国をめぐる諸課題についてタイムリーに意見交換を行いました。\n　日本としては、米中関係が日本を含む国際社会の安定に資するものとなることが重要だと考えておりますので、ここは日米で緊密に連携をしてまいります。\n　また、ＩＣＣにつきましては、我が国は国際社会における法の支配の徹底のため、ＩＣＣを一貫して支持しております。\n　本日の会談においては、このような立場を踏まえて、トランプ大統領との間でＩＣＣについて率直にやり取りを行いました。\n　一般討論演説でも申し上げましたけれども、世界に平和と安定をもたらし、国際社会が新たな課題を乗り越えて繁栄する上で、今ほど、国連が重要な時代はありません。\n　日本が「平和国家」として、国連と歩んだ７０年間を礎に、国際社会が直面する重要課題に対応する「ルール・制度づくり」と「現場の支援」の両輪で、国連と歩みを重ねてまいります。\n　あわせて、「国連への信頼」を取り戻すということも重要です。\n　日本は、「より強靱、かつ実効的な国連」に変革し、「安全保障理事会を改革」していくために、大きな責任を果たしていく所存でございます。\n　今年秋に予定される様々な国際会議の機会も活用して、同盟国、同志国との関係を一層深めていきます。\n　また、「自由で開かれたインド太平洋、ＦＯＩＰ」を進化させ、これまで構築してきた各国首脳との信頼関係を基盤に、「パワー・アジア」など具体策の展開を加速させて、積極的な外交を展開していきたいと考えております。\n\n（記者）\n　総理、このような記者会見の機会を設けていただき心から感謝申し上げます。私からは、イランは、ホルムズ海峡について質問させていただきます。イランはホルムズ海峡、制裁解除を含むいくつかの条件と関連付けています。日本は、こうしたイラン側の要求について交渉を行うべきだと考えていますでしょうか。\n　日本は長年にわたり、航行の自由を国際秩序の基本原則として擁護してこられました。日本は、イランによるホルムズ海峡の船舶航行に対する制限は、この原則に違反するものだと考えていますでしょうか。\n　また、ホルムズ海峡が開かれた状態を確保するため、国際社会はどのような対応を取るべきだと考えますか。\n\n（高市総理）\n　イラン情勢につきましては、この軍事的な緊張が継続する中でございます。特に、ホルムズ海峡において、「法の支配に基づく海洋秩序」が 大きく揺らいでいることを強く懸念しています。\n　今何よりも重要なことは、地域全体の「事態の早期沈静化・安定化」が図られることです。\n　その上で、世界の物流の要衝であり、国際公共財でもあるホルムズ海峡において、「追加的な費用がない形」で、「自由で安全な航行」が一刻も早く回復されることが重要です。\n　また、今後のこの海峡の在り方につきましては、海峡の沿岸国やそして利用国、そして国際海事機関（ＩＭＯ）を含む国際社会全体での議論が不可欠だと思っております。\n　そのために、日本は国際社会において積極的な外交努力を続けてまいります。\n　イランに対してもそうですけれども、関係国に対して、これまで電話・首脳会談などで私どもの考えを伝えてまいりました。以上です。\n\n（記者）\n　総理よろしくお願いいたします。私の方からは内政についてお伺いしたいと思います。\n　１０月５日に招集される臨時国会についてお伺いします。総理が、決断と挑戦、実行の内閣と位置づける第２次高市改造内閣が発足して初めて臨む国会となりますが、総理はどのような成果を得たいとお考えでしょうか。\n　悲願とされる食料品の消費税減税関連法案や、日本維新の会との連立合意で掲げた、衆院議員定数削減法案の成立には、与党が参院で過半数に届かない中で、野党の協力が必要になります。野党にはどのような方針で臨むおつもりでしょうか。\n　また、自民党の鈴木俊一幹事長は、国民民主党との関係について、政策ごとに協力をしてもらうことから、究極的には連立を組むところまで行くと思う、と述べられました。国民民主党との連立に関しても、改めてお考えをお伺いしたいと思います。よろしくお願いします。\n\n（高市総理）\n　はい、ありがとうございます。「決断と挑戦、そして実行の内閣」としまして、日本列島のすみずみまで活発な経済活動が行き渡り、今を生きる国民も、未来を生きる国民も、安全で安心して暮らせる国を創るために大胆な政策転換を着実に「実行」に移して一つ一つ形にしていかなければならないと考えております。\n　臨時国会では、「消費税・支援金法案」や中東情勢を受けた「原油調達多角化に関する法案」など、国民の皆様に身近な法整備で、結果を出していきたいと考えています。\n　野党の皆様とも真摯に議論を行い、ご理解を求めて、国民生活の向上や国益のために一致できる点では幅広く協力して、政策を前に進めていきたいと思います。\n　「消費税・支援金法案」につきましては、これまで物価高や税・社会保険料負担に苦しんできた、中所得・低所得の方の負担軽減が現下の最重要課題であるという認識の下で検討を進めてまいりました。\n　社会保障国民会議における議論の中では、中所得・低所得の方の税・社会保険料をトータルで見て早期に負担軽減を図るべきという方向性については、参加各党と共有できる部分も多く、特に「所得に応じたきめ細かな給付」につきましては、様々なご意見もありましたけれども、概ね各党のご了承いただいたと考えております。\n　先週の会見でも申し上げましたとおり、政府としましては、先日９月１５日に閣議決定した「大綱」に基づいて、必要な法制上の措置等を可及的速やかに講ずるということにしております。引き続き、「中間取りまとめ」における各党のご意見というものに十分配慮し、尊重しながら、なるべく多くの政党にご賛同いただけますように、法律案の準備や審議に丁寧に臨んでまいります。\n　それから、これも先週申し上げたとおりなのですが、「定数削減法案」につきましては、議員立法でございます。先の特別国会において継続審議になっており、次の国会においても議論が行われるということです。\n　ですから議員定数の在り方というのは、民主主義の根幹に関わる問題ですから、国会においてご議論をいただくべき事柄でありますので、その議論の状況を内閣としては注視してまいりたいと思っております。\n　先週も申し上げましたけれども、これは自民党と日本維新の会の「連立政権合意書」を交わした中にも入っており、また自民党のですね、今年の衆議院議員選挙の政権公約にも掲げております。その実現に向けて、自民党として真摯に取り組んでいくべきものだと考えます。\n　連立の拡大についてでございますが、これは相手方の意向もあることですから、私からコメントするということは控えますけれども、就任以来、申し上げておりますとおり、政治の安定なくしては強い経済を実現するための政策も、力強い外交も、安全保障も推進していくことはできないと考えておりますので、そのために必要な対応というものは常に考えております。\n\n（記者）\n　総理、私に質問の機会をいただきありがとうございます。日米豪印（ＱＵＡＤ）の枠組みにおけるインドと日本のパートナーシップをどのように評価していますでしょうか。また、インド太平洋地域におけるＱＵＡＤの優先課題を推進するため、両国はどのように協力していますか。\n　二つ目の質問は、現在の日印関係をどのように評価していますか。また、南アジアの他の国々との関係強化に向けた日本の優先課題は何でしょうか。\n\n（高市総理）\n　日米豪印というのは、インドも含めて、価値を共有して、地域の課題を解決する意思と能力を有する４か国が「自由で開かれたインド太平洋、ＦＯＩＰ」の実現に向けて具体的な協力を進めていく枠組みでございます。\n　４か国は、「進化したＦＯＩＰ」においても重要な、各国の「自律性」・「強靱性」を強化していくということの重要性を確認しております。具体的な取組を進めるために日本はインドとも緊密に連携しています。\n　私は今年７月にインドを訪問しました。その時、モディ首相との間で確認したとおり、 両国は、戦略的方向性を共有する「特別な戦略的グローバルパートナー」でございます。\n　経済安全保障を含む安全保障、経済・投資・イノベーション、人的交流といった分野を中心に、互いの強みを活かし合う相互補完的な関係を構築してまいります。\n　南アジアについてもおっしゃいましたが、地政学的重要性と大きな経済的潜在力を有している地域でございます。この進化したＦＯＩＰの実現に向けても、とても大切な地域でございます。\n　地域各国との伝統的な友好関係の上に、今後も海洋安全保障、経済・投資、経済協力、 人的交流といった分野で協力関係を幅広く強化していきたいと考えております。"}}},"rest_id":"2102721356668522728","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"56239","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2102720196301713431","2102721356668522728"],"enableDeduplication":true}}},"entryId":"list-conversation-2102984395735433261","sortIndex":"2102984395735433171"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/A7NgPRhZs0"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":55},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/891029089/_______1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/137272821/1675935544"},"core":{"created_at":"Mon Apr 26 09:01:56 +0000 2010","name":"総務省消防庁","screen_name":"FDMA_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMzcyNzI4MjE=","is_blue_verified":false,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2100823875403874738"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"本アカウントは総務省消防庁の公式アカウントです。大規模災害に関する情報や消防防災に関する情報を発信します。","entities":{"description":{},"url":{"urls":[{"display_url":"fdma.go.jp","expanded_url":"http://www.fdma.go.jp/","indices":[0,23],"url":"https://t.co/YCgAnjuA83"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_intersti