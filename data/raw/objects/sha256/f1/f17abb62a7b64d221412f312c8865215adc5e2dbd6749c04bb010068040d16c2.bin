idth":1920},"sizes":{"large":{"h":1080,"resize":"fit","w":1920},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/usHXFfrrLN","video_info":{"aspect_ratio":[16,9],"duration_millis":14165,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2102688229837398016/pl/LxrRBWUn9Nz9iLea.m3u8?tag=29&v=cfc"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102688229837398016/vid/avc1/480x270/55uJZJgMXCwZkvCI.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102688229837398016/vid/avc1/640x360/Y57hEE2KiGthvUyq.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102688229837398016/vid/avc1/1280x720/wC8Qrl5tDE-IoA3N.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2102688229837398016/vid/avc1/1920x1080/AE00WqIhVCqBbLtq.mp4?tag=29"}]}}]},"favorite_count":407,"favorited":false,"full_text":"【防災情報　23日18時点】機構では現在も印旛沼の水位低下を図るため、常時満水位（Y.P 2.30ｍ）に向けて、印旛機場（最大排水能力：毎秒92トン）、大和田機場（最大排水能力：120トン）の排水運転を行っています。\n ※印旛沼の平均水位　Y.P 4.04ｍ（23日18時現在） https://t.co/usHXFfrrLN","id_str":"2102688739185262702","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":8,"reply_count":1,"retweet_count":174,"retweeted":false,"user_id_str":"525120344"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDI2ODg3MzkxMjIzNjg1MTI=","richtext":{"richtext_tags":[]},"text":"【防災情報　23日18時点】機構では現在も印旛沼の水位低下を図るため、常時満水位（Y.P 2.30ｍ）に向けて、印旛機場（最大排水能力：毎秒92トン）、大和田機場（最大排水能力：120トン）の排水運転を行っています。\n ※印旛沼の平均水位　Y.P 4.04ｍ（23日18時現在） \nまた、大和田排水機場の動力源である燃料（灯油）についても関係者みなさまのご協力によりタンクローリーが続々と到着しています。ありがとうございます。"}}},"previous_counts":{"bookmark_count":0,"favorite_count":0,"quote_count":0,"reply_count":0,"retweet_count":1},"rest_id":"2102688739185262702","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"26902","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2102694446991286733","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"692","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102694446991286733","sortIndex":"2102984395735433168"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2101902184103477314"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls":[{"display_url":"