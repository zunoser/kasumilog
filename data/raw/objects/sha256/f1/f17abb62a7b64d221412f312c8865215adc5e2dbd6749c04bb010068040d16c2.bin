"allow_download":true},"display_url":"pic.x.com/UPb7wdDWzp","expanded_url":"https://x.com/takaichi_sanae/status/2102571751519526995/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":35,"w":35,"x":594,"y":358}]},"medium":{"faces":[{"h":35,"w":35,"x":594,"y":358}]},"orig":{"faces":[{"h":35,"w":35,"x":594,"y":358}]},"small":{"faces":[{"h":31,"w":31,"x":537,"y":323}]}},"id_str":"2102571680782565376","indices":[147,170],"media_key":"3_2102571680782565376","media_results":{"result":{"media_key":"3_2102571680782565376"}},"media_url_https":"https://pbs.twimg.com/media/HS3VzcPXQAASs-I.jpg","original_info":{"focus_rects":[{"h":421,"w":752,"x":0,"y":0},{"h":624,"w":624,"x":0,"y":0},{"h":624,"w":547,"x":0,"y":0},{"h":624,"w":312,"x":0,"y":0},{"h":624,"w":752,"x":0,"y":0}],"height":624,"width":752},"sizes":{"large":{"h":624,"resize":"fit","w":752},"medium":{"h":624,"resize":"fit","w":752},"small":{"h":564,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/UPb7wdDWzp"}]},"favorite_count":16602,"favorited":false,"full_text":"本日、国連総会出席のために訪問中の米国・ニューヨークにて、中東地域において長年にわたり重要な役割を果たしているトルコのエルドアン大統領(@RTErdogan)との間で会談を行いました。\n\nエルドアン大統領とは、8月の電話会談に続き、本日は対面での会談となり、信頼関係を深めることができました。 https://t.co/UPb7wdDWzp","id_str":"2102571751519526995","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":72,"reply_count":282,"retweet_count":1749,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"68034431","indices":[68,78],"name":"Recep Tayyip Erdoğan","screen_name":"RTErdogan"}]},"id":"Tm90ZVR3ZWV0OjIxMDI1NzE3NTE0NTI0MDk4NTY=","richtext":{"richtext_tags":[]},"text":"本日、国連総会出席のために訪問中の米国・ニューヨークにて、中東地域において長年にわたり重要な役割を果たしているトルコのエルドアン大統領(@RTErdogan)との間で会談を行いました。\n\nエルドアン大統領とは、8月の電話会談に続き、本日は対面での会談となり、信頼関係を深めることができました。\n\n中東情勢に関し、私から、地域全体の事態の早期沈静化及び安定化、また、ホルムズ海峡におけるいかなる追加的費用もない形での自由で安全な航行の確保が極めて重要であることを指摘しました。\n\nその上で、エルドアン大統領からは、日本の立場への賛同が示され、両国が緊密に連携していくことで一致しました。\n\n日・トルコ関係は「広いアジアを東西から支える二つの翼」にたとえられます。\n\n会談では、教育、経済、防衛といった幅広い分野での協力を一層推進し、戦略的パートナーシップを更なる高みへと引き上げていくことを確認しました。\n\n中東地域全体の安定に向け、エルドアン大統領と緊密に連携してまいります。"}}},"rest_id":"2102571751519526995","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"299526","state":"EnabledWithCount"}}}}},"entryId":"tweet-2102571751519526995","sortIndex":"2102984395735433139"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/7hqmpH6hGr"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":18},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1457603623069040641/xdzevirh_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/571429134/1530598268"},"core":{"created_at":"Sat May 05 02:08:28 +0000 2012","name":"国土交通省","screen_name":"MLIT_JAPAN"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo1NzE0MjkxMzQ=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2101902184103477314"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省公式アカウントです。国土交通省ホームページの新着情報を中心に、  国民の皆さまに情報を発信していきます。","entities":{"description":{},"url":{"urls"