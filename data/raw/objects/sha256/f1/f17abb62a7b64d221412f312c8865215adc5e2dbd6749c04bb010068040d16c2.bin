,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2102636876759024123","created_at":"Wed Sep 23 05:51:11 +0000 2026","display_text_range":[0,140],"entities":{"hashtags":[{"indices":[22,35],"text":"台風25号被害に伴う対応"}],"urls":[{"display_url":"ktr.mlit.go.jp/kisha/kyoku_s_…","expanded_url":"https://www.ktr.mlit.go.jp/kisha/kyoku_s_kisha_00578.pdf","indices":[109,132],"url":"https://t.co/TeeQTX990Z"}],"user_mentions":[{"id_str":"714372536490852352","indices":[3,19],"name":"国土交通省　関東地方整備局　広報","screen_name":"mlit_kanto_koho"}]},"favorite_count":0,"favorited":false,"full_text":"RT @mlit_kanto_koho: 【＃台風25号被害に伴う対応】千葉県からの支援要請を受け、TEC-FORCE（緊急災害対策派遣隊）を派遣し、印旛沼の決壊した堤防の緊急復旧について、技術的な支援を実施します。\nhttps://t.co/TeeQTX990Z https:…","id_str":"2102636876759024123","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":246,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":59094},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/800954414630453248/u8rHJtFy_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/714372536490852352/1548730557"},"core":{"created_at":"Mon Mar 28 08:44:19 +0000 2016","name":"国土交通省　関東地方整備局　広報","screen_name":"mlit_kanto_koho"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo3MTQzNzI1MzY0OTA4NTIzNTI=","is_blue_verified":false,"location":{"location":"埼玉県さいたま市"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国土交通省　関東地方整備局の公式アカウントです。関東地方整備局ホームページの新着情報を中心に、お知らせしたい情報を発信していきます。\n関東地方整備局公式SNS一覧　→　https://t.co/ESFaQAGRuT",