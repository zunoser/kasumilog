:[{"indices":[46,52],"text":"自転車活用"}],"urls":[{"display_url":"mlit.go.jp/report/press/s…","expanded_url":"https://www.mlit.go.jp/report/press/sogo12_hh_000544.html","indices":[146,169],"url":"https://t.co/7fLCgW75Mj"}]},"favorite_count":21,"favorited":false,"full_text":"🚲＝＝＝＝＝＝＝＝\n\n自転車･地域公共交通\n   連携促進セミナー\n\n＝＝＝＝＝＝＝＝🚃\n\n#自転車活用･地域公共交通との\n連携に関する取組紹介\n\n先進事例を通じて、\n自転車を活用した\n地域の移動環境の形成を考えます\n\n🗓️日時\n9月14日(月) 10時30分～11時30分\n※WEB開催\n\nhttps://t.co/7fLCgW75Mj","id_str":"2096851866806354027","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":0,"retweet_count":7,"retweeted":false,"user_id_str":"571429134"},"rest_id":"2096851866806354027","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"7188","state":"EnabledWithCount"}}}}},"entryId":"tweet-2096851866806354027","sortIndex":"2096998893823721431"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2994870,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":530,"tweets":1766},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2096851118865461536"],"editable_until_msecs":"1788766839000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":43,"bookmarked":false,"conversation_id_str":"2096851118865461536","created_at":"Mon Sep 07 06:40:39 +0000 2026","display_text_range":[0,133],"entities":{},"favorite_count":7702,"favorited":false,"full_text":"東京都新島村、大島町に加え、東京都利島村にも「レベル５土砂災害特別警報」が発表されました。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。","id_str":"2096851118865461536","is_quote_status":true,"lang":"ja","quote_count":78,"quoted_status_id_str":"2096817824627147231","quoted_status_permalink":{"display":"x.com/takaichi_sanae…","expanded":"https://twitter.com/takaichi_sanae/status/2096817824627147231","url":"https://t.co/Lao0HZikQI"},"reply_count":607,"retweet_count":901,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTY4NTExMTg4MTUxNjIzNjg=","richtext":{"richtext_tags":[]},"text":"東京都新島村、大島町に加え、東京都利島村にも「レベル５土砂災害特別警報」が発表されました。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。\n命の危険が迫っているため、地方自治体の指示に従い、直ちに身の安全を確保して下さい。\n\n今後、他の市町村にも、レベル５特別警報が発表される可能性があります。\n土砂災害、低い土地の浸水、河川の増水や氾濫などに厳重に警戒して下さい。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2994870,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":530,"tweets":1766},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2096817824627147231"],"editable_until_msecs":"1788758901000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":40,"bookmarked":false,"conversation_id_str":"2096817824627147231","created_at":"Mon Sep 07 04:28:21 +0000 2026","display_text_range":[0,128],"entities":{},"favorite_count":7233,"favorited":false,"full_text":"東京都新島村に加え、東京都大島町に「レベル５土砂災害特別警報」が発表されました。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。","id_str":"2096817824627147231","is_quote_status":false,"lang":"ja","quote_count":72,"reply_count":299,"retweet_count":793,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTY4MTc4MjQ1NzI1MDYxMTI=","richtext":{"richtext_tags":[]},"text":"東京都新島村に加え、東京都大島町に「レベル５土砂災害特別警報」が発表されました。\n\nこれらの地域では、これまでに経験したことのないような大雨となっており、特に、土砂災害警戒区域などでは、土砂災害など何らかの災害が既に発生している可能性が極めて高い状況です。\n命の危険が迫っているため、地方自治体の指示に従い、直ちに身の安全を確保して下さい。\n\n避難所までの移動がかえって危険な場合は、無理をせず、崖や沢から離れた場所など、今いる場所より少しでも安全な場所に移動するなど、命を守る行動を最優先して下さい。\n\n今後、他の市町村にも、レベル５特別警報が発表される可能性があります。\nまた、現在、レベル５特別警報が発表されていない地域でも、前線と台風から変わった熱帯低気圧の影響で、西日本から北日本の太平洋側の広い範囲で大雨になるおそれがあります。\n土砂災害、低い土地の浸水、河川の増水や氾濫などに厳重に警戒して下さい。\n\n政府としては、「レベル５土砂災害特別警報」の発表を受け、「官邸危機管理センター」に設置した「官邸連絡室」において、地方自治体とも連携し、国民の皆様に対する適時的確な情報提供、被害が発生した場合の被害状況の把握、人命第一の方針の災害応急対策など、危機管理に万全の対応をしてまいります。"}}},"rest_id":"2096817824627147231","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"593800","state":"EnabledWithCount"}}},"rest_id":"2096851118865461536","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"330729","state":"EnabledWithCount"}}}}},"entryId":"tweet-2096851118865461536","sortIndex":"2096998893823721430"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1456514256103669762/-XOHBm82_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/461064204/1788223971"},"core":{"created_at":"Wed Jan 11 12:10:12 +0000 2012","name":"政府広報オンライン","screen_name":"gov_online"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo0NjEwNjQyMDQ=","is_blue_verified":false,"location":{"location":"東京都 千代田区永田町1-6-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2096457155079741779"]},"possibly_sensitive":false,"privacy":{"protected":false},"professional":{"category":[],"professional_type":"Business","rest_id":"1610151932995465216"},"profile_bio":{"description":"内閣府政府広報の公式アカウントです。政府の重要施策や各府省の新しい制度・取組の中から日々の暮らしにかかわるお役立ち情報をピックアップして分かりやすく紹介しています。ぜひフォローをお願いします。","entities":{"description":{},"url":{"urls":[{"display_url":"gov-online.go.jp","expanded_url":"https://www.gov-online.go.jp/","indice