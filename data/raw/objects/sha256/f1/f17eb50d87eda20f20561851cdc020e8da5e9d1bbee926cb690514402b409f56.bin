r":"218434058","indices":[3,18],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"preview_translation":"カラ @takaichi_sanae、言葉をありがとうございます。  \nあなたを友人として迎えられたことを光栄に思いますし、イタリアと日本の間の信頼関係とますます強まる絆に大変誇りを感じています 🇮🇹🇯🇵  \n\n私たちの外交関係160周年は、共通の歴史を祝い、共に未来を見据える重要な機会です。","source_language":"it","translation":"カラ @takaichi_sanae、言葉をありがとうございます。  \nあなたを友人として迎えられたことを光栄に思いますし、イタリアと日本の間の信頼関係とますます強まる絆に大変誇りを感じています 🇮🇹🇯🇵  \n\n私たちの外交関係160周年は、共通の歴史を祝い、共に未来を見据える重要な機会です。  \n\n私たちは、高度な技術分野、エネルギー分野、インフラ、防衛分野での多くの進行中の協力関係を発展させながら、特別戦略的パートナーシップをさらに強化するために、肩を並べて働き続けます。"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":336,"bookmarked":false,"conversation_id_str":"2095835147945861419","created_at":"Fri Sep 04 11:23:32 +0000 2026","display_text_range":[0,275],"entities":{"user_mentions":[{"id_str":"218434058","indices":[5,20],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"favorite_count":22904,"favorited":false,"full_text":"Cara @takaichi_sanae, grazie per le tue parole.\nSono onorata di averti come amica e sono molto orgogliosa del rapporto di fiducia e del legame sempre più forte tra Italia e Giappone 🇮🇹🇯🇵\n \nIl 160° anniversario delle nostre relazioni diplomatiche è un’occasione importante per","id_str":"2095835147945861419","is_quote_status":true,"lang":"it","quote_count":121,"quoted_status_id_str":"2095754084502683807","quoted_status_permalink":{"display":"x.com/takaichi_sanae…","expanded":"https://twitter.com/takaichi_sanae/status/2095754084502683807","url":"https://t.co/3OeDN4xRPM"},"reply_count":290,"retweet_count":2622,"retweeted":false,"user_id_str":"130537001"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"218434058","indices":[5,20],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"id":"Tm90ZVR3ZWV0OjIwOTU4MzUxNDc4NTM1NTc3NjQ=","text":"Cara @takaichi_sanae, grazie per le tue parole.\nSono onorata di averti come amica e sono molto orgogliosa del rapporto di fiducia e del legame sempre più forte tra Italia e Giappone 🇮🇹🇯🇵\n \nIl 160° anniversario delle nostre relazioni diplomatiche è un’occasione importante per celebrare una storia comune e guardare insieme al futuro.\n \nContinueremo a lavorare fianco a fianco per rendere ancora più forte il nostro Partenariato Strategico Speciale, sviluppando le molte collaborazioni in corso nei settori ad alto contenuto tecnologico, in ambito energetico, nelle infrastrutture e nella difesa."}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2994870,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":530,"tweets":1766},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2095754084502683807"],"editable_until_msecs":"1788505285000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":480,"bookmarked":false,"conversation_id_str":"2095754084502683807","created_at":"Fri Sep 04 06:01:25 +0000 2026","display_text_range":[0,89],"entities":{"user_mentions":[{"id_str":"130537001","indices":[18,32],"name":"Giorgia Meloni","screen_name":"GiorgiaMeloni"}]},"favorite_count":49926,"favorited":false,"full_text":"本日、親愛なる友人であるジョルジャ（@GiorgiaMeloni）が、イタリアにおいて戦後最も長く、途切れることのない形で職務を継続された首相となられたことにお祝い申し上げます。","id_str":"2095754084502683807","is_quote_status":false,"lang":"ja","quote_count":600,"reply_count":1229,"retweet_count":4433,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"130537001","indices":[18,32],"name":"Giorgia Meloni","screen_name":"GiorgiaMeloni"},{"id_str":"130537001","indices":[357,371],"name":"Giorgia Meloni","screen_name":"GiorgiaMeloni"}]},"id":"Tm90ZVR3ZWV0OjIwOTU3NTQwODQzNzI2NjAyMjQ=","richtext":{"richtext_tags":[]},"text":"本日、親愛なる友人であるジョルジャ（@GiorgiaMeloni）が、イタリアにおいて戦後最も長く、途切れることのない形で職務を継続された首相となられたことにお祝い申し上げます。\n\n首相に就任されて以来、イタリア国民の皆様のために、様々な課題に取り組まれてきたジョルジャのたゆまぬ努力に心から敬意を表します。\n\n本年行われた2回の首脳会談を通じて、ジョルジャとの間で友情と信頼関係を確認するとともに、日本とイタリアの関係を更に深めることができました。\n\n本年の外交関係樹立160周年という節目の年に「特別な戦略的パートナー」となった両国の緊密な関係を、共に益々発展させていきたいと思います。\n\nOggi, desidero congratularmi con la mia cara amica Giorgia (@GiorgiaMeloni), per essere diventata il Presidente del Consiglio ad aver ricoperto l’incarico per il periodo più lungo del dopoguerra in Italia, senza interruzioni.\n\nEsprimo il mio più sincero rispetto per gli instancabili sforzi di Giorgia nell'affrontare varie sfide per i cittadini italiani da quando è diventata Presidente del Consiglio dei Ministri.\n\nNel corso dei due vertici Giappone-Italia tenutisi quest'anno, abbiamo potuto confermare la nostra amicizia e fiducia reciproca, e approfondire ulteriormente le relazioni tra Giappone e Italia.\n\nDesidero continuare a sviluppare le strette relazioni tra i nostri due paesi, che quest'anno hanno celebrato il 160° anniversario dell'instaurazione delle relazioni diplomatiche e sono diventati \"partner strategici speciali\"."}}},"rest_id":"2095754084502683807","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"3777581","state":"EnabledWithCount"}}},"rest_id":"2095835147945861419","source":"<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>","unmention_data":{},"views":{"count":"811900","state":"EnabledWithCount"}}},"user_id_str":"218434058"},"rest_id":"2096827409945559351","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"34391","state":"EnabledWithCount"}}}}},"entryId":"tweet-2096827409945559351","sortIndex":"2096998893823721415"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2096824653960597504/uC-cqpLW?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"thumbnail_ima