92","sortIndex":"2096998893823721416"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2994870,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":530,"tweets":1766},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2096827409945559351"],"editable_until_msecs":"1788761186357","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{},"grok_translated_post_with_availability":{"data":{"associated_data":{},"destination_language":"ja","entities":{"hashtags":[],"symbols":[],"urls":[],"user_mentions":[{"id":"218434058","id_str":"218434058","indices":[3,18],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"preview_translation":"カラ @takaichi_sanae、言葉をありがとうございます。  \nあなたを友人として迎えられたことを光栄に思いますし、イタリアと日本の間の信頼関係とますます強まる絆に大変誇りを感じています 🇮🇹🇯🇵  \n\n私たちの外交関係160周年は、共通の歴史を祝い、共に未来を見据える重要な機会です。","source_language":"it","translation":"カラ @takaichi_sanae、言葉をありがとうございます。  \nあなたを友人として迎えられたことを光栄に思いますし、イタリアと日本の間の信頼関係とますます強まる絆に大変誇りを感じています 🇮🇹🇯🇵  \n\n私たちの外交関係160周年は、共通の歴史を祝い、共に未来を見据える重要な機会です。  \n\n私たちは、高度な技術分野、エネルギー分野、インフラ、防衛分野での多くの進行中の協力関係を発展させながら、特別戦略的パートナーシップをさらに強化するために、肩を並べて働き続けます。"},"is_available":true},"is_translatable":true,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2096827409945559351","created_at":"Mon Sep 07 05:06:26 +0000 2026","display_text_range":[0,140],"entities":{"user_mentions":[{"id_str":"130537001","indices":[3,17],"name":"Giorgia Meloni","screen_name":"GiorgiaMeloni"},{"id_str":"218434058","indices":[24,39],"name":"高市早苗","screen_name":"takaichi_sanae"}]},"favorite_count":0,"favorited":false,"full_text":"RT @GiorgiaMeloni: Cara @takaichi_sanae, grazie per le tue parole.\nSono onorata di averti come amica e sono molto orgogliosa del rapporto d…","id_str":"2096827409945559351","is_quote_status":true,"lang":"it","quote_count":0,"quoted_status_id_str":"2095754084502683807","quoted_status_permalink":{"display":"x.com/takaichi_sanae…","expanded":"https://twitter.com/takaichi_sanae/status/2095754084502683807","url":"https://t.co/3OeDN4xRPM"},"reply_count":0,"retweet_count":2622,"retweete