ated_access":true,"id":"VXNlcjozMDM3MzU2MjU=","is_blue_verified":true,"location":{"location":"Tokyo"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2096879062816063588"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"The Official English Account of the Ministry of Foreign Affairs of Japan.\nSocial Media List: https://t.co/PnH9N7WcqL","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/about/list_en.…","expanded_url":"https://www.mofa.go.jp/about/list_en.html","indices":[93,116],"url":"https://t.co/PnH9N7WcqL"}]},"url":{"urls":[{"display_url":"mofa.go.jp","expanded_url":"http://www.mofa.go.jp/","indices":[0,23],"url":"https://t.co/jDWRcTicQE"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":152320,"following":179},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8564,"tweets":19475},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2096919788329336923"],"editable_until_msecs":"1788783211000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":true,"legacy":{"bookmark_count":89,"bookmarked":false,"conversation_id_str":"2096919788329336923","created_at":"Mon Sep 07 11:13:31 +0000 2026","display_text_range":[0,280],"entities":{},"favorite_count":985,"favorited":false,"full_text":"The Chinese Embassy in Japan again posted on X regarding issues including the so-called “enemy State” clauses in the Charter of the United Nations.\nAs posted before, regarding the so-called “enemy State” clauses in the Charter of the United Nations, a resolution recognizing it as","id_str":"2096919788329336923","is_quote_status":true,"lang":"en","quote_count":22,"quoted_status_id_str":"1992511156913901804","quoted_status_permalink":{"display":"x.com/MofaJapan_en/s…","expanded":"https://twitter.com/MofaJapan_en/status/1992511156913901804","url":"https://t.co/hotlmlhCbB"},"reply_count":60,"retweet_count":338,"retweeted":false,"user_id_str":"303735625"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTY5MTk3ODgyMzcwMDQ4MDE=","richtext":{"richtext_tags":[]},"text":"The Chinese Embassy in Japan again posted on X regarding issues including the so-called “enemy State” clauses in the Charter of the United Nations.\nAs posted before, regarding the so-called “enemy State” clauses in the Charter of the United Nations, a resolution recognizing it as obsolete was adopted by an overwhelming majority at the 1995 UN General Assembly, with China itself casting a vote in favor. Furthermore, at the 2005 UN World Summit, a General Assembly resolution was adopted stipulating the resolution of all Member State leaders to delete references to “enemy States” from the UN Charter, with China also joining the consensus.\nPosting information implying that obsolete clauses remain in effect is incompatible with such resolutions already adopted at the United Nations which China itself supported.\nSince the end of World War II, Japan has consistently contributed to peace and prosperity in the international community as a peace-loving nation. This is widely recognized in the international community."}}},"quotedRefResult":{"result":{"__typename":"Tweet","rest_id":"1992511156913901804"}},"rest_id":"2096919788329336923","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"134318","state":"EnabledWithCount"}}},"rest_id":"2096921834596016393","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"45814","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2096921832612110833","2096921834596016393"],"enableDeduplication":true}}},"entryId":"list-conversation-2096998893823721474","sortIndex":"2096998893823721470"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2094434707140485120/w1QyFFFL?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.mof.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":200,"url":"https://pbs.twimg.com/card_img/2094434707140485120/w1QyFFFL?format=png&name=280x280_2","width":200},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":203,"url":"https://pbs.twimg.com/card_img/2094434707140485120/w1QyFFFL?format=png&name=orig","width":200},"type":"IMAGE"}},{"key":"thumbnail_image_small","value":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2094434707140485120/w1QyFFFL?format=png&name=100x100_2","width":100},"type":"IMAGE"}},{"key":"thumbnail_image_x_large","value":{"image_value":{"height":203,"url":"https://pbs.twimg.com/card_img/2094434707140485120/w1QyFFFL?format=png&name=2048x2048_2_exp","width":2