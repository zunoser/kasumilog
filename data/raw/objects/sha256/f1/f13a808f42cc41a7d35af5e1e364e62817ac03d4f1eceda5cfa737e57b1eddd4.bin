:{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2072976218283274240/uNvLKeoI_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2070308568658767872/1782467472"},"core":{"created_at":"Fri Jun 26 01:14:19 +0000 2026","name":"防衛省あぐいん報道官","screen_name":"PressSec_JMOD"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMDcwMzA4NTY4NjU4NzY3ODcy","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"防衛省報道官が投稿する公式アカウントです。国民の皆様にもっと防衛省・自衛隊を知っていただけるよう、報道官の目線から情報発信していきます。防衛省からの公式発信は@ModJapan_JPをご確認ください。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp","expanded_url":"https://www.mod.go.jp","indices":[0,23],"url":"https://t.co/BLdQ6H2TQ1"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":39934,"following":7},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"2070308568658767872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":98,"tweets":429},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/BLdQ6H2TQ1"}}}},"edit_control":{"edit_tweet_ids":["2110923362222661925"],"editable_until_msecs":"1792121923000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":7,"bookmarked":false,"conversation_id_str":"2110923362222661925","created_at":"Fri Oct 16 02:38:43 +0000 2026","display_text_range":[0,145],"entities":{},"favorite_count":297,"favorited":false,"full_text":"【10月16日　小泉防衛大臣会見】\n冒頭、インドネシア共和国における国際緊急援助活動終了に伴う輸送艦「くにさき」の帰国、日マレーシア防衛相会談の実施について発表しました。\n \nその他、\n○太平洋における中国海軍の動向\n○日米共同統合演習「キーン・ソード27」\nに関する質疑応答がありました。","id_str":"2110923362222661925","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":7,"retweet_count":48,"retweeted":false,"user_id_str":"2070308568658767872"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"youtu.be/CwcKNGaRAcQ?si…","expanded_url":"https://youtu.be/CwcKNGaRAcQ?si=vcY-m_Ln4pF4jbTa","indices":[969,992],"url":"https://t.co/vXKwSwqsYB"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTA5MjMzNjIwNTkwNjMyOTY=","text":"【10月16日　小泉防衛大臣会見】\n冒頭、インドネシア共和国における国際緊急援助活動終了に伴う輸送艦「くにさき」の帰国、日マレーシア防衛相会談の実施について発表しました。\n \nその他、\n○太平洋における中国海軍の動向\n○日米共同統合演習「キーン・ソード27」\nに関する質疑応答がありました。\n \n↓発表事項の全文はこちら\n「今日は、冒頭２件あります。１点目は、インドネシア関係です。インドネシア共和国における山林火災に対する国際緊急援助活動について、現地へ派遣されていた輸送艦「くにさき」は、本日、海上自衛隊横須賀地区に帰国いたしました。\n \n今回の活動では、ＣＨ－４７輸送ヘリコプター３機により、延べ５６回の消火活動を実施し、計約２８０トンの水を放水しました。困難な環境でも着実に任務を遂行したことは、インドネシアでも高い信頼と評価を受け、９月３０日にはシャフリィ国防大臣から直接表彰を受け、全隊員に対してメダルが授与されました。世界で輝く自衛隊の活躍を心から誇りに思います。\n \nそして、あさって１８日には、海上自衛隊横須賀地区において帰国行事が計画されており、私も当日、彼らを直接出迎え、その労をねぎらいたいと思います。\n \n防衛省・自衛隊としては、引き続き、国際社会の一員として、人道的観点から必要な支援に積極的に取り組んでいきたいと思います。そして、今回培われた信頼を礎として、インドネシアとの防衛協力を一層深めてまいります。\n \nそして、２点目は、マレーシア防衛大臣会談の実施です。来週１０月１８日から２１日まで、マレーシアのカレド・ノルディン国防大臣が訪日し、１９日（月）には日・マレーシア防衛大臣会談を実施する予定です。\n \nマレーシアは、我が国と基本的な価値や原則を共有する包括的・戦略的パートナーです。今回のカレド国防大臣の訪日は、マレーシアの国防大臣としては８年ぶりの訪日であり、今回、カレド大臣と初めて日本で会談できることを大変うれしく思います。\n \n防衛相会談では、地域情勢の意見交換や海洋安全保障をはじめ、日・マレーシア防衛協力の一層の強化に向けた率直で具体的な議論を行う予定です。また、今回の訪日を機に、カレド大臣と強固な信頼関係を築いていきたいと考えています。冒頭は２点、以上です。」\n \n↓動画はこちら\nhttps://t.co/vXKwSwqsYB"}}},"rest_id":"2110923362222661925","unmention_data":{},"views":{"count":"26023","state":"EnabledWithCount"}}},"user_id_str":"268732024"},"rest_id":"2110923584151679049","source":"<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>","unmention_data":{},"views":{"count":"4313","state":"EnabledWithCount"}}}}},"entryId":"tweet-2110923584151679049","sortIndex":"2111071115475419042"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Top","entryType":"TimelineTimelineCursor","value":"DAABCgABHUwH_p2AJxEKAAIdTAK5LxrxywgAAwAAAAEAAA"},"entryId":"cursor-top-2111071115475419137","sortIndex":"2111071115475419137"},{"content":{"__typename":"TimelineTimelineCursor","cursorType":"Bottom","entryType":"TimelineTimelineCursor","value":"DAABCgABHUwH_p1__58KAAIdS4HQzVrwSQgAAwAAAAIAAA"},"entryId":"cursor-bottom-2111071115475419041","sortIndex":"2111071115475419041"}],"type":"TimelineAddEntries"}],"metadata":{"scribeConfig":{"page":"list_tweets"}}}}}}}