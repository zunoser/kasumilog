:"fit","w":1004},"small":{"h":680,"resize":"fit","w":656},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/zVmxc9jRVB"}]},"favorite_count":21,"favorited":false,"full_text":"🚁ドローン講習潜入レポ🔍\n10/3～4に ＃大分県  ＃消防学校 で ＃消防団 員向け ＃ドローン 操作講習を開催❗\n講習は夕暮れの時間にも実施しました🌆災害は昼夜を問わず発生します🚨\n日中とは異なる環境での注意点も確認し、実践的な運用技術の向上を図りました🌛🌠\n\n＃DX　＃総務省消防庁 https://t.co/zVmxc9jRVB","id_str":"2108498581170892983","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":4,"retweeted":false,"user_id_str":"1682374304993005569"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[21,25],"text":"大分県"},{"indices":[27,32],"text":"消防学校"},{"indices":[35,39],"text":"消防団"},{"indices":[44,49],"text":"ドローン"},{"indices":[133,136],"text":"DX"},{"indices":[137,144],"text":"総務省消防庁"},{"indices":[145,151],"text":"おんせん県"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDg0OTg1ODExMTYzOTU1MjA=","richtext":{"richtext_tags":[]},"text":"🚁ドローン講習潜入レポ🔍\n10/3～4に ＃大分県  ＃消防学校 で ＃消防団 員向け ＃ドローン 操作講習を開催❗\n講習は夕暮れの時間にも実施しました🌆災害は昼夜を問わず発生します🚨\n日中とは異なる環境での注意点も確認し、実践的な運用技術の向上を図りました🌛🌠\n\n＃DX　＃総務省消防庁　＃おんせん県♨"}}},"rest_id":"2108498581170892983","unmention_data":{},"views":{"count":"5175","state":"EnabledWithCount"}}},"user_id_str":"137272821"},"rest_id":"2111042189644243184","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"1089","state":"EnabledWithCount"}}}}},"entryId":"tweet-2111042189644243184","sortIndex":"2111071115475419123"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":3015283,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":583,"tweets":1869},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2111040513214382411"],"editable_until_msecs":"1792149854000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":85,"bookmarked":false,"conversation_id_str":"2111040513214382411","created_at":"Fri Oct 16 10:24:14 +0000 2026","display_text_range":[0,67],"entities":{},"favorite_count":6254,"favorited":false,"full_text":"本日、日本で初となる、茶道、華道、書道、食文化などの「生活文化」に関する「人間国宝」の認定について、「文化審議会答申」がなされました。","id_str":"2111040513214382411","is_quote_status":false,"lang":"ja","quote_count":78,"reply_count":406,"retweet_count":678,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMTEwNDA1MTMxNDczODM4MDg=","richtext":{"richtext_tags":[]},"text":"本日、日本で初となる、茶道、華道、書道、食文化などの「生活文化」に関する「人間国宝」の認定について、「文化審議会答申」がなされました。\n\n「人間国宝」とは、『文化財保護法』に基づいて、芸能や工芸技術などの特に価値の高い「わざ」の高度な体得者などとして、「重要無形文化財」の保持者又は保持団体に認定された皆様のことです。\n\nこの「重要無形文化財制度」は、昭和29年に創設されたものですが、昨年、約70年ぶりに、分野が拡大され、茶道、華道、書道、食文化などの「生活文化」が対象となりました。\n\nこの度、以下の３名の皆様が、「人間国宝」の認定について「答申」されましたが、その皆様のこれまでの御功績に敬意を表しますとともに、心よりお祝い申し上げます。\n\n1人目は、華道「立花（りっか）」について、「池坊専永（いけのぼう せんえい）様」です。\n「立花」は、草木や花を用いて、自然の風景や生命の営みを一つの花器の中に表現する、華道の伝統的な様式であり、池坊様は長年にわたりその技法と精神を受け継ぎ、その継承に尽力しておられます。\n\n2人目は、酒「吟醸造り（ぎんじょうづくり）」について、「農口尚彦（のぐち なおひこ）様」です。\n「吟醸造り」は、香りや味わいを追求した日本酒造りのわざであり、農口様は70年以上にわたって酒造りに携わり、日本の吟醸酒の発展を牽引しておられます。\n\n3人目は、料理「京料理（会席）」について、「髙橋英一（たかはし えいいち）様」です。\n「京料理（会席）」は、季節感やもてなしの心を表現する京都の伝統的な料理文化であり、髙橋様は老舗料亭「瓢亭（ひょうてい）」の料理人として伝統を継承・発展させ、わざの公開などにより、日本料理全体の発展に貢献しておられます。\n\n今後も、我が国の長い歴史の中で培われた伝統を大切にし、貴重な文化を適切に保存・活用し、次代へ継承してまいりましょう。"}}},"rest_id":"2111040513214382411","unmention_data":{},"views":{"count":"156934","state":"EnabledWithCount"}}}}},"entryId":"tweet-2111040513214382411","sortIndex":"2111071115475419122"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemCo