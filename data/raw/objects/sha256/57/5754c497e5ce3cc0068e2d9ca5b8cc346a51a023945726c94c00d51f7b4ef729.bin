ted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1440464873708605443/Bw8DmKFs_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/266566401/1667205513"},"core":{"created_at":"Tue Mar 15 12:52:50 +0000 2011","name":"経済産業省","screen_name":"meti_NIPPON"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjY1NjY0MDE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関１－３－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2085952779030499393"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"経済産業省の公式アカウントです。災害関連投稿は「#meti_saigai」 、 大臣動静は 「#meti_daijin 」で抽出ください。英語版Xはこちら @METI_JPN。\n公式インスタはこちら《https://t.co/XBW3ZNrTnn》","entities":{"description":{"urls":[{"display_url":"instagram.com/meti_japan/","expanded_url":"https://www.instagram.com/meti_japan/","indices":[100,123],"url":"https://t.co/XBW3ZNrTnn"}]},"url":{"urls":[{"display_url":"meti.go.jp","expanded_url":"http://www.meti.go.jp/","indices":[0,23],"url":"https://t.co/3tgZ0wGHvI"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":394849,"following":90},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"266566401","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":5404,"tweets":23208},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/3tgZ0wGHvI"}}}},"edit_control":{"edit_tweet_ids":["2103359305185743327"],"editable_until_msecs":"1790318511000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":1,"bookmarked":false,"conversation_id_str":"2103359305185743327","created_at":"Fri Sep 25 05:41:51 +0000 2026","display_text_range":[0,136],"entities":{"hashtags":[{"indices":[117,123],"text":"台風25号"},{"indices":[124,136],"text":"meti_saigai"}]},"favorite_count":9,"favorited":false,"full_text":"【台風第25号関連アナウンス】\n太陽光パネルは、浸水・破損した場合でも、日の光が当たると発電し、感電やショートによる火災の可能性があるため、むやみに近づかないようにご注意ください。また、復旧作業にあたられる際にも十分ご留意ください。\n#台風25号 #meti_saigai","id_str":"2103359305185743327","is_quote_status":false,"lang":"ja","quote_count":1,"reply_count":4,"retweet_count":8,"retweeted":false,"user_id_str":"266566401"},"rest_id":"2103359305185743327","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2898","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103359305185743327","sortIndex":"2103391427378544621"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2998596,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":545,"tweets":1803},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNdzy0"}}}},"edit_control":{"edit_tweet_ids":["2103357254544302326"],"editable_until_msecs":"1790318022000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":105,"bookmarked":false,"conversation_id_str":"2103357254544302326","created_at":"Fri Sep 25 05:33:42 +0000 2026","display_text_range":[0,81],"entities":{},"favorite_count":6012,"favorited":false,"full_text":"「台風第25号」に伴う大雨や土砂災害などによって、これまでに千葉県や神奈川県で10名を超える方々が犠牲になられたほか、今も行方不明の方々の救助活動が続いています。","id_str":"2103357254544302326","is_quote_status":false,"lang":"ja","quote_count":150,"reply_count":513,"retweet_count":744,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDMzNTcyNTQ0ODEzODc1MjA=","richtext":{"richtext_tags":[]},"text":"「台風第25号」に伴う大雨や土砂災害などによって、これまでに千葉県や神奈川県で10名を超える方々が犠牲になられたほか、今も行方不明の方々の救助活動が続いています。\n\nまた、千葉県佐倉市など印旛沼周辺の地域では大きな浸水被害が発生し、堤防が決壊した北印旛沼や長門川では今も浸水が続いています。\nこのほか、千葉県を中心に停電や断水、鉄道の運転見合わせ、道路の寸断など、各地で大きな被害が発生しています。\n\nお亡くなりになられた方々に哀悼の誠を捧げますとともに、謹んでご遺族の皆様にお悔やみを申し上げます。\n\nそして、被害に遭われたすべての方々に、心よりお見舞いを申し上げます。\n\n＜災害対応の状況について＞\n\n今般の台風に際し、政府としては、官邸に「官邸連絡室」を設置した上で、「関係省庁災害警戒会議」を開催し、自治体と緊密に連携を図りながら、被害状況の把握、人命第一の方針の下で災害応急対策などに当たっています。\n\n警察、消防、自衛隊が土砂災害の現場で救助活動を行っているほか、「TEC-FORCE」（国土交通省 緊急災害対策派遣隊）や「MAFF-SAT」（農林水産省 サポート・アドバイス・チーム）など、各省庁の職員が、県や自治体と連携して、千葉県や神奈川県などで活動を行っています。\n\n＜印旛沼周辺の地域での浸水被害などへの対応について＞\n\n印旛沼周辺の地域での浸水被害については、排水機場を最大限稼働させるとともに、排水ポンプ車を30台まで増強するなど、浸水の解消に当たっています。\n\n決壊した北印旛沼や長門川の堤防についても、技術支援のため「TEC-FORCE」を派遣し、大手建設業者と連携して、現地の状況確認、施工方法の技術的な支援などを行っており、早期の応急復旧に向けて、全力で取り組んでいます。\n\n停電や断水などインフラの復旧についても、関係事業者などと連携し、力を尽くしています。\n\n＜「激甚災害」の指定について＞\n\n「台風第25号」については、「梅雨前線から千葉豪雨までの一連の気象現象」と一連性があると判断しており、農地等に係る「本激」の指定を見込んでいます。\n\n自治体や関係省庁とともに、関係施設の被害状況の把握を急いでまいります。\n\n日本の南の海上では、「台風第26号」が発生し、今後沖縄地方に接近するとともに、本州でも大雨が長期間継続する可能性があります。\n\n政府として、救助活動、応急復旧など「台風第25号」の災害応急対応に全力を尽くすとともに、今後の警戒も怠らず、緊張感を持って臨んでまいります。"}}},"rest_id":"2103357254544302326","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"289388","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103357254544302326","sortIndex":"2103391427378544620"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","