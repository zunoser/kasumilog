":true},"display_url":"pic.x.com/Cw2BRGIYsG","expanded_url":"https://x.com/takaichi_sanae/status/2103109377049948278/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103109311732011008","indices":[72,95],"media_key":"3_2103109311732011008","media_results":{"result":{"media_key":"3_2103109311732011008"}},"media_url_https":"https://pbs.twimg.com/media/HS--xrmaUAAVQ4K.jpg","original_info":{"focus_rects":[{"h":664,"w":1185,"x":0,"y":157},{"h":821,"w":821,"x":270,"y":0},{"h":821,"w":720,"x":320,"y":0},{"h":821,"w":411,"x":475,"y":0},{"h":821,"w":1185,"x":0,"y":0}],"height":821,"width":1185},"sizes":{"large":{"h":821,"resize":"fit","w":1185},"medium":{"h":821,"resize":"fit","w":1185},"small":{"h":471,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Cw2BRGIYsG"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/Cw2BRGIYsG","expanded_url":"https://x.com/takaichi_sanae/status/2103109377049948278/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":60,"w":60,"x":220,"y":201}]},"medium":{"faces":[{"h":60,"w":60,"x":220,"y":201}]},"orig":{"faces":[{"h":60,"w":60,"x":220,"y":201}]},"small":{"faces":[{"h":39,"w":39,"x":144,"y":132}]}},"id_str":"2103109333966008320","indices":[72,95],"media_key":"3_2103109333966008320","media_results":{"result":{"media_key":"3_2103109333966008320"}},"media_url_https":"https://pbs.twimg.com/media/HS--y-baMAASY1C.jpg","original_info":{"focus_rects":[{"h":578,"w":1033,"x":0,"y":237},{"h":815,"w":815,"x":218,"y":0},{"h":815,"w":715,"x":318,"y":0},{"h":815,"w":408,"x":544,"y":0},{"h":815,"w":1033,"x":0,"y":0}],"height":815,"width":1033},"sizes":{"large":{"h":815,"resize":"fit","w":1033},"medium":{"h":815,"resize":"fit","w":1033},"small":{"h":536,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/Cw2BRGIYsG"}]},"favorite_count":10711,"favorited":false,"full_text":"今週22日、タイ王国にて、経済産業省・在タイ日本国大使館・日本貿易振興機構（JETRO）による「日本食輸出促進レセプション」が開催されました。 https://t.co/Cw2BRGIYsG","id_str":"2103109377049948278","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":98,"reply_count":866,"retweet_count":992,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDMxMDkzNzY5Nzg2MDgxMjg=","richtext":{"richtext_tags":[]},"text":"今週22日、タイ王国にて、経済産業省・在タイ日本国大使館・日本貿易振興機構（JETRO）による「日本食輸出促進レセプション」が開催されました。\n\n参加いただいたエーカナット・タイエネルギー大臣や、タイの食品流通に強い財閥のトップに、赤澤経済産業大臣自らトップセールスを行うとともに、タイのインフルエンサーにも、日本の食の魅力を発信しました。\n\nレセプションでは、日本が一丸となって市場づくりを目指す「日本産ノングルテン米粉」（グルテン含有量がグルテンフリー米粉よりも20倍厳しい基準を満たす米粉）を使用した麺料理やデザートをはじめ、日本産食材使用の料理が提供されました。\n\n出席者の皆様から、「日本の食輸出を進める上で、日本食を好むタイは正しい選択」「産地の品質を消費者まで届けきるコールドチェーンの整備を期待」などの声をいただいたと伺っております。\n\n高市内閣では、農林水産物・食品の輸出額を2030年に5兆円とする目標を掲げており、海外需要の獲得に向けた「販路の拡大」と、農林水産物・食品の供給力の向上に向けた「輸出産地・プレーヤーの育成支援」を、両輪で推進しています。\n\n「農林水産大臣とも協力して、農林水産物・食品の輸出拡大に取り組むように」との私から赤澤大臣への指示を踏まえ、本年4月に「日本の食輸出1万者支援プログラム」が立ち上げられました。\n今回のレセプションも、この「プログラム」の一環として開催されました。\n農林水産物・食品の輸出拡大の足掛かりとしてまいります。\n\n（参考）ノングルテンの米粉について\n欧米の基準であるグルテン含有量20ppm以下の「グルテンフリー」に対し、日本独自の「ノングルテン」は、我が国の世界最高水準検査法を活用した、世界でも類を見ないグルテン含有量1ppm以下の米粉です。\nノングルテン米粉はグルテンフリー製品と差別化し、より高い安全性を提供しています。"}}},"rest_id":"2103109377049948278","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"329032","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103109377049948278","sortIndex":"2103391427378544573"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__type