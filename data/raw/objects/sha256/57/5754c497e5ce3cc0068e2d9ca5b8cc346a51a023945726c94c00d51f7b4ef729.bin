a_attention"}]},"favorite_count":0,"favorited":false,"full_text":"RT @fsa_attention: 「無登録で金融商品取引業を行う者の名称等」を更新しました。\n#無登録 の業者が、金融商品取引法上の登録を得ずに #店頭デリバティブ取引 の勧誘等を行うことは禁止されております。\n\nhttps://t.co/j4K6NzH4V5\n\n#ZOOM…","id_str":"2103304453382340616","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":6,"retweeted":false,"retweeted_status_result":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":13},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1186885991186882561/39FIFdT__normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1186871382442831872/1690334722"},"core":{"created_at":"Wed Oct 23 05:10:56 +0000 2019","name":"金融庁金融トラブル注意喚起情報","screen_name":"fsa_attention"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxMTg2ODcxMzgyNDQyODMxODcy","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関３－２－１"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["1678599303013761024"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"金融トラブルに関する金融庁の公式アカウントです。\n金融トラブルについて注意喚起情報を発信します。悪質な投稿に対して返信機能を使って注意喚起することもあります。\nhttps://t.co/atLkhj7eFv","entities":{"description":{"urls":[{"display_url":"fsa.go.jp/copyright/soci…","expanded_url":"https://www.fsa.go.jp/copyright/socialmedia.html","indices":[80,103],"url":"https://t.co/atLkhj7eFv"}]},"url":{"urls":[{"display_url":"fsa.go.jp/ordinary/chuui…","expanded_url":"https://www.fsa.go.jp/ordinary/chuui/kinyu_chuui.html","indices":[0,23],"url":"https://t.co/LzledB9M9a"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":5661,"following":5},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1186871382442831872","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":2799,"tweets":4078},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/LzledB9M9a"}}}},"edit_control":{"edit_tweet_ids":["2103303856096764068"],"editable_until_msecs":"1790305291000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2103303856096764068","created_at":"Fri Sep 25 02:01:31 +0000 2026","display_text_range":[0,162],"entities":{"hashtags":[{"indices":[30,34],"text":"無登録"},{"indices":[56,67],"text":"店頭デリバティブ取引"},{"indices":[115,122],"text":"ZOOMEX"},{"indices":[123,139],"text":"BABA_INVESTMENT"},{"indices":[140,148],"text":"D_Prime"},{"indices":[149,162],"text":"Spec_Trading"}],"media":[{"display_url":"pic.x.com/H01JyRlCQf","expanded_url":"https://x.com/fsa_attention/status/2103303856096764068/photo/1","ext_alt_text":"金融庁ウェブサイトでは、無登録で金融商品取引業を行う者の名称等について公表しております。\n掲載されている無登録業者は、警告書の発出を行った時点で無登録営業を行っていることが確認できた者に限られています。そのため、掲載されていない者であっても、無登録営業に該当する行為を行っていることがあり得ますのでご注意ください。\n掲載されている無登録業者について、必ずしも、現在の無登録営業の状況を示すものではありません。また、その名称及び所在地等についても、現時点のものでない場合があります。\n掲載されている無登録業者は、財務省の総合出先機関である財務局が、金融庁の委任を受け、警告を行ったものを含みます。\n警告書の発出は行っていないものの、証券取引等監視委員会において、金融商品取引法第192条第1項に基づく裁判所への禁止及び停止命令発出の申立てを行った無登録業者については、広く周知する観点から、証券取引等監視委員会の公表にあわせ掲載されています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103303848215662592","indices":[163,186],"media_key":"