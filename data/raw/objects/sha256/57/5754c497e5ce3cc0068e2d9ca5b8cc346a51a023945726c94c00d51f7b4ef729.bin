","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2103319939235160372"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":589350,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303730149","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20213,"tweets":48909},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2103102281231323323"],"editable_until_msecs":"1790257232000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":2885,"bookmarked":false,"conversation_id_str":"2103102281231323323","created_at":"Thu Sep 24 12:40:32 +0000 2026","display_text_range":[0,113],"entities":{},"favorite_count":61918,"favorited":false,"full_text":"中国は、死文化している国連憲章のいわゆる「旧敵国条項」が未だ有効であるかのように、同条項に関する彼らの立場について再び発信を行いました。このような発信は、国連で既に採択され、中国も採択を支持した関連の決議と相容れないものです。","id_str":"2103102281231323323","is_quote_status":false,"lang":"ja","quote_count":1265,"reply_count":1604,"retweet_count":13367,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDMxMDIyODExODA5MDU0NzQ=","richtext":{"richtext_tags":[]},"text":"中国は、死文化している国連憲章のいわゆる「旧敵国条項」が未だ有効であるかのように、同条項に関する彼らの立場について再び発信を行いました。このような発信は、国連で既に採択され、中国も採択を支持した関連の決議と相容れないものです。\n中国は、国連憲章のいわゆる「旧敵国条項」について、時代遅れとなり、既に死文化したとの認識を規定した１９９５年（平成７年）の国連総会決議に賛成票を投じており、また、国連憲章から「敵国」への言及を削除するとの全加盟国首脳の決意を規定した２００５年（平成１７年）の国連総会決議のコンセンサスにも加わっています。国連安保理常任理事国たる中国として、自身が採択を支持したこれら決議を尊重するよう期待します。\n日本は、戦後一貫して平和国家として国際社会の平和と繁栄に貢献してきています。こうした点は国際社会でも広く認識されています。高市総理の一般討論演説においても述べたとおり、引き続き、我が国の立場や取組をしっかりと説明・発信していきます。"}}},"rest_id":"2103102281231323323","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"4512831","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2103391427378544706-tweet-2103111376801824929","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"Or