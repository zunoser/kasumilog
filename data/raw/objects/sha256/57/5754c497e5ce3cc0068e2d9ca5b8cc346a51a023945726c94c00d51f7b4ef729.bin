49/QaRdW4oU_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303735625/1782867162"},"core":{"created_at":"Mon May 23 10:32:05 +0000 2011","name":"MOFA of Japan","screen_name":"MofaJapan_en"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzU2MjU=","is_blue_verified":true,"location":{"location":"Tokyo"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2103368078172340684"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"The Official English Account of the Ministry of Foreign Affairs of Japan.\nSocial Media List: https://t.co/PnH9N7WcqL","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/about/list_en.…","expanded_url":"https://www.mofa.go.jp/about/list_en.html","indices":[93,116],"url":"https://t.co/PnH9N7WcqL"}]},"url":{"urls":[{"display_url":"mofa.go.jp","expanded_url":"http://www.mofa.go.jp/","indices":[0,23],"url":"https://t.co/jDWRcTicQE"}]}}},"profile_description_language":"en","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":153133,"following":179},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"303735625","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":8633,"tweets":19572},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/jDWRcTicQE"}}}},"edit_control":{"edit_tweet_ids":["2103111094655242248"],"editable_until_msecs":"1790259333000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":true,"legacy":{"bookmark_count":198,"bookmarked":false,"conversation_id_str":"2103111094655242248","created_at":"Thu Sep 24 13:15:33 +0000 2026","display_text_range":[0,273],"entities":{},"favorite_count":5030,"favorited":false,"full_text":"China again posted on X their view on the so-called “enemy State” clauses in the Charter of the United Nations, implying that these obsolete clauses remain in effect. Such postings are incompatible with relevant resolutions that were adopted at the United Nations and China","id_str":"2103111094655242248","is_quote_status":false,"lang":"en","quote_count":46,"reply_count":138,"retweet_count":1436,"retweeted":false,"user_id_str":"303735625"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDMxMTEwOTQ1NzEyOTQ3MjA=","richtext":{"richtext_tags":[]},"text":"China again posted on X their view on the so-called “enemy State” clauses in the Charter of the United Nations, implying that these obsolete clauses remain in effect. Such postings are incompatible with relevant resolutions that were adopted at the United Nations and China supported to adopt.\nChina cast a vote in favor of the UNGA RES 1995, recognizing the clauses to have become obsolete. China also joined the consensus on the UNGA RES 2005, expressing the resolve of the leaders of the Member States to delete the clauses. We expect China, as a permanent member of the UN Security Council, to respect these resolutions that China supported to adopt.\nSince the end of World War II, Japan has consistently contributed to peace and prosperity in the international community as a peace-loving nation. This is widely recognized in the international community. Japan will continue to clearly articulate and communicate its views and policies as Prime Minister Takaichi did with her general debate speech."}}},"rest_id":"2103111094655242248","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"516281","state":"EnabledWithCount"}}},"rest_id":"2103111376801824929","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"359868","state":"EnabledWithCount"}}}}}}],"metadata":{"conversationMetadata":{"allTweetIds":["2103102281231323323","2103111376801824929"],"enableDeduplication":true}}},"entryId":"list-conversation-2103391427378544706","sortIndex":"2103391427378544574"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1790225212"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNdzy0"}]}}},"prof