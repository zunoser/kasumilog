日本・韓国青年親善交流事業\n＼\n日韓青年は東京プログラムに参加し、内閣府へ表敬訪問。\nロボットカフェで遠隔による接客を体験し、デジタル社会への理解を深めました。\nその後、韓国青年は長崎県へ出発。✨\n#青年国際交流 #日韓交流  #グローバル人材 #グローバルリーダー #内閣府 https://t.co/Wdeoe3NDwF","id_str":"2103074242774684035","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":6,"retweeted":false,"user_id_str":"2958995318"},"rest_id":"2103074242774684035","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"821","state":"EnabledWithCount"}}},"user_id_str":"2904127170"},"rest_id":"2103373280497533126","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"212","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103373280497533126","sortIndex":"2103391427378544628"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2103391427378544653-tweet-2103372445738750230","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":8},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_reques