":140,"w":250,"x":150,"y":0},{"h":140,"w":140,"x":240,"y":0},{"h":140,"w":123,"x":249,"y":0},{"h":140,"w":70,"x":275,"y":0},{"h":140,"w":400,"x":0,"y":0}],"height":140,"width":400},"sizes":{"large":{"h":140,"resize":"fit","w":400},"medium":{"h":140,"resize":"fit","w":400},"small":{"h":140,"resize":"fit","w":400},"thumb":{"h":140,"resize":"crop","w":140}},"type":"photo","url":"https://t.co/dF6A4WS4UJ"}]},"favorite_count":6,"favorited":false,"full_text":"＼IPランドスケープ　オンラインセミナー開催／\n💡生成AIが進展する時代、IPランドスケープに求められる価値とは何か？\n\n「AI時代にIPランドスケープはどう変わるのか\n ～経営課題に迫るための『調査』の“その先”へ～」 https://t.co/dF6A4WS4UJ","id_str":"2088143581622247830","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":2,"retweeted":false,"user_id_str":"719342924857626624"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[371,377],"text":"INPIT"},{"indices":[379,389],"text":"IPランドスケープ"},{"indices":[390,395],"text":"生成AI"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"inpit.go.jp/katsuyo/ipl/in…","expanded_url":"https://www.inpit.go.jp/katsuyo/ipl/index.html","indices":[346,369],"url":"https://t.co/BYZ2tr4pHq"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwODgxNDM1ODE1MDA2Mjg5OTM=","text":"＼IPランドスケープ　オンラインセミナー開催／\n💡生成AIが進展する時代、IPランドスケープに求められる価値とは何か？\n\n「AI時代にIPランドスケープはどう変わるのか\n ～経営課題に迫るための『調査』の“その先”へ～」\n\n本セミナーでは、「AI時代におけるIPランドスケープの価値を再定義する」をテーマとした全4回シリーズの第1回として、基調講演とパネルディスカッションを開催します。\nAIを活用しながら経営課題を捉え、意思決定につながる示唆を導き出すために何が必要なのか。\nIPランドスケープの実践に携わる専門家とともに、その可能性を考えます✨\n\n📅日時\n2026年9月14日（月）16:00～18:00\n\n💻開催形式：オンライン（Zoom）\n💰参加費：無料\n\n🔗詳細・お申込みはこちら\nhttps://t.co/BYZ2tr4pHq\n\n#INPIT  #IPランドスケープ #生成AI"}}},"rest_id":"2088143581622247830","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"3107","state":"EnabledWithCount"}}},"rest_id":"2103288376137015746","source":"<a href=\"http://twitter.com\" rel=\"n