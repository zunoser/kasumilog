た場合は、まずはご加入の「損害保険会社」または「損害保険代理店」にご相談ください。 詳細は以下からご覧ください。\n【特別措置等】https://t.co/21t3HQHRNX\n【業者とのトラブル】https://t.co/hQzXO9UHNM\n\n#台風 #自然災害 #千葉県 #東京都 #相談窓口 #損害保険 #火災保険 #自動車保険 #傷害保険 #消費者トラブル #災害便乗商法 #損保協会"}}},"rest_id":"2103036801439183218","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"2949","state":"EnabledWithCount"}}},"user_id_str":"276848601"},"rest_id":"2103053873124643251","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"835","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103053873124643251","sortIndex":"2103391427378544559"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":29},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2011671787697029123/GbiAhFPe_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2916368839/1785238079"},"core":{"created_at":"Tue Dec 02 07:37:39 +0000 2014","name":"海上保安庁","screen_name":"JCG_koho"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyOTE2MzY4ODM5","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関2‐1‐3"},"media_permissions":{"can_media_tag":false},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"海上保安庁公式アカウントです。海上保安庁ホームページの新着情報を中心に、国民の皆さまにお知らせしたい情報を発信していきます。\n\n運用ポリ