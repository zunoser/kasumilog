AAVN-7.jpg","original_info":{"focus_rects":[{"h":1529,"w":2731,"x":0,"y":1591},{"h":2731,"w":2731,"x":0,"y":990},{"h":3113,"w":2731,"x":0,"y":799},{"h":4096,"w":2048,"x":0,"y":0},{"h":4096,"w":2731,"x":0,"y":0}],"height":4096,"width":2731},"sizes":{"large":{"h":2048,"resize":"fit","w":1366},"medium":{"h":1200,"resize":"fit","w":800},"small":{"h":680,"resize":"fit","w":453},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/RDzQVQBOsO"},{"display_url":"pic.x.com/RDzQVQBOsO","expanded_url":"https://x.com/Kyoto_Geihinkan/status/2103043411502665765/photo/1","ext_alt_text":"夕暮れ時の空に白い月が浮かぶ日本庭園。静寂な池が広がり、水面には木々や建物、月の姿が鏡のように映り込んでいる。奥には緑色の瓦屋根を持つ伝統的な日本建築が建ち、内部から温かみのある灯りが漏れる。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103043008157597696","indices":[113,136],"media_key":"3_2103043008157597696","media_results":{"result":{"media_key":"3_2103043008157597696"}},"media_url_https":"https://pbs.twimg.com/media/HS-CeTiaQAAMLvz.jpg","original_info":{"focus_rects":[{"h":860,"w":1536,"x":0,"y":440},{"h":1536,"w":1536,"x":0,"y":102},{"h":1751,"w":1536,"x":0,"y":0},{"h":2048,"w":1024,"x":512,"y":0},{"h":2048,"w":1536,"x":0,"y":0}],"height":2048,"width":1536},"sizes":{"large":{"h":2048,"resize":"fit","w":1536},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/RDzQVQBOsO"}]},"favorite_count":100,"favorited":false,"full_text":"□─　─　─　─　─　─　─　─\n秋の澄んだ夜空に浮かぶお月様🌖\n明日は十五夜「中秋の名月」です。\n─　─　─　─　─　─　─　─□\n\n先日、正面玄関から撮れた奇跡のショット📸\n雲の形がまるでススキのようだと思いませんか🎑✨ https://t.co/RDzQVQBOsO","id_str":"2103043411502665765","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":3,"reply_count":1,"retweet_count":29,"retweeted":false,"user_id_str":"803146955757010944"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[375,385],"text":"秋は京都の迎賓館へ"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDMwNDM0MTE0MjI4OTIwMzI=","richtext":{"richtext_tags":[]},"text":"□─　─　─　─　─　─　─　─\n秋の澄んだ夜空に浮かぶお月様🌖\n明日は十五夜「中秋の名月」です。\n─　─　─　─　─　─　─　─□\n\n先日、正面玄関から撮れた奇跡のショット📸\n雲の形がまるでススキのようだと思いませんか🎑✨\n廊橋からは、月が大池の水面に映り込む様や、月明かりに照らされた池の中を優雅に泳ぐ錦鯉の姿も見ることができました。\n\n11月28日から4日間限定「夜間延長公開」の機会には、紅葉に彩られた幽玄の世界を、多くの皆様にぜひ生でご覧いただきたいです！\n\n【明日9月25日(金曜日)「水明の間」特別公開 実施中】\n明日9:30から当日整理券(先着順)を清和院休憩所にて配布します。\n  9:30 残12\n10:15 残13\n11:45 残26\n12:30 残30\n13:15 残4\n14:00 残2\n14:45 残7\n15:30 残4\n#秋は京都の迎賓館へ"}}},"rest_id":"2103043411502665765","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"4037","state":"EnabledWithCount"}}},"user_id_str":"2904127170"},"rest_id":"2103049578572579118","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"417","state":"EnabledWithCount"}}}}},"entryId":"tweet-2103049578572579118","sortIndex":"2103391427378544554"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2103391427378544727-tweet-2103046784897712260","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":23},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/12241235363750830