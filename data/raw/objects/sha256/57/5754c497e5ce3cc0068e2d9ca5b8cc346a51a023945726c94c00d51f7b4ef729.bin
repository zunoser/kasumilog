","expanded_url":"https://x.com/Kyoto_Geihinkan/status/2103043411502665765/photo/1","ext_alt_text":"澄んだ夜空に明るい月が輝く中、平屋造りの日本建築が暖かい琥珀色の光を放っている。建物手前には水面が広がり、建物の琥珀色の照明と月明かりが静かに反射している。静寂と温かさが共存する趣深い和の夜景。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":236,"w":236,"x":934,"y":68}]},"medium":{"faces":[{"h":138,"w":138,"x":547,"y":39}]},"orig":{"faces":[{"h":472,"w":472,"x":1868,"y":136}]},"small":{"faces":[{"h":78,"w":78,"x":309,"y":22}]}},"id_str":"2103042853857619968","indices":[113,136],"media_key":"3_2103042853857619968","media_results":{"result":{"media_key":"3_2103042853857619968"}},"media_url_https":"https://pbs.twimg.com/media/HS-CVUubcAAVN-7.jpg","original_info":{"focus_rects":[{"h":1529,"w":2731,"x":0,"y":1591},{"h":2731,"w":2731,"x":0,"y":990},{"h":3113,"w":2731,"x":0,"y":799},{"h":4096,"w":2048,"x":0,"y":0},{"h":4096,"w":2731,"x":0,"y":0}],"height":4096,"width":2731},"sizes":{"large":{"h":2048,"resize":"fit","w":1366},"medium":{"h":1200,"resize":"fit","w":800},"small":{"h":680,"resize":"fit","w":453},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/RDzQVQBOsO"},{"display_url":"pic.x.com/RDzQVQBOsO","expanded_url":"https://x.com/Kyoto_Geihinkan/status/2103043411502665765/photo/1","ext_alt_text":"夕暮れ時の空に白い月が浮かぶ日本庭園。静寂な池が広がり、水面には木々や建物、月の姿が鏡のように映り込んでいる。奥には緑色の瓦屋根を持つ伝統的な日本建築が建ち、内部から温かみのある灯りが漏れる。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103043008157597696","indices":[113,136],"media_key":"3_2103043008157597696","media_results":{"result":{"media_key":"3_2103043008157597696"}},"media_url_https":"https://pbs.twimg.com/media/HS-CeTiaQAAMLvz.jpg","original_info":{"focus_rects":[{"h":860,"w":1536,"x":0,"y":440},{"h":1536,"w":1536,"x":0,"y":102},{"h":1751,"w":1536,"x":0,"y":0},{"h":2048,"w":1024,"x":512,"y":0},{"h":2048,"w":1536,"x":0,"y":0}],"height":2048,"width":1536},"sizes":{"large":{"h":2048,"