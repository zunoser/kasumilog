0,"x":0,"y":0},{"h":1734,"w":1734,"x":0,"y":0},{"h":1734,"w":1521,"x":0,"y":0},{"h":1734,"w":867,"x":22,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/sryEbUp3Fz"}]},"favorite_count":9915,"favorited":false,"full_text":"本日、「2027国際園芸博覧会（横浜グリーンエクスポ）を成功させる国会議員連盟」の設立総会に出席し、御挨拶申し上げました。\n\n開幕まで半年となるこのタイミングで、党派を超えた議員連盟が設立され、「横浜グリーンエクスポ」を応援いただけますことに、感謝の気持ちで一杯です。 https://t.co/sryEbUp3Fz","id_str":"2100168389700554978","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":159,"reply_count":1209,"retweet_count":966,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDAxNjgzODk2Mzc2NjQ3Njg=","richtext":{"richtext_tags":[]},"text":"本日、「2027国際園芸博覧会（横浜グリーンエクスポ）を成功させる国会議員連盟」の設立総会に出席し、御挨拶申し上げました。\n\n開幕まで半年となるこのタイミングで、党派を超えた議員連盟が設立され、「横浜グリーンエクスポ」を応援いただけますことに、感謝の気持ちで一杯です。\n\n私からは、「美しい花と緑」、「食と農の魅力」があふれる「みんなが楽しめる万博」とするとともに、「強い経済」の構築に向けて、我が国の優れた「グリーン技術」が披露されるいわば「産業見本市」としていく旨を申し上げました。\n\nグリーンエクスポには、全ての都道府県と政令市を含む、多くの自治体が出展を予定しており、地域の魅力を国内外に発信する絶好の機会にもなります。\n\n議員連盟の皆様とも連携しながら、「オールジャパン体制」で準備に万全を期してまいります。"}}},"rest_id":"2100168389700554978","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"379627","state":"EnabledWithCount"}}}}},"entryId":"tweet-2100168389700554978","sortIndex":"2100577622126755748"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTwe