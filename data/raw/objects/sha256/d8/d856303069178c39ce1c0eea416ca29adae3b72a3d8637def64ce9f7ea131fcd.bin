d":false,"verified_type":"Government"},"website":{"url":"https://t.co/NPEOH6ku2s"}}}},"edit_control":{"edit_tweet_ids":["2100049532608495812"],"editable_until_msecs":"1789529400000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":4,"bookmarked":false,"conversation_id_str":"2100049532608495812","created_at":"Wed Sep 16 02:30:00 +0000 2026","display_text_range":[0,142],"entities":{"hashtags":[{"indices":[2,11],"text":"令和８年熊本地震"}],"media":[{"display_url":"pic.x.com/o9sFY1FKuP","expanded_url":"https://x.com/gov_online/status/2100049532608495812/photo/1","ext_alt_text":"上部に「令和8年熊本地震で被害を受けられたかたへ。国税の申告・納付等の期限が延長されています。」と記載されており、その横に、申告書やお金のイラストが描かれている。その下には、次のように記載されている。熊本県八代市、宇土市、うき市及び八代郡氷川町においては、納税者のかたが申請することなく、国税に関する申告・納付等の期限の延長ができます。そのほかの地域に納税地のあるかたであっても、災害により申告・納付等をその期限までにできないとき（交通途絶等）は、所轄税務署長に申請し、その承認を受けることにより、その理由のやんだ日から2か月以内の範囲でその期限の延長を受けられます。詳しくは国税庁の情報をご確認ください。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2100033246998503424","indices":[143,166],"media_key":"3_2100033246998503424","media_results":{"result":{"media_key":"3_2100033246998503424"}},"media_url_https":"https://pbs.twimg.com/media/HSTRHJfbIAA0J1Z.jpg","original_info":{"focus_rects":[{"h":598,"w":1067,"x":0,"y":150},{"h":1067,"w":1067,"x":0,"y":0},{"h":1200,"w":1053,"x":0,"y":0},{"h":1200,"w":600,"x":0,"y":0},{"h":1200,"w":1067,"x":0,"y":0}],"height":1200,"width":1067},"sizes":{"large":{"h":1200,"resize":"fit","w":1067},"medium":{"h":1200,"resize":"fit","w":1067},"small":{"h":680,"resize":"fit","w":605},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/o9sFY1FKuP"}],"urls":[{"display_url":"nta.go.jp//taxes/shirabe…","expanded_url":"https://www.nta.go.jp//taxes/shiraberu/saigai/r8/kumamoto/index.htm","indices":[108,131],"url":"htt