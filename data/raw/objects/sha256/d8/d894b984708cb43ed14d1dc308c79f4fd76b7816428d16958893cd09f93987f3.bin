734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/AlriMWjbEp"}]},"extended_entities":{"media":[{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/AlriMWjbEp","expanded_url":"https://x.com/takaichi_sanae/status/2122160402872320403/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":71,"w":71,"x":751,"y":573}]},"medium":{"faces":[{"h":42,"w":42,"x":440,"y":336}]},"orig":{"faces":[{"h":91,"w":91,"x":954,"y":728}]},"small":{"faces":[{"h":23,"w":23,"x":249,"y":190}]}},"id_str":"2122160320361959424","indices":[65,88],"media_key":"3_2122160320361959424","media_results":{"result":{"media_key":"3_2122160320361959424"}},"media_url_https":"https://pbs.twimg.com/media/HXNtkVOakAAQPeV.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":368,"y":0},{"h":1734,"w":1521,"x":475,"y":0},{"h":1734,"w":867,"x":802,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/AlriMWjbEp"}]},"favorite_count":14690,"favorited":false,"full_text":"これから、フィリピンのマニラを訪問してASEAN関連首脳会議に、続いて中国の深圳を訪問してAPEC首脳会議に出席してまいります。 https://t.co/AlriMWjbEp","id_str":"2122160402872320403","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":254,"reply_count":1390,"retweet_count":1487,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIxNjA0MDI3ODg0MzgwMTY=","richtext":{"richtext_tags":[]},"text":"これから、フィリピンのマニラを訪問してASEAN関連首脳会議に、続いて中国の深圳を訪問してAPEC首脳会議に出席してまいります。\n\n国際社会が歴史的な変化に直面する中、「法の支配に基づく自由で開かれた国際秩序」の維持・強化に向けた日本の取組を積極的に発信し、そのための協力を各国と確認したいと考えています。\n\nASEAN関連首脳会議では、「自由で開かれたインド太平洋（FOIP）」実現の要であるASEANとの協力の一層の強化を確認してまいります。\nまた、『進化したFOIP』の具体化の一つとして、AZEC首脳会合への出席を通じ、「パワー・アジア」を強化する決意を示し、経済・エネルギー強靱化の視点を強化した、「AZEC2.0」への進化を打ち出す考えです。\nAPEC首脳会議では、貿易・投資、地域経済統合、経済・エネルギー強靱化、デジタル経済・AIといった地域の経済的諸課題について議論し、それらに関する日本の立場を力強く発信してまいります。\n\nさらに、この一連の外交の機会に日米豪印（クアッド）の首脳会合の開催を予定しているほか、フィリピンのマルコス大統領、韓国の李在明大統領、タイのアヌティン首相といった各国首脳との会談も予定しています。\n\n諸外国との連携・協力をしっかり推進する4日間にしたいと思います。"}}},"rest_id":"2122160402872320403","unmention_data":{},"views":{"count":"608601","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122160402872320403","sortIndex":"2122264030251843526"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location