weet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2120648183248211968/olqSGjR3?format=jpg&name=800x419","width":800},"type":"IMAGE"}},{"key":"app_star_rating","value":{"string_value":"4.73557","type":"STRING"}},{"key":"thumbnail_image","value":{"image_value":{"height":147,"url":"https://pbs.twimg.com/card_img/2120648183248211968/olqSGjR3?format=jpg&name=280x150","width":280},"type":"IMAGE"}},{"key":"description","value":{"string_value":"2030年度から、教科書のかたちに新たな選択肢が加わります。 目指しているのは、教科書をすべてデジタルにすることではありません。紙とデジタル、それぞれの良さを生かしながら、子供たちにとってより「分かりやすい」「学びやすい」教科書をつくることが目的です。 2026年6月の「学校教育法等の一部を改正する法律」の成立を受け、これから教科書の選択肢がどのように広がり、子供たちの学びはどう変わっていく...","type":"STRING"}},{"key":"domain","value":{"string_value":"mext-gov.note.jp","type":"STRING"}},{"key":"app_is_free","value":{"string_value":"true","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":314,"url":"https://pbs.twimg.com/card_img/2120648183248211968/olqSGjR3?format=jpg&name=600x600","width":600},"type":"IMAGE"}},{"key":"summary_photo_image_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2120648183248211968/olqSGjR3?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":670,"url":"https://pbs.twimg.com/card_img/2120648183248211968/olqSGjR3?format=jpg&name=orig","width":1280},"type":"IMAGE"}},{"key":"site","value":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"2426595726","path":[]}}},{"key":"photo_image_full_size_small","value":{"image_value":{"height":202,"url":"https://pbs.twimg.com/card_img/2120648183248211968/olqSGjR3?format=jpg&name=386x202","width":386},"type":"IMAGE"}},{"key":"summary_photo_image_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2120648183248211968/olqSGjR3?format=jpg&name=