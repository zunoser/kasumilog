on":{"verified":false,"verified_type":"Government"},"website":{"url":""}}}},"edit_control":{"edit_tweet_ids":["2122147647788110291"],"editable_until_msecs":"1794798001000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":3,"bookmarked":false,"conversation_id_str":"2122147647788110291","created_at":"Mon Nov 16 02:00:01 +0000 2026","display_text_range":[0,160],"entities":{"hashtags":[{"indices":[24,35],"text":"RegTechミート"}],"urls":[{"display_url":"digital.go.jp/policies/digit…","expanded_url":"https://www.digital.go.jp/policies/digital-extraordinary-administrative-research-committee/regtechconsortium/regtechmeet","indices":[137,160],"url":"https://t.co/ZL1zwGgPR8"}]},"favorite_count":9,"favorited":false,"full_text":"アナログ規制見直しの取組について語るイベント\n「#RegTechミート」11/19（木）オンライン開催📢\n\n今回は、電子投票の要件緩和を受け、総務省による制度概要の解説と、タブレット端末を活用した有用性を宮崎県新富町や事業者等がご紹介。ぜひご参加ください。\n\n詳細・申込↓\nhttps://t.co/ZL1zwGgPR8","id_str":"2122147647788110291","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":1,"retweet_count":2,"retweeted":false,"user_id_str":"1312820383532294144"},"rest_id":"2122147647788110291","unmention_data":{},"views":{"count":"4069","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2122264030251843651-tweet-2122147648496910623","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"photo_image_full_size_large","value":{"image_value":{"height":419,"url":"https://pbs.twimg.com/card_img/2120831735328096256/DEk7zheF?format=jpg&na