ible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":20515,"tweets":49313},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/42AYao2vk0"}}}},"edit_control":{"edit_tweet_ids":["2122193247527477695"],"editable_until_msecs":"1794808873000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":10,"bookmarked":false,"conversation_id_str":"2122193247527477695","created_at":"Mon Nov 16 05:01:13 +0000 2026","display_text_range":[0,156],"entities":{},"favorite_count":82,"favorited":false,"full_text":"高市総理大臣は、ASEAN関連首脳会議及びAPEC首脳会議出席に際し、「共に、強く豊かなインド太平洋地域のために」と題して、The Philippine Star、Manila Bulletin、Philippine Daily Inquirer及び星洲日報に寄稿し、Nikkei Asia及びAsia News","id_str":"2122193247527477695","is_quote_status":false,"lang":"ja","quote_count":0,"reply_count":2,"retweet_count":18,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/a_o/rp/p…","expanded_url":"https://www.mofa.go.jp/mofaj/a_o/rp/pageit_000001_03328.html","indices":[272,295],"url":"https://t.co/nWnFVI3wrS"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIxOTMyNDc0MTQxNDA5Mjg=","richtext":{"richtext_tags":[]},"text":"高市総理大臣は、ASEAN関連首脳会議及びAPEC首脳会議出席に際し、「共に、強く豊かなインド太平洋地域のために」と題して、The Philippine Star、Manila Bulletin、Philippine Daily Inquirer及び星洲日報に寄稿し、Nikkei Asia及びAsia News Networkに記事が転載されました。寄稿文の中で高市総理は、FOIPやパワーアジアなど、インド太平洋地域での日本の取組を紹介するとともに、地域の各国と日本が「共に、強く豊かに」なるために、協力を積み重ねていく旨を述べました。\n\nhttps://t.co/nWnFVI3wrS"}}},"rest_id":"2122193247527477695","unmention_data":{},"views":{"count":"6658","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122193247527477695","sortIndex":"2122264030251843543"},{"content