esults":{"result":{"entity_set":{"hashtags":[{"indices":[307,314],"text":"まさかで疑え"},{"indices":[315,322],"text":"ミセスと訓練"},{"indices":[323,337],"text":"MrsGREENAPPLE"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"gov-online.go.jp/tokusyu/ict-li…","expanded_url":"https://www.gov-online.go.jp/tokusyu/ict-literacy/index.html","indices":[283,306],"url":"https://t.co/TK8nY9SAyy"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIxMDIzNTQ1NTIyNzQ5NDQ=","text":"／\nMrs. GREEN APPLEが\n街に、学校に、イヤホンの中に🍏\n＼\n\n街のどこかにいる3人を探してみませんか?🔎\n\n━━━━━━━━━━━━\n本日から、偽・誤(ニセゴ)情報対策のメッセージが全国に📢\n🚃東京圏、大阪圏、名古屋圏の電車内ビジョン\n🌆街頭ビジョン(LIVE BOARD)\n🏫全国の小中高等学校などが対象の校内掲示ポスター\n📻Spotify・ラジオ(SCHOOL OF LOCK!内)\n\n偽・誤(ニセゴ)情報の可能性は「ま・さ・か」で疑え!\n「待つ・探す・確認する」の3つの行動を実践しましょう。\n━━━━━━━━━━━━\n\n▼特設サイトはこちら\nhttps://t.co/TK8nY9SAyy\n#まさかで疑え #ミセスと訓練 #MrsGREENAPPLE"}}},"rest_id":"2122102354912985294","unmention_data":{},"views":{"count":"81882","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122102354912985294","sortIndex":"2122264030251843498"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1