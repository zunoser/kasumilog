nt_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122168189006323712/pl/58wJFzqBAc56yif3.m3u8?tag=29&v=8b4"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122168189006323712/vid/avc1/480x270/51lMZ-VCzh1jpPSJ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122168189006323712/vid/avc1/640x360/4ltbf9H_-op0h5Ng.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122168189006323712/vid/avc1/1280x720/m3PQyuIgkKOjCY4w.mp4?tag=29"}]}}]},"extended_entities":{"media":[{"additional_media_info":{"monetizable":false},"display_url":"pic.x.com/DgAKEMFKHD","expanded_url":"https://x.com/kantei/status/2122168980584689778/video/1","ext_media_availability":{"status":"Available"},"id_str":"2122168189006323712","indices":[85,108],"media_key":"13_2122168189006323712","media_results":{"result":{"media_key":"13_2122168189006323712"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2122168189006323712/img/jXXuFei_Rw1enA9u.jpg","original_info":{"focus_rects":[],"height":720,"width":1280},"sizes":{"large":{"h":720,"resize":"fit","w":1280},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/DgAKEMFKHD","video_info":{"aspect_ratio":[16,9],"duration_millis":173166,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2122168189006323712/pl/58wJFzqBAc56yif3.m3u8?tag=29&v=8b4"},{"bitrate":256000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122168189006323712/vid/avc1/480x270/51lMZ-VCzh1jpPSJ.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122168189006323712/vid/avc1/640x360/4ltbf9H_-op0h5Ng.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2122168189006323712/vid/avc1/1280x720/m3PQyuIgkKOjCY4w.mp4?tag=29"}]}}]},"favorite_count":1910,"favorited":false,"full_text":"【お知らせ】\n本日（１１月１６日）、高市総理は、ＡＳＥＡＮ関連首脳会議出席及びＡＰＥＣ首脳会議出席についてのぶらさがり会見を行いました。\n \n※要旨（速報版）\n（記者） https://t.co/DgAKEMFKHD","id_str":"2122168980584689778","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":68,"reply_count":185,"retweet_count":262,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMjIxNjg5ODA1MDQ5ODU2MDA=","richtext":{"richtext_tags":[]},"text":"【お知らせ】\n本日（１１月１６日）、高市総理は、ＡＳＥＡＮ関連首脳会議出席及びＡＰＥＣ首脳会議出席についてのぶらさがり会見を行いました。\n \n※要旨（速報版）\n（記者）\n　総理はこれからＡＳＥＡＮ首脳会合、ＡＰＥＣ首脳会合に参加するため、フィリピン、中国を訪問されます。ＡＳＥＡＮに関連して、「パワー・アジア」やＡＺＥＣなどの国際協力の取組を推し進める中、今回の首脳会合で、どのような成果を得たいとお考えでしょうか。また、各国首脳が集まる中、日中・日米・日ロなどの個別会談、またクアッドなどの調整状況を伺います。さらに、各国首脳との会談では、どのような成果を得たいとお考えでしょうか。お願いいたします。\n \n（高市総理）\n　ただ今から、フィリピンのマニラと中国の深センを訪問して、ＡＳＥＡＮ関連首脳会議とＡＰＥＣ首脳会議に出席をいたします。\n　国際社会が歴史的な変化に直面する中で、「法の支配に基づく自由で開かれた国際秩序」の維持・強化に向けた日本の取組を発信し、そのための協力を各国と確認したいと考えております。\n　また、ＡＳＥＡＮ関連首脳会議への出席を通じて、「自由で開かれたインド太平洋、ＦＯＩＰ」の「要」でありますＡＳＥＡＮとのこの協力をですね、一層強化してまいりたいと考えております。\n　また、『進化したＦＯＩＰ』の具体化の一つとして、 ＡＺＥＣ首脳会合への出席を通じまして「パワー・アジア」を強化する決意を示します。これは経済・エネルギー強靱化の視点を強化した、「ＡＺＥＣ２．０」への進化を打ち出すものでございます。\n　また、ＡＰＥＣ首脳会議では、貿易・投資、地域経済統合、経済・エネルギー強靱化、デジタル経済・ＡＩといった地域の経済的諸課題について議論をして、それらに関する日本の立場を力強く発信したいと考えております。\n　また、この一連の外交の機会に「日米豪印、クアッド」の首脳会合の開催を予定しております。このほか、フィリピンのマルコス大統領、韓国の李在明（イ・ジェミョン）大統領、タイのアヌティン首相、といった各国首脳との会談も予定しております。\n　諸外国とのこの連携・協力をしっかりと確認するという考えでございます。"}}},"rest_id":"2122168980584689778","unmention_data":{},"views":{"count":"171236","state":"EnabledWithCount"}}}}},"entryId":"tweet-2122168980584689778","sortIndex":"2122264030251843533"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDeta