e":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2104342822392627539","created_at":"Sun Sep 27 22:50:00 +0000 2026","display_text_range":[0,160],"entities":{"media":[{"display_url":"pic.x.com/O6wvhtsIkk","expanded_url":"https://x.com/INPIT_jp/status/2104342822392627539/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103384419734360064","indices":[161,184],"media_key":"3_2103384419734360064","media_results":{"result":{"media_key":"3_2103384419734360064"}},"media_url_https":"https://pbs.twimg.com/media/HTC4_ExbkAAcomp.png","original_info":{"focus_rects":[{"h":159,"w":284,"x":31,"y":0},{"h":159,"w":159,"x":94,"y":0},{"h":159,"w":139,"x":104,"y":0},{"h":159,"w":80,"x":133,"y":0},{"h":159,"w":776,"x":0,"y":0}],"height":159,"width":776},"sizes":{"large":{"h":159,"resize":"fit","w":776},"medium":{"h":159,"resize":"fit","w":776},"small":{"h":139,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/O6wvhtsIkk"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/O6wvhtsIkk","expanded_url":"https://x.com/INPIT_jp/status/2104342822392627539/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2103384419734360064","indices":[161,184],"media_key":"3_2103384419734360064","media_results":{"result":{"media_key":"3_2103384419734360064"}},"media_url_https":"https://pbs.twimg.com/media/HTC4_ExbkAAcomp.png","original_info":{"focus_rects":[{"h":159,"w":284,"x":31,"y":0},{"h":159,"w":159,"x":94,"y":0},{"h":159,"w":139,"x":104,"y":0},{"h":159,"w":80,"x":133,"y":0},{"h":159,"w":776,"x":0,"y":0}],"height":159,"width":776},"sizes":{"large":{"h":159,"resize":"fit","w":776},"medium":{"h":159,"resize":"fit","w":776},"small":{"h":139,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/O6wvhtsIkk"}]},"favorite_count":4,"favorited":false,"full_text":"／\n「第1回 商工会議所知財フォーラム in 九州」開催！\n＼\n\n日本商工会議所・東京商工会議所主催\n「第1回商工会議所知財フォーラムin九州」が、\n10月16日（金）に熊本市で開催されます。\n\nINPITからは、\n・九州本部（INPIT-KYUSHU） 本部長 横田之俊\n・INPIT熊本県知財総合支援窓口 支援担当者 https://t.co/O6wvhtsIkk","id_str":"2104342822392627539","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":0,"retweet_count":2,"retweeted":false,"user_id_str":"719342924857626624"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[282,288],"text":"商工会議所"},{"indices":[289,301],"text":"INPITKYUSHU"},{"indices":[302,319],"text":"INPIT熊本県知財総合支援窓口"}],"smarttags":[],"symbols":[],"urls":[{"display_url":"jcci.or.jp/news/seminar/2…","expanded_url":"https://www.jcci.or.jp/news/seminar/2026/0915091500.html","indices":[257,280],"url":"https://t.co/Q6SZoFoYbU"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQzNDI4MjIwMDY3NTEyMzI=","text":"／\n「第1回 商工会議所知財フォーラム in 九州」開催！\n＼\n\n日本商工会議所・東京商工会議所主催\n「第1回商工会議所知財フォーラムin九州」が、\n10月16日（金）に熊本市で開催されます。\n\nINPITからは、\n・九州本部（INPIT-KYUSHU） 本部長 横田之俊\n・INPIT熊本県知財総合支援窓口 支援担当者 宮﨑聖子\nが登壇予定です。\n\n✅中小企業支援に携わる方\n✅技術・ノウハウの保護に関心のある方\n✅知的財産の取得・活用を本格化させたい方\n\nぜひご参加ください！\n\n詳細・申込👇（現地開催のみ）\nhttps://t.co/Q6SZoFoYbU\n\n#商工会議所 #INPITKYUSHU #INPIT熊本県知財総合支援窓口"}}},"rest_id":"2104342822392627539","source":"<a href=\"http://twitter.com\" rel=\"nofollow\">Twitter Web Client</a>","unmention_data":{},"views":{"count":"1195","state":"EnabledWithCount"}}},"user_id_str":"281874178"},"rest_id":"2104382318463131813","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"178","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104382318463131813","sortIndex":"2104752515479240616"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_lis