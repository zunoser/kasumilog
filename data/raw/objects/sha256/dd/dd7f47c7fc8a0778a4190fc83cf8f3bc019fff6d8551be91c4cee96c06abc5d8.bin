","quote_count":0,"reply_count":11,"retweet_count":18,"retweeted":false,"user_id_str":"303730149"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[{"display_url":"mofa.go.jp/mofaj/press/re…","expanded_url":"https://www.mofa.go.jp/mofaj/press/release/pressit_000001_04220.html","indices":[204,227],"url":"https://t.co/43Ojqd0wSI"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ0OTMyMDMzMTE0NDgwNjQ=","richtext":{"richtext_tags":[]},"text":"貝原国連担当大使は、米国・ニューヨークにおいて、海運及び船員の安全に関するフレンズ・グループ設立会合（閣僚級）に出席しました。貝原大使から、海運及び船員の安全のためには、法の支配と航行の自由が極めて重要であり、その観点から、国連海洋法条約（UNCLOS）を基礎とする法の支配に基づく自由で開かれた海洋秩序の維持・強化は、進化した自由で開かれたインド太平洋（FOIP）の柱の一つとなっている旨を述べました。\n\nhttps://t.co/43Ojqd0wSI"}}},"rest_id":"2104493203433161099","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"13642","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104493203433161099","sortIndex":"2104752515479240661"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location"