deo/2104524901331963904/vid/avc1/480x270/MvES8g8Lc5vx7ABL.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2104524901331963904/vid/avc1/640x360/rS_2itsgrPZJUziS.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2104524901331963904/vid/avc1/1280x720/XWF8I7EzOQ0UDc9j.mp4?tag=29"}]}}]},"favorite_count":4160,"favorited":false,"full_text":"【お知らせ】 \n本日（９月２８日）、高市総理は、第１回「インテリジェンス機能の強化に関する有識者会議」を開催しました。\n\n※高市総理発言要旨（速報版） https://t.co/lGIvjfqmIG","id_str":"2104527257234465071","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":58,"reply_count":200,"retweet_count":596,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ1MjcyNTcxMjk2MDcxNjg=","richtext":{"richtext_tags":[]},"text":"【お知らせ】 \n本日（９月２８日）、高市総理は、第１回「インテリジェンス機能の強化に関する有識者会議」を開催しました。\n\n※高市総理発言要旨（速報版）\n　インテリジェンス機能の強化は、現下の国際情勢等に鑑みますと喫緊の課題でございます。構成員の皆様におかれましては、この課題を御議論いただく有識者会議への参加を御快諾いただきましたことにまず御礼を申し上げます。ありがとうございます。 \n　昨今、地政学的な国家間競争が激化しております。我が国周辺では、 \n・中国・北朝鮮の軍事力の増強、 \n・中国とロシア、そして、ロシアと北朝鮮の連携強化\nが見られます。\n　また、ウクライナや中東での紛争は長期化をして、世界中に影響を与えています。 \n　我が国におきましても、 \n・外国の情報機関員が関わる先端技術の不正流出、また、\n・官民の重要情報を狙ったサイバー攻撃、そして、\n・自国に有利なように世論を誘導しようとする偽情報の拡散\nといった脅威が高まっております。 \n　このような中で、国民の皆様の安全や国益をしっかりと守り抜いていく、そのためには、我が国の情報力の強化が不可欠と考えております。 \n　情報部門が、政策部門のニーズも踏まえて、質の高い、時宜にかなった情報を得て、政府としての意思決定を強固に支えていく必要がございます。 \n　このため、今年の７月末に政府全体の情報活動に関する司令塔機能を強化するべく、国家情報会議及び国家情報局を設置したところです。 \n　しかし、これらはインテリジェンス改革の第一歩に過ぎません。 \n・外国による不当な干渉の防止策の強化、また、\n・対外情報機能の充実 \nといった取組を、更に進めていかなければなりません。 \n　こうしたインテリジェンス改革の一環として、政府の情報活動の中長期的な推進方策を国家情報戦略として取りまとめて、公表するということが必要と考えております。 \n　このような観点から、この有識者会議を設置して、まさに、\n・国際情勢、経済安全保障、 \n・先端科学技術、サイバー、 \n・情報発信、影響工作、法律など、 \n様々な分野において高い見識をお持ちの専門家の皆様に御参集いただいたわけでございます。 \n　渡部座長をはじめとしまして、我が国のインテリジェンス機能の強化のために、構成員の皆様にはこれからも忌憚のないご意見を賜りますよう、心よりお願いを申し上げます。\n　本日は誠にありがとうございました。"}}},"rest_id":"2104527257234465071","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"96923","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104527257234465071","sortIndex":"2104752515479240683"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"TweetWithVisibilityResults","limitedActionResults":{"limited_actions":[{"action":"Reply","prompt":{"__typename":"CtaLimitedActionPrompt","cta_type":"SeeConversation","headline":{"entities":[],"text":"Who can reply?"},"subtext":{"entities":[],"text":"一部のアカウントのみが返信できます。"}}}]},"tweet":{"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzY2ODI3OTE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関 "},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2001095001481076943"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"国税庁の公式アカウントです。税に関する情報を提供します。税務行政に対するご意見・ご要望は国税庁ホームページまで。https://t.co/lV