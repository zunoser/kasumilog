:182,"x":352,"y":421},{"h":198,"w":198,"x":1693,"y":1089},{"h":616,"w":616,"x":1774,"y":274}]},"small":{"faces":[{"h":22,"w":22,"x":200,"y":108},{"h":47,"w":47,"x":92,"y":110},{"h":51,"w":51,"x":442,"y":284},{"h":161,"w":161,"x":463,"y":71}]}},"id_str":"2104502844812611585","indices":[90,113],"media_key":"3_2104502844812611585","media_results":{"result":{"media_key":"3_2104502844812611585"}},"media_url_https":"https://pbs.twimg.com/media/HTSyL-3a0AEZoPd.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":108,"y":0},{"h":1734,"w":1521,"x":215,"y":0},{"h":1734,"w":867,"x":542,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/bW1VL5ZKLL"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/bW1VL5ZKLL","expanded_url":"https://x.com/takaichi_sanae/status/2104503043022901635/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":99,"w":99,"x":35,"y":591},{"h":167,"w":167,"x":39,"y":555}]},"medium":{"faces":[{"h":58,"w":58,"x":20,"y":346},{"h":98,"w":98,"x":23,"y":325}]},"orig":{"faces":[{"h":126,"w":126,"x":45,"y":751},{"h":213,"w":213,"x":50,"y":705}]},"small":{"faces":[{"h":32,"w":32,"x":11,"y":196},{"h":55,"w":55,"x":13,"y":184}]}},"id_str":"2104502874013409281","indices":[90,113],"media_key":"3_2104502874013409281","media_results":{"result":{"media_key":"3_2104502874013409281"}},"media_url_https":"https://pbs.twimg.com/media/HTSyNrpboAExj9R.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/bW1VL5ZKLL"}]},"favorite_count":14815,"favorited":false,"full_text":"近年の複雑で厳しい国際環境において、我が国の国益、そして国民の皆様の暮らしや安全を守っていくためには、それらを脅かす可能性のある脅威を迅速かつ正確に把握することが極めて重要です。 https://t.co/bW1VL5ZKLL","id_str":"2104503043022901635","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":262,"reply_count":1008,"retweet_count":1865,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ1MDMwNDI5NTk5MTcwNTY=","richtext":{"richtext_tags":[]},"text":"近年の複雑で厳しい国際環境において、我が国の国益、そして国民の皆様の暮らしや安全を守っていくためには、それらを脅かす可能性のある脅威を迅速かつ正確に把握することが極めて重要です。\n\n官民の重要情報を狙った「サイバー攻撃」、外国の情報機関員が関わる「先端技術の不正流出」、自国に有利なように世論を誘導しようとする「偽情報の拡散」など、様々な脅威が私たちの身近に迫っています。\n一方、一つ一つの事象や事案は一見無関係に見えることもあり、外交、防衛、治安、経済、技術といった複数の領域で把握された情報を統合して分析しなければ、全体像を把握することが難しいのも実情です。\n\nこのような状況に的確に対処する上で欠かせないのは、まさに、様々な情報を収集・集約し、これを分析する「総合的なインテリジェンス機能」です。\n\n先の国会において、政府におけるインテリジェンス機能の強化を図るため、『国家情報会議設置法案』を提出し、５月に成立しました。\n\n『国家情報会議設置法』は、総理大臣を議長とする閣僚級の「国家情報会議」、そして、内閣情報調査室の後継組織である「国家情報局」を新たに設置することにより、政府におけるインテリジェンス活動の司令塔機能を強化するものです。\n\n法律は7月31日に施行され、既に2回の「国家情報会議」を開催し、各機関が実施する情報活動の重点などを決定しました。\n\nインテリジェンス機能の強化に向けた取組は始まったばかりであり、今後も『国家情報戦略』の策定、「外国による不当な干渉の防止の強化」、「対外情報機能の充実」といった、更なるインテリジェンス改革について、検討を進めていく必要があります。\n\nこうした取組の一環として、本日（9/28）、第1回目となる「インテリジェンス機能の強化に関する有識者会議」を開催しました。\n\n有識者会議には、国際情勢、経済安全保障、先端科学技術、サイバー、情報発信、影響工作、法律など、様々な分野について高い見識をお持ちの皆様にご参集いただきました。\n\n幅広く御意見を伺い、改革を着実に前に進めてまいります。"}}},"rest_id":"2104503043022901635","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"399846","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104503043022901635","sortIndex":"2104752515479240674"},{"content":{"__typename":"TimelineT