fo":{"focus_rects":[{"h":1720,"w":3072,"x":0,"y":2314},{"h":3072,"w":3072,"x":0,"y":1024},{"h":3502,"w":3072,"x":0,"y":594},{"h":4096,"w":2048,"x":1024,"y":0},{"h":4096,"w":3072,"x":0,"y":0}],"height":4096,"width":3072},"sizes":{"large":{"h":2048,"resize":"fit","w":1536},"medium":{"h":1200,"resize":"fit","w":900},"small":{"h":680,"resize":"fit","w":510},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/bnNeNkTweV"}]},"favorite_count":193,"favorited":false,"full_text":"【防災情報　28日11時点】                \n◆印旛沼の平均水位　Y.P 1.94ｍ（28日11時現在）               \n印旛沼の水位は常時満水位（Y.P https://t.co/bnNeNkTweV","id_str":"2104393351881740404","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":0,"reply_count":3,"retweet_count":58,"retweeted":false,"user_id_str":"525120344"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[303,310],"text":"チーム印旛沼"}],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQzOTMzNTE4MDYyMTQxNDQ=","richtext":{"richtext_tags":[]},"text":"【防災情報　28日11時点】                \n◆印旛沼の平均水位　Y.P 1.94ｍ（28日11時現在）               \n印旛沼の水位は常時満水位（Y.P 2.30ｍ）を下回りました。できる限り印旛機場（最大排水能力：毎秒92トン）、大和田機場（最大排水能力：毎秒120トン）の排水運転※を行って水位低下を図ります。            \n※両機場取水地点の水位が低下してきたこと等により最大排水量での運転が難しくなってきたため、排水量の調整や取水に影響が出ないよう慎重に操作しています。\n写真は大和田機場に配置している排水ポンプ車の点検や燃料の給油を行っている状況です。　#チーム印旛沼"}}},"rest_id":"2104393351881740404","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"5026","state":"EnabledWithCount"}}},"user_id_str":"571429134"},"rest_id":"2104739722987974748","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"281","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104739722987974748","sortIndex":"2104752515479240696"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"co