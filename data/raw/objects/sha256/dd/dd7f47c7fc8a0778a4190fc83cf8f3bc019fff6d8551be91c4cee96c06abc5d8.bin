に対するパトロール等を実施します。\nhttps://t.co/log9sLsFVj\n#荷主 #運送 #パトロール #取適法","id_str":"1971461585144250687","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":1,"reply_count":0,"retweet_count":7,"retweeted":false,"user_id_str":"2455900080"},"rest_id":"1971461585144250687","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"27559","state":"EnabledWithCount"}}},"rest_id":"2104456696710217903","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"10806","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2104752515479240766-tweet-2104463156794077442","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"rest_id":"https://t.co/72mAPx4vFS"},"cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":8},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1422419569415655427/oP9KuARy_normal.png"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/2455900080/1772426773"},"core":{"created_at":"Mon Apr 21 03:31:44 +0000 2014","name":"公正取引委員会","screen_name":"jftc"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNDU1OTAwMDgw","is_blue_verified":false,"location":{"location":"東京都港区虎ノ門２－２－３"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"公正取引委員会の公式アカウントです。 \n公正かつ自由な競争について理解を深めて