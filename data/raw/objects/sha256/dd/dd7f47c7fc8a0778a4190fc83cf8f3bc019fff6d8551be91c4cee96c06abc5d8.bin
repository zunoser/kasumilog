"urls":[{"display_url":"www8.cao.go.jp/souki/sns/x.ht…","expanded_url":"https://www8.cao.go.jp/souki/sns/x.html","indices":[58,81],"url":"https://t.co/nSooMa6Gc5"}]},"url":{"urls":[{"display_url":"www8.cao.go.jp/souki/index.ht…","expanded_url":"https://www8.cao.go.jp/souki/index.html","indices":[0,23],"url":"https://t.co/wBzrJ8ehrX"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1110,"following":12},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"1853694958383050752","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":141,"tweets":330},"verification":{"verified":false},"website":{"url":"https://t.co/wBzrJ8ehrX"}}}},"edit_control":{"edit_tweet_ids":["2103007729883529459"],"editable_until_msecs":"1790234689000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_control":{"conversation_owner_results":{"result":{"__typename":"User","core":{"screen_name":"kyoseikyojo_cao"}}},"policy":"ByInvitation"},"conversation_id_str":"2079419560898470328","created_at":"Thu Sep 24 06:24:49 +0000 2026","display_text_range":[0,159],"entities":{"hashtags":[{"indices":[143,149],"text":"ともフェス"},{"indices":[150,154],"text":"内閣府"},{"indices":[155,159],"text":"丸の内"}],"media":[{"display_url":"pic.x.com/MvCo5fqnNW","expanded_url":"https://x.com/kyoseikyojo_cao/status/2103007729883529459/photo/1","ext_alt_text":"キャッチコピー「出会う、ふれあう、未来がかわる」を掲げた、障害の有無にかかわらず、こどもから大人まで、誰もが、一緒に楽しみ、交流できるインクルーシブイベント「ともともフェスタ2026（Tomotomo Festa 2026）」の告知ポスターです。開催日時は2026年10月9日(金)11:00〜19:00（行幸通りは17:00まで）及び10日(土)11:00〜17:00、入場無料です。会場は東京駅丸の内口 行幸通り及び丸ビル1階マルキューブを予定しており、音楽ステージ・体験型ワークショップ・展示などの楽しいコンテンツやみんなで遊べる遊具もあります。行幸通りは、東京都千代田区丸の内２丁目２番地、各線「東京駅」丸の内中央口より徒歩１分、東京メトロ千代田線「二重橋前駅」より徒歩3分です。丸ビルは東京都千代田区丸の内２丁目４番地１号、各線「東京駅」から地下で直結、徒歩４分、東京メトロ千代田線「二重橋前駅」より徒歩４分です。主催：内閣府・ともともフェスタ2026実行委員会、協力：東京法務局・全国人権擁護委員連合会・東京都人権擁護委員連合会・株式会社アイシン・味の素株式会社・錦城護謨株式会社・株式会社講談社・タカオ株式会社・株式会社乃村工藝社　未来創造研究所・株式会社毎日新聞社、後援：こども家庭庁・法務省・文部科学省・厚生労働省・国土交通省・東京都・鳥取県・千代田区。特設WEBサイト: https://www.tomotomo.go.jp/festa2026/。バリアフリー情報や出展・出演・イベント情報は特設ホームページを御覧ください。イベントへのお問い合わせは、ともともフェスタ2026運営事務局 info@tomotomo.go.jp ,03-5730-3157までお寄せください。受付時間は平日10時から17時（土日祝日、年末年始は除く）です。ポスターには、車いすユーザー・白杖ユーザーを含む多様な年齢・背景の人々のイラストが描かれています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":150,"w":150,"x":141,"y":181}]},"medium":{"faces":[{"h":143,"w":143,"x":135,"y":173}]},"orig":{"faces":[{"h":150,"w":150,"x":141,"y":181}]},"small":{"faces":[{"h":81,"w":81,"x":76,"y":98}]}},"id_str":"2102983010165649408","indices":[160,183],"media_key":"3_2102983010165649408","media_results":{"result":{"media_key":"3_2102983010165649408"}},"media_url_https":"https://pbs.twimg.com/media/HS9L59ma8AA2ch7.jpg","original_info":{"focus_rects":[{"h":496,"w":885,"x":0,"y":0},{"h":885,"w":885,"x":0,"y":0},{"h":1009,"w":885,"x":0,"y":0},{"h":1253,"w":627,"x":258,"y":0},{"h":1253,"w":885,"x":0,"y":0}],"height":1253,"width":885},"sizes":{"large":{"h":1253,"resize":"fit","w":885},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":480},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MvCo5fqnNW"}],"urls":[{"display_url":"tomotomo.go.jp","expanded_url":"https://tomotomo.go.jp","indices":[52,75],"url":"https://t.co/nsj3DoqDgK"}]},"extended_entities":{"media":[{"display_url":"pic.x.com/MvCo5fqnNW","expanded_url":"https://x.com/kyoseikyojo_cao/status/2103007729883529459/photo/1","ext_alt_text":"キャッチコピー「出会う、ふれあう、未来がかわる」を掲げた、障害の有無にかかわらず、こどもから大人まで、誰もが、一緒に楽しみ、交流できるインクルーシブイベント「ともともフェスタ2026（Tomotomo Festa 2026）」の告知ポスターです。開催日時は2026年10月9日(金)11:00〜19:00（行幸通りは17:00まで）及び10日(土)11:00〜17:00、入場無料です。会場は東京駅丸の内口 行幸通り及び丸ビル1階マルキューブを予定しており、音楽ステージ・体験型ワークショップ・展示などの楽しいコンテンツやみんなで遊べる遊具もあります。行幸通りは、東京都千代田区丸の内２丁目２番地、各線「東京駅」丸の内中央口より徒歩１分、東京メトロ千代田線「二重橋前駅」より徒歩3分です。丸ビルは東京都千代田区丸の内２丁目４番地１号、各線「東京駅」から地下で直結、徒歩４分、東京メトロ千代田線「二重橋前駅」より徒歩４分です。主催：内閣府・ともともフェスタ2026実行委員会、協力：東京法務局・全国人権擁護委員連合会・東京都人権擁護委員連合会・株式会社アイシン・味の素株式会社・錦城護謨株式会社・株式会社講談社・タカオ株式会社・株式会社乃村工藝社　未来創造研究所・株式会社毎日新聞社、後援：こども家庭庁・法務省・文部科学省・厚生労働省・国土交通省・東京都・鳥取県・千代田区。特設WEBサイト: https://www.tomotomo.go.jp/festa2026/。バリアフリー情報や出展・出演・イベント情報は特設ホームページを御覧ください。イベントへのお問い合わせは、ともともフェスタ2026運営事務局 info@tomotomo.go.jp ,03-5730-3157までお寄せください。受付時間は平日10時から17時（土日祝日、年末年始は除く）です。ポスターには、車いすユーザー・白杖ユーザーを含む多様な年齢・背景の人々のイラストが描かれています。","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":150,"w":150,"x":141,"y":181}]},"medium":{"faces":[{"h":143,"w":143,"x":135,"y":173}]},"orig":{"faces":[{"h":150,"w":150,"x":141,"y":181}]},"small":{"faces":[{"h":81,"w":81,"x":76,"y":98}]}},"id_str":"2102983010165649408","indices":[160,183],"media_key":"3_2102983010165649408","media_results":{"result":{"media_key":"3_2102983010165649408"}},"media_url_https":"https://pbs.twimg.com/media/HS9L59ma8AA2ch7.jpg","original_info":{"focus_rects":[{"h":496,"w":885,"x":0,"y":0},{"h":885,"w":885,"x":0,"y":0},{"h":1009,"w":885,"x":0,"y":0},{"h":1253,"w":627,"x":258,"y":0},{"h":1253,"w":885,"x":0,"y":0}],"height":1253,"width":885},"sizes":{"large":{"h":1253,"resize":"fit","w":885},"medium":{"h":1200,"resize":"fit","w":848},"small":{"h":680,"resize":"fit","w":480},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/MvCo5fqnNW"}]},"favorite_count":8,"favorited":false,"full_text":"＼ともともフェスタ2026を開催します！／\nいよいよ来月開催！HPを更新しました。\n最新情報は特設HP https://t.co/nsj3DoqDgK を御覧ください。\n日時：10月9日(金)・10日(土)\n場所：東京駅丸の内口　行幸通り・丸ビルマルキューブ\n御来場お待ちしています！\n#ともフェス　＃内閣府　＃丸の内 https://t.co/MvCo5fqnNW","id_str":"2103007729883529459","in_reply_to_screen_name":"kyoseikyojo_cao","in_reply_to_status_id_str":"2079419560898470328",