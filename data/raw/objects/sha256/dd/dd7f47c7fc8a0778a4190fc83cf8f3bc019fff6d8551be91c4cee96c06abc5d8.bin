},{"h":91,"w":91,"x":429,"y":407},{"h":83,"w":83,"x":1079,"y":445},{"h":97,"w":97,"x":1305,"y":351},{"h":101,"w":101,"x":175,"y":373},{"h":95,"w":95,"x":1571,"y":413},{"h":75,"w":75,"x":1315,"y":451},{"h":71,"w":71,"x":1347,"y":867},{"h":103,"w":103,"x":1815,"y":351},{"h":215,"w":215,"x":245,"y":873}]},"medium":{"faces":[{"h":57,"w":57,"x":358,"y":200},{"h":55,"w":55,"x":492,"y":216},{"h":53,"w":53,"x":251,"y":238},{"h":48,"w":48,"x":632,"y":261},{"h":57,"w":57,"x":765,"y":205},{"h":59,"w":59,"x":102,"y":218},{"h":55,"w":55,"x":920,"y":242},{"h":44,"w":44,"x":770,"y":264},{"h":42,"w":42,"x":789,"y":508},{"h":60,"w":60,"x":1063,"y":205},{"h":126,"w":126,"x":144,"y":511}]},"orig":{"faces":[{"h":124,"w":124,"x":776,"y":434},{"h":121,"w":121,"x":1066,"y":469},{"h":116,"w":116,"x":545,"y":517},{"h":106,"w":106,"x":1371,"y":566},{"h":124,"w":124,"x":1658,"y":446},{"h":129,"w":129,"x":223,"y":474},{"h":121,"w":121,"x":1995,"y":525},{"h":96,"w":96,"x":1670,"y":573},{"h":91,"w":91,"x":1711,"y":1101},{"h":132,"w":132,"x":2305,"y":446},{"h":274,"w":274,"x":312,"y":1109}]},"small":{"faces":[{"h":32,"w":32,"x":202,"y":113},{"h":31,"w":31,"x":278,"y":122},{"h":30,"w":30,"x":142,"y":135},{"h":27,"w":27,"x":358,"y":148},{"h":32,"w":32,"x":433,"y":116},{"h":33,"w":33,"x":58,"y":123},{"h":31,"w":31,"x":521,"y":137},{"h":25,"w":25,"x":436,"y":149},{"h":23,"w":23,"x":447,"y":287},{"h":34,"w":34,"x":602,"y":116},{"h":71,"w":71,"x":81,"y":290}]}},"id_str":"2104499297324806146","indices":[137,160],"media_key":"3_2104499297324806146","media_results":{"result":{"media_key":"3_2104499297324806146"}},"media_url_https":"https://pbs.twimg.com/media/HTSu9fcasAIJI6W.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1734,"w":1734,"x":866,"y":0},{"h":1734,"w":1521,"x":1079,"y":0},{"h":1734,"w":867,"x":1733,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/M5i495eHHC"}]},"favorite_count":6956,"favorited":false,"full_text":"本日午後、開催まで半年を切った「横浜グリーンエクスポ」の開催に向けた機運を盛り上げるべく、（公社）2027年国際園芸博覧会協会の筒井義信会長と、「グリーンエクスポ」で展示予定の最先端の「グリーン技術」をお持ちの皆様が、官邸までお運び下さいました。\n\n目の前で「“土に還る” https://t.co/M5i495eHHC","id_str":"2104499358129627444","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":63,"reply_count":317,"retweet_count":718,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ0OTkzNTgwNjY3Mjg5NjA=","richtext":{"richtext_tags":[]},"text":"本日午後、開催まで半年を切った「横浜グリーンエクスポ」の開催に向けた機運を盛り上げるべく、（公社）2027年国際園芸博覧会協会の筒井義信会長と、「グリーンエクスポ」で展示予定の最先端の「グリーン技術」をお持ちの皆様が、官邸までお運び下さいました。\n\n目の前で「“土に還る” 公式ボランティア・スタッフユニフォーム」、「省エネと脱炭素を支える超断熱材素材」、「スギから生まれる高機能プラスチック代替素材」のデモンストレーションをしていただき、興味深く拝見しました。\n\nご披露いただいたそれぞれのグリーン技術は、アパレル産業の「大量生産、大量廃棄」の問題、「エネルギー効率化」や「水素社会の実現」、更には「経済安全保障」など、様々な社会課題を解決すると同時に、「価格競争力」も期待できる技術でした。\n\nまさに、成長の原動力になり得るものとして感動しました。\n\n横浜グリーンエクスポは、「みんなが楽しめる万博」であると同時に、我が国の優れたグリーン技術が披露される「産業見本市」でもあります。\n\n我が国の成長につながる「グリーン技術」が数多く展示され、来場された皆様が、将来に「希望」が感じられる博覧会となるよう、官民一体の「オールジャパン体制」で取り組んでまいります。"}}},"rest_id":"2104499358129627444","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"228961","state":"EnabledWithCount"}}}}},"entryId":"tweet-2104499358129627444","sortIndex":"2104752515479240666"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"T