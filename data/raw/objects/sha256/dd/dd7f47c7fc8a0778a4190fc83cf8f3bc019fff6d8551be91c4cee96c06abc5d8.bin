},"small":{"h":229,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/yDGFFdvXo3"}]},"favorite_count":1170,"favorited":false,"full_text":"令和８年９月２６日、ロシア海軍ステレグシチー級フリゲート１隻が、与那国島と西表島の間の海域を北東進した後、２７日から２８日にかけて、対馬海峡を北東進し、日本海へ向けて航行したことを確認しました。 https://t.co/yDGFFdvXo3","id_str":"2104509545594671470","is_quote_status":true,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":11,"quoted_status_id_str":"2104496826007146498","quoted_status_permalink":{"display":"x.com/jointstaffpa/s…","expanded":"https://twitter.com/jointstaffpa/status/2104496826007146498","url":"https://t.co/Fc0UynybsI"},"reply_count":13,"retweet_count":279,"retweeted":false,"user_id_str":"268732024"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIxMDQ1MDk1NDU1NDQzNTE3NDQ=","text":"令和８年９月２６日、ロシア海軍ステレグシチー級フリゲート１隻が、与那国島と西表島の間の海域を北東進した後、２７日から２８日にかけて、対馬海峡を北東進し、日本海へ向けて航行したことを確認しました。\n防衛省・自衛隊は、海上自衛隊の第１水上補給隊所属「とわだ」（呉）及び第３哨戒防備隊所属「しらたか」（佐世保）により、警戒監視・情報収集を行いました。"}}},"quoted_status_result":{"result":{"__typename":"Tweet","core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":3295},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1730044368902615040/7w8jWTpY_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/864751444586397696/1576143970"},"core":{"created_at":"Wed May 17 07:56:25 +0000 2017","name":"防衛省統合幕僚監部","screen_name":"jointstaffpa"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjo4NjQ3NTE0NDQ1ODYzOTc2OTY=","is_blue_verified":true,"location":{"location":"東京都新宿区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"統合幕僚監部の公式アカウントです。陸・海・空自衛隊の運用を司る統合幕僚監部は、厳しさを増す安全保障環境の中、それぞれが行う我が国周辺の警戒監視・対領空侵犯措置、海外での任務（海賊対処行動など）、災害派遣、そしてあらゆる事態に備えての統合演習など統合幕僚監部ならではのプロフェッショナルな活動状況をお伝えしています。","entities":{"description":{},"url":{"urls":[{"display_url":"mod.go.jp/js/","expanded_url":"https://www.mod.go.jp/js/","indices":[0,23],"url":"https://t.co/Rh7kA16rwk"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":360770,"following":33},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"864751444586397696","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":6349,"tweets":12394},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/Rh7kA16rwk"}}}},"edit_control":{"edit_tweet_ids":["2104496826007146498"],"editable_until_msecs":"1790589717000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":12,"bookmarked":false,"conversation_id_str":"2104496826007146498","created_at":"Mon Sep 28 09:01:57 +0000 2026","display_text_range":[0,97],"entities":{"media":[{"display_url":"pic.x.com/mrzLEilHPQ","expanded_url":"https://x.com/jointstaffpa/status/2104496826007146498/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[]},"medium":{"faces":[]},"orig":{"faces":[]},"small":{"faces":[]}},"id_str":"2104495752475189248","indices":[98,121],"media_key":"3_2104495752475189248","media_results":{"result":{"media_key":"3_2104495752475189248"}},"media_url_https":"https://pbs.twimg.com/media/HTSrvJ2aIAAHDSB.png","original_info":{"focus_rects":[{"h":319,"w":570,"x