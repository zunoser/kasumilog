:[119,142],"media_key":"13_2094697693247623168","media_results":{"result":{"media_key":"13_2094697693247623168"}},"media_url_https":"https://pbs.twimg.com/amplify_video_thumb/2094697693247623168/img/9TYoSg8uHDf4TF1o.jpg","original_info":{"focus_rects":[],"height":1080,"width":1080},"sizes":{"large":{"h":1080,"resize":"fit","w":1080},"medium":{"h":1080,"resize":"fit","w":1080},"small":{"h":680,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"video","url":"https://t.co/LO9WnQHuNI","video_info":{"aspect_ratio":[1,1],"duration_millis":30186,"variants":[{"content_type":"application/x-mpegURL","url":"https://video.twimg.com/amplify_video/2094697693247623168/pl/y7-5KtlQ7D7lk1k-.m3u8?tag=29&v=4a9"},{"bitrate":432000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2094697693247623168/vid/avc1/320x320/hBazn8_zWn0bGfqt.mp4?tag=29"},{"bitrate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2094697693247623168/vid/avc1/540x540/pzZTOkzjvDutJTkY.mp4?tag=29"},{"bitrate":1280000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2094697693247623168/vid/avc1/720x720/_cwYRYWNqMJnMOUe.mp4?tag=29"},{"bitrate":8768000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2094697693247623168/vid/avc1/1080x1080/S5aPCTgVZ7td1UVm.mp4?tag=29"}]}}]},"favorite_count":215,"favorited":false,"full_text":"【#地震保険】\n本日、9月1日は「防災の日」です。\n災害への備えとして、防災対策はもちろんですが、万が一被災した場合の経済的な備えも重要です。\n\n地震保険は、地震による住宅などの損害を官民共同で補償し、被災後の生活再建を支える保険です。 https://t.co/LO9WnQHuNI","id_str":"2094697721416634411","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":2,"reply_count":20,"retweet_count":85,"retweeted":false,"user_id_str":"331514169"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[{"indices":[1,6],"text":"地震保険"}],"smarttags":[],"symbols":[],"timestamps":[],"urls":[{"display_url":"gov-online.go.jp/article/201701…","expanded_url":"https://www.gov-online.go.jp/article/201701/entry-9333.html","indices":[175,198],"url":"https://t.co/tObf06ORF3"},{"display_url":"jishin-hoken.jp","expanded_url":"https://www.jishin-hoken.jp/","indices":[219,242],"url":"https://t.co/I8kByYawL9"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ2OTc3MjEyOTQ5MjU4MjQ=","richtext":{"richtext_tags":[]},"text":"【#地震保険】\n本日、9月1日は「防災の日」です。\n災害への備えとして、防災対策はもちろんですが、万が一被災した場合の経済的な備えも重要です。\n\n地震保険は、地震による住宅などの損害を官民共同で補償し、被災後の生活再建を支える保険です。\n\n防災を意識するこの機会に、地震への経済的な備えについても考えてみてはいかがでしょうか。\n\n政府広報オンライン\nhttps://t.co/tObf06ORF3\n地震保険特設サイト（日本損害保険協会）\nhttps://t.co/I8kByYawL9"}}},"rest_id":"2094697721416634411","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"50715","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094697721416634411","sortIndex":"2095009078836199352"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2093734994057560065/YyIHcbv7?format=png&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"domain","value":{"string_value":"www.fsa.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2093734994057560065/YyIHcbv7?format=png&name=420x420_2","width":400},"type":"IMAGE"}},{"key":"thumbnail_image_original","value":{"image_value":{"height":400,"url":"https://pbs.twimg.com/card_img/2093734994057560065/YyIHcbv7?format=png&name=orig","width":401},"type":"IMAGE"}},{"key":"site","value":{"scribe_