"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2991898,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":527,"tweets":1750},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2094742947862642767"],"editable_until_msecs":"1788264211000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":129,"bookmarked":false,"conversation_id_str":"2094742947862642767","created_at":"Tue Sep 01 11:03:31 +0000 2026","display_text_range":[0,116],"entities":{},"favorite_count":6222,"favorited":false,"full_text":"本日、笹川平和財団及びササカワ・アフリカ財団の設立40周年を記念するレセプションに出席し、御挨拶申し上げる機会を賜りました。\n\n国際交流・国際協力を始め、国際社会の課題解決に長年、尽力されてきた両財団のご功績に、深く敬意を表します。","id_str":"2094742947862642767","is_quote_status":false,"lang":"ja","quote_count":277,"reply_count":1079,"retweet_count":660,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ3NDI5NDc4MTIyODY0NjQ=","richtext":{"richtext_tags":[]},"text":"本日、笹川平和財団及びササカワ・アフリカ財団の設立40周年を記念するレセプションに出席し、御挨拶申し上げる機会を賜りました。\n\n国際交流・国際協力を始め、国際社会の課題解決に長年、尽力されてきた両財団のご功績に、深く敬意を表します。\n\n国際情勢が不透明さを増す中で、国際社会の平和と繁栄の実現には、官民一体での知見の活用と、息の長い対話の積み重ねが不可欠です。\n\n40年にもわたり、民間の立場から対話のチャンネルを切り拓き、ネットワークの構築に貢献してこられた笹川平和財団の取組は、大きな役割を果たしていくものと確信しています。\n\n政府としても、財団と手を携え、国際社会の課題解決に積極的に取り組んでいきたいと考えております。"}}},"rest_id":"2094742947862642767","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"703855","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094742947862642767","sortIndex":"2095009078836199385"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/378800000051923376/95544f0925b76c202e9c75ebb6234e22_normal.jpeg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/236682791/1402039644"},"core":{"created_at":"Tue Jan 11 04:04:54 +0000 2011","name":"国税庁","screen_name":"NTA_Japan"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMzY2ODI3OTE=","is_blue_verified":false,"location":{"location":"東京都千代田区霞が関 "},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2001095001481076943"]},"possibly_sensitive":false,"privacy":{"pro