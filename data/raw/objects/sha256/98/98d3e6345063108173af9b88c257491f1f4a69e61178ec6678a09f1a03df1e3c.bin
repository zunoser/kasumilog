3776/vid/avc1/320x568/D0aVCXr_8HvQFuk5.mp4?tag=29"},{"bitrate":950000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2094731768041803776/vid/avc1/480x852/DsAOn5bYHCW5EHLe.mp4?tag=29"},{"bitrate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2094731768041803776/vid/avc1/720x1280/5ywjScAk5ywJmXSd.mp4?tag=29"},{"bitrate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2094731768041803776/vid/avc1/1080x1920/ydBDONeuckRE9v6S.mp4?tag=29"}]}}]},"favorite_count":2439,"favorited":false,"full_text":"「防災の日」の本日、首都直下地震と日本海溝地震・千島海溝地震を想定した総合防災訓練を行いました。政府本部運営訓練における緊急災害対策本部会議では、初動対応や自治体との連携を確認し、厚木市の訓練視察では、ワンタッチテントの設置やAEDによる心肺蘇生を体験しました。国民の生命と財産を守 https://t.co/9AETUpIciu","id_str":"2094732115502071821","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":75,"reply_count":158,"retweet_count":380,"retweeted":false,"user_id_str":"412940784"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"timestamps":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ3MzIxMTU0NTE3MDczOTI=","richtext":{"richtext_tags":[]},"text":"「防災の日」の本日、首都直下地震と日本海溝地震・千島海溝地震を想定した総合防災訓練を行いました。政府本部運営訓練における緊急災害対策本部会議では、初動対応や自治体との連携を確認し、厚木市の訓練視察では、ワンタッチテントの設置やAEDによる心肺蘇生を体験しました。国民の生命と財産を守るため、災害対策に万全を期してまいります。"}}},"rest_id":"2094732115502071821","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"76303","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094732115502071821","sortIndex":"2095009078836199374"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":46},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1985639760669655041/3yz_lJbK_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/218434058/1778462883"},"core":{"created_at":"Mon Nov 22 10:18:33 +0000 2010","name":"高市早苗","screen_name":"takaichi_sanae"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyMTg0MzQwNTg=","is_blue_verified":true,"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"衆議院議員 自由民主党奈良県第2選挙区支部長\n※総理在任中の投稿は、一部広報スタッフによるものを含みます。","entities":{"description":{},"url":{"urls":[{"display_url":"sanae.gr.jp","expanded_url":"https://www.sanae.gr.jp/","indices":[0,23],"url":"https://t.co/VNedKNe7ny"}]}}},"profile_description_language":"ja","profile_image_shape":"Circle","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":2991898,"following":0},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"218434058","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":527,"tweets":1750},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/VNedKNe7ny"}}}},"edit_control":{"edit_tweet_ids":["2094730660409958539"],"editable_until_msecs":"1788261282000","edits_remaining":"5","is_edit_eligible":true},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":108,"bookmarked":false,"conversation_id_str":"2094730660409958539","created_at":"Tue Sep 01 10:14:42 +0000 2026","display_text_range":[0,117],"entities":{"user_mentions":[{"id_str":"3241480459","indices":[23,33],"name":"PMO","screen_name":"PM_nepal_"}]},"favorite_count":15100,"favorited":false,"full_text":"本日、16時15分から、ネパールのシャハ首相（@PM_nepal_）との間で、電話会談を行いました。\n\n私からは、ネパールの洪水被害で犠牲となられた方々に哀悼の誠を捧げ、御家族と被害に遭われた皆様に、心からのお見舞いを申し上げました。","id_str":"2094730660409958539","is_quote_status":false,"lang":"ja","quote_count":95,"reply_count":435,"retweet_count":1405,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[{"id_str":"3241480459","indices":[23,33],"name":"PMO","screen_name":"PM_nepal_"}]},"id":"Tm90ZVR3ZWV0OjIwOTQ3MzA2NjAzMzQ0ODU1MDQ=","richtext":{"richtext_tags":[]},"text":"本日、16時15分から、ネパールのシャハ首相（@PM_nepal_）との間で、電話会談を行いました。\n\n私からは、ネパールの洪水被害で犠牲となられた方々に哀悼の誠を捧げ、御家族と被害に遭われた皆様に、心からのお見舞いを申し上げました。\n\n日本でも、熊本地震や記録的豪雨により、各地で災害が相次ぎ、多くの方が被災されていますが、日本と同様、ネパールも災害多発国であることから、ネパールの難局に心を痛めていることをお伝えしました。\n\nまた、連絡が取れていない邦人5名の一刻も早い救援について、改めてネパール政府に最大限の協力をお願いしました。\n\nこれに対しては、シャハ首相から、全力で取り組んでいる旨のお話がありました。\n\n日本政府としても、安否確認に全力を挙げています。\n\nその上で、ネパールとの友好関係にかんがみ、被災者の方々を支援すべく、テントや毛布といった緊急援助物資の供与を行うことをお伝えしました。\n\nこの緊急援助物資は、日本国内での災害対応用とは別に、政府が海外に備蓄している、対外支援用の緊急物資を活用したものです。\n\nアジアの友人であるネパールに対し、 今後も、国際機関を通じた支援や国際緊急援助隊派遣などの準備を行ってまいります。\n\nまた、本日は、「日・ネパール外交関係樹立70周年」　の記念日であり、両国関係の強化に向けても、シャハ首相と共に取り組んでまいります。"}}},"rest_id":"2094730660409958539","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"502442","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094730660409958539","sortIndex":"2095009078836199373"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":2},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1082102533454102528/HXpr1ZEl_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/303730149/1782867128"},"core":{"created_at":"Mon May 23 10:17:04 +0000 2011","name":"外務省","screen_name":"MofaJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjozMDM3MzAxNDk=","is_blue_verified":false,"location":{"location":"東京都千代田区"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2094921576336765029"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"外務省の公式アカウントです。外交に関する新着情報を中心に発信しております。｜英語版（English）@MofaJapan_en\n｜外務省ソーシャルメディア一覧： https://t.co/2VDfT2CQ5p","entities":{"description":{"urls":[{"display_url":"mofa.go.jp/mofaj/annai/sn…","expanded_url":"https://www.mofa.go.jp/mofaj/annai/sns/list_jp.html","indices":[81,104],"url":"https://t.co/2VDfT2CQ5p"}]},"url":{"urls":[{"display_url":"mofa.go.jp/mofaj/","expanded_url":"http://www.mofa.go.jp/mofaj/","indices":[0,23],"url":"https://t.co/42AYao2vk0"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":586033,"following":205},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest