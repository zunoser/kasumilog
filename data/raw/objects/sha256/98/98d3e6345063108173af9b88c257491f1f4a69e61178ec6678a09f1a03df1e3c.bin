mofaj/erp/erp_…","expanded_url":"https://www.mofa.go.jp/mofaj/erp/erp_2/pageit_000001_03176.html","indices":[178,201],"url":"https://t.co/ZEQNBRWHLY"}],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ3NzQ3NzQ1NDc1Mzc5MjA=","richtext":{"richtext_tags":[]},"text":"スロバキアを訪問中の茂木外務大臣は、第8回「V4+日本」外相会合に出席しました。茂木大臣は、議長国のスロバキアを始めとする各国の協力に対する謝意を述べ、「V4＋日本」協力は、経済、科学技術を始め大きなポテンシャルを有する、また、法の支配に基づく自由で開かれた国際秩序を維持・強化する上で、我々の結束及び連携がこれまで以上に求められている旨を述べました。\n\nhttps://t.co/ZEQNBRWHLY"}}},"rest_id":"2094774774656627093","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"13824","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094774774656627093","sortIndex":"2095009078836199390"},{"content":{"__typename":"TimelineTimelineItem","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"entryType":"TimelineTimelineItem","itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":127},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1182494221720145920/1f6PGrY1_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/268732024/1693473523"},"core":{"created_at":"Sat Mar 19 10:39:03 +0000 2011","name":"防衛省・自衛隊","screen_name":"ModJapan_jp"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoyNjg3MzIwMjQ=","is_blue_verified":true,"location":{"location":"東京都新宿区市谷本村町5-1"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"#防衛省・自衛隊 の公式アカウントです。防衛省