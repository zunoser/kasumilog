_2094717903077773312"}},"media_url_https":"https://pbs.twimg.com/media/HRHu1aWaEAArKCZ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":0},{"h":1679,"w":1679,"x":921,"y":0},{"h":1679,"w":1473,"x":1127,"y":0},{"h":1679,"w":840,"x":1760,"y":0},{"h":1679,"w":2600,"x":0,"y":0}],"height":1679,"width":2600},"sizes":{"large":{"h":1323,"resize":"fit","w":2048},"medium":{"h":775,"resize":"fit","w":1200},"small":{"h":439,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YIVnMOB3pt"},{"allow_download_status":{"allow_download":true},"display_url":"pic.x.com/YIVnMOB3pt","expanded_url":"https://x.com/takaichi_sanae/status/2094717997743304717/photo/1","ext_media_availability":{"status":"Available"},"features":{"large":{"faces":[{"h":395,"w":395,"x":943,"y":355}]},"medium":{"faces":[{"h":231,"w":231,"x":552,"y":208}]},"orig":{"faces":[{"h":502,"w":502,"x":1198,"y":451}]},"small":{"faces":[{"h":131,"w":131,"x":313,"y":117}]}},"id_str":"2094717955586289664","indices":[14,37],"media_key":"3_2094717955586289664","media_results":{"result":{"media_key":"3_2094717955586289664"}},"media_url_https":"https://pbs.twimg.com/media/HRHu4d9acAAnyKZ.jpg","original_info":{"focus_rects":[{"h":1456,"w":2600,"x":0,"y":117},{"h":1734,"w":1734,"x":628,"y":0},{"h":1734,"w":1521,"x":735,"y":0},{"h":1734,"w":867,"x":1062,"y":0},{"h":1734,"w":2600,"x":0,"y":0}],"height":1734,"width":2600},"sizes":{"large":{"h":1366,"resize":"fit","w":2048},"medium":{"h":800,"resize":"fit","w":1200},"small":{"h":454,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/YIVnMOB3pt"}]},"favorite_count":8561,"favorited":false,"full_text":"本日は、「防災の日」です。 https://t.co/YIVnMOB3pt","id_str":"2094717997743304717","is_quote_status":false,"lang":"ja","possibly_sensitive":false,"possibly_sensitive_editable":true,"quote_count":157,"reply_count":534,"retweet_count":958,"retweeted":false,"user_id_str":"218434058"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"result":{"entity_set":{"hashtags":[],"smarttags":[],"symbols":[],"urls":[],"user_mentions":[]},"id":"Tm90ZVR3ZWV0OjIwOTQ3MTc5OTc2NzE5MDczMjk=","richtext":{"richtext_tags":[]},"text":"本日は、「防災の日」です。\n\n政府では、「首都直下地震」を想定した「徒歩参集訓練」と、北海道・鈴木知事、青森県・宮下知事、釧路市・鶴間市長にもご協力いただき、「千島海溝地震・日本海溝地震」を想定した「政府本部運営訓練」を実施し、発災後の初動における政府の対応や、関係機関の役割分担・連携などについて確認をしました。\n\nその後、神奈川県厚木市で開催された「九都県市合同防災訓練」と連携した現地調査訓練に参加しました。\n\n「九都県市合同防災訓練」には、警察、消防、自衛隊、海上保安庁をはじめ、米軍、医療・健康分野の専門家の皆様なども参加されており、様々な機関が連携して実施された「救出・救助訓練」などの視察に加え、私自身も\n・「ワンタッチテント」の設置\n・AEDを用いた「心肺蘇生」\nの訓練に参加させていただきました。\n\nこうした訓練は、いざという時に大切な命を守り抜く力となり、それは訓練を重ねるごとに確かなものとなっていきます。\n\n自然災害は、いつ、どこで発生してもおかしくありません。\n\n政府では、徹底した「事前防災」と、発災時の対応から復旧復興までの「一貫した災害対応」の「司令塔」機能を担う「防災庁」の本年中の設置に向けて、人員と予算を拡充するなど、「産官学民」の総力を挙げた防災体制の抜本的強化を図っています。\n\n発生が危惧される「首都直下地震」や「南海トラフ地震」に備えるためには、国や自治体、関係機関の緊密な連携に加え、国民の皆様お一人お一人が「自分の命を守る」「地域を守る」という意識を持ち、日頃から備えていただくことが重要です。\n\n是非「防災の日」の機会に、ご自身やご家庭の「災害への備え」について、ご確認をしていただきたいと思います。\n\n大雨などによる災害が、多く発生する時期が続きます。\n\n政府として、警戒を怠らず、緊張感を持って臨んでまいります。\n\n改めて、本日の訓練にご協力いただきました皆様に心から感謝申し上げます。"}}},"rest_id":"2094717997743304717","source":"<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>","unmention_data":{},"views":{"count":"273712","state":"EnabledWithCount"}}}}},"entryId":"tweet-2094717997743304717","sortIndex":"2095009078836199369"},{"content":{"__typename":"TimelineTimelineModule","clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}}},"displayType":"VerticalConversation","entryType":"TimelineTimelineModule","items":[{"entryId":"list-conversation-2095009078836199480-tweet-2094714072168386847","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","cashtag_attachments":[],"core":{"user_results":{"result":{"__typename":"User","action_counts":{"favorites_count":0},"affiliates_highlighted_label":{},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/1674231387166220288/iK7GwtIr_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/180585090/1680484704"},"core":{"created_at":"Fri Aug 20 00:19:17 +0000 2010","name":"厚生労働省","screen_name":"MHLWitter"},"dm_permissions":{"can_dm":false},"follow_request_sent":false,"has_graduated_access":true,"id":"VXNlcjoxODA1ODUwOTA=","is_blue_verified":true,"location":{"location":"東京都千代田区霞が関　中央合同庁舎５号館"},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"parody_commentary_fan_label":"None","pinned_items":{"tweet_ids_str":["2088087568323870923"]},"possibly_sensitive":false,"privacy":{"protected":false},"profile_bio":{"description":"厚生労働省の公式アカウントです。\n健康・医療、福祉・介護、雇用・労働、年金など、皆さまの暮らしを支える情報をお届けします。\n\n※このXに寄せられたコメントへの返信はしておりません。\n\n【運用方針】\nhttps://t.co/dQtOdVs4pp","entities":{"description":{"urls":[{"display_url":"mhlw.go.jp/content/102000…","expanded_url":"https://www.mhlw.go.jp/content/10200000/001350977.pdf","indices":[99,122],"url":"https://t.co/dQtOdVs4pp"}]},"url":{"urls":[{"display_url":"mhlw.go.jp","expanded_url":"http://www.mhlw.go.jp/","indices":[0,23],"url":"https://t.co/XJir5J4Swz"}]}}},"profile_description_language":"ja","profile_image_shape":"Square","profile_metadata":{"profile_interstitial_type":""},"profile_translation":{"translator_type":"none"},"relationship_counts":{"followers":1034027,"following":15},"relationship_perspectives":{"blocked_by":false,"blocking":false,"followed_by":false,"following":false,"live_following":false,"muting":false},"rest_id":"180585090","super_follow_eligible":false,"super_followed_by":false,"super_following":false,"tweet_counts":{"media_tweets":24505,"tweets":44922},"verification":{"verified":false,"verified_type":"Government"},"website":{"url":"https://t.co/XJir5J4Swz"}}}},"edit_control":{"edit_tweet_ids":["2094714072168386847"],"editable_until_msecs":"1788257327000","edits_remaining":"5","is_edit_eligible":false},"grok_analysis_button":true,"grok_annotations":{"is_image_editable_by_grok":false},"grok_translated_post_with_availability":{"is_available":false},"is_translatable":false,"legacy":{"bookmark_count":0,"bookmarked":false,"conversation_id_str":"2094714072168386847","created_at":"Tue Sep 01 09:08:47 +0000 2026","display_text_range":[0,111],"entities":{},"favorite_count":36,"favorited":false,"full_text":"9月1日(火)大臣記者会見概要を公開しました。\n健康増進普及月間の実施\n自殺予防週間の実施\n労働基準監督署による時間外労働に関する監督指導の見直し等\n「障害者雇用ビジネス」にかかる法規制\n与党合意した社会保障改革の検討状況","id_str":"2094714072168386847","is_quote_status":false,"lang":"ja","quote_count":2,"reply_count":8,"retweet_count":9,"retweeted":false,"user_id_str":"180585090"},"rest_id":"2094714072168386847","source":"<a href=\"https://social.userlocal.jp/\" rel=\"nofollow\">Userlocal SocialInsight</a>","unmention_data":{},"views":{"count":"29601","state":"EnabledWithCount"}}}}}},{"entryId":"list-conversation-2095009078836199480-tweet-2094714165118292197","item":{"clientEventInfo":{"component":"suggest_organic_list_tweet","details":{"timelinesDetails":{"injectionType":"OrganicListTweet"}},"element":"tweet"},"itemContent":{"__typename":"TimelineTweet","itemType":"TimelineTweet","tweetDisplayType":"Tweet","tweet_results":{"result":{"__typename":"Tweet","card":{"legacy":{"binding_values":[{"key":"thumbnail_image","value":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2094203077285072896/HWyzNP1P?format=jpg&name=144x144_2","width":144},"type":"IMAGE"}},{"key":"description","value":{"string_value":"上野大臣会見概要について紹介しています","type":"STRING"}},{"key":"domain","value":{"string_value":"www.mhlw.go.jp","type":"STRING"}},{"key":"thumbnail_image_large","value":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2094203077285072896/HWyzNP1P?format=jpg&name=420x420_2","width":420},"type":"IMAGE"}},{"key":"thumbn